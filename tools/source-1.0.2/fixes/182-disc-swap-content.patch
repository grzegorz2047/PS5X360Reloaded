diff --git a/include/xbox360ps5/disc_content.hpp b/include/xbox360ps5/disc_content.hpp
--- a/include/xbox360ps5/disc_content.hpp
+++ b/include/xbox360ps5/disc_content.hpp
@@ -55,4 +55,31 @@ inline bool OpensExisting(uint32_t flags) {
   return disposition == 3 || disposition == 4;
 }
 
+// Fix 182: where a disc package was found.
+enum class Found { kNone, kDrive, kEarlierDisc };
+
+// Fix 182: a disc package is looked for at every path on the disc in the drive (game:) first, then
+// on the discs that were in the drive before a disc swap (VirtualFileSystem keeps them,
+// ResolvePathOnReplacedDevices). Grand Theft Auto V opens its four packages again under the root
+// "extra" after the swap from Disc 1 (Install) to Disc 2 (Play), on the device where its first pass
+// found them; after an install made in the session that is the drive, which then holds Disc 2, so
+// all four opens failed with "path not found" and the game waited for them for hours.
+// on_drive(path) and on_earlier(path) return the entry (nullptr when absent); is_file(entry) refuses
+// a folder. `entry` and `path` are set only when a package is found.
+template <class Entry, class OnDrive, class OnEarlier, class IsFile>
+Found FindPackage(const std::vector<std::string>& paths, OnDrive&& on_drive, OnEarlier&& on_earlier,
+                  IsFile&& is_file, Entry*& entry, std::string& path) {
+  for (int pass = 0; pass < 2; ++pass) {
+    for (const std::string& candidate : paths) {
+      Entry* found = pass == 0 ? on_drive(candidate) : on_earlier(candidate);
+      if (found && is_file(found)) {
+        entry = found;
+        path = candidate;
+        return pass == 0 ? Found::kDrive : Found::kEarlierDisc;
+      }
+    }
+  }
+  return Found::kNone;
+}
