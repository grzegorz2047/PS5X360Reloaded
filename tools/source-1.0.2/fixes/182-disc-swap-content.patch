+++ b/.deps/xenia-canary/src/xenia/vfs/virtual_file_system.cc
@@ -44,6 +44,30 @@ bool VirtualFileSystem::ReplaceDeviceRetainingOld(std::unique_ptr<Device> device
   return true;
 }
 
+// Xbox360PS5 (fix 182): Grand Theft Auto V opens its install packages again
+// after the swap to its play disc, on the drive (device 2) when its first
+// pass found them there: the packages are on the disc that was in the drive
+// then, kept here until Clear.
+Entry* VirtualFileSystem::ResolvePathOnReplacedDevices(
+    const std::string_view path) {
+  auto global_lock = global_critical_region_.Acquire();
+  auto normalized_path(xe::utf8::canonicalize_guest_path(path));
+  std::string resolved_path;
+  if (ResolveSymbolicLink(normalized_path, resolved_path)) {
+    normalized_path = resolved_path;
+  }
+  std::lock_guard lock(retired_mutex);
+  auto found = retired_devices.find(this);
+  if (found == retired_devices.end()) return nullptr;
+  for (auto it = found->second.rbegin(); it != found->second.rend(); ++it) {
+    const auto& device = *it;
+    if (!xe::utf8::starts_with(normalized_path, device->mount_path())) continue;
+    auto relative_path = normalized_path.substr(device->mount_path().size());
+    if (auto entry = device->ResolvePath(relative_path)) return entry;
+  }
+  return nullptr;
+}
+
 
 VirtualFileSystem::VirtualFileSystem() {}
 
