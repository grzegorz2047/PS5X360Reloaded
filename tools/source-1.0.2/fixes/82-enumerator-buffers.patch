diff --git a/include/xbox360ps5/xam_buffers.hpp b/include/xbox360ps5/xam_buffers.hpp
new file mode 100644
--- /dev/null
+++ b/include/xbox360ps5/xam_buffers.hpp
@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+// Fix 82: the XamAlloc buffers an enumerator's private area points to, freed when the enumerator
+// goes. On a console, closing an enumerator made with XamCreateEnumeratorHandle sends its close
+// message to its XAM app, which frees what the title library allocated for it; Xenia has no such
+// handler. Battlefield 3 (1.0.5_candidate_57, with fix 80 freeing the enumerators): about 15
+// XamAlloc buffers of about 21 KiB a second kept, 3,768 allocated and 5 freed, until the guest's
+// 4 KiB heap is full after about 14 minutes.
+// The emulator keeps the live XamAlloc blocks; when an enumerator is destroyed, a block whose
+// start address is a word of the enumerator's object (its fields and private area) is freed,
+// unless another live enumerator's object also holds it. XamFree of a block freed that way does
+// nothing (the console's XAM app would have freed it too); XamFree of anything else is as before.
+#include <cstdint>
+#include <mutex>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+namespace xbox360ps5 {
+namespace xam_buffers {
+
+struct State {
+  std::mutex mutex;
+  std::unordered_map<uint32_t, uint32_t> live;  // XamAlloc block -> size
+  std::unordered_set<uint32_t> freed_with_enumerator;
+};
+inline State& Get() {
+  static State state;
+  return state;
+}
+
+inline void Allocated(uint32_t address, uint32_t size) {
+  if (!address) return;
+  State& s = Get();
+  std::lock_guard<std::mutex> lock(s.mutex);
+  s.live[address] = size;
+  s.freed_with_enumerator.erase(address);  // the address is a new block's now
+}
+// XamFree: whether to free the block; false only for one freed with its enumerator (any other
+// address, even one this does not know, is freed as before).
+inline bool Freeing(uint32_t address) {
+  State& s = Get();
+  std::lock_guard<std::mutex> lock(s.mutex);
+  if (s.freed_with_enumerator.erase(address)) return false;
+  s.live.erase(address);
+  return true;
+}
+
+struct Held {
+  uint32_t address, size, offset;
+};
+// The live XamAlloc blocks the words of an enumerator's object point to (each once, by offset),
+// leaving out those another live enumerator's words point to; taken out of the live set, to be
+// freed by the caller.
+inline std::vector<Held> TakeHeld(const std::vector<uint32_t>& words, const std::vector<uint32_t>& others) {
+  State& s = Get();
+  std::lock_guard<std::mutex> lock(s.mutex);
+  std::vector<Held> held;
+  for (uint32_t i = 0; i < words.size(); ++i) {
+    const uint32_t word = words[i];
+    const auto it = s.live.find(word);
+    if (it == s.live.end()) continue;
+    bool shared = false;
+    for (uint32_t other : others) shared |= other == word;
+    if (shared) continue;
+    held.push_back({word, it->second, i * 4});
+    s.live.erase(it);
+    s.freed_with_enumerator.insert(word);
+  }
+  return held;
+}
+
+}  // namespace xam_buffers
+}  // namespace xbox360ps5
