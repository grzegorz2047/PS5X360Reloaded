 XEnumerator::~XEnumerator() {
+  // Xbox360PS5 (fix 82): on a console, closing an enumerator sends its close
+  // message to its XAM app, which frees the buffers the title library
+  // XamAlloc'd for it (Battlefield 3: one of about 21 KiB with each of about 15
+  // enumerators a second). Free the XamAlloc blocks this enumerator's object
+  // points to, unless another live enumerator's object points to them too.
+  if (const uint32_t object = guest_object()) {
+    auto global_lock = xe::global_critical_region::AcquireDirect();
+    const auto words_of = [this](uint32_t at, size_t extra) {
+      std::vector<uint32_t> words;
+      const auto* w = memory()->TranslateVirtual<xe::be<uint32_t>*>(at);
+      for (size_t i = 0; i < (sizeof(X_KENUMERATOR) + extra) / 4; ++i) {
+        words.push_back(w[i]);
+      }
+      return words;
+    };
+    std::vector<uint32_t> others;
+    for (const auto& [at, enumerator] : OwnedEnumerators()) {
+      if (enumerator == this) continue;
+      const auto theirs = words_of(at, enumerator->extra_size_);
+      others.insert(others.end(), theirs.begin(), theirs.end());
+    }
+    for (const auto& held : xbox360ps5::xam_buffers::TakeHeld(
+             words_of(object, extra_size_), others)) {
+      memory()->SystemHeapFree(held.address);
+      static std::atomic<uint32_t> said{0};
+      if (said.fetch_add(1) < 8) {
+        XELOGW(
+            "Enumerator {:08X} gone: freed the XamAlloc buffer {:08X} ({} "
+            "bytes) it held at +{:X}, as its close message would",
+            object, held.address, held.size, held.offset);
+      }
+    }
+  }
   if (const uint32_t guest_ptr = guest_object()) {
     auto global_lock = xe::global_critical_region::AcquireDirect();
     const auto it = OwnedEnumerators().find(guest_ptr);
