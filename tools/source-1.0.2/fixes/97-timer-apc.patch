+// Fix 97: the APC relay. A guest timer's APC routine fires on the POSIX
+// TimerQueue thread, a host thread without a guest context; queueing the APC
+// there read through the missing context (Brian Lara International Cricket
+// 2007, issue 16: a read fault at 0x20 in XThread::EnqueueApc five seconds
+// after the start). This thread has a guest context and waits on its own
+// lock, never on the global one. It is started by the first timer with an APC
+// routine (XTimer::SetTimer, on the guest thread that sets it, before the
+// timer is armed), not at boot: a game that sets none runs without it, with
+// the threads, IDs and guest stacks it had before fix 97.
+void KernelState::EnsureApcRelay() {
+  std::lock_guard<std::mutex> start(host_apc_start_mutex_);
+  if (!host_apc_thread_) {
+    {
+      std::lock_guard<std::mutex> lock(host_apc_mutex_);
+      host_apc_running_ = true;
+    }
+    host_apc_thread_ = object_ref<XHostThread>(new XHostThread(
+        this, 64 * 1024, 0,
+        [this]() {
+          std::vector<HostApc> batch;
+          while (true) {
+            {
+              std::unique_lock<std::mutex> lock(host_apc_mutex_);
+              host_apc_cond_.wait(lock, [this] {
+                return !host_apcs_.empty() || !host_apc_running_;
+              });
+              if (!host_apc_running_) {
+                break;
+              }
+              batch.swap(host_apcs_);
+            }
+            for (const HostApc& apc : batch) {
+              auto thread =
+                  object_table()->LookupObject<XThread>(apc.thread_handle);
+              if (!thread) {
+                if (host_apcs_skipped_++ == 0) {
+                  XELOGW(
+                      "Timer APC (fix 97): thread {:08X} ended before its "
+                      "routine {:08X} was queued; skipped (later ones not "
+                      "logged)",
+                      apc.thread_handle, apc.routine);
+                }
+                continue;
+              }
+              if (host_apcs_relayed_++ == 0) {
+                XELOGW(
+                    "Timer APC (fix 97): routine {:08X} for thread {:08X} "
+                    "queued through the kernel's relay (first; later ones not "
+                    "logged)",
+                    apc.routine, apc.thread_handle);
+              }
+              thread->EnqueueApc(apc.routine, apc.routine_context, apc.arg1,
+                                 apc.arg2);
+            }
+            batch.clear();
+          }
+          return 0;
+        },
+        GetSystemProcess()));
+    host_apc_thread_->set_name("Kernel APC relay");
+    host_apc_thread_->Create();
+  }
 }
 
