+void KernelState::QueueApcFromHost(uint32_t thread_handle, uint32_t routine,
+                                   uint32_t routine_context, uint32_t arg1,
+                                   uint32_t arg2) {
+  // Fix 97: no global lock here (see kernel_state.h).
+  {
+    std::lock_guard<std::mutex> lock(host_apc_mutex_);
+    if (!host_apc_running_) {
+      // No timer with an APC routine yet: the relay is not running (a host
+      // thread's other callers; before fix 97 they read through no context).
+      if (host_apcs_unrelayed_++ == 0) {
+        XELOGW("Timer APC (fix 97): routine {:08X} for thread {:08X} asked for "
+               "on a host thread before the relay started; dropped (later "
+               "ones not logged)",
+               routine, thread_handle);
+      }
+      return;
+    }
+    host_apcs_.push_back({thread_handle, routine, routine_context, arg1, arg2});
+  }
+  host_apc_cond_.notify_one();
+}
