+// scale is not changed while it runs), the verdict saved and the player told, once a session.
+void NoteAutoScaleVerdict(xbox360ps5::auto_scale::Trigger trigger) {
+  namespace as = xbox360ps5::auto_scale;
+  as::Session& session = as::session();
+  if (trigger == as::Trigger::none || session.reported) return;
+  session.reported = true;
+  const std::string text = as::VerdictText(trigger, session.watch.numbers());
+  const bool saved = xbox360ps5::SaveScaleVerdict(session.title, text);
+  XELOGW("Resolution scale (fix 163): {} goes to 1x from its next start, Automatic ({}){}", session.title, text,
+         saved ? "" : "; the verdict could not be saved");
+  xbox360ps5::Notify({XBOX360PS5_PRODUCT_NAME, Tr("This game runs better at 1x: from its next start it runs at 1x."), "", false});
