+// SPDX-License-Identifier: MIT
+// Fix 163: "Automatic" resolution scale, the default. draw_scale's third choice (2): a game runs at
+// 2x unless 2x was found not to suit it, then at 1x from its next start. 2x does not suit a game
+// when, at 2x by Automatic,
+//  - memory: fix 117b's floor was hit (a render target class kept at 1x, a render target refused)
+//    or fix 117d's (free direct memory under 1 GiB): the picture mixes 1x and 2x from then on;
+//  - speed: in play it stays under 30 frames: the median game swaps a second of the last kWindows
+//    30 s windows, after the first kWarmupSeconds, is under kMinSwaps (a game held at 30 shows
+//    29.x, so 28); a window in which the game swapped less than once a second (a pause, the
+//    guide, a stall, a loading screen that does not draw) does not count.
+// The scale is not changed while the game runs (half the picture would be 1x); the player is told
+// and the verdict (game-settings/<TITLE ID>.scale.txt) holds 1x from the next start. Resetting the
+// game's own settings removes it. An explicit 1x or 2x (the general setting or the game's own)
+// is used as it is; fix 150g's 1x for Kinect Sports comes after.
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+#include <vector>
+
+#include "xbox360ps5/resolution_scale.hpp"  // fix 162c's list, when the tree has it
+
+namespace xbox360ps5::auto_scale {
+
+inline constexpr int kAutomatic = 2;          // draw_scale: 0 1x, 1 2x, 2 Automatic
+inline constexpr double kMinSwaps = 28.0;     // under it: too slow (a cap of 30 shows 29.x)
+inline constexpr double kPlaying = 1.0;       // a window under it is not play (pause, guide, stall)
+inline constexpr int kWarmupSeconds = 60;     // the first minute (loading, menus) does not count
+inline constexpr int kWindowSeconds = 30;
+inline constexpr size_t kWindows = 6;         // three minutes of play
+
+// The choice a game runs with (0 1x, 1 2x) and why, for the start line.
+struct Start {
+  int choice = 0;
+  std::string why;
+};
+inline Start Resolve(int choice, const std::string& title_id, bool verdict_1x) {
+  if (choice == 0) return {0, "1x chosen"};
+  if (choice == 1) return {1, "2x chosen"};
+  if (title_id.empty()) return {1, "Automatic, no game yet: 2x"};
+#ifdef XBOX360PS5_AUTO_SCALE_ONE_X_LIST
+  // Fix 162c: listed games start at 1x without trying 2x.
+  if (xbox360ps5::resolution_scale::AutomaticStartsAtOneX(title_id)) return {0, "Automatic: 1x (compiled-in list)"};
+#endif
+  if (verdict_1x) return {0, "Automatic: 1x remembered for this game"};
+  return {1, "Automatic: 2x (no verdict for this game)"};
+}
+
+// The verdict file's text: "1x <trigger>: <numbers>".
+enum class Trigger { none, memory, speed };
+inline const char* TriggerName(Trigger t) {
+  return t == Trigger::memory ? "memory" : t == Trigger::speed ? "speed" : "none";
+}
+inline std::string VerdictText(Trigger trigger, const std::string& numbers) {
+  return std::string("1x ") + TriggerName(trigger) + ": " + numbers;
+}
+inline bool SaysOneX(const std::string& text) { return text.rfind("1x ", 0) == 0; }
+
+inline double Median(std::vector<double> values) {
+  if (values.empty()) return 0;
+  std::sort(values.begin(), values.end());
+  const size_t n = values.size();
+  return n % 2 ? values[n / 2] : (values[n / 2 - 1] + values[n / 2]) / 2;
+}
+
+// One session at 2x by Automatic: fed once a second, decides at most once.
+class Watch {
+ public:
+  void Begin(bool active) {
+    *this = Watch();
+    active_ = active;
+  }
+  bool active() const { return active_; }
+  bool decided() const { return trigger_ != Trigger::none; }
+  Trigger trigger() const { return trigger_; }
+  const std::string& numbers() const { return numbers_; }
+  const std::vector<double>& windows() const { return windows_; }
+
+  // `seconds` since the game started; `swaps` its swaps a second over the last second.
+  Trigger Second(double seconds, double swaps) {
+    if (!active_ || decided() || seconds < kWarmupSeconds) return Trigger::none;
+    const long window = long((seconds - kWarmupSeconds) / kWindowSeconds);
+    if (window != window_) {
+      Close();
+      window_ = window;
+    }
+    sum_ += swaps;
+    ++count_;
+    return trigger_;
+  }
+  // `floor_hit`: fix 117b's or 117d's floor; `detail` goes into the verdict.
+  Trigger Memory(bool floor_hit, const std::string& detail) {
+    if (!active_ || decided() || !floor_hit) return Trigger::none;
+    trigger_ = Trigger::memory;
+    numbers_ = detail;
+    return trigger_;
+  }
+
+ private:
+  void Close() {
+    if (count_ >= kWindowSeconds / 2) {
+      const double mean = sum_ / count_;
+      if (mean >= kPlaying) {
+        windows_.push_back(mean);
+        if (windows_.size() > kWindows) windows_.erase(windows_.begin());
+        if (windows_.size() == kWindows && Median(windows_) < kMinSwaps) {
+          trigger_ = Trigger::speed;
+          char text[160];
+          std::snprintf(text, sizeof(text), "median %.1f game swaps/s over %zu windows of %d s (", Median(windows_),
+                        windows_.size(), kWindowSeconds);
+          numbers_ = text;
+          for (size_t i = 0; i < windows_.size(); ++i) {
+            std::snprintf(text, sizeof(text), "%s%.1f", i ? " " : "", windows_[i]);
+            numbers_ += text;
+          }
+          numbers_ += "), under " + std::to_string(int(kMinSwaps));
+        }
+      }
+    }
+    sum_ = 0;
+    count_ = 0;
+  }
+  bool active_ = false;
+  Trigger trigger_ = Trigger::none;
+  std::string numbers_;
+  std::vector<double> windows_;
+  long window_ = -1;
+  double sum_ = 0;
+  int count_ = 0;
+};
+
+// The running game's watch, its title and whether the player was told (once a session).
+struct Session {
+  Watch watch;
+  std::string title;
+  bool reported = false;
+  void Begin(const std::string& title_id, bool active) {
+    title = title_id;
+    reported = false;
+    watch.Begin(active);
+  }
+};
+inline Session& session() {
+  static Session* s = new Session();
+  return *s;
+}
+
+}  // namespace xbox360ps5::auto_scale
