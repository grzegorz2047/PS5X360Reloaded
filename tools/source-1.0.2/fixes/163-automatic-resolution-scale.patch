+std::string ScaleVerdict(const std::string& title_id) {
+  if (title_id.empty()) return {};
+  std::ifstream input(kStorage / "game-settings" / (title_id + ".scale.txt"));
+  std::string line;
+  std::getline(input, line);
+  return line;
+}
+bool SaveScaleVerdict(const std::string& title_id, const std::string& text) {
+  if (title_id.empty()) return false;
+  std::error_code error;
+  fs::create_directories(kStorage / "game-settings", error);
+  std::ofstream output(kStorage / "game-settings" / (title_id + ".scale.txt"), std::ios::trunc);
+  output << text << "\n";
+  output.flush();
+  return output.good();
+}
+void ClearScaleVerdict(const std::string& title_id) {
+  if (title_id.empty()) return;
+  std::error_code error;
+  fs::remove(kStorage / "game-settings" / (title_id + ".scale.txt"), error);
+}
