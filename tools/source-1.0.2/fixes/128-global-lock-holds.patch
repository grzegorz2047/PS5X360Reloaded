+// Fix 128: who holds the global critical region for long. Fix 88's sample above says where the
+// GPU command thread takes the lock, not who keeps it waiting. Kinect Sports (4D5308C9) on
+// 1.0.5-work-fix119 while it records its replay: the GPU thread waited 643-662 ms/s for the lock,
+// 216 sleeps a second of about 3 ms, so another thread held it most of the time.
+//
+// Every thread's outermost hold of the region (xe_global_mutex, the plain and the "Fast locks"
+// mutex alike) is timed with the TSC: from just after the lock is won to just before it is let go.
+// A hold of kLongHoldMs or more is counted for its caller (the return address into the code that
+// asked for the lock, as fix 88's) and its thread: count, time, the longest. It is recorded while
+// the lock is still held, so the recorders never race one another; the summary reads the table
+// with relaxed loads. Every hold costs two TSC reads and a compare.
+namespace xbox360ps5 {
+namespace global_lock_holds {
+
+inline constexpr double kLongHoldMs = 1.0;
+// TSC ticks in kLongHoldMs: a guess until the first summary measures the rate.
+inline std::atomic<uint64_t> long_ticks{2000000};
+inline void SetTicksPerMs(double ticks_per_ms) {
+  if (ticks_per_ms > 0) long_ticks.store(uint64_t(ticks_per_ms * kLongHoldMs), std::memory_order_relaxed);
+}
+
+inline constexpr uint32_t kSlots = 128;
+struct Slot {
+  std::atomic<uintptr_t> caller{0};
+  std::atomic<uint64_t> thread{0};
+  std::atomic<uint64_t> holds{0}, ticks{0}, max_ticks{0};
+};
+inline std::array<Slot, kSlots> slots;
+inline std::atomic<uint64_t> dropped{0}, long_holds{0}, long_hold_ticks{0};
+inline void Bump(std::atomic<uint64_t>& counter, uint64_t value) {
+  counter.store(counter.load(std::memory_order_relaxed) + value, std::memory_order_relaxed);
+}
+
+// With the lock held, by its holder only.
+inline void Record(uintptr_t caller, uint64_t thread, uint64_t ticks) {
+  Bump(long_holds, 1);
+  Bump(long_hold_ticks, ticks);
+  uint32_t index = uint32_t(((caller >> 2) ^ (thread >> 4)) * 0x9E3779B1u) % kSlots;
+  for (uint32_t probe = 0; probe < kSlots; ++probe, index = (index + 1) % kSlots) {
+    Slot& slot = slots[index];
+    const uintptr_t held = slot.caller.load(std::memory_order_relaxed);
+    if (!held) {
+      slot.thread.store(thread, std::memory_order_relaxed);
+      slot.caller.store(caller, std::memory_order_release);
+    } else if (held != caller || slot.thread.load(std::memory_order_relaxed) != thread) {
+      continue;
+    }
+    Bump(slot.holds, 1);
+    Bump(slot.ticks, ticks);
+    if (ticks > slot.max_ticks.load(std::memory_order_relaxed)) slot.max_ticks.store(ticks, std::memory_order_relaxed);
+    return;
+  }
+  Bump(dropped, 1);
+}
+
+// The current hold, kept in the mutex; only its holder reads or writes it.
+struct Holder {
+  uint64_t thread = 0;
+  uint32_t depth = 0;
+  uint64_t start = 0;
+  uintptr_t caller = 0;
+};
+// Just after `self` has won the lock.
+inline void Acquired(Holder& holder, uint64_t self, uintptr_t caller, uint64_t now) {
+  if (holder.depth && holder.thread == self) {
+    ++holder.depth;
+    return;
+  }
+  holder.thread = self;
+  holder.depth = 1;
+  holder.start = now;
+  holder.caller = caller;
+}
+// Just before the lock is let go: the outermost release times the hold.
+inline void Releasing(Holder& holder, uint64_t now) {
+  if (!holder.depth || --holder.depth) return;
+  const uint64_t ticks = now - holder.start;
+  if (ticks >= long_ticks.load(std::memory_order_relaxed)) Record(holder.caller, holder.thread, ticks);
+}
+
+// "Performance: global lock holds of 1 ms or more (every thread): n/s, x ms/s held; by caller and
+// thread: 0x... 'name' n/s, t ms/s, longest m ms; ...; k without a slot; anchor 0x..." since the
+// previous line, the kShown that held it longest (the same anchor as fix 88's line).
+inline constexpr uint32_t kShown = 6;
+class Reporter {
+ public:
+  std::string Line(double seconds, double ticks_per_ms, uintptr_t anchor,
+                   const std::function<std::string(uint64_t)>& name_of) {
+    if (seconds <= 0) seconds = 1;
+    SetTicksPerMs(ticks_per_ms);
+    const double ms_per_tick = ticks_per_ms > 0 ? 1.0 / ticks_per_ms : 0.0;
+    struct Row {
+      uintptr_t caller;
+      uint64_t thread, holds, ticks, max_ticks;
+    };
+    std::array<Row, kSlots> rows{};
+    for (uint32_t i = 0; i < kSlots; ++i) {
+      const uint64_t holds = slots[i].holds.load(std::memory_order_relaxed);
+      const uint64_t ticks = slots[i].ticks.load(std::memory_order_relaxed);
+      const uint64_t max = slots[i].max_ticks.exchange(0, std::memory_order_relaxed);
+      rows[i] = {slots[i].caller.load(std::memory_order_acquire), slots[i].thread.load(std::memory_order_relaxed),
+                 holds - last_[i][0], ticks - last_[i][1], max};
+      last_[i][0] = holds;
+      last_[i][1] = ticks;
+    }
+    std::sort(rows.begin(), rows.end(), [](const Row& a, const Row& b) { return a.ticks > b.ticks; });
+    const uint64_t all = long_holds.load(std::memory_order_relaxed);
+    const uint64_t all_ticks = long_hold_ticks.load(std::memory_order_relaxed);
+    char head[192];
+    std::snprintf(head, sizeof(head),
+                  "Performance: global lock holds of %.0f ms or more (every thread): %.1f/s, %.1f ms/s held; by caller "
+                  "and thread: ",
+                  kLongHoldMs, double(all - last_all_) / seconds,
+                  double(all_ticks - last_all_ticks_) * ms_per_tick / seconds);
+    last_all_ = all;
+    last_all_ticks_ = all_ticks;
+    std::string text = head;
+    uint32_t shown = 0;
+    for (const Row& row : rows) {
+      if (shown == kShown || !row.holds) break;
+      const std::string name = name_of ? name_of(row.thread) : std::string();
+      char item[256];
+      std::snprintf(item, sizeof(item), "%s0x%llx '%s' %.1f/s, %.1f ms/s, longest %.1f ms", shown ? "; " : "",
+                    (unsigned long long)row.caller, name.c_str(), double(row.holds) / seconds,
+                    double(row.ticks) * ms_per_tick / seconds, double(row.max_ticks) * ms_per_tick);
+      text += item;
+      ++shown;
+    }
+    char tail[96];
+    std::snprintf(tail, sizeof(tail), "%s%llu without a slot; anchor 0x%llx", shown ? "; " : "",
+                  (unsigned long long)dropped.load(std::memory_order_relaxed), (unsigned long long)anchor);
+    return text + tail;
+  }
+
+ private:
+  std::array<std::array<uint64_t, 2>, kSlots> last_{};
+  uint64_t last_all_ = 0, last_all_ticks_ = 0;
+};
+
+}  // namespace global_lock_holds
+}  // namespace xbox360ps5
