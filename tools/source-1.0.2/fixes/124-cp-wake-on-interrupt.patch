+++ b/.deps/xenia-canary/src/xenia/gpu/interrupt_wake.h
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: MIT
+// Xbox360PS5 (fix 124, CP wake on interrupt): wakes the GPU command thread's memory waits
+// (WAIT_REG_MEM on memory) as soon as a guest interrupt callback returns, instead of on the next
+// 100 us poll of fix 83.
+//
+// The Sims 3's present code makes the GPU wait every frame for a word that only the game's vblank
+// interrupt callback writes (SCRATCH_REG1's writeback, cleared once the queued flip's vblank has
+// come). The callback runs on the thread that dispatches the interrupt; the command thread notices
+// the word on its next poll. Notify() after each callback and WaitAfter() in the polling loop
+// end the wait right after it: the same vblank, the game's pacing unchanged. A write by any other
+// guest thread is still seen by the poll, at the latest one slice later.
+#ifndef XENIA_GPU_INTERRUPT_WAKE_H_
+#define XENIA_GPU_INTERRUPT_WAKE_H_
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <mutex>
+
+namespace xe {
+namespace gpu {
+namespace interrupt_wake {
+
+inline uint64_t SteadyNs() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                      std::chrono::steady_clock::now().time_since_epoch())
+                      .count());
+}
+
+class Waker {
+ public:
+  // An interrupt callback has returned (any thread). The count changes under the mutex, so a
+  // waiter that read the old count before waiting cannot miss it.
+  void Notify() {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      last_ns_.store(SteadyNs(), std::memory_order_relaxed);
+      seq_.store(seq_.load(std::memory_order_relaxed) + 1, std::memory_order_release);
+    }
+    cv_.notify_all();
+  }
+  // The interrupts so far; read it before reading the awaited word.
+  uint64_t Seq() const { return seq_.load(std::memory_order_acquire); }
+  // When the latest interrupt callback returned (SteadyNs).
+  uint64_t LastNs() const { return last_ns_.load(std::memory_order_relaxed); }
+  // Waits for `slice` at most, or until an interrupt after `seen`; true if one came.
+  template <class Rep, class Period>
+  bool WaitAfter(uint64_t seen, std::chrono::duration<Rep, Period> slice) {
+    std::unique_lock<std::mutex> lock(mutex_);
+    return cv_.wait_for(lock, slice, [&] { return seq_.load(std::memory_order_relaxed) != seen; });
+  }
+
+ private:
+  std::mutex mutex_;
+  std::condition_variable cv_;
+  std::atomic<uint64_t> seq_{0};
+  std::atomic<uint64_t> last_ns_{0};
+};
+
+}  // namespace interrupt_wake
+}  // namespace gpu
+}  // namespace xe
+
+#endif  // XENIA_GPU_INTERRUPT_WAKE_H_
