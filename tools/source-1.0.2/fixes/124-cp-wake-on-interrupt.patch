diff --git a/include/xbox360ps5/frame_cost.hpp b/include/xbox360ps5/frame_cost.hpp
--- a/include/xbox360ps5/frame_cost.hpp
+++ b/include/xbox360ps5/frame_cost.hpp
@@ -969,6 +969,54 @@ class WaitRegTimer {
   uint32_t wait_;
   uint64_t start_ = 0, slept_ = 0, polls_ = 0, sleeps_ = 0;
 };
+// Fix 124 (CP wake on interrupt, xenia/gpu/interrupt_wake.h): the GPU thread's memory waits that
+// slept, those during which a guest interrupt callback returned, the time from the latest such
+// callback to the wait's end, and the 100 us polls an interrupt cut short. "Performance interrupt
+// wake (GPU thread, fix 124, on): n/s memory waits slept, k/s ended after an interrupt callback,
+// x us from the callback to the wait's end on average (max y us), e/s polls cut short".
+inline std::atomic<bool> wake_mode_on{false};
+inline std::atomic<uint64_t> wake_memory_waits{0}, wake_after_interrupt{0}, wake_latency_ns{0},
+    wake_latency_max_ns{0}, wake_early{0};
+inline void NoteInterruptWake(bool on, bool after_interrupt, uint64_t latency_ns, uint64_t early) {
+  if (!OnGpuThread()) return;
+  wake_mode_on.store(on, std::memory_order_relaxed);
+  AddOwn(wake_memory_waits, 1);
+  if (after_interrupt) {
+    AddOwn(wake_after_interrupt, 1);
+    AddOwn(wake_latency_ns, latency_ns);
+    if (latency_ns > wake_latency_max_ns.load(std::memory_order_relaxed))
+      wake_latency_max_ns.store(latency_ns, std::memory_order_relaxed);
+  }
+  if (early) AddOwn(wake_early, early);
+}
+class InterruptWakeReporter {
+ public:
+  std::string Line(double seconds) {
+    const double s = seconds > 0 ? seconds : 1;
+    const uint64_t w = wake_memory_waits.load(std::memory_order_relaxed);
+    const uint64_t a = wake_after_interrupt.load(std::memory_order_relaxed);
+    const uint64_t l = wake_latency_ns.load(std::memory_order_relaxed);
+    const uint64_t e = wake_early.load(std::memory_order_relaxed);
+    const uint64_t max = wake_latency_max_ns.exchange(0, std::memory_order_relaxed);
+    const uint64_t dw = w - last_waits_, da = a - last_after_, dl = l - last_latency_, de = e - last_early_;
+    last_waits_ = w;
+    last_after_ = a;
+    last_latency_ = l;
+    last_early_ = e;
+    char line[256];
+    std::snprintf(line, sizeof(line),
+                  "Performance interrupt wake (GPU thread, fix 124, %s): %.0f/s memory waits slept, %.0f/s ended "
+                  "after an interrupt callback, %.0f us from the callback to the wait's end on average (max %.0f "
+                  "us), %.0f/s polls cut short",
+                  wake_mode_on.load(std::memory_order_relaxed) ? "on" : "off", double(dw) / s, double(da) / s,
+                  da ? double(dl) / double(da) / 1000.0 : 0.0, double(max) / 1000.0, double(de) / s);
+    return line;
+  }
+
+ private:
+  uint64_t last_waits_ = 0, last_after_ = 0, last_latency_ = 0, last_early_ = 0;
+};
