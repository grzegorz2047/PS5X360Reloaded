     std::lock_guard<std::mutex> lock(mutex_);
-    return totals_[size_t(kind)];
+    return totals_[size_t(kind)] +
+           counted_[size_t(kind)].load(std::memory_order_relaxed);  // fix 110
+  }
+  // Fix 110: a write only counted, not kept in the recent writes or the
+  // targets. For the screen extents (EVENT_WRITE_EXT), which Red Dead
+  // Redemption writes for most draws (36,000 to 51,000 a second, each to its
+  // own address): each Record took the clock, the mutex and two scans of the
+  // 32 targets, 0.57 us a packet, and pushed every other write out of the
+  // STALL report. The GPU thread is the only writer.
+  void Count(Kind kind) {
+    std::atomic<uint64_t>& counted = counted_[size_t(kind)];
+    counted.store(counted.load(std::memory_order_relaxed) + 1,
