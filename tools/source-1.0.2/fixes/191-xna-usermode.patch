+#include "xenia/base/platform.h"
+
+#if XE_ARCH_AMD64
+
+// SysV AMD64 context switch (Linux x86-64 and PS5 FreeBSD x86-64).
+// Saves/restores MXCSR, x87 FCW, and callee-saved GPRs r12-r15, rbx, rbp.
+// Argument 0 (%rdi): void** from_fctx_slot (receives suspended %rsp).
+// Argument 1 (%rsi): void*  to_fctx        (resumed %rsp).
+__asm__(
+    ".text\n"
+    ".p2align 4\n"
+    ".globl xe_switch_fcontext\n"
+    ".hidden xe_switch_fcontext\n"
+    "xe_switch_fcontext:\n"
+    "  subq $0x38, %rsp\n"
+    "  stmxcsr (%rsp)\n"
+    "  fnstcw 4(%rsp)\n"
+    "  movq %r12, 0x08(%rsp)\n"
+    "  movq %r13, 0x10(%rsp)\n"
+    "  movq %r14, 0x18(%rsp)\n"
+    "  movq %r15, 0x20(%rsp)\n"
+    "  movq %rbx, 0x28(%rsp)\n"
+    "  movq %rbp, 0x30(%rsp)\n"
+    "  movq %rsp, (%rdi)\n"
+    "  movq %rsi, %rsp\n"
+    "  ldmxcsr (%rsp)\n"
+    "  fldcw 4(%rsp)\n"
+    "  movq 0x08(%rsp), %r12\n"
+    "  movq 0x10(%rsp), %r13\n"
+    "  movq 0x18(%rsp), %r14\n"
+    "  movq 0x20(%rsp), %r15\n"
+    "  movq 0x28(%rsp), %rbx\n"
+    "  movq 0x30(%rsp), %rbp\n"
+    "  addq $0x38, %rsp\n"
+    "  retq\n"
+    "\n"
+    ".p2align 4\n"
+    ".globl xe_fiber_entry_stub\n"
+    ".hidden xe_fiber_entry_stub\n"
+    "xe_fiber_entry_stub:\n"
+    "  xorl %ebp, %ebp\n"
+    "  movq %r12, %rdi\n"
+    "  callq *%r13\n"
+    "  ud2\n"
+#if defined(__linux__)
+    ".section .note.GNU-stack,\"\",@progbits\n"
+#endif
+);
+
+extern "C" void xe_switch_fcontext(void** from_fctx_slot, void* to_fctx);
+extern "C" void xe_fiber_entry_stub();
+
+namespace xe {
+namespace threading {
+namespace {
+
+using namespace xe::literals;
+
+constexpr size_t kDefaultFiberStackSize = 2_MiB;
+
+struct FiberContextFrame {
+  uint32_t mxcsr;
+  uint32_t fcw;
+  uint64_t r12;
+  uint64_t r13;
+  uint64_t r14;
+  uint64_t r15;
+  uint64_t rbx;
+  uint64_t rbp;
+  uint64_t rip;
+};
+static_assert(sizeof(FiberContextFrame) == 0x40,
+              "FiberContextFrame must match xe_switch_fcontext layout");
+
+struct FiberStack {
+  uint8_t* base = nullptr;
+  size_t total_size = 0;
+  size_t guard_size = 0;
+  uint8_t* high = nullptr;
+};
+
+// Allocates through xe::memory::AllocFixed rather than anonymous mmap so PS5
+// builds draw from direct memory instead of the 448 MiB flexible budget.
+FiberStack AllocFiberStack(size_t requested_size) {
+  const size_t page = xe::memory::page_size();
+  const size_t usable = xe::round_up(
+      requested_size ? requested_size : kDefaultFiberStackSize, page);
+  const size_t total = usable + page;
+  auto* base = static_cast<uint8_t*>(xe::memory::AllocFixed(
+      nullptr, total, xe::memory::AllocationType::kReserveCommit,
+      xe::memory::PageAccess::kReadWrite));
+  assert_not_null(base);
+  // Guard floor page at the low end of the downward-growing stack.
+  xe::memory::Protect(base, page, xe::memory::PageAccess::kNoAccess);
+  FiberStack stack;
+  stack.base = base;
+  stack.total_size = total;
+  stack.guard_size = page;
+  stack.high = base + total;
+  return stack;
+}
+
+void FreeFiberStack(FiberStack& stack) {
+  if (!stack.base) {
+    return;
+  }
+  if (stack.guard_size) {
+    xe::memory::Protect(stack.base, stack.guard_size,
+                        xe::memory::PageAccess::kReadWrite);
+  }
+  xe::memory::DeallocFixed(stack.base, stack.total_size,
+                           xe::memory::DeallocationType::kRelease);
+  stack = {};
+}
+
+class FcontextFiber final : public Fiber {
+ public:
+  // Adopted thread fiber.
+  FcontextFiber() = default;
+
+  // Newly created fiber with its own host stack.
+  FcontextFiber(size_t stack_size, std::function<void()> start_routine)
+      : entry_(std::move(start_routine)), owns_stack_(true) {
+    stack_ = AllocFiberStack(stack_size);
+    ResetContext();
+  }
+
+  ~FcontextFiber() override {
+    if (current_fiber_ == this) {
+      current_fiber_ = nullptr;
+    }
+    if (owns_stack_) {
+      FreeFiberStack(stack_);
+    }
+  }
+
+  static Fiber* Current() { return current_fiber_; }
+
+  static std::unique_ptr<Fiber> AdoptCurrentThread() {
+    assert_null(current_fiber_);
+    auto fiber = std::make_unique<FcontextFiber>();
+    current_fiber_ = fiber.get();
+    return fiber;
+  }
+
+  void SwitchTo() override {
+    assert_false(terminated_);
+    FcontextFiber* prev = current_fiber_;
+    assert_not_null(prev);
+    if (prev == this) {
+      return;
+    }
+    current_fiber_ = this;
+    xe_switch_fcontext(&prev->fctx_, fctx_);
+  }
+
+  void SetTerminated() override { terminated_ = true; }
+
+  void Restart() override {
+    assert_true(owns_stack_);
+    assert_true(current_fiber_ != this);
+    ResetContext();
+    terminated_ = false;
+  }
+
+ private:
+  void ResetContext() {
+    uintptr_t top = reinterpret_cast<uintptr_t>(stack_.high) & ~uintptr_t(0xF);
+    auto* frame = reinterpret_cast<FiberContextFrame*>(top - sizeof(FiberContextFrame));
+    std::memset(frame, 0, sizeof(*frame));
+    frame->mxcsr = 0x1F80;
+    frame->fcw = 0x037F;
+    frame->r12 = reinterpret_cast<uint64_t>(this);
+    frame->r13 = reinterpret_cast<uint64_t>(&FcontextFiber::RunEntry);
+    frame->rip = reinterpret_cast<uint64_t>(&xe_fiber_entry_stub);
+    fctx_ = frame;
+  }
+
+  static void RunEntry(void* raw_self) {
+    auto* self = static_cast<FcontextFiber*>(raw_self);
+    self->entry_();
+    self->terminated_ = true;
+    assert_always("Fiber start routine returned without switching away");
+  }
+
+  static thread_local FcontextFiber* current_fiber_;
+
+  void* fctx_ = nullptr;
+  FiberStack stack_;
+  std::function<void()> entry_;
+  bool owns_stack_ = false;
+  bool terminated_ = false;
+};
+
+thread_local FcontextFiber* FcontextFiber::current_fiber_ = nullptr;
+
+}  // namespace
+
+std::unique_ptr<Fiber> Fiber::CreateFromThread() {
+  return FcontextFiber::AdoptCurrentThread();
+}
+
+std::unique_ptr<Fiber> Fiber::Create(CreationParameters params,
+                                     std::function<void()> start_routine) {
+  return std::make_unique<FcontextFiber>(params.stack_size,
+                                         std::move(start_routine));
+}
+
+Fiber* Fiber::GetCurrentFiber() { return FcontextFiber::Current(); }
+
+}  // namespace threading
+}  // namespace xe
+
+#endif  // XE_ARCH_AMD64
