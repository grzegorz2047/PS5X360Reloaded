+// 1.0.5: opening the guide saves the last 10 s of phone motion (motion_record.hpp) to the logs
+// folder, for tools/check-motion-replay.cpp on a PC: make the move, then open the guide.
+static void SaveMotionRecording(const std::filesystem::path& folder) {
+  if (!xbox360ps5::motion::enabled.load() || folder.empty()) return;
+  const std::vector<uint8_t> bytes = xbox360ps5::motion::motion_recorder.Take();
+  if (bytes.empty()) return;
+  char name[64];
+  const std::time_t now = std::time(nullptr);
+  std::tm utc{};
+  gmtime_r(&now, &utc);
+  std::strftime(name, sizeof(name), "motion-%Y%m%d-%H%M%S-UTC.xmr", &utc);
+  const std::filesystem::path path = folder / name;
+  std::ofstream out(path, std::ios::binary | std::ios::trunc);
+  out.write(reinterpret_cast<const char*>(bytes.data()), std::streamsize(bytes.size()));
+  out.close();
+  XELOGW("Motion: the last {} frames of phone motion saved to {}{}",
+         (bytes.size() - 12) / xbox360ps5::motion::kRecordBytes, path.string(),
+         out ? "" : " (the file could not be written)");
+}
