+// SPDX-License-Identifier: MIT
+// Fix 63: the motion panel over a running game shows how to connect a phone while none is.
+//
+// With "Camera motion" on, the panel at the top right showed "Motion: waiting / body lost" and
+// an empty frame until a phone sent joints, and nothing in the game said how to connect one:
+// the QR code was only in the library. Now, while no phone frame has arrived for a few
+// seconds (none since the setting was turned on, or the phone stopped sending), the panel
+// shows the library's camera QR code (the settings server's /camera page with the key, which
+// pairs and connects by itself, fix 56), the pairing code in large text and a short
+// instruction, in the panel's own place and size. Frames arriving bring the skeleton back;
+// a phone that stops brings the code back. A phone that sends frames without a body
+// ("body lost") is connected: the skeleton view stays.
+#pragma once
+#include <chrono>
+#include <cmath>
+#include <string>
+
+namespace xbox360ps5::motion {
+
+// How long without a frame counts as no phone. The phone sends about 30 frames a second;
+// a few seconds covers a short Wi-Fi stall without the code flashing up.
+constexpr std::chrono::milliseconds kPhoneQuiet{3000};
+
+enum class PanelView { kSkeleton, kPhoneQr };
+
+// received: when the latest phone frame arrived (Snapshot().received; the epoch when none
+// has since the setting was turned on). url: the camera page's link, empty when the
+// settings server has no address or key (then there is no code to show).
+inline PanelView ChoosePanelView(std::chrono::steady_clock::time_point received,
+                                 std::chrono::steady_clock::time_point now,
+                                 const std::string& url) {
+  if (url.empty()) return PanelView::kSkeleton;
+  if (received == std::chrono::steady_clock::time_point{} || now < received) return PanelView::kPhoneQr;
+  return now - received > kPhoneQuiet ? PanelView::kPhoneQr : PanelView::kSkeleton;
+}
+
+// Where the "no phone" view draws, in 1080p units (the overlay scales by the screen's height):
+// inside the motion panel's own box, which it does not grow.
+struct QrPanelLayout {
+  float left = 1550, top = 100, right = 1900, bottom = 640;  // the panel (unchanged)
+  float text_x = 1570, title_y = 112, title_size = 22;
+  float card_x = 1620, card_y = 146, card = 210;             // white card under the code
+  float code_y = 370, code_size = 40;                        // "Code: <key>"
+  float text_y = 428, text_size = 22, text_width = 312;      // how to stand, wrapped
+};
+constexpr QrPanelLayout kQrPanel{};
+// "Motion panel: Top left": the same box moved to x 24-374 (below the FPS counter, which ends
+// at y 94), for games that draw their own camera view at the top right (Dragon Ball Z).
+constexpr float kQrPanelLeftShift = 24 - 1550;
+// 1.0.5_candidate_10: the panel's skeleton is a mirror, as the player expects: their left hand on
+// the left. The phone's (and the game's) X grows towards the player's left, which the panel drew
+// on the right, as a camera sees them ("my left should be the skeleton's left", DBZ on
+// 1.0.5_candidate_8). Only the drawing turns; the game gets the skeleton as before.
+inline float PanelMirrorX(float centre, float joint_x, float pixels_per_metre) {
+  return centre - joint_x * pixels_per_metre;
+}
+
+// Whole pixels per QR module on a card of `card` units at `scale` (8 units of white margin
+// each side); 0 when the code does not fit.
+inline float QrModulePixels(int modules, float card, float scale) {
+  if (modules <= 0) return 0;
+  const float module = std::floor((card - 16) * scale / float(modules));
+  return module >= 1 ? module : 0;
+}
+
+// The library's camera QR link (launcher.cpp CameraQr): <plain address>camera?k=<key>.
+inline std::string CameraPageUrl(const std::string& plain, const std::string& key) {
+  return plain.empty() || key.empty() ? std::string() : plain + "camera?k=" + key;
+}
+
+}  // namespace xbox360ps5::motion
