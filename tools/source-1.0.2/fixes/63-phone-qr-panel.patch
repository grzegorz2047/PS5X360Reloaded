+  // a direction the game is counting is drawn brighter.
+  void DrawTargetArms(ImDrawList* draw, float scale, const xbox360ps5::motion::Frame& pose,
+                      const xbox360ps5::motion::GameHands& hands) {
+    draw->PushClipRect(ImVec2((1550 + shift_) * scale, 185 * scale), ImVec2((1900 + shift_) * scale, 565 * scale), true);
+    for (int side = 0; side < 2; ++side) {
