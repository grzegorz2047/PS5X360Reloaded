+// SPDX-License-Identifier: MIT
+// Fix 126: the performance sampler's request to one thread, answered from that thread's signal
+// handler (platform/ps5/crash_report.cpp, SampleThread and Probe).
+//
+// The sampler used to hand the handler a pointer to its sample and, when no answer came within
+// 20 ms, wait another 100 ms so that a late answer could not write into a sample that was gone.
+// A thread that takes signals late (Grand Theft Auto IV's F8001014, in a system call: 42 answers
+// in 94 rounds on 1.0.5-work-fix120) so cost every round 120 ms, and MEASURE took 94 rounds in
+// 10 s instead of about 1,000. Now each request has a round number and its target thread: the
+// handler answers only the pending request addressed to it, and a request the sampler gave up on
+// is cancelled, so a late answer finds nothing to write into and the sampler moves on at once.
+//
+// State: round << 2 | phase, phase 1 asked, 2 claimed (the handler is writing the sample),
+// 3 answered, 0 cancelled. Lock-free atomics only, so the handler side is async-signal-safe.
+#ifndef XBOX360PS5_SAMPLE_TICKET_HPP_
+#define XBOX360PS5_SAMPLE_TICKET_HPP_
+
+#include <atomic>
+#include <cstdint>
+#include <thread>
+
+namespace xbox360ps5 {
+namespace sample_ticket {
+
+class Ticket {
+ public:
+  // Sampler: a new request to `target`; returns its round.
+  uint64_t Ask(uintptr_t target) {
+    target_.store(target, std::memory_order_relaxed);
+    const uint64_t round = round_.fetch_add(1, std::memory_order_relaxed) + 1;
+    state_.store(round << 2 | 1, std::memory_order_release);
+    return round;
+  }
+  // Handler (signal context) on thread `self`: true when this call answers the pending request;
+  // it then writes the sample and calls Done(claimed).
+  bool Claim(uintptr_t self, uint64_t& claimed) {
+    uint64_t state = state_.load(std::memory_order_acquire);
+    if ((state & 3) != 1 || target_.load(std::memory_order_relaxed) != self) return false;
+    if (!state_.compare_exchange_strong(state, (state & ~uint64_t(3)) | 2, std::memory_order_acq_rel)) return false;
+    claimed = state;
+    return true;
+  }
+  void Done(uint64_t claimed) { state_.store((claimed & ~uint64_t(3)) | 3, std::memory_order_release); }
+  // Sampler: the answer has come.
+  bool Answered(uint64_t round) const { return state_.load(std::memory_order_acquire) == (round << 2 | 3); }
+  // Sampler, at the end of its wait: true when the sample is there to read; false when the request
+  // was still unclaimed and is now cancelled (a later answer is dropped). A handler that has
+  // claimed it is running and is waited for: it only copies a few words.
+  bool Finish(uint64_t round) {
+    uint64_t asked = round << 2 | 1;
+    if (state_.compare_exchange_strong(asked, round << 2, std::memory_order_acq_rel)) return false;
+    while (!Answered(round)) std::this_thread::yield();
+    return true;
+  }
+
+ private:
+  std::atomic<uint64_t> state_{0}, round_{0};
+  std::atomic<uintptr_t> target_{0};
+};
+
+}  // namespace sample_ticket
+}  // namespace xbox360ps5
+
+#endif  // XBOX360PS5_SAMPLE_TICKET_HPP_
