 constexpr uint32_t kEmergencyPadUser = 0;  // player 1
 inline bool FeedsEmergency(uint32_t user) { return user == kEmergencyPadUser; }
 
-// One pad sample of player slot `user`. True when it ends a brief L3 + R3 press of player 1's
-// pad (a re-centre request); a sample of another slot changes nothing and is never a press.
+// Fix 196b: the slot that feeds the detector given the connected slots (bit n: slot n): the lowest
+// connected one, player 1's when none is.
+inline uint32_t EmergencySlot(uint32_t connected_slots) {
+  for (uint32_t slot = 0; slot < 32; ++slot)
+    if (connected_slots & (1u << slot)) return slot;
+  return kEmergencyPadUser;
+}
+inline std::atomic<uint32_t> emergency_pads_connected{0};  // fix 196b: bit n, slot n's pad
+
+// One pad sample of player slot `user`. True when it ends a brief L3 + R3 press of the pad that
+// feeds the detector (a re-centre request); a sample of another slot changes nothing and is never
+// a press.
