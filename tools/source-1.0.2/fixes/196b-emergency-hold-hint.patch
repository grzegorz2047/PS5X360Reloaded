                                std::chrono::steady_clock::time_point now) {
-  if (!FeedsEmergency(user)) return false;
+  if (user < 32) {
+    if (connected) emergency_pads_connected.fetch_or(1u << user);
+    else emergency_pads_connected.fetch_and(~(1u << user));
+  }
+  if (user != EmergencySlot(emergency_pads_connected.load())) return false;
   return pose.Pad(connected && (buttons & kEmergencyButtons) == kEmergencyButtons, now);
