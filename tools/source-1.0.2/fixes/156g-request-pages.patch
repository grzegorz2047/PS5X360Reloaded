+  // Fix 156g (Kinect Sports Season Two, #63): a request block the title passes in only has
+  // to be readable. Season Two's read requests sit in its image's data (83507E78-83508080);
+  // at a sport's load that page stopped being writable in the page table, and the camera
+  // refused every read on it, at completion and on resubmission (INVALID_PARAMETER): after 5
+  // failed reads the title read no frame again and the loading screen never ended. The
+  // console's driver writes its replies regardless of the caller's page protection; replies
+  // here go through RequestWriteWindow. The first 8 such pages are logged.
+  bool IsRequestRange(uint32_t address, size_t size) const {
+    if (!IsGuestRange(address, size, false)) return false;
+    if (!IsGuestRange(address, size, true)) {
+      static std::atomic<uint32_t> shown{0};
+      if (shown.fetch_add(1) < 8) {
+        auto* heap = memory_->LookupHeap(address);
+        uint32_t protection = 0;
+        if (heap) heap->QueryProtect(address, &protection);
+        XELOGW("Virtual Kinect: request {:08X} is on a page that is not writable "
+               "(protect {:X}); answered anyway (fix 156g)", address, protection);
+      }
+    }
+    return true;
+  }
+  // Fix 156g: makes a request's pages writable while a reply is written into it, and puts
+  // their protection back after.
+  class RequestWriteWindow {
+   public:
+    RequestWriteWindow(Memory* memory, uint32_t address, size_t size) {
+      if (!address || !size || uint64_t(address) + size > 0x100000000ull) return;
+      for (uint64_t at = address; at < uint64_t(address) + size && count_ < 2;
+           at = (at & ~uint64_t(4095)) + 4096) {
+        auto* heap = memory->LookupHeap(uint32_t(at));
+        uint32_t protection = 0;
+        if (!heap || !heap->QueryProtect(uint32_t(at), &protection) ||
+            !(protection & kMemoryProtectRead) || (protection & kMemoryProtectWrite))
+          continue;
+        if (heap->Protect(uint32_t(at), 1, protection | kMemoryProtectWrite))
+          pages_[count_++] = {heap, uint32_t(at), protection};
+      }
+    }
+    ~RequestWriteWindow() {
+      for (uint32_t n = count_; n-- > 0;)
+        pages_[n].heap->Protect(pages_[n].address, 1, pages_[n].protection);
+    }
+    RequestWriteWindow(const RequestWriteWindow&) = delete;
+    RequestWriteWindow& operator=(const RequestWriteWindow&) = delete;
+
+   private:
+    struct Page {
+      BaseHeap* heap;
+      uint32_t address, protection;
+    } pages_[2] = {};
+    uint32_t count_ = 0;
+  };
