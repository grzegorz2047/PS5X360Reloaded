     std::lock_guard<std::mutex> lock(mutex_);
     files_.erase(path);
   }
+  // Fix 173c: a pipeline made this session (not one of the start's stored ones).
+  void NotePipelineCreated() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    ++created_;
+  }
+  // Fix 173b: the same bytes as on the drive.
   bool Unchanged(const std::string& path, const uint8_t* bytes, size_t size) {
+    return Check(path, bytes, size) == Verdict::kSameBytes;
+  }
+  // Fix 173c: the same bytes, or the same size with no pipeline made since the file was noted.
+  Verdict Check(const std::string& path, const uint8_t* bytes, size_t size) {
+    File file;
+    uint64_t created = 0;
     {
       std::lock_guard<std::mutex> lock(mutex_);
       const auto it = files_.find(path);
-      if (it == files_.end() || it->second.size != size) return false;
+      if (it == files_.end() || it->second.size != size) return Verdict::kWrite;
+      file = it->second;
+      created = created_;
     }
-    const uint64_t hash = Hash(bytes, size);
-    std::lock_guard<std::mutex> lock(mutex_);
-    const auto it = files_.find(path);
-    return it != files_.end() && it->second.size == size && it->second.hash == hash;
+    if (Hash(bytes, size) == file.hash) return Verdict::kSameBytes;
+    return created == file.created_at_note ? Verdict::kSameSizeNoNewPipeline : Verdict::kWrite;
   }
 
  private:
   struct File {
-    uint64_t size = 0, hash = 0;
+    uint64_t size = 0, hash = 0, created_at_note = 0;
   };
   std::mutex mutex_;
   std::unordered_map<std::string, File> files_;
+  uint64_t created_ = 0;
 };
 inline Store& Global() {
   static Store* store = new Store();
   return *store;
 }
 
+// Fix 173c: the <file>.pending-N left by a write cut off (the rename never happened); returns how
+// many were removed.
+inline int RemoveStalePending(const std::filesystem::path& file) {
+  std::error_code error;
+  const std::string prefix = file.filename().string() + ".pending-";
+  int removed = 0;
+  for (std::filesystem::directory_iterator it(file.parent_path(), error), end; !error && it != end;
+       it.increment(error)) {
+    const std::string name = it->path().filename().string();
+    if (name.rfind(prefix, 0) != 0) continue;
+    std::error_code remove_error;
+    if (std::filesystem::remove(it->path(), remove_error)) ++removed;
+  }
+  return removed;
+}
+
 }  // namespace xbox360ps5::pipeline_cache_skip
