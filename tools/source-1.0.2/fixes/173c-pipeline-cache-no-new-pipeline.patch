-// What is on the drive at each cache path.
+// What is on the drive at each cache path, and the pipelines made since it was noted.
+enum class Verdict { kWrite, kSameBytes, kSameSizeNoNewPipeline };
 class Store {
  public:
   void Note(const std::string& path, const uint8_t* bytes, size_t size) {
     const uint64_t hash = Hash(bytes, size);
     std::lock_guard<std::mutex> lock(mutex_);
