diff --git a/.deps/xenia-canary/src/xenia/cpu/backend/x64/x64_backend.cc b/.deps/xenia-canary/src/xenia/cpu/backend/x64/x64_backend.cc
--- a/.deps/xenia-canary/src/xenia/cpu/backend/x64/x64_backend.cc
+++ b/.deps/xenia-canary/src/xenia/cpu/backend/x64/x64_backend.cc
@@ -1568,6 +1568,7 @@ void* X64HelperEmitter::EmitTryAcquireReservationHelper() {
   mov(r8, GetBackendCtxPtr(offsetof(X64BackendContext, reserve_helper_)));
   jc(already_has_a_reservation);
 
+  L(acquire_new_reservation);
   shr(ecx, RESERVE_BLOCK_SHIFT);
   xor_(r9d, r9d);
   mov(edx, ecx);
@@ -1588,8 +1589,17 @@ void* X64HelperEmitter::EmitTryAcquireReservationHelper() {
 
   or_(GetBackendCtxPtr(offsetof(X64BackendContext, flags)), r9d);
   ret();
+  // Fix 192: a load-and-reserve while this thread still holds a reservation.
+  // On PowerPC the new lwarx/ldarx simply replaces the old reservation, so the
+  // old block's bit is given back and the new one is taken. Only rdx and r9
+  // are used here: the callers keep the host address in rax.
   L(already_has_a_reservation);
-  DebugBreak();
+  mov(rdx,
+      GetBackendCtxPtr(offsetof(X64BackendContext, cached_reserve_offset)));
+  mov(r9d, GetBackendCtxPtr(offsetof(X64BackendContext, cached_reserve_bit)));
+  lock();
+  btr(qword[rdx], r9);
+  jmp(acquire_new_reservation, CodeGenerator::T_NEAR);
 
   code_offsets.prolog_stack_alloc = getSize();
   code_offsets.body = getSize();
@@ -1660,10 +1670,21 @@ void* X64HelperEmitter::EmitReservedStoreHelper(bool bit64) {
   cmp(ax, 0x0101);
   ret();
 
-  // could be the same label, but otherwise we don't know where we came from
-  // when one gets triggered
+  // Fix 192: a store-conditional to an address other than the one this
+  // thread reserved. PowerPC allows it (whether it stores is undefined, and
+  // titles use it to drop a reservation: GTA V's lock-free pop stores 0 to its
+  // own stack when the list is empty), so it is no longer a trap. The
+  // reservation is given back, nothing is stored, and the store-conditional
+  // fails: ZF is clear after the compare, as at done when CF is clear.
   L(reservation_isnt_for_our_addr);
-  DebugBreak();
+  mov(rdx,
+      GetBackendCtxPtr(offsetof(X64BackendContext, cached_reserve_offset)));
+  mov(eax, GetBackendCtxPtr(offsetof(X64BackendContext, cached_reserve_bit)));
+  lock();
+  btr(qword[rdx], rax);
+  xor_(eax, eax);
+  cmp(ax, 0x0101);
+  ret();
 
   L(somehow_double_cleared);  // somehow, something else cleared our reserve??
   DebugBreak();
