+// Fix 112d: whether a package in the folder `name` may be a game. A package's own content type
+// folder (8 hex digits, under its title ID's) says what it holds: Games on Demand 00007000, arcade
+// 000D0000, demos 00080000, installed discs 00004000 and 00005000, community games 02000000, game
+// videos... (the types ReadPackage calls a game). Any other one (title updates 000B0000, DLC
+// 00000002, saves 00000001, themes, gamer pictures, avatar items...) holds no game, and its
+// packages are not read by the library's scan (the DLC and update screens find them on their own).
+// A folder of the player's (not 8 hex digits) may hold a game's package.
+inline bool GamePackageFolder(const std::string& name) {
+  if (!PackageFolder(name)) return true;
+  const std::string type = LowerAscii(name);
+  return type == "000d0000" || type == "00080000" || type == "00007000" || type == "00004000" || type == "00005000" ||
+         type == "02000000" || type == "00060000" || type == "000c0000";
+}
