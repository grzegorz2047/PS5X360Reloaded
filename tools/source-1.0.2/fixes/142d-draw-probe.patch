+// Fix 142d (research/parallel-gpu-commands/STAGE2.md, step 2.0): where a draw's "bindings" and
+// "dynamic state and constants" (fix 73) go, and how often a draw's primitive processing, render
+// pass, pipeline and shaders come out as the previous draw's, with the time those calls take
+// either way. Diagnostics only, on the GPU thread. One draw in 8 is timed (as fix 73's, nested
+// sections taken out) and scaled; the counts are every draw's.
+enum BindPart : uint32_t {
+  kBindSystem = 0, kBindClip, kBindTessellation, kBindFloatVertex, kBindFloatPixel, kBindBoolLoop,
+  kBindFetch,  // the seven constant buffers, in UpdateBindings' order
+  kBindConstantSets, kBindImageInfos, kBindReuseCheck, kBindAllocate, kBindUpdateSets, kBindBind,
+  kBindTotal,  // the whole of UpdateBindings
+  kBindDynamicState, kBindSystemConstants, kBindParts
+};
+constexpr uint32_t kBindConstantBuffers = 7;
+inline const char* BindPartName(uint32_t part) {
+  static const char* const names[] = {"system", "clip", "tessellation", "float VS", "float PS",
+                                      "bool/loop", "fetch", "constant sets", "texture image infos",
+                                      "texture set reuse check", "set allocation and writes",
+                                      "vkUpdateDescriptorSets", "binds", "total", "dynamic state",
+                                      "system constants"};
+  return part < kBindParts ? names[part] : "?";
+}
+inline std::array<std::atomic<uint64_t>, kBindParts> bind_part_ticks{};
+inline std::array<std::atomic<uint64_t>, kBindConstantBuffers> bind_uploads{}, bind_upload_bytes{};
+inline std::atomic<uint64_t> bind_draws{0}, bind_sampled{0}, bind_calls{0}, bind_update_calls{0},
+    bind_update_descriptors{0};
+// Whether the current draw is timed (the GPU thread's; set at its start).
+inline bool bind_probe_active = false;
+inline void BindBeginDraw() {
+  if (!OnGpuThread()) {
+    bind_probe_active = false;
+    return;
+  }
+  AddOwn(bind_draws, 1);
+  bind_probe_active = SampleOneIn(8);
+  if (bind_probe_active) AddOwn(bind_sampled, 1);
+}
+struct BindMark {
+  uint64_t ticks = 0, other = 0;
+};
+inline BindMark BindStart() {
+  BindMark mark;
+  if (bind_probe_active && OnGpuThread()) {
+    mark.ticks = Ticks();
+    mark.other = OtherSectionTicks();
+  }
+  return mark;
+}
+// The own ticks since `mark` (nested sections taken out), or 0 when the draw is not timed.
+inline uint64_t BindOwn(const BindMark& mark) {
+  if (!mark.ticks) return 0;
+  const uint64_t wall = Ticks() - mark.ticks, nested = OtherSectionTicks() - mark.other;
+  return wall > nested ? wall - nested : 0;
+}
+inline void BindStop(uint32_t part, const BindMark& mark) {
+  if (mark.ticks) AddOwn(bind_part_ticks[part], BindOwn(mark));
+}
+class BindScope {
+ public:
+  explicit BindScope(uint32_t part) : part_(part), mark_(BindStart()) {}
+  ~BindScope() { BindStop(part_, mark_); }
+  BindScope(const BindScope&) = delete;
+  BindScope& operator=(const BindScope&) = delete;
+
+ private:
+  uint32_t part_;
+  BindMark mark_;
+};
+inline void CountBindUpload(uint32_t buffer, uint64_t bytes) {
+  if (buffer >= kBindConstantBuffers || !OnGpuThread()) return;
+  AddOwn(bind_uploads[buffer], 1);
+  AddOwn(bind_upload_bytes[buffer], bytes);
+}
+inline void CountBindCall() {
+  if (OnGpuThread()) AddOwn(bind_calls, 1);
+}
+inline void CountDescriptorUpdate(uint32_t descriptors) {
+  if (!OnGpuThread()) return;
+  AddOwn(bind_update_calls, 1);
+  AddOwn(bind_update_descriptors, descriptors);
+}
+// The calls whose result is compared with the previous draw's.
+enum SameCall : uint32_t { kSamePrimitive = 0, kSameTargets, kSamePipeline, kSameShaders, kSameCalls };
+inline const char* SameCallName(uint32_t call) {
+  static const char* const names[] = {"primitive processing", "render pass and framebuffer", "pipeline",
+                                      "shaders"};
+  return call < kSameCalls ? names[call] : "?";
+}
+// [call * 2 + same]: every draw counted; the timed draws' own ticks and their number.
+inline std::array<std::atomic<uint64_t>, kSameCalls * 2> same_counts{}, same_ticks{}, same_timed{};
+inline void NoteSame(uint32_t call, bool same, const BindMark& mark) {
+  if (call >= kSameCalls || !OnGpuThread()) return;
+  const uint32_t slot = call * 2 + (same ? 1 : 0);
+  AddOwn(same_counts[slot], 1);
+  if (mark.ticks) {
+    AddOwn(same_ticks[slot], BindOwn(mark));
+    AddOwn(same_timed[slot], 1);
+  }
+}
+// "Frame time bindings (GPU thread, fix 142d, 1 draw in 8 timed): n draws/s, c UpdateBindings/s,
+// t us each; constants: system a ms/s (u/s, b B each), ..., fetch ...; constant sets ..., texture
+// image infos ..., texture set reuse check ..., set allocation and writes ..., vkUpdateDescriptorSets
+// x ms/s in k calls/s (d descriptors each), binds ..., the rest ...; dynamic state ... ms/s, system
+// constants ... ms/s" and "Frame time draws like the previous one (GPU thread, fix 142d): primitive
+// processing p% (x ms/s when the same, y when not), render pass and framebuffer ..., pipeline ...,
+// shaders q%".
+class BindReporter {
+ public:
+  // `fixed_ns_per_tick` (tests): the ticks' length instead of the one measured between lines.
+  std::string Lines(double seconds, double fixed_ns_per_tick = 0) {
+    const uint64_t ticks_now = Ticks(), ns_now = NowNs();
+    double ns_per_tick = last_ns_per_tick_ > 0 ? last_ns_per_tick_ : 1.0;
+    if (last_ticks_ && ticks_now > last_ticks_ && ns_now > last_ns_)
+      ns_per_tick = double(ns_now - last_ns_) / double(ticks_now - last_ticks_);
+    if (fixed_ns_per_tick > 0) ns_per_tick = fixed_ns_per_tick;
+    last_ns_per_tick_ = ns_per_tick;
+    last_ticks_ = ticks_now;
+    last_ns_ = ns_now;
+    const double s = seconds > 0 ? seconds : 1;
+    const double draws = Delta(bind_draws, last_draws_), sampled = Delta(bind_sampled, last_sampled_);
+    const double calls = Delta(bind_calls, last_calls_);
+    const double scale = sampled > 0 ? draws / sampled : 0.0;
+    double ms[kBindParts];
+    for (uint32_t n = 0; n < kBindParts; ++n) {
+      ms[n] = Delta(bind_part_ticks[n], last_parts_[n]) * scale * ns_per_tick / 1e6 / s;
+    }
+    std::string constants;
+    double parts_sum = 0;
+    for (uint32_t n = 0; n < kBindConstantBuffers; ++n) {
+      const double uploads = Delta(bind_uploads[n], last_uploads_[n]);
+      const double bytes = Delta(bind_upload_bytes[n], last_bytes_[n]);
+      char item[96];
+      std::snprintf(item, sizeof(item), "%s%s %.1f ms/s (%.0f/s, %.0f B each)", n ? ", " : "", BindPartName(n),
+                    ms[n], uploads / s, uploads > 0 ? bytes / uploads : 0.0);
+      constants += item;
+      parts_sum += ms[n];
+    }
+    for (uint32_t n = kBindConstantSets; n <= kBindBind; ++n) parts_sum += ms[n];
+    const double updates = Delta(bind_update_calls, last_update_calls_);
+    const double descriptors = Delta(bind_update_descriptors, last_update_descriptors_);
+    char text[1024];
+    std::snprintf(text, sizeof(text),
+                  "Frame time bindings (GPU thread, fix 142d, 1 draw in 8 timed): %.0f draws/s, %.0f "
+                  "UpdateBindings/s, %.2f us each; constants: %s; constant sets %.1f ms/s, texture image infos "
+                  "%.1f ms/s, texture set reuse check %.1f ms/s, set allocation and writes %.1f ms/s, "
+                  "vkUpdateDescriptorSets %.1f ms/s in %.0f calls/s (%.1f descriptors each), binds %.1f ms/s, the "
+                  "rest %.1f ms/s; dynamic state %.1f ms/s, system constants %.1f ms/s",
+                  draws / s, calls / s, calls > 0 ? ms[kBindTotal] * 1000.0 * s / calls : 0.0, constants.c_str(),
+                  ms[kBindConstantSets], ms[kBindImageInfos], ms[kBindReuseCheck], ms[kBindAllocate],
+                  ms[kBindUpdateSets], updates / s, updates > 0 ? descriptors / updates : 0.0, ms[kBindBind],
+                  ms[kBindTotal] > parts_sum ? ms[kBindTotal] - parts_sum : 0.0, ms[kBindDynamicState],
+                  ms[kBindSystemConstants]);
+    std::string same = "Frame time draws like the previous one (GPU thread, fix 142d): ";
+    for (uint32_t c = 0; c < kSameCalls; ++c) {
+      double count[2], ms_bucket[2];
+      for (uint32_t b = 0; b < 2; ++b) {
+        const uint32_t slot = c * 2 + b;
+        count[b] = Delta(same_counts[slot], last_same_counts_[slot]);
+        const double timed = Delta(same_timed[slot], last_same_timed_[slot]);
+        const double ticks = Delta(same_ticks[slot], last_same_ticks_[slot]);
+        ms_bucket[b] = timed > 0 ? ticks * (count[b] / timed) * ns_per_tick / 1e6 / s : 0.0;
+      }
+      const double total = count[0] + count[1];
+      char item[160];
+      if (c == kSameShaders) {
+        std::snprintf(item, sizeof(item), "%s%s %.1f%%", c ? ", " : "", SameCallName(c),
+                      total > 0 ? 100.0 * count[1] / total : 0.0);
+      } else {
+        std::snprintf(item, sizeof(item), "%s%s %.1f%% (%.1f ms/s when the same, %.1f when not)", c ? ", " : "",
+                      SameCallName(c), total > 0 ? 100.0 * count[1] / total : 0.0, ms_bucket[1], ms_bucket[0]);
+      }
+      same += item;
+    }
+    return std::string(text) + "\n" + same;
+  }
+
+ private:
+  template <class Counter>
+  static double Delta(const Counter& counter, uint64_t& last) {
+    const uint64_t now = counter.load(std::memory_order_relaxed);
+    const double d = double(now - last);
+    last = now;
+    return d;
+  }
+  uint64_t last_ticks_ = 0, last_ns_ = 0;
+  double last_ns_per_tick_ = 0;
+  uint64_t last_draws_ = 0, last_sampled_ = 0, last_calls_ = 0, last_update_calls_ = 0,
+           last_update_descriptors_ = 0;
+  uint64_t last_parts_[kBindParts] = {};
+  uint64_t last_uploads_[kBindConstantBuffers] = {}, last_bytes_[kBindConstantBuffers] = {};
+  uint64_t last_same_counts_[kSameCalls * 2] = {}, last_same_ticks_[kSameCalls * 2] = {},
+           last_same_timed_[kSameCalls * 2] = {};
+};
+
 }  // namespace frame_cost
 }  // namespace xbox360ps5
