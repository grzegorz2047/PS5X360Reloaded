+// Fix 148j: what a vfork child measured; plain data only (the child shares the parent's memory and
+// must not allocate).
+struct ChildStats {
+  uint64_t bytes, writes, stalls;
+  double longest_ms;
+  int error;     // errno of a failed pwrite, else 0
+  int timed_out;
+};
+inline void ChildWrite(int fd, const unsigned char* buffer, uint64_t chunk, uint64_t total, int seconds,
+                       ChildStats* out) {
+  const Clock::time_point start = Clock::now();
+  while (out->bytes < total) {
+    if (MsSince(start) >= seconds * 1000.0) {
+      out->timed_out = 1;
+      return;
+    }
+    const size_t length = size_t(total - out->bytes < chunk ? total - out->bytes : chunk);
+    const Clock::time_point t = Clock::now();
+    const ssize_t wrote = ::pwrite(fd, buffer, length, off_t(out->bytes));
+    const double ms = MsSince(t);
+    if (wrote <= 0) {
+      if (wrote < 0 && errno == EINTR) continue;
+      out->error = wrote < 0 ? errno : EIO;
+      return;
+    }
+    ++out->writes;
+    if (ms > kStallMs) ++out->stalls;
+    if (ms > out->longest_ms) out->longest_ms = ms;
+    out->bytes += uint64_t(wrote);
+  }
 }
 
