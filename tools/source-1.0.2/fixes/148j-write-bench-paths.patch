+                  fs.f_fstypename, fs.f_mntonname, (unsigned long long)fs.f_bsize,
+                  (unsigned long long)(uint64_t(fs.f_bavail) * uint64_t(fs.f_bsize) / kMiB),
+                  (unsigned long long)(uint64_t(fs.f_blocks) * uint64_t(fs.f_bsize) / kMiB),
+                  ::access(path, W_OK) == 0 ? "yes" : "no");
+#else
+    struct statvfs fs {};
+    if (::statvfs(path, &fs) != 0) continue;
+    std::snprintf(part, sizeof(part), " %s block %llu, free %llu of %llu MiB, writable %s;", path,
+                  (unsigned long long)fs.f_bsize, (unsigned long long)(uint64_t(fs.f_bavail) * fs.f_frsize / kMiB),
+                  (unsigned long long)(uint64_t(fs.f_blocks) * fs.f_frsize / kMiB),
+                  ::access(path, W_OK) == 0 ? "yes" : "no");
