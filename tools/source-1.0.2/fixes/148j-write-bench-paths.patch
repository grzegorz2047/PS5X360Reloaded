+// Fix 148j: one write of `length` bytes at `offset` by the variant's method; the bytes written, or
+// -1 with errno.
+inline ssize_t WriteOnce(const Variant& v, int fd, const unsigned char* buffer, size_t length, uint64_t offset) {
+  if (v.method == Method::kWritev) {
+    iovec parts[4];
+    const size_t quarter = length / 4;
+    for (int i = 0; i < 4; ++i) {
+      parts[i].iov_base = const_cast<unsigned char*>(buffer) + quarter * size_t(i);
+      parts[i].iov_len = i < 3 ? quarter : length - quarter * 3;
+    }
+    return ::writev(fd, parts, 4);
+  }
+#if XBOX360PS5_WRITE_BENCH_AIO
+  if (v.method == Method::kAio) {
+    aiocb request;
+    std::memset(&request, 0, sizeof(request));
+    request.aio_fildes = fd;
+    request.aio_buf = const_cast<unsigned char*>(buffer);
+    request.aio_nbytes = length;
+    request.aio_offset = off_t(offset);
+    if (::aio_write(&request) != 0) return -1;
+    const aiocb* list[1] = {&request};
+    while (::aio_error(&request) == EINPROGRESS) ::aio_suspend(list, 1, nullptr);
+    return ::aio_return(&request);
+  }
+#endif
+  return ::pwrite(fd, buffer, length, off_t(offset));
+}
