+// Fix 98: switches the theme in a title folder from what it is now (dark_now). False when the
+// light choice could not be written or removed; ui-dark.on only follows it for older builds.
+inline bool ToggleAt(const std::filesystem::path& folder, bool dark_now) {
+  std::error_code error;
+  const auto light = folder / "ui-light.on", dark = folder / "ui-dark.on";
+  if (dark_now) {
+    {
+      std::ofstream marker(light, std::ios::trunc | std::ios::binary);
+      marker.write("1\n", 2);
+      if (!marker) return false;
+    }
+    std::filesystem::remove(dark, error);
+    return true;
+  }
+  std::filesystem::remove(light, error);
+  if (error || std::filesystem::exists(light, error)) return false;
+  std::ofstream marker(dark, std::ios::trunc | std::ios::binary);
+  marker.write("1\n", 2);
+  return true;
+}
