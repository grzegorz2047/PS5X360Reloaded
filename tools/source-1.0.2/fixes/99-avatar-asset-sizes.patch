diff --git a/include/xbox360ps5/avatar_assets.hpp b/include/xbox360ps5/avatar_assets.hpp
new file mode 100644
index 0000000..2277fd9
--- /dev/null
+++ b/include/xbox360ps5/avatar_assets.hpp
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: MIT
+// Fix 99 (1.0.5, issue 15): the sizes XamAvatarGetAssetsResultSize gives while the avatar asset
+// calls are stubs (XamAvatarGetAssets fails), so a title allocates and clears room for an empty
+// XAVATAR_ASSETS instead of 0 bytes.
+//
+// Kinect Sports (4D5308C9, 0x82524388) asks for the sizes, allocates them (the result with its
+// heap, the GPU part with XPhysicalAlloc), clears the result with memset of the size it got, calls
+// XamAvatarGetAssets and, after its second failure, still runs 0x82524770, which reads the set's
+// component count at +8 and its component array at +0x10 and writes a 32-byte index buffer header
+// per component. With sizes 0 the count came from the heap block after the 0-byte allocation, and
+// the headers (FFFF0000 00000003 10000002 ...) went over megabytes of the title's heap: crashes in
+// its allocators right after it opened \AM\AMBundle\bundle\4F45161E (1.0.5_candidate_5, 8 and 10,
+// 1.0.5-work-fix92), which only happened to be next. Found by an external analysis of the title's
+// code and confirmed in those logs' memory dumps.
+//
+// 1.0.5-work-fix99c: the set's skeleton. On 1.0.5-work-fix106 a Guest at "Pick main player"
+// crashed at 0x82524E6C: 0x82524E38 takes the set (the title's object +0xA18), reads the skeleton
+// pointer at +0 and its bone count without a NULL check (only a count of 0 skips the body), and
+// the cleared set had +0 = 0. The cleared result now points +0 at an empty skeleton (bone count 0,
+// no bones) inside the same buffer, at kSkeletonAt. Every other reader of the set in the title
+// (0x825247E4, 0x82524808, 0x8252491C, 0x825258FC, 0x8259E724, 0x8259E858) reads +0xC and +0x10
+// only under the component count at +8, which stays 0.
+#pragma once
+#include <cstdint>
+
+namespace xbox360ps5::avatar_assets {
+
+// Room for an empty set: the header (flags, skeleton, component count, the component array's
+// size and pointer) with plenty to spare.
+constexpr uint32_t kResultBytes = 0x100;
+// A small GPU part, not XPhysicalAlloc(0).
+constexpr uint32_t kGpuBytes = 0x1000;
+// What XamAvatarGetAssets clears of the result before it fails: all of it (what the title was told
+// to allocate, and cleared itself), so the count (+8) and the array pointer (+0x10) read 0.
+constexpr uint32_t kClearedBytes = kResultBytes;
+// The empty skeleton (bone count, bones pointer) the set's +0 points at.
+constexpr uint32_t kSkeletonAt = 0x80, kSkeletonBytes = 8;
+static_assert(kClearedBytes <= kResultBytes, "cleared within what the title was told to allocate");
+static_assert(kSkeletonAt >= 0x20 && kSkeletonAt + kSkeletonBytes <= kClearedBytes, "past the header, inside the clear");
+
+// The component count and array a title reads from an XAVATAR_ASSETS (big-endian words).
+inline uint32_t ComponentCount(const uint8_t* assets) {
+  return uint32_t(assets[8]) << 24 | uint32_t(assets[9]) << 16 | uint32_t(assets[10]) << 8 | assets[11];
+}
+inline uint32_t ComponentArray(const uint8_t* assets) {
+  return uint32_t(assets[16]) << 24 | uint32_t(assets[17]) << 16 | uint32_t(assets[18]) << 8 | assets[19];
+}
+inline uint32_t Word(const uint8_t* at) {
+  return uint32_t(at[0]) << 24 | uint32_t(at[1]) << 16 | uint32_t(at[2]) << 8 | at[3];
+}
+// An empty set in `assets` (kClearedBytes at the guest address `address`): all zero but +0, the
+// skeleton pointer, which holds address + kSkeletonAt, where the bone count and bones are 0.
+inline void PrepareEmptyAssets(uint8_t* assets, uint32_t address) {
+  for (uint32_t i = 0; i < kClearedBytes; ++i) assets[i] = 0;
+  const uint32_t skeleton = address + kSkeletonAt;
+  assets[0] = uint8_t(skeleton >> 24);
+  assets[1] = uint8_t(skeleton >> 16);
+  assets[2] = uint8_t(skeleton >> 8);
+  assets[3] = uint8_t(skeleton);
+}
+
+}  // namespace xbox360ps5::avatar_assets
