+// SPDX-License-Identifier: MIT
+// Fix 115 (issues #33 and #34): the in-game guide's quick actions.
+//  - "Restart game" on the guide's first page: this game again from its start, as the System
+//    list's "Restart this game with logs for a bug report" (fix 93d) does, but without the logs.
+//    Both go through one helper in canary_game_main.cpp; this says which bug_report value the
+//    restart sets (none for the plain one).
+//  - "Game volume" changed in the guide is kept for this game (its own options), always: until
+//    now it was kept for every game unless the game already had a value of its own or a preset.
+//    Every other option keeps that rule.
+//  - "Mute game sound" on the guide's first page: the Sound option ("mute"), switched at once.
+#ifndef XBOX360PS5_GUIDE_QUICK_HPP_
+#define XBOX360PS5_GUIDE_QUICK_HPP_
+
+#include <string_view>
+
+namespace xbox360ps5::guide_quick {
+
+// Where a value the guide changes is kept.
+enum class Keep { game, general };
+
+// The options the guide keeps for the running game even when it has no value of its own yet.
+inline bool KeptForGame(std::string_view key) { return key == "volume"; }
+
+// own: the game already has its own value of this option; preset: its preset sets it;
+// title_known: the running game has a title ID (its own options can be saved).
+inline Keep WhereToKeep(std::string_view key, bool own, bool preset, bool title_known) {
+  if (own || preset) return Keep::game;  // the rule from before (where the value came from)
+  if (title_known && KeptForGame(key)) return Keep::game;
+  return Keep::general;
+}
+
+// What a restart from the guide writes before it restarts: the bug_report value of this game
+// (the general one for a game without a title ID), or nothing for the plain restart.
+struct BugReportFlags {
+  bool game = false;
+  bool general = false;
+};
+inline BugReportFlags RestartFlags(bool with_logs, bool title_known) {
+  BugReportFlags flags;
+  if (!with_logs) return flags;
+  (title_known ? flags.game : flags.general) = true;
+  return flags;
+}
+
+// The quick mute row's value (the English key): "On" while the game is muted. The row is the
+// Sound option itself (key "mute", 0 sound on, 1 muted), so a press switches it as the option's
+// row on the settings page does, and it is kept by the same rule.
+inline const char* MuteRowValue(int mute) { return mute ? "On" : "Off"; }
+
+}  // namespace xbox360ps5::guide_quick
+
+#endif  // XBOX360PS5_GUIDE_QUICK_HPP_
