diff --git a/include/xbox360ps5/present_stall.hpp b/include/xbox360ps5/present_stall.hpp
new file mode 100644
--- /dev/null
+++ b/include/xbox360ps5/present_stall.hpp
@@ -0,0 +1,135 @@
+// SPDX-License-Identifier: MIT
+// Fix 146e: where a stopped present went (a diagnostic).
+//
+// On the console (1.0.6-work-fix146d, GTA IV on the 120 Hz output) the presents stopped for 0.14 to
+// 0.85 s about once in 30 s, with the frame rate limit on and, later in the session, with it off;
+// every picture that stayed that long was such a stop. The stage timers of the Vulkan calls
+// (submit, present) never passed 4 ms, and the hang watch (a beat every 250 ms, a report after 1 s)
+// is too coarse. So each paint of the Vulkan presenter (VulkanPresenter::PaintAndPresentImpl on the
+// UI thread) now times its parts, and a paint that took 100 ms or more, or came 100 ms or more
+// after the previous one ended, writes one line: the time outside the presenter (the UI loop
+// between two paints) and, inside the paint, the waits for earlier paints on the GPU, the swapchain
+// acquire, the guest output (the mailbox's consumer lock and the frame rate limit), the waits for
+// images in use, the UI drawers (the guide, the FPS overlay), the submit (with the queue's lock)
+// and the present (with the queue's lock); what is left is "other". At most 10 lines a minute; the
+// next line says how many were not written.
+#pragma once
+
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+namespace xbox360ps5 {
+namespace present_stall {
+
+enum Stage : int {
+  kPending = 0,  // AwaitMaxSubmissionsPending: earlier paints still on the GPU
+  kAcquire,      // vkAcquireNextImageKHR
+  kGuestOutput,  // Presenter::ConsumeGuestOutput (consumer lock, frame rate limit)
+  kImageWaits,   // AwaitSubmission for an image or pipeline still in use
+  kDrawers,      // ExecuteUIDrawersFromUIThread (guide, FPS overlay)
+  kSubmit,       // the paint's queue submit, with the queue's lock
+  kPresent,      // vkQueuePresentKHR, with the queue's lock
+  kStages
+};
+
+inline const char* StageName(int stage) {
+  static const char* const kNames[kStages] = {
+      "waiting for earlier paints", "acquire", "guest output", "image waits", "drawers",
+      "submit", "present"};
+  return stage >= 0 && stage < kStages ? kNames[stage] : "?";
+}
+
+inline int64_t NowNs() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+class Timer {
+ public:
+  static constexpr int64_t kStallNs = 100000000;   // 100 ms
+  static constexpr int64_t kWindowNs = 60000000000;  // lines are limited per minute
+  static constexpr unsigned kLinesPerWindow = 10;
+
+  // At the start of a paint.
+  void Begin(int64_t now) {
+    outside_ = last_end_ ? now - last_end_ : 0;
+    begin_ = now;
+    stages_.fill(0);
+  }
+  void Add(int stage, int64_t ns) {
+    if (begin_ && stage >= 0 && stage < kStages && ns > 0) stages_[size_t(stage)] += ns;
+  }
+  // At the end of a paint (any return): true and `line` when this paint or the time before it
+  // was a stall worth a line.
+  bool End(int64_t now, std::string& line) {
+    if (!begin_) return false;
+    const int64_t inside = now - begin_;
+    const int64_t outside = outside_;
+    begin_ = 0;
+    last_end_ = now;
+    if (inside < kStallNs && outside < kStallNs) return false;
+    ++stalls_;
+    if (!window_start_ || now - window_start_ >= kWindowNs) {
+      window_start_ = now;
+      written_in_window_ = 0;
+    }
+    if (written_in_window_ >= kLinesPerWindow) {
+      ++not_written_;
+      return false;
+    }
+    ++written_in_window_;
+    int64_t known = 0;
+    for (int64_t ns : stages_) known += ns;
+    char text[640];
+    int n = std::snprintf(text, sizeof(text),
+                          "Present stall (fix 146e): %.1f ms from the end of the previous paint "
+                          "to the end of this one: %.1f ms outside the presenter (the UI loop), "
+                          "%.1f ms in the paint:",
+                          double(outside + inside) / 1e6, double(outside) / 1e6, double(inside) / 1e6);
+    for (int s = 0; s < kStages && n > 0 && size_t(n) < sizeof(text); ++s)
+      n += std::snprintf(text + n, sizeof(text) - size_t(n), "%s %s %.1f", s ? "," : "",
+                         StageName(s), double(stages_[size_t(s)]) / 1e6);
+    if (n > 0 && size_t(n) < sizeof(text))
+      n += std::snprintf(text + n, sizeof(text) - size_t(n), ", other %.1f ms",
+                         double(inside > known ? inside - known : 0) / 1e6);
+    if (not_written_ && n > 0 && size_t(n) < sizeof(text))
+      std::snprintf(text + n, sizeof(text) - size_t(n), " (%u earlier not written)", not_written_);
+    not_written_ = 0;
+    line = text;
+    return true;
+  }
+  uint64_t stalls() const { return stalls_; }
+
+ private:
+  int64_t begin_ = 0, last_end_ = 0, outside_ = 0, window_start_ = 0;
+  std::array<int64_t, kStages> stages_{};
+  unsigned written_in_window_ = 0, not_written_ = 0;
+  uint64_t stalls_ = 0;
+};
+
+// One per thread: the UI thread's paints are what is timed; a capture on another thread adds to
+// its own, unused timer.
+inline Timer& ThisThread() {
+  static thread_local Timer timer;
+  return timer;
+}
+
+// Times a part of the paint into the thread's timer.
+class Span {
+ public:
+  explicit Span(int stage) : stage_(stage), start_(NowNs()) {}
+  ~Span() { ThisThread().Add(stage_, NowNs() - start_); }
+  Span(const Span&) = delete;
+  Span& operator=(const Span&) = delete;
+
+ private:
+  int stage_;
+  int64_t start_;
+};
+
+}  // namespace present_stall
+}  // namespace xbox360ps5
