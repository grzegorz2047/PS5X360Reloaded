+// Fix 112c: where a group's folder tile puts its games' covers. Coordinates are fractions of the
+// folder's width (u) and height (v), the folder's front starting at v = 0.14. The covers stay in
+// the mosaic's area, clear of the folder's edges, its name at the foot and the badge.
+struct Cell {
+  float u0, v0, u1, v1;
+};
+inline constexpr Cell kMosaicArea{0.10f, 0.18f, 0.90f, 0.80f};   // The covers stay inside.
+inline constexpr Cell kFolderLabel{0.07f, 0.84f, 0.70f, 0.97f};  // The folder's name.
+inline constexpr Cell kFolderBadge{0.74f, 0.82f, 0.96f, 0.98f};  // The number of games.
+inline constexpr float kDefaultCoverAspect = 0.70f;              // An Xbox 360 case's front, width over height.
+
+// Up to four covers' places: one in the middle, two side by side, three or four in a 2x2 square,
+// centred in the mosaic's area with yellow margins around them (a group of 5 or more shows its
+// first four). Each cover keeps its own proportions: `aspects` are the covers' widths over their
+// heights as drawn (0 or a wild value: kDefaultCoverAspect); `folder_aspect` is the folder's width
+// over its height on the screen. A cover is fitted into its slot (never stretched) and centred.
+inline std::vector<Cell> MosaicCells(const std::vector<float>& aspects, float folder_aspect) {
+  const size_t count = std::min<size_t>(aspects.size(), 4);
+  std::vector<Cell> cells;
+  if (!count) return cells;
+  if (!(folder_aspect > 0.05f && folder_aspect < 20.0f)) folder_aspect = kDefaultCoverAspect;
+  // Each slot's size, and the gaps between slots.
+  float slot_w = 0.42f, slot_h = 0.46f, gap_u = 0.0f, gap_v = 0.0f;
+  size_t columns = 1, rows = 1;
+  if (count == 2) { slot_w = 0.30f; slot_h = 0.40f; gap_u = 0.04f; columns = 2; }
+  if (count >= 3) { slot_w = 0.28f; slot_h = 0.27f; gap_u = 0.04f; gap_v = 0.03f; columns = 2; rows = 2; }
+  const float total_w = slot_w * float(columns) + gap_u * float(columns - 1);
+  const float total_h = slot_h * float(rows) + gap_v * float(rows - 1);
+  const float left = (kMosaicArea.u0 + kMosaicArea.u1 - total_w) / 2;
+  const float top = (kMosaicArea.v0 + kMosaicArea.v1 - total_h) / 2;
+  for (size_t i = 0; i < count; ++i) {
+    float aspect = aspects[i];
+    if (!(aspect > 0.05f && aspect < 20.0f)) aspect = kDefaultCoverAspect;
+    const float su = left + float(i % columns) * (slot_w + gap_u), sv = top + float(i / columns) * (slot_h + gap_v);
+    // In the slot's own proportions on the screen (slot_w * folder_aspect wide for slot_h high).
+    float w = slot_w, h = slot_w * folder_aspect / aspect;
+    if (h > slot_h) { h = slot_h; w = slot_h * aspect / folder_aspect; }
+    const float u0 = su + (slot_w - w) / 2, v0 = sv + (slot_h - h) / 2;
+    cells.push_back({u0, v0, u0 + w, v0 + h});
+  }
+  return cells;
+}
