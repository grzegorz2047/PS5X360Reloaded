+// Fix 117k: render target classes (pitch in pixels, MSAA samples) a game renders at 1x when at 2x.
+struct NativeClass {
+  uint32_t pitch_px = 0;
+  uint32_t samples = 1;
+};
+// The EDRAM tiles of a pitch (80 samples wide: 80 pixels, or 40 at 4xMSAA); 0 when it is not a whole number.
+inline uint32_t PitchTiles(uint32_t pitch_px, uint32_t samples) {
+  const uint32_t tile_px = samples >= 4 ? 40 : 80;
+  return pitch_px && pitch_px % tile_px == 0 ? pitch_px / tile_px : 0;
+}
+// xenos::MsaaSamples: 0 is 1x, 1 is 2x, 2 is 4x.
+inline uint32_t MsaaIndex(uint32_t samples) { return samples >= 4 ? 2 : samples == 2 ? 1 : 0; }
+// "800x1 40x4, 80x4" with # comments; anything else is skipped.
+inline std::vector<NativeClass> ParseNativeClasses(const std::string& text) {
+  std::vector<NativeClass> classes;
+  size_t i = 0;
+  while (i < text.size()) {
+    if (text[i] == '#') {
+      while (i < text.size() && text[i] != '\n') ++i;
+      continue;
+    }
+    if (!std::isdigit(static_cast<unsigned char>(text[i]))) {
+      ++i;
+      continue;
+    }
+    uint32_t pitch = 0;
+    while (i < text.size() && std::isdigit(static_cast<unsigned char>(text[i])) && pitch < 100000)
+      pitch = pitch * 10 + uint32_t(text[i++] - '0');
+    if (i >= text.size() || (text[i] != 'x' && text[i] != 'X')) continue;
+    ++i;
+    uint32_t samples = 0;
+    while (i < text.size() && std::isdigit(static_cast<unsigned char>(text[i])) && samples < 100)
+      samples = samples * 10 + uint32_t(text[i++] - '0');
+    if ((samples == 1 || samples == 2 || samples == 4) && PitchTiles(pitch, samples) && PitchTiles(pitch, samples) < 256)
+      classes.push_back({pitch, samples});
+  }
+  return classes;
+}
+inline std::vector<NativeClass> CompiledNativeClasses(const std::string& title_id) {
+  std::string id;
+  for (char ch : title_id) id += char(std::toupper(static_cast<unsigned char>(ch)));
+  // Red Dead Redemption: the shadow cascade's depth and the passes of 40 to 200 pixels (fix 117k).
+  if (id == "5454082B") return ParseNativeClasses("800x1 40x4 80x4 80x1 120x4 160x4 160x1 200x4");
+  return {};
+}
+// Set as a game starts (before it draws), read while it draws.
+inline std::bitset<256 * 4> native_class_bits;
+inline bool IsNativeClass(uint32_t pitch_tiles, uint32_t msaa_index) {
+  return pitch_tiles < 256 && msaa_index < 4 && native_class_bits[pitch_tiles * 4 + msaa_index];
+}
+// Only at 2x; returns how many classes apply.
+inline size_t SetNativeClasses(const std::vector<NativeClass>& classes, uint32_t scale) {
+  native_class_bits.reset();
+  if (scale <= 1) return 0;
+  size_t applied = 0;
+  for (const NativeClass& c : classes) {
+    const uint32_t tiles = PitchTiles(c.pitch_px, c.samples);
+    if (!tiles || tiles >= 256) continue;
+    native_class_bits[tiles * 4 + MsaaIndex(c.samples)] = true;
+    ++applied;
+  }
+  return applied;
+}
+inline std::string NativeClassesLine(const std::vector<NativeClass>& classes, const std::string& title_id,
+                                     const char* from) {
+  std::string line = "Resolution scale (fix 117k): classes at 1x for " +
+                     (title_id.empty() ? std::string("no identified title") : title_id) + " (" +
+                     (from && *from ? from : "unknown") + "):";
+  for (const NativeClass& c : classes)
+    line += " " + std::to_string(c.pitch_px) + "x" + std::to_string(c.samples);
+  return line;
+}
