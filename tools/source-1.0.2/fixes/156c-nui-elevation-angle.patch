diff --git a/include/xbox360ps5/virtual_nui.hpp b/include/xbox360ps5/virtual_nui.hpp
--- a/include/xbox360ps5/virtual_nui.hpp
+++ b/include/xbox360ps5/virtual_nui.hpp
@@ -83,6 +83,27 @@ inline NuiBinding LiveNuiBinding(bool kinect_title, uint32_t signed_in_mask) {
       !(signed_in_mask & (1u << nui_binding.user_index))) return {};
   return nui_binding;
 }
+// Fix 156c (Kinect Adventures, Kinect Sports Season Two, Zumba Fitness Core; issue 63): the
+// virtual camera's tilt. XamNuiCameraElevationGetAngle always failed, and Kinect Adventures
+// moves the motor on its start screen (SetAngle +4, then +12) and polls the angle every frame.
+// The virtual camera has no motor and stands level: the angle is 0 and it is never moving,
+// as its tilt status (gravity straight down) and its skeleton frames (a level floor plane)
+// say. A first build answered the last SetAngle target: every title then read -25 degrees,
+// which the NUI library itself asks for at start-up when the tilt it reads is exactly level
+// (KS1 829C5D98: `li r3,-25`), so the angle and the frames disagreed (Zumba keeps the angle,
+// 82332698, and did not find the player). The last target is kept for the log only.
+constexpr int32_t kTiltAngleMin = -27, kTiltAngleMax = 27;
+inline std::atomic<int32_t> nui_tilt_angle{0};
+inline int32_t ClampTiltAngle(int32_t angle) {
+  return angle < kTiltAngleMin ? kTiltAngleMin : angle > kTiltAngleMax ? kTiltAngleMax : angle;
+}
+inline void SetVirtualTiltAngle(int32_t angle) { nui_tilt_angle = ClampTiltAngle(angle); }
+struct TiltAngle {
+  int32_t angle;
+  uint32_t moving;
+};
+inline TiltAngle VirtualTiltAngle() { return {0, 0}; }
+inline int32_t RequestedTiltAngle() { return nui_tilt_angle.load(); }
 // Fix 57: a Kinect game asked for its camera while "Camera motion" was off. The title
 // side shows the player how to turn it on (set at start-up; called once per game).
 inline void (*kinect_needed)() = nullptr;
@@ -96,5 +117,6 @@ inline void ResetVirtualNui() {
   nui_identity_callback = 0;
   nui_identity_notifications = 0;
   kinect_needed_reported = false;
+  nui_tilt_angle = 0;  // fix 156c
 }
 }
