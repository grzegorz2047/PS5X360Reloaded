@@ -80,6 +80,22 @@ inline NuiBinding LiveNuiBinding(bool kinect_title, uint32_t signed_in_mask) {
       !(signed_in_mask & (1u << nui_binding.user_index))) return {};
   return nui_binding;
 }
+// Fix 156c (Kinect Adventures, Kinect Sports Season Two; issue 63): the virtual camera's tilt.
+// XamNuiCameraElevationGetAngle always failed, and Kinect Adventures moves the motor on its
+// start screen (SetAngle +4, then +12) and polls the angle every frame. The virtual motor
+// moves at once: the angle is the last SetAngle target, clamped to the Kinect's range of
+// +-27 degrees, and it is never moving. Level (0) until a title sets it.
+constexpr int32_t kTiltAngleMin = -27, kTiltAngleMax = 27;
+inline std::atomic<int32_t> nui_tilt_angle{0};
+inline int32_t ClampTiltAngle(int32_t angle) {
+  return angle < kTiltAngleMin ? kTiltAngleMin : angle > kTiltAngleMax ? kTiltAngleMax : angle;
+}
+inline void SetVirtualTiltAngle(int32_t angle) { nui_tilt_angle = ClampTiltAngle(angle); }
+struct TiltAngle {
+  int32_t angle;
+  uint32_t moving;
+};
+inline TiltAngle VirtualTiltAngle() { return {nui_tilt_angle.load(), 0}; }
 // Fix 57: a Kinect game asked for its camera while "Camera motion" was off. The title
 // side shows the player how to turn it on (set at start-up; called once per game).
 inline void (*kinect_needed)() = nullptr;
@@ -93,5 +109,6 @@ inline void ResetVirtualNui() {
   nui_identity_callback = 0;
   nui_identity_notifications = 0;
   kinect_needed_reported = false;
+  nui_tilt_angle = 0;  // fix 156c
 }
 }
