+// Fix 148d: GTA V's slow install phase reads no package file (no 148c line): it copies the
+// install disc's package files themselves, reading the disc image and writing the drive. Every
+// guest file read and write is counted by where it goes, with its largest size, and the delays of a
+// thread that read or wrote a file in the last second with the time asked and the time it really
+// slept. One line per 30 s while files are read or written.
+struct Kind {
+  std::atomic<uint64_t> calls{0}, bytes{0}, ns{0}, largest{0};
+};
+struct FileIo {
+  Kind disc_reads, host_reads, host_writes, set_length;
+  std::atomic<uint64_t> delays{0}, asked_100ns{0}, slept_ns{0};
+  std::atomic<uint64_t> last_report_ns{0};
+};
+inline FileIo file_io;
+inline thread_local uint64_t last_file_io_ns = 0;
+
+inline void Add(Kind& kind, uint64_t bytes, uint64_t ns) {
+  kind.calls.fetch_add(1);
+  kind.bytes.fetch_add(bytes);
+  kind.ns.fetch_add(ns);
+  uint64_t largest = kind.largest.load();
+  while (bytes > largest && !kind.largest.compare_exchange_weak(largest, bytes)) {
+  }
+}
+inline bool FileIoThread(uint64_t now_ns) {
+  return last_file_io_ns && now_ns - last_file_io_ns < 1000000000ull;
+}
+
+struct KindPeriod {
+  uint64_t calls = 0, bytes = 0, ns = 0, largest = 0;
+};
+inline KindPeriod TakeKind(Kind& kind) {
+  return {kind.calls.exchange(0), kind.bytes.exchange(0), kind.ns.exchange(0), kind.largest.exchange(0)};
+}
+
+// The 30 s line when due and the period had file I/O, else "". Only one caller wins a period.
+inline std::string FileIoReport(FileIo& io, uint64_t now_ns, uint64_t period_ns = 30000000000ull) {
+  uint64_t last = io.last_report_ns.load();
+  if (!last) {
+    io.last_report_ns.compare_exchange_strong(last, now_ns);
+    return {};
+  }
+  if (now_ns - last < period_ns || !io.last_report_ns.compare_exchange_strong(last, now_ns)) return {};
+  const double seconds = double(now_ns - last) / 1e9;
+  const KindPeriod d = TakeKind(io.disc_reads), r = TakeKind(io.host_reads), w = TakeKind(io.host_writes),
+                   l = TakeKind(io.set_length);
+  const uint64_t delays = io.delays.exchange(0), asked = io.asked_100ns.exchange(0),
+                 slept = io.slept_ns.exchange(0);
+  if (!d.calls && !r.calls && !w.calls && !l.calls) return {};
+  const auto part = [seconds](const char* name, const KindPeriod& k) {
+    char text[200];
+    std::snprintf(text, sizeof(text), "%s %llu (%.1f MiB, %.0f KiB each, largest %.0f KiB, %.2f MiB/s, %.0f us each)",
+                  name, (unsigned long long)k.calls, double(k.bytes) / 1048576.0,
+                  k.calls ? double(k.bytes) / double(k.calls) / 1024.0 : 0.0, double(k.largest) / 1024.0,
+                  seconds > 0 ? double(k.bytes) / 1048576.0 / seconds : 0.0,
+                  k.calls ? double(k.ns) / double(k.calls) / 1e3 : 0.0);
+    return std::string(text);
+  };
+  char tail[200];
+  std::snprintf(tail, sizeof(tail),
+                "; set length %llu (%.0f ms in all); KeDelayExecutionThread of threads doing file I/O %llu "
+                "(%.2f ms asked, %.2f ms slept each; %.0f ms slept in all)",
+                (unsigned long long)l.calls, double(l.ns) / 1e6, (unsigned long long)delays,
+                delays ? double(asked) / double(delays) / 1e4 : 0.0,
+                delays ? double(slept) / double(delays) / 1e6 : 0.0, double(slept) / 1e6);
+  char head[64];
+  std::snprintf(head, sizeof(head), "File I/O (fix 148d), last %.0f s: ", seconds);
+  return std::string(head) + part("disc image reads", d) + "; " + part("drive reads", r) + "; " +
+         part("drive writes", w) + tail;
+}
