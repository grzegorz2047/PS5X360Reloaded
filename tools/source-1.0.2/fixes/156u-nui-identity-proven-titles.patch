+// ---- Fix 156u: only in titles where the answer was proven ----------------------------------
+// 1.0.6_candidate_9: Dance Central 3 (373307D9) crashed 22 s after its start (an observer list
+// at 82553440 walked into an object without a vtable) with both functions bound and never
+// called; on 162f, without the binding, it played a song. The answer stays for the titles it
+// was tested in: Fighters Uncaged (it identifies with it), Dragon Ball Z for Kinect and Kinect
+// Sports (they ran bound since 156l/156q). Any other title, where the shapes are found too
+// (Dance Central 3, Zumba Fitness), keeps its own identification, as before 156l.
+inline bool ProvenTitle(uint32_t title_id) {
+  switch (title_id) {
+    case 0x5553084E:  // Fighters Uncaged
+    case 0x4E4D084E:  // Dragon Ball Z for Kinect
+    case 0x4D5308C9:  // Kinect Sports
+      return true;
+    default:
+      return false;
+  }
+}
