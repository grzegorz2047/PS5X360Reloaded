--- /dev/null
+++ b/include/xbox360ps5/nui_speech.hpp
@@ -0,0 +1,136 @@
+// SPDX-License-Identifier: MIT
+// Fix 170 (Harry Potter Kinect 57520826, issue 74): the Kinect speech library waits for a
+// microphone that no virtual Kinect has.
+//
+// The titles' statically linked Kinect speech library (NUISP, the XEX lists it among its static
+// libraries) reads Kinect audio through an audio source object (SAPI's ISpAudio). Its device
+// check reads the NUI status bits through the library's XamNuiGetDeviceStatus wrapper; 0x2 is
+// "ready" there, as for the rest of the NUI code (fix 156). Read from Zumba Fitness Core's and
+// Dance Central 3's default.xex (NUISP 2.0.21173.0, the build Harry Potter and Nike+ Kinect
+// Training link) and Kinect Sports Season Two's (2.0.20764.3):
+//  - Start-up (Zumba 825BCD38): the device check (825BCBF8) starts the microphone capture when
+//    the device is ready; else it notes "not connected" (0x8007048F) or "not ready"
+//    (0x80070015). A failed start-up is kept only when the device is ready (the second
+//    status call, 825BCDD4); otherwise start-up succeeds and the capture waits for the system's
+//    NUI hardware status notification (0x00060019, routed by the library's notification thread
+//    825B7A08 -> 825B24C8 -> 825BCD08) to start it later.
+//  - Read (825BC448, the stream's Read): while the audio source runs, it waits 20 ms at a time
+//    on the source's event (+0x24), which only the capture's frame callback (825BC8F8) and a
+//    status change set. On each timeout it asks the device status again (825BC4FC): not ready
+//    -> it fails with 0x80070015 / 0x8007048F; ready -> it keeps waiting unless the capture
+//    reported an error (a global the capture's own error callback sets).
+// There is no microphone array (fix 156f answers XamVoiceGetMicArrayAudioEx 0x8007048F), so
+// the capture never starts. A title that starts its speech after its camera opened (Nike+,
+// Zumba, Season Two) gets the capture's failure at start-up and goes on without voice. Harry
+// Potter starts its speech while its camera is still closed (status bits 0): start-up waits
+// for a notification the emulator never sends, then its recognizer's Read sees "ready" (the
+// camera opened, bits 0x3) and waits forever (thread 16 on its event at +0x24, the main
+// thread on its loading card, frame 796).
+//
+// The answer: the library's two questions about the microphone get the microphone's answer.
+//  - The start-up's "keep the error?" call is told ready (bit 0x2 set): start-up fails now, as
+//    it does in Nike+ (the same error, 0x8007048F), instead of waiting.
+//  - The Read's timeout call is told not ready (bit 0x2 clear): Read fails (0x80070015 with the
+//    device connected) instead of waiting forever. Only a source whose capture never started
+//    reaches this, since the capture's frames would set the event first.
+// Every other caller (the titles' own Kinect code, the library's device check that starts the
+// capture) gets fix 156's answer unchanged.
+//
+// The two calls are found by the shape of the code around the return address (no per-title
+// address): XamNuiGetDeviceStatus's LR is the wrapper's return, and the wrapper's saved LR
+// (one frame up the back chain) is the return into the speech code. Both builds' shapes:
+//  start-up: or. rS,r3,r3 / bge / bl wrapper / RET: rlwinm rA,r3,0,30,30 / subfic rA,rA,0 /
+//            subfe / and   (the error is kept only with 0x2)
+//  Read:     cmpwi crN,r3,0x102 (the wait timed out) shortly before bl wrapper, then
+//            RET: rlwinm. rA,r3,0,30,30 / beq (Season Two), or
+//            RET: b +8 / li r3,2 / rlwinm. rA,r3,0,30,30 / beq (21173: the "use the Kinect"
+//            flag's default)
+// Each image has exactly one of each (Zumba 825BCDD8 / 825BC500, Dance Central 3 8286EA30 /
+// 8286E150, Season Two 82AAD5D8 / 82AACDDC); Harry Potter's Read return is 82AB51A0.
+#pragma once
+#include <cstdint>
+
+namespace xbox360ps5::nui_speech {
+
+constexpr uint32_t kStatusReady = 0x2;  // the NUI status bit the speech code tests
+
+enum class Site { kOther, kStartup, kRead };
+
+inline const char* SiteName(Site site) {
+  switch (site) {
+    case Site::kStartup: return "start-up";
+    case Site::kRead: return "audio read";
+    default: return "other";
+  }
+}
+
+namespace detail {
+inline bool IsBl(uint32_t w) { return (w >> 26) == 18 && (w & 3) == 1; }
+// rlwinm[.] rA,r3,0,30,30 (r3 & 0x2), Rc as given.
+inline bool TestsReadyBit(uint32_t w, bool record) {
+  return (w & 0xFFE0FFFE) == 0x546007BC && (w & 1) == (record ? 1u : 0u);
+}
+inline bool IsBeqCr0(uint32_t w) { return (w & 0xFFFF0000) == 0x41820000; }
+// cmpwi crN,r3,0x102 (STATUS_TIMEOUT from the wait), any field.
+inline bool IsTimeoutTest(uint32_t w) { return (w & 0xFC7FFFFF) == 0x2C030102; }
+}  // namespace detail
+
+// What the speech code at return address `ret` does with the status it asked for.
+// read(address, &word) reads a big-endian guest word and returns false when it cannot.
+template <typename Read>
+inline Site ClassifyReturn(uint32_t ret, Read read) {
+  using namespace detail;
+  if (!ret || (ret & 3) || ret < 0x20) return Site::kOther;
+  uint32_t w[12];  // ret-0x20 .. ret+0x0C
+  for (int i = 0; i < 12; ++i)
+    if (!read(ret - 0x20 + uint32_t(i) * 4, &w[i])) return Site::kOther;
+  const auto at = [&](int offset) { return w[(offset + 0x20) / 4]; };
+  if (!IsBl(at(-4))) return Site::kOther;
+  // Start-up: the error is kept only when bit 0x2 is set.
+  if ((at(-12) & 0xFC0007FF) == 0x7C000379 &&     // or. rA,rS,rS (the device check's result)
+      (at(-8) & 0xFFFF0000) == 0x40800000 &&       // bge (cr0): no error, no question
+      TestsReadyBit(at(0), false) &&
+      (at(4) & 0xFC00FFFF) == 0x20000000 &&         // subfic rD,rA,0
+      (at(8) & 0xFC0007FE) == 0x7C000110 &&         // subfe rD,rA,rB
+      (at(12) & 0xFC0007FE) == 0x7C000038)          // and
+    return Site::kStartup;
+  // Read: asked after the wait timed out, and "ready" means "wait again".
+  bool after_timeout = false;
+  for (int offset = -0x20; offset < -4; offset += 4)
+    if (IsTimeoutTest(at(offset))) after_timeout = true;
+  if (!after_timeout) return Site::kOther;
+  if (TestsReadyBit(at(0), true) && IsBeqCr0(at(4))) return Site::kRead;
+  if (at(0) == 0x48000008 && at(4) == 0x38600002 && TestsReadyBit(at(8), true) &&
+      IsBeqCr0(at(12)))
+    return Site::kRead;
+  return Site::kOther;
+}
+
+// The caller of XamNuiGetDeviceStatus: `lr` returns into the title's status wrapper, whose
+// own saved LR (8 bytes below its caller's stack pointer, the word at `sp`) returns into the
+// speech code. A call straight from the speech code (lr itself) is recognised too.
+template <typename Read>
+inline Site ClassifyCaller(uint32_t lr, uint32_t sp, Read read, uint32_t* where = nullptr) {
+  Site site = ClassifyReturn(lr, read);
+  uint32_t ret = lr;
+  if (site == Site::kOther) {
+    uint32_t back = 0, saved = 0;
+    if (!sp || !read(sp, &back) || back <= sp || back - sp > 0x100000) return Site::kOther;
+    if (!read(back - 8, &saved)) return Site::kOther;
+    site = ClassifyReturn(saved, read);
+    ret = saved;
+  }
+  if (where) *where = site == Site::kOther ? 0 : ret;
+  return site;
+}
+
+// The status bits the speech code at `site` is given (fix 156's bits otherwise).
+inline uint32_t SpeechStatusBits(Site site, uint32_t bits) {
+  switch (site) {
+    case Site::kStartup: return bits | kStatusReady;   // fail start-up now: no microphone
+    case Site::kRead: return bits & ~kStatusReady;     // fail the read: no microphone
+    default: return bits;
+  }
+}
+
+}  // namespace xbox360ps5::nui_speech
