+// Fix 170: a guest word, read only where the page table says it can be (a back chain or a
+// return address that leads nowhere ends the look instead of faulting).
+bool NuiReadWord(uint32_t address, uint32_t* value) {
+  if (!address || (address & 3)) return false;
+  auto* heap = kernel_state()->memory()->LookupHeap(address);
+  uint32_t protection = 0;
+  if (!heap || !heap->QueryProtect(address, &protection) ||
+      !(protection & kMemoryProtectRead)) return false;
+  *value = xe::load_and_swap<uint32_t>(kernel_state()->memory()->TranslateVirtual(address));
+  return true;
+}
