+// merged, so their merge (a write of guest memory, invalidating the GPU's copy of those pages)
+// does not come after it and throw its data away.
+void VulkanCommandProcessor::FlushMemexportBatchIfOverlaps(uint32_t start, uint32_t length,
+                                                           uint32_t page_log2) {
+  if (memexport_batch_own_write_ || memexport_batch_.empty() ||
+      !memexport_batch_.Overlaps(start, length, page_log2)) {
+    return;
+  }
+  FlushMemexportBatch(memexport_batch::kGpuWrite);
