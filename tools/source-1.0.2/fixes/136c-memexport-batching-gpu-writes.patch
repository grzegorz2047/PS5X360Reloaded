+  // Fix 136c: whether [start, start + length) shares a page (1 << page_log2 bytes) with a pending
+  // range.
+  bool Overlaps(uint32_t start, uint32_t length, uint32_t page_log2) const {
+    if (!length) return false;
+    const uint64_t first = start >> page_log2, last = (uint64_t(start) + length - 1) >> page_log2;
+    for (const Pending& pending : pending_) {
+      for (const Range& range : pending.ranges) {
+        if (!range.size) continue;
+        const uint64_t range_first = range.start >> page_log2;
+        const uint64_t range_last = (uint64_t(range.start) + range.size - 1) >> page_log2;
+        if (range_first <= last && first <= range_last) return true;
+      }
+    }
+    return false;
+  }
