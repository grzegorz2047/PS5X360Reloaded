+// Fix 153: the hang watch without an fsync per beat. On the console (GTA IV, 1.0.6-work-fix146f
+// and 142e) its beats fell from 110 to 7 in 30 s, gaps up to 1.93 s, and every slow file
+// operation of the game on the console drive (create, rename, delete) topped out at 0.94-1.0 s:
+// the watch's own fsync, 8 a second (a beat and its guest line every 250 ms, each written and
+// synced), queued behind the drive's flushes and may have forced them. Now the beats, and the
+// frequent lines guest threads write (DbgPrint, the guest's own reports, protect and stack
+// switch lines), are written without an fsync (RawLight); HANG/STALL reports, process ends and
+// every other Raw line still sync. The words of hang-watch-sync.txt in the app folder
+// (XBOX360PS5_DATA_ROOT) switch it while a game runs, read every 2 s by the watch: "beats" syncs
+// every line again (as before), "reports" (the default, also when the file is missing) only
+// those. Every 10 s the watch times one fsync of its file and writes it as a line: a gauge of
+// how long the drive takes to flush.
+enum SyncPolicy : int { kSyncReports = 0, kSyncEveryLine = 1 };
+inline std::atomic<int> sync_policy{kSyncReports};
+inline std::atomic<RawSink> raw_light_sink{nullptr};
+// A frequent line: no fsync unless hang-watch-sync.txt says "beats". Without a light sink (the
+// watch not running) it is a Raw line.
+inline void RawLight(const std::string& text) {
+  if (RawSink sink = raw_light_sink.load(std::memory_order_acquire)) {
+    sink(text.data(), text.size());
+    return;
+  }
+  Raw(text);
+}
+// The words of hang-watch-sync.txt: the first word "beats" (or "every", "all", "sync") is every
+// line; "reports" or anything else, a missing or empty file too, is reports only.
+inline int ParseSyncSwitch(const std::string& content) {
+  size_t start = 0;
+  while (start < content.size() && (content[start] == ' ' || content[start] == '\t' ||
+                                    content[start] == '\r' || content[start] == '\n'))
+    ++start;
+  size_t end = start;
+  while (end < content.size() && content[end] != ' ' && content[end] != '\t' && content[end] != '\r' &&
+         content[end] != '\n')
+    ++end;
+  std::string word = content.substr(start, end - start);
+  for (char& c : word) c = char(std::tolower(static_cast<unsigned char>(c)));
+  return word == "beats" || word == "every" || word == "all" || word == "sync" ? kSyncEveryLine
+                                                                             : kSyncReports;
+}
+inline std::string SyncPolicyLine(int policy, bool file_found) {
+  return std::string("HANG watch sync (fix 153): ") +
+         (policy == kSyncEveryLine ? "every line synced (hang-watch-sync.txt says beats)"
+                                   : file_found ? "only reports synced (hang-watch-sync.txt says reports)"
+                                                : "only reports synced (no hang-watch-sync.txt: the default)");
+}
+// The 10 s gauge: one fsync of the watch's file, timed.
+inline std::string FsyncGaugeLine(double seconds, double fsync_ms, int policy) {
+  char text[160];
+  std::snprintf(text, sizeof(text), "HANG fsync gauge +%.2f s (fix 153): %.1f ms for one fsync of this file (%s)",
+                seconds, fsync_ms, policy == kSyncEveryLine ? "every line synced" : "only reports synced");
+  return text;
+}
