+// Xbox360PS5 fix 174 (xbox360ps5/guest_object_close.hpp): the console's object manager calls an
+// object type's close procedure from NtClose with the handle count before the close. For an
+// object the title made with a type of its own (ObCreateObject) and opened by pointer, run that
+// procedure on this guest thread before the handle goes. The NUI library frees an image
+// stream's channel there; without it Harry Potter's second open of its camera stream got
+// "already open" (0x83010003) and the title stopped on its own check (827E0F78, issue 76).
+dword_result_t NtClose_entry(dword_t handle, const ppc_context_t& ctx) {
+  namespace goc = xbox360ps5::guest_object_close;
+  uint32_t close_proc = 0, guest_object = 0, type = 0, handle_count = 0;
+  if (auto object = kernel_state()->object_table()->LookupObject<XObject>(handle)) {
+    guest_object = object->guest_object();
+    if (guest_object >= goc::kObjectHeaderSize) {
+      const uint32_t header_type = xe::load_and_swap<uint32_t>(kernel_memory()->TranslateVirtual(
+          guest_object - goc::kObjectHeaderSize + 8));
+      const auto close = goc::registry().Closing(object->guest_object(), header_type);
+      if (close.type) {
+        type = close.type;
+        handle_count = close.handle_count;
+        close_proc = xe::load_and_swap<uint32_t>(
+            kernel_memory()->TranslateVirtual(close.type + goc::kCloseProc));
+      }
+    }
+  }
+  if (close_proc) {
+    static std::atomic<uint32_t> shown{0};
+    if (shown.fetch_add(1) < 16)
+      XELOGW("Kernel: NtClose({:08X}) runs the title's close procedure {:08X} for object "
+             "{:08X} (type {:08X}, tag {:08X}, handles {}) (fix 174)",
+             uint32_t(handle), close_proc, guest_object, type,
+             xe::load_and_swap<uint32_t>(
+                 kernel_memory()->TranslateVirtual(type + goc::kPoolTag)),
+             handle_count);
+    uint64_t args[] = {guest_object, handle_count};
+    ctx->processor->Execute(ctx->thread_state, close_proc, args, 2);
+  }
+  return NtClose(handle);
+}
 DECLARE_XBOXKRNL_EXPORT1(NtClose, kNone, kImplemented);
 
