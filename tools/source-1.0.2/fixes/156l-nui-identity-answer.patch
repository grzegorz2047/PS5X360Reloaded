+// Fix 156l: has the guest run handler in place of the title's function at address, as the
+// skeleton function below is bound ("sc 2; blr" and an extern handler).
+bool BindTitleFunction(KernelState* kernel_state, cpu::XexModule* xex, uint32_t address,
+                       cpu::GuestFunction::ExternHandler handler) {
+  Memory* memory = kernel_state->memory();
+  cpu::Function* function = nullptr;
+  const cpu::Symbol::Status status = xex->DeclareFunction(address, &function);
+  if (!function || (status != cpu::Symbol::Status::kNew &&
+                    status != cpu::Symbol::Status::kDeclared))
+    return false;
+  auto* heap = memory->LookupHeap(address);
+  uint32_t protection = 0;
+  if (!heap || !heap->QueryProtect(address, &protection) ||
+      !heap->Protect(address, 8, kMemoryProtectRead | kMemoryProtectWrite))
+    return false;
+  static_cast<cpu::GuestFunction*>(function)->SetupExtern(handler);
+  uint8_t* code = memory->TranslateVirtual(address);
+  xe::store_and_swap<uint32_t>(code + 0, 0x44000042);  // sc 2
+  xe::store_and_swap<uint32_t>(code + 4, 0x4E800020);  // blr
+  heap->Protect(address, 8, protection);
+  function->set_end_address(address + 4);
+  if (status == cpu::Symbol::Status::kNew)
+    function->set_status(cpu::Symbol::Status::kDeclared);
+  return true;
+}
+
+// Fix 156l: the title's in-title Kinect ID (NuiIdentityIdentify and
+// NuiIdentityGetEnrollmentInformation), when it has it, answered for the virtual player.
+void BindIdentity(KernelState* kernel_state, cpu::XexModule* xex, uint32_t base,
+                  uint32_t size) {
+  Memory* memory = kernel_state->memory();
+  const auto found = xbox360ps5::nui_identity::FindIdentityFunctions(
+      {memory->TranslateVirtual<const uint8_t*>(base), size, base});
+  // Without NuiIdentityIdentify the title asks the system (Kinect Sports Season Two, Zumba
+  // Fitness, Dragon Ball Z have only the enrollment information function).
+  if (found.identify.empty()) return;
+  if (!found.ok()) {
+    XELOGW("Virtual Kinect: the title's Kinect ID functions were not identified ({} identify, "
+           "{} enrollment information candidates); it keeps its own (fix 156l)",
+           found.identify.size(), found.enrollment.size());
+    return;
+  }
+  const uint32_t identify = found.identify[0], enrollment = found.enrollment[0];
+  if (!BindTitleFunction(kernel_state, xex, enrollment, IdentityEnrollmentHandler) ||
+      !BindTitleFunction(kernel_state, xex, identify, IdentityIdentifyHandler)) {
+    XELOGW("Virtual Kinect: the title's Kinect ID functions at {:08X} / {:08X} could not be "
+           "bound (fix 156l)", identify, enrollment);
+    return;
+  }
+  XELOGW("Virtual Kinect: the title's Kinect ID answers for the signed-in profile (identify at "
+         "{:08X}, enrollment information at {:08X}) (fix 156l)", identify, enrollment);
+}
