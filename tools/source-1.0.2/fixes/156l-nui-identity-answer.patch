+// Fix 156l (Fighters Uncaged, #67): Kinect ID for titles that identify the player themselves
+// (xbox360ps5/nui_identity.hpp). The signed-in profile slots, as the skeleton frame sees them.
+uint32_t SignedInMask(KernelState* kernel_state) {
+  uint32_t mask = 0;
+  for (uint32_t slot = 0; slot < 4; ++slot)
+    if (kernel_state->xam_state()->IsUserSignedIn(slot) &&
+        kernel_state->xam_state()->GetUserProfile(slot))
+      mask |= 1u << slot;
+  return mask;
+}
+uint32_t VirtualPlayerSlot(KernelState* kernel_state) {
+  uint32_t bound = xbox360ps5::motion::kUserIndexNone;
+  {
+    std::lock_guard lock(xbox360ps5::motion::nui_mutex);
+    bound = xbox360ps5::motion::nui_binding.user_index;
+  }
+  return xbox360ps5::nui_identity::ProfileSlot(bound, SignedInMask(kernel_state));
+}
+
+// NuiIdentityIdentify(tracking_id, flags, callback, context), bound in place of the title's.
+void IdentityIdentifyHandler(cpu::ppc::PPCContext* ppc_context, KernelState* kernel_state) {
+  const uint32_t tracking_id = uint32_t(ppc_context->r[3]);
+  const uint32_t flags = uint32_t(ppc_context->r[4]);
+  const uint32_t callback = uint32_t(ppc_context->r[5]);
+  const uint32_t context = uint32_t(ppc_context->r[6]);
+  uint32_t live = 0;
+  {
+    std::lock_guard lock(xbox360ps5::motion::nui_mutex);
+    live = xbox360ps5::motion::nui_binding.tracking_id;
+  }
+  const uint32_t result = xbox360ps5::nui_identity::Identify(
+      tracking_id, flags, callback, context, xbox360ps5::motion::enabled.load() ? live : 0);
+  ppc_context->r[3] = result;
+  static std::atomic<uint32_t> shown{0};
+  if (shown.fetch_add(1) < 8)
+    XELOGW("Virtual Kinect: the title identifies body {:08X} (flags {:X}, callback {:08X}, "
+           "context {:08X}; tracked body {:08X}) -> {:08X} (fix 156l)",
+           tracking_id, flags, callback, context, live, result);
+}
+
+// NuiIdentityGetEnrollmentInformation(index, out), bound in place of the title's.
+void IdentityEnrollmentHandler(cpu::ppc::PPCContext* ppc_context, KernelState* kernel_state) {
+  const uint32_t index = uint32_t(ppc_context->r[3]);
+  const uint32_t out = uint32_t(ppc_context->r[4]);
+  Memory* memory = kernel_state->memory();
+  const bool has_out = out && IsGuestRangeMapped(memory, out, 8, true);
+  const uint32_t slot = VirtualPlayerSlot(kernel_state);
+  const auto info = xbox360ps5::nui_identity::GetEnrollmentInformation(index, has_out, slot);
+  if (info.write) {
+    xe::store_and_swap<uint32_t>(memory->TranslateVirtual(out), info.user_index);
+    xe::store_and_swap<uint32_t>(memory->TranslateVirtual(out + 4), info.flags);
+  }
+  ppc_context->r[3] = info.result;
+  static std::atomic<uint32_t> shown{0};
+  if (shown.fetch_add(1) < 8)
+    XELOGW("Virtual Kinect: enrollment {} is user {:X} (flags {:X}) -> {:08X} (fix 156l)",
+           index, info.user_index, info.flags, info.result);
+}
+
+// The answers to the title's identify requests, on its own thread (the skeleton frame's
+// caller): "frame processed", then "complete" with the signed-in profile's enrollment.
+void DeliverIdentityAnswers(KernelState* kernel_state, uint32_t user_index) {
+  auto requests = xbox360ps5::nui_identity::TakePending();
+  if (requests.empty()) return;
+  auto* thread = cpu::ThreadState::Get();
+  Memory* memory = kernel_state->memory();
+  const uint32_t message =
+      thread ? memory->SystemHeapAlloc(uint32_t(xbox360ps5::nui_identity::kMessageBytes)) : 0;
+  if (!message) {
+    XELOGW("Virtual Kinect: {} identify answer(s) dropped (no guest thread or memory) "
+           "(fix 156l)", requests.size());
+    return;
+  }
+  const auto answer = xbox360ps5::nui_identity::AnswerFor(user_index);
+  static std::atomic<uint32_t> shown{0};
+  for (const auto& r : requests) {
+    if (!IsGuestRangeMapped(memory, r.callback, 4, false)) continue;
+    uint8_t* m = memory->TranslateVirtual<uint8_t*>(message);
+    uint64_t args[] = {r.context, message};
+    xbox360ps5::nui_identity::WriteFrameProcessed(m, r.tracking_id);
+    kernel_state->processor()->Execute(thread, r.callback, args, 2);
+    xbox360ps5::nui_identity::WriteComplete(m, r.tracking_id, answer);
+    kernel_state->processor()->Execute(thread, r.callback, args, 2);
+    if (shown.fetch_add(1) < 8)
+      XELOGW("Virtual Kinect: body {:08X} identified: result {:08X}, enrollment {:X}, "
+             "profile matched {} (user {:X}) (fix 156l)", r.tracking_id, answer.result,
+             answer.enrollment, answer.matched, user_index);
+  }
+  memory->SystemHeapFree(message);
+}
