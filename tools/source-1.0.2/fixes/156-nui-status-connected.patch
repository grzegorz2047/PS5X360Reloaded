 }
+// Fix 156 (Zumba Fitness Core, issue 63): the virtual device is there once the guest opened its
+// camera and the title's skeleton frame function is bound, before any frame was delivered.
+// Zumba asks XamNuiGetDeviceStatus once, right after its NUI start-up and before it reads a
+// skeleton frame; the 500 ms rule above (a frame delivered just now) told it there was no
+// camera, so it never asked for a frame and said it could not find the Kinect. The rule stays
+// for the player binding (LiveNuiBinding: user index and enrollment), which needs a body.
+inline bool VirtualNuiDeviceConnected(bool kinect_title) {
+  return kinect_title && enabled.load() && guest_camera_open.load() &&
+      guest_skeleton_bound.load();
+}
+// XamNuiGetDeviceStatus's answer for the virtual device. status_bits 0x3, as titles read them
+// (Zumba Fitness Core's default.xex): 0x1 connected (82278688: without it 0x8007048F, "device
+// not connected"; Xenia's own answer for an initialised Kinect is 1) and 0x2 ready (Zumba's
+// per-frame Kinect update, 82332650, which is the only caller of its skeleton read, runs only
+// with it: with 4 it read no frame at all; two fallbacks there default the bits to 2). 4 is
+// not set: no title read so far tests it, and with 4 and 0x40 but no 1 the system's
+// XNuiTitleInitialize sends the player to the troubleshooter. No microphone is emulated.
+constexpr uint32_t kVirtualNuiStatusBits = 0x3;
+constexpr uint32_t kNuiDeviceNotConnected = 0xC0050006;
+constexpr uint32_t kNuiStatusNotPresent = 0xC000009D;
+struct NuiDeviceStatus {
+  uint32_t result, camera_status, tilt_status, mic_status, status_bits;
+};
+inline NuiDeviceStatus VirtualNuiStatus(bool connected) {
+  if (!connected)
+    return {kNuiDeviceNotConnected, 0, kNuiStatusNotPresent, kNuiStatusNotPresent, 0};
+  return {0, 0, 0, kNuiStatusNotPresent, kVirtualNuiStatusBits};
+}
