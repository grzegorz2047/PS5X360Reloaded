diff --git a/include/xbox360ps5/video_mode.hpp b/include/xbox360ps5/video_mode.hpp
new file mode 100644
--- /dev/null
+++ b/include/xbox360ps5/video_mode.hpp
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: MIT
+// Fix 140 (tools/source-1.0.2/fixes/140-video-mode-900p.patch): the "Emulated console resolution" option is what the
+// game is told. Until now the option set the core's custom_internal_display_resolution_x/y, which only
+// GraphicsSystem::GetResolution read (the vertical counter's step per vblank); VdQueryVideoMode (and XGetVideoMode and
+// VdGetCurrentDisplayInformation through it) read the console's own screen size, 1280x720, so every game saw 720p
+// whatever the choice. Now VdQueryVideoMode reports the custom size when one is set (hi-def from 1280 pixels wide,
+// widescreen unless 4:3, as for the console's own size), and a 1600x900 choice is added as value 4. The default
+// (720p, value 0) sets no custom size, so the game is told exactly what it was told before. Saved values keep their
+// meaning; a saved value out of range is the default.
+#pragma once
+
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+namespace xbox360ps5 {
+namespace video_mode {
+
+struct Size {
+  uint32_t width = 0;
+  uint32_t height = 0;
+};
+
+// The option's choices: 0 the console's own (720p), 1 1920x1080, 2 848x480, 3 960x540, 4 1600x900.
+inline constexpr int kChoices = 5;
+inline Size ForChoice(int choice) {
+  static constexpr Size kSizes[kChoices] = {{0, 0}, {1920, 1080}, {848, 480}, {960, 540}, {1600, 900}};
+  return choice >= 0 && choice < kChoices ? kSizes[choice] : kSizes[0];
+}
+// A value read from settings.txt: out of range is the default.
+inline int LoadedChoice(int saved) { return saved >= 0 && saved < kChoices ? saved : 0; }
+
+// The size the game is told: the custom one when both sides are set (and fit the guest's 16 bits), else the console's.
+inline Size Reported(uint32_t custom_width, uint32_t custom_height, Size console) {
+  if (custom_width && custom_height && custom_width <= 0xFFFF && custom_height <= 0xFFFF)
+    return {custom_width, custom_height};
+  return console;
+}
+inline bool IsCustom(uint32_t custom_width, uint32_t custom_height) {
+  return custom_width && custom_height && custom_width <= 0xFFFF && custom_height <= 0xFFFF;
+}
+// As VdQueryVideoMode decides them: hi-def from 1280 pixels wide, widescreen unless exactly 4:3.
+inline bool HiDef(Size s) { return s.width >= 0x500; }
+inline bool AspectWide(Size s) { return uint64_t(s.width) * 3 != uint64_t(s.height) * 4; }
+
+// Logged once, the first time a game asks.
+inline std::string Line(Size s, bool hi_def, bool widescreen, bool custom) {
+  char line[200];
+  std::snprintf(line, sizeof(line), "Video mode (fix 140): %ux%u reported to the game (%s, %s), %s", s.width, s.height,
+                hi_def ? "hi-def" : "standard definition", widescreen ? "widescreen" : "4:3",
+                custom ? "from the Emulated console resolution setting" : "the console's own (Emulated console "
+                                                                          "resolution: 720p)");
+  return line;
+}
+
+}  // namespace video_mode
+}  // namespace xbox360ps5
