@@ -3967,8 +3973,21 @@ bool VulkanPipelineCache::SavePipelineCacheSnapshot() noexcept try {
           xbox360ps5::exit_cache_timing::Global(),
           xbox360ps5::exit_cache_timing::kRead,
           xbox360ps5::exit_cache_timing::NowNs(), written);
