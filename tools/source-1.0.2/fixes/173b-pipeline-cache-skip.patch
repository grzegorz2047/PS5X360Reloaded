diff --git a/include/xbox360ps5/pipeline_cache_skip.hpp b/include/xbox360ps5/pipeline_cache_skip.hpp
new file mode 100644
--- /dev/null
+++ b/include/xbox360ps5/pipeline_cache_skip.hpp
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: MIT
+// Fix 173b: a pipeline cache snapshot that equals the file on the drive is not written again. GTA IV
+// at 2x on 1.0.6-work-fix173 loaded 15951112 bytes of <title>.vk.bin at start and left with a
+// snapshot of the same 15951112 bytes (no new pipelines), written in 12.3 s: the process's drive
+// write budget was spent (0.44-0.69 MiB/s, its utility cache on the drive at 2x), and the exit waited
+// for a file that had not changed. The cache remembers the size and a 64-bit hash of what is on the
+// drive (the data loaded at start once its header is accepted, then each snapshot written); a
+// snapshot of the same size and hash is not written. Only a successful write updates them, so a
+// failed one is tried again at the next snapshot.
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+
+namespace xbox360ps5::pipeline_cache_skip {
+
+// 64-bit hash of the bytes, eight at a time (a few ms for 16 MB): change detection, not security.
+inline uint64_t Hash(const uint8_t* bytes, size_t size) {
+  uint64_t h = 0x9E3779B97F4A7C15ull ^ (uint64_t(size) * 0xFF51AFD7ED558CCDull);
+  size_t i = 0;
+  for (; i + 8 <= size; i += 8) {
+    uint64_t w;
+    std::memcpy(&w, bytes + i, 8);
+    w *= 0x87C37B91114253D5ull;
+    w = (w << 31) | (w >> 33);
+    w *= 0x4CF5AD432745937Full;
+    h ^= w;
+    h = ((h << 27) | (h >> 37)) * 5 + 0x52DCE729;
+  }
+  uint64_t tail = 0;
+  for (size_t shift = 0; i < size; ++i, shift += 8) tail |= uint64_t(bytes[i]) << shift;
+  h ^= tail * 0xC2B2AE3D27D4EB4Full;
+  h ^= h >> 33;
+  h *= 0xFF51AFD7ED558CCDull;
+  h ^= h >> 33;
+  h *= 0xC4CEB9FE1A85EC53ull;
+  h ^= h >> 33;
+  return h;
+}
+
+// What is on the drive at each cache path.
+class Store {
+ public:
+  void Note(const std::string& path, const uint8_t* bytes, size_t size) {
+    const uint64_t hash = Hash(bytes, size);
+    std::lock_guard<std::mutex> lock(mutex_);
+    files_[path] = {size, hash};
+  }
+  void Forget(const std::string& path) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    files_.erase(path);
+  }
+  bool Unchanged(const std::string& path, const uint8_t* bytes, size_t size) {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      const auto it = files_.find(path);
+      if (it == files_.end() || it->second.size != size) return false;
+    }
+    const uint64_t hash = Hash(bytes, size);
+    std::lock_guard<std::mutex> lock(mutex_);
+    const auto it = files_.find(path);
+    return it != files_.end() && it->second.size == size && it->second.hash == hash;
+  }
+
+ private:
+  struct File {
+    uint64_t size = 0, hash = 0;
+  };
+  std::mutex mutex_;
+  std::unordered_map<std::string, File> files_;
+};
+inline Store& Global() {
+  static Store* store = new Store();
+  return *store;
+}
+
+}  // namespace xbox360ps5::pipeline_cache_skip
