     if (pauses % kTryEvery == 0 && mutex.try_lock()) {
       Add(stats.won_spinning);
       Add(stats.wait_ticks, __rdtsc() - start);
+      if (slot) Add(slot->wait_ticks, __rdtsc() - start);
       return;
     }
   }
   mutex.lock();
   Add(stats.slept);
   Add(stats.wait_ticks, __rdtsc() - start);
+  if (slot) Add(slot->wait_ticks, __rdtsc() - start);
 }
 
+// "Performance: global lock callers (GPU thread, 1 in 64 sampled and scaled): 0x... n/s taken,
+// c/s contended, w ms/s waiting; ...; anchor 0x..." for the period since the previous line, the
+// kCallersShown callers that took it most.
+inline constexpr uint32_t kCallersShown = 8;
+class CallerReporter {
+ public:
+  std::string Line(double seconds, double ticks_per_ms,
+                   uintptr_t anchor = reinterpret_cast<uintptr_t>(&Anchor)) {
+    if (seconds <= 0) seconds = 1;
+    struct Row {
+      uintptr_t caller;
+      uint64_t taken, contended, wait_ticks;
+    };
+    std::array<Row, kCallerSlots> rows{};
+    for (uint32_t i = 0; i < kCallerSlots; ++i) {
+      const uint64_t taken = callers[i].taken.load(std::memory_order_relaxed);
+      const uint64_t contended = callers[i].contended.load(std::memory_order_relaxed);
+      const uint64_t wait = callers[i].wait_ticks.load(std::memory_order_relaxed);
+      rows[i] = {callers[i].caller.load(std::memory_order_relaxed), taken - last_[i][0], contended - last_[i][1],
+                 wait - last_[i][2]};
+      last_[i][0] = taken;
+      last_[i][1] = contended;
+      last_[i][2] = wait;
+    }
+    std::sort(rows.begin(), rows.end(), [](const Row& a, const Row& b) { return a.taken > b.taken; });
+    const double scale = double(kCallerSampleEvery) / seconds;
+    std::string text = "Performance: global lock callers (GPU thread, 1 in 64 sampled and scaled): ";
+    uint32_t shown = 0;
+    for (const Row& row : rows) {
+      if (shown == kCallersShown || !row.taken) break;
+      char item[160];
+      std::snprintf(item, sizeof(item), "%s0x%llx %.0f/s taken, %.0f/s contended, %.1f ms/s waiting", shown ? "; " : "",
+                    (unsigned long long)row.caller, double(row.taken) * scale, double(row.contended) * scale,
+                    ticks_per_ms > 0 ? double(row.wait_ticks) / ticks_per_ms * scale : 0.0);
+      text += item;
+      ++shown;
+    }
+    char tail[96];
+    std::snprintf(tail, sizeof(tail), "%s%llu samples without a slot; anchor 0x%llx", shown ? "; " : "",
+                  (unsigned long long)callers_dropped.load(std::memory_order_relaxed), (unsigned long long)anchor);
+    return text + tail;
+  }
+
+ private:
+  std::array<std::array<uint64_t, 3>, kCallerSlots> last_{};
+};
