   Add(stats.taken);
+  CallerSlot* slot = nullptr;
+  if (caller && ++caller_sample_counter % kCallerSampleEvery == 0) {
+    slot = SlotFor(reinterpret_cast<uintptr_t>(caller));
+    if (slot) Add(slot->taken);
+  }
   if (mutex.try_lock()) return;
   Add(stats.contended);
+  if (slot) Add(slot->contended);
   const uint64_t start = __rdtsc();
