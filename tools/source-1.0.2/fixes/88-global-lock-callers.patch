+// Fix 88: which code the GPU thread takes the lock for. Modern Warfare 2 on the 1.0.5 perf builds
+// with fix 87: 102,775 locks a second, 91.8 ms/s waiting, after draws (fix 86) and arming
+// (fix 84) no longer take it per call; the known callers explain only part of it. One in
+// kCallerSampleEvery of the GPU thread's locks is counted for its caller (the return address
+// into the code that asked for the lock), with whether it waited and how long; the summary gives
+// the callers that took it most, scaled back. The anchor's address at run time, with its address
+// in the build's eboot-symbols.txt, places the callers.
+inline constexpr uint32_t kCallerSampleEvery = 64;
+inline constexpr uint32_t kCallerSlots = 256;
+struct CallerSlot {
+  std::atomic<uintptr_t> caller{0};
+  std::atomic<uint64_t> taken{0}, contended{0}, wait_ticks{0};
+};
+inline std::array<CallerSlot, kCallerSlots> callers;
+inline std::atomic<uint64_t> callers_dropped{0};  // samples with no free slot
+inline uint32_t caller_sample_counter = 0;        // the GPU thread's alone
+inline void Anchor() { asm volatile(""); }
+// The caller's slot (claimed on first use), or null when the table is full.
+inline CallerSlot* SlotFor(uintptr_t caller) {
+  uint32_t index = uint32_t((caller >> 2) * 0x9E3779B1u) % kCallerSlots;
+  for (uint32_t probe = 0; probe < kCallerSlots; ++probe, index = (index + 1) % kCallerSlots) {
+    const uintptr_t held = callers[index].caller.load(std::memory_order_relaxed);
+    if (held == caller) return &callers[index];
+    if (!held) {
+      callers[index].caller.store(caller, std::memory_order_relaxed);
+      return &callers[index];
+    }
+  }
+  Add(callers_dropped);
+  return nullptr;
+}
