+// asked for the lock (fix 88), or null.
 template <class Mutex>
-inline void Lock(Mutex& mutex) {
+inline void Lock(Mutex& mutex, const void* caller = nullptr) {
   if (!SpinsHere()) {
     mutex.lock();
