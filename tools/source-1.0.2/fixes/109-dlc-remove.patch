+// Fix 109: a package's size in decimal units, as the PS5's storage screens give it: "640 KB",
+// "812 MB", "1.2 GB", "15 GB".
+inline std::string SizeText(uint64_t bytes) {
+  char text[32];
+  const double kb = double(bytes) / 1e3, mb = double(bytes) / 1e6, gb = double(bytes) / 1e9;
+  if (gb >= 10) std::snprintf(text, sizeof(text), "%.0f GB", gb);
+  else if (gb >= 1) std::snprintf(text, sizeof(text), "%.1f GB", gb);
+  else if (mb >= 1) std::snprintf(text, sizeof(text), "%.0f MB", mb);
+  else std::snprintf(text, sizeof(text), "%.0f KB", std::max(1.0, kb));
+  return text;
 }
 
