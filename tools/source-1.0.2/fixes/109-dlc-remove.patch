+// Fix 109: removing an installed package. Only the listed file in its device's active or disabled
+// folder is deleted, and only while no game is running; the folders stay.
+// stat and unlink only: the console's sandbox refuses lstat (fixes 50 and 60), so neither
+// std::filesystem::symlink_status nor std::filesystem::remove (libc's remove() asks lstat first)
+// can be used there; 1.0.5-work-fix109 failed so with BF3's HD textures on ext1. Each refusal
+// says which step and errno (why, for the log).
+enum class Removal { removed, game_running, not_installed, missing, failed };
+struct RemoveStep {
+  std::string call;  // "stat", "unlink", "check: ..."
+  int error = 0;     // errno, 0 when none
+};
+inline Removal Remove(const Item& item, uint32_t title, bool game_running, RemoveStep* why = nullptr) {
+  const auto refuse = [why](Removal removal, const char* call, int error = 0) {
+    if (why) *why = {call, error};
+    return removal;
+  };
+  if (game_running) return refuse(Removal::game_running, "check: a game is running");
+  if (item.state == State::available || item.root.empty() || item.file.empty() || !title)
+    return refuse(Removal::not_installed, "check: not an installed package");
+  const fs::path folder =
+      item.state == State::active ? ActiveFolder(item.root, title) : DisabledFolder(item.root, title);
+  if (item.path != folder / item.file) return refuse(Removal::not_installed, "check: not in its own folder");
+  std::error_code ec;
+  const fs::file_status status = fs::status(item.path, ec);  // stat
+  if (ec) return refuse(ec.value() == ENOENT ? Removal::missing : Removal::failed, "stat", ec.value());
+  if (!fs::is_regular_file(status)) return refuse(Removal::failed, "stat: not a regular file");
+#ifdef _WIN32
+  fs::remove(item.path, ec);  // the host checks on Windows
+  const int error = ec.value();
+#else
+  const int error = ::unlink(item.path.c_str()) == 0 ? 0 : errno;
+#endif
+  if (error) return refuse(error == ENOENT ? Removal::missing : Removal::failed, "unlink", error);
+  if (fs::exists(item.path, ec)) return refuse(Removal::failed, "unlink: the file is still there");  // stat
+  if (why) *why = {"unlink", 0};
+  return Removal::removed;
+}
