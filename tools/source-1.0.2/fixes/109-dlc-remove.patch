+// Fix 109: removing an installed package. Only the listed file in its device's active or disabled
+// folder is deleted, and only while no game is running; the folders stay.
+enum class Removal { removed, game_running, not_installed, missing, failed };
+inline Removal Remove(const Item& item, uint32_t title, bool game_running) {
+  if (game_running) return Removal::game_running;
+  if (item.state == State::available || item.root.empty() || item.file.empty() || !title)
+    return Removal::not_installed;
+  const fs::path folder =
+      item.state == State::active ? ActiveFolder(item.root, title) : DisabledFolder(item.root, title);
+  if (item.path != folder / item.file) return Removal::not_installed;
+  std::error_code ec;
+  const fs::file_status status = fs::symlink_status(item.path, ec);
+  if (ec || !fs::is_regular_file(status)) return Removal::missing;
+  if (!fs::remove(item.path, ec) || ec) return Removal::failed;
+  return Removal::removed;
+}
+// Fix 109: a package's size in decimal units, as the PS5's storage screens give it: "640 KB",
+// "812 MB", "1.2 GB", "15 GB".
+inline std::string SizeText(uint64_t bytes) {
+  char text[32];
+  const double kb = double(bytes) / 1e3, mb = double(bytes) / 1e6, gb = double(bytes) / 1e9;
+  if (gb >= 10) std::snprintf(text, sizeof(text), "%.0f GB", gb);
+  else if (gb >= 1) std::snprintf(text, sizeof(text), "%.1f GB", gb);
+  else if (mb >= 1) std::snprintf(text, sizeof(text), "%.0f MB", mb);
+  else std::snprintf(text, sizeof(text), "%.0f KB", std::max(1.0, kb));
+  return text;
+}
