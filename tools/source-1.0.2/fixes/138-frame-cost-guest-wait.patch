 //   - other threads' waits for the GPU (the UI thread's presenter);
 // and a reading: GPU-bound, waiting for readbacks or queries (synchronisation), the guest's own
 // CPU time (game code, JIT, the kernel), or the command thread's own work.
+// Fix 138: "executing" also held the GPU thread's sleeps in WAIT_REG_MEM, waiting for the guest
+// to write a memory word or register (fix 77's "sleeping"). Red Dead Redemption with fix 134c in
+// mode 1 moved 140 ms/s of replay to the submit worker, yet "executing" stayed at 989 ms/s: the
+// WAIT_REG_MEM sleeps went from 39-47 to 206-208 ms/s. They are now taken out and shown on
+// their own, after "idle for the guest": "waiting for the guest (WAIT_REG_MEM) x ms/s in n
+// sleeps/s". The old "executing" is the new one plus that figure.
 // No Xenia headers: tools/check-frame-cost.cpp drives it.
 #pragma once
 #include <algorithm>
@@ -44,6 +50,7 @@ inline uint64_t NowNs() {
 struct Totals {
   std::array<std::atomic<uint64_t>, kCauses> wait_ns{}, waits{};
   std::atomic<uint64_t> execute_ns{0}, idle_ns{0};       // GPU command thread
+  std::atomic<uint64_t> guest_wait_ns{0}, guest_waits{0};  // fix 138: its WAIT_REG_MEM sleeps
   std::atomic<uint64_t> other_wait_ns{0}, other_waits{0};  // other threads' fence waits
   std::atomic<uint64_t> gpu_busy_ns{0}, gpu_samples{0}, submissions{0};
