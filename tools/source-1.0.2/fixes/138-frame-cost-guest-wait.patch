+  uint64_t BeforeSleep() {
+    if (!active_) return 0;
+    sleep_start_ns_ = NowNs();  // fix 138
+    return Ticks();
+  }
   void AfterSleep(uint64_t before) {
     if (!active_) return;
     slept_ += Ticks() - before;
     ++sleeps_;
+    // Fix 138: the sleep, out of "executing" in the Frame time line.
+    AddOwn(totals.guest_wait_ns, NowNs() - sleep_start_ns_);
+    AddOwn(totals.guest_waits, 1);
   }
   ~WaitRegTimer() {
     if (!active_ || !start_) return;
