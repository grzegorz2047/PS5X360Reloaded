+++ b/.deps/xenia-canary/src/xenia/vfs/devices/host_delete_steps.h
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: MIT
+// Xbox360PS5, fix 150b: a file renamed for its delete (fix 139b) is shrunk to nothing in steps
+// before its unlink. Grand Theft Auto IV deletes one of its cache files (CACHE1\bars_1.img and
+// others, hundreds of MB) and makes it again at once; on 1.0.6-work-fix146f-150-152-153 each
+// such create on the game thread took 723-948 ms and ended 5-21 ms after the background unlink of
+// the old file (fix 150) did: freeing all of a big file's blocks at once held the console's file
+// system for about 0.95 s. Shrunk 4 MiB at a time with a short pause between, each hold is short,
+// and the game's create or rename waits for one step at most.
+#ifndef XENIA_VFS_DEVICES_HOST_DELETE_STEPS_H_
+#define XENIA_VFS_DEVICES_HOST_DELETE_STEPS_H_
+
+#include <atomic>
+#include <cstdint>
+
+namespace xe {
+namespace vfs {
+namespace delete_steps {
+
+inline constexpr uint64_t kStepBytes = uint64_t(4) << 20;
+inline constexpr int kPauseMs = 2;
+// The steps the last shrink took (tests and the slow-operation line).
+inline std::atomic<uint32_t> last_steps{0};
+
+// From `size` bytes down to `step` or less, `step` bytes at a time (`resize(new_size)`, false
+// stops), with `pause()` after each; then `remove()`, whose result it returns.
+template <class Resize, class Remove, class Pause>
+bool ShrinkThenRemove(uint64_t size, uint64_t step, Resize&& resize, Remove&& remove,
+                      Pause&& pause) {
+  uint32_t steps = 0;
+  while (step && size > step) {
+    size -= step;
+    if (!resize(size)) {
+      break;
+    }
+    ++steps;
+    pause();
+  }
+  last_steps.store(steps, std::memory_order_relaxed);
+  return remove();
+}
+
+}  // namespace delete_steps
+}  // namespace vfs
+}  // namespace xe
+
+#endif  // XENIA_VFS_DEVICES_HOST_DELETE_STEPS_H_
