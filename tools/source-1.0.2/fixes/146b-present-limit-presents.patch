+// The game's time between pictures, written by the producer without a lock (a count lost to a
+// race at the window's start does not matter for a summary).
+class AtomicIntervalHistogram {
+ public:
+  void Add(int64_t ns) {
+    const size_t bin = ns <= 0 ? 0
+                               : std::min(IntervalHistogram::kBins - 1,
+                                          size_t(ns / IntervalHistogram::kBinNs));
+    bins_[bin].fetch_add(1, std::memory_order_relaxed);
+    int64_t longest = longest_.load(std::memory_order_relaxed);
+    while (ns > longest &&
+           !longest_.compare_exchange_weak(longest, ns, std::memory_order_relaxed)) {
+    }
+  }
+  // Moves the counts into `out` and starts again.
+  int64_t Take(IntervalHistogram& out) {
+    out.Clear();
+    for (size_t i = 0; i < IntervalHistogram::kBins; ++i) {
+      const uint32_t count = bins_[i].exchange(0, std::memory_order_relaxed);
+      for (uint32_t n = 0; n < count; ++n) out.Add(int64_t(i) * IntervalHistogram::kBinNs);
+    }
+    return longest_.exchange(0, std::memory_order_relaxed);
+  }
+
+ private:
+  std::array<std::atomic<uint32_t>, IntervalHistogram::kBins> bins_{};
+  std::atomic<int64_t> longest_{0};
+};
