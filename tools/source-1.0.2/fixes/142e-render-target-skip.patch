+// Xbox360PS5, fix 142e: the mode from render-target-skip.txt in the title folder when it exists
+// (read again at most once a second), else render_target_skip; while it is not 0, the line once
+// a second.
+void VulkanRenderTargetCache::Fix142eEndSubmission() {
+  const auto now = std::chrono::steady_clock::now();
+  const bool first = fix142e_checked_ == std::chrono::steady_clock::time_point();
+  if (!first && now - fix142e_checked_ < std::chrono::seconds(1)) {
+    return;
+  }
+  const double seconds =
+      first ? 0.0 : std::chrono::duration<double>(now - fix142e_checked_).count();
+  fix142e_checked_ = now;
+  // A value that is not a mode is off, never the strongest one.
+  uint32_t mode = cvars::render_target_skip < render_target_skip::kModes
+                      ? uint32_t(cvars::render_target_skip)
+                      : uint32_t(render_target_skip::kOff);
+  const char* from = "the settings";
+#if XE_PLATFORM_PS5
+  const char* const path = XBOX360PS5_DATA_ROOT "/render-target-skip.txt";
+  if (FILE* file = std::fopen(path, "rb")) {
+    std::string text;
+    char chunk[256];
+    size_t got;
+    while ((got = std::fread(chunk, 1, sizeof(chunk), file)) > 0) text.append(chunk, got);
+    std::fclose(file);
+    from = render_target_skip::ParseMode(text, mode) ? path : "the settings (file not understood)";
+  }
+#endif
+  if (!fix142e_mode_logged_ || mode != fix142e_mode_) {
+    XELOGW("Render target skip (fix 142e): mode {} ({}), from {}", mode,
+           mode == render_target_skip::kVerify ? "verify"
+           : mode == render_target_skip::kSkip ? "skip"
+                                               : "off",
+           from);
+    fix142e_mode_ = mode;
+    fix142e_mode_logged_ = true;
+    fix142e_memo_.Invalidate();
+    fix142e_mismatches_logged_ = 0;
+  } else if (seconds > 0 && mode != render_target_skip::kOff) {
+    XELOGW("{}", render_target_skip::Line(mode, fix142e_stats_, fix142e_stats_logged_, seconds));
+  }
+  fix142e_stats_logged_ = fix142e_stats_;
+}
