diff --git a/.deps/xenia-canary/src/xenia/gpu/render_target_skip.h b/.deps/xenia-canary/src/xenia/gpu/render_target_skip.h
new file mode 100644
index 0000000..b625f40
--- /dev/null
+++ b/.deps/xenia-canary/src/xenia/gpu/render_target_skip.h
@@ -0,0 +1,224 @@
+// SPDX-License-Identifier: MIT
+// Xbox360PS5, fix 142e: skips RenderTargetCache::Update for a draw that would change nothing.
+//
+// Fix 142d measured RenderTargetCache::Update at 86-98 ms/s in Grand Theft Auto IV, 43.6 in Red
+// Dead Redemption and 74.5 in Modern Warfare 2, and the render pass the same as the previous
+// draw's for 99.1-99.9% of the draws. Update is still needed for those draws: it estimates the
+// draw's height from its registers, claims the EDRAM ranges, creates render targets, transfers
+// between them and transitions their layouts. It is skipped here only when running it again
+// cannot do anything:
+//   1. The draw's key matches the last Update's: the registers Update reads (kRegisters, which
+//      check-render-target-skip compares with the functions' text), its parameters, the
+//      resolution scale and the settings it reads.
+//   2. The draw is clipped (PA_CL_CLIP_CNTL.clip_disable clear). An unclipped draw's height can
+//      come from its vertices, run on the CPU, which the key does not hold.
+//   3. The cache's state version is unchanged since that Update returned. Every change of the
+//      state Update reads bumps it (Touch), in Update or anywhere else: a claimed EDRAM range, a
+//      created render target, a layout transition, a resolve, a trim, a cleared cache.
+//   4. That Update changed nothing: the version did not move during it and what it leaves for
+//      the draw (the bound render targets, the transfers, the render pass and framebuffer) is
+//      what it was before it.
+// Then Update would run the same code on the same inputs and state and change nothing again.
+//
+// Modes (render_target_skip, or the number in render-target-skip.txt in the title folder):
+//   0 off: Update always runs and nothing here is looked at (only the version is counted).
+//   1 verify: Update always runs; when the memo says it could have been skipped, whether it then
+//     changed anything is checked, and each such draw counted as a mismatch (the first ones are
+//     logged with what changed).
+//   2 skip: the memo's draws return at once with the last Update's results.
+// Host render targets only; the fragment shader interlock path always runs Update.
+#ifndef XENIA_GPU_RENDER_TARGET_SKIP_H_
+#define XENIA_GPU_RENDER_TARGET_SKIP_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <sstream>
+#include <string>
+#include <type_traits>
+
+#include "xenia/gpu/registers.h"
+
+namespace xe {
+namespace gpu {
+namespace render_target_skip {
+
+enum Mode : uint32_t { kOff = 0, kVerify = 1, kSkip = 2, kModes };
+
+// render-target-skip.txt: one number, 0, 1 or 2, "#" comments. Returns false (mode untouched)
+// for anything else.
+inline bool ParseMode(const std::string& text, uint32_t& mode) {
+  std::istringstream lines(text);
+  std::string line;
+  bool found = false;
+  uint32_t value = kOff;
+  while (std::getline(lines, line)) {
+    const size_t hash = line.find('#');
+    if (hash != std::string::npos) line.resize(hash);
+    std::istringstream words(line);
+    std::string word;
+    while (words >> word) {
+      if (found || word.size() != 1 || word[0] < '0' || word[0] >= char('0' + kModes)) {
+        return false;
+      }
+      value = uint32_t(word[0] - '0');
+      found = true;
+    }
+  }
+  if (found) mode = value;
+  return found;
+}
+
+// The registers RenderTargetCache::Update reads for a clipped draw on the host render target
+// path, with DrawExtentEstimator::EstimateMaxY, draw_util::GetScissor and the Vulkan Update.
+constexpr Register kRegisters[] = {
+    XE_GPU_REG_RB_SURFACE_INFO,         XE_GPU_REG_RB_DEPTH_INFO,
+    XE_GPU_REG_RB_COLOR_INFO,           XE_GPU_REG_RB_COLOR1_INFO,
+    XE_GPU_REG_RB_COLOR2_INFO,          XE_GPU_REG_RB_COLOR3_INFO,
+    XE_GPU_REG_RB_DEPTHCONTROL,         XE_GPU_REG_PA_SC_WINDOW_OFFSET,
+    XE_GPU_REG_PA_SC_WINDOW_SCISSOR_TL, XE_GPU_REG_PA_SC_WINDOW_SCISSOR_BR,
+    XE_GPU_REG_PA_SC_SCREEN_SCISSOR_TL, XE_GPU_REG_PA_SC_SCREEN_SCISSOR_BR,
+    XE_GPU_REG_PA_CL_CLIP_CNTL,         XE_GPU_REG_PA_CL_VTE_CNTL,
+    XE_GPU_REG_PA_SU_SC_MODE_CNTL,      XE_GPU_REG_PA_SU_VTX_CNTL,
+    XE_GPU_REG_PA_CL_VPORT_YOFFSET,     XE_GPU_REG_PA_CL_VPORT_YSCALE,
+};
+constexpr size_t kRegisterCount = sizeof(kRegisters) / sizeof(kRegisters[0]);
+
+// Everything Update's outcome depends on besides the cache's own state.
+struct Key {
+  uint32_t registers[kRegisterCount] = {};
+  uint32_t words[16] = {};
+  uint32_t word_count = 0;
+  template <typename T>
+  void Add(const T& value) {
+    static_assert(std::is_trivially_copyable<T>::value && sizeof(T) <= 8, "a word or two");
+    uint64_t bits = 0;
+    std::memcpy(&bits, &value, sizeof(T));
+    if (word_count <= sizeof(words) / sizeof(words[0]) - 2) {  // UINT32_MAX stays
+      words[word_count++] = uint32_t(bits);
+      words[word_count++] = uint32_t(bits >> 32);
+    } else {
+      word_count = UINT32_MAX;  // never equal to a key that fits: no skip
+    }
+  }
+  bool operator==(const Key& other) const {
+    return word_count == other.word_count && word_count != UINT32_MAX &&
+           !std::memcmp(registers, other.registers, sizeof(registers)) &&
+           !std::memcmp(words, other.words, sizeof(words));
+  }
+  // Index of the first register that differs, kRegisterCount for the other words, -1 if none.
+  int FirstDifference(const Key& other) const {
+    for (size_t i = 0; i < kRegisterCount; ++i) {
+      if (registers[i] != other.registers[i]) return int(i);
+    }
+    return *this == other ? -1 : int(kRegisterCount);
+  }
+};
+
+// What Update leaves for the draw and later draws: the bound render targets, the transfers, the
+// render pass and the framebuffer. Compared before and after an Update.
+struct Outputs {
+  uint64_t words[32] = {};
+  uint32_t count = 0;
+  template <typename T>
+  void Add(const T& value) {
+    static_assert(std::is_trivially_copyable<T>::value && sizeof(T) <= 8, "a word");
+    uint64_t bits = 0;
+    std::memcpy(&bits, &value, sizeof(T));
+    if (count < sizeof(words) / sizeof(words[0])) {
+      words[count] = bits;
+    }
+    ++count;  // past the end: never equal, the Update counts as a change
+  }
+  bool operator==(const Outputs& other) const {
+    return count == other.count && count <= sizeof(words) / sizeof(words[0]) &&
+           !std::memcmp(words, other.words, sizeof(words));
+  }
+  // The first word that differs, -1 if none (the count past the end differing counts as 32).
+  int FirstDifference(const Outputs& other) const {
+    if (*this == other) return -1;
+    for (uint32_t i = 0; i < count && i < other.count && i < sizeof(words) / sizeof(words[0]);
+         ++i) {
+      if (words[i] != other.words[i]) return int(i);
+    }
+    return int(sizeof(words) / sizeof(words[0]));
+  }
+};
+
+// Runs a function when the scope ends (Update has several returns).
+template <typename F>
+class AtExit {
+ public:
+  explicit AtExit(F f) : f_(f) {}
+  ~AtExit() { f_(); }
+  AtExit(const AtExit&) = delete;
+  AtExit& operator=(const AtExit&) = delete;
+
+ private:
+  F f_;
+};
+
+// The last Update's key and the cache's state version after it, valid when it changed nothing.
+class Memo {
+ public:
+  bool Predict(const Key& key, uint64_t version) const {
+    return valid_ && version == version_ && key == key_;
+  }
+  void Record(const Key& key, bool succeeded, bool changed, uint64_t version) {
+    valid_ = succeeded && !changed;
+    key_ = key;
+    version_ = version;
+  }
+  void Invalidate() { valid_ = false; }
+  bool valid() const { return valid_; }
+
+ private:
+  Key key_;
+  uint64_t version_ = 0;
+  bool valid_ = false;
+};
+
+enum Mismatch : uint32_t { kMismatchState, kMismatchOutputs, kMismatchFailed, kMismatches };
+
+// Counted on the GPU thread, logged from it once a second.
+struct Stats {
+  uint64_t updates = 0;     // Update calls (host render target path, mode not 0), skipped too
+  uint64_t eligible = 0;    // clipped draws with a key
+  uint64_t unclipped = 0;   // clip_disable set: never skipped
+  uint64_t predicted = 0;   // the memo said the Update could be skipped (mode 1 or 2)
+  uint64_t skipped = 0;     // mode 2: of those, returned at once
+  uint64_t mismatches[kMismatches] = {};  // mode 1: predicted, yet Update changed something
+  uint64_t changed = 0;     // Updates that changed something (the memo starts again)
+  uint64_t MismatchTotal() const {
+    return mismatches[kMismatchState] + mismatches[kMismatchOutputs] +
+           mismatches[kMismatchFailed];
+  }
+};
+
+// The diagnostics line for the counts since `before`.
+inline std::string Line(uint32_t mode, const Stats& now, const Stats& before, double seconds) {
+  const double per_second = seconds > 0 ? 1.0 / seconds : 0.0;
+  auto rate = [&](uint64_t a, uint64_t b) { return uint64_t(double(a - b) * per_second + 0.5); };
+  const uint64_t updates = now.updates - before.updates;
+  const uint64_t predicted = now.predicted - before.predicted;
+  std::ostringstream line;
+  line << "Render target skip (fix 142e): mode " << mode
+       << (mode == kVerify ? " (verify)" : mode == kSkip ? " (skip)" : " (off)") << ", per second "
+       << rate(now.updates, before.updates) << " updates, " << rate(now.eligible, before.eligible)
+       << " clipped, " << rate(now.unclipped, before.unclipped) << " unclipped, "
+       << rate(now.predicted, before.predicted) << " could skip ("
+       << (updates ? predicted * 100 / updates : 0) << "%), "
+       << rate(now.skipped, before.skipped) << " skipped, " << rate(now.changed, before.changed)
+       << " changed; mismatches " << now.MismatchTotal() - before.MismatchTotal() << " (state "
+       << now.mismatches[kMismatchState] - before.mismatches[kMismatchState] << ", outputs "
+       << now.mismatches[kMismatchOutputs] - before.mismatches[kMismatchOutputs] << ", failed "
+       << now.mismatches[kMismatchFailed] - before.mismatches[kMismatchFailed] << "), "
+       << now.MismatchTotal() << " in all";
+  return line.str();
+}
+
+}  // namespace render_target_skip
+}  // namespace gpu
+}  // namespace xe
+
+#endif  // XENIA_GPU_RENDER_TARGET_SKIP_H_
