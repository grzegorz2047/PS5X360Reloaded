+// Fix 142f: why a resolve readback waited for the GPU (the GPU thread's; set by
+// ResolveReasonScope around each wait of the kResolve cause).
+enum ResolveReason : uint32_t {
+  kResolveFullMode = 0,  // readback "full" (or not fast): every resolve read back waits for all work
+  kResolveFirstCopy,     // fast mode, no earlier copy of the key to hand over yet
+  kResolveOwnCopy,       // fast mode, the key's own copy (fixes 91k and 133: not steady)
+  kResolveGrowth,        // the scaled downscale buffer grew: all work awaited before freeing it
+  kResolveUnnamed,       // a wait of the kResolve cause outside a named place
+  kResolveReasons
+};
+inline const char* ResolveReasonName(uint32_t reason) {
+  static const char* const names[] = {"full mode", "first copy of a key", "own copy (fixes 91k, 133)",
+                                      "downscale buffer growth", "unnamed"};
+  return reason < kResolveReasons ? names[reason] : "?";
+}
