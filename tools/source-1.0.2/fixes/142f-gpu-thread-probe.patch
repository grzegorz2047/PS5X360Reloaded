+inline uint64_t resolve_reason_bytes = 0;
+class ResolveReasonScope {
+ public:
+  ResolveReasonScope(uint32_t reason, uint64_t bytes)
+      : previous_(resolve_reason), previous_bytes_(resolve_reason_bytes) {
+    if (!gpu_thread) return;
+    resolve_reason = reason < kResolveReasons ? reason : kResolveUnnamed;
+    resolve_reason_bytes = bytes;
+  }
+  ~ResolveReasonScope() {
+    if (!gpu_thread) return;
+    resolve_reason = previous_;
+    resolve_reason_bytes = previous_bytes_;
+  }
+  ResolveReasonScope(const ResolveReasonScope&) = delete;
+  ResolveReasonScope& operator=(const ResolveReasonScope&) = delete;
+
+ private:
+  uint32_t previous_;
+  uint64_t previous_bytes_;
+};
