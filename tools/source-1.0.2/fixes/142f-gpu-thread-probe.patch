+// nested sections taken out, scaled). The rest of each part is fix 73's figure less these.
+enum DrawSubPart : uint32_t {
+  kSubProcess = 0,     // PrimitiveProcessor::Process
+  kSubModifications,   // the vertex and pixel shader modifications
+  kSubTranslations,    // GetOrCreateTranslation and EnsureShadersTranslated
+  kSubSamplers,        // the samplers' parameters and UseSampler
+  kSubWindowOffset,    // RenderTargetCache::GetWindowOffsetTiles
+  kSubConfigurePipeline,  // PipelineCache::ConfigurePipeline
+  kSubPipelineReady,   // the pipeline's readiness checks (and waits for it, fix 49's "pipelines")
+  kSubRequestTextures, // TextureCache::RequestTextures (its own time; textures are a section)
+  kSubBindPipeline,    // binding the pipeline and its layout
+  kSubViewport,        // the viewport, scissor and VIZ predicate setup
+  kDrawSubParts
+};
+constexpr uint32_t kFirstPipelineSub = kSubConfigurePipeline;
+inline const char* DrawSubPartName(uint32_t part) {
+  static const char* const names[] = {"Process", "shader modifications", "translations", "samplers",
+                                      "window offset", "ConfigurePipeline", "pipeline readiness",
+                                      "RequestTextures", "pipeline bind", "viewport and predicate"};
+  return part < kDrawSubParts ? names[part] : "?";
+}
+inline std::array<std::atomic<uint64_t>, kDrawSubParts> draw_sub_ticks{};
+inline void DrawSubStop(uint32_t part, const BindMark& mark) {
+  if (mark.ticks && part < kDrawSubParts) AddOwn(draw_sub_ticks[part], BindOwn(mark));
+}
+class DrawSubScope {
+ public:
+  explicit DrawSubScope(uint32_t part) : part_(part), mark_(BindStart()) {}
+  ~DrawSubScope() { DrawSubStop(part_, mark_); }
+  DrawSubScope(const DrawSubScope&) = delete;
+  DrawSubScope& operator=(const DrawSubScope&) = delete;
+
+ private:
+  uint32_t part_;
+  BindMark mark_;
+};
+
+// What a timed packet's timer costs: inside the packet's own time (between its two clock reads)
+// and outside it (what the enclosing packet sees beyond that), in ticks. Estimated by running the
+// timer's own steps on scratch counters on the calling thread, which runs on the same kind of core.
+struct TimerCost {
+  double inside_ticks = 0, outside_ticks = 0;
+};
+inline TimerCost EstimatePacketTimerCost(uint32_t rounds = 4096) {
+  std::atomic<uint64_t> scratch_ticks{0}, scratch_count{0};
+  uint64_t nested = 0, inside = 0, timed = 0;
+  volatile bool on_thread = false;
+  const uint64_t outer_start = Ticks();
+  for (uint32_t i = 0; i < rounds; ++i) {
+    on_thread = OnGpuThread();  // the constructor's test
+    const uint64_t start = Ticks();
+    const uint64_t other = OtherSectionTicks() + section_ticks[kDraw].load(std::memory_order_relaxed);
+    const uint64_t nested_before = nested, timed_before = timed;
+    const uint64_t wall = Ticks() - start;  // the destructor
+    const uint64_t sections =
+        OtherSectionTicks() + section_ticks[kDraw].load(std::memory_order_relaxed) - other;
+    const uint64_t own = wall > sections ? wall - sections : 0;
+    AddOwn(scratch_ticks, own);
+    AddOwn(scratch_count, 1);
+    AddOwn(scratch_ticks, timed - timed_before);
+    ++timed;
+    nested = nested_before + wall - sections;
+    inside += own;
+  }
+  const uint64_t outer = Ticks() - outer_start;
+  (void)on_thread;
+  TimerCost cost;
+  if (rounds) {
+    cost.inside_ticks = double(inside) / rounds;
+    cost.outside_ticks = outer > inside ? double(outer - inside) / rounds : 0.0;
+  }
+  return cost;
+}
+
+// "Frame time GPU thread without waits (fix 142f): executing x ms/s, of which sections ..., GPU
+// waits w ms/s (fix 49's fences), WAIT_REG_MEM sleeps z ms/s (fix 138), and the rest (packets,
+// registers, constants) r ms/s" - the detail line's rest of executing holds the waits; this one
+// takes them out. And "Frame time packet timing (GPU thread, fix 142f): ..." with INDIRECT_BUFFER's
+// nested timed packets and the timer's cost in them, type 0 by register group, and fix 73's
+// primitives and pipeline parts by sub-part. And "Frame time resolve waits (GPU thread, fix 142f):
+// ..." by reason.
+class ProbeReporter {
+ public:
+  // `fixed_ns_per_tick` and `fixed_cost` (tests): instead of the measured ones.
+  std::string Lines(double seconds, double fixed_ns_per_tick = 0, const TimerCost* fixed_cost = nullptr) {
+    const uint64_t ticks_now = Ticks(), ns_now = NowNs();
+    double ns_per_tick = last_ns_per_tick_ > 0 ? last_ns_per_tick_ : 1.0;
+    if (last_ticks_ && ticks_now > last_ticks_ && ns_now > last_ns_)
+      ns_per_tick = double(ns_now - last_ns_) / double(ticks_now - last_ticks_);
+    if (fixed_ns_per_tick > 0) ns_per_tick = fixed_ns_per_tick;
+    last_ns_per_tick_ = ns_per_tick;
+    last_ticks_ = ticks_now;
+    last_ns_ = ns_now;
+    const double s = seconds > 0 ? seconds : 1;
+    auto ms_ticks = [&](double ticks) { return ticks * ns_per_tick / 1e6 / s; };
+    auto ms_ns = [&](double ns) { return ns / 1e6 / s; };
+
+    // The GPU thread without its waits.
+    const double execute = ms_ns(Delta(totals.execute_ns, last_execute_));
+    const double guest = ms_ns(Delta(totals.guest_wait_ns, last_guest_));
+    const double guest_n = Delta(totals.guest_waits, last_guest_n_) / s;
+    double sections_ms[kSections] = {};
+    double covered = 0;
+    std::string sections;
+    for (uint32_t n = 1; n < kSections; ++n) {
+      sections_ms[n] = ms_ticks(Delta(section_ticks[n], last_sections_[n]));
+      covered += sections_ms[n];
+      if (n == kWait) continue;
+      char item[64];
+      std::snprintf(item, sizeof(item), "%s%s %.1f", sections.empty() ? "" : ", ", SectionName(n), sections_ms[n]);
+      sections += item;
+    }
+    double pipeline_waits = ms_ns(Delta(totals.wait_ns[kPipeline], last_pipeline_));
+    const double rest = execute > covered + guest ? execute - covered - guest : 0.0;
+    char first[640];
+    std::snprintf(first, sizeof(first),
+                  "Frame time GPU thread without waits (fix 142f): executing %.0f ms/s with every wait in it; "
+                  "sections %s ms/s (draws hold pipeline waits %.1f); GPU waits %.1f ms/s; WAIT_REG_MEM sleeps "
+                  "%.1f ms/s in %.0f/s; the rest of executing (packets, registers, constants) without waits %.1f ms/s",
+                  execute, sections.c_str(), pipeline_waits, sections_ms[kWait], guest, guest_n, rest);
+
+    // Packet timing.
+    const TimerCost cost = fixed_cost ? *fixed_cost : EstimatePacketTimerCost();
+    const uint64_t top = packet_top.load(std::memory_order_relaxed);
+    const uint64_t sampled = packet_top_sampled.load(std::memory_order_relaxed);
+    const double scale = sampled != last_top_sampled_ ? double(top - last_top_) / double(sampled - last_top_sampled_)
+                                                      : 0.0;
+    last_top_ = top;
+    last_top_sampled_ = sampled;
+    const double ib_ms = ms_ticks(Delta(packet_ticks[kPacketIndirect], last_ib_ticks_) * scale);
+    const double ib_n = Delta(packet_counts[kPacketIndirect], last_ib_counts_) * scale;
+    const double nested = Delta(packet_indirect_nested, last_ib_nested_) * scale;
+    const double ib_timers = ms_ticks(nested * cost.outside_ticks);
+    std::string groups;
+    for (uint32_t g = 0; g < kRegGroups; ++g) {
+      const double ms = ms_ticks(Delta(packet_register_ticks[g], last_reg_ticks_[g]) * scale);
+      const double n = Delta(packet_register_counts[g], last_reg_counts_[g]) * scale;
+      char item[128];
+      std::snprintf(item, sizeof(item), "%s%s %.1f ms/s in %.0f/s (%.0f ns each)", g ? ", " : "", RegisterGroupName(g),
+                    ms, n / s, n > 0 ? ms * 1e6 * s / n : 0.0);
+      groups += item;
+    }
+    // Fix 73's parts by sub-part (fix 142d's sampling).
+    const double draws = Delta(bind_draws, last_draws_), timed = Delta(bind_sampled, last_timed_);
+    const double draw_scale = timed > 0 ? draws / timed : 0.0;
+    std::string subs;
+    for (uint32_t n = 0; n < kDrawSubParts; ++n) {
+      const double ms = ms_ticks(Delta(draw_sub_ticks[n], last_subs_[n]) * draw_scale);
+      char item[96];
+      std::snprintf(item, sizeof(item), "%s%s%s %.1f", n == 0 ? "primitives: " : n == kFirstPipelineSub ? "; pipeline: " : ", ",
+                    "", DrawSubPartName(n), ms);
+      subs += item;
+    }
+    char second[1200];
+    std::snprintf(second, sizeof(second),
+                  "Frame time packet timing (GPU thread, fix 142f): the timer costs about %.0f ns inside a timed packet "
+                  "and %.0f ns outside it; INDIRECT_BUFFER own %.1f ms/s in %.0f/s with %.1f timed packets nested "
+                  "each, of which about %.1f ms/s is their timers; type 0 by first register: %s; draws by sub-part "
+                  "(ms/s, 1 draw in 8 timed): %s",
+                  cost.inside_ticks * ns_per_tick, cost.outside_ticks * ns_per_tick, ib_ms, ib_n / s,
+                  ib_n > 0 ? nested / ib_n : 0.0, ib_timers, groups.c_str(), subs.c_str());
+
+    // Resolve waits by reason.
+    std::string reasons;
+    double resolve_total = 0;
+    for (uint32_t r = 0; r < kResolveReasons; ++r) {
+      const double ms = ms_ns(Delta(resolve_wait_ns[r], last_resolve_ns_[r]));
+      const double n = Delta(resolve_waits[r], last_resolve_n_[r]);
+      const double bytes = Delta(resolve_wait_bytes[r], last_resolve_bytes_[r]);
+      resolve_total += ms;
+      char item[128];
+      std::snprintf(item, sizeof(item), "%s%s %.1f ms/s in %.1f/s (%.0f KiB each)", r ? ", " : "", ResolveReasonName(r),
+                    ms, n / s, n > 0 ? bytes / n / 1024.0 : 0.0);
+      reasons += item;
+    }
+    char third[700];
+    std::snprintf(third, sizeof(third), "Frame time resolve waits (GPU thread, fix 142f): %.1f ms/s; %s", resolve_total,
+                  reasons.c_str());
+    return std::string(first) + "\n" + second + "\n" + third;
+  }
+
+ private:
+  template <class Counter>
+  static double Delta(const Counter& counter, uint64_t& last) {
+    const uint64_t now = counter.load(std::memory_order_relaxed);
+    const double d = double(now - last);
+    last = now;
+    return d;
+  }
+  uint64_t last_ticks_ = 0, last_ns_ = 0;
+  double last_ns_per_tick_ = 0;
+  uint64_t last_execute_ = 0, last_guest_ = 0, last_guest_n_ = 0, last_pipeline_ = 0;
+  uint64_t last_sections_[kSections] = {};
+  uint64_t last_top_ = 0, last_top_sampled_ = 0, last_ib_ticks_ = 0, last_ib_counts_ = 0, last_ib_nested_ = 0;
+  uint64_t last_reg_ticks_[kRegGroups] = {}, last_reg_counts_[kRegGroups] = {};
+  uint64_t last_draws_ = 0, last_timed_ = 0, last_subs_[kDrawSubParts] = {};
+  uint64_t last_resolve_ns_[kResolveReasons] = {}, last_resolve_n_[kResolveReasons] = {},
+           last_resolve_bytes_[kResolveReasons] = {};
+};
+
 }  // namespace frame_cost
 }  // namespace xbox360ps5
