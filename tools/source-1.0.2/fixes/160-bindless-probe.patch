+    for (uint32_t slot = 100; slot < 108; ++slot) write_heap(slot, 0);
+    std::memset(out_mapping, 0, kOutSlots * 16);
+  }
+
+  // 1: slot 7 after a long dispatch, so the submission is still running at the next write.
+  bool pending_at_write = false;
+  if (ok && settings.heap_test && check(begin(cbs[1]), "begin")) {
+    bind(cbs[1], 1);
+    dispatch(cbs[1], 7, 256, kOutSlots - 1, 2048);
+    dispatch(cbs[1], 7, 1, 0, 1);
+    check(submit(cbs[1], fences[0]), "first submission");
