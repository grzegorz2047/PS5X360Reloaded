+    write_heap(7, 3);
+    if (ok && check(begin(cbs[3]), "begin")) {
+      bind(cbs[3], 1);
+      dispatch(cbs[3], 7, 1, 3, 1);
+      if (pipelines[2] != VK_NULL_HANDLE) {
+        bind(cbs[3], 2);
+        dispatch(cbs[3], 100, 1, 4, 1);
+      }
+      bind(cbs[3], 0);
