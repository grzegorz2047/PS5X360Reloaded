+    }
+  }
+  for (VkDescriptorSetLayout set_layout : set_layouts) {
+    if (set_layout != VK_NULL_HANDLE) {
+      dfn.vkDestroyDescriptorSetLayout(device, set_layout, nullptr);
+    }
+  }
+  if (out_mapping) dfn.vkUnmapMemory(device, out_memory);
+  if (out_buffer != VK_NULL_HANDLE) dfn.vkDestroyBuffer(device, out_buffer, nullptr);
+  if (out_memory != VK_NULL_HANDLE) dfn.vkFreeMemory(device, out_memory, nullptr);
+  if (sampler != VK_NULL_HANDLE) dfn.vkDestroySampler(device, sampler, nullptr);
+  for (uint32_t i = 0; i < kImages; ++i) {
+    if (views[i] != VK_NULL_HANDLE) dfn.vkDestroyImageView(device, views[i], nullptr);
+    if (images[i] != VK_NULL_HANDLE) dfn.vkDestroyImage(device, images[i], nullptr);
+    if (image_memory[i] != VK_NULL_HANDLE) dfn.vkFreeMemory(device, image_memory[i], nullptr);
+  }
+  for (VkFence fence : fences) {
+    if (fence != VK_NULL_HANDLE) dfn.vkDestroyFence(device, fence, nullptr);
+  }
+  if (pool != VK_NULL_HANDLE) dfn.vkDestroyCommandPool(device, pool, nullptr);
+}
