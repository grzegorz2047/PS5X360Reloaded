+    bool all = ok;
+    if (ok) {
+      VkMappedMemoryRange range = {VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE};
+      range.memory = out_memory;
+      range.size = VK_WHOLE_SIZE;
+      dfn.vkInvalidateMappedMemoryRanges(device, 1, &range);
+      const float* out = static_cast<const float*>(out_mapping);
+      const auto& checks = bp::HeapChecks();
+      for (uint32_t i = 0; i < checks.size(); ++i) {
+        const float* got = out + i * 4;
+        std::string item;
+        if (i == 4 && pipelines[2] == VK_NULL_HANDLE) {
+          item = "not run (non-uniform indexing not enabled)";
+        } else if (bp::Near(got, checks[i].expected)) {
+          item = "ok";
+        } else {
+          char text[96];
+          std::snprintf(text, sizeof(text), "WRONG (%.2f %.2f %.2f %.2f)", got[0], got[1],
+                        got[2], got[3]);
