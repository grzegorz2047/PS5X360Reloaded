+    dfn.vkCmdBindPipeline(cb, VK_PIPELINE_BIND_POINT_COMPUTE, pipelines[pipeline]);
+    dfn.vkCmdBindDescriptorSets(cb, VK_PIPELINE_BIND_POINT_COMPUTE, pipeline_layout, 0, 2, sets,
+                                0, nullptr);
+  };
+  auto dispatch = [&](VkCommandBuffer cb, uint32_t index, uint32_t iterations,
+                      uint32_t out_slot, uint32_t groups) {
+    const uint32_t push[4] = {index, 0, iterations, out_slot};
+    dfn.vkCmdPushConstants(cb, pipeline_layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(push),
+                           push);
+    dfn.vkCmdDispatch(cb, groups, 1, 1);
+  };
