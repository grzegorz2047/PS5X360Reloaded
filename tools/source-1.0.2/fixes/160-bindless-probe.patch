+#if XE_PLATFORM_PS5
+// Xbox360PS5, fix 160 (docs/design/bindless.md, step B0; xbox360ps5/bindless_probe.hpp): a
+// diagnostics-only probe, run only with "on" in bindless-probe.txt.
+namespace fix160 {
+namespace bp = xbox360ps5::bindless_probe;
+namespace fc = xbox360ps5::frame_cost;
+
+// A timer mark: the ticks minus the nested sections' ticks (fix 73's way), 0 for an untimed draw.
+inline uint64_t Mark() {
+  return bp::probe.timed() ? fc::Ticks() - fc::OtherSectionTicks() : 0;
+}
+
+// The probe's own cost, measured once on this thread: a draw counted, and a timed draw's marks.
+void CalibrateOwnCost() {
+  bp::Probe scratch;
+  constexpr uint32_t kDraws = 100000, kTimed = 20000;
+  uint64_t start = fc::NowNs();
+  for (uint32_t i = 0; i < kDraws; ++i) {
+    scratch.BeginDraw(1u << 30);
+    scratch.CountBindings(i & 3, 2, i & 7, 4, 32, 256);
+  }
+  const uint64_t draws_ns = fc::NowNs() - start;
+  start = fc::NowNs();
+  for (uint32_t i = 0; i < kTimed; ++i) {
+    scratch.BeginDraw(1);
+    for (uint32_t part = 0; part < bp::kParts; ++part) {
+      const uint64_t then = fc::Ticks() - fc::OtherSectionTicks();
+      scratch.Stop(part, then, fc::Ticks() - fc::OtherSectionTicks());
+    }
+    scratch.CountUpdate(4);
+  }
+  const uint64_t timed_ns = fc::NowNs() - start;
+  bp::own_cost.draw_ns = double(draws_ns) / kDraws;
+  bp::own_cost.timed_ns = double(timed_ns) / kTimed;
+}
+
+// The 30 s line, from EndSubmission.
+struct Report {
+  std::chrono::steady_clock::time_point at{};
+  uint64_t ticks = 0, ns = 0, executing_ns = 0;
+  std::array<uint64_t, bp::kViewKinds> views_made{}, views_destroyed{};
+  uint64_t samplers_made = 0, samplers_destroyed = 0;
+};
+Report report;
+void ReportEvery30s() {
+  const auto now = std::chrono::steady_clock::now();
+  const bool first = report.at == std::chrono::steady_clock::time_point();
+  if (!first && now - report.at < std::chrono::seconds(30)) return;
+  const uint64_t ticks = fc::Ticks(), ns = fc::NowNs();
+  const uint64_t executing = fc::totals.execute_ns.load(std::memory_order_relaxed);
+  bp::Window window;
+  window.seconds = double(ns - report.ns) / 1e9;
+  window.ns_per_tick =
+      ticks > report.ticks ? double(ns - report.ns) / double(ticks - report.ticks) : 1.0;
+  window.executing_ns = executing - report.executing_ns;
+  window.max_push_descriptors = bp::device_support.max_push_descriptors;
+  window.max_push_constants_size = bp::device_support.max_push_constants_size;
+  for (uint32_t k = 0; k < bp::kViewKinds; ++k) {
+    const uint64_t made = bp::objects.views_made[k].load(std::memory_order_relaxed);
+    const uint64_t destroyed = bp::objects.views_destroyed[k].load(std::memory_order_relaxed);
+    window.views_live[k] = made > destroyed ? made - destroyed : 0;
+    window.views_peak[k] = std::max(
+        bp::objects.views_peak[k].exchange(window.views_live[k], std::memory_order_relaxed),
+        window.views_live[k]);
+    window.views_made[k] = made - report.views_made[k];
+    window.views_destroyed[k] = destroyed - report.views_destroyed[k];
+    report.views_made[k] = made;
+    report.views_destroyed[k] = destroyed;
+  }
+  const uint64_t samplers_made = bp::objects.samplers_made.load(std::memory_order_relaxed);
+  const uint64_t samplers_destroyed =
+      bp::objects.samplers_destroyed.load(std::memory_order_relaxed);
+  window.samplers_live =
+      samplers_made > samplers_destroyed ? samplers_made - samplers_destroyed : 0;
+  window.samplers_peak = std::max(
+      bp::objects.samplers_peak.exchange(window.samplers_live, std::memory_order_relaxed),
+      window.samplers_live);
+  window.samplers_made = samplers_made - report.samplers_made;
+  window.samplers_destroyed = samplers_destroyed - report.samplers_destroyed;
+  report.samplers_made = samplers_made;
+  report.samplers_destroyed = samplers_destroyed;
+  const bp::Counters counters = bp::probe.Take();
+  if (!first && counters.draws) {
+    XELOGW("{}", bp::Line(counters, window));
+  }
+  report.at = now;
+  report.ticks = ticks;
+  report.ns = ns;
+  report.executing_ns = executing;
+}
+
+// The start-up test: the real path once, then the GPU's sampling cost by kind of index.
+void StartupTest(const ui::vulkan::VulkanDevice* vulkan_device) {
+  const bp::Settings& settings = bp::Current();
+  const bp::DeviceSupport& support = bp::device_support;
+  if (!settings.heap_test && !settings.gpu_timing) return;
+  if (!support.dynamic_indexing || !support.update_after_bind || !support.partially_bound) {
+    XELOGW("Bindless probe (fix 160) heap test: not run, a feature it needs is not enabled "
+           "(dynamic indexing {}, update after bind {}, partially bound {})",
+           support.dynamic_indexing, support.update_after_bind, support.partially_bound);
+    return;
+  }
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  const uint32_t family = vulkan_device->queue_family_graphics_compute();
+  constexpr uint32_t kHeapImages = 65536, kHeapSamplers = 16, kOutSlots = 64;
+  constexpr uint32_t kImages = 4;
+  bool ok = true;
+  const char* failed = nullptr;
+  auto check = [&](bool result, const char* what) {
+    if (!result && ok) {
+      ok = false;
+      failed = what;
+    }
+    return ok;
+  };
+
+  // Objects, all destroyed at the end.
+  VkCommandPool pool = VK_NULL_HANDLE;
+  VkCommandBuffer cbs[5] = {};  // each used once: clears, three test submissions, timing
+  VkFence fences[2] = {};
+  VkImage images[kImages] = {};
+  VkDeviceMemory image_memory[kImages] = {};
+  VkImageView views[kImages] = {};
+  VkSampler sampler = VK_NULL_HANDLE;
+  VkBuffer out_buffer = VK_NULL_HANDLE;
+  VkDeviceMemory out_memory = VK_NULL_HANDLE;
+  void* out_mapping = nullptr;
+  VkDescriptorSetLayout set_layouts[2] = {};
+  VkDescriptorPool descriptor_pools[2] = {};
+  VkDescriptorSet sets[2] = {};
+  VkPipelineLayout pipeline_layout = VK_NULL_HANDLE;
+  VkPipeline pipelines[3] = {};  // fixed, uniform, non-uniform
+  VkQueryPool queries = VK_NULL_HANDLE;
+
+  VkCommandPoolCreateInfo pool_info = {VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+  pool_info.queueFamilyIndex = family;
+  check(dfn.vkCreateCommandPool(device, &pool_info, nullptr, &pool) == VK_SUCCESS,
+        "command pool");
+  if (ok) {
+    VkCommandBufferAllocateInfo allocate_info = {VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+    allocate_info.commandPool = pool;
+    allocate_info.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+    allocate_info.commandBufferCount = 5;
+    check(dfn.vkAllocateCommandBuffers(device, &allocate_info, cbs) == VK_SUCCESS,
+          "command buffers");
+  }
+  for (VkFence& fence : fences) {
+    VkFenceCreateInfo fence_info = {VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+    fence_info.flags = VK_FENCE_CREATE_SIGNALED_BIT;  // a wait on an unused one returns at once
+    if (ok) check(dfn.vkCreateFence(device, &fence_info, nullptr, &fence) == VK_SUCCESS, "fence");
+  }
+  // Four 4x4 images of one color each: A red, B green, C blue, D yellow.
+  for (uint32_t i = 0; i < kImages && ok; ++i) {
+    VkImageCreateInfo image_info = {VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+    image_info.imageType = VK_IMAGE_TYPE_2D;
+    image_info.format = VK_FORMAT_R8G8B8A8_UNORM;
+    image_info.extent = {4, 4, 1};
+    image_info.mipLevels = 1;
+    image_info.arrayLayers = 1;
+    image_info.samples = VK_SAMPLE_COUNT_1_BIT;
+    image_info.tiling = VK_IMAGE_TILING_OPTIMAL;
+    image_info.usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    image_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    image_info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    if (!check(ui::vulkan::util::CreateDedicatedAllocationImage(
+                   vulkan_device, image_info, ui::vulkan::util::MemoryPurpose::kDeviceLocal,
+                   images[i], image_memory[i]),
+               "image")) {
+      break;
+    }
+    VkImageViewCreateInfo view_info = {VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+    view_info.image = images[i];
+    view_info.viewType = VK_IMAGE_VIEW_TYPE_2D_ARRAY;
+    view_info.format = VK_FORMAT_R8G8B8A8_UNORM;
+    view_info.subresourceRange = ui::vulkan::util::InitializeSubresourceRange();
+    check(dfn.vkCreateImageView(device, &view_info, nullptr, &views[i]) == VK_SUCCESS,
+          "image view");
+  }
+  if (ok) {
+    VkSamplerCreateInfo sampler_info = {VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO};
+    sampler_info.magFilter = VK_FILTER_NEAREST;
+    sampler_info.minFilter = VK_FILTER_NEAREST;
+    sampler_info.mipmapMode = VK_SAMPLER_MIPMAP_MODE_NEAREST;
+    sampler_info.addressModeU = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+    sampler_info.addressModeV = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+    sampler_info.addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+    sampler_info.maxLod = 0.25f;
+    check(dfn.vkCreateSampler(device, &sampler_info, nullptr, &sampler) == VK_SUCCESS, "sampler");
+  }
+  if (ok) {
+    check(ui::vulkan::util::CreateDedicatedAllocationBuffer(
+              vulkan_device, kOutSlots * 16, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT,
+              ui::vulkan::util::MemoryPurpose::kReadback, out_buffer, out_memory) &&
+              dfn.vkMapMemory(device, out_memory, 0, VK_WHOLE_SIZE, 0, &out_mapping) ==
+                  VK_SUCCESS,
+          "output buffer");
+  }
+  // Set 0: the heap (update-after-bind, partially bound); set 1: a fixed binding and the output.
+  if (ok) {
+    VkDescriptorSetLayoutBinding bindings[2] = {};
+    bindings[0].binding = 0;
+    bindings[0].descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;
+    bindings[0].descriptorCount = kHeapImages;
+    bindings[0].stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+    bindings[1].binding = 1;
+    bindings[1].descriptorType = VK_DESCRIPTOR_TYPE_SAMPLER;
+    bindings[1].descriptorCount = kHeapSamplers;
+    bindings[1].stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+    VkDescriptorBindingFlags binding_flags[2];
+    binding_flags[0] = VK_DESCRIPTOR_BINDING_UPDATE_AFTER_BIND_BIT |
+                       VK_DESCRIPTOR_BINDING_PARTIALLY_BOUND_BIT |
+                       (support.unused_while_pending
+                            ? VK_DESCRIPTOR_BINDING_UPDATE_UNUSED_WHILE_PENDING_BIT
+                            : 0);
+    binding_flags[1] =
+        VK_DESCRIPTOR_BINDING_UPDATE_AFTER_BIND_BIT | VK_DESCRIPTOR_BINDING_PARTIALLY_BOUND_BIT;
+    VkDescriptorSetLayoutBindingFlagsCreateInfo flags_info = {
+        VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_BINDING_FLAGS_CREATE_INFO};
+    flags_info.bindingCount = 2;
+    flags_info.pBindingFlags = binding_flags;
+    VkDescriptorSetLayoutCreateInfo layout_info = {
+        VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};
+    layout_info.pNext = &flags_info;
+    layout_info.flags = VK_DESCRIPTOR_SET_LAYOUT_CREATE_UPDATE_AFTER_BIND_POOL_BIT;
+    layout_info.bindingCount = 2;
+    layout_info.pBindings = bindings;
+    check(dfn.vkCreateDescriptorSetLayout(device, &layout_info, nullptr, &set_layouts[0]) ==
+              VK_SUCCESS,
+          "heap set layout");
+  }
+  if (ok) {
+    VkDescriptorSetLayoutBinding bindings[3] = {};
+    const VkDescriptorType types[3] = {VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE,
+                                       VK_DESCRIPTOR_TYPE_SAMPLER,
+                                       VK_DESCRIPTOR_TYPE_STORAGE_BUFFER};
+    for (uint32_t i = 0; i < 3; ++i) {
+      bindings[i].binding = i;
+      bindings[i].descriptorType = types[i];
+      bindings[i].descriptorCount = 1;
+      bindings[i].stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+    }
+    VkDescriptorSetLayoutCreateInfo layout_info = {
+        VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};
+    layout_info.bindingCount = 3;
+    layout_info.pBindings = bindings;
+    check(dfn.vkCreateDescriptorSetLayout(device, &layout_info, nullptr, &set_layouts[1]) ==
+              VK_SUCCESS,
+          "fixed set layout");
+  }
+  if (ok) {
+    const VkDescriptorPoolSize heap_sizes[2] = {
+        {VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, kHeapImages},
+        {VK_DESCRIPTOR_TYPE_SAMPLER, kHeapSamplers}};
+    VkDescriptorPoolCreateInfo pool_create = {VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+    pool_create.flags = VK_DESCRIPTOR_POOL_CREATE_UPDATE_AFTER_BIND_BIT;
+    pool_create.maxSets = 1;
+    pool_create.poolSizeCount = 2;
+    pool_create.pPoolSizes = heap_sizes;
+    check(dfn.vkCreateDescriptorPool(device, &pool_create, nullptr, &descriptor_pools[0]) ==
+              VK_SUCCESS,
+          "heap descriptor pool");
+  }
+  if (ok) {
+    const VkDescriptorPoolSize fixed_sizes[3] = {{VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, 1},
+                                                 {VK_DESCRIPTOR_TYPE_SAMPLER, 1},
+                                                 {VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1}};
+    VkDescriptorPoolCreateInfo pool_create = {VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+    pool_create.maxSets = 1;
+    pool_create.poolSizeCount = 3;
+    pool_create.pPoolSizes = fixed_sizes;
+    check(dfn.vkCreateDescriptorPool(device, &pool_create, nullptr, &descriptor_pools[1]) ==
+              VK_SUCCESS,
+          "fixed descriptor pool");
+  }
+  for (uint32_t i = 0; i < 2 && ok; ++i) {
+    VkDescriptorSetAllocateInfo set_info = {VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+    set_info.descriptorPool = descriptor_pools[i];
+    set_info.descriptorSetCount = 1;
+    set_info.pSetLayouts = &set_layouts[i];
+    check(dfn.vkAllocateDescriptorSets(device, &set_info, &sets[i]) == VK_SUCCESS,
+          i ? "fixed set" : "heap set (65536 sampled images, update after bind)");
+  }
+  if (ok) {
+    VkPushConstantRange push_range = {VK_SHADER_STAGE_COMPUTE_BIT, 0, 16};
+    VkPipelineLayoutCreateInfo layout_info = {VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+    layout_info.setLayoutCount = 2;
+    layout_info.pSetLayouts = set_layouts;
+    layout_info.pushConstantRangeCount = 1;
+    layout_info.pPushConstantRanges = &push_range;
+    check(dfn.vkCreatePipelineLayout(device, &layout_info, nullptr, &pipeline_layout) ==
+              VK_SUCCESS,
+          "pipeline layout");
+  }
+  if (ok) {
+    pipelines[0] = ui::vulkan::util::CreateComputePipeline(
+        vulkan_device, pipeline_layout, shaders::bindless_probe_fixed_cs,
+        sizeof(shaders::bindless_probe_fixed_cs));
+    pipelines[1] = ui::vulkan::util::CreateComputePipeline(
+        vulkan_device, pipeline_layout, shaders::bindless_probe_uniform_cs,
+        sizeof(shaders::bindless_probe_uniform_cs));
+    if (support.non_uniform) {
+      pipelines[2] = ui::vulkan::util::CreateComputePipeline(
+          vulkan_device, pipeline_layout, shaders::bindless_probe_nonuniform_cs,
+          sizeof(shaders::bindless_probe_nonuniform_cs));
+    }
+    check(pipelines[0] != VK_NULL_HANDLE && pipelines[1] != VK_NULL_HANDLE,
+          "compute pipelines");
+  }
+
+  auto write_heap = [&](uint32_t slot, uint32_t image) {
+    VkDescriptorImageInfo image_info = {VK_NULL_HANDLE, views[image],
+                                        VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL};
+    VkWriteDescriptorSet write = {VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+    write.dstSet = sets[0];
+    write.dstBinding = 0;
+    write.dstArrayElement = slot;
+    write.descriptorCount = 1;
+    write.descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;
+    write.pImageInfo = &image_info;
+    dfn.vkUpdateDescriptorSets(device, 1, &write, 0, nullptr);
+  };
