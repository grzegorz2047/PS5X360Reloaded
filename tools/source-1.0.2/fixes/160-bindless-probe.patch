+      compute.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+      compute.dstAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+      for (uint32_t v = 0; v < 3; ++v) {
+        if (pipelines[v] == VK_NULL_HANDLE) continue;
+        bind(cbs[4], v);
+        dispatch(cbs[4], 100, 64, kOutSlots - 1, 64);  // warm-up
+        dfn.vkCmdPipelineBarrier(cbs[4], VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                                 VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 1, &compute, 0,
+                                 nullptr, 0, nullptr);
+        dfn.vkCmdWriteTimestamp(cbs[4], VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, queries, v * 2);
+        for (uint32_t d = 0; d < 8; ++d) dispatch(cbs[4], 100, 64, kOutSlots - 1, 256);
+        dfn.vkCmdWriteTimestamp(cbs[4], VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, queries,
+                                v * 2 + 1);
+        dfn.vkCmdPipelineBarrier(cbs[4], VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                                 VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 1, &compute, 0,
+                                 nullptr, 0, nullptr);
+      }
+      uint64_t stamps[6] = {};
+      if (submit(cbs[4], fences[0]) && wait(fences[0])) {
+        for (uint32_t v = 0; v < 3; ++v) {
+          if (pipelines[v] == VK_NULL_HANDLE) continue;
+          dfn.vkGetQueryPoolResults(device, queries, v * 2, 2, sizeof(uint64_t) * 2,
+                                    stamps + v * 2, sizeof(uint64_t),
+                                    VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WAIT_BIT);
+        }
+        const uint64_t mask = valid_bits >= 64 ? ~UINT64_C(0) : (UINT64_C(1) << valid_bits) - 1;
+        constexpr double kSamples = 8.0 * 256 * 64 * 64;
+        double us[3] = {};
+        for (uint32_t v = 0; v < 3; ++v) {
+          us[v] = double((stamps[v * 2 + 1] - stamps[v * 2]) & mask) * period / 1000.0;
+        }
+        auto item = [&](uint32_t v) {
+          if (pipelines[v] == VK_NULL_HANDLE) return std::string("not run");
+          char text[96];
+          std::snprintf(text, sizeof(text), "%.1f us (%.2f ps a sample, %.2f x the fixed)",
+                        us[v], us[v] * 1e6 / kSamples, us[0] > 0 ? us[v] / us[0] : 0.0);
+          return std::string(text);
+        };
+        XELOGW("Bindless probe (fix 160) GPU timing, 8 x 256 x 64 invocations of 64 samples: "
+               "fixed binding {}; dynamically uniform heap index {}; non-uniform heap index {}",
+               item(0), item(1), item(2));
+      }
+    }
+  }
