diff --git a/include/xbox360ps5/bindless_probe.hpp b/include/xbox360ps5/bindless_probe.hpp
new file mode 100644
index 0000000..c3eb2eb
--- /dev/null
+++ b/include/xbox360ps5/bindless_probe.hpp
@@ -0,0 +1,365 @@
+// SPDX-License-Identifier: MIT
+// Xbox360PS5, fix 160 (docs/design/bindless.md, step B0): a diagnostics-only probe that decides
+// whether a bindless texture path, or push descriptors, would pay on the PS5. It changes nothing
+// the game sees. Off unless bindless-probe.txt in the title folder says "on"; the file is read once,
+// at start. With it on:
+//  - the device's descriptor indexing features are enabled (only for the start-up test) and logged
+//    with the limits and extensions a bindless path or push descriptors would use;
+//  - a start-up test runs the real path once (an update-after-bind heap, partially bound, a slot
+//    written while a submission is pending and one after the bind) and times sampling through a
+//    fixed binding, a dynamically uniform heap index and a non-uniform one;
+//  - every 30 s: the draws' binding counts against the push limits, the live image views and
+//    samplers, and the texture binding work by part (fix 142d's parts), timed on 1 draw in N.
+// GPU thread only, except the view counters (atomics).
+
+#ifndef XBOX360PS5_BINDLESS_PROBE_HPP_
+#define XBOX360PS5_BINDLESS_PROBE_HPP_
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+namespace xbox360ps5 {
+namespace bindless_probe {
+
+struct Settings {
+  bool on = false;
+  uint32_t sample = 8;    // 1 draw in `sample` timed (1-1024)
+  bool heap_test = true;  // "heap-test off"
+  bool gpu_timing = true; // "gpu-timing off"
+};
+
+// Words, blanks between, "#" to the end of a line: on/1, off/0, "sample N", "heap-test off|on",
+// "gpu-timing off|on". Anything else is ignored.
+inline Settings Parse(const std::string& text) {
+  std::vector<std::string> words;
+  std::string word;
+  bool comment = false;
+  for (size_t i = 0; i <= text.size(); ++i) {
+    const char c = i < text.size() ? text[i] : '\n';
+    if (c == '\n') comment = false;
+    if (c == '#') comment = true;
+    if (comment || c == ' ' || c == '\t' || c == '\r' || c == '\n') {
+      if (!word.empty()) words.push_back(word);
+      word.clear();
+    } else {
+      word += c;
+    }
+  }
+  Settings s;
+  for (size_t i = 0; i < words.size(); ++i) {
+    const std::string& w = words[i];
+    const std::string value = i + 1 < words.size() ? words[i + 1] : std::string();
+    if (w == "on" || w == "1") {
+      s.on = true;
+    } else if (w == "off" || w == "0") {
+      s.on = false;
+    } else if (w == "sample" && !value.empty() && value.size() < 5 &&
+               value.find_first_not_of("0123456789") == std::string::npos) {
+      s.sample = std::clamp<uint32_t>(uint32_t(std::strtoul(value.c_str(), nullptr, 10)), 1, 1024);
+      ++i;
+    } else if ((w == "heap-test" || w == "gpu-timing") && (value == "on" || value == "off")) {
+      (w == "heap-test" ? s.heap_test : s.gpu_timing) = value == "on";
+      ++i;
+    }
+  }
+  return s;
+}
+
+// Read once (the first caller's path), then the same answer for the whole run.
+inline Settings& Current() {
+  static Settings settings;
+  return settings;
+}
+inline bool& Loaded() {
+  static bool loaded = false;
+  return loaded;
+}
+inline bool enabled = false;  // Current().on, for the per-draw test
+inline const Settings& Load(const char* path) {
+  if (!Loaded()) {
+    Loaded() = true;
+    std::string text;
+    if (FILE* file = std::fopen(path, "rb")) {
+      char buffer[1024];
+      const size_t got = std::fread(buffer, 1, sizeof(buffer), file);
+      std::fclose(file);
+      text.assign(buffer, got);
+      Current() = Parse(text);
+    }
+    enabled = Current().on;
+  }
+  return Current();
+}
+
+// What the device side enabled for the start-up test (vulkan_device.cc).
+struct DeviceSupport {
+  bool dynamic_indexing = false;     // shaderSampledImageArrayDynamicIndexing, enabled
+  bool update_after_bind = false;    // descriptorBindingSampledImageUpdateAfterBind, enabled
+  bool unused_while_pending = false; // descriptorBindingUpdateUnusedWhilePending, enabled
+  bool partially_bound = false;      // descriptorBindingPartiallyBound, enabled
+  bool non_uniform = false;          // shaderSampledImageArrayNonUniformIndexing, enabled
+  uint32_t max_push_descriptors = 0; // VK_KHR_push_descriptor's limit, 0 without it
+  uint32_t max_push_constants_size = 128;
+};
+inline DeviceSupport device_support;
+
+// The parts of a draw's texture binding work (fix 142d's names), timed on the sampled draws.
+enum Part : uint32_t {
+  kImageInfos = 0,  // texture image infos (stays with bindless: becomes the index lookup)
+  kReuseCheck,      // fix 104's check (goes)
+  kAllocate,        // set allocation and writes (goes)
+  kUpdate,          // vkUpdateDescriptorSets (goes)
+  kBind,            // binds (texture sets go, the constant set's rebind stays)
+  kTotal,           // the whole of UpdateBindings
+  kParts
+};
+inline const char* PartName(uint32_t part) {
+  static const char* const names[] = {"texture image infos", "texture set reuse check",
+                                      "set allocation and writes", "vkUpdateDescriptorSets",
+                                      "binds", "UpdateBindings in all"};
+  return part < kParts ? names[part] : "?";
+}
+
+// Image view kinds, as a heap would hold them in separate bindings.
+enum ViewKind : uint32_t { kView2DArray = 0, kView3D, kViewCube, kView3DAs2D, kViewKinds };
+inline const char* ViewKindName(uint32_t kind) {
+  static const char* const names[] = {"2D/2D array", "3D", "cube", "3D as 2D"};
+  return kind < kViewKinds ? names[kind] : "?";
+}
+
+struct Counters {
+  // Every draw (when on).
+  uint64_t draws = 0, timed = 0;
+  uint32_t max_vertex = 0, max_pixel = 0, max_both = 0;  // textures + samplers
+  uint32_t max_vertex_textures = 0, max_pixel_textures = 0, max_vertex_samplers = 0,
+           max_pixel_samplers = 0;
+  uint64_t over_push_descriptors = 0;  // a stage with more than maxPushDescriptors
+  uint64_t over_push_constants = 0;    // more 16-bit indices than maxPushConstantsSize holds
+  uint64_t vkupdate_calls = 0, vkupdate_descriptors = 0;  // on the timed draws
+  std::array<uint64_t, kParts> ticks{};                   // own ticks on the timed draws
+};
+
+class Probe {
+ public:
+  // Once per draw, at the start of UpdateBindings: whether this draw is timed (1 in `sample`).
+  bool BeginDraw(uint32_t sample) {
+    ++counters_.draws;
+    timed_ = SampleOneIn(sample);
+    counters_.timed += timed_;
+    return timed_;
+  }
+  // The draw's bindings by stage, against the push limits (0 descriptors: no push descriptors).
+  void CountBindings(uint32_t vertex_textures, uint32_t vertex_samplers, uint32_t pixel_textures,
+                     uint32_t pixel_samplers, uint32_t max_push_descriptors,
+                     uint32_t max_push_constants_size) {
+    Counters& c = counters_;
+    const uint32_t vertex = vertex_textures + vertex_samplers;
+    const uint32_t pixel = pixel_textures + pixel_samplers;
+    c.max_vertex = std::max(c.max_vertex, vertex);
+    c.max_pixel = std::max(c.max_pixel, pixel);
+    c.max_both = std::max(c.max_both, vertex + pixel);
+    c.max_vertex_textures = std::max(c.max_vertex_textures, vertex_textures);
+    c.max_pixel_textures = std::max(c.max_pixel_textures, pixel_textures);
+    c.max_vertex_samplers = std::max(c.max_vertex_samplers, vertex_samplers);
+    c.max_pixel_samplers = std::max(c.max_pixel_samplers, pixel_samplers);
+    if (max_push_descriptors && (vertex > max_push_descriptors || pixel > max_push_descriptors))
+      ++c.over_push_descriptors;
+    if (vertex + pixel > max_push_constants_size / 2) ++c.over_push_constants;
+  }
+  bool timed() const { return timed_; }
+  // A part's own ticks, from two marks (ticks minus nested sections' ticks).
+  void Stop(uint32_t part, uint64_t mark_then, uint64_t mark_now) {
+    if (!timed_ || part >= kParts || !mark_then) return;
+    counters_.ticks[part] += mark_now > mark_then ? mark_now - mark_then : 0;
+  }
+  void CountUpdate(uint32_t descriptors) {
+    if (!timed_) return;
+    ++counters_.vkupdate_calls;
+    counters_.vkupdate_descriptors += descriptors;
+  }
+  // The counters since the last call, and a fresh start.
+  Counters Take() {
+    Counters taken = counters_;
+    counters_ = Counters();
+    return taken;
+  }
+
+ private:
+  bool SampleOneIn(uint32_t every) {
+    if (every <= 1) return true;
+    uint32_t x = state_;
+    x ^= x << 13;
+    x ^= x >> 17;
+    x ^= x << 5;
+    state_ = x;
+    return x % every == 0;
+  }
+  Counters counters_;
+  uint32_t state_ = 0x2545F491u;  // its own, so fix 73's sampled draws stay as they were
+  bool timed_ = false;
+};
+inline Probe probe;
+
+// Image views and samplers made and destroyed (the texture cache; atomics).
+struct Objects {
+  std::array<std::atomic<uint64_t>, kViewKinds> views_made{}, views_destroyed{};
+  std::array<std::atomic<uint64_t>, kViewKinds> views_peak{};
+  std::atomic<uint64_t> samplers_made{0}, samplers_destroyed{0}, samplers_peak{0};
+};
+inline Objects objects;
+inline void Peak(std::atomic<uint64_t>& peak, uint64_t live) {
+  uint64_t seen = peak.load(std::memory_order_relaxed);
+  while (live > seen && !peak.compare_exchange_weak(seen, live, std::memory_order_relaxed)) {
+  }
+}
+inline void ViewMade(uint32_t kind) {
+  if (!enabled || kind >= kViewKinds) return;
+  const uint64_t made = objects.views_made[kind].fetch_add(1, std::memory_order_relaxed) + 1;
+  const uint64_t destroyed = objects.views_destroyed[kind].load(std::memory_order_relaxed);
+  Peak(objects.views_peak[kind], made > destroyed ? made - destroyed : 0);
+}
+inline void ViewDestroyed(uint32_t kind, uint64_t count = 1) {
+  if (!enabled || kind >= kViewKinds || !count) return;
+  objects.views_destroyed[kind].fetch_add(count, std::memory_order_relaxed);
+}
+inline void SamplerMade() {
+  if (!enabled) return;
+  const uint64_t made = objects.samplers_made.fetch_add(1, std::memory_order_relaxed) + 1;
+  const uint64_t destroyed = objects.samplers_destroyed.load(std::memory_order_relaxed);
+  Peak(objects.samplers_peak, made > destroyed ? made - destroyed : 0);
+}
+inline void SamplerDestroyed() {
+  if (!enabled) return;
+  objects.samplers_destroyed.fetch_add(1, std::memory_order_relaxed);
+}
+
+// The probe's own cost per draw, measured at start (ns): a draw counted, and a timed draw's marks.
+struct OwnCost {
+  double draw_ns = 0, timed_ns = 0;
+};
+inline OwnCost own_cost;
+
+// The 30 s line. `ns_per_tick` converts the parts' ticks; `executing_ns` is the GPU thread's
+// executing time over the same window (fix 49), for the shares.
+struct Window {
+  double seconds = 30;
+  double ns_per_tick = 1;
+  uint64_t executing_ns = 0;
+  uint32_t max_push_descriptors = 0;
+  uint32_t max_push_constants_size = 128;
+  std::array<uint64_t, kViewKinds> views_live{}, views_peak{}, views_made{}, views_destroyed{};
+  uint64_t samplers_live = 0, samplers_peak = 0, samplers_made = 0, samplers_destroyed = 0;
+};
+struct Summary {
+  double draws_s = 0;
+  std::array<double, kParts> ms_s{};
+  double bindless_ms_s = 0, push_ms_s = 0;    // what each would remove (upper bounds)
+  double bindless_share = 0, push_share = 0;  // of the GPU thread's executing time
+  double over_push_descriptors = 0, over_push_constants = 0;  // shares of draws
+  double own_ms_s = 0;
+};
+inline Summary Summarize(const Counters& c, const Window& w) {
+  Summary s;
+  const double seconds = w.seconds > 0 ? w.seconds : 1;
+  s.draws_s = double(c.draws) / seconds;
+  const double scale = c.timed ? double(c.draws) / double(c.timed) : 0.0;
+  for (uint32_t n = 0; n < kParts; ++n)
+    s.ms_s[n] = double(c.ticks[n]) * scale * w.ns_per_tick / 1e6 / seconds;
+  s.push_ms_s = s.ms_s[kReuseCheck] + s.ms_s[kAllocate] + s.ms_s[kUpdate];
+  s.bindless_ms_s = s.push_ms_s + s.ms_s[kBind];
+  const double executing_ms_s = double(w.executing_ns) / 1e6 / seconds;
+  s.bindless_share = executing_ms_s > 0 ? s.bindless_ms_s / executing_ms_s : 0.0;
+  s.push_share = executing_ms_s > 0 ? s.push_ms_s / executing_ms_s : 0.0;
+  s.over_push_descriptors = c.draws ? double(c.over_push_descriptors) / double(c.draws) : 0.0;
+  s.over_push_constants = c.draws ? double(c.over_push_constants) / double(c.draws) : 0.0;
+  s.own_ms_s = (double(c.draws) * own_cost.draw_ns + double(c.timed) * own_cost.timed_ns) / 1e6 /
+               seconds;
+  return s;
+}
+inline std::string Line(const Counters& c, const Window& w) {
+  const Summary s = Summarize(c, w);
+  const double seconds = w.seconds > 0 ? w.seconds : 1;
+  std::string views;
+  for (uint32_t k = 0; k < kViewKinds; ++k) {
+    char item[128];
+    std::snprintf(item, sizeof(item), "%s%s %llu (peak %llu)", k ? ", " : "", ViewKindName(k),
+                  static_cast<unsigned long long>(w.views_live[k]),
+                  static_cast<unsigned long long>(w.views_peak[k]));
+    views += item;
+  }
+  uint64_t made = 0, destroyed = 0;
+  for (uint32_t k = 0; k < kViewKinds; ++k) {
+    made += w.views_made[k];
+    destroyed += w.views_destroyed[k];
+  }
+  std::string parts;
+  for (uint32_t n = 0; n < kParts; ++n) {
+    char item[96];
+    std::snprintf(item, sizeof(item), "%s%s %.1f ms/s", n ? ", " : "", PartName(n), s.ms_s[n]);
+    parts += item;
+  }
+  char push_descriptors[96];
+  if (w.max_push_descriptors) {
+    std::snprintf(push_descriptors, sizeof(push_descriptors), "%.2f%% of draws over %u a stage",
+                  s.over_push_descriptors * 100.0, w.max_push_descriptors);
+  } else {
+    std::snprintf(push_descriptors, sizeof(push_descriptors), "not available");
+  }
+  char text[2048];
+  std::snprintf(
+      text, sizeof(text),
+      "Bindless probe, last 30 s (fix 160, 1 draw in %llu timed): %.0f draws/s; bindings a draw "
+      "(textures + samplers) at most: vertex %u (%u + %u), pixel %u (%u + %u), both %u; push "
+      "descriptors: %s; a push-constant index table (%u bytes, 16-bit indices): %.2f%% of draws "
+      "over; live image views: %s; views made %.1f/s, destroyed %.1f/s; samplers live %llu (peak "
+      "%llu), made %.1f/s, destroyed %.1f/s; texture binding work: %s; bindless would remove up to "
+      "%.1f ms/s (%.1f%% of the GPU thread's %.0f ms/s), push descriptors up to %.1f ms/s (%.1f%%); "
+      "vkUpdateDescriptorSets %.1f descriptors a call; the probe's own cost about %.1f ms/s",
+      static_cast<unsigned long long>(c.timed ? (c.draws + c.timed / 2) / c.timed : 0), s.draws_s,
+      c.max_vertex, c.max_vertex_textures, c.max_vertex_samplers, c.max_pixel,
+      c.max_pixel_textures, c.max_pixel_samplers, c.max_both, push_descriptors,
+      w.max_push_constants_size, s.over_push_constants * 100.0, views.c_str(),
+      double(made) / seconds, double(destroyed) / seconds,
+      static_cast<unsigned long long>(w.samplers_live),
+      static_cast<unsigned long long>(w.samplers_peak), double(w.samplers_made) / seconds,
+      double(w.samplers_destroyed) / seconds, parts.c_str(), s.bindless_ms_s,
+      s.bindless_share * 100.0, double(w.executing_ns) / 1e6 / seconds, s.push_ms_s,
+      s.push_share * 100.0,
+      c.vkupdate_calls ? double(c.vkupdate_descriptors) / double(c.vkupdate_calls) : 0.0,
+      s.own_ms_s);
+  return text;
+}
+
+// The start-up heap test's expected results, in the order the test writes them (one RGBA color a
+// slot of the output): the checks are made against these, and the log names the one that failed.
+struct HeapCheck {
+  const char* what;
+  float expected[4];
+};
+inline const std::array<HeapCheck, 6>& HeapChecks() {
+  static const std::array<HeapCheck, 6> checks = {{
+      {"heap slot 7, written before the bind", {1, 0, 0, 1}},
+      {"slot 40000, written while an earlier submission was pending", {0, 1, 0, 1}},
+      {"slot 50000, written after the bind was recorded", {0, 0, 1, 1}},
+      {"slot 7 again, rewritten after its last use completed", {1, 1, 0, 1}},
+      {"a non-uniform index (slots 100-107)", {1, 0, 0, 1}},
+      {"a fixed binding (today's path)", {1, 0, 0, 1}},
+  }};
+  return checks;
+}
+inline bool Near(const float* got, const float* expected) {
+  for (int i = 0; i < 4; ++i)
+    if (got[i] < expected[i] - 0.01f || got[i] > expected[i] + 0.01f) return false;
+  return true;
+}
