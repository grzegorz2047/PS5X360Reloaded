index 0000000..c11f0e8
--- /dev/null
+++ b/.deps/xenia-canary/src/xenia/gpu/shaders/bindless_probe.glsli
@@ -0,0 +1,50 @@
+// Xbox360PS5 (fix 160, docs/design/bindless.md step B0): the bindless probe's compute shaders,
+// run once at start when bindless-probe.txt says "on". Set 0 is the heap (update-after-bind,
+// partially bound); set 1 holds today's kind of fixed binding and the output. Each invocation
+// samples `iterations` times; invocation 0 writes the average to xe_probe_out[out_slot].
+layout(local_size_x = 64) in;
+
+layout(set = 0, binding = 0) uniform texture2DArray xe_heap_2d[65536];
+layout(set = 0, binding = 1) uniform sampler xe_heap_samplers[16];
+layout(set = 1, binding = 0) uniform texture2DArray xe_fixed_2d;
+layout(set = 1, binding = 1) uniform sampler xe_fixed_sampler;
+layout(set = 1, binding = 2, std430) buffer XeProbeOut { vec4 xe_probe_out[]; };
+
+layout(push_constant) uniform XeProbePush {
+  uint index;
+  uint sampler_index;
+  uint iterations;
+  uint out_slot;
+} xe_probe;
+
+vec4 XeProbeFetch(vec3 uv) {
+#if defined(XE_PROBE_FIXED)
+  return textureLod(sampler2DArray(xe_fixed_2d, xe_fixed_sampler), uv, 0.0);
+#elif defined(XE_PROBE_NONUNIFORM)
+  // Eight different descriptors in one wave: what a non-uniform index costs on this GPU.
+  return textureLod(
+      sampler2DArray(xe_heap_2d[nonuniformEXT(xe_probe.index + (gl_LocalInvocationID.x & 7u))],
+                     xe_heap_samplers[xe_probe.sampler_index]),
+      uv, 0.0);
+#else
+  // The bindless design's case: the same index for the whole dispatch.
+  return textureLod(sampler2DArray(xe_heap_2d[xe_probe.index],
+                                   xe_heap_samplers[xe_probe.sampler_index]),
+                    uv, 0.0);
+#endif
+}
+
+void main() {
+  vec4 sum = vec4(0.0);
+  for (uint i = 0u; i < xe_probe.iterations; ++i) {
+    vec3 uv = vec3((float(gl_LocalInvocationID.x) + 0.5) * (1.0 / 64.0),
+                   (float(i & 3u) + 0.5) * 0.25, 0.0);
+    sum += XeProbeFetch(uv);
+  }
+  vec4 average = sum / float(max(xe_probe.iterations, 1u));
+  if (gl_GlobalInvocationID.x == 0u) {
+    xe_probe_out[xe_probe.out_slot] = average;
+  } else if (average.w < -1.0) {
+    xe_probe_out[0] = average;  // never: keeps every invocation's samples
+  }
+}
