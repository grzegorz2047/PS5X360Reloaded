+    VkCommandBufferBeginInfo begin_info = {VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+    begin_info.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+    return dfn.vkBeginCommandBuffer(cb, &begin_info) == VK_SUCCESS;
+  };
+  auto submit = [&](VkCommandBuffer cb, VkFence fence) {
+    if (dfn.vkEndCommandBuffer(cb) != VK_SUCCESS) return false;
+    dfn.vkResetFences(device, 1, &fence);
+    VkSubmitInfo submit_info = {VK_STRUCTURE_TYPE_SUBMIT_INFO};
+    submit_info.commandBufferCount = 1;
+    submit_info.pCommandBuffers = &cb;
+    ui::vulkan::VulkanDevice::Queue::Acquisition queue =
+        vulkan_device->AcquireQueue(family, 0);
+    return dfn.vkQueueSubmit(queue.queue(), 1, &submit_info, fence) == VK_SUCCESS;
+  };
