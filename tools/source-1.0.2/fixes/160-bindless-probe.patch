+      write_heap(50000, 2);
+      dispatch(cbs[2], 40000, 1, 1, 1);
+      dispatch(cbs[2], 50000, 1, 2, 1);
+      check(submit(cbs[2], fences[1]), "second submission");
+    }
+    check(wait(fences[0]) && wait(fences[1]), "waits");
