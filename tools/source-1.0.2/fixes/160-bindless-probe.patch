+      to_host.dstAccessMask = VK_ACCESS_HOST_READ_BIT;
+      dfn.vkCmdPipelineBarrier(cbs[3], VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                               VK_PIPELINE_STAGE_HOST_BIT, 0, 1, &to_host, 0, nullptr, 0,
+                               nullptr);
+      check(submit(cbs[3], fences[0]) && wait(fences[0]), "third submission");
+    }
