--- /dev/null
+++ b/include/xbox360ps5/event_pulse.hpp
@@ -0,0 +1,167 @@
+// Xbox360PS5 fix 180: how NtPulseEvent and KePulseEvent release the threads waiting on an event.
+//
+// Spider-Man: Web of Shadows (41560815, issue #78) pulses events about 1,300-2,000 times a frame in
+// play (11-26k a second) and ran at 9-17 FPS with the GPU idle for the guest 820-900 ms a second.
+// 1.0.6's POSIX pulse set the event, yielded, slept 10 us and reset it; the console's sleeps overshoot
+// by about 0.1 ms, so each pulse cost its caller some 20-110 us (the console's KePulseEvent: a few us),
+// and a waiter that ran only after the reset missed the pulse. "atomic" releases, under the event's
+// lock, the threads waiting at that moment (one for an auto-reset event, all for a manual-reset one)
+// and leaves the event reset for everybody else, with no sleep (xenia/base/posix_conditions.h).
+//
+// The mode: the first word of event-pulse.txt in the data folder ("atomic" or "old"), re-read about
+// twice a second while the game pulses, so that a console test can switch it live; without the file
+// (or with another word in it), the setting `event_pulse` (default "old" in this first build).
+// Header-only, no Xenia headers: the core (xevent.cc, threading_posix.cc, wait_stats.h) and the
+// host check use it.
+#pragma once
+
+#include <fcntl.h>
+#include <unistd.h>
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <string_view>
+
+#include "xbox360ps5/app_identity.hpp"  // XBOX360PS5_DATA_ROOT
+
+#if defined(__x86_64__) || defined(_M_X64)
+#include <x86intrin.h>
+#else
+#include <chrono>
+#endif
+
+namespace xbox360ps5 {
+namespace event_pulse {
+
+enum Mode : int { kOld = 0, kAtomic = 1 };
+enum Source : int { kDefault = 0, kSetting = 1, kFile = 2 };
+
+// The first word of `text`: "atomic" -> kAtomic, "old" -> kOld, anything else -> -1.
+inline int ParseSwitch(std::string_view text) {
+  size_t begin = 0;
+  while (begin < text.size() &&
+         (text[begin] == ' ' || text[begin] == '\t' || text[begin] == '\r' || text[begin] == '\n' ||
+          static_cast<unsigned char>(text[begin]) == 0xEF || static_cast<unsigned char>(text[begin]) == 0xBB ||
+          static_cast<unsigned char>(text[begin]) == 0xBF)) {
+    ++begin;  // blanks and a UTF-8 byte-order mark
+  }
+  size_t end = begin;
+  while (end < text.size() && text[end] != ' ' && text[end] != '\t' && text[end] != '\r' && text[end] != '\n') {
+    ++end;
+  }
+  const std::string_view word = text.substr(begin, end - begin);
+  const auto same = [&word](std::string_view lower) {
+    if (word.size() != lower.size()) return false;
+    for (size_t i = 0; i < word.size(); ++i) {
+      char c = word[i];
+      if (c >= 'A' && c <= 'Z') c = char(c - 'A' + 'a');
+      if (c != lower[i]) return false;
+    }
+    return true;
+  };
+  if (same("atomic")) return kAtomic;
+  if (same("old")) return kOld;
+  return -1;
+}
+
+inline const char* ModeName(int mode) { return mode == kAtomic ? "atomic" : "old"; }
+inline const char* SourceText(int source) {
+  switch (source) {
+    case kFile:
+      return "event-pulse.txt says so";
+    case kSetting:
+      return "the setting event_pulse, no event-pulse.txt";
+    default:
+      return "the default, no event-pulse.txt";
+  }
+}
+
+inline std::atomic<int> mode{kOld};
+inline std::atomic<int> source{kDefault};
+inline std::atomic<bool> known{false};  // a refresh has run
+inline std::atomic<uint64_t> last_check{0};
+inline std::atomic<bool> checking{false};
+inline std::atomic<uint32_t> changes{0};
+// For the host check: another file instead of the data folder's (nullptr: the console's).
+inline std::atomic<const char*> path_override{nullptr};
+
+inline uint64_t Ticks() {
+#if defined(__x86_64__) || defined(_M_X64)
+  return __rdtsc();
+#else
+  return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                      std::chrono::steady_clock::now().time_since_epoch())
+                      .count());
+#endif
+}
+// Between two looks at the file: 2^30 TSC ticks (about 0.3-0.7 s), no clock call per pulse.
+inline constexpr uint64_t kCheckTicks = uint64_t(1) << 30;
+
+// The word of the switch file, or -1 (no file, or no word it knows).
+inline int ReadFile() {
+  const char* override_path = path_override.load(std::memory_order_acquire);
+  const char* const paths[2] = {override_path ? override_path : XBOX360PS5_DATA_ROOT "/event-pulse.txt",
+                                override_path ? nullptr : "/download0/xbox360ps5/event-pulse.txt"};
+  for (const char* path : paths) {
+    if (!path) continue;
+    const int fd = ::open(path, O_RDONLY);
+    if (fd < 0) continue;
+    char buffer[64];
+    const ssize_t got = ::read(fd, buffer, sizeof(buffer));
+    ::close(fd);
+    return got > 0 ? ParseSwitch(std::string_view(buffer, size_t(got))) : -1;
+  }
+  return -1;
+}
+
+struct Refreshed {
+  bool changed = false;  // the mode or where it comes from differs from before (or the first look)
+  int mode = kOld;
+  int source = kDefault;
+};
+
+// Before a pulse: looks at the file when kCheckTicks have passed (one thread at a time; the others
+// keep the mode they find). `setting` is ParseSwitch of the setting event_pulse (-1: not a word it
+// knows, read as the default). `force` looks now.
+inline Refreshed Refresh(int setting, bool force = false) {
+  Refreshed result;
+  const uint64_t now = Ticks();
+  const uint64_t last = last_check.load(std::memory_order_relaxed);
+  if (!force && known.load(std::memory_order_acquire) && now - last < kCheckTicks) {
+    result.mode = mode.load(std::memory_order_relaxed);
+    result.source = source.load(std::memory_order_relaxed);
+    return result;
+  }
+  if (checking.exchange(true, std::memory_order_acquire)) {
+    result.mode = mode.load(std::memory_order_relaxed);
+    result.source = source.load(std::memory_order_relaxed);
+    return result;
+  }
+  last_check.store(now, std::memory_order_relaxed);
+  const int from_file = ReadFile();
+  int new_mode = kOld, new_source = kDefault;
+  if (from_file >= 0) {
+    new_mode = from_file;
+    new_source = kFile;
+  } else if (setting >= 0) {
+    new_mode = setting;
+    new_source = setting == kOld ? kDefault : kSetting;
+  }
+  const bool was_known = known.load(std::memory_order_relaxed);
+  result.changed = !was_known || new_mode != mode.load(std::memory_order_relaxed) ||
+                   new_source != source.load(std::memory_order_relaxed);
+  mode.store(new_mode, std::memory_order_relaxed);
+  source.store(new_source, std::memory_order_relaxed);
+  known.store(true, std::memory_order_release);
+  if (result.changed && was_known) changes.fetch_add(1, std::memory_order_relaxed);
+  checking.store(false, std::memory_order_release);
+  result.mode = new_mode;
+  result.source = new_source;
+  return result;
+}
+
+inline bool Atomic() { return mode.load(std::memory_order_relaxed) == kAtomic; }
+
+}  // namespace event_pulse
+}  // namespace xbox360ps5
