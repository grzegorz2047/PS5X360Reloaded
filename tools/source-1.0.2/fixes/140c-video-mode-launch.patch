+// Fix 140c: the custom size when the game started; what it is told until it starts again.
+inline std::atomic<uint32_t> launch_width{0}, launch_height{0};
+inline void LatchAtLaunch(uint32_t custom_width, uint32_t custom_height) {
+  launch_width.store(custom_width, std::memory_order_relaxed);
+  launch_height.store(custom_height, std::memory_order_relaxed);
+}
+inline Mode LaunchMode() {
+  return ReportedMode(launch_width.load(std::memory_order_relaxed), launch_height.load(std::memory_order_relaxed));
+}
+// Fix 140c: the 2x tuning of fix 117 was measured on the 1280-pixel frame (720p).
+inline bool TuningMayNotFit(int internal_resolution, uint32_t scale, bool has_tuning) {
+  return scale > 1 && has_tuning && ReportedMode(ForChoice(internal_resolution).width,
+                                                 ForChoice(internal_resolution).height).reported;
+}
