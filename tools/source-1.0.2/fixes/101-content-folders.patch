+std::string ContentManager::MountPackageFolder(uint32_t device_id,
+                                               uint64_t xuid,
+                                               uint32_t title_id,
+                                               uint32_t content_type) {
+  std::string root;
+  if (device_id == storage::kInternalDeviceId) {
+    root = "\\Device\\Harddisk0\\Partition1\\Content";
+  } else if (storage::FindSlot(device_id) &&
+             storage::Find(StorageDevices(), device_id)) {
+    root = fmt::format("\\Device\\PS5X360Content{}", device_id);
+  } else {
+    return {};
+  }
+  const std::string folder = fmt::format("{}\\{:016X}\\{:08X}\\{:08X}", root,
+                                         xuid, title_id, content_type);
+  std::lock_guard<std::mutex> lock(package_folders_mutex_);
+  if (package_folders_.count(folder)) {
+    return folder;
+  }
+  const std::filesystem::path host =
+      storage::PackageRoot(DeviceRoot(device_id), xuid, title_id, content_type);
+  std::error_code error;
+  std::filesystem::create_directories(host, error);
+  auto device = std::make_unique<vfs::HostPathDevice>(folder, host, false);
+  if (error || !device->Initialize()) {
+    XELOGE("Storage (fix 101): cannot make {} for {} ({})", host.string(),
+           folder, error.message());
+    return {};
+  }
+  kernel_state_->file_system()->RegisterDeviceFirst(std::move(device));
+  package_folders_.insert(folder);
+  XELOGW("Storage (fix 101): {} is {} (device {}), writable", folder,
+         host.string(), device_id);
+  return folder;
+}
