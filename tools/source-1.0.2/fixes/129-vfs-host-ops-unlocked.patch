diff --git a/.deps/xenia-canary/src/xenia/vfs/entry_io.h b/.deps/xenia-canary/src/xenia/vfs/entry_io.h
new file mode 100644
--- /dev/null
+++ b/.deps/xenia-canary/src/xenia/vfs/entry_io.h
@@ -0,0 +1,95 @@
+// SPDX-License-Identifier: MIT
+// Xbox360PS5, fix 129: a file system entry's host operation (creating or deleting the host file)
+// runs with the global critical region let go.
+//
+// Entry::CreateEntry and Entry::Delete took the region and kept it across
+// HostPathEntry::CreateEntryInternal / DeleteEntryInternal, which open, stat or remove a file on
+// the console's disk. Kinect Sports (4D5308C9) creates and deletes its replay files
+// (\CACHE\videobufferNNN) all the time; on 1.0.5-work-fix128 those holds lasted up to 961 ms, at
+// 572-710 ms/s, and every thread that needed the region waited (the GPU thread 540-667 ms/s, in
+// SharedMemory::RequestRange). The region still guards the entry's children: the checks before
+// and the change after the host operation are made under it; only the operation runs without it.
+// A caller that already holds the region (it is recursive) keeps holding it: OutsideLock then
+// lets go of this function's hold only, as before.
+#ifndef XENIA_VFS_ENTRY_IO_H_
+#define XENIA_VFS_ENTRY_IO_H_
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+namespace xe {
+namespace vfs {
+namespace entry_io {
+
+enum Kind : int { kCreate = 0, kDelete = 1, kKinds };
+
+struct Stats {
+  std::atomic<uint64_t> count[kKinds]{}, total_ns[kKinds]{}, max_ns[kKinds]{};
+};
+inline Stats stats;
+
+inline void Note(Kind kind, uint64_t ns) {
+  stats.count[kind].fetch_add(1, std::memory_order_relaxed);
+  stats.total_ns[kind].fetch_add(ns, std::memory_order_relaxed);
+  uint64_t max = stats.max_ns[kind].load(std::memory_order_relaxed);
+  while (ns > max && !stats.max_ns[kind].compare_exchange_weak(max, ns, std::memory_order_relaxed)) {
+  }
+}
+
+// `lock` (a locked std::unique_lock of the region) is let go, `io` runs, and the lock is taken
+// again, also when `io` throws. Returns what `io` returns.
+template <class Lock, class Io>
+auto OutsideLock(Lock& lock, Kind kind, Io&& io) -> decltype(io()) {
+  struct Relock {
+    Lock& lock;
+    ~Relock() { lock.lock(); }
+  };
+  lock.unlock();
+  Relock relock{lock};
+  const auto start = std::chrono::steady_clock::now();
+  auto result = io();
+  Note(kind, uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                          std::chrono::steady_clock::now() - start)
+                          .count()));
+  return result;
+}
+
+// "VFS host operations (fix 129, without the global lock): n creates (x ms, longest y ms), m
+// deletes (...)" since the previous line, or empty when there were none.
+class Reporter {
+ public:
+  std::string Line() {
+    uint64_t count[kKinds], total[kKinds], max[kKinds];
+    bool any = false;
+    for (int k = 0; k < kKinds; ++k) {
+      const uint64_t c = stats.count[k].load(std::memory_order_relaxed);
+      const uint64_t t = stats.total_ns[k].load(std::memory_order_relaxed);
+      count[k] = c - last_count_[k];
+      total[k] = t - last_total_[k];
+      max[k] = stats.max_ns[k].exchange(0, std::memory_order_relaxed);
+      last_count_[k] = c;
+      last_total_[k] = t;
+      any = any || count[k];
+    }
+    if (!any) return std::string();
+    char line[256];
+    std::snprintf(line, sizeof(line),
+                  "VFS host operations (fix 129, without the global lock): %llu creates (%.1f ms, longest %.1f ms), "
+                  "%llu deletes (%.1f ms, longest %.1f ms)",
+                  (unsigned long long)count[kCreate], double(total[kCreate]) / 1e6, double(max[kCreate]) / 1e6,
+                  (unsigned long long)count[kDelete], double(total[kDelete]) / 1e6, double(max[kDelete]) / 1e6);
+    return line;
+  }
+
+ private:
+  uint64_t last_count_[kKinds]{}, last_total_[kKinds]{};
+};
+
+}  // namespace entry_io
+}  // namespace vfs
+}  // namespace xe
+
+#endif  // XENIA_VFS_ENTRY_IO_H_
