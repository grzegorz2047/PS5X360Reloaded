diff --git a/include/xbox360ps5/enum_trace.hpp b/include/xbox360ps5/enum_trace.hpp
new file mode 100644
--- /dev/null
+++ b/include/xbox360ps5/enum_trace.hpp
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+// Fix 81: the life of the emulator's enumerators, by kind (app id and open message).
+// Battlefield 3 keeps about 15 enumerators a second and one XamAlloc buffer with each (fix 79 on
+// 1.0.5_candidate_55); fix 80 (ObDereferenceObject finding an enumerator by its address) did not
+// change that on 1.0.4_candidate_34. Each step of an enumerator is counted for its kind: made,
+// enumerated (and what that returned), taken with XamGetPrivateEnumStructureFromHandle, given back
+// with ObDereferenceObject, closed with NtClose, destroyed; the summary line says which step the
+// kept ones never reach.
+#include <cstdint>
+#include <cstdio>
+#include <map>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+
+namespace xbox360ps5 {
+namespace enum_trace {
+
+struct Kind {
+  uint64_t made = 0, enumerated = 0, items = 0, no_more = 0, failed = 0, taken = 0, given_back = 0, closed = 0,
+           destroyed = 0;
+  uint32_t close_message = 0, extra_size = 0, items_per_enumerate = 0, flags = 0;
+};
+struct State {
+  std::mutex mutex;
+  std::map<uint64_t, Kind> kinds;                    // (app id << 32) | open message
+  std::unordered_map<uint32_t, uint64_t> by_object;  // guest object -> kind
+};
+inline State& Get() {
+  static State state;
+  return state;
+}
+inline uint64_t KindKey(uint32_t app_id, uint32_t open_message) { return (uint64_t(app_id) << 32) | open_message; }
+
+// A new enumerator; true for the first 4 of its kind (the caller logs those).
+inline bool Made(uint32_t guest_object, uint32_t app_id, uint32_t open_message, uint32_t close_message,
+                 uint32_t extra_size, uint32_t items_per_enumerate, uint32_t flags) {
+  State& s = Get();
+  std::lock_guard<std::mutex> lock(s.mutex);
+  const uint64_t key = KindKey(app_id, open_message);
+  s.by_object[guest_object] = key;
+  Kind& k = s.kinds[key];
+  k.close_message = close_message;
+  k.extra_size = extra_size;
+  k.items_per_enumerate = items_per_enumerate;
+  k.flags = flags;
+  return ++k.made <= 4;
+}
+enum Step { kEnumerated, kTaken, kGivenBack, kClosed, kDestroyed };
+inline constexpr uint32_t kNoMoreFiles = 18;  // X_ERROR_NO_MORE_FILES
+inline void Note(uint32_t guest_object, Step step, uint32_t result = 0, uint32_t items = 0) {
+  State& s = Get();
+  std::lock_guard<std::mutex> lock(s.mutex);
+  const auto it = s.by_object.find(guest_object);
+  if (it == s.by_object.end()) return;
+  Kind& k = s.kinds[it->second];
+  switch (step) {
+    case kEnumerated:
+      ++k.enumerated;
+      k.items += items;
+      if (result == kNoMoreFiles) ++k.no_more;
+      else if (result) ++k.failed;
+      break;
+    case kTaken: ++k.taken; break;
+    case kGivenBack: ++k.given_back; break;
+    case kClosed: ++k.closed; break;
+    case kDestroyed:
+      ++k.destroyed;
+      s.by_object.erase(it);
+      break;
+  }
+}
+
+// "Enumerators by kind (app/open message): 000000FB/00058039 made n, enumerated e (items i, no more
+// m, failed f), taken t, given back g, closed c, destroyed d, alive a; ..." since the start.
+inline std::string Line() {
+  State& s = Get();
+  std::lock_guard<std::mutex> lock(s.mutex);
+  std::string text = "Enumerators by kind (app/open message, since the start): ";
+  bool first = true;
+  for (const auto& [key, k] : s.kinds) {
+    char item[320];
+    std::snprintf(item, sizeof(item),
+                  "%s%08X/%08X (close %08X, extra %u, %u per call, flags %X) made %llu, enumerated %llu (items %llu, "
+                  "no more %llu, failed %llu), taken %llu, given back %llu, closed %llu, destroyed %llu, alive %llu",
+                  first ? "" : "; ", uint32_t(key >> 32), uint32_t(key), k.close_message, k.extra_size,
+                  k.items_per_enumerate, k.flags, (unsigned long long)k.made, (unsigned long long)k.enumerated,
+                  (unsigned long long)k.items, (unsigned long long)k.no_more, (unsigned long long)k.failed,
+                  (unsigned long long)k.taken, (unsigned long long)k.given_back, (unsigned long long)k.closed,
+                  (unsigned long long)k.destroyed, (unsigned long long)(k.made - k.destroyed));
+    text += item;
+    first = false;
+  }
+  return first ? text + "none" : text;
+}
+
+}  // namespace enum_trace
+}  // namespace xbox360ps5
