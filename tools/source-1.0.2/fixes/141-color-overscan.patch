diff --git a/.deps/xenia-canary/src/xenia/gpu/shaders/swap_post.glsli b/.deps/xenia-canary/src/xenia/gpu/shaders/swap_post.glsli
new file mode 100644
index 0000000..589be4f
--- /dev/null
+++ b/.deps/xenia-canary/src/xenia/gpu/shaders/swap_post.glsli
@@ -0,0 +1,108 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Copyright 2022 Ben Vanik. All rights reserved.                             *
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+// Xbox360PS5 (fixes 137 and 141): the second pass of the Vulkan swap's effect
+// path (xenia/gpu/vulkan/swap_effects.h), from the intermediate image (RGB
+// after the game's gamma ramp, A its perceptual luma, written by
+// apply_gamma_{table,pwl}_fxaa_luma.ps) into the guest output image, drawn
+// with fullscreen_cw.vs. The guest output image is the intermediate image's
+// size less the overscan crop; its pixel (x, y) is the intermediate image's
+// (x, y) + offset. In order: at most one AA mode (fix 137), then the colour
+// preset (fix 141), before the presenter's scaling.
+//
+// XE_SWAP_POST_FXAA 1 (fxaa.ps.glsl, fxaa_extreme.ps.glsl, which also set
+// FXAA_QUALITY__PRESET, FXAA_QUALITY__SUBPIX, FXAA_QUALITY__EDGE_THRESHOLD and
+// FXAA_QUALITY__EDGE_THRESHOLD_MIN as fxaa.cs.hlsl and fxaa_extreme.cs.hlsl):
+// FXAA 3.11 through the linear clamp-to-edge sampler. XE_SWAP_POST_FXAA 0
+// (swap_post.ps.glsl): the pixel itself, no filtering.
+
+#if XE_SWAP_POST_FXAA
+#define FXAA_PC 1
+#define FXAA_GLSL_130 1
+// Luma in alpha, as apply_gamma_*_fxaa_luma writes it.
+#define FXAA_GREEN_AS_LUMA 0
+// textureGather is core in GLSL 4.00+ and Vulkan (as FXAA_HLSL_5 does in D3D12).
+#define FXAA_GATHER4_ALPHA 1
+#include "../../../../third_party/fxaa/FXAA3_11.h"
+#endif
+
+// swap_effects::PushConstants (48 bytes).
+layout(push_constant) uniform XeSwapPostConstants {
+  // 1 / the intermediate image's width and height.
+  vec2 size_inv;
+  // The crop's corner in the intermediate image, in pixels.
+  vec2 offset;
+  // The colour preset: x toe, y curve, z vibrance, w 1 / gamma.
+  vec4 grade;
+  // x: 1 to apply the colour preset.
+  vec4 grade_on;
+} xe_swap_post;
+
+layout(set = 0, binding = 0) uniform sampler2D xe_swap_post_source;
+
+layout(location = 0) out vec4 xe_swap_post_dest;
+
+// swap_effects::GradeChannel: shadows deeper with a smooth toe, contrast as a
+// blend towards smoothstep, then gamma; 0 and 1 stay, and no level is clipped.
+float XeGradeChannel(float x) {
+  float toe = xe_swap_post.grade.x;
+  float curve = xe_swap_post.grade.y;
+  float inv_gamma = xe_swap_post.grade.w;
+  x = clamp(x, 0.0, 1.0);
+  if (toe > 0.0) {
+    x = x * x * (1.0 + toe) / (x + toe);
+  }
+  if (curve > 0.0) {
+    x = x + curve * (x * x * (3.0 - 2.0 * x) - x);
+  }
+  if (inv_gamma != 1.0) {
+    x = pow(x, inv_gamma);
+  }
+  return clamp(x, 0.0, 1.0);
+}
+
+// swap_effects::GradeColor: the channels, then vibrance (muted colours more
+// than saturated ones; grey stays grey).
+vec3 XeGrade(vec3 color) {
+  color = vec3(XeGradeChannel(color.r), XeGradeChannel(color.g),
+               XeGradeChannel(color.b));
+  float vibrance = xe_swap_post.grade.z;
+  if (vibrance != 0.0) {
+    float max_c = max(color.r, max(color.g, color.b));
+    float min_c = min(color.r, min(color.g, color.b));
+    float luma = dot(color, vec3(0.2126, 0.7152, 0.0722));
+    float amount = 1.0 + vibrance * (1.0 - (max_c - min_c));
+    color = clamp(vec3(luma) + (color - vec3(luma)) * amount, 0.0, 1.0);
+  }
+  return color;
+}
+
+void main() {
+  // gl_FragCoord.xy is the pixel's center, (x + 0.5, y + 0.5); the offset is
+  // whole pixels.
+  vec2 pixel = gl_FragCoord.xy + xe_swap_post.offset;
+#if XE_SWAP_POST_FXAA
+  vec2 size_inv = xe_swap_post.size_inv;
+  vec3 color =
+      FxaaPixelShader(
+          pixel * size_inv, vec4(0.0), xe_swap_post_source,
+          xe_swap_post_source, xe_swap_post_source, size_inv, vec4(0.0),
+          vec4(0.0), vec4(0.0), FXAA_QUALITY__SUBPIX,
+          FXAA_QUALITY__EDGE_THRESHOLD, FXAA_QUALITY__EDGE_THRESHOLD_MIN, 8.0,
+          0.125, 0.05, vec4(1.0, -1.0, 0.25, -0.25))
+          .rgb;
+#else
+  vec3 color = texelFetch(xe_swap_post_source, ivec2(pixel), 0).rgb;
+#endif
+  if (xe_swap_post.grade_on.x != 0.0) {
+    color = XeGrade(color);
+  }
+  // Force alpha to 1 as D3D12 does: the presenter does not need it.
+  xe_swap_post_dest = vec4(color, 1.0);
+}
