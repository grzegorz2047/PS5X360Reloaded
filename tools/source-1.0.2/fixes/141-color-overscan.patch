diff --git a/.deps/xenia-canary/src/xenia/gpu/vulkan/swap_effects.h b/.deps/xenia-canary/src/xenia/gpu/vulkan/swap_effects.h
new file mode 100644
index 0000000..2814a9f
--- /dev/null
+++ b/.deps/xenia-canary/src/xenia/gpu/vulkan/swap_effects.h
@@ -0,0 +1,203 @@
+// SPDX-License-Identifier: MIT
+// Xbox360PS5 (fix 141): the colour preset and the overscan crop of the Vulkan swap, the decisions and
+// the colour math without Vulkan (host-checked by tools/check-swap-effects.cpp).
+//
+// Fix 137 made the swap's effect path (swap_fxaa.h): the gamma ramp into an intermediate image, then
+// one pass from it into the guest output image. Fix 141 runs that path for any of FXAA, a colour
+// preset or an overscan crop, in the order of the presentation contract (the game's gamma ramp ->
+// at most one AA mode -> colour and crop -> the presenter's scaling (FSR/CAS) -> the emulator's UI):
+//   1. apply_gamma_{table,pwl}_fxaa_luma.ps into the intermediate image, the front buffer's size;
+//   2. fxaa.ps / fxaa_extreme.ps / swap_post.ps (no AA: one texel, no filtering) from the
+//      intermediate image at the crop's offset into a guest output image of the cropped size, the
+//      colour preset applied (swap_post.glsli; the same math as GradeColor below).
+// The crop makes the guest output image smaller instead of resampling it: the presenter scales the
+// cropped picture to the same display rectangle (the aspect it is given does not change), so the
+// picture is enlarged by the crop with its proportions kept, and FSR/CAS see its edges as edges.
+// Off and 0% (and anything whose resources could not be made) draw the one-pass swap as before.
+#ifndef XENIA_GPU_VULKAN_SWAP_EFFECTS_H_
+#define XENIA_GPU_VULKAN_SWAP_EFFECTS_H_
+
+#include <cmath>
+#include <cstdint>
+
+namespace xe {
+namespace gpu {
+namespace swap_effects {
+
+// The launcher's color_preset values.
+enum class ColorPreset : uint32_t {
+  kOff = 0,
+  kOledDeepBlack = 1,
+  kVibrant = 2,
+  kCleanNeutral = 3,
+};
+constexpr uint32_t kColorPresetCount = 4;
+// The launcher's overscan_crop values are the percent cut from each edge.
+constexpr uint32_t kMaxOverscanPercent = 3;
+
+// Anything unknown is the default (Off, 0%).
+constexpr ColorPreset ColorPresetFromSetting(int value) {
+  return value > 0 && uint32_t(value) < kColorPresetCount ? ColorPreset(uint32_t(value))
+                                                         : ColorPreset::kOff;
+}
+constexpr uint32_t OverscanFromSetting(int value) {
+  return value > 0 && uint32_t(value) <= kMaxOverscanPercent ? uint32_t(value) : 0;
+}
+
+// What the launcher hands the core (CommandProcessor::SetSwapEffects): one 32-bit value, so the GPU
+// thread reads the preset and the crop of the same choice. Off on OpenGL (no swap effects there).
+constexpr uint32_t Pack(ColorPreset preset, uint32_t overscan_percent) {
+  return uint32_t(preset) | (overscan_percent << 8);
+}
+constexpr uint32_t PackSettings(int color_preset, int overscan_crop, bool opengl) {
+  return opengl ? 0u
+                : Pack(ColorPresetFromSetting(color_preset), OverscanFromSetting(overscan_crop));
+}
+constexpr ColorPreset UnpackPreset(uint32_t packed) {
+  return ColorPresetFromSetting(int(packed & 0xFF));
+}
+constexpr uint32_t UnpackOverscan(uint32_t packed) {
+  return OverscanFromSetting(int((packed >> 8) & 0xFF));
+}
+
+constexpr const char* ColorPresetName(ColorPreset preset) {
+  return preset == ColorPreset::kOledDeepBlack ? "OLED Deep Black"
+         : preset == ColorPreset::kVibrant     ? "Vibrant"
+         : preset == ColorPreset::kCleanNeutral ? "Clean Neutral"
+                                                : "off";
+}
+
+// A preset's parameters (swap_post.glsli's push constants):
+// - toe: deeper shadows with a smooth curve, x^2 (1 + toe) / (x + toe): 0 and 1 stay, every level
+//   stays above the one below (no clipping of the darkest shades, unlike the prototype's
+//   subtraction); 0 is none;
+// - curve: contrast as a blend towards smoothstep, x + curve (smoothstep(x) - x): 0 and 1 stay, the
+//   brightest shades stay apart (no clipping above ~97.7% as the prototype's contrast did);
+// - inv_gamma: x^inv_gamma, mid-tones brighter below 1;
+// - vibrance: muted colours more saturated than already saturated ones; grey stays grey.
+struct Grade {
+  float toe = 0.0f;
+  float curve = 0.0f;
+  float vibrance = 0.0f;
+  float inv_gamma = 1.0f;
+};
+constexpr bool IsIdentity(const Grade& grade) {
+  return grade.toe == 0.0f && grade.curve == 0.0f && grade.vibrance == 0.0f &&
+         grade.inv_gamma == 1.0f;
+}
+constexpr Grade GradeFor(ColorPreset preset) {
+  switch (preset) {
+    case ColorPreset::kOledDeepBlack:
+      return {0.08f, 0.15f, 0.10f, 1.0f};
+    case ColorPreset::kVibrant:
+      return {0.02f, 0.25f, 0.30f, 1.0f};
+    case ColorPreset::kCleanNeutral:
+      return {0.0f, 0.10f, 0.0f, 1.0f / 1.05f};
+    default:
+      return {};
+  }
+}
+
+inline float Clamp01(float x) { return x < 0.0f ? 0.0f : (x > 1.0f ? 1.0f : x); }
+
+// One channel, as swap_post.glsli's XeGradeChannel.
+inline float GradeChannel(float x, const Grade& grade) {
+  x = Clamp01(x);
+  if (grade.toe > 0.0f) x = x * x * (1.0f + grade.toe) / (x + grade.toe);
+  if (grade.curve > 0.0f) x = x + grade.curve * (x * x * (3.0f - 2.0f * x) - x);
+  if (grade.inv_gamma != 1.0f) x = std::pow(x, grade.inv_gamma);
+  return Clamp01(x);
+}
+
+// RGB in [0, 1] after the game's gamma ramp, as swap_post.glsli's XeGrade.
+inline void GradeColor(float rgb[3], const Grade& grade) {
+  for (int i = 0; i < 3; ++i) rgb[i] = GradeChannel(rgb[i], grade);
+  if (grade.vibrance != 0.0f) {
+    const float max_c = rgb[0] > rgb[1] ? (rgb[0] > rgb[2] ? rgb[0] : rgb[2])
+                                        : (rgb[1] > rgb[2] ? rgb[1] : rgb[2]);
+    const float min_c = rgb[0] < rgb[1] ? (rgb[0] < rgb[2] ? rgb[0] : rgb[2])
+                                        : (rgb[1] < rgb[2] ? rgb[1] : rgb[2]);
+    const float luma = 0.2126f * rgb[0] + 0.7152f * rgb[1] + 0.0722f * rgb[2];
+    const float amount = 1.0f + grade.vibrance * (1.0f - (max_c - min_c));
+    for (int i = 0; i < 3; ++i) rgb[i] = Clamp01(luma + (rgb[i] - luma) * amount);
+  }
+}
+
+// The crop of a width x height front buffer: percent of each edge, rounded to whole pixels, so the
+// guest output image is (width - 2 x, height - 2 y) read from (x, y). 0% (or a size too small to
+// crop) is the whole picture.
+struct CropRect {
+  uint32_t x = 0;
+  uint32_t y = 0;
+  uint32_t width = 0;
+  uint32_t height = 0;
+};
+constexpr CropRect Crop(uint32_t width, uint32_t height, uint32_t percent) {
+  if (percent > kMaxOverscanPercent) percent = 0;
+  const uint32_t x = (width * percent + 50) / 100;
+  const uint32_t y = (height * percent + 50) / 100;
+  if (!percent || 2 * x >= width || 2 * y >= height) return {0, 0, width, height};
+  return {x, y, width - 2 * x, height - 2 * y};
+}
+
+// Whether this swap takes the effect path: something asked for (FXAA, a preset or a crop), a size,
+// and its resources made. Anything else is the one-pass swap.
+constexpr bool UseEffectPath(bool fxaa, ColorPreset preset, uint32_t overscan_percent,
+                             uint32_t width, uint32_t height, bool resources_ready) {
+  return (fxaa || preset != ColorPreset::kOff || overscan_percent != 0) && width != 0 &&
+         height != 0 && resources_ready;
+}
+
+// swap_post.glsli's push constants (48 bytes).
+struct PushConstants {
+  float size_inv_x = 0.0f;  // 1 / the intermediate image's size
+  float size_inv_y = 0.0f;
+  float offset_x = 0.0f;  // the crop's corner in the intermediate image, in pixels
+  float offset_y = 0.0f;
+  float toe = 0.0f;
+  float curve = 0.0f;
+  float vibrance = 0.0f;
+  float inv_gamma = 1.0f;
+  float grade_on = 0.0f;  // 1: apply the preset
+  float reserved[3] = {};
+};
+static_assert(sizeof(PushConstants) == 48, "swap_post.glsli's XeSwapPostConstants");
+
+constexpr PushConstants MakePushConstants(uint32_t width, uint32_t height, const CropRect& crop,
+                                          ColorPreset preset) {
+  PushConstants constants;
+  if (!width || !height) return constants;
+  constants.size_inv_x = 1.0f / float(width);
+  constants.size_inv_y = 1.0f / float(height);
+  constants.offset_x = float(crop.x);
+  constants.offset_y = float(crop.y);
+  const Grade grade = GradeFor(preset);
+  constants.toe = grade.toe;
+  constants.curve = grade.curve;
+  constants.vibrance = grade.vibrance;
+  constants.inv_gamma = grade.inv_gamma;
+  constants.grade_on = IsIdentity(grade) ? 0.0f : 1.0f;
+  return constants;
+}
+
+// The log line's state (a line when it changes, not per frame).
+struct LineState {
+  uint32_t fxaa = 0;  // swap_fxaa::Effect
+  ColorPreset preset = ColorPreset::kOff;
+  uint32_t overscan = 0;
+  uint32_t width = 0;
+  uint32_t height = 0;
+  CropRect crop;
+  bool operator==(const LineState& other) const {
+    return fxaa == other.fxaa && preset == other.preset && overscan == other.overscan &&
+           width == other.width && height == other.height && crop.x == other.crop.x &&
+           crop.y == other.crop.y && crop.width == other.crop.width &&
+           crop.height == other.crop.height;
+  }
+};
+
+}  // namespace swap_effects
+}  // namespace gpu
+}  // namespace xe
+
+#endif  // XENIA_GPU_VULKAN_SWAP_EFFECTS_H_
diff --git a/.deps/xenia-canary/src/xenia/gpu/vulkan/vulkan_command_processor.cc b/.deps/xenia-canary/src/xenia/gpu/vulkan/vulkan_command_processor.cc
index 384afc7..12904b5 100644
--- a/.deps/xenia-canary/src/xenia/gpu/vulkan/vulkan_command_processor.cc
+++ b/.deps/xenia-canary/src/xenia/gpu/vulkan/vulkan_command_processor.cc
@@ -48,6 +48,7 @@
