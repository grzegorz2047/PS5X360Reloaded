+// Xbox360PS5, fix 157: a CPU read of a resolve copy that fix 142i has queued waits on the reading
+// thread for that copy, instead of the GPU thread waiting for the GPU at the resolve.
+//
+// The GPU thread puts each queued copy on a board (Publish) and takes it off once the copy is in
+// guest memory or dropped (Retire). A read the read watch reports (fix 91, in the fault handler)
+// looks for queued copies on the pages it touches; if there are any, the reading thread lets the
+// global lock go (the GPU thread needs it to go on) and waits until they are off the board, or
+// until the timeout, then takes the lock back. While a reader waits, the GPU thread checks the
+// board at each draw and while it waits for the guest (idle, WAIT_REG_MEM), so a reader is never
+// left waiting on a GPU thread that waits for it longer than the timeout.
+//
+// Lock-free (the reader runs in a signal handler): each slot is a sequence-locked
+// (id, address, length); ids are unique and never 0.
+
+#ifndef XENIA_GPU_VULKAN_READER_WAIT_H_
+#define XENIA_GPU_VULKAN_READER_WAIT_H_
+
+#include <algorithm>
+#include <atomic>
+#include <cstdint>
+
+namespace xe {
+namespace gpu {
+namespace vulkan {
+namespace reader_wait {
+
+constexpr uint32_t kSlots = 256;
+constexpr uint32_t kMaxWatched = 16;  // queued copies one read waits for, at most
+
+struct Board {
+  std::atomic<uint64_t> ids[kSlots] = {};
+  std::atomic<uint32_t> addresses[kSlots] = {};
+  std::atomic<uint32_t> lengths[kSlots] = {};
+  uint32_t next = 0;  // the GPU thread's next slot to try
+
+  // Settings, from the GPU thread.
+  std::atomic<bool> enabled{false};
+  std::atomic<uint64_t> timeout_ns{20000000};
+
+  // Between the readers and the GPU thread.
+  std::atomic<uint32_t> readers{0};            // reading threads waiting now
+  std::atomic<uint64_t> gpu_polls{0};          // the GPU thread's looks at the board for them
+  std::atomic<uint64_t> gpu_guest_wait_ns{0};  // when the GPU thread last waited for the guest
+
+  // For the 30 s line (taken with exchange(0)).
+  std::atomic<uint64_t> nothing_queued{0};       // reads with no queued copy on their pages
+  std::atomic<uint64_t> delivered{0};            // reads that waited until their copy was there
+  std::atomic<uint64_t> waited_ns{0};            // their time
+  std::atomic<uint64_t> waited_max_ns{0};
+  std::atomic<uint64_t> timeouts{0};             // reads that went on with stale data
+  std::atomic<uint64_t> timeouts_guest_wait{0};  // ... while the GPU thread waited for the guest
+  std::atomic<uint64_t> timeouts_silent{0};      // ... with no look at the board from the GPU thread
+  std::atomic<uint64_t> gpu_thread_reads{0};     // reads on the GPU thread itself, never waited
+  std::atomic<uint64_t> not_on_board{0};         // copies queued with the board full
+  std::atomic<uint64_t> gpu_serves{0};           // GPU-thread deliveries for a waiting reader
+  std::atomic<uint64_t> submissions_ended{0};    // submissions ended for a waiting reader
+};
+
+inline bool Overlaps(uint32_t a, uint32_t a_length, uint32_t b, uint32_t b_length) {
+  return uint64_t(a) < uint64_t(b) + b_length && uint64_t(b) < uint64_t(a) + a_length;
+}
+
+// GPU thread: a queued copy, on the board. The slot, or -1 with the board full (counted).
+inline int Publish(Board& board, uint64_t id, uint32_t address, uint32_t length) {
+  for (uint32_t n = 0; n < kSlots; ++n) {
+    const uint32_t i = (board.next + n) % kSlots;
+    if (board.ids[i].load(std::memory_order_relaxed)) continue;
+    std::atomic_thread_fence(std::memory_order_release);
+    board.addresses[i].store(address, std::memory_order_relaxed);
+    board.lengths[i].store(length, std::memory_order_relaxed);
+    board.ids[i].store(id, std::memory_order_release);
+    board.next = (i + 1) % kSlots;
+    return int(i);
+  }
+  board.not_on_board.fetch_add(1, std::memory_order_relaxed);
+  return -1;
+}
+
+// GPU thread: the copy is in guest memory (or dropped). The full fence orders the copy's stores,
+// streaming ones included, before the reader can see the slot change.
+inline void Retire(Board& board, int slot, uint64_t id) {
+  if (slot < 0 || uint32_t(slot) >= kSlots) return;
+  std::atomic_thread_fence(std::memory_order_seq_cst);
+  if (board.ids[slot].load(std::memory_order_relaxed) == id) {
+    board.ids[slot].store(0, std::memory_order_release);
+  }
+}
+
+// GPU thread: whether a reader waits now (one relaxed load, at each draw).
+inline bool ReaderWaiting(const Board& board) {
+  return board.readers.load(std::memory_order_relaxed) != 0;
+}
+
+enum class Outcome { kNothingQueued, kDelivered, kTimeout };
+
+struct Result {
+  Outcome outcome = Outcome::kNothingQueued;
+  uint64_t waited_ns = 0;
+  bool gpu_answered = true;     // the GPU thread looked at the board during the wait
+  bool gpu_guest_wait = false;  // the GPU thread waited for the guest during the wait
+};
+
+// Reading thread: waits for the queued copies on [address, address + length). now() gives
+// nanoseconds; pause() waits a little; unlock() and relock() let the global lock go and take it
+// back (only around a wait).
+template <typename Now, typename Pause, typename Unlock, typename Relock>
+Result Wait(Board& board, uint32_t address, uint32_t length, Now now, Pause pause, Unlock unlock,
+            Relock relock) {
+  uint32_t slots[kMaxWatched];
+  uint64_t ids[kMaxWatched];
+  uint32_t count = 0;
+  for (uint32_t i = 0; i < kSlots && count < kMaxWatched; ++i) {
+    const uint64_t id = board.ids[i].load(std::memory_order_acquire);
+    if (!id) continue;
+    const uint32_t slot_address = board.addresses[i].load(std::memory_order_relaxed);
+    const uint32_t slot_length = board.lengths[i].load(std::memory_order_relaxed);
+    std::atomic_thread_fence(std::memory_order_acquire);
+    if (board.ids[i].load(std::memory_order_relaxed) != id) continue;
+    if (!Overlaps(slot_address, slot_length, address, length)) continue;
+    slots[count] = i;
+    ids[count] = id;
+    ++count;
+  }
+  Result result;
+  if (!count) return result;
+  const uint64_t timeout = board.timeout_ns.load(std::memory_order_relaxed);
+  const uint64_t polls = board.gpu_polls.load(std::memory_order_relaxed);
+  const uint64_t start = now();
+  board.readers.fetch_add(1, std::memory_order_acq_rel);
+  unlock();
+  uint64_t at = start;
+  result.outcome = Outcome::kTimeout;
+  for (;;) {
+    bool queued = false;
+    for (uint32_t j = 0; j < count && !queued; ++j) {
+      queued = board.ids[slots[j]].load(std::memory_order_acquire) == ids[j];
+    }
+    at = now();
+    if (!queued) {
+      result.outcome = Outcome::kDelivered;
+      break;
+    }
+    if (at - start >= timeout) break;
+    pause();
+  }
+  board.readers.fetch_sub(1, std::memory_order_acq_rel);
+  relock();
+  result.waited_ns = at - start;
+  result.gpu_answered = board.gpu_polls.load(std::memory_order_relaxed) != polls;
+  result.gpu_guest_wait = board.gpu_guest_wait_ns.load(std::memory_order_relaxed) >= start;
+  return result;
+}
+
+// Reading thread: a read's outcome, counted for the 30 s line.
+inline void Count(Board& board, const Result& result) {
+  switch (result.outcome) {
+    case Outcome::kNothingQueued:
+      board.nothing_queued.fetch_add(1, std::memory_order_relaxed);
+      return;
+    case Outcome::kDelivered:
+      board.delivered.fetch_add(1, std::memory_order_relaxed);
+      break;
+    case Outcome::kTimeout:
+      board.timeouts.fetch_add(1, std::memory_order_relaxed);
+      board.timeouts_guest_wait.fetch_add(result.gpu_guest_wait, std::memory_order_relaxed);
+      board.timeouts_silent.fetch_add(!result.gpu_answered, std::memory_order_relaxed);
+      break;
+  }
+  board.waited_ns.fetch_add(result.waited_ns, std::memory_order_relaxed);
+  uint64_t max = board.waited_max_ns.load(std::memory_order_relaxed);
+  while (result.waited_ns > max &&
+         !board.waited_max_ns.compare_exchange_weak(max, result.waited_ns,
+                                                    std::memory_order_relaxed)) {
+  }
+}
+
+}  // namespace reader_wait
+}  // namespace vulkan
+}  // namespace gpu
+}  // namespace xe
+
+#endif  // XENIA_GPU_VULKAN_READER_WAIT_H_
