+      fix157::board.submissions_ended.fetch_add(1, std::memory_order_relaxed);
+      EndSubmission(false);
+    }
+  }
+  fix157::board.gpu_serves.fetch_add(1, std::memory_order_relaxed);
+  Fix142iDeliver();
+}
+
+// Fix 157: the GPU thread waits for the guest (WAIT_REG_MEM, the start of the idle wait).
+void VulkanCommandProcessor::PrepareForWait() {
+  CommandProcessor::PrepareForWait();
+  fix157::board.gpu_guest_wait_ns.store(xbox360ps5::frame_cost::NowNs(),
+                                        std::memory_order_relaxed);
+  if (reader_wait::ReaderWaiting(fix157::board)) Fix157Serve(true);
+}
+
+// Fix 157: each round of the idle wait for new commands.
+void VulkanCommandProcessor::GuestWaitPoll() {
+  fix157::board.gpu_guest_wait_ns.store(xbox360ps5::frame_cost::NowNs(),
+                                        std::memory_order_relaxed);
+  if (reader_wait::ReaderWaiting(fix157::board)) Fix157Serve(true);
+}
