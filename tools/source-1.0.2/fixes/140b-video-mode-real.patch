+// Fix 140b: what the game is told for each custom size the option sets; anything else is the console's own.
+struct Mode {
+  Size size;
+  bool reported = false;          // false: the console's own mode
+  bool widescreen_forced = false;  // the widescreen flag on a 4:3-sized mode (16:9 anamorphic 480p)
+};
+inline Mode ReportedMode(uint32_t custom_width, uint32_t custom_height) {
+  if (custom_width == 1920 && custom_height == 1080) return {{1920, 1080}, true, false};
+  if (custom_width == 848 && custom_height == 480) return {{640, 480}, true, true};
+  if (custom_width == 1600 && custom_height == 900) return {{1600, 900}, true, false};
+  return {};  // 960x540 and anything else: not a mode a console reports
+}
