+// SPDX-License-Identifier: MIT
+// Xbox360PS5, fix 172: a utility cache on a drive moves its new files to memory once the game churns
+// it (makes small files and deletes them again within seconds).
+// Kinect Sports: Season Two (4D5309D6) records its darts replays into \CACHE\videobufferN: files of
+// 320 KiB made, written, renamed for the delete and deleted again, several a second. On the ext1
+// drive of 1.0.7-work-integration1 every such host operation took 0.8-0.96 s about 2 s into the
+// recording (345 creates and 346 deletes in 30 s), and each was followed by a game swap of 165-939 ms
+// (43.6 frames/s, at worst 12). Kinect Sports (4D5308C9) makes the same files in memory (fix 150d's
+// list) and made 3580 of them in 16 ms in the same run. Fix 150d's list names titles; this watches
+// what the game does instead, for every game whose cache is not in memory already.
+//
+// The rule (Group): a file made on the devices of the group while it runs, still small (at most
+// kSmallBytes written) and deleted within kLifetimeMs of its making counts as one turn of churn; at
+// kTurns of them within kWindowMs, while the group is armed, the group moves to memory: from then on
+// a file or folder the game makes on cache: or cache1: lives in memory (memory_device.h's entries,
+// in fix 150d's pool), as long as the pool has less than kBudgetBytes in use and the direct memory
+// keeps fix 150d's reserve; otherwise it is made on the drive as before. Files already on the drive
+// stay there. Nothing is written back to the drive: as fix 150d's cache, the files in memory end
+// with the process (the utility cache may be emptied at any time; the game makes its files again).
+// Season Two's menus made 7 and 4 files in 30 s (no turn of churn), its darts several a second.
+#ifndef XENIA_VFS_DEVICES_CACHE_CHURN_H_
+#define XENIA_VFS_DEVICES_CACHE_CHURN_H_
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <deque>
+#include <iterator>
+#include <mutex>
+#include <unordered_map>
+
+#define XBOX360PS5_CACHE_CHURN 1  // fix 172 (the host checks look for it)
+
+namespace xe {
+namespace vfs {
+namespace cache_churn {
+
+inline constexpr uint64_t kSmallBytes = uint64_t(8) << 20;  // a file of at most 8 MiB is small
+inline constexpr uint64_t kLifetimeMs = 60000;              // deleted within a minute of its making
+inline constexpr uint64_t kWindowMs = 10000;                // kTurns of them within 10 s
+inline constexpr uint32_t kTurns = 8;
+inline constexpr uint64_t kBudgetBytes = uint64_t(128) << 20;  // in memory at most (new files)
+inline constexpr size_t kTracked = 4096;  // files made and not deleted yet, followed at most
+
+inline uint64_t SteadyMs() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                      std::chrono::steady_clock::now().time_since_epoch())
+                      .count());
+}
+
+// The utility cache devices of one start (cache: and cache1:): a turn on either counts for both.
+// Files are keys (their entries); a key is followed from its making to its delete.
+class Group {
+ public:
+  explicit Group(uint64_t (*now_ms)() = SteadyMs) : now_ms_(now_ms) {}
+
+  // Whether churn may move the group to memory (the title's start decides; fix 150d's titles and a
+  // "drive"/"ram" switch do not watch). Disarming does not take files back out of memory.
+  void Arm(bool armed) { armed_.store(armed, std::memory_order_release); }
+  bool armed() const { return armed_.load(std::memory_order_acquire); }
+  bool in_memory() const { return in_memory_.load(std::memory_order_acquire); }
+
+  // A file made on the drive.
+  void NoteCreate(const void* key) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    const uint64_t now = now_ms_();
+    if (files_.size() >= kTracked) {
+      for (auto it = files_.begin(); it != files_.end();) {
+        it = now - it->second.made_ms > kLifetimeMs ? files_.erase(it) : std::next(it);
+      }
+      if (files_.size() >= kTracked) files_.clear();  // all young: start again
+    }
+    files_[key] = {now, 0};
+  }
+  // Written up to `end` (a write's end, a new length).
+  void NoteSize(const void* key, uint64_t end) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto found = files_.find(key);
+    if (found != files_.end() && end > found->second.bytes) found->second.bytes = end;
+  }
+  // A file deleted: true for the turn that moves the group to memory (once).
+  bool NoteDelete(const void* key) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto found = files_.find(key);
+    if (found == files_.end()) return false;  // not made while the group watched
+    const File file = found->second;
+    files_.erase(found);
+    const uint64_t now = now_ms_();
+    if (file.bytes > kSmallBytes || now - file.made_ms > kLifetimeMs) return false;
+    ++turns_total_;
+    turns_.push_back(now);
+    while (!turns_.empty() && now - turns_.front() > kWindowMs) turns_.pop_front();
+    if (turns_.size() < kTurns || !armed() || in_memory()) return false;
+    in_memory_.store(true, std::memory_order_release);
+    tripped_after_ = turns_total_;
+    return true;
+  }
+  // A new file goes to memory: moved there, with less than the budget in the pool and its reserve
+  // of direct memory kept (free_now < 0: not known). Counted either way.
+  bool Admit(uint64_t pool_used, int64_t direct_free, int64_t reserve, uint64_t segment_bytes) {
+    if (!in_memory()) return false;
+    const bool room = pool_used < kBudgetBytes &&
+                      (direct_free < 0 || direct_free - int64_t(segment_bytes) >= reserve);
+    (room ? admitted_ : declined_).fetch_add(1, std::memory_order_relaxed);
+    return room;
+  }
+
+  uint64_t admitted() const { return admitted_.load(std::memory_order_relaxed); }
+  uint64_t declined() const { return declined_.load(std::memory_order_relaxed); }
+  uint64_t turns_total() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return turns_total_;
+  }
+  uint64_t tripped_after() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return tripped_after_;
+  }
+  size_t followed() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return files_.size();
+  }
+
+ private:
+  struct File {
+    uint64_t made_ms = 0;
+    uint64_t bytes = 0;
+  };
+  uint64_t (*now_ms_)();
+  std::atomic<bool> armed_{false}, in_memory_{false};
+  std::atomic<uint64_t> admitted_{0}, declined_{0};
+  mutable std::mutex mutex_;
+  std::unordered_map<const void*, File> files_;
+  std::deque<uint64_t> turns_;
+  uint64_t turns_total_ = 0, tripped_after_ = 0;
+};
+
+}  // namespace cache_churn
+}  // namespace vfs
+}  // namespace xe
+
+#endif  // XENIA_VFS_DEVICES_CACHE_CHURN_H_
