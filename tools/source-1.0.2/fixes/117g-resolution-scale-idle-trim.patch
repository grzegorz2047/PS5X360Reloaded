+  // Fix 117g: framebuffers refer to the attachment views of the targets that
+  // may go; render passes do not, so they stay.
+  last_update_framebuffer_ = VK_NULL_HANDLE;
+  for (const auto& framebuffer_pair : framebuffers_) {
+    dfn.vkDestroyFramebuffer(device, framebuffer_pair.second.framebuffer,
+                             nullptr);
+  }
+  framebuffers_.clear();
+  return TrimUnusedRenderTargets(idle_frames);
+}
