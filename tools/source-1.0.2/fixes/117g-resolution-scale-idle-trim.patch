+#if XE_PLATFORM_PS5
+size_t RenderTargetCache::TrimUnusedRenderTargets(uint64_t idle_frames) {
+  // Fix 117g: as ClearCache keeps the targets owning EDRAM data, and also the
+  // last bound ones and those used in the last idle_frames frames.
+  std::unordered_set<RenderTargetKey, RenderTargetKey::Hasher> kept;
+  for (const auto& ownership_range_pair : ownership_ranges_) {
+    const OwnershipRange& ownership_range = ownership_range_pair.second;
+    for (const RenderTargetKey& key :
+         {ownership_range.render_target, ownership_range.depth_bits_target,
+          ownership_range.host_depth_render_target_unorm24,
+          ownership_range.host_depth_render_target_float24}) {
+      if (!key.IsEmpty()) {
+        kept.emplace(key);
+      }
+    }
+  }
+  std::unordered_set<const RenderTarget*> bound;
+  for (size_t i = 0; i < xe::countof(last_update_used_render_targets_); ++i) {
+    bound.emplace(last_update_used_render_targets_[i]);
+    bound.emplace(last_update_accumulated_render_targets_[i]);
+  }
+  size_t destroyed = 0;
+  for (auto it = render_targets_.begin(); it != render_targets_.end();) {
+    RenderTarget* render_target = it->second;
+    if (!render_target) {
+      it = render_targets_.erase(it);
+      continue;
+    }
+    if (!xbox360ps5::resolution_scale::MayTrim(
+            kept.find(render_target->key()) != kept.end(),
+            bound.find(render_target) != bound.end(), trim_frame_,
+            render_target->last_used_frame, idle_frames)) {
+      ++it;
+      continue;
+    }
+    delete render_target;
+    it = render_targets_.erase(it);
+    ++destroyed;
+  }
+  return destroyed;
+}
+#endif
 
