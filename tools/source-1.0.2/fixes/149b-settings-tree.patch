+  const auto& options = Options();
+  const auto add = [&](std::string_view key) {
+    if (key == option_groups::kFramegenRowKey) { if (!game) rows.push_back(kFramegenRow); return; }
+    if (key == option_groups::kFramegenOutputRowKey) { if (!game) rows.push_back(kFramegenOutputRow); return; }
+    if (key == option_groups::kFsiRowKey) { if (!game) rows.push_back(kFsiRow); return; }
+    for (int n = 0; n < int(options.size()); ++n)
+      if (key == options[size_t(n)].key && options[size_t(n)].category == category && (!game || options[size_t(n)].per_game))
