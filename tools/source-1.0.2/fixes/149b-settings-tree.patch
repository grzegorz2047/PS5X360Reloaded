+void Launcher::DrawGameSections(Canvas& c, float x, int category) {
+  const auto& options = Options();
+  for (int n = 0; n < int(game_sections_.size()); ++n) {
+    const int section = game_sections_[size_t(n)];
+    const std::vector<int> rows = TreeRows(category, section, true);
+    int own = 0;
+    for (const int row : rows) own += overrides_.count(options[size_t(row)].key) ? 1 : 0;
+    const float y = 384 + n * 56.0f;
+    const bool focused = n == game_section_row_ && g_list_focus_tab == 2;
+    c.Fill(x + 40, y, 780, 50, focused ? kSurfaceHigh : kSurface, focused ? 1.0f : 0.6f, 10);
+    if (focused) c.Edge(x + 40, y, 780, 50, kAccent, 0.9f, 10, 2.0f);
+    c.Text(Tr(option_groups::SectionName(section)), x + 64, y + 12, 24, focused ? kText : kBody, 1.0f, 0, 470);
+    std::string detail = std::to_string(rows.size()) + " " + Tr("Options");
+    if (own) detail += " · " + std::to_string(own) + " " + Tr("Customized");
+    c.Text(detail + "  >", x + 796, y + 14, 20, own ? kAccent : kMuted, 1.0f, 2, 290);
+  }
+  if (!game_sections_.empty()) {
+    c.Fill(x + 40, 774, 780, 1, kWhite, 0.10f);
+    c.Wrapped(SectionSummary(category, game_sections_[size_t(game_section_row_)], true), x + 56, 786, 20, kBody, 750);
+  }
+  float hint = x + 56;
+  if (g_list_focus_tab == 2) hint = c.Hint('x', Tr("Open"), hint, 1004);
+  c.Hint('o', Tr("Back"), hint, 1004);
+}
