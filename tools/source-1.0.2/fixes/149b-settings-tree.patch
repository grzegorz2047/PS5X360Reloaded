+// Fix 149b: a long page's sections, each with how many of its options are not at the recommended value;
+// under the list the rows the focused one holds.
+void Launcher::DrawSections(Canvas& c, float x) {
+  const std::vector<int> sections = option_groups::SectionsOf(category_);
+  const auto& options = Options();
+  for (int n = 0; n < int(sections.size()); ++n) {
+    int changed = 0;
+    for (const int row : TreeRows(category_, sections[size_t(n)], false))
+      if (row >= 0 && settings_.*(options[size_t(row)].field) != options[size_t(row)].recommended) ++changed;
+    const float y = 156 + n * 56.0f;
+    const bool focused = n == section_row_;
+    c.Fill(x + 40, y, 780, 50, focused ? kSurfaceHigh : kSurface, focused ? 1.0f : 0.6f, 10);
+    if (focused) c.Edge(x + 40, y, 780, 50, kAccent, 0.9f, 10, 2.0f);
+    c.Text(Tr(option_groups::SectionName(sections[size_t(n)])), x + 64, y + 12, 24, focused ? kText : kBody, 1.0f, 0, 500);
+    std::string value = ">";
+    if (changed) {
+      char text[48];
+      std::snprintf(text, sizeof(text), Tr("%d changed  >"), changed);
+      value = text;
+    }
+    c.Text(value, x + 796, y + 12, 24, focused ? kAccent : changed ? kWarning : kMuted, 1.0f, 2, 260);
+  }
+  c.Fill(x + 40, 612, 780, 1, kWhite, 0.10f);
+  if (!sections.empty()) c.Wrapped(SectionSummary(category_, sections[size_t(section_row_)], false), x + 56, 632, 20, kBody, 750);
+  float hint = c.Hint('x', Tr("Open"), x + 56, 1004);
+  hint = c.Hint('o', Tr("Back"), hint, 1004);
+  c.Hint('v', Tr("Navigate"), hint, 1004);
+}
