+  };
+  if (section != option_groups::kNoSection) {
+    for (const char* key : option_groups::SectionKeys(section)) add(key);
+  } else {
+    for (int n = 0; n < int(options.size()); ++n)
+      if (options[size_t(n)].category == category && (!game || options[size_t(n)].per_game)) rows.push_back(n);
+  }
+  return rows;
+}
+// Fix 149b: what a section holds, under its row: the names of its rows.
+std::string SectionSummary(int category, int section, bool game) {
+  std::string text;
