+// right of the selected option"). Every option the guide shows has a text here.
+struct Brief {
+  const char* key;
+  const char* text;
+};
+inline constexpr Brief kBriefs[] = {
+    {"image_filter", "How the picture is scaled to your screen. CAS sharpens; FSR upscales with cleaner edges."},
+    {"antialiasing", "Smooths jagged edges. FXAA is light; SMAA 1x gives the cleanest edges."},
+    {"color_preset", "Changes the picture's colors: deeper blacks, richer or brighter colors."},
+    {"overscan_crop", "Cuts a thin border off the edges, for games with a stripe at the edge."},
+    {"sharpness", "How strongly CAS and FSR sharpen the picture."},
+    {"dither", "Hides banding in skies and shadows."},
+    {"stretch", "Keep the game's proportions, or stretch the picture to fill the screen."},
