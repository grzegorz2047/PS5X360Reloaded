+// Fix 149b: the settings as a menu of several levels. On 1.0.6-work-fix149 the user found the
+// launcher's settings and a game's settings unreadable: long flat pages, and a game's subjects
+// switched with Triangle ("Next subject"), a list nobody sees. The two long pages, Picture and
+// smoothness and Emulation (advanced), now open a short list of sections, each a short list of
+// options; Audio, Controls and System (six or seven options each) stay one list. The same tree is
+// the launcher's (general settings and each game's), the guide's (the sections as headers over their
+// rows) and the phone page's (the sections as headings). A title above each list says where it is
+// (Path). The launcher's own rows (frame generation, its output, the general FSI switch) have keys
+// here too, so they sit in their section.
+enum Section : int {
+  kNoSection = -1,
+  kAaSharpness, kColorsFit, kFrameRate, kDetail,                                // Picture and smoothness
+  kVideoClock, kRendererAccuracy, kMemoryReadback, kShadersThreads, kProcessor,  // Emulation (advanced)
+};
+struct SectionInfo {
+  int category;
+  const char* name;
+};
+inline constexpr SectionInfo kSections[] = {
+    {kPicture, "Anti-aliasing and sharpness"}, {kPicture, "Colors and screen fit"},
+    {kPicture, "Frame rate and 120 Hz"},       {kPicture, "Detail and resolution"},
+    {kEmulation, "Video clock and mode"},      {kEmulation, "Renderer and accuracy"},
+    {kEmulation, "Video memory and readback"}, {kEmulation, "Shaders and threads"},
+    {kEmulation, "Processor"},
+};
+// The launcher's rows that are not options of the table (Settings > Picture and smoothness and
+// Emulation (advanced) in the launcher only; a game cannot have its own value of them).
+inline constexpr const char* kFramegenRowKey = "framegen";
+inline constexpr const char* kFramegenOutputRowKey = "framegen_output";
+inline constexpr const char* kFsiRowKey = "fsi_general";
+inline bool IsLauncherRow(std::string_view key) {
+  return key == kFramegenRowKey || key == kFramegenOutputRowKey || key == kFsiRowKey;
+}
+struct TreeEntry {
+  int section;
+  const char* key;
+};
+// Each section's rows, in the order they are shown.
+inline constexpr TreeEntry kTree[] = {
+    {kAaSharpness, "antialiasing"}, {kAaSharpness, "image_filter"}, {kAaSharpness, "sharpness"},
+    {kAaSharpness, "dither"},
+    {kColorsFit, "color_preset"}, {kColorsFit, "overscan_crop"}, {kColorsFit, "stretch"},
+    {kFrameRate, "present_limit"}, {kFrameRate, kFramegenRowKey}, {kFrameRate, kFramegenOutputRowKey},
+    {kDetail, "anisotropic"}, {kDetail, "draw_scale"},
+    {kVideoClock, "video_clock"}, {kVideoClock, "vsync"}, {kVideoClock, "internal_resolution"},
+    {kVideoClock, "gamma"},
+    {kRendererAccuracy, "renderer"}, {kRendererAccuracy, "depth_precision"}, {kRendererAccuracy, "decal_bias"},
+    {kRendererAccuracy, "mulsc"}, {kRendererAccuracy, "occlusion"}, {kRendererAccuracy, "fsi"},
+    {kRendererAccuracy, kFsiRowKey},
+    {kMemoryReadback, "memory_boost"}, {kMemoryReadback, "dynamic_buffers"}, {kMemoryReadback, "memory_window"},
+    {kMemoryReadback, "readback"}, {kMemoryReadback, "memexport"}, {kMemoryReadback, "clear_pages"},
+    {kMemoryReadback, "released_memory"},
+    {kShadersThreads, "async_shaders"}, {kShadersThreads, "pipeline_threads"}, {kShadersThreads, "threaded_driver"},
+    {kProcessor, "fast_locks"}, {kProcessor, "guest_yield"}, {kProcessor, "fast_dot"}, {kProcessor, "no_promotion"},
+    {kProcessor, "zero_page"},
+};
+
+inline const char* SectionName(int section) {
+  return section >= 0 && section < int(std::size(kSections)) ? kSections[section].name : "";
+}
+// The section a row is in (kNoSection for the options of Audio, Controls and System).
+inline int SectionOf(std::string_view key) {
+  for (const TreeEntry& entry : kTree)
+    if (key == entry.key) return entry.section;
+  return kNoSection;
+}
+// The sections of a page, in order (none: the page is one list).
+inline std::vector<int> SectionsOf(int category) {
+  std::vector<int> sections;
+  for (int n = 0; n < int(std::size(kSections)); ++n)
+    if (kSections[n].category == category) sections.push_back(n);
+  return sections;
+}
+inline bool HasSections(int category) { return !SectionsOf(category).empty(); }
+// A section's rows, in order.
+inline std::vector<const char*> SectionKeys(int section) {
+  std::vector<const char*> keys;
+  for (const TreeEntry& entry : kTree)
+    if (entry.section == section) keys.push_back(entry.key);
+  return keys;
+}
+// Where a row goes in the tree's order: by section, then by its place there; rows without a section
+// after them, in their own order (std::stable_sort keeps it).
+inline int TreeRank(std::string_view key) {
+  for (int n = 0; n < int(std::size(kTree)); ++n)
+    if (key == kTree[n].key) return n;
+  return int(std::size(kTree));
+}
+// The title over a list: the levels from the top, translated by the caller ("Settings > Picture and
+// smoothness > Colors and screen fit"). ">" as the launcher's own rows show a level below.
+inline std::string Path(const std::vector<std::string>& levels) {
+  std::string path;
+  for (const std::string& level : levels) {
+    if (level.empty()) continue;
+    if (!path.empty()) path += "  >  ";
+    path += level;
+  }
+  return path;
+}
+// The guide's rows a header only names: Up and Down move past it, in the direction they went; past the
+// first row is the tab bar (-1). is_header(row) says whether a row is a header.
+template <typename IsHeader>
+int SkipHeader(int row, int direction, int rows, IsHeader&& is_header) {
+  while (row >= 0 && row < rows && is_header(row)) row += direction < 0 ? -1 : 1;
+  if (row >= rows) {  // a header at the end (none is): back to the last row that is not one
+    row = rows - 1;
+    while (row >= 0 && is_header(row)) --row;
+  }
+  return row;
+}
