+    {"dynamic_buffers", "Lighter tracking of data the game rewrites all the time. Off only to compare."},
+    {"memory_window", "How much memory is sent to video again after the game writes to it."},
+    {"readback", "Lets the game read back what it drew. Some effects need it; it is slower."},
+    {"memexport", "Lets the game read data made by video. Fixes missing objects; it is slower."},
+    {"async_shaders", "Prepares new effects in the background: fewer stops, effects may appear late."},
+    {"clear_pages", "A fix for Team Ninja games where characters disappear. It is slower."},
+    {"released_memory", "Draws from memory the game already gave back, so nothing goes missing."},
+    {"mute", "Turns the game's sound off or on."},
+    {"volume", "The game's sound volume. The TV's volume still applies."},
+    {"ui_sounds", "The emulator's menu sounds."},
+    {"ui_sound_volume", "The volume of the menu sounds."},
+    {"touchpad_menu", "What a touchpad click does: open this guide, or press Xbox Back."},
+    {"vibration", "Sends the game's vibration to the controller."},
+    {"deadzone_left", "Ignores small movements of the left stick."},
+    {"deadzone_right", "Ignores small movements of the right stick."},
+    {"motion_phone", "A phone as a motion camera (research). It shows diagnostics."},
+    {"motion_panel", "Where the motion panel is drawn over the game."},
+    {"motion_picture", "Sends the phone camera's picture to games that show the camera."},
+    {"show_fps", "Shows the frames per second in a corner."},
+    {"achievement_toasts", "Shows a notification when you unlock an achievement."},
+    {"save_drive", "Where the game keeps its saves."},
+};
+inline const char* BriefOf(std::string_view key) {
+  for (const Brief& brief : kBriefs)
+    if (key == brief.key) return brief.text;
+  return nullptr;
+}
+// The line an Emulation (advanced) option's help adds.
+inline constexpr const char* kRiskLine = "Changes how the game runs: it can run faster, slower or wrong.";
+inline bool ChangesHowGameRuns(std::string_view key) {
+  const Entry* entry = Find(key);
+  return entry && entry->group == Group::emulation;
+}
+// An option's choices on one line ("Off  ·  FXAA  ·  SMAA 1x"), each already translated.
+inline std::string JoinChoices(const std::vector<std::string>& choices) {
+  std::string line;
+  for (const std::string& choice : choices) {
+    if (choice.empty()) continue;
+    if (!line.empty()) line += "  ·  ";  // the launcher's own separator
+    line += choice;
+  }
+  return line;
+}
+// Where the help card goes: beside its row, inside the band [top, bottom] it may use.
+inline float CardTop(float row_y, float height, float top, float bottom) {
+  float y = row_y;
+  if (y + height > bottom) y = bottom - height;
+  if (y < top) y = top;
+  return y;
+}
