+// Xbox360PS5 (fix 134c): the commands of RecordResolveBatch, into a Vulkan command buffer (the
+// GPU thread, after the replay) or at the end of a deferred one (a submission handed to the
+// submit worker, which replays it there: the same place).
+struct VulkanQueryPool::ResolveRecorder {
+  const ui::vulkan::VulkanDevice::Functions* dfn = nullptr;
+  VkCommandBuffer command_buffer = VK_NULL_HANDLE;
+  DeferredCommandBuffer* deferred = nullptr;
+  void CopyQueryPoolResults(VkQueryPool pool, uint32_t first, uint32_t count, VkBuffer dst,
+                            VkDeviceSize offset, VkDeviceSize stride,
+                            VkQueryResultFlags flags) const {
+    if (deferred) {
+      deferred->CmdVkCopyQueryPoolResults(pool, first, count, dst, offset, stride, flags);
+    } else {
+      dfn->vkCmdCopyQueryPoolResults(command_buffer, pool, first, count, dst, offset, stride,
+                                     flags);
+    }
+  }
+  void PipelineBarrier(VkPipelineStageFlags src, VkPipelineStageFlags dst, uint32_t count,
+                       const VkBufferMemoryBarrier* barriers) const {
+    if (deferred) {
+      deferred->CmdVkPipelineBarrier(src, dst, 0, 0, nullptr, count, barriers, 0, nullptr);
+    } else {
+      dfn->vkCmdPipelineBarrier(command_buffer, src, dst, 0, 0, nullptr, count, barriers, 0,
+                                nullptr);
+    }
+  }
+  void CopyBuffer(VkBuffer src, VkBuffer dst, uint32_t count, const VkBufferCopy* regions) const {
+    if (deferred) {
+      deferred->CmdVkCopyBuffer(src, dst, count, regions);
+    } else {
+      dfn->vkCmdCopyBuffer(command_buffer, src, dst, count, regions);
+    }
+  }
+};
