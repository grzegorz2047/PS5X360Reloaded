+// Fix 150g: games that run at 1x even when 2x is chosen (their own setting or the general one).
+// Kinect Sports (4D5308C9) at 2x on 1.0.6-work-fix150f: its Kinect camera pictures are copied with
+// copy command 2 (kConvertTo1111), which the core cannot do scaled (fix 154: skipped, 32769 times in
+// a session), so the stadium's big screen showed green blocks and the replay panel stayed black;
+// and its render targets (up to 3680x2880 at 2x) reached 4252 MiB with the utility cache on the
+// drive, so fix 117b put several of them at 1x within minutes. At 1x both are fine (150d3).
+inline bool TwoXUnfit(const std::string& title_id) {
+  static constexpr const char* kTitles[] = {"4D5308C9"};
+  for (const char* id : kTitles) {
+    if (title_id.size() != 8) continue;
+    bool same = true;
+    for (size_t i = 0; i < 8; ++i)
+      same = same && std::toupper(static_cast<unsigned char>(title_id[i])) == id[i];
+    if (same) return true;
+  }
+  return false;
+}
+// The draw_scale choice a game runs with: 2x (1) becomes 1x (0) for those games.
+inline int ChoiceFor(int choice, const std::string& title_id) {
+  return choice == 1 && TwoXUnfit(title_id) ? 0 : choice;
+}
