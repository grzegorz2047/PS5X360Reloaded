diff --git a/include/xbox360ps5/smartglass_app.hpp b/include/xbox360ps5/smartglass_app.hpp
new file mode 100644
index 0000000..3109e22
--- /dev/null
+++ b/include/xbox360ps5/smartglass_app.hpp
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: MIT
+// Fix 147b: the console's SmartGlass service (Xbox LIVE Remote Control, "LRC"), XAM app 0xF1.
+//
+// Dance Central 3 (373307D9) talks to it through its XDK interface (XamLrcSetTitlePort and app-F1
+// messages 0x00800002..0x00800005, 12-byte buffers): about once a frame it sends 0x00800002 with an
+// overlapped. No app 0xF1 existed, so XMsgStartIORequestEx answered "app undefined" at once
+// (X_E_INVALIDARG, 15,389 log lines in four minutes) and the game sent it again on the next frame.
+//
+// Here the app exists and says what a console with no SmartGlass device connected would say: no
+// companion device (ERROR_DEVICE_NOT_CONNECTED) for every request, through the overlapped as any
+// XMsg request, and logs each message ID once.
+#pragma once
+#include <cstdint>
+
+namespace xbox360ps5::smartglass {
+
+constexpr uint32_t kAppId = 0xF1;
+// Win32 ERROR_DEVICE_NOT_CONNECTED: no SmartGlass (companion) device is connected.
+constexpr uint32_t kNoCompanionDevice = 0x0000048F;
+
+// The answer to one message: messages of the LRC class (0x0080xxxx) get "no companion device";
+// anything else gets ERROR_INVALID_FUNCTION (1), which no title is known to send.
+inline uint32_t Answer(uint32_t message) {
+  return (message & 0xFFFF0000u) == 0x00800000u ? kNoCompanionDevice : 0x00000001u;
+}
+
+}  // namespace xbox360ps5::smartglass
diff --git a/include/xbox360ps5/title_keys.hpp b/include/xbox360ps5/title_keys.hpp
new file mode 100644
index 0000000..3bb92be
--- /dev/null
+++ b/include/xbox360ps5/title_keys.hpp
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: MIT
+// Fix 147b: the title key slots of XeKeysSetKey / XeKeysAesCbc.
+//
+// Dance Central 3 stayed on its "Loading" screen: through the XDK it puts a 16-byte key of its own
+// (a table in the executable, 82D13000) into key slot 0xE0 + n with XeKeysSetKey, then decrypts one
+// 16-byte block with XeKeysAesCbc on that slot (no feed, decrypt) -- the key step of Harmonix's
+// encrypted song audio. Neither export existed ("undefined extern call to XeKeysSetKey /
+// XeKeysAesCbc"): the calls returned without writing the output, so the game worked with whatever
+// was in its buffer.
+//
+// The slots a title may set are 0xE0..0xE7 (the XDK refuses an index of 8 or more before the call).
+// The key is the one the title gave; AES-CBC runs with it as the console does for these slots (the
+// key is the game's own, the same on every console). A missing feed is a zero IV.
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <mutex>
+
+namespace xbox360ps5::title_keys {
+
+constexpr uint32_t kFirstSlot = 0xE0;
+constexpr uint32_t kSlots = 8;
+constexpr uint32_t kKeyBytes = 16;
+
+// The slot index of a key number a title may set, or -1.
+inline int Slot(uint32_t key_number) {
+  return key_number >= kFirstSlot && key_number < kFirstSlot + kSlots ? int(key_number - kFirstSlot)
+                                                                      : -1;
+}
+
+// AES-CBC input: whole 16-byte blocks, at least one.
+inline bool CbcSize(uint32_t bytes) { return bytes && bytes % kKeyBytes == 0; }
+
+class Store {
+ public:
+  // A 16-byte key for a title slot; anything else is refused.
+  bool Set(uint32_t key_number, const uint8_t* key, uint32_t bytes) {
+    const int slot = Slot(key_number);
+    if (slot < 0 || !key || bytes != kKeyBytes) return false;
+    std::lock_guard<std::mutex> lock(mutex_);
+    std::memcpy(keys_[size_t(slot)].data(), key, kKeyBytes);
+    set_[size_t(slot)] = true;
+    return true;
+  }
+  bool Get(uint32_t key_number, uint8_t* key) const {
+    const int slot = Slot(key_number);
+    if (slot < 0) return false;
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!set_[size_t(slot)]) return false;
+    std::memcpy(key, keys_[size_t(slot)].data(), kKeyBytes);
+    return true;
+  }
+
+ private:
+  mutable std::mutex mutex_;
+  std::array<std::array<uint8_t, kKeyBytes>, kSlots> keys_{};
+  std::array<bool, kSlots> set_{};
+};
+
+}  // namespace xbox360ps5::title_keys
