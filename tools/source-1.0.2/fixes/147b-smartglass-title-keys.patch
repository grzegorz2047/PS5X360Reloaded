+// Xbox360PS5 fix 147b: XAM app 0xF1, the SmartGlass service (Xbox LIVE Remote
+// Control). Dance Central 3 sends it 0x00800002 about once a frame; without the
+// app every request failed at once as "app undefined" (a log line each). It
+// answers as a console with no SmartGlass device connected would: no companion
+// device, through the overlapped as any XMsg request; each message ID is logged
+// once.
+class SmartGlassApp : public App {
+ public:
+  explicit SmartGlassApp(KernelState* kernel_state)
+      : App(kernel_state, xbox360ps5::smartglass::kAppId) {}
+
+  X_HRESULT ExecuteDispatchMessage(uint32_t message, uint32_t buffer_ptr,
+                                   uint32_t buffer_length,
+                                   uint32_t* extended_error) override {
+    const uint32_t answer = xbox360ps5::smartglass::Answer(message);
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (logged_.size() < 32 && logged_.insert(message).second) {
+        XELOGW(
+            "SmartGlass (fix 147b): message {:08X} ({} bytes at {:08X}) "
+            "answered {:08X}: no companion device (said once per message)",
+            message, buffer_length, buffer_ptr, answer);
+      }
+    }
+    if (extended_error) {
+      *extended_error = X_HRESULT_FROM_WIN32(answer);
+    }
+    return answer;
+  }
+
+ private:
+  std::mutex mutex_;
+  std::set<uint32_t> logged_;
+};
