--- /dev/null
+++ b/include/xbox360ps5/readback_keys.hpp
@@ -0,0 +1,180 @@
+// SPDX-License-Identifier: MIT
+// Fix 91 diagnostic (issue 14, 1.0.5-work-fix91e): the resolve readback mode per key, from a file
+// the user writes over FTP between runs, for finding which resolve Tekken Tag Tournament 2's
+// colours need without a build per guess (four rules tried on the console, none right).
+//
+// readback-keys.txt (the title folder, or /download0/xbox360ps5/), read again when it changes:
+//   # a comment
+//   default full            every key not listed below: full (or fast); without it, the setting
+//   0E338000 fast           one address, any length
+//   0FE7C000/245760 full    one address and length (bytes, decimal, or hex with 0x)
+// A key's line with a length wins over its address-only line, which wins over the default. Only
+// the fast and full settings are changed (readback off, and its automatic copy, stay as they are).
+#pragma once
+#include <atomic>
+#include <cstdint>
+#include <cstdlib>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace xbox360ps5::readback_keys {
+
+enum class Mode { kAsSet, kFast, kFull };
+
+struct Rule {
+  uint32_t address = 0;
+  uint32_t length = 0;  // 0: any length
+  Mode mode = Mode::kAsSet;
+};
+struct Rules {
+  Mode default_mode = Mode::kAsSet;
+  std::vector<Rule> keys;
+  int not_understood = 0;  // lines that were neither empty, a comment, nor a rule
+  // 1.0.5-work-fix91g: "watch <address>" arms the CPU read watch on that key at every resolve
+  // (testing the watch alone); "occasional own" gives every occasional key its own copy whether
+  // or not the CPU is seen reading it (the simpler rule, for measuring its cost).
+  std::vector<uint32_t> watch;
+  bool occasional_own = false;
+  // 1.0.5-work-fix91h: "nocopy <address>" leaves that key's fast-mode copy out of guest memory;
+  // "nocopy unread" leaves out the copies of every key the CPU has not been seen reading.
+  std::vector<uint32_t> nocopy;
+  bool nocopy_unread = false;
+};
+
+inline bool ParseMode(const std::string& word, Mode* mode) {
+  if (word == "full") *mode = Mode::kFull;
+  else if (word == "fast") *mode = Mode::kFast;
+  else return false;
+  return true;
+}
+
+inline bool ParseNumber(const std::string& text, int base, uint32_t* value) {
+  if (text.empty()) return false;
+  char* end = nullptr;
+  const unsigned long long n = std::strtoull(text.c_str(), &end, base);
+  if (!end || *end || n > 0xFFFFFFFFull) return false;
+  *value = uint32_t(n);
+  return true;
+}
+
+inline Rules Parse(const std::string& text) {
+  Rules rules;
+  std::istringstream lines(text);
+  std::string line;
+  while (std::getline(lines, line)) {
+    const size_t hash = line.find('#');
+    if (hash != std::string::npos) line.resize(hash);
+    std::istringstream words(line);
+    std::string first, second, extra;
+    if (!(words >> first)) continue;  // empty
+    Mode mode;
+    if (first == "nocopy") {
+      uint32_t address = 0;
+      if (!(words >> second) || (words >> extra)) {
+        ++rules.not_understood;
+      } else if (second == "unread") {
+        rules.nocopy_unread = true;
+      } else if (ParseNumber(second.rfind("0x", 0) == 0 ? second.substr(2) : second, 16, &address)) {
+        rules.nocopy.push_back(address);
+      } else {
+        ++rules.not_understood;
+      }
+      continue;
+    }
+    if (first == "watch" || first == "occasional") {
+      uint32_t address = 0;
+      const bool ok =
+          (words >> second) && !(words >> extra) &&
+          (first == "watch"
+               ? ParseNumber(second.rfind("0x", 0) == 0 ? second.substr(2) : second, 16, &address)
+               : (second == "own" || second == "off"));
+      if (!ok) {
+        ++rules.not_understood;
+      } else if (first == "watch") {
+        rules.watch.push_back(address);
+      } else {
+        rules.occasional_own = second == "own";
+      }
+      continue;
+    }
+    if (!(words >> second) || (words >> extra) || !ParseMode(second, &mode)) {
+      ++rules.not_understood;
+      continue;
+    }
+    if (first == "default") {
+      rules.default_mode = mode;
+      continue;
+    }
+    Rule rule;
+    rule.mode = mode;
+    const size_t slash = first.find('/');
+    const std::string address = first.substr(0, slash);
+    bool ok = ParseNumber(address.rfind("0x", 0) == 0 ? address.substr(2) : address, 16, &rule.address);
+    if (ok && slash != std::string::npos) {
+      const std::string length = first.substr(slash + 1);
+      ok = length.rfind("0x", 0) == 0 ? ParseNumber(length.substr(2), 16, &rule.length)
+                                      : ParseNumber(length, 10, &rule.length);
+      ok = ok && rule.length;
+    }
+    if (!ok) {
+      ++rules.not_understood;
+      continue;
+    }
+    rules.keys.push_back(rule);
+  }
+  return rules;
+}
+
+// The mode for a key: its address-and-length line, else its address line, else the default.
+inline Mode Lookup(const Rules& rules, uint32_t address, uint32_t length) {
+  Mode by_address = Mode::kAsSet;
+  bool any_address = false;
+  for (const Rule& rule : rules.keys) {
+    if (rule.address != address) continue;
+    if (rule.length == length) return rule.mode;
+    if (!rule.length) {
+      by_address = rule.mode;
+      any_address = true;
+    }
+  }
+  return any_address ? by_address : rules.default_mode;
+}
+
+inline bool Watched(const Rules& rules, uint32_t address) {
+  for (uint32_t watched : rules.watch)
+    if (watched == address) return true;
+  return false;
+}
+// Whether a key's fast-mode copy stays out of guest memory (fix 91h): listed, or "nocopy
+// unread" and the CPU not seen reading it.
+inline bool NoCopy(const Rules& rules, uint32_t address, bool cpu_reads) {
+  for (uint32_t listed : rules.nocopy)
+    if (listed == address) return true;
+  return rules.nocopy_unread && !cpu_reads;
+}
+
+// Fix 91i: whether any page of first..last has its bit set, the bits held 64 pages to a block
+// (the memory's notify_on_read flags); bits(block) gives block number `block`'s bits.
+template <typename Bits>
+inline bool AnyPage(Bits bits, uint32_t first, uint32_t last) {
+  if (first > last) return false;
+  for (uint32_t block = first >> 6; block <= (last >> 6); ++block) {
+    uint64_t set = bits(block);
+    if (block == (first >> 6)) set &= ~((uint64_t(1) << (first & 63)) - 1);
+    if (block == (last >> 6) && (last & 63) != 63) set &= (uint64_t(1) << ((last & 63) + 1)) - 1;
+    if (set) return true;
+  }
+  return false;
+}
+
+inline const char* Name(Mode mode) {
+  return mode == Mode::kFull ? "full" : mode == Mode::kFast ? "fast" : "as set";
+}
+
+}  // namespace xbox360ps5::readback_keys
+
+namespace xbox360ps5 {
+// Fix 91i (memory.cc): read-watched pages whose first access was a write.
+extern std::atomic<uint32_t> read_watch_writes;
+}  // namespace xbox360ps5
