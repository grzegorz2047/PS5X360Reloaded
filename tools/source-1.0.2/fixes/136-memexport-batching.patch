+// Fix 136 (memexport_batch.h): whether memory exports are batched, from memexport-batching.txt in
+// the title folder when it exists (read again at most once a second), else the cvar; every 30 s
+// the batch's counters.
+bool VulkanCommandProcessor::MemexportBatchingOn() {
+  static auto checked = std::chrono::steady_clock::time_point();
+  static auto summary = std::chrono::steady_clock::now();
+  const auto now = std::chrono::steady_clock::now();
+  if (!memexport_batching_logged_ || now - checked >= std::chrono::seconds(1)) {
+    checked = now;
+    bool on = cvars::readback_memexport_batching;
+    bool from_file = false;
+    int not_understood = 0;
+    const char* const path = XBOX360PS5_DATA_ROOT "/memexport-batching.txt";
+    if (FILE* file = std::fopen(path, "rb")) {
+      std::string text;
+      char chunk[256];
+      size_t got;
+      while ((got = std::fread(chunk, 1, sizeof(chunk), file)) > 0) text.append(chunk, got);
+      std::fclose(file);
+      not_understood = memexport_batch::ParseSwitch(text, on);
+      from_file = true;
+    }
+    if (!memexport_batching_logged_ || on != memexport_batching_on_) {
+      // Switched off: what is pending is merged at the next sync point or before the next
+      // export read back at once (not here, in the middle of a draw).
+      memexport_batching_on_ = on;
+      memexport_batching_logged_ = true;
+      XELOGW("Memexport batching (fix 136): {}, from {}{}", on ? "on" : "off",
+             from_file ? path : "the settings",
+             not_understood ? fmt::format(", {} lines not understood", not_understood)
+                            : std::string());
+    }
+  }
+  if (now - summary >= std::chrono::seconds(30)) {
+    summary = now;
+    if (memexport_batching_on_ || memexport_batch_deferred_ || memexport_batch_at_once_) {
+      std::string reasons;
+      for (uint32_t reason = 0; reason < memexport_batch::kReasons; ++reason) {
+        if (!memexport_batch_flushes_[reason]) continue;
+        reasons += fmt::format("{}{} {}", reasons.empty() ? "" : ", ",
+                               memexport_batch::ReasonName(reason),
+                               memexport_batch_flushes_[reason]);
+      }
+      uint64_t flushes = 0;
+      for (uint64_t count : memexport_batch_flushes_) flushes += count;
+      XELOGW("Memexport batching, last 30 s (fix 136, {}): {} exports batched, merged in {} waits "
+             "({}); {} read back at once",
+             memexport_batching_on_ ? "on" : "off", memexport_batch_deferred_, flushes,
+             reasons.empty() ? "none" : reasons, memexport_batch_at_once_);
+      memexport_batch_deferred_ = memexport_batch_at_once_ = 0;
+      memexport_batch_flushes_.fill(0);
+    }
+  }
+  return memexport_batching_on_;
+}
