+// SPDX-License-Identifier: MIT
+// Xbox360PS5, fix 136: memory exports read back once per sync period instead of at every
+// exporting draw.
+//
+// Fix 30 reads a draw's exports back to guest memory right after the draw: a submission, a wait
+// for the GPU and a merge of the dwords the shader wrote (memexport_merge.h). Fix 133 counted
+// those waits and the periods between the points where the CPU can learn that the GPU went on
+// (the command processor writing guest memory, a new part of the ring, a swap): Kinect Sports'
+// boxing 42,103-55,894 waits in 3,458-3,516 periods per 30 s (129-192 ms/s, about 1,500
+// submissions a second), Modern Warfare 2 3.9-8.4 waits per period (56-83 ms/s).
+//
+// With readback_memexport_batching on, the copies are recorded as before, each export into its
+// own place in the readback buffer (Batch::Reserve), and the wait and the merges run once, at
+// the first of: the command processor writing guest memory (MEM_WRITE, EVENT_WRITE_SHD,
+// COND_WRITE, REG_TO_MEM, a scratch register's write-back), an interrupt, a WAIT_REG_MEM on
+// memory, the end of a part of the ring, a swap, a draw or resolve whose pending export units the
+// CPU wrote meanwhile (their GPU copy would be replaced by an upload), the readback buffer full.
+// Until merged, the units are marked GPU-only (fix 48), so an upload over them is counted as
+// exported data lost. The merges run in export order; fix 30's merge keeps the dwords the CPU
+// changed after the draw.
+#ifndef XENIA_GPU_VULKAN_MEMEXPORT_BATCH_H_
+#define XENIA_GPU_VULKAN_MEMEXPORT_BATCH_H_
+
+#include <cstdint>
+#include <sstream>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace xe {
+namespace gpu {
+namespace memexport_batch {
+
+enum FlushReason : uint32_t {
+  kCpWrite = 0,
+  kInterrupt,
+  kWaitRegMem,
+  kRingPart,
+  kSwap,
+  kInvalidated,
+  kFull,
+  kOther,
+  kReasons
+};
+inline const char* ReasonName(uint32_t reason) {
+  static const char* const names[] = {"CP write", "interrupt", "WAIT_REG_MEM", "ring part",
+                                      "swap",     "units written", "buffer full", "other"};
+  return reason < kReasons ? names[reason] : "?";
+}
+
+struct Range {
+  uint32_t start = 0, size = 0;
+};
+// An export waiting for its merge: its ranges, and where its copies are in the readback buffer
+// (the copy from after the draw at base, the one from before at base + before_offset).
+struct Pending {
+  std::vector<Range> ranges;
+  uint32_t base = 0, before_offset = 0, total = 0;
+  uint64_t shader = 0;
+};
+
+constexpr uint32_t kAlign = 256;
+constexpr uint32_t kMaxBytes = 32u << 20;
+
+class Batch {
+ public:
+  // Where the next export's copies go, or UINT32_MAX when it does not fit after the pending ones
+  // (or at all: more than `capacity` or kMaxBytes); it is then read back at once, after them.
+  uint32_t Reserve(uint32_t before_offset, uint32_t total, uint32_t capacity) const {
+    const uint64_t need = uint64_t(before_offset) + total;
+    if (need > capacity || need > kMaxBytes) return UINT32_MAX;
+    if (pending_.empty()) return 0;
+    const uint64_t end = uint64_t(offset_) + need;
+    return end <= capacity && end <= kMaxBytes ? offset_ : UINT32_MAX;
+  }
+  void Add(Pending pending) {
+    const uint64_t end = uint64_t(pending.base) + pending.before_offset + pending.total;
+    offset_ = uint32_t((end + kAlign - 1) / kAlign * kAlign);
+    pending_.push_back(std::move(pending));
+  }
+  bool empty() const { return pending_.empty(); }
+  const std::vector<Pending>& pending() const { return pending_; }
+  void Clear() {
+    pending_.clear();
+    offset_ = 0;
+  }
+  // Whether a pending range is no longer valid in the GPU copy (`valid(start, size)` false): the
+  // CPU wrote it, and an upload would replace the exported data.
+  template <class Valid>
+  bool AnyInvalid(Valid valid) const {
+    for (const Pending& pending : pending_) {
+      for (const Range& range : pending.ranges) {
+        if (!valid(range.start, range.size)) return true;
+      }
+    }
+    return false;
+  }
+
+ private:
+  std::vector<Pending> pending_;
+  uint32_t offset_ = 0;
+};
+
+// memexport-batching.txt in the title folder: "on" or "off" (it wins over the cvar), "#" comments.
+// Returns the lines not understood.
+inline int ParseSwitch(const std::string& text, bool& on) {
+  int not_understood = 0;
+  std::istringstream lines(text);
+  std::string line;
+  while (std::getline(lines, line)) {
+    const size_t hash = line.find('#');
+    if (hash != std::string::npos) line.resize(hash);
+    std::istringstream words(line);
+    std::string word, extra;
+    if (!(words >> word)) continue;
+    if (words >> extra) {
+      ++not_understood;
+    } else if (word == "on") {
+      on = true;
+    } else if (word == "off") {
+      on = false;
+    } else {
+      ++not_understood;
+    }
+  }
+  return not_understood;
+}
+
+}  // namespace memexport_batch
+}  // namespace gpu
+}  // namespace xe
+
+#endif  // XENIA_GPU_VULKAN_MEMEXPORT_BATCH_H_
