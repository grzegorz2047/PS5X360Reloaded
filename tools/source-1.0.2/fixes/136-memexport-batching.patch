+// Fix 136: the batch's readback buffer, kMaxBytes, host-readable like RequestReadbackBuffer's.
+bool VulkanCommandProcessor::EnsureMemexportBatchBuffer() {
+  if (memexport_batch_buffer_ != VK_NULL_HANDLE) {
+    return true;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  VkBufferCreateInfo buffer_info = {VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+  buffer_info.size = memexport_batch::kMaxBytes;
+  buffer_info.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+  buffer_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+  VkBuffer buffer;
+  if (dfn.vkCreateBuffer(device, &buffer_info, nullptr, &buffer) != VK_SUCCESS) {
+    XELOGE("Memexport batching (fix 136): failed to create the readback buffer");
+    return false;
+  }
+  VkMemoryRequirements requirements;
+  dfn.vkGetBufferMemoryRequirements(device, buffer, &requirements);
+  const uint32_t memory_type = ui::vulkan::util::ChooseMemoryType(
+      vulkan_device->memory_types(), requirements.memoryTypeBits,
+      ui::vulkan::util::MemoryPurpose::kReadback);
+  VkMemoryAllocateInfo allocate_info = {VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+  allocate_info.allocationSize = requirements.size;
+  allocate_info.memoryTypeIndex = memory_type;
+  VkDeviceMemory memory;
+  if (memory_type == UINT32_MAX ||
+      dfn.vkAllocateMemory(device, &allocate_info, nullptr, &memory) != VK_SUCCESS) {
+    XELOGE("Memexport batching (fix 136): failed to allocate the readback buffer's memory");
+    dfn.vkDestroyBuffer(device, buffer, nullptr);
+    return false;
+  }
+  if (dfn.vkBindBufferMemory(device, buffer, memory, 0) != VK_SUCCESS) {
+    XELOGE("Memexport batching (fix 136): failed to bind the readback buffer's memory");
+    dfn.vkFreeMemory(device, memory, nullptr);
+    dfn.vkDestroyBuffer(device, buffer, nullptr);
+    return false;
+  }
+  memexport_batch_buffer_ = buffer;
+  memexport_batch_memory_ = memory;
+  memexport_batch_host_coherent_ =
+      (vulkan_device->memory_types().host_coherent & (uint32_t(1) << memory_type)) != 0;
+  return true;
+}
+
+// Fix 136: one wait for the GPU, then each pending export's merge in order (fix 30's: only the
+// dwords the shader wrote), and its units back to normal (fix 48).
+void VulkanCommandProcessor::FlushMemexportBatch(uint32_t reason) {
+  if (memexport_batch_.empty() || memexport_batch_flushing_) {
+    return;
+  }
+  memexport_batch_flushing_ = true;
+  ++memexport_batch_flushes_[std::min<uint32_t>(reason, memexport_batch::kReasons - 1)];
+  {
+#if XE_PLATFORM_PS5
+    xbox360ps5::frame_cost::CauseScope frame_cost_cause(  // fix 49
+        xbox360ps5::frame_cost::kMemexport);
+#endif
+    readback_memexport_batches_.Note(ReadbackSyncPoint());  // fix 133: the one wait
+    if (AwaitAllQueueOperationsCompletion()) {
+      const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+      void* mapped_data = nullptr;
+      if (MapReadbackMemory(memexport_batch_memory_, memexport_batch_host_coherent_,
+                            &mapped_data) &&
+          mapped_data) {
+        const uint8_t* const bytes = static_cast<const uint8_t*>(mapped_data);
+        for (const memexport_batch::Pending& pending : memexport_batch_.pending()) {
+          const uint8_t* after = bytes + pending.base;
+          const uint8_t* before = after + pending.before_offset;
+          for (const memexport_batch::Range& range : pending.ranges) {
+            xbox360ps5::memexport_merge::ApplyExports(memory_->TranslatePhysical(range.start),
+                                                      before, after, range.size);
+            shared_memory_->ClearGpuOnly(range.start, range.size);
+            after += range.size;
+            before += range.size;
+          }
+          ++memexport_batch_merged_;
+        }
+        vulkan_device->functions().vkUnmapMemory(vulkan_device->device(),
+                                                 memexport_batch_memory_);
+      } else {
+        XELOGE("Memexport batching (fix 136): failed to map the readback buffer");
+      }
+    } else {
+      XELOGE("Memexport batching (fix 136): failed to complete the queue operations");
+    }
+  }
+  memexport_batch_.Clear();
+  memexport_batch_flushing_ = false;
+}
+
+void VulkanCommandProcessor::FlushDeferredReadbacks(uint32_t reason) {
+  if (!memexport_batch_.empty()) {
+    FlushMemexportBatch(reason);
+  }
+}
