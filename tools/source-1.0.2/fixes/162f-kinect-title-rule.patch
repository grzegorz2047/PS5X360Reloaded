+// Fix 162f: a Kinect title (its executable says it requires Kinect: XEX system flag 32, skeletal
+// tracking required, covers.hpp GameRequiresKinect, as fix 57's virtual player uses). Kinect Sports,
+// Season Two and Zumba Fitness Core (two developers) failed at 2x the same way, through the passes of
+// the Kinect library every Kinect title links: its camera pictures copied with copy command 2 from
+// 80, 160 and 320 pixel 1xMSAA targets (skipped scaled: black or green pictures) and 2.4 to 2.7 GiB of
+// scaled render targets (stutter, 1 frame a second). The launch notes the flag (a set of title IDs,
+// read when the game is chosen or started); Automatic starts such a title at 1x, and at 2x it keeps
+// those three classes at 1x unless it has a list of its own.
+#define XBOX360PS5_KINECT_TITLE_RULE 1  // fix 162f (auto_scale.hpp and the host checks look for it)
+inline std::mutex kinect_titles_mutex;
+inline std::set<std::string> kinect_titles;
+inline std::string UpperTitle(const std::string& title_id) {
+  std::string id;
+  for (char ch : title_id) id += char(std::toupper(static_cast<unsigned char>(ch)));
+  return id;
+}
+inline void NoteKinectTitle(const std::string& title_id, bool requires_kinect) {
+  if (title_id.empty()) return;
+  std::lock_guard<std::mutex> lock(kinect_titles_mutex);
+  if (requires_kinect) kinect_titles.insert(UpperTitle(title_id));
+  else kinect_titles.erase(UpperTitle(title_id));
+}
+inline bool KinectTitle(const std::string& title_id) {
+  std::lock_guard<std::mutex> lock(kinect_titles_mutex);
+  return kinect_titles.count(UpperTitle(title_id)) != 0;
+}
+// Why Automatic starts a game at 1x: the Kinect rule before the compiled-in list; null: 2x.
+inline const char* AutomaticOneXReason(const std::string& title_id) {
+  if (KinectTitle(title_id)) return "Kinect title";
+  if (AutomaticStartsAtOneX(title_id)) return "compiled-in list";
+  return nullptr;
+}
+// The camera classes of the Kinect library's passes (fix 162a's, from fix 161's owners).
+inline constexpr const char* kKinectCameraClasses = "80x1 160x1 320x1";
 // The draw_scale choice a game runs with: 2x (1) becomes 1x (0) for those games.
 inline int ChoiceFor(int choice, const std::string& title_id) {
   return choice == 1 && TwoXUnfit(title_id) ? 0 : choice;
@@ -423,6 +458,8 @@ inline std::vector<NativeClass> CompiledNativeClasses(const std::string& title_i
   // 1.0.6-work-fix156q2 and the same render targets, down to the small passes at EDRAM bases 2 to 16
   // and 360 to 408, so they come from the Kinect library every Kinect title links, not one engine.
   if (id == "4D4A07F0") return ParseNativeClasses("80x1 160x1 320x1");
+  // Fix 162f: any other Kinect title gets the Kinect library's camera classes.
+  if (KinectTitle(id)) return ParseNativeClasses(kKinectCameraClasses);
   return {};
 }
