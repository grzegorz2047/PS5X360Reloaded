+// SPDX-License-Identifier: MIT
+// Fix 93b: a message while a game is left. Closing a game (the guide's "Close the game and
+// return to the menu", after a crash of the game too), exiting the emulator, or a game starting
+// another of its executables (a title switch, fix 85's path) used to leave the screen black or
+// frozen for seconds: the Vulkan cache checkpoint (fix 07, up to 30 s), the network settings'
+// change and the online sessions' removal (fix 22, 3 s) run on the UI thread before the title
+// restarts with LoadExec. Now the screen says what is happening, with dots turning beside it, and
+// the UI thread keeps drawing while those steps run on another thread (WhilePainting). The last
+// frame drawn stays on screen through the restart.
+// Header-only, no Xenia headers: the host check (tools/check-leaving-notice.cpp) builds it as it is.
+#pragma once
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <thread>
+#include <utility>
+namespace xbox360ps5::leaving_notice {
+enum class Kind : int { none, menu, restart_game, closing };
+// What is shown, set from any thread (a title switch comes from a guest thread); the overlay
+// (canary_game_main.cpp's LeavingNoticeOverlay, which has the texts) reads it each frame.
+inline std::atomic<int> current{int(Kind::none)};
+inline void Show(Kind kind) { current.store(int(kind), std::memory_order_release); }
+inline Kind Current() { return Kind(current.load(std::memory_order_acquire)); }
+// The turning dots: `dots` around a circle, the brightest going round once a second, each one
+// after it a little dimmer. Between 0.15 and 1.
+inline float DotAlpha(int dot, int dots, double seconds) {
+  if (dots <= 0) return 0.0f;
+  const double head = std::fmod(seconds, 1.0) * dots;  // Where the brightest dot is.
+  double behind = head - double(dot);
+  behind -= std::floor(behind / dots) * dots;           // 0 .. dots: how far the dot trails it.
+  return float(0.15 + 0.85 * std::pow(1.0 - behind / dots, 2.0));
+}
+// Runs `task` on a thread of its own and calls `paint` (one frame) on the calling thread until
+// the task has ended, so the screen keeps moving; then returns. Every frame waits for the
+// display, so the loop sleeps only when painting returned at once.
+template <class Task, class Paint>
+void WhilePainting(Task&& task, Paint&& paint) {
+  std::atomic<bool> done{false};
+  std::thread worker([&task, &done] {
+    task();
+    done.store(true, std::memory_order_release);
+  });
+  while (!done.load(std::memory_order_acquire)) {
+    const auto frame = std::chrono::steady_clock::now();
+    paint();
+    const auto spent = std::chrono::steady_clock::now() - frame;
+    if (spent < std::chrono::milliseconds(16)) std::this_thread::sleep_for(std::chrono::milliseconds(16) - spent);
+  }
+  worker.join();
+}
+}  // namespace xbox360ps5::leaving_notice
