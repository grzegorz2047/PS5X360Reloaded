+// Fix 93b: what happens while a game is left, over everything, with dots turning beside it
+// (leaving_notice.hpp). Drawn only while leaving_notice::Current() says so.
+class LeavingNoticeOverlay final : public xe::ui::ImGuiDialog {
+ public:
+  explicit LeavingNoticeOverlay(xe::ui::ImGuiDrawer* drawer) : ImGuiDialog(drawer) {}
+ protected:
+  void OnDraw(ImGuiIO& io) override {
+    namespace notice = xbox360ps5::leaving_notice;
+    const notice::Kind kind = notice::Current();
+    if (kind == notice::Kind::none) return;
+    const char* text = kind == notice::Kind::restart_game ? Tr("Restarting the game...")
+                     : kind == notice::Kind::closing ? Tr("Closing the emulator...")
+                                                     : Tr("Returning to the menu...");
+    const char* wait = Tr("Please wait, this can take a few seconds.");
+    ImDrawList* list = ImGui::GetForegroundDrawList();
+    ImFont* font = ImGui::GetFont();
+    const float scale = io.DisplaySize.y / 1080.0f;
+    list->AddRectFilled(ImVec2(0, 0), io.DisplaySize, IM_COL32(6, 7, 10, 235));
+    const float big = 40 * scale, small = 24 * scale, radius = 26 * scale, gap = 30 * scale;
+    const ImVec2 size = font->CalcTextSizeA(big, 1e9f, 0.0f, text);
+    const float left = (io.DisplaySize.x - (2 * radius + gap + size.x)) / 2, middle = io.DisplaySize.y / 2;
+    const double seconds =
+        std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    for (int dot = 0; dot < 8; ++dot) {
+      const float angle = float(dot) * 6.2831853f / 8.0f - 1.5707963f;
+      const ImVec2 at(left + radius + std::cos(angle) * radius, middle + std::sin(angle) * radius);
+      list->AddCircleFilled(at, 5 * scale, IM_COL32(53, 208, 127, int(255 * notice::DotAlpha(dot, 8, seconds))), 12);
+    }
+    list->AddText(font, big, ImVec2(left + 2 * radius + gap, middle - size.y / 2), IM_COL32(243, 245, 248, 255), text);
+    const ImVec2 wait_size = font->CalcTextSizeA(small, 1e9f, 0.0f, wait);
+    list->AddText(font, small, ImVec2((io.DisplaySize.x - wait_size.x) / 2, middle + 64 * scale),
+                  IM_COL32(160, 168, 182, 255), wait);
+  }
+};
