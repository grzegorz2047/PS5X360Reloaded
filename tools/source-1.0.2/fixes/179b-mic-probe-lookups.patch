+inline std::string Nid(std::string_view symbol) {
+  static constexpr uint8_t kSalt[16] = {0x51, 0x8d, 0x64, 0xa6, 0x35, 0xde, 0xd8, 0xc1,
+                                        0xe6, 0xb0, 0x39, 0xb1, 0xc3, 0xe5, 0x52, 0x30};
+  static constexpr char kChars[] =
+      "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+-";
+  std::vector<uint8_t> input(symbol.begin(), symbol.end());
+  input.insert(input.end(), kSalt, kSalt + 16);
+  uint8_t digest[20];
+  sha1::Digest(input.data(), input.size(), digest);
+  uint8_t bytes[12] = {};
+  for (int i = 0; i < 8; ++i) bytes[i] = digest[7 - i];  // the first 8 bytes, reversed
+  std::string out;
+  for (int i = 0; out.size() < 11; i += 3) {
+    const uint32_t abc = uint32_t(bytes[i]) << 16 | uint32_t(bytes[i + 1]) << 8 | bytes[i + 2];
+    for (int shift : {18, 12, 6, 0})
+      if (out.size() < 11) out += kChars[(abc >> shift) & 0x3F];
+  }
+  return out;
+}
