+inline uint32_t Rotate(uint32_t x, int n) { return (x << n) | (x >> (32 - n)); }
+inline void Digest(const uint8_t* data, size_t size, uint8_t out[20]) {
+  uint32_t h[5] = {0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0};
+  std::vector<uint8_t> m(data, data + size);
+  const uint64_t bits = uint64_t(size) * 8;
+  m.push_back(0x80);
+  while (m.size() % 64 != 56) m.push_back(0);
+  for (int i = 7; i >= 0; --i) m.push_back(uint8_t(bits >> (8 * i)));
+  for (size_t chunk = 0; chunk < m.size(); chunk += 64) {
+    uint32_t w[80];
+    for (int i = 0; i < 16; ++i)
+      w[i] = uint32_t(m[chunk + 4 * i]) << 24 | uint32_t(m[chunk + 4 * i + 1]) << 16 |
+             uint32_t(m[chunk + 4 * i + 2]) << 8 | uint32_t(m[chunk + 4 * i + 3]);
+    for (int i = 16; i < 80; ++i) w[i] = Rotate(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1);
+    uint32_t a = h[0], b = h[1], c = h[2], e4 = h[3], e = h[4];
+    for (int i = 0; i < 80; ++i) {
+      uint32_t f, k;
+      if (i < 20) { f = (b & c) | (~b & e4); k = 0x5A827999; }
+      else if (i < 40) { f = b ^ c ^ e4; k = 0x6ED9EBA1; }
+      else if (i < 60) { f = (b & c) | (b & e4) | (c & e4); k = 0x8F1BBCDC; }
+      else { f = b ^ c ^ e4; k = 0xCA62C1D6; }
+      const uint32_t t = Rotate(a, 5) + f + e + k + w[i];
+      e = e4; e4 = c; c = Rotate(b, 30); b = a; a = t;
+    }
+    h[0] += a; h[1] += b; h[2] += c; h[3] += e4; h[4] += e;
+  }
+  for (int i = 0; i < 5; ++i)
+    for (int j = 0; j < 4; ++j) out[4 * i + j] = uint8_t(h[i] >> (24 - 8 * j));
+}
+}  // namespace sha1
