+inline bool LoadLibrary(Library* lib) {
+  // 1. The library by its name, as fix 179 did.
+  if (TryHandle(LoadModule("libSceAudioIn.sprx"), "loaded by name", lib)) return true;
+  // 2. Through the system module service, as the payload SDK loads system libraries.
+  using LoadInternalFn = int32_t (*)(uint32_t);
+  const int sysmodule = LoadModule("libSceSysmodule.sprx");
+  if (sysmodule >= 0) {
+    for (const bool by_nid : {false, true}) {
+      const std::string symbol =
+          by_nid ? Nid("sceSysmoduleLoadModuleInternal") : "sceSysmoduleLoadModuleInternal";
+      void* address = nullptr;
+      const int found = sceKernelDlsym(sysmodule, symbol.c_str(), &address);
+      XELOGW("Microphone probe (fix 179b): {} lookup gave {:08X}", symbol, unsigned(found));
+      if (found < 0 || !address) continue;
+      const int32_t loaded = reinterpret_cast<LoadInternalFn>(address)(kAudioInModule);
+      XELOGW("Microphone probe (fix 179b): sceSysmoduleLoadModuleInternal({:08X}) -> {:08X}",
+             kAudioInModule, uint32_t(loaded));
+      if (TryHandle(LoadModule("libSceAudioIn.sprx"), "after the system module service", lib))
+        return true;
+      break;
+    }
+  }
+  // 3. The full system path.
+  if (TryHandle(LoadModule("/system/common/lib/libSceAudioIn.sprx"), "loaded by path", lib))
+    return true;
+  // 4. Other audio libraries, in case the functions live there on this system.
+  for (const char* other : {"libSceAudioOut.sprx", "libSceAudioSystem.sprx"})
+    if (TryHandle(LoadModule(other), other, lib)) return true;
+  return false;
