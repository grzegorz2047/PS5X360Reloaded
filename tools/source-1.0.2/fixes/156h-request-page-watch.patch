diff --git a/include/xbox360ps5/page_watch.hpp b/include/xbox360ps5/page_watch.hpp
new file mode 100644
--- /dev/null
+++ b/include/xbox360ps5/page_watch.hpp
@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: MIT
+// Fix 156h (Kinect Sports Season Two, #63): which heap operation changes the page table under
+// a camera request. On 1.0.6-work-fix156g2 the darts load still failed 5 frame reads with
+// "request not mapped", and fix 156g's "not writable" line never came: the page holding the
+// NUI library's read requests (83507E78-83508100, in the title's image data) stopped being
+// even readable in the page table, while the title went on using the same page (its NUI state
+// at 83507D50), so the host memory stayed accessible. BaseHeap::Release clears a region's
+// table entries and leaves the host mapping (protect_on_release is off): a release of a
+// region over that page fits. The camera registers the pages of the requests it accepts; the
+// heap reports every allocation, protection, decommit and release that covers one of them
+// through `reporter` (set by the camera, which logs the guest thread and caller).
+// No Xenia headers here.
+#pragma once
+#include <atomic>
+#include <cstdint>
+
+namespace xbox360ps5::page_watch {
+
+constexpr uint32_t kSlots = 8;
+constexpr uint32_t kPageMask = 0xFFFF;  // the 64 KiB guest pages of the image heaps
+inline std::atomic<uint32_t> pages[kSlots] = {};
+inline std::atomic<uint32_t> watched{0};
+// op ("release", ...), first guest address, size, new protect, page table protect before.
+inline std::atomic<void (*)(const char*, uint32_t, uint32_t, uint32_t, uint32_t)> reporter{
+    nullptr};
+
+// Adds the 64 KiB page holding `address`; false when it was there or no slot is free.
+inline bool Watch(uint32_t address) {
+  const uint32_t page = address & ~kPageMask;
+  if (!page) return false;
+  for (auto& slot : pages)
+    if (slot.load() == page) return false;
+  for (auto& slot : pages) {
+    uint32_t empty = 0;
+    if (slot.compare_exchange_strong(empty, page)) {
+      watched.fetch_add(1);
+      return true;
+    }
+  }
+  return false;
+}
+
+// True when [address, address + size) covers a watched page.
+inline bool Hits(uint32_t address, uint64_t size) {
+  if (!watched.load() || !size) return false;
+  const uint64_t end = uint64_t(address) + size;
+  for (auto& slot : pages) {
+    const uint32_t page = slot.load();
+    if (page && uint64_t(page) + kPageMask + 1 > address && page < end) return true;
+  }
+  return false;
+}
+
+inline void Note(const char* op, uint32_t address, uint64_t size, uint32_t protect,
+                 uint32_t before) {
+  if (!Hits(address, size)) return;
+  if (auto* report = reporter.load())
+    report(op, address, uint32_t(size > 0xFFFFFFFFull ? 0xFFFFFFFFull : size), protect, before);
+}
+
+inline void Reset() {
+  for (auto& slot : pages) slot = 0;
+  watched = 0;
+}
+
+}  // namespace xbox360ps5::page_watch
