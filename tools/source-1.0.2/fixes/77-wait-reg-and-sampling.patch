+// Fix 77: how the GPU thread waits in WAIT_REG_MEM (a guest memory word or register reaching a
+// value): Tekken Tag Tournament 2 and DBZ spend most of their "rest of executing" there. Every
+// such packet is counted; one that does not match at once is timed from its first poll to its
+// match, split into the time in Xenia's sleeps (the packet's wait field >= 0x100, with vsync on)
+// and the rest (polling without a pause). By the wait field too: 0, 1-0xFF, 0x100-0x3FF, more.
+inline std::atomic<uint64_t> wait_reg_packets{0}, wait_reg_waits{0}, wait_reg_memory_waits{0}, wait_reg_polls{0},
+    wait_reg_sleeps{0}, wait_reg_spin_ticks{0}, wait_reg_sleep_ticks{0};
+inline std::array<std::atomic<uint64_t>, 4> wait_reg_by_field{};
+inline uint32_t WaitFieldBucket(uint32_t wait) { return wait == 0 ? 0 : wait < 0x100 ? 1 : wait < 0x400 ? 2 : 3; }
+class WaitRegTimer {
+ public:
+  WaitRegTimer(bool memory, uint32_t wait) : active_(OnGpuThread()), memory_(memory), wait_(wait) {
+    if (active_) AddOwn(wait_reg_packets, 1);
+  }
+  // Each poll that did not match.
+  void Missed() {
+    if (!active_) return;
+    if (!start_) start_ = Ticks();
+    ++polls_;
+  }
+  uint64_t BeforeSleep() const { return active_ ? Ticks() : 0; }
+  void AfterSleep(uint64_t before) {
+    if (!active_) return;
+    slept_ += Ticks() - before;
+    ++sleeps_;
+  }
+  ~WaitRegTimer() {
+    if (!active_ || !start_) return;
+    const uint64_t total = Ticks() - start_;
+    AddOwn(wait_reg_waits, 1);
+    if (memory_) AddOwn(wait_reg_memory_waits, 1);
+    AddOwn(wait_reg_polls, polls_);
+    AddOwn(wait_reg_sleeps, sleeps_);
+    AddOwn(wait_reg_sleep_ticks, slept_);
+    AddOwn(wait_reg_spin_ticks, total > slept_ ? total - slept_ : 0);
+    AddOwn(wait_reg_by_field[WaitFieldBucket(wait_)], 1);
+  }
+  WaitRegTimer(const WaitRegTimer&) = delete;
+  WaitRegTimer& operator=(const WaitRegTimer&) = delete;
+
+ private:
+  bool active_, memory_;
+  uint32_t wait_;
+  uint64_t start_ = 0, slept_ = 0, polls_ = 0, sleeps_ = 0;
+};
+// "Frame time WAIT_REG_MEM (GPU thread): n/s, w/s waited (m on memory), polling x ms/s, sleeping
+// y ms/s in s sleeps/s, p polls/s; waits by wait field: 0 a/s, 1-FF b/s, 100-3FF c/s, 400+ d/s"
+class WaitRegReporter {
+ public:
+  std::string Line(double seconds) {
+    const uint64_t ticks_now = Ticks(), ns_now = NowNs();
+    double ns_per_tick = last_ns_per_tick_ > 0 ? last_ns_per_tick_ : 1.0;
+    if (last_ticks_ && ticks_now > last_ticks_ && ns_now > last_ns_)
+      ns_per_tick = double(ns_now - last_ns_) / double(ticks_now - last_ticks_);
+    last_ns_per_tick_ = ns_per_tick;
+    last_ticks_ = ticks_now;
+    last_ns_ = ns_now;
+    const double s = seconds > 0 ? seconds : 1;
+    const std::atomic<uint64_t>* const counters[11] = {
+        &wait_reg_packets, &wait_reg_waits, &wait_reg_memory_waits, &wait_reg_spin_ticks, &wait_reg_sleep_ticks,
+        &wait_reg_sleeps, &wait_reg_polls, &wait_reg_by_field[0], &wait_reg_by_field[1], &wait_reg_by_field[2],
+        &wait_reg_by_field[3]};
+    double d[11];
+    for (int n = 0; n < 11; ++n) {
+      const uint64_t now = counters[n]->load(std::memory_order_relaxed);
+      d[n] = double(now - last_[n]);
+      last_[n] = now;
+    }
+    char text[384];
+    std::snprintf(text, sizeof(text),
+                  "Frame time WAIT_REG_MEM (GPU thread): %.0f/s, %.0f/s waited (%.0f on memory), polling %.1f ms/s, "
+                  "sleeping %.1f ms/s in %.0f sleeps/s, %.0f polls/s; waits by wait field: 0 %.0f/s, 1-FF %.0f/s, "
+                  "100-3FF %.0f/s, 400+ %.0f/s",
+                  d[0] / s, d[1] / s, d[2] / s, d[3] * ns_per_tick / 1e6 / s, d[4] * ns_per_tick / 1e6 / s, d[5] / s,
+                  d[6] / s, d[7] / s, d[8] / s, d[9] / s, d[10] / s);
+    return text;
+  }
+
+ private:
+  uint64_t last_[11] = {};
+  uint64_t last_ticks_ = 0, last_ns_ = 0;
+  double last_ns_per_tick_ = 0;
+};
