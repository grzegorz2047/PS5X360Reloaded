--- /dev/null
+++ b/.deps/xenia-canary/src/xenia/gpu/vulkan/texture_set_reuse.h
@@ -0,0 +1,92 @@
+/**
+ ******************************************************************************
+ * Xbox360PS5: fix 104, a draw's texture descriptor set reused when unchanged.*
+ ******************************************************************************
+ * VulkanCommandProcessor::UpdateBindings allocated, wrote
+ * (vkUpdateDescriptorSets) and bound a new descriptor set of textures and
+ * samplers for each shader stage of every draw ("TODO(Triang3l): Reuse texture
+ * and sampler bindings if not changed"). Bindings are the largest part of a
+ * draw's own time: Grand Theft Auto IV 177 ms/s of the GPU command thread in
+ * 196,000 draws a second (1.0.5-work-fix93e), Modern Warfare 2 156 ms/s.
+ *
+ * A stage's set written in the current frame is reused for a later draw of
+ * the same frame when that draw would write exactly the same descriptors: the
+ * same descriptor set layout, the same numbers of textures and samplers, the
+ * same image views (in the shader's binding order) and the same samplers.
+ * Transient sets are recycled only once their frame has completed on the GPU,
+ * so a set of the current frame is still alive. A handle is a descriptor's
+ * whole content only while its object lives: `epoch` changes whenever the
+ * texture cache may have destroyed an image view or a sampler (texture
+ * bindings reset: a texture destroyed, a new frame, the cache cleared; a
+ * sampler destroyed) or the transient pools were cleared, and a set written
+ * in another epoch is not reused.
+ ******************************************************************************
+ */
+
+#ifndef XENIA_GPU_VULKAN_TEXTURE_SET_REUSE_H_
+#define XENIA_GPU_VULKAN_TEXTURE_SET_REUSE_H_
+
+#include <cstdint>
+#include <vector>
+
+namespace xe {
+namespace gpu {
+namespace vulkan {
+namespace texture_set_reuse {
+
+// View and Sampler are VkImageView and VkSampler (any comparable handle).
+template <typename Layout, typename View, typename Sampler, typename Set>
+struct Written {
+  bool valid = false;
+  uint64_t frame = 0;
+  uint64_t epoch = 0;
+  Layout layout{};
+  std::vector<View> views;
+  std::vector<Sampler> samplers;
+  Set set{};
+
+  // Whether a draw that would write `views` and `samplers` (count of each) with
+  // `layout` in `frame` and `epoch` may bind `set` instead.
+  bool Matches(uint64_t frame_now, uint64_t epoch_now, Layout layout_now,
+               const View* views_now, uint32_t view_count,
+               const Sampler* samplers_now, uint32_t sampler_count) const {
+    if (!valid || frame != frame_now || epoch != epoch_now ||
+        layout != layout_now || views.size() != view_count ||
+        samplers.size() != sampler_count) {
+      return false;
+    }
+    for (uint32_t i = 0; i < view_count; ++i) {
+      if (views[i] != views_now[i]) {
+        return false;
+      }
+    }
+    for (uint32_t i = 0; i < sampler_count; ++i) {
+      if (samplers[i] != samplers_now[i]) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  void Remember(uint64_t frame_now, uint64_t epoch_now, Layout layout_now,
+                const View* views_now, uint32_t view_count,
+                const Sampler* samplers_now, uint32_t sampler_count,
+                Set set_now) {
+    valid = true;
+    frame = frame_now;
+    epoch = epoch_now;
+    layout = layout_now;
+    views.assign(views_now, views_now + view_count);
+    samplers.assign(samplers_now, samplers_now + sampler_count);
+    set = set_now;
+  }
+
+  void Forget() { valid = false; }
+};
+
+}  // namespace texture_set_reuse
+}  // namespace vulkan
+}  // namespace gpu
+}  // namespace xe
+
+#endif  // XENIA_GPU_VULKAN_TEXTURE_SET_REUSE_H_
