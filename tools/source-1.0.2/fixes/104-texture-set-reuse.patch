diff --git a/include/xbox360ps5/frame_cost.hpp b/include/xbox360ps5/frame_cost.hpp
--- a/include/xbox360ps5/frame_cost.hpp
+++ b/include/xbox360ps5/frame_cost.hpp
@@ -1131,5 +1131,33 @@ class Reporter {
   Snapshot last_{};  // the first line covers the time since the game started
 };
 
+// Fix 104: the draws' texture descriptor sets, reused (the same descriptors as the stage's set
+// written last in the frame) or written, counted on the GPU thread; "Performance texture sets
+// (GPU thread, fix 104): n/s reused, m/s written (x% reused)" since its previous line.
+inline std::atomic<uint64_t> texture_sets_reused{0}, texture_sets_written{0};
+inline void CountTextureSets(uint32_t reused, uint32_t written) {
+  if (!OnGpuThread()) return;
+  if (reused) AddOwn(texture_sets_reused, reused);
+  if (written) AddOwn(texture_sets_written, written);
+}
+class TextureSetReporter {
+ public:
+  std::string Line(double seconds) {
+    const double s = seconds > 0 ? seconds : 1;
+    const uint64_t reused = texture_sets_reused.load(std::memory_order_relaxed);
+    const uint64_t written = texture_sets_written.load(std::memory_order_relaxed);
+    const uint64_t dr = reused - last_reused_, dw = written - last_written_;
+    last_reused_ = reused;
+    last_written_ = written;
+    char line[160];
+    std::snprintf(line, sizeof(line), "Performance texture sets (GPU thread, fix 104): %.0f/s reused, %.0f/s written (%.0f%% reused)",
+                  double(dr) / s, double(dw) / s, dr + dw ? 100.0 * double(dr) / double(dr + dw) : 0.0);
+    return line;
+  }
+
+ private:
+  uint64_t last_reused_ = 0, last_written_ = 0;
+};
+
 }  // namespace frame_cost
 }  // namespace xbox360ps5
