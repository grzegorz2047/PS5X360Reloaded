+// Fix 134e: the games that get mode 1 while gpu_async_submit is at its default (0) and
+// async-submit.txt does not say otherwise. Console runs in mode 1 (1.0.5-work-fix134b to 134d):
+// Grand Theft Auto IV (545407F2) 43 to 45.5 frames a second, 45-55 in 8 windows, 13 minutes
+// clean; Red Dead Redemption (5454082B) a minimum of 30 instead of 28 at its 30, the GPU
+// thread's own work from 945 down to 780 ms/s, 17 minutes clean. Everything else: 0, as before.
+inline uint32_t PresetMode(uint32_t title_id) {
+  switch (title_id) {
+    case 0x545407F2:  // Grand Theft Auto IV
+    case 0x5454082B:  // Red Dead Redemption
+      return kWorker;
+    default:
+      return kOff;
+  }
+}
+// The mode in force: the cvar's when it is not 0, else the game's preset; the file's
+// "mode" line wins over both (Parse, after this). `from_preset` says which.
+inline uint32_t ModeFor(uint32_t cvar_mode, uint32_t title_id, bool* from_preset) {
+  const uint32_t mode = cvar_mode < kModes ? cvar_mode : kModes - 1;
+  if (mode != kOff) {
+    *from_preset = false;
+    return mode;
+  }
+  const uint32_t preset = PresetMode(title_id);
+  *from_preset = preset != kOff;
+  return preset;
+}
+
 // At the start of a draw: whether the submission ends here, as a chunk.
 inline bool ChunkDue(uint32_t mode, size_t stream_bytes, uint32_t chunk_kib) {
   return mode != kOff && chunk_kib && stream_bytes >= size_t(chunk_kib) * 1024;
