-  uint32_t ret = 0, r31 = 0, first_word = 0;
-  bool readable = false;
+  uint32_t ret = 0, r31 = 0;
+  uint32_t words[kObjectWords] = {};
+  int readable = 0;  // how many of words were read
 };
 template <typename Read>
 inline int BackChainR31(uint32_t sp, Read read, SavedR31* out, int count) {
@@ -105,7 +110,10 @@ inline int BackChainR31(uint32_t sp, Read read, SavedR31* out, int count) {
