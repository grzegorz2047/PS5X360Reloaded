-// One allocation; returns the raw line written for it ("" when none: small and successful).
+// Fix 76: the stall capture's log of every system call (log level 3 for 3 s) takes at most
+// kCaptureDebugLines debug lines. On the draft, Fable II's two idle threads asked for the time
+// about 20,000 times a second: 33,000 lines in under 2 s, which the log writer took over a minute
+// to write while the game's own log lines waited for room. -1: no capture running, debug lines
+// go by the log level alone (the "detailed logs" setting).
+inline constexpr int32_t kCaptureDebugLines = 1000;
+inline std::atomic<int32_t> capture_debug_lines{-1};
+// Whether a debug line may still go to the log (the check before a line is formatted).
+inline bool CaptureDebugLeft() { return capture_debug_lines.load(std::memory_order_relaxed) != 0; }
+// One debug line going to the log: false once the capture's lines are spent; the last one taken
+// writes a raw line saying so.
+inline bool TakeCaptureDebugLine() {
+  int32_t left = capture_debug_lines.load(std::memory_order_relaxed);
+  while (left > 0 && !capture_debug_lines.compare_exchange_weak(left, left - 1, std::memory_order_relaxed)) {
+  }
+  if (left == 1)
+    Raw(Format("STALL capture: %d system-call lines logged, no more until the next capture", kCaptureDebugLines));
+  return left != 0;
+}
