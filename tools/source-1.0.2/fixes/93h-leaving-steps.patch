 inline std::atomic<int> current{int(Kind::none)};
 inline void Show(Kind kind) { current.store(int(kind), std::memory_order_release); }
 inline Kind Current() { return Kind(current.load(std::memory_order_acquire)); }
+// Fix 93h: what is being done, said under the notice in plain words (the overlay has the texts):
+// saving the shaders (the cache checkpoint), writing to the drive (the flush), signing out of
+// online play, saving the bug report's logs, starting the menu or the game (the next process).
+// None: "Please wait, this can take a few seconds."
+enum class Step : int { none, shaders, writing, online, bug_logs, starting };
+inline std::atomic<int> step{int(Step::none)};
+inline void ShowStep(Step now) { step.store(int(now), std::memory_order_release); }
+inline Step CurrentStep() { return Step(step.load(std::memory_order_acquire)); }
