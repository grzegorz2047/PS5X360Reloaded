+inline constexpr int64_t kTrimIntervalMs = 10000;
+inline bool ShouldTrim(const Counters& c, int64_t direct_free, int64_t now_ms) {
+  if (c.scale.load(std::memory_order_relaxed) <= 1) return false;
+  if (direct_free < 0 || uint64_t(direct_free) >= kRenderTargetFloor) return false;
+  if (now_ms - c.last_trim_ms.load(std::memory_order_relaxed) < kTrimIntervalMs) return false;
+  const uint64_t made = c.rt_scaled.load(std::memory_order_relaxed) + c.rt_native.load(std::memory_order_relaxed);
+  return made != c.made_at_trim.load(std::memory_order_relaxed);
+}
+inline void NoteTrim(Counters& c, int64_t now_ms, uint64_t destroyed) {
