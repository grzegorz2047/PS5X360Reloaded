+// Fix 93e: paints frames until `done` or `limit` has passed; whether it was done. For work that
+// runs on a thread of its own and may be left behind (the title restarts anyway).
+template <class Paint>
+bool PaintUntil(const std::atomic<bool>& done, std::chrono::milliseconds limit, Paint&& paint) {
+  const auto until = std::chrono::steady_clock::now() + limit;
+  while (!done.load(std::memory_order_acquire)) {
+    if (std::chrono::steady_clock::now() >= until) return false;
+    const auto frame = std::chrono::steady_clock::now();
+    paint();
+    const auto spent = std::chrono::steady_clock::now() - frame;
+    if (spent < std::chrono::milliseconds(16)) std::this_thread::sleep_for(std::chrono::milliseconds(16) - spent);
+  }
+  return true;
+}
