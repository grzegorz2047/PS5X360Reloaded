+std::string logging::TakeRecentLines() {
+  std::string lines;
+  bool cut = false;
+  {
+    xe::threading::SuspensionDeferral deferral;  // fix 45: as in RememberLine
+    std::lock_guard<std::mutex> lock(recent_mutex_);
+    keep_recent_lines_ = false;
+    if (!recent_lines_) {
+      return lines;
+    }
+    cut = recent_wrapped_;
+    if (recent_wrapped_) {
+      lines.assign(recent_lines_.get() + recent_end_,
+                   kRecentBytes - recent_end_);
+    }
+    lines.append(recent_lines_.get(), recent_end_);
+    recent_end_ = 0;
+    recent_wrapped_ = false;
+  }
+  if (cut) {
+    // The oldest line lost its beginning when the memory came round.
+    const size_t first = lines.find('\n');
+    lines.erase(0, first == std::string::npos ? lines.size() : first + 1);
+  }
+  return lines;
+}
