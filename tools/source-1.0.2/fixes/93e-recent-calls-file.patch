+// Fix 93e: the game's last system calls, in a file of their own beside the game log:
+// "recent-calls-<title ID>-<YYYYMMDD-HHMMSS>-UTC.txt".
+inline std::string RecentCallsName(uint32_t title_id, int64_t now) {
+  std::tm utc{};
+  char name[64] = "recent-calls.txt";
+  if (log_zip::UtcTime(std::time_t(now), &utc))
+    std::snprintf(name, sizeof(name), "recent-calls-%08X-%04d%02d%02d-%02d%02d%02d-UTC.txt", title_id, utc.tm_year + 1900,
+                  utc.tm_mon + 1, utc.tm_mday, utc.tm_hour, utc.tm_min, utc.tm_sec);
+  return name;
+}
+// Writes `text` to `file` in one go on a thread of its own and returns at once; `done` is set
+// when the file is closed (written or not). The thread owns what it uses: the caller may stop
+// waiting for it (the title restarts) without harm.
+struct Writing {
+  std::atomic<bool> done{false};
+  std::atomic<bool> ok{false};
+};
+inline std::shared_ptr<Writing> StartWriting(const fs::path& file, std::shared_ptr<const std::string> text) {
+  auto writing = std::make_shared<Writing>();
+  std::thread([writing, file, text] {
+    bool ok = false;
+    if (std::FILE* output = std::fopen(file.string().c_str(), "wb")) {
+      ok = text->empty() || std::fwrite(text->data(), 1, text->size(), output) == text->size();
+      ok = std::fclose(output) == 0 && ok;
+    }
+    writing->ok.store(ok, std::memory_order_release);
+    writing->done.store(true, std::memory_order_release);
+  }).detach();
+  return writing;
+}
