diff --git a/include/xbox360ps5/kinect_diag.hpp b/include/xbox360ps5/kinect_diag.hpp
new file mode 100644
index 0000000..1e32a12
--- /dev/null
+++ b/include/xbox360ps5/kinect_diag.hpp
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: MIT
+// Fix 108 (Kinect Sports, issue 15): what a Kinect game asks the system for after "Pick main
+// player". On 1.0.5-work-fix106 the body stayed tracked the whole run, the player was picked by
+// hovering, and then the hand cursors went and nothing followed, with nothing in the log at its
+// usual level: the stall is the game's, after a signed-in profile is chosen.
+//
+// While a Kinect title runs (from the moment it starts its NUI library, xboxkrnl_pscam.cc):
+//  - the first call of each avatar, user, profile, content or NUI export is logged with its
+//    caller and first arguments (xenia/kernel/util/shim_utils.h, the exports' trampoline);
+//  - every guest thread that calls the kernel logs where it is, at most once per 10 s each (its
+//    current call and the return addresses along its stack's back chain), from its own call, so
+//    no thread reads another's state;
+//  - an empty file name (xboxkrnl_io.cc's failed-path report) also gives 8 callers and the bytes
+//    around the name's buffer, which say what the game built the name from.
+#pragma once
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <unordered_set>
+
+namespace xbox360ps5::kinect_diag {
+
+inline std::atomic<bool> enabled{false};
+constexpr int64_t kSnapshotMs = 10000;
+constexpr size_t kMaxNames = 256;
+constexpr int kFrames = 8;
+
+// The exports whose first call is logged.
+inline bool Watched(const char* name) {
+  if (!name) return false;
+  static constexpr const char* kPrefixes[] = {"XamAvatar", "XamUser", "XamProfile", "XamContent",
+                                              "XContent",  "XamNui",  "XUser",      "XamShow"};
+  for (const char* prefix : kPrefixes)
+    if (std::strncmp(name, prefix, std::strlen(prefix)) == 0) return true;
+  return false;
+}
+
+// True the first time `name` is seen (at most kMaxNames names).
+class FirstCalls {
+ public:
+  bool First(const char* name) {
+    std::lock_guard lock(mutex_);
+    if (seen_.size() >= kMaxNames) return false;
+    return seen_.insert(name).second;
+  }
+  void Reset() {
+    std::lock_guard lock(mutex_);
+    seen_.clear();
+  }
+
+ private:
+  std::mutex mutex_;
+  std::unordered_set<std::string> seen_;
+};
+inline FirstCalls first_calls;
+
+// The calling thread's snapshot is due (once per kSnapshotMs per thread; the first call of a
+// thread is due at once). `last` is the thread's own slot.
+inline bool SnapshotDue(int64_t now_ms, int64_t& last) {
+  if (last && now_ms - last < kSnapshotMs) return false;
+  last = now_ms ? now_ms : 1;
+  return true;
+}
+
+// The return addresses: `lr`, then the saved LR of each frame along the back chain from `sp`
+// (the word at sp is the caller's sp; its saved LR is 8 bytes below that, as the game's code
+// lays frames out). read(address, &value) reads a big-endian guest word, false when it cannot.
+// Stops at a chain that does not go up by less than 1 MiB. Returns how many were found.
+template <typename Read>
+inline int BackChain(uint32_t lr, uint32_t sp, Read read, uint32_t* out, int count) {
+  int n = 0;
+  if (count <= 0) return 0;
+  out[n++] = lr;
+  while (n < count && sp) {
+    uint32_t back = 0, saved = 0;
+    if (!read(sp, &back) || back <= sp || back - sp > 0x100000) break;
+    if (!read(back - 8, &saved)) break;
+    out[n++] = saved;
+    sp = back;
+  }
+  return n;
+}
+
+inline std::string Chain(const uint32_t* callers, int n) {
+  std::string out;
+  char item[16];
+  for (int i = 0; i < n; ++i) {
+    std::snprintf(item, sizeof(item), i ? " < %08X" : "%08X", callers[i]);
+    out += item;
+  }
+  return out;
+}
+
+// "XX XX ..." for `size` bytes (a dump of guest memory around a pointer).
+inline std::string Hex(const uint8_t* bytes, size_t size) {
+  std::string out;
+  char item[4];
+  for (size_t i = 0; i < size; ++i) {
+    std::snprintf(item, sizeof(item), i ? " %02X" : "%02X", bytes[i]);
+    out += item;
+  }
+  return out;
+}
+
+}  // namespace xbox360ps5::kinect_diag
