+// Fix 108 (xbox360ps5/kinect_diag.hpp): a guest word, read only where the memory says it can be
+// (a back chain that leaves the stack ends the walk instead of faulting).
+inline bool KinectDiagRead(uint32_t address, uint32_t* value) {
+  if (!address || (address & 3)) return false;
+  Memory* memory = kernel_state()->memory();
+  BaseHeap* heap = memory->LookupHeap(address);
+  uint32_t protection = 0;
+  if (!heap || !heap->QueryProtect(address, &protection) || !(protection & kMemoryProtectRead))
+    return false;
+  *value = xe::load_and_swap<uint32_t>(memory->TranslateVirtual(address));
+  return true;
+}
+// Fix 108: from every export's trampoline while a Kinect title runs: the first call of each
+// avatar, user, profile, content and NUI export, and this thread's place every 10 s.
+inline void KinectDiagCall(const char* name, PPCContext* context) {
+  namespace kd = xbox360ps5::kinect_diag;
+  if (kd::Watched(name) && kd::first_calls.First(name)) {
+    uint32_t callers[3];
+    const int n = kd::BackChain(uint32_t(context->lr), uint32_t(context->r[1]), KinectDiagRead, callers, 3);
+    XELOGW("Kinect diag: first call of {} from {} (r3 {:08X} r4 {:08X} r5 {:08X} r6 {:08X}), thread {} (fix 108)",
+           name, kd::Chain(callers, n), uint32_t(context->r[3]), uint32_t(context->r[4]),
+           uint32_t(context->r[5]), uint32_t(context->r[6]), context->thread_id);
+  }
+  thread_local int64_t last_snapshot = 0;
+  const int64_t now_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                             std::chrono::steady_clock::now().time_since_epoch())
+                             .count();
+  if (kd::SnapshotDue(now_ms, last_snapshot)) {
+    uint32_t callers[kd::kFrames];
+    const int n = kd::BackChain(uint32_t(context->lr), uint32_t(context->r[1]), KinectDiagRead, callers,
+                                kd::kFrames);
+    XELOGW("Kinect diag: thread {} calls {} from {} (fix 108)", context->thread_id, name, kd::Chain(callers, n));
+  }
+}
+#endif
