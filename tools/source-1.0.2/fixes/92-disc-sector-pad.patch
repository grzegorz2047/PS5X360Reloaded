@@ -39,6 +43,26 @@ X_STATUS DiscImageFile::ReadSync(std::span<uint8_t> buffer, size_t byte_offset,
   if (!entry_->mmap()->ReadAt(real_offset, buffer.data(), real_length)) {
     return X_STATUS_END_OF_FILE;
   }
+  // Xbox360PS5 fix 92: a read that stops at the file's end inside a 2 KiB disc sector also gets
+  // the rest of that sector, as a console's sector read (xbox360ps5/disc_sector_pad.hpp): the
