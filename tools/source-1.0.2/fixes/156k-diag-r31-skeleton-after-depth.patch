+// Fix 156k (Kinect Sports Season Two, #63): what each function along the chain is working on.
+// A callee saves the r31 of its caller 0x10 bytes below the caller's stack pointer (the game's
+// `std r31,-0x10(r1)` before its `stwu`, and the __savegprlr helpers): for each saved LR the
+// walk finds (a return address into function F), the word at back - 0x10 is F's r31, and,
+// when that is a readable guest address, its first word (an object's vtable). Season Two's
+// darts load waits in a loop that keeps its load operation in r31 (82620560: `while
+// (!op->vt[0x14]()) pump();`); this names the operation. Same walk and stops as BackChain.
+struct SavedR31 {
+  uint32_t ret = 0, r31 = 0, first_word = 0;
+  bool readable = false;
+};
+template <typename Read>
+inline int BackChainR31(uint32_t sp, Read read, SavedR31* out, int count) {
+  int n = 0;
+  while (n < count && sp) {
+    uint32_t back = 0, saved = 0;
+    if (!read(sp, &back) || back <= sp || back - sp > 0x100000) break;
+    if (!read(back - 8, &saved)) break;
+    SavedR31 item;
+    item.ret = saved;
+    if (read(back - 0x10, &item.r31)) item.readable = read(item.r31, &item.first_word);
+    out[n++] = item;
+    sp = back;
+  }
+  return n;
+}
+inline std::string ChainR31(const SavedR31* items, int n) {
+  std::string out;
+  char text[48];
+  for (int i = 0; i < n; ++i) {
+    if (items[i].readable)
+      std::snprintf(text, sizeof(text), "%s%08X r31 %08X [%08X]", i ? " < " : "", items[i].ret,
+                    items[i].r31, items[i].first_word);
+    else
+      std::snprintf(text, sizeof(text), "%s%08X r31 %08X", i ? " < " : "", items[i].ret,
+                    items[i].r31);
+    out += text;
+  }
+  return out;
+}
