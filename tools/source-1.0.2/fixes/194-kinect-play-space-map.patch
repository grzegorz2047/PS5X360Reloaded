--- /dev/null
+++ b/include/xbox360ps5/play_space_map.hpp
@@ -0,0 +1,208 @@
+// SPDX-License-Identifier: MIT
+// Fix 194: the play space as a Kinect game sees it, for the motion panel over the game.
+//
+// Nike+ Kinect Training asks the player to "MOVE ONTO THE MARKER". With a phone as the Kinect the
+// player could not tell where the game thought they stood: the panel showed the phone page's own
+// distance (3.8 m, its upper limit, while the player stood about 2-2.5 m away) and a front view
+// only. The game gets neither: body_scale.hpp re-centres the hips' depth on the bridge's 2.5 m,
+// and virtual_skeleton.hpp's SkeletonSpace turns the result into sensor metres.
+//
+// So the panel now shows, from the frame the game gets (the phone's pose after NormalizedSnapshot,
+// and the emergency pose while it is on, motion_emergency.hpp):
+//  - a top-down map: the sensor's field of view (57 degrees across, 0.8-4 m deep, SkeletonSpace's
+//    range), the usual Kinect sweet spot (1.8-2.5 m, centred) and the player as a dot at the hip
+//    centre's sensor x and z;
+//  - short guidance from that place: step back or closer, move left or right, show the whole body,
+//    or that the camera sees the body lying sideways (a phone turned with its picture not turned);
+//  - the front view, upright as the game gets it (sensor x and y), beside the map.
+// Only the drawing reads this; the game's frames do not change.
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <vector>
+
+#include "xbox360ps5/kinect_hand_view.hpp"  // PositionHint: the whole body seen
+#include "xbox360ps5/motion_input.hpp"
+#include "xbox360ps5/virtual_skeleton.hpp"  // SkeletonSpace, kSensorHeight
+
+namespace xbox360ps5::motion::play_space {
+
+// The field of view: Kinect's 57 degrees across, and the depth SkeletonSpace keeps (0.8-4 m).
+constexpr float kHalfFovDegrees = 28.5f;
+constexpr float kNearMetres = 0.8f, kFarMetres = 4.0f;
+// The sweet spot most Kinect games ask for: 1.8-2.5 m from the sensor, centred.
+constexpr float kSweetNear = 1.8f, kSweetFar = 2.5f, kSweetHalfWidth = 0.5f;
+// Guidance: a depth hint once the hips are this far outside the sweet spot's depth (the bridge
+// re-centres the hips on 2.5 m, which must not read as "step closer"); a side hint past
+// kSideMetres from the centre, or nearer than kEdgeMargin (half a body) to the view's edge.
+constexpr float kDepthSlack = 0.1f;
+constexpr float kSideMetres = 0.5f, kEdgeMargin = 0.3f;
+// The torso (hip centre to shoulder centre) further than this from upright: lying sideways.
+constexpr float kSidewaysDegrees = 50.0f;
+// The map shows x within +-kMapHalfWidth (the wedge is wider further back, and is cut there).
+constexpr float kMapHalfWidth = 1.5f, kMapDepth = 4.25f;
+constexpr int kHipCentre = 0, kSpine = 1, kShoulderCentre = 2;
+
+inline float HalfWidthAt(float z) { return z * std::tan(kHalfFovDegrees * 3.14159265f / 180.0f); }
+
+// Where the game sees the body: the hip centre in sensor metres, as WriteSkeletonFrame writes it
+// (+x the player's right, which is the sensor's left; z away from the sensor).
+struct Place {
+  bool body = false;        // a tracked body with a placed hip centre (or spine)
+  float x = 0, z = 0;       // sensor metres
+  bool hips_seen = false;   // the hip centre tracked (confidence >= 0.5), not inferred
+  bool whole_body = false;  // head, hands and feet seen (PositionHint)
+  float tilt_degrees = 0;   // the torso from upright (0 upright, 90 lying, 180 upside down)
+  bool tilt_known = false;
+};
+
+inline Place PlaceOf(const Frame& guest) {
+  Place place;
+  if (!guest.tracked) return place;
+  // WriteSkeletonFrame leaves a joint of confidence 0 at the zeroed position: no place from it.
+  const int at = guest.joints[kHipCentre].confidence > 0 ? kHipCentre
+               : guest.joints[kSpine].confidence > 0     ? kSpine
+                                                         : -1;
+  if (at < 0) return place;
+  float y = 0;
+  SkeletonSpace(guest.joints[size_t(at)], place.x, y, place.z);
+  place.body = true;
+  place.hips_seen = at == kHipCentre && guest.joints[kHipCentre].confidence >= 0.5f;
+  place.whole_body = PositionHint(guest) != Positioning::kWholeBody;
+  const Joint& hip = guest.joints[size_t(at)];
+  const Joint& shoulders = guest.joints[kShoulderCentre];
+  if (shoulders.confidence > 0) {
+    float hx, hy, hz, sx, sy, sz;
+    SkeletonSpace(hip, hx, hy, hz);
+    SkeletonSpace(shoulders, sx, sy, sz);
+    const float dx = sx - hx, dy = sy - hy;
+    if (std::hypot(dx, dy) > 0.05f) {
+      place.tilt_degrees = std::atan2(std::fabs(dx), dy) * 180.0f / 3.14159265f;
+      place.tilt_known = true;
+    }
+  }
+  return place;
+}
+
+// What to tell the player, most important first.
+enum Hint : uint32_t {
+  kNone = 0,
+  kSideways = 1u << 0,    // the picture is turned: only this one is given
+  kWholeBody = 1u << 1,
+  kStepBack = 1u << 2,    // nearer than the sweet spot
+  kStepCloser = 1u << 3,  // further than the sweet spot
+  kMoveLeft = 1u << 4,    // too far to the player's right
+  kMoveRight = 1u << 5,   // too far to the player's left
+};
+struct Guidance {
+  uint32_t hints = kNone;
+  bool in_sweet_spot = false;  // the hips inside the marked sweet spot
+  bool good = false;           // a body, no hint: the player stands where games want them
+};
+
+inline bool InSweetSpot(float x, float z) {
+  return z >= kSweetNear && z <= kSweetFar && std::fabs(x) <= kSweetHalfWidth;
+}
+
+inline Guidance Guide(const Place& place) {
+  Guidance guide;
+  if (!place.body) return guide;
+  guide.in_sweet_spot = InSweetSpot(place.x, place.z);
+  if (place.tilt_known && place.tilt_degrees > kSidewaysDegrees) {
+    guide.hints = kSideways;
+    return guide;
+  }
+  if (!place.whole_body) guide.hints |= kWholeBody;
+  if (place.z < kSweetNear - kDepthSlack) guide.hints |= kStepBack;
+  else if (place.z > kSweetFar + kDepthSlack) guide.hints |= kStepCloser;
+  const float side = std::max(0.1f, std::min(kSideMetres, HalfWidthAt(place.z) - kEdgeMargin));
+  if (place.x > side) guide.hints |= kMoveLeft;
+  else if (place.x < -side) guide.hints |= kMoveRight;
+  guide.good = guide.hints == kNone;
+  return guide;
+}
+
+// The English keys of the hints, in order (the panel translates each with Tr and joins them).
+inline std::vector<const char*> HintKeys(uint32_t hints) {
+  std::vector<const char*> keys;
+  if (hints & kSideways) keys.push_back("The camera sees you sideways: stand the phone upright");
+  if (hints & kWholeBody) keys.push_back("Show your whole body to the camera");
+  if (hints & kStepBack) keys.push_back("Step back");
+  if (hints & kStepCloser) keys.push_back("Step closer");
+  if (hints & kMoveLeft) keys.push_back("Move left");
+  if (hints & kMoveRight) keys.push_back("Move right");
+  return keys;
+}
+inline constexpr const char* kGoodSpot = "Good spot";
+
+// Panel geometry, in 1080p units (the overlay scales by the screen's height). The motion panel is
+// x 1550-1900 (+ shift) by y 100-640; the skeleton area starts at y 185 and ends at 565 while the
+// hand-reach bars show under it, else at 640 (phone_qr_panel.hpp).
+struct Point { float x = 0, y = 0; };
+
+// The front view: the game's skeleton, upright, centred on the hip centre (the map has the place).
+struct FrontView {
+  float centre_x = 1725, floor_y = 522, pixels_per_metre = 130;
+  float left = 1550, right = 1900;  // its clip, sideways
+};
+// Without the map, the old place and size (fix 63: centre 1725, 130 per metre, the hips at y 405);
+// with it, the left half.
+inline FrontView FrontFor(bool map_shown, float shift) {
+  if (!map_shown) return {1725 + shift, 405 + (kHipHeight) * 130, 130, 1550 + shift, 1900 + shift};
+  return {1637 + shift, 512, 100, 1550 + shift, 1724 + shift};
+}
+// A joint of the game's skeleton in the front view: sensor y up from the floor (the floor is
+// kSensorHeight below the sensor), sensor x from the hip centre, the player's right on the right
+// (a mirror, as fix 63's panel: PanelMirrorX).
+inline Point FrontPoint(const FrontView& view, const Joint& joint, float hip_x) {
+  float x, y, z;
+  SkeletonSpace(joint, x, y, z);
+  return {view.centre_x + (x - hip_x) * view.pixels_per_metre,
+          view.floor_y - (y + kSensorHeight) * view.pixels_per_metre};
+}
+
+// The map: the right half of the panel, above the foot line (two lines of guidance).
+struct MapView {
+  float left = 0, top = 0, right = 0, bottom = 0;
+  float centre_x = 0, sensor_y = 0, pixels_per_metre = 0;
+};
+constexpr float kMapLeft = 1730, kMapRight = 1892, kMapTop = 190, kMapFootRoom = 52;
+inline MapView MapFor(float shift, bool bars_shown) {
+  MapView map;
+  map.left = kMapLeft + shift;
+  map.right = kMapRight + shift;
+  map.top = kMapTop;
+  const float bottom = (bars_shown ? 565.0f : 640.0f) - kMapFootRoom;
+  map.pixels_per_metre = std::min((map.right - map.left) / (2 * kMapHalfWidth), (bottom - map.top) / kMapDepth);
+  map.bottom = map.top + kMapDepth * map.pixels_per_metre;
+  map.centre_x = (map.left + map.right) / 2;
+  map.sensor_y = map.top + 0.1f * map.pixels_per_metre;
+  return map;
+}
+// A floor place (sensor x, z) on the map: the sensor at the top, the player's right on the right
+// (as the player sees the room from above with the TV ahead of them).
+inline Point MapPoint(const MapView& map, float x, float z) {
+  return {map.centre_x + x * map.pixels_per_metre, map.sensor_y + z * map.pixels_per_metre};
+}
+// The dot: kept inside the map (`outside` says it was moved in).
+inline Point DotPoint(const MapView& map, const Place& place, bool* outside = nullptr) {
+  const Point p = MapPoint(map, place.x, place.z);
+  const Point in = {std::clamp(p.x, map.left + 6, map.right - 6), std::clamp(p.y, map.top + 6, map.bottom - 6)};
+  if (outside) *outside = in.x != p.x || in.y != p.y;
+  return in;
+}
+// The field of view as a convex outline (near left, far left, far right, near right) and the sweet
+// spot as a rectangle (near left, far right); the overlay clips both to the map.
+struct Quad { Point corner[4]; };
+inline Quad ViewQuad(const MapView& map) {
+  const float near_w = HalfWidthAt(kNearMetres), far_w = HalfWidthAt(kFarMetres);
+  return {{MapPoint(map, -near_w, kNearMetres), MapPoint(map, -far_w, kFarMetres),
+           MapPoint(map, far_w, kFarMetres), MapPoint(map, near_w, kNearMetres)}};
+}
+inline Quad SweetQuad(const MapView& map) {
+  return {{MapPoint(map, -kSweetHalfWidth, kSweetNear), MapPoint(map, -kSweetHalfWidth, kSweetFar),
+           MapPoint(map, kSweetHalfWidth, kSweetFar), MapPoint(map, kSweetHalfWidth, kSweetNear)}};
+}
+
+}  // namespace xbox360ps5::motion::play_space
