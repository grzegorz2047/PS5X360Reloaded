+struct GuidePainter {
+  ImDrawList* list;
+  ImFont* font;
+  float scale, reveal;
+  ImU32 Colour(uint32_t rgb, float alpha) const {
+    return IM_COL32((rgb >> 16) & 0xFF, (rgb >> 8) & 0xFF, rgb & 0xFF, int(255 * std::clamp(alpha, 0.0f, 1.0f) * reveal));
+  }
+  void Fill(float x, float y, float w, float h, uint32_t rgb, float alpha, float round) {
+    list->AddRectFilled(ImVec2(x * scale, y * scale), ImVec2((x + w) * scale, (y + h) * scale), Colour(rgb, alpha),
+                        round * scale);
+  }
+  void Text(const char* text, float x, float y, float size, uint32_t rgb, float alpha) {
+    list->AddText(font, size * scale, ImVec2(x * scale, y * scale), Colour(rgb, alpha), text);
+  }
+  float Width(const char* text, float size) { return font->CalcTextSizeA(size * scale, 4096.0f, 0.0f, text).x / scale; }
+  void Triangle(float ax, float ay, float bx, float by, float cx, float cy, uint32_t rgb, float alpha) {
+    list->AddTriangleFilled(ImVec2(ax * scale, ay * scale), ImVec2(bx * scale, by * scale), ImVec2(cx * scale, cy * scale),
