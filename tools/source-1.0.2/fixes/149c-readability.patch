@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: MIT
+// Fix 149c: the launcher's button hints (Launcher::Canvas::Hint) at 22 px (20 before), the user's choice
+// after 1.0.6-work-fix149b (#57). At 22 px the longest legend (a profile's: Use this profile, Back, Remove
+// profile, Avatar, Navigate) is wider than its 860 px sheet in German, French, Italian, Dutch and Russian,
+// so a hint that would pass the right edge starts a second line under the first, at the legend's start.
+// The sheets are flush with the screen's right edge, so one edge serves them all.
+#ifndef XBOX360PS5_HINT_ROW_HPP_
+#define XBOX360PS5_HINT_ROW_HPP_
+
+namespace xbox360ps5::hint_row {
+
+inline constexpr float kSize = 22;       // the label's size
+inline constexpr float kRight = 1896;    // the screen's right edge (1920) less a margin
+inline constexpr float kLineStep = 34;   // the second line, under the first
+inline constexpr float kIcon = 38;       // the button's circle and the space after it
+inline constexpr float kGap = 44;        // between one hint and the next
+
+// One legend, as the hints are drawn: each call passes the x the previous one returned and the same y.
+struct Row {
+  float start = 0, next = -1, y = -1, shift = 0;
+};
+struct Place {
+  float x, y;  // where this hint goes
+  float next;  // where the next one goes (Hint returns it)
+};
+// Where a hint whose label is `label` px wide goes when its caller asks for (x, y).
+inline Place Next(Row& row, float x, float y, float label) {
+  if (x != row.next || y != row.y) {  // a new legend
+    row.start = x;
+    row.y = y;
+    row.shift = 0;
+  }
+  const float width = kIcon + label;
+  if (x + width > kRight && x > row.start) {  // never an empty first line
+    x = row.start;
+    row.shift += kLineStep;
+  }
+  row.next = x + width + kGap;
+  return {x, y + row.shift, row.next};
+}
+
+}  // namespace xbox360ps5::hint_row
+
+#endif  // XBOX360PS5_HINT_ROW_HPP_
