+// Fix 125: see content_check_policy.h. GPU command thread, at the start of
+// each part of the ring.
+void SharedMemory::CheckContentUnits() {
+  if (checked_new_count_.load(std::memory_order_acquire)) {
+    auto global_lock = global_critical_region_.Acquire();
+    checked_list_.insert(checked_list_.end(), checked_new_.begin(),
+                         checked_new_.end());
+    checked_new_.clear();
+    checked_new_count_.store(0, std::memory_order_relaxed);
+  }
+  checked_list_size_.store(uint32_t(checked_list_.size()),
+                           std::memory_order_relaxed);
+  if (checked_list_.empty()) {
+    return;
+  }
+  const auto start = std::chrono::steady_clock::now();
+  ++checked_parts_;
+  checked_changed_.clear();
+  const size_t unit_bytes = size_t(1) << page_size_log2_;
+  for (size_t i = 0; i < checked_list_.size();) {
+    const uint32_t unit = checked_list_[i];
+    if (!UnitBit(checked_bits_, unit)) {
+      // No longer checked (aged, forgotten, GPU-written): dropped.
+      checked_list_[i] = checked_list_.back();
+      checked_list_.pop_back();
+      continue;
+    }
+    ++i;
+    if (!((__atomic_load_n(&system_page_flags_valid_[unit >> 6],
+                           __ATOMIC_ACQUIRE) >>
+           (unit & 63)) &
+          1)) {
+      continue;  // Its next upload hashes it.
+    }
+    ++checked_hashes_;
+    const uint64_t hash = XXH3_64bits(
+        memory().TranslatePhysical(unit << page_size_log2_), unit_bytes);
+    if (hash != unit_hash_[unit]) {
+      checked_changed_.push_back(unit);
     }
   }
+  if (!checked_changed_.empty()) {
+    auto global_lock = global_critical_region_.Acquire();
+    request_cache_.Invalidate();
+    for (const uint32_t unit : checked_changed_) {
+      if (!UnitBit(checked_bits_, unit)) {
+        continue;
+      }
+      // As a write fault on it would: invalid, its watches fired, warmer.
+      const uint64_t bit = uint64_t(1) << (unit & 63);
+      __atomic_fetch_and(&system_page_flags_valid_[unit >> 6], ~bit,
+                         __ATOMIC_RELEASE);
+      system_page_flags_valid_and_gpu_written_[unit >> 6] &= ~bit;
+      unit_heat_[unit] = content_check::HeatOnChange(unit_heat_[unit]);
+      FireWatches(unit, unit, false);
+    }
+    checked_found_changed_ += checked_changed_.size();
+  }
+  checked_list_size_.store(uint32_t(checked_list_.size()),
+                           std::memory_order_relaxed);
+  checked_ticks_ns_ += uint64_t(
+      std::chrono::duration_cast<std::chrono::nanoseconds>(
+          std::chrono::steady_clock::now() - start)
+          .count());
 }
