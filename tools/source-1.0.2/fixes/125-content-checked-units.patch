--- /dev/null
+++ b/.deps/xenia-canary/src/xenia/gpu/content_check_policy.h
@@ -0,0 +1,65 @@
+/**
+ ******************************************************************************
+ * Xbox360PS5: fix 125, watched units the guest rewrites all the time are     *
+ * compared by content at each part of the ring instead.                      *
+ ******************************************************************************
+ * Fix 36 leaves a unit the guest keeps writing unwatched, but only for
+ * requests that allow it (vertex data). A unit something depends on (a
+ * texture's watch, a converted index buffer, a request without
+ * allow_unwatched) is pinned: watched and protected after every upload. The
+ * Sims 3 rewrites texture pages every frame in live mode, so each such page
+ * cost a write fault and two protection changes per frame. With Optimized
+ * video memory on (1.0.5-work-fix121, research/sims3-121boost) that was 8,506
+ * protections a second on the GPU thread (321 ms/s, about 37.7 us each) and
+ * 6,277 faults a second opening pages on the guest's threads (236 ms/s).
+ *
+ * A pinned unit that faults kHeatToCheck times (the heat fix 36 keeps, halved
+ * every 120 frames) is checked by content from then on. It stays valid but is
+ * not protected after its uploads, and the upload records a hash of the
+ * guest's bytes, taken before the copy. At the start of each part of the ring
+ * (fix 87's epoch) the GPU command thread hashes every such unit; one whose
+ * bytes differ is invalidated and its watches fire, as a write fault would
+ * have done. That relies on fix 87's rule: what a part of the ring reads was
+ * written before the part was published. A unit with GPU-written data is
+ * never checked (its bytes are not the GPU copy). A unit whose heat runs out
+ * (no change found for a few hundred frames) is invalidated once and watched
+ * again from its next upload.
+ ******************************************************************************
+ */
+
+#ifndef XENIA_GPU_CONTENT_CHECK_POLICY_H_
+#define XENIA_GPU_CONTENT_CHECK_POLICY_H_
+
+#include <cstddef>
+#include <cstdint>
+
+namespace xe {
+namespace gpu {
+namespace content_check {
+
+constexpr uint8_t kHeatToCheck = 6;
+// At most this many units (16 MiB with 4 KiB units) are checked at once: a
+// hash of each at every part of the ring.
+constexpr size_t kMaxCheckedUnits = 4096;
+
+// A write fault on a pinned unit whose heat is now `heat` (global lock held).
+inline bool StartChecking(bool gpu_written, bool checked, uint8_t heat,
+                          size_t checked_count) {
+  return !gpu_written && !checked && heat >= kHeatToCheck &&
+         checked_count < kMaxCheckedUnits;
+}
+// A change found by a check warms the unit as a fault would, up to
+// kHeatWhileChecked, so that about three agings (360 frames) without a change
+// take it back to being watched.
+constexpr uint8_t kHeatWhileChecked = 2 * kHeatToCheck;
+inline uint8_t HeatOnChange(uint8_t heat) {
+  return heat < kHeatWhileChecked ? uint8_t(heat + 1) : heat;
+}
+// A checked unit whose heat is now `heat` after aging goes back to being watched.
+inline bool StopChecking(uint8_t heat) { return heat < 2; }
+
+}  // namespace content_check
+}  // namespace gpu
+}  // namespace xe
+
+#endif  // XENIA_GPU_CONTENT_CHECK_POLICY_H_
