+// Fix 117e: the surface pitch (pixels) up to which a game renders at 1x when it is at 2x, from its
+// assets/presets.txt section (scale_threshold=); 0 when it has none.
+int ScaleThresholdFor(const std::string& title_id) {
+  if (title_id.empty()) return 0;
+  const auto values = ReadValues("/app0/assets/presets.txt", title_id);
+  const auto it = values.find("scale_threshold");
+  return it == values.end() ? 0 : it->second;
+}
