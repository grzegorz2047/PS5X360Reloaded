+// SPDX-License-Identifier: MIT
+// Avatar milestone 1 (1.0.5): a generated avatar skeleton, so a title that reads the player's
+// body shape from XamAvatarGetAssets (Kinect Sports, 4D5308C9) gets one, with no avatar files.
+//
+// What a title reads (research/avatar-creator/REPORT.md, from Kinect Sports' code; the layout is
+// the one public projects document, gibbed's xenia "avatars" branch and xenia-canary PR #768):
+//   XAVATAR_ASSETS +0x00 skeleton -> { u32 joint count; u32 joints } with 71 joints of 0x60 bytes:
+//     +0x00 parent, +0x04 first child, +0x08 next sibling (0xFF = none), +0x0C 0,
+//     +0x10 bind pose position (float4), +0x20 bind pose rotation (quaternion x, y, z, w),
+//     +0x30 pose position, +0x40 pose rotation, +0x50 pose scale (float4).
+// Kinect Sports (0x82524E38) maps each joint to its own rig and applies the scale's girth (x and
+// z, or y and z for the arm's scale joints) where it is not 1: the body shape. Its bind pose comes
+// from its own copy of the standard skeleton, so ours only needs the right order and parents.
+//
+// The joint names and parents are public (the XNA AvatarBone values, the ATG samples' joint enum;
+// parents listed before children). The positions are our own numbers for a simple mannequin in a
+// T-pose, Y up, in metres, the root between the feet; no avatar data is copied from anywhere.
+// The shape: body type, height and weight per player profile, in the launcher's profile sheet,
+// kept in /download0/xbox360ps5/avatars/<XUID>.txt.
+#pragma once
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <sstream>
+#include <string>
+
+namespace xbox360ps5::avatar_skeleton {
+
+constexpr uint32_t kJoints = 71;
+constexpr uint32_t kJointBytes = 0x60;
+constexpr uint32_t kNone = 0xFF;
+
+struct Joint {
+  const char* name;
+  uint8_t parent;
+  float x, y, z;  // the bind pose, relative to the parent
+};
+
+// Left is +x (the avatar faces +z). Scale joints ("SC") are leaves that carry the body shape.
