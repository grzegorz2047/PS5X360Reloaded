+// The body shape of one profile. Height and weight in percent, -100 (shortest, thinnest) to 100.
+struct Shape {
+  int body = 1;  // 1 male, 2 female (XAVATAR_BODY_TYPE)
+  int height = 0;
+  int weight = 0;
+};
+constexpr int kStep = 10;  // what one press changes in the launcher
+
+inline int Clamp(int value, int low, int high) { return value < low ? low : value > high ? high : value; }
+inline Shape Clamped(Shape shape) {
+  shape.body = shape.body == 2 ? 2 : 1;
+  shape.height = Clamp(shape.height, -100, 100);
+  shape.weight = Clamp(shape.weight, -100, 100);
+  return shape;
+}
+
+// The file's text: "body=1\nheight=0\nweight=0\n". Unknown lines are ignored, missing ones keep
+// the default, values are clamped.
+inline std::string Format(const Shape& shape) {
+  const Shape s = Clamped(shape);
+  return "body=" + std::to_string(s.body) + "\nheight=" + std::to_string(s.height) +
+         "\nweight=" + std::to_string(s.weight) + "\n";
+}
+inline Shape Parse(const std::string& text) {
+  Shape shape;
+  size_t at = 0;
+  while (at < text.size()) {
+    size_t end = text.find('\n', at);
+    if (end == std::string::npos) end = text.size();
+    const std::string line = text.substr(at, end - at);
+    at = end + 1;
+    const size_t equals = line.find('=');
+    if (equals == std::string::npos) continue;
+    const std::string key = line.substr(0, equals);
+    int value = 0;
+    if (std::sscanf(line.c_str() + equals + 1, "%d", &value) != 1) continue;
+    if (key == "body") shape.body = value;
+    else if (key == "height") shape.height = value;
+    else if (key == "weight") shape.weight = value;
+  }
+  return Clamped(shape);
+}
+constexpr const char* kFolder = "/download0/xbox360ps5/avatars";
+inline std::string FileName(uint64_t xuid) {
+  char name[32];
+  std::snprintf(name, sizeof(name), "%016llX.txt", static_cast<unsigned long long>(xuid));
+  return name;
+}
+
+// A profile's shape from `folder` (kFolder on the console). False, and the default shape, when the
+// profile has none saved.
+inline bool Load(const std::string& folder, uint64_t xuid, Shape* shape) {
+  *shape = Shape();
+  std::ifstream in(folder + "/" + FileName(xuid), std::ios::binary);
+  if (!in) return false;
+  std::stringstream text;
+  text << in.rdbuf();
+  *shape = Parse(text.str());
+  return true;
+}
+// Saves it there (a new file, then renamed over the old one).
+inline bool Save(const std::string& folder, uint64_t xuid, const Shape& shape) {
+  std::error_code error;
+  std::filesystem::create_directories(folder, error);
+  const std::string path = folder + "/" + FileName(xuid), temporary = path + ".new";
+  {
+    std::ofstream out(temporary, std::ios::binary | std::ios::trunc);
+    if (!out) return false;
+    out << Format(shape);
+    if (!out.flush()) return false;
+  }
+  std::filesystem::rename(temporary, path, error);
+  return !error;
+}
+
+// The scale joints and which way they run in the T-pose: along y (spine, legs, neck) or along x
+// (the arms, whose girth is in y and z).
+inline bool IsScaleJoint(uint32_t joint) {
+  const char* name = kSkeleton[joint].name;
+  return name[0] == 'S' || (name[2] == '_' && name[3] == 'S' && name[4] == 'C');
+}
+inline bool RunsAlongX(uint32_t joint) {
+  switch (joint) {
+    case 26: case 27: case 29: case 30: case 32: case 35: return true;
+    default: return false;
+  }
+}
+
+struct Scale { float x = 1, y = 1, z = 1; };
+// Our own proportions: weight widens or narrows the limbs and trunk by up to 25 %, height
+// lengthens or shortens them by up to 12 %; a female body has slightly wider hips and narrower
+// shoulders and arms. Joints that are not scale joints keep 1.
+inline Scale ScaleOf(uint32_t joint, const Shape& shape) {
+  Scale scale;
+  if (joint >= kJoints || !IsScaleJoint(joint)) return scale;
+  const Shape s = Clamped(shape);
+  float girth = 1.0f + 0.25f * float(s.weight) / 100.0f;
+  const float length = 1.0f + 0.12f * float(s.height) / 100.0f;
+  if (s.body == 2) {
+    if (joint == 4 || joint == 7 || joint == 9) girth *= 1.06f;  // hips and thighs
+    if (joint == 18 || RunsAlongX(joint)) girth *= 0.94f;        // chest, arms
+  }
+  if (RunsAlongX(joint)) scale = {length, girth, girth};
+  else scale = {girth, length, girth};
+  return scale;
+}
+
+// The skeleton in a result buffer: the joint count and pointer at kSkeletonAt, the joints at
+// kJointsAt (16-byte aligned), all big-endian; the set's +0 points at the skeleton.
+constexpr uint32_t kSkeletonAt = 0x100;  // after fix 99's empty set (0x100 bytes, cleared)
+constexpr uint32_t kJointsAt = 0x110;
+constexpr uint32_t kResultBytes = 0x2000;  // what XamAvatarGetAssetsResultSize asks for at least
+static_assert(kJointsAt + kJoints * kJointBytes <= kResultBytes, "the joints fit");
+
+inline void Put32(uint8_t* at, uint32_t value) {
+  at[0] = uint8_t(value >> 24), at[1] = uint8_t(value >> 16), at[2] = uint8_t(value >> 8), at[3] = uint8_t(value);
+}
+inline void PutFloat(uint8_t* at, float value) {
+  uint32_t bits;
+  static_assert(sizeof(bits) == sizeof(value), "float is 32 bits");
+  std::memcpy(&bits, &value, sizeof(bits));
+  Put32(at, bits);
+}
+inline uint32_t FirstChild(uint32_t joint) {
+  for (uint32_t n = joint + 1; n < kJoints; ++n)
+    if (kSkeleton[n].parent == joint) return n;
+  return kNone;
+}
+inline uint32_t NextSibling(uint32_t joint) {
+  for (uint32_t n = joint + 1; n < kJoints; ++n)
+    if (kSkeleton[n].parent == kSkeleton[joint].parent) return n;
+  return kNone;
+}
+
+// Writes the skeleton for `shape` into `assets` (kResultBytes at the guest address `address`) and
+// points the set's +0 at it. The rest of the set is left as it is (fix 99's empty set: no
+// components).
+inline void WriteSkeleton(uint8_t* assets, uint32_t address, const Shape& shape) {
+  uint8_t* skeleton = assets + kSkeletonAt;
+  Put32(skeleton, kJoints);
+  Put32(skeleton + 4, address + kJointsAt);
+  for (uint32_t n = 0; n < kJoints; ++n) {
+    uint8_t* joint = assets + kJointsAt + n * kJointBytes;
+    for (uint32_t i = 0; i < kJointBytes; ++i) joint[i] = 0;
+    const Joint& j = kSkeleton[n];
+    Put32(joint + 0x00, j.parent);
+    Put32(joint + 0x04, FirstChild(n));
+    Put32(joint + 0x08, NextSibling(n));
+    for (uint32_t pose : {0x10u, 0x30u}) {  // bind pose and pose: the same, at rest
+      PutFloat(joint + pose + 0x0, j.x);
+      PutFloat(joint + pose + 0x4, j.y);
+      PutFloat(joint + pose + 0x8, j.z);
+      PutFloat(joint + pose + 0x1C, 1.0f);  // rotation w: no rotation
+    }
+    const Scale scale = ScaleOf(n, shape);
+    PutFloat(joint + 0x50, scale.x);
+    PutFloat(joint + 0x54, scale.y);
+    PutFloat(joint + 0x58, scale.z);
+    PutFloat(joint + 0x5C, 1.0f);
+  }
+  Put32(assets, address + kSkeletonAt);
+}
+
+}  // namespace xbox360ps5::avatar_skeleton
