+// Fix 156t (Zumba Fitness, #63): a body starts unidentified. In a title that identifies its
+// players itself, a body's skeleton frames carry "call identify" (enrollment -1, no user) until
+// the title has asked to identify it and got the answer, as the console's library writes them;
+// then the signed-in profile's enrollment and user index. Zumba maps the frame's enrollment to
+// its identity state (82333248: -1 -> 0, 0 and up -> 4) and calls identify only for state 0
+// (8227E380); its identify callback (82331FE8) is what fills its user slots (tracking ID,
+// profile matched, enrollment). Our frames said enrollment 0 from the first one, so Zumba never
+// asked and its "Searching for player..." never ended (1.0.6-work-fix156s: our body picked
+// for 56 s in a row, the library tracking it, inside the play area 1.80-3.60 m).
+inline std::atomic<bool> identify_bound{false};  // this title's identify is answered here
+inline std::vector<uint32_t> identified;          // bodies answered (under mutex)
+constexpr size_t kMaxIdentified = 16;
+inline void MarkIdentified(uint32_t tracking_id) {
+  if (!tracking_id) return;
+  std::lock_guard lock(mutex);
+  for (uint32_t id : identified)
+    if (id == tracking_id) return;
+  if (identified.size() >= kMaxIdentified) identified.erase(identified.begin());
+  identified.push_back(tracking_id);
+}
+// A title that never asks (Kinect Sports and Dragon Ball Z have the function bound too): while
+// it has not asked to identify anyone since its binding, a body it has seen for kAskWithinMs is
+// taken as identified, and the frames say what they said before 156t. A title that asked once
+// never falls back (Zumba may first see the body during its intro and ask only on its search
+// screen).
+constexpr int64_t kAskWithinMs = 20000;
+inline uint32_t watched_body = 0;  // under mutex
+inline int64_t watched_since_ms = 0;
+inline bool Unidentified(uint32_t tracking_id, int64_t now_ms) {
+  if (!tracking_id) return false;
+  std::lock_guard lock(mutex);
+  for (uint32_t id : identified)
+    if (id == tracking_id) return false;
+  if (tracking_id != watched_body) {
+    watched_body = tracking_id;
+    watched_since_ms = now_ms;
+  }
+  if (!ever_asked && now_ms - watched_since_ms >= kAskWithinMs) {
+    if (identified.size() >= kMaxIdentified) identified.erase(identified.begin());
+    identified.push_back(tracking_id);
+    return false;
+  }
+  return true;
+}
+struct FrameIdentity {
+  uint32_t enrollment, user_index;
+};
+// What a body's skeleton frame says about who it is.
+inline FrameIdentity ForFrame(bool bound, bool unidentified, uint32_t enrollment,
+                              uint32_t user_index) {
+  if (bound && unidentified) return {kEnrollmentUnknown, kUserIndexNone};  // call identify
+  return {enrollment, user_index};
+}
+
 inline void Reset() {
   std::lock_guard lock(mutex);
   pending.clear();
+  identified.clear();  // fix 156t
+  ever_asked = false;
+  watched_body = 0;
+  watched_since_ms = 0;
 }
 
