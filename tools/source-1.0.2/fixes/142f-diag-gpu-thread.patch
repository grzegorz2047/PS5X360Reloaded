+ private:
+  template <typename T>
+  void Put(const T& value) {
+    static_assert(sizeof(T) <= sizeof(uint64_t), "a handle");
+    uint64_t bits = 0;
+    std::memcpy(&bits, &value, sizeof(T));
+    key_.push_back(bits);
+  }
+  struct Stage {
+    uint64_t frame = UINT64_MAX;
+    std::vector<uint64_t> previous;
+    bool has_previous = false;
+    std::array<std::vector<uint64_t>, kTextureSetHistory> history;
+    uint32_t used = 0, next = 0;
+  };
+  std::array<Stage, 2> stages_;
+  std::vector<uint64_t> key_;
+};
+inline TextureSetHistory texture_set_history;
+
+// Float constant writes by stage (0 vertex, 1 pixel): identical (the bits it had), unused by the
+// current shaders (changed, not in their float constant map), used (changed and in it). And the
+// system constants: each UpdateSystemConstantValues call, and those that changed them (an upload,
+// fix 142d's "system" in the constants).
+constexpr uint32_t kConstantIdentical = 0, kConstantUnused = 1, kConstantUsed = 2, kConstantClasses = 3;
+inline std::array<std::array<std::atomic<uint64_t>, kConstantClasses>, 2> constant_writes{};
+inline void NoteFloatConstantWrite(uint32_t float_index, bool identical, bool used) {
+  const uint32_t stage = float_index >= 256 ? 1 : 0;
+  AddOwn(constant_writes[stage][identical ? kConstantIdentical : used ? kConstantUsed : kConstantUnused], 1);
+}
+inline std::atomic<uint64_t> system_constant_calls{0}, system_constant_changes{0};
+inline void NoteSystemConstants(bool changed) {
+  if (!DiagDetail() || !OnGpuThread()) return;
+  AddOwn(system_constant_calls, 1);
+  if (changed) AddOwn(system_constant_changes, 1);
+}
+
+// Resolve readbacks in fast mode that did not wait: the earlier copy handed over, a steady family's
+// late copy taken instead of its own (fix 133), or carried over to a later resolve because the GPU
+// had not finished the copy (fix 59). (Waits are counted by reason above.)
+constexpr uint32_t kOutcomeHanded = 0, kOutcomeFamilyLate = 1, kOutcomeCarried = 2, kOutcomes = 3;
+inline std::array<std::atomic<uint64_t>, kOutcomes> resolve_outcomes{};
+inline void NoteResolveOutcome(uint32_t outcome) {
+  if (outcome < kOutcomes && DiagDetail() && OnGpuThread()) AddOwn(resolve_outcomes[outcome], 1);
+}
+
+// Access faults in guest memory (MMIOHandler::ExceptionCallback, any thread): MMIO, a write to a
+// watched page, a read of a read-watched page (fix 91), and a watch another thread had already
+// lifted; and the guest code that faulted most (one fault in 8 resolved to its guest address
+// through the JIT's code map; 0 is the emulator's own code).
+enum FaultKind : uint32_t { kFaultMmio = 0, kFaultWriteWatch, kFaultReadWatch, kFaultCleared, kFaultKinds };
+inline const char* FaultKindName(uint32_t kind) {
+  static const char* const names[] = {"MMIO", "write to a watched page", "read of a read-watched page",
+                                      "watch already lifted"};
+  return kind < kFaultKinds ? names[kind] : "?";
+}
+inline std::array<std::atomic<uint64_t>, kFaultKinds> faults{};
+inline std::atomic<uint32_t (*)(uint64_t)> guest_pc_resolver{nullptr};
+constexpr uint32_t kFaultSlots = 128;
+struct FaultSlot {
+  std::atomic<uint64_t> key{0};  // guest PC << 8 | kind + 1
+  std::atomic<uint64_t> count{0};
+};
+inline std::array<FaultSlot, kFaultSlots> fault_slots{};
+inline std::atomic<uint32_t> fault_sample{0};
+inline void NoteFault(uint32_t kind, uint64_t host_pc) {
+  if (kind >= kFaultKinds || !DiagDetail()) return;
+  faults[kind].fetch_add(1, std::memory_order_relaxed);
+  if (fault_sample.fetch_add(1, std::memory_order_relaxed) % 8) return;
+  uint32_t (*resolve)(uint64_t) = guest_pc_resolver.load(std::memory_order_relaxed);
+  const uint32_t guest_pc = resolve ? resolve(host_pc) : 0;
+  const uint64_t key = (uint64_t(guest_pc) << 8) | (kind + 1);
+  uint32_t slot = uint32_t((key * 0x9E3779B97F4A7C15ull) >> 57) % kFaultSlots;
+  for (uint32_t probe = 0; probe < 8; ++probe, slot = (slot + 1) % kFaultSlots) {
+    uint64_t current = fault_slots[slot].key.load(std::memory_order_relaxed);
+    if (current == 0 &&
+        fault_slots[slot].key.compare_exchange_strong(current, key, std::memory_order_relaxed)) {
+      current = key;
+    }
+    if (current == key) {
+      fault_slots[slot].count.fetch_add(8, std::memory_order_relaxed);  // scaled back
+      return;
+    }
+  }
+}
+
+// What a timed packet's timer costs: inside the packet's own time (between its two clock reads)
+// and outside it (what the enclosing packet sees beyond that), in ticks. Estimated by running the
+// timer's own steps on scratch counters on the calling thread, which runs on the same kind of core.
+struct TimerCost {
+  double inside_ticks = 0, outside_ticks = 0;
+};
+inline TimerCost EstimatePacketTimerCost(uint32_t rounds = 4096) {
+  std::atomic<uint64_t> scratch_ticks{0}, scratch_count{0};
+  uint64_t nested = 0, inside = 0, timed = 0;
+  volatile bool on_thread = false;
+  const uint64_t outer_start = Ticks();
+  for (uint32_t i = 0; i < rounds; ++i) {
+    on_thread = OnGpuThread();  // the constructor's test
+    const uint64_t start = Ticks();
+    const uint64_t other = OtherSectionTicks() + section_ticks[kDraw].load(std::memory_order_relaxed);
+    const uint64_t nested_before = nested, timed_before = timed;
+    const uint64_t wall = Ticks() - start;  // the destructor
+    const uint64_t sections =
+        OtherSectionTicks() + section_ticks[kDraw].load(std::memory_order_relaxed) - other;
+    const uint64_t own = wall > sections ? wall - sections : 0;
+    AddOwn(scratch_ticks, own);
+    AddOwn(scratch_count, 1);
+    AddOwn(scratch_ticks, timed - timed_before);
+    ++timed;
+    nested = nested_before + wall - sections;
+    inside += own;
+  }
+  const uint64_t outer = Ticks() - outer_start;
+  (void)on_thread;
+  TimerCost cost;
+  if (rounds) {
+    cost.inside_ticks = double(inside) / rounds;
+    cost.outside_ticks = outer > inside ? double(outer - inside) / rounds : 0.0;
+  }
+  return cost;
+}
+
+// "Frame time GPU thread without waits (fix 142f-diag): executing x ms/s, of which sections ..., GPU
+// waits w ms/s (fix 49's fences), WAIT_REG_MEM sleeps z ms/s (fix 138), and the rest (packets,
+// registers, constants) r ms/s" - the detail line's rest of executing holds the waits; this one
+// takes them out. And "Frame time packet timing (GPU thread, fix 142f-diag): ..." with INDIRECT_BUFFER's
+// nested timed packets and the timer's cost in them, type 0 by register group, and fix 73's
+// primitives and pipeline parts by sub-part. And "Frame time readback waits (GPU thread, fix
+// 142f): ..." the resolve and memexport readback waits by reason.
+class ProbeReporter {
+ public:
+  // `fixed_ns_per_tick` and `fixed_cost` (tests): instead of the measured ones.
+  std::string Lines(double seconds, double fixed_ns_per_tick = 0, const TimerCost* fixed_cost = nullptr) {
+    const uint64_t ticks_now = Ticks(), ns_now = NowNs();
+    double ns_per_tick = last_ns_per_tick_ > 0 ? last_ns_per_tick_ : OriginNsPerTick();  // fix 142f-diag
+    if (last_ticks_ && ticks_now > last_ticks_ && ns_now > last_ns_)
+      ns_per_tick = double(ns_now - last_ns_) / double(ticks_now - last_ticks_);
+    if (fixed_ns_per_tick > 0) ns_per_tick = fixed_ns_per_tick;
+    last_ns_per_tick_ = ns_per_tick;
+    last_ticks_ = ticks_now;
+    last_ns_ = ns_now;
+    const double s = seconds > 0 ? seconds : 1;
+    auto ms_ticks = [&](double ticks) { return ticks * ns_per_tick / 1e6 / s; };
+    auto ms_ns = [&](double ns) { return ns / 1e6 / s; };
+
+    // The GPU thread without its waits.
+    const double execute = ms_ns(Delta(totals.execute_ns, last_execute_));
+    const double guest = ms_ns(Delta(totals.guest_wait_ns, last_guest_));
+    const double guest_n = Delta(totals.guest_waits, last_guest_n_) / s;
+    double sections_ms[kSections] = {};
+    double covered = 0;
+    std::string sections;
+    for (uint32_t n = 1; n < kSections; ++n) {
+      sections_ms[n] = ms_ticks(Delta(section_ticks[n], last_sections_[n]));
+      covered += sections_ms[n];
+      if (n == kWait) continue;
+      char item[64];
+      std::snprintf(item, sizeof(item), "%s%s %.1f", sections.empty() ? "" : ", ", SectionName(n), sections_ms[n]);
+      sections += item;
+    }
+    double pipeline_waits = ms_ns(Delta(totals.wait_ns[kPipeline], last_pipeline_));
+    const double rest = execute > covered + guest ? execute - covered - guest : 0.0;
+    char first[640];
+    std::snprintf(first, sizeof(first),
+                  "Frame time GPU thread without waits (fix 142f-diag): executing %.0f ms/s with every wait in it; "
+                  "sections %s ms/s (draws hold pipeline waits %.1f); GPU waits %.1f ms/s; WAIT_REG_MEM sleeps "
+                  "%.1f ms/s in %.0f/s; the rest of executing (packets, registers, constants) without waits %.1f ms/s",
+                  execute, sections.c_str(), pipeline_waits, sections_ms[kWait], guest, guest_n, rest);
+
+    // Packet timing.
+    const TimerCost cost = fixed_cost ? *fixed_cost : EstimatePacketTimerCost();
+    const uint64_t top = packet_top.load(std::memory_order_relaxed);
+    const uint64_t sampled = packet_top_sampled.load(std::memory_order_relaxed);
+    const double scale = sampled != last_top_sampled_ ? double(top - last_top_) / double(sampled - last_top_sampled_)
+                                                      : 0.0;
+    last_top_ = top;
+    last_top_sampled_ = sampled;
+    const double ib_ms = ms_ticks(Delta(packet_ticks[kPacketIndirect], last_ib_ticks_) * scale);
+    const double ib_n = Delta(packet_counts[kPacketIndirect], last_ib_counts_) * scale;
+    const double nested = Delta(packet_indirect_nested, last_ib_nested_) * scale;
+    const double ib_timers = ms_ticks(nested * cost.outside_ticks);
+    std::string groups;
+    for (uint32_t g = 0; g < kRegGroups; ++g) {
+      const double ms = ms_ticks(Delta(packet_register_ticks[g], last_reg_ticks_[g]) * scale);
+      const double n = Delta(packet_register_counts[g], last_reg_counts_[g]) * scale;
+      char item[128];
+      std::snprintf(item, sizeof(item), "%s%s %.1f ms/s in %.0f/s (%.0f ns each)", g ? ", " : "", RegisterGroupName(g),
+                    ms, n / s, n > 0 ? ms * 1e6 * s / n : 0.0);
+      groups += item;
+    }
+    // Fix 73's parts by sub-part (fix 142d's sampling).
+    const double draws = Delta(bind_draws, last_draws_), timed = Delta(bind_sampled, last_timed_);
+    const double draw_scale = timed > 0 ? draws / timed : 0.0;
+    std::string subs;
+    for (uint32_t n = 0; n < kDrawSubParts; ++n) {
+      const double ms = ms_ticks(Delta(draw_sub_ticks[n], last_subs_[n]) * draw_scale);
+      char item[96];
+      std::snprintf(item, sizeof(item), "%s%s%s %.1f", n == 0 ? "primitives: " : n == kFirstPipelineSub ? "; pipeline: " : ", ",
+                    "", DrawSubPartName(n), ms);
+      subs += item;
+    }
+    char second[1200];
+    std::snprintf(second, sizeof(second),
+                  "Frame time packet timing (GPU thread, fix 142f-diag): the timer costs about %.0f ns inside a timed packet "
+                  "and %.0f ns outside it; INDIRECT_BUFFER own %.1f ms/s in %.0f/s with %.1f timed packets nested "
+                  "each (%.0f ns of its own time per nested packet), of which about %.1f ms/s is their timers; type 0 by first register: %s; draws by sub-part "
+                  "(ms/s, 1 draw in 8 timed): %s",
+                  cost.inside_ticks * ns_per_tick, cost.outside_ticks * ns_per_tick, ib_ms, ib_n / s,
+                  ib_n > 0 ? nested / ib_n : 0.0, nested > 0 ? ib_ms * 1e6 * s / nested : 0.0, ib_timers, groups.c_str(), subs.c_str());
+
+    // Resolve waits by reason.
+    std::string reasons;
+    double resolve_total = 0;
+    for (uint32_t r = 0; r < kResolveReasons; ++r) {
+      const double ms = ms_ns(Delta(resolve_wait_ns[r], last_resolve_ns_[r]));
+      const double n = Delta(resolve_waits[r], last_resolve_n_[r]);
+      const double bytes = Delta(resolve_wait_bytes[r], last_resolve_bytes_[r]);
+      resolve_total += ms;
+      char item[128];
+      std::snprintf(item, sizeof(item), "%s%s %.1f ms/s in %.1f/s (%.0f KiB each)", r ? ", " : "", ResolveReasonName(r),
+                    ms, n / s, n > 0 ? bytes / n / 1024.0 : 0.0);
+      reasons += item;
+    }
+    std::string exports;
+    double memexport_total = 0;
+    for (uint32_t r = 0; r < kMemexportReasons; ++r) {
+      const double ms = ms_ns(Delta(memexport_wait_ns[r], last_memexport_ns_[r]));
+      const double n = Delta(memexport_waits[r], last_memexport_n_[r]);
+      const double bytes = Delta(memexport_wait_bytes[r], last_memexport_bytes_[r]);
+      memexport_total += ms;
+      char item[128];
+      std::snprintf(item, sizeof(item), "%s%s %.1f ms/s in %.1f/s (%.1f KiB each)", r ? ", " : "",
+                    MemexportReasonName(r), ms, n / s, n > 0 ? bytes / n / 1024.0 : 0.0);
+      exports += item;
+    }
+    double outcomes[kOutcomes];
+    for (uint32_t o = 0; o < kOutcomes; ++o) outcomes[o] = Delta(resolve_outcomes[o], last_outcomes_[o]) / s;
+    const double resolve_own = sections_ms[kCopy];
+    const double resolve_n = Delta(section_count[kCopy], last_copy_count_) / s;
+    char third[1600];
+    std::snprintf(third, sizeof(third),
+                  "Frame time readback waits (GPU thread, fix 142f-diag): resolves %.1f ms/s (%s); fast copies without a "
+                  "wait: the earlier copy handed over %.1f/s, a steady family's late copy (fix 133) %.1f/s, carried over "
+                  "with the GPU behind (fix 59) %.1f/s; the resolves' own time %.1f ms/s in %.0f/s (%.1f us each); "
+                  "memexport %.1f ms/s (%s)",
+                  resolve_total, reasons.c_str(), outcomes[kOutcomeHanded], outcomes[kOutcomeFamilyLate],
+                  outcomes[kOutcomeCarried], resolve_own, resolve_n, resolve_n > 0 ? resolve_own * 1000 / resolve_n : 0.0,
+                  memexport_total, exports.c_str());
+    // Every packet counted by kind, against fix 75's scaled sample; the sample's own time each.
+    std::string kinds;
+    double kinds_ms = 0;
+    for (uint32_t k = 0; k < kPacketKinds; ++k) {
+      const double all = Delta(packet_all_counts[k], last_all_counts_[k]);
+      const double timed_ticks = Delta(packet_ticks[k], last_kind_ticks_[k]);
+      const double timed_n = Delta(packet_counts[k], last_kind_counts_[k]);
+      const double each_ns = timed_n > 0 ? timed_ticks * ns_per_tick / timed_n : 0.0;
+      const double ms = all * each_ns / 1e6 / s;
+      kinds_ms += ms;
+      if (all < 1 && timed_n < 1) continue;
+      char item[160];
+      std::snprintf(item, sizeof(item), "%s%s %.0f/s (fix 75's scaled %.0f/s), %.0f ns each, %.1f ms/s",
+                    kinds.empty() ? "" : "; ", PacketKindName(k), all / s, timed_n * scale / s, each_ns, ms);
+      kinds += item;
+    }
+    const double wait_reg_sleep = ms_ns(Delta(packet_wait_reg_sleep_ns, last_wait_reg_sleep_) * scale);
+    char fourth[2400];
+    std::snprintf(fourth, sizeof(fourth),
+                  "Frame time packets counted (GPU thread, fix 142f-diag, every packet counted, own time from the "
+                  "timed ones): %s; in all %.1f ms/s; WAIT_REG_MEM's own time holds %.1f ms/s of sleeping (fix 138's "
+                  "sleeps in timed WAIT_REG_MEM packets, scaled)",
+                  kinds.empty() ? "none" : kinds.c_str(), kinds_ms, wait_reg_sleep);
+    // The draws' detail: Process by index buffer type, texture sets, constant writes, hot registers.
+    std::string process;
+    for (uint32_t t = 0; t < kIndexTypes; ++t) {
+      const double n = Delta(process_counts[t], last_process_n_[t]);
+      const double prepare = ms_ticks(Delta(process_prepare_ticks[t], last_process_prepare_[t]) * draw_scale);
+      const double request = ms_ticks(Delta(process_request_ticks[t], last_process_request_[t]) * draw_scale);
+      char item[160];
+      std::snprintf(item, sizeof(item), "%s%s %.0f/s (before the request %.1f ms/s, RequestRange %.1f ms/s)",
+                    t ? ", " : "", IndexTypeName(t), n / s, prepare, request);
+      process += item;
+    }
+    std::string sets;
+    for (uint32_t st = 0; st < 2; ++st) {
+      const double n = Delta(texture_set_draws[st], last_set_draws_[st]);
+      const double same = Delta(texture_set_same_previous[st], last_set_same_[st]);
+      const double found = Delta(texture_set_in_history[st], last_set_found_[st]);
+      char item[160];
+      std::snprintf(item, sizeof(item), "%s%s %.0f/s, the previous draw's %.1f%%, among the last %u of the frame %.1f%%",
+                    st ? "; " : "", st ? "pixel" : "vertex", n / s, n > 0 ? same * 100 / n : 0.0, kTextureSetHistory,
+                    n > 0 ? found * 100 / n : 0.0);
+      sets += item;
+    }
+    std::string writes;
+    for (uint32_t st = 0; st < 2; ++st) {
+      double c[kConstantClasses];
+      for (uint32_t k = 0; k < kConstantClasses; ++k) c[k] = Delta(constant_writes[st][k], last_writes_[st][k]) / s;
+      char item[160];
+      std::snprintf(item, sizeof(item), "%s%s identical %.0f/s, unused %.0f/s, used %.0f/s", st ? "; " : "",
+                    st ? "pixel" : "vertex", c[kConstantIdentical], c[kConstantUnused], c[kConstantUsed]);
+      writes += item;
+    }
+    const double system_calls = Delta(system_constant_calls, last_system_calls_) / s;
+    const double system_changes = Delta(system_constant_changes, last_system_changes_) / s;
+    std::string hot;
+    for (uint32_t h = 0; h < kHotRegisterCount; ++h) {
+      const double ms = ms_ticks(Delta(packet_hot_ticks[h], last_hot_ticks_[h]) * scale);
+      const double n = Delta(packet_hot_counts[h], last_hot_counts_[h]) * scale;
+      char item[96];
+      std::snprintf(item, sizeof(item), "%s%04X %.1f ms/s in %.0f/s (%.0f ns each)", h ? ", " : "", kHotRegisters[h], ms,
+                    n / s, n > 0 ? ms * 1e6 * s / n : 0.0);
+      hot += item;
+    }
+    char fifth[2400];
+    std::snprintf(fifth, sizeof(fifth),
+                  "Frame time draw detail (GPU thread, fix 142f-diag): Process by index buffer type: %s; texture "
+                  "sets: %s; float constant writes: %s; system constants %.0f updates/s, %.0f changed/s; type 0 "
+                  "packets at the hot registers: %s",
+                  process.c_str(), sets.c_str(), writes.c_str(), system_calls, system_changes, hot.c_str());
+    // Faults by kind, and the guest code that faulted most.
+    std::string fault_kinds;
+    for (uint32_t k = 0; k < kFaultKinds; ++k) {
+      char item[96];
+      std::snprintf(item, sizeof(item), "%s%s %.0f/s", k ? ", " : "", FaultKindName(k),
+                    Delta(faults[k], last_faults_[k]) / s);
+      fault_kinds += item;
+    }
+    struct Top { uint64_t key; double rate; };
+    Top top_faults[8] = {};
+    for (uint32_t i = 0; i < kFaultSlots; ++i) {
+      const uint64_t key = fault_slots[i].key.load(std::memory_order_relaxed);
+      const double rate = Delta(fault_slots[i].count, last_fault_slots_[i]) / s;
+      if (!key || rate <= 0) continue;
+      for (uint32_t t = 0; t < 8; ++t) {
+        if (rate > top_faults[t].rate) {
+          for (uint32_t u = 7; u > t; --u) top_faults[u] = top_faults[u - 1];
+          top_faults[t] = {key, rate};
+          break;
+        }
+      }
+    }
+    std::string top_text;
+    for (const Top& t : top_faults) {
+      if (!t.key) continue;
+      char item[96];
+      std::snprintf(item, sizeof(item), "%s%08X (%s) %.0f/s", top_text.empty() ? "" : ", ", uint32_t(t.key >> 8),
+                    FaultKindName(uint32_t(t.key & 0xFF) - 1), t.rate);
+      top_text += item;
+    }
+    const std::string sixth = "Frame time faults (fix 142f-diag, every thread): " + fault_kinds +
+                              "; guest code faulting most (1 in 8 resolved, 00000000 the emulator's own): " +
+                              (top_text.empty() ? std::string("none") : top_text);
+    const char* state = DiagDetail() ? "on" : "off (the detailed figures below are not counted)";
+    return std::string("GPU diagnostics detail (fix 142f-diag): ") + state + "\n" + first + "\n" + second + "\n" +
+           third + "\n" + fourth + "\n" + fifth + "\n" + sixth;
+  }
+
+ private:
+  template <class Counter>
+  static double Delta(const Counter& counter, uint64_t& last) {
+    const uint64_t now = counter.load(std::memory_order_relaxed);
+    const double d = double(now - last);
+    last = now;
+    return d;
+  }
+  uint64_t last_ticks_ = 0, last_ns_ = 0;
+  double last_ns_per_tick_ = 0;
+  uint64_t last_execute_ = 0, last_guest_ = 0, last_guest_n_ = 0, last_pipeline_ = 0;
+  uint64_t last_sections_[kSections] = {};
+  uint64_t last_top_ = 0, last_top_sampled_ = 0, last_ib_ticks_ = 0, last_ib_counts_ = 0, last_ib_nested_ = 0;
+  uint64_t last_reg_ticks_[kRegGroups] = {}, last_reg_counts_[kRegGroups] = {};
+  uint64_t last_draws_ = 0, last_timed_ = 0, last_subs_[kDrawSubParts] = {};
+  uint64_t last_resolve_ns_[kResolveReasons] = {}, last_resolve_n_[kResolveReasons] = {},
+           last_resolve_bytes_[kResolveReasons] = {};
+  uint64_t last_memexport_ns_[kMemexportReasons] = {}, last_memexport_n_[kMemexportReasons] = {},
+           last_memexport_bytes_[kMemexportReasons] = {};
+  uint64_t last_process_n_[kIndexTypes] = {}, last_process_prepare_[kIndexTypes] = {},
+           last_process_request_[kIndexTypes] = {};
+  uint64_t last_set_draws_[2] = {}, last_set_same_[2] = {}, last_set_found_[2] = {};
+  uint64_t last_writes_[2][kConstantClasses] = {};
+  uint64_t last_system_calls_ = 0, last_system_changes_ = 0;
+  uint64_t last_hot_ticks_[kHotRegisterCount] = {}, last_hot_counts_[kHotRegisterCount] = {};
+  uint64_t last_outcomes_[kOutcomes] = {}, last_copy_count_ = 0, last_faults_[kFaultKinds] = {},
+           last_fault_slots_[kFaultSlots] = {};
+  uint64_t last_all_counts_[kPacketKinds] = {}, last_kind_ticks_[kPacketKinds] = {},
+           last_kind_counts_[kPacketKinds] = {}, last_wait_reg_sleep_ = 0;
+};
+
 }  // namespace frame_cost
