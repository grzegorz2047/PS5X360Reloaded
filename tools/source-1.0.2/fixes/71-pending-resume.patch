diff --git a/.deps/xenia-canary/src/xenia/kernel/xthread.cc b/.deps/xenia-canary/src/xenia/kernel/xthread.cc
--- a/.deps/xenia-canary/src/xenia/kernel/xthread.cc
+++ b/.deps/xenia-canary/src/xenia/kernel/xthread.cc
@@ -1090,6 +1090,10 @@ X_STATUS XThread::Resume(uint32_t* out_suspend_count) {
       const uint64_t now = xbox360ps5::suspend_trace::NowMs();
       if (previous == 0) {
         suspend_trace_.Note(xbox360ps5::suspend_trace::kResumeFoundRunning, resumer, 0, now);
+        // Fix 71: kept for a suspension of the thread by itself that follows within 10 ms.
+        pending_resume_.Note(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                 std::chrono::steady_clock::now().time_since_epoch())
+                                 .count());
         const std::string line = xbox360ps5::suspend_trace::EarlyResumeLine(
             resumer, handle(), entering_self_suspend_.load(std::memory_order_relaxed), now);
         if (!line.empty()) XELOGW("{}", line);
@@ -1210,6 +1214,20 @@ uint32_t XThread::SelfSuspend() {
                       xbox360ps5::suspend_trace::NowMs());
   {
     std::unique_lock<std::mutex> lock(suspend_mutex_);
+    // Fix 71: a resume that came before the count was raised (it found 0, under this lock) left a
+    // credit: this suspension took place and ended at once, instead of sleeping with no one left
+    // to wake the thread. Checked after raising the count and under the lock Resume holds while it
+    // reads the count, so a resume either finds the count raised or leaves the credit seen here.
+    if (pending_resume_.Take(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                 std::chrono::steady_clock::now().time_since_epoch())
+                                 .count())) {
+      suspend_count.fetch_sub(1);
+      lock.unlock();
+      suspend_trace_.Note(xbox360ps5::suspend_trace::kSuspendCancelled, 0, uint8_t(previous),
+                          xbox360ps5::suspend_trace::NowMs());
+      xe::threading::Thread::DeferSuspension(false);
+      return previous;
+    }
     suspend_cv_.wait(lock,
                      [&suspend_count]() { return suspend_count.load() == 0; });
   }
