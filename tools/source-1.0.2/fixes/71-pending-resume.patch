diff --git a/include/xbox360ps5/pending_resume.hpp b/include/xbox360ps5/pending_resume.hpp
new file mode 100644
--- /dev/null
+++ b/include/xbox360ps5/pending_resume.hpp
@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: MIT
+// Fix 71 (tools/source-1.0.2/fixes/71-pending-resume.patch): a resume that reaches a thread just
+// before it suspends itself is kept for that suspension.
+//
+// Ninja Gaiden II on 1.0.4_candidate_26 went black after 203 s: two job threads were suspended by
+// their own NtSuspendThread and the main thread spun on a flag only they clear. A worker that
+// says it is idle and then suspends itself, and a thread that sees it idle and resumes it, race:
+// when the resume comes between the two, it finds a suspend count of 0 and does nothing, and the
+// worker then sleeps with no one left to wake it. The console's timing makes that window small;
+// here a kernel call costs more (the trampoline, SelfSuspend's lock and condition variable), and
+// tools/check-pending-resume.cpp reproduces the hang within a fraction of a second.
+//
+// A resume that finds a count of 0 now leaves a credit on the thread (Note); a suspension of the
+// thread by itself within kWindowNs of it takes the credit (Take) and returns at once, as if it had
+// been suspended and resumed. Remote suspensions and resumes of suspended threads are unchanged.
+// A credit is taken once and lapses after the window, so a thread that suspends itself later
+// still sleeps until resumed.
+#pragma once
+#include <atomic>
+#include <cstdint>
+
+namespace xbox360ps5::pending_resume {
+
+inline constexpr int64_t kWindowNs = 10'000'000;  // 10 ms: a thread preempted between saying it is idle and suspending still gets it
+
+class Credit {
+ public:
+  void Note(int64_t now_ns) { at_.store(now_ns ? now_ns : 1, std::memory_order_release); }
+  // A resume noted within kWindowNs before now, taken once.
+  bool Take(int64_t now_ns) {
+    const int64_t at = at_.exchange(0, std::memory_order_acq_rel);
+    return at && now_ns >= at && now_ns - at <= kWindowNs;
+  }
+
+ private:
+  std::atomic<int64_t> at_{0};
+};
+
+}  // namespace xbox360ps5::pending_resume
diff --git a/include/xbox360ps5/suspend_trace.hpp b/include/xbox360ps5/suspend_trace.hpp
--- a/include/xbox360ps5/suspend_trace.hpp
+++ b/include/xbox360ps5/suspend_trace.hpp
@@ -27,6 +27,7 @@ enum Kind : uint8_t {
   kSuspendedBy,      // by another thread
   kResumedBy,        // by another thread, count before (>0)
   kResumeFoundRunning,  // a resume found count 0: nothing happened
+  kSuspendCancelled,    // fix 71: its own suspension took that resume's credit
 };
 inline const char* KindName(uint8_t kind) {
   switch (kind) {
@@ -35,6 +36,7 @@ inline const char* KindName(uint8_t kind) {
     case kSuspendedBy: return "suspended by";
     case kResumedBy: return "resumed by";
     case kResumeFoundRunning: return "EARLY resume (count 0) by";
+    case kSuspendCancelled: return "suspension cancelled by the early resume";
     default: return "?";
   }
 }
