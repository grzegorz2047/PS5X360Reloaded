+  }
+  // Fix 106: calibration restarts and picture changes, for the page's report.
+  note(cause, width, height) {
+    this.events.push({cause, width: finite(width) ? width : 0, height: finite(height) ? height : 0});
+    if (this.events.length > 8) this.events.shift();
