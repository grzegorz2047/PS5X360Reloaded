+// Fix 106 (Kinect Sports): the page's frames without a body by reason, the ones that kept a body
+// with inferred hips, and the tracker's calibration restarts, from the same report:
+//   "reasons":{"no_landmarks":0,"stale":0,"no_body":40,...},"restarts":"recentre 640x480"
+// "Motion: phone frames without a body, last 2 s: no_body 40; kept with hips inferred 120;
+// calibration restarted: recentre 640x480"; nothing when there was none of them.
+inline constexpr const char* kReasons[] = {"no_landmarks", "stale", "no_body", "out_of_range", "out_of_order",
+                                           "hips_inferred", "hips_hidden"};
+inline std::optional<std::string> ReasonsLine(const std::string& json) {
+  if (json.empty() || json.size() > kMaxBody || json.front() != '{') return std::nullopt;
+  const size_t open = json.find("\"reasons\":{");
+  std::string lost, kept;
+  if (open != std::string::npos) {
+    const size_t close = json.find('}', open);
+    if (close == std::string::npos) return std::nullopt;
+    const std::string reasons = json.substr(open, close - open + 1);
+    for (size_t n = 0; n < 7; ++n) {
+      double v = 0;
+      if (!Numbers(reasons, kReasons[n], &v, 1) || v < 1) continue;
+      std::string& to = n < 5 ? lost : kept;
+      char part[48];
+      std::snprintf(part, sizeof(part), "%s%s %.0f", to.empty() ? "" : ", ",
+                    n == 5 ? "hips inferred" : n == 6 ? "hips hidden" : kReasons[n], v);
+      to += part;
+    }
+  }
+  std::string restarts;
+  const std::string key = "\"restarts\":\"";
+  if (const size_t at = json.find(key); at != std::string::npos) {
+    for (size_t p = at + key.size(); p < json.size() && json[p] != '"' && restarts.size() < 120; ++p) {
+      const char c = json[p];
+      if ((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' || c == ' ' || c == ',') restarts += c;
+    }
+  }
+  if (lost.empty() && kept.empty() && restarts.empty()) return std::nullopt;
+  std::string line = "Motion: phone frames without a body, last 2 s: " + (lost.empty() ? std::string("none") : lost);
+  if (!kept.empty()) line += "; kept with " + kept;
+  if (!restarts.empty()) line += "; calibration restarted: " + restarts;
+  return line;
+}
