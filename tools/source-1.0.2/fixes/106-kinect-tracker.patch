+    if (lean.z > .15) this.states.add('lean_forward');
+    else if (lean.z < -.12) this.states.add('lean_back');
+    if (Math.abs(lean.x) > .14) this.states.add('lean_side');
+    this.previous = {t, points};
+  }
+}
