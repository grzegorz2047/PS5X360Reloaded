+      joint.y += root.y;
+      joint.z += BODY_DISTANCE - root.distance;
+    }
+    if (pose.joints.some(j => ![j.x, j.y, j.z].every(finite) || Math.abs(j.x) > 4 || Math.abs(j.y) > 4 || Math.abs(j.z) > 4))
