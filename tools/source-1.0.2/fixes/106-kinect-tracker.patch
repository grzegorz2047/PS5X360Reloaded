+  }
+
+  status(reason, root = null) {
+    const progress = this.calibration ? 1 : this.samples.length >= 2 ?
+      clamp(Math.min(this.samples.length / CALIBRATION_FRAMES, (this.samples.at(-1).t - this.samples[0].t) / CALIBRATION_MS), 0, 1) : 0;
