+      this.rootTime = t;
+    } else if (this.calibration && t - this.rootTime > ROOT_HOLD_MS) {
+      // Fix 106: the body keeps its last place while the hips cannot be placed (it was dropped
+      // here after ROOT_HOLD_MS); the page warns the player to step back.
+      reason = 'hips_hidden';
+    }
+    const root = this.calibration && this.root ? this.root :
+      {x: 0, y: 0, distance: this.calibrateFrom ?? BODY_DISTANCE};  // fix 106: no jump to 2.5 m
