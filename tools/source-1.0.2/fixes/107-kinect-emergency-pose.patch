+// Fix 107: a re-centre asked on the PS5 (L3 + R3 pressed briefly): its sequence number and
+// countdown come in the console's answers (frames, status); the page counts down, then re-centres
+// once, and reports the number it ran ("recentred").
+export class RecentreState {
+  constructor() { this.seen = 0; this.pending = 0; this.due = 0; this.done = 0; }
+  // json: a console answer; now: performance.now(). True when a new request starts its countdown.
+  note(json, now) {
+    const seq = Number(json?.recentre), ms = Number(json?.recentre_in_ms);
+    if (!Number.isInteger(seq) || seq <= this.seen) return false;
+    this.seen = seq;
+    this.pending = seq;
+    this.due = now + (Number.isFinite(ms) ? Math.min(Math.max(ms, 0), 10000) : 3000);
+    return true;
+  }
+  // Whole seconds left to show; 0 when none is counting down.
+  remaining(now) { return this.pending ? Math.max(1, Math.ceil((this.due - now) / 1000)) : 0; }
+  // True once, when the countdown is over.
+  fire(now) {
+    if (!this.pending || now < this.due) return false;
+    this.done = this.pending;
+    this.pending = 0;
+    return true;
+  }
+}
