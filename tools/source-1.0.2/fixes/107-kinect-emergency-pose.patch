+// Fix 107: re-centring the phone camera from the pad (L3 + R3 pressed briefly, motion_emergency.hpp)
+// instead of walking to the phone. Each request has a sequence number and a countdown for the player
+// to get into place; the page learns of it in the console's answers to its frames and in the status
+// (RecentreJson) and says in its 2 s report which one it ran (AckRecentre). A request waits at most
+// kRecentreAnswerMs past its countdown.
+constexpr int64_t kRecentreCountdownMs = 3000, kRecentreAnswerMs = 10000;
+inline std::atomic<uint32_t> recentre_seq{0}, recentre_acked{0};
+inline std::atomic<int64_t> recentre_due_ms{0};
+inline int64_t SteadyMs() {
+  return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+inline uint32_t RequestRecentre(int64_t now_ms) {
+  recentre_due_ms = now_ms + kRecentreCountdownMs;
+  uint32_t seq = recentre_seq.load() + 1;
+  if (!seq) seq = 1;
+  recentre_seq = seq;
+  return seq;
+}
+inline bool RecentrePending(int64_t now_ms) {
+  const uint32_t seq = recentre_seq.load();
+  return seq && seq != recentre_acked.load() && now_ms <= recentre_due_ms.load() + kRecentreAnswerMs;
+}
+inline int64_t RecentreRemainingMs(int64_t now_ms) {
+  const int64_t left = recentre_due_ms.load() - now_ms;
+  return left > 0 ? left : 0;
+}
+// ",\"recentre\":N,\"recentre_in_ms\":M" while a request waits for the phone; "" otherwise.
+inline std::string RecentreJson(int64_t now_ms) {
+  if (!RecentrePending(now_ms)) return "";
+  return ",\"recentre\":" + std::to_string(recentre_seq.load()) + ",\"recentre_in_ms\":" +
+         std::to_string(RecentreRemainingMs(now_ms));
+}
+// The page ran request `seq`: true the first time (for the log).
+inline bool AckRecentre(uint32_t seq) {
+  if (!seq || seq > recentre_seq.load() || seq == recentre_acked.load()) return false;
+  recentre_acked = seq;
+  return true;
+}
 inline Frame Snapshot() {
   if (!enabled.load()) return {};
   std::lock_guard lock(mutex);
@@ -129,6 +167,6 @@ inline std::string Status() {
     ",\"guest_skeleton_bodies\":" + std::to_string(guest_skeleton_bodies.load()) +
     ",\"refused\":" + RefusedJson() +
     ",\"frames_without_body\":" + std::to_string(frames_without_body.load()) +
-    ",\"bodies_lost\":" + std::to_string(bodies_lost.load()) + "}";
+    ",\"bodies_lost\":" + std::to_string(bodies_lost.load()) + RecentreJson(SteadyMs()) + "}";  // fix 107
 }
 }
