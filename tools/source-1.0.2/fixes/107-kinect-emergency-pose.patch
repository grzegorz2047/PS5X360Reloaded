diff --git a/include/xbox360ps5/motion_emergency.hpp b/include/xbox360ps5/motion_emergency.hpp
new file mode 100644
index 0000000..2cd7839
--- /dev/null
+++ b/include/xbox360ps5/motion_emergency.hpp
@@ -0,0 +1,169 @@
+// SPDX-License-Identifier: MIT
+// Fix 107 (Kinect Sports, issue 15): a way out of a Kinect game's "player lost" pause.
+//
+// A Kinect game pauses while its sensor reports no player (Kinect Sports: "Pick main player",
+// then a pause once the phone lost the body), and only a body brings it back. When the phone
+// cannot find the player again, holding L3 + R3 (both stick clicks; no game is expected to use
+// the pair, and neither is the guide's) for kHoldToStart makes the virtual sensor publish the
+// last body it published (a standing body at the sensor's 2.5 m when there was none), tracked,
+// in the same phone session, so the title keeps its tracking id and its player binding. It ends
+// when the phone sends a body (which takes over in that same session: no new tracking id, no
+// identity notification), when the buttons are let go, or after kLimit.
+//
+// The same pair pressed briefly (let go within kHoldToStart, the emergency body not started)
+// asks the phone page to re-centre its camera (motion_input.hpp, RequestRecentre), so the player
+// does not walk to the phone: that walk is how the phone's distance ended up at its near limit.
+//
+// Nothing here knows the title: the trigger is the virtual sensor's own state (a game reading
+// skeletons, no body published for kNoBodyFor). Called from the pad thread (Pad) and from the
+// title's skeleton reads (Apply, once per sensor period), so it has its own lock.
+#pragma once
+#include <chrono>
+#include <cstdint>
+#include <mutex>
+
+#include "xbox360ps5/motion_input.hpp"
+
+namespace xbox360ps5::motion {
+
+constexpr std::chrono::milliseconds kNoBodyFor{3000}, kHoldToStart{500}, kEmergencyLimit{10000};
+constexpr uint32_t kEmergencyButtons = 0x02 | 0x04;  // DualSense L3 | R3 (dualsense_input.cpp)
+
+// A standing body in the bridge's hip-relative metres (pose.mjs order, picture-right +X, up +Y),
+// arms down, for a player the sensor never saw.
+inline Frame StandingBody(uint32_t session) {
+  static constexpr float joints[20][3] = {
+      {0, 0, 0},         {0, .24f, 0},      {0, .48f, 0},      {0, .66f, .04f},   // hips, spine, shoulders, head
+      {.19f, .48f, 0},   {.22f, .2f, 0},    {.23f, -.06f, 0},  {.23f, -.145f, 0},  // left arm
+      {-.19f, .48f, 0},  {-.22f, .2f, 0},   {-.23f, -.06f, 0}, {-.23f, -.145f, 0}, // right arm
+      {.1f, 0, 0},       {.11f, -.45f, 0},  {.11f, -.88f, 0},  {.11f, -.93f, .1f}, // left leg
+      {-.1f, 0, 0},      {-.11f, -.45f, 0}, {-.11f, -.88f, 0}, {-.11f, -.93f, .1f}, // right leg
+  };
+  Frame frame;
+  for (int n = 0; n < 20; ++n) frame.joints[n] = {joints[n][0], joints[n][1], joints[n][2], 1.0f};
+  frame.tracked = true;
+  frame.session = session ? session : 1;
+  frame.sequence = 1;
+  return frame;
+}
+
+enum class EmergencyEvent { kNone, kOn, kOffBody, kOffReleased, kOffLimit };
+
+class EmergencyPose {
+ public:
+  using Clock = std::chrono::steady_clock;
+
+  // The pad thread: whether L3 and R3 are both down now. True when they were just let go after a
+  // brief press that did not start the emergency body: a re-centre request.
+  bool Pad(bool both_down, Clock::time_point now) {
+    std::lock_guard lock(mutex_);
+    bool press = false;
+    if (both_down && !held_) {
+      held_since_ = now;
+      started_in_hold_ = false;
+    } else if (!both_down && held_) {
+      press = now - held_since_ < kHoldToStart && !started_in_hold_ && !active_;
+    }
+    held_ = both_down;
+    return press;
+  }
+
+  // The title's skeleton read: `real` is the body the sensor would publish. Returns the one to
+  // publish; `event` says what changed (for the log).
+  Frame Apply(const Frame& real, Clock::time_point now, EmergencyEvent* event = nullptr) {
+    std::lock_guard lock(mutex_);
+    EmergencyEvent what = EmergencyEvent::kNone;
+    Frame out = real;
+    if (real.tracked) {
+      if (active_) {
+        active_ = false;
+        what = EmergencyEvent::kOffBody;
+        // The phone's body takes over in the session the title knows.
+        if (real.session != last_.session) alias_from_ = real.session, alias_to_ = last_.session;
+      }
+      if (alias_to_ && real.session == alias_from_) out.session = alias_to_;
+      last_ = out;
+      have_last_ = true;
+      last_body_ = now;
+    } else {
+      alias_from_ = alias_to_ = 0;  // a gap: the next body is a new one for the title anyway
+      if (active_ && !held_) {
+        active_ = false;
+        what = EmergencyEvent::kOffReleased;
+      } else if (active_ && now - active_since_ >= kEmergencyLimit) {
+        active_ = false;
+        what = EmergencyEvent::kOffLimit;
+        expired_ = true;  // not again until the buttons are let go
+      } else if (!active_ && held_ && !expired_ && now - held_since_ >= kHoldToStart && NoBodyLocked(now)) {
+        active_ = true;
+        active_since_ = now;
+        started_in_hold_ = true;
+        what = EmergencyEvent::kOn;
+      }
+      if (!held_) expired_ = false;
+      if (active_) {
+        out = have_last_ ? last_ : StandingBody(real.session);
+        out.tracked = true;
+        out.received = now;
+      }
+    }
+    seen_reads_ = true;
+    if (event) *event = what;
+    return out;
+  }
+
+  // The depth camera and other readers: the emergency body while it is on, else `real`.
+  Frame Overlay(const Frame& real) const {
+    std::lock_guard lock(mutex_);
+    if (!active_ || real.tracked) return real;
+    Frame out = have_last_ ? last_ : StandingBody(real.session);
+    out.tracked = true;
+    out.received = Clock::now();
+    return out;
+  }
+
+  // The overlay's hint: a game reads skeletons, none has had a body for kNoBodyFor, and the
+  // emergency body is not on.
+  bool HintVisible(Clock::time_point now) const {
+    std::lock_guard lock(mutex_);
+    return seen_reads_ && !active_ && NoBodyLocked(now);
+  }
+  bool Active() const {
+    std::lock_guard lock(mutex_);
+    return active_;
+  }
+  // A new game, or the camera setting switched: forget the last body.
+  void Reset() {
+    std::lock_guard lock(mutex_);
+    last_ = {};
+    have_last_ = active_ = expired_ = seen_reads_ = false;
+    last_body_ = active_since_ = Clock::time_point{};
+    alias_from_ = alias_to_ = 0;
+  }
+
+ private:
+  bool NoBodyLocked(Clock::time_point now) const {
+    return !have_last_ || now - last_body_ > kNoBodyFor;
+  }
+
+  mutable std::mutex mutex_;
+  Frame last_;
+  bool have_last_ = false, active_ = false, held_ = false, expired_ = false, seen_reads_ = false;
+  bool started_in_hold_ = false;
+  Clock::time_point last_body_{}, active_since_{}, held_since_{};
+  uint32_t alias_from_ = 0, alias_to_ = 0;
+};
+
+inline EmergencyPose emergency_pose;
+
+inline const char* EmergencyEventName(EmergencyEvent event) {
+  switch (event) {
+    case EmergencyEvent::kOn: return "on (L3 + R3 held, no body from the phone)";
+    case EmergencyEvent::kOffBody: return "off (the phone has a body again)";
+    case EmergencyEvent::kOffReleased: return "off (L3 + R3 let go)";
+    case EmergencyEvent::kOffLimit: return "off (10 s limit)";
+    default: return "";
+  }
+}
+
+}  // namespace xbox360ps5::motion
