+// Fix 156e (Kinect Sports Season Two, #63): the camera worker, which runs the title's frame
+// completion routines. KS2's sport load left three frame reads queued that were never
+// completed, with nothing in the log saying why. Now the status line says which guest routine
+// the worker is inside and for how long (0 when it is not in one), how many reads it put back
+// for want of a frame, how many it completed with a failure, and how many depth reads it
+// answered packed (11-bit, 0x67200 bytes).
+inline std::atomic<uint32_t> camera_worker_routine{0};
+inline std::atomic<int64_t> camera_worker_since_ms{0};
+inline std::atomic<uint64_t> camera_reads_requeued{0}, camera_reads_failed{0},
+    camera_reads_packed{0};
+inline std::string CameraWorkerJson(int64_t now_ms) {
+  const uint32_t routine = camera_worker_routine.load();
+  const int64_t since = camera_worker_since_ms.load();
+  char text[200];
+  std::snprintf(text, sizeof(text),
+                ",\"camera_worker\":{\"routine\":\"%08X\",\"busy_ms\":%lld,\"requeued\":%llu,"
+                "\"failed\":%llu,\"packed_depth\":%llu}",
+                routine, routine && since ? (long long)(now_ms - since) : 0LL,
+                (unsigned long long)camera_reads_requeued.load(),
+                (unsigned long long)camera_reads_failed.load(),
+                (unsigned long long)camera_reads_packed.load());
+  return text;
+}
