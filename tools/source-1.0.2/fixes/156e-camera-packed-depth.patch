+// Fix 156e: how much of a depth frame a read's buffer takes: 16-bit samples (640 x 480 x 2 =
+// 0x96000 bytes) when it holds them, else the packed frame as the sensor sends it (11-bit
+// samples, 0x67200 bytes), else none (the read fails). The NUI library's read completion
+// takes either size (KS2 82A645F0: 0x96000, or 0x67200 marked packed).
+constexpr uint32_t kDepthUnpackedBytes = 640 * 480 * 2, kDepthPackedBytes = 640 * 480 * 11 / 8;
+inline uint32_t DepthReadBytes(uint32_t buffer_size) {
+  if (buffer_size >= kDepthUnpackedBytes) return kDepthUnpackedBytes;
+  if (buffer_size >= kDepthPackedBytes) return kDepthPackedBytes;
+  return 0;
+}
