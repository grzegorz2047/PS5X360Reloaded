diff --git a/include/xbox360ps5/install_notice.hpp b/include/xbox360ps5/install_notice.hpp
new file mode 100644
--- /dev/null
+++ b/include/xbox360ps5/install_notice.hpp
@@ -0,0 +1,145 @@
+// SPDX-License-Identifier: MIT
+// Fix 148h: a game that ends on its dirty-disc error after fix 148e refused a cut-short package of
+// it gets an explanation in the library, instead of a silent return.
+//
+// Grand Theft Auto V with an install that had stopped half-way (part1 948 MB of 2.1 GB): 148e no
+// longer mounted the cut package, the game took that part from the disc, and with part0 installed
+// and the rest from the disc it showed its dirty-disc error; the emulator went back to the library
+// without a word. The game does not offer to install again while any of its install packages is
+// on a drive. Now:
+//  * the core notes the host path of each package it refused as cut short (NoteRefused);
+//  * on the dirty-disc path it reads those files' headers, and for the first that is still cut
+//    short writes <data>/install-notice.txt: the game's name, the package's name (the header's
+//    display name, else the file name), the bytes it has and the bytes its header needs;
+//  * the library shows that once, as a message naming the game's sheet's DLCs tab and its Remove
+//    action in the player's language (the steps the player takes; nothing is deleted for them),
+//    then removes the file.
+#pragma once
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "xbox360ps5/stfs_size.hpp"
+
+namespace xbox360ps5::install_notice {
+
+struct Notice {
+  std::string game, package;
+  uint64_t have = 0, need = 0;
+};
+
+inline std::string FileName(const std::string& data_root) { return data_root + "/install-notice.txt"; }
+
+// One value per line; a value cannot hold a line break.
+inline std::string Clean(std::string text) {
+  for (char& c : text)
+    if (c == '\n' || c == '\r') c = ' ';
+  return text;
+}
+inline std::string Serialize(const Notice& n) {
+  return "game=" + Clean(n.game) + "\npackage=" + Clean(n.package) + "\nhave=" + std::to_string(n.have) +
+         "\nneed=" + std::to_string(n.need) + "\n";
+}
+inline std::optional<Notice> Parse(const std::string& text) {
+  Notice n;
+  bool have = false, need = false;
+  size_t at = 0;
+  while (at < text.size()) {
+    size_t end = text.find('\n', at);
+    if (end == std::string::npos) end = text.size();
+    std::string line = text.substr(at, end - at);
+    if (!line.empty() && line.back() == '\r') line.pop_back();
+    at = end + 1;
+    const size_t eq = line.find('=');
+    if (eq == std::string::npos) continue;
+    const std::string key = line.substr(0, eq), value = line.substr(eq + 1);
+    if (key == "game") n.game = value;
+    else if (key == "package") n.package = value;
+    else if (key == "have") have = !value.empty(), n.have = std::strtoull(value.c_str(), nullptr, 10);
+    else if (key == "need") need = !value.empty(), n.need = std::strtoull(value.c_str(), nullptr, 10);
+  }
+  if (n.game.empty() || n.package.empty() || !have || !need || n.have >= n.need) return std::nullopt;
+  return n;
+}
+
+// From a package's first 0x511 bytes: the size its STFS header says the file has (0 when not an
+// STFS package) and its display name (UTF-16BE at 0x411, ASCII kept, others as '?').
+inline uint32_t Be32(const unsigned char* p) {
+  return uint32_t(p[0]) << 24 | uint32_t(p[1]) << 16 | uint32_t(p[2]) << 8 | uint32_t(p[3]);
+}
+inline uint64_t ExpectedSize(const unsigned char* b, size_t size) {
+  if (size < 0x511) return 0;
+  const bool magic = (b[0] == 'C' && b[1] == 'O' && b[2] == 'N' && b[3] == ' ') ||
+                     (b[0] == 'L' && b[1] == 'I' && b[2] == 'V' && b[3] == 'E') ||
+                     (b[0] == 'P' && b[1] == 'I' && b[2] == 'R' && b[3] == 'S');
+  if (!magic || Be32(b + 0x3A9) != 0) return 0;
+  const uint64_t header = (uint64_t(Be32(b + 0x340)) + 0xFFF) & ~uint64_t(0xFFF);
+  const uint32_t blocks = Be32(b + 0x379 + 0x1C);
+  if (!blocks) return 0;
+  return header + stfs_size::DataNeeded(blocks, (b[0x379 + 2] & 1) ? 1 : 2);
+}
+inline std::string DisplayName(const unsigned char* b, size_t size) {
+  std::string name;
+  for (size_t i = 0; i < 128 && 0x412 + 2 * i < size; ++i) {
+    const unsigned c = unsigned(b[0x411 + 2 * i]) << 8 | b[0x412 + 2 * i];
+    if (!c) break;
+    name += c < 0x80 ? char(c) : '?';
+  }
+  return name;
+}
+
+// A package file on the host: its notice when it is cut short.
+inline std::optional<Notice> Check(const std::string& path, const std::string& game) {
+  std::ifstream file(path, std::ios::binary | std::ios::ate);
+  if (!file) return std::nullopt;
+  const uint64_t size = uint64_t(file.tellg());
+  file.seekg(0);
+  unsigned char header[0x511] = {};
+  if (!file.read(reinterpret_cast<char*>(header), sizeof(header))) return std::nullopt;
+  const uint64_t need = ExpectedSize(header, sizeof(header));
+  if (!need || size >= need) return std::nullopt;
+  Notice n;
+  n.game = game;
+  n.package = DisplayName(header, sizeof(header));
+  if (n.package.empty()) {
+    const size_t slash = path.find_last_of("/\\");
+    n.package = slash == std::string::npos ? path : path.substr(slash + 1);
+  }
+  n.have = size;
+  n.need = need;
+  return n;
+}
+
+// The packages fix 148e refused in this session (host paths), for the dirty-disc path.
+struct Refused {
+  std::mutex mutex;
+  std::vector<std::string> paths;
+};
+inline Refused refused;
+inline void NoteRefused(const std::string& path) {
+  std::lock_guard<std::mutex> lock(refused.mutex);
+  for (const auto& p : refused.paths)
+    if (p == path) return;
+  if (refused.paths.size() < 32) refused.paths.push_back(path);
+}
+inline std::vector<std::string> RefusedPaths() {
+  std::lock_guard<std::mutex> lock(refused.mutex);
+  return refused.paths;
+}
+
+// The message: the English key's placeholders are the game, the package, the two sizes, the DLCs
+// tab's name and the Remove action's, in that order (every translation keeps that order).
+inline std::string Message(const char* format, const Notice& n, const std::string& have, const std::string& need,
+                           const char* tab, const char* remove) {
+  char text[1024];
+  std::snprintf(text, sizeof(text), format, n.game.c_str(), n.package.c_str(), have.c_str(), need.c_str(), tab,
+                remove);
+  return text;
+}
+
+}  // namespace xbox360ps5::install_notice
