+namespace {
+// The family of a font: its source's name before ", <size>px" (ImFontAtlas names each source so).
+std::string_view Family(const ImFont* font) {
+  const std::string_view name = font ? font->GetDebugName() : "";
+  return name.substr(0, name.find(','));
+}
+bool Covers(ImFont* font, const char* text) {
+  if (!text) return true;
+  for (char16_t c : xe::to_utf16(text))
+    if (c >= 0x20 && !font->FindGlyphNoFallback(ImWchar(c))) return false;
+  return true;
+}
+}  // namespace
+
+ImFont* KeyboardFont(float size, const char* text) {
+  // Fix 114b: the interface's own family (the launcher's FontDefault, which covers the 16
+  // languages), the loaded size nearest; never another family that happens to be loaded at that
+  // size: the core's monospace font has no Polish letters, and the legend read "Usu?". Within the
+  // family, a size that lacks one of the text's letters gives way to the default font.
+  ImGuiIO& io = ImGui::GetIO();
+  ImFont* base = io.FontDefault ? io.FontDefault : ImGui::GetFont();
+  ImFont* best = base;
+  float distance = FLT_MAX;
+  for (ImFont* font : io.Fonts->Fonts) {
+    if (Family(font) != Family(base)) continue;
+    const float d = std::fabs(font->FontSize - size);
+    if (d < distance) { distance = d; best = font; }
+  }
+  return Covers(best, text) ? best : base;
+}
