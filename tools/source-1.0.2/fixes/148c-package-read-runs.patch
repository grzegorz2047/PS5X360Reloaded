diff --git a/include/xbox360ps5/package_io.hpp b/include/xbox360ps5/package_io.hpp
new file mode 100644
index 0000000..10b5296
--- /dev/null
+++ b/include/xbox360ps5/package_io.hpp
@@ -0,0 +1,112 @@
+// SPDX-License-Identifier: MIT
+// Fix 148c: reads of files inside a content package (STFS/SVOD), and what an install costs.
+//
+// Grand Theft Auto V's install (fix 148: four PIRS packages read from the disc image) copied
+// about 2 MB/s on the console's M.2 drive. A file inside a package was read one 4 KiB package
+// block at a time: XContentContainerFile::ReadSync called the device's Read once per block record,
+// and each went down to a pread of the disc image (no cache), so a 1 MiB guest read took 256
+// host reads. Records that follow each other in the same backing file are now read as one run:
+// an STFS package keeps its data blocks contiguous between its hash blocks (170 blocks, 680 KiB),
+// so a 1 MiB read takes two or three host reads.
+//
+// The 30 s line measures an install: guest package reads (calls, bytes), the host reads they took
+// and their time; host file writes (calls, bytes, time); and the KeDelayExecutionThread calls of
+// threads that read a package in the last second (calls, the intervals asked for). It is written
+// only for a period with package reads, so games that read no package never show it.
+#pragma once
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+#include <vector>
+
+namespace xbox360ps5::package_io {
+
+struct Piece {
+  size_t file = 0;
+  size_t offset = 0;
+  size_t length = 0;
+};
+
+// Adds the next piece of a read, merged into the last run when it continues it in the same file.
+inline void AddPiece(std::vector<Piece>& runs, const Piece& piece) {
+  if (!piece.length) return;
+  if (!runs.empty()) {
+    Piece& last = runs.back();
+    if (last.file == piece.file && last.offset + last.length == piece.offset) {
+      last.length += piece.length;
+      return;
+    }
+  }
+  runs.push_back(piece);
+}
+
+struct Counters {
+  std::atomic<uint64_t> guest_reads{0}, read_bytes{0}, host_reads{0}, read_ns{0};
+  std::atomic<uint64_t> writes{0}, write_bytes{0}, write_ns{0};
+  std::atomic<uint64_t> delays{0}, delay_100ns{0};
+  std::atomic<uint64_t> last_report_ns{0};
+};
+inline Counters counters;
+
+// One period's numbers, taken (and reset) together.
+struct Period {
+  uint64_t guest_reads = 0, read_bytes = 0, host_reads = 0, read_ns = 0;
+  uint64_t writes = 0, write_bytes = 0, write_ns = 0;
+  uint64_t delays = 0, delay_100ns = 0;
+};
+
+inline Period Take(Counters& c) {
+  Period p;
+  p.guest_reads = c.guest_reads.exchange(0);
+  p.read_bytes = c.read_bytes.exchange(0);
+  p.host_reads = c.host_reads.exchange(0);
+  p.read_ns = c.read_ns.exchange(0);
+  p.writes = c.writes.exchange(0);
+  p.write_bytes = c.write_bytes.exchange(0);
+  p.write_ns = c.write_ns.exchange(0);
+  p.delays = c.delays.exchange(0);
+  p.delay_100ns = c.delay_100ns.exchange(0);
+  return p;
+}
+
+// Whether a report is due at now_ns (30 s after the last one; the first period starts at the first
+// read). Only one caller wins a period.
+inline bool Due(Counters& c, uint64_t now_ns, uint64_t period_ns = 30000000000ull) {
+  uint64_t last = c.last_report_ns.load();
+  if (!last) {
+    c.last_report_ns.compare_exchange_strong(last, now_ns);
+    return false;
+  }
+  if (now_ns - last < period_ns) return false;
+  return c.last_report_ns.compare_exchange_strong(last, now_ns);
+}
+
+inline std::string Describe(const Period& p, double seconds) {
+  const auto per = [](uint64_t total, uint64_t count) { return count ? double(total) / double(count) : 0.0; };
+  char text[640];
+  std::snprintf(
+      text, sizeof(text),
+      "Package I/O (fix 148c), last %.0f s: guest reads of package files %llu (%.1f MiB, %.0f KiB "
+      "each, %.2f MiB/s), host reads %llu (%.0f KiB each), read time %.0f ms (%.0f us per guest "
+      "read); host file writes %llu (%.1f MiB, %.0f KiB each), write time %.0f ms (%.0f us each); "
+      "KeDelayExecutionThread of the reading threads %llu (%.1f ms asked each, %.0f ms in all)",
+      seconds, (unsigned long long)p.guest_reads, double(p.read_bytes) / 1048576.0,
+      per(p.read_bytes, p.guest_reads) / 1024.0,
+      seconds > 0 ? double(p.read_bytes) / 1048576.0 / seconds : 0.0,
+      (unsigned long long)p.host_reads, per(p.read_bytes, p.host_reads) / 1024.0,
+      double(p.read_ns) / 1e6, per(p.read_ns, p.guest_reads) / 1e3,
+      (unsigned long long)p.writes, double(p.write_bytes) / 1048576.0,
+      per(p.write_bytes, p.writes) / 1024.0, double(p.write_ns) / 1e6, per(p.write_ns, p.writes) / 1e3,
+      (unsigned long long)p.delays, per(p.delay_100ns, p.delays) / 1e4, double(p.delay_100ns) / 1e4);
+  return text;
+}
+
+// A thread that read a package file within the last second counts its delays.
+inline thread_local uint64_t last_package_read_ns = 0;
+inline bool ReaderThread(uint64_t now_ns) {
+  return last_package_read_ns && now_ns - last_package_read_ns < 1000000000ull;
+}
+
+}  // namespace xbox360ps5::package_io
