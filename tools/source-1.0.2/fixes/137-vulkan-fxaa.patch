+
+// Xbox360PS5 (fix 137): FXAA for the Vulkan swap, as a graphics pass (the
+// guest output image has no storage usage, so not as D3D12's fxaa.cs.hlsl).
+// The pixel shader of fxaa.ps.glsl and fxaa_extreme.ps.glsl, which set:
+// - FXAA_QUALITY__PRESET
+// - FXAA_QUALITY__SUBPIX
+// - FXAA_QUALITY__EDGE_THRESHOLD
+// - FXAA_QUALITY__EDGE_THRESHOLD_MIN
+// (the values of fxaa.cs.hlsl and fxaa_extreme.cs.hlsl).
+//
+// The source is the swap's intermediate image written by
+// apply_gamma_{table,pwl}_fxaa_luma.ps: RGB after the gamma ramp, A the
+// perceptual luma, sampled with a linear clamp-to-edge sampler. The pass draws
+// fullscreen_cw.vs into the guest output image, whose size is the source's.
+
+#define FXAA_PC 1
+#define FXAA_GLSL_130 1
+// Luma in alpha, as apply_gamma_*_fxaa_luma writes it.
+#define FXAA_GREEN_AS_LUMA 0
+// textureGather is core in GLSL 4.00+ and Vulkan (as FXAA_HLSL_5 does in D3D12).
+#define FXAA_GATHER4_ALPHA 1
+#include "../../../../third_party/fxaa/FXAA3_11.h"
+
+layout(push_constant) uniform XeFxaaConstants {
+  // 1 / the source's width and height.
+  vec2 size_inv;
+} xe_fxaa_constants;
+
+layout(set = 0, binding = 0) uniform sampler2D xe_fxaa_source;
+
+layout(location = 0) out vec4 xe_fxaa_dest;
+
+void main() {
+  vec2 size_inv = xe_fxaa_constants.size_inv;
+  // gl_FragCoord.xy is the pixel's center, (x + 0.5, y + 0.5).
+  vec2 position = gl_FragCoord.xy * size_inv;
+  // Force alpha to 1 as D3D12 does: the presenter does not need it.
+  xe_fxaa_dest = vec4(
+      FxaaPixelShader(
+          position, vec4(0.0), xe_fxaa_source, xe_fxaa_source, xe_fxaa_source,
+          size_inv, vec4(0.0), vec4(0.0), vec4(0.0), FXAA_QUALITY__SUBPIX,
+          FXAA_QUALITY__EDGE_THRESHOLD, FXAA_QUALITY__EDGE_THRESHOLD_MIN, 8.0,
+          0.125, 0.05, vec4(1.0, -1.0, 0.25, -0.25))
+          .rgb,
+      1.0);
+}
