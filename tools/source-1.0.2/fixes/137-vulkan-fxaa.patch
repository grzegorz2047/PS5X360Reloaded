+// Xbox360PS5 (fix 137): FXAA for the swap (swap_fxaa.h).
+static_assert(uint32_t(CommandProcessor::SwapPostEffect::kNone) ==
+                  uint32_t(swap_fxaa::Effect::kNone),
+              "swap_fxaa::Effect follows SwapPostEffect");
+static_assert(uint32_t(CommandProcessor::SwapPostEffect::kFxaa) ==
+                  uint32_t(swap_fxaa::Effect::kFxaa),
+              "swap_fxaa::Effect follows SwapPostEffect");
+static_assert(uint32_t(CommandProcessor::SwapPostEffect::kFxaaExtreme) ==
+                  uint32_t(swap_fxaa::Effect::kFxaaExtreme),
+              "swap_fxaa::Effect follows SwapPostEffect");
+
+bool VulkanCommandProcessor::PrepareSwapFxaa(SwapPostEffect effect,
+                                             uint32_t width, uint32_t height) {
+  // Intermediate images replaced or let go of earlier, once the GPU completed
+  // their last submission.
+  DestroyRetiredSwapFxaaSources(false);
+  const swap_fxaa::Effect fxaa_effect = swap_fxaa::Effect(uint32_t(effect));
+  bool ready = false;
+  if (fxaa_effect == swap_fxaa::Effect::kNone || !width || !height) {
+    // Off: the intermediate image (8 bytes per pixel) is not kept.
+    if (swap_fxaa_source_.image != VK_NULL_HANDLE) {
+      RetireSwapFxaaSource();
+    }
+    swap_fxaa_failed_width_ = 0;
+    swap_fxaa_failed_height_ = 0;
+  } else {
+    if (!swap_fxaa_pipelines_state_) {
+      swap_fxaa_pipelines_state_ = CreateSwapFxaaPipelines() ? 1 : -1;
+    }
+    if (swap_fxaa_pipelines_state_ > 0) {
+      if (swap_fxaa::NeedsNewSource(swap_fxaa_source_.width,
+                                    swap_fxaa_source_.height, width, height)) {
+        // 1x <-> 2x, or the game's own resolution changed.
+        if (swap_fxaa_source_.image != VK_NULL_HANDLE) {
+          RetireSwapFxaaSource();
+        }
+        if ((width != swap_fxaa_failed_width_ ||
+             height != swap_fxaa_failed_height_) &&
+            !CreateSwapFxaaSource(width, height)) {
+          swap_fxaa_failed_width_ = width;
+          swap_fxaa_failed_height_ = height;
+        }
+      }
+      ready = swap_fxaa_source_.framebuffer != VK_NULL_HANDLE;
+    }
+  }
+  const bool use_fxaa = swap_fxaa::UseFxaa(fxaa_effect, width, height, ready);
+  swap_fxaa::LineState line;
+  if (use_fxaa) {
+    line.effect = fxaa_effect;
+    line.width = width;
+    line.height = height;
+    line.format = swap_fxaa_format_;
+  }
+  if (!(line == swap_fxaa_line_)) {
+    swap_fxaa_line_ = line;
+    if (use_fxaa) {
+      XELOGW("Anti-aliasing (fix 137): {} on, {}x{}, intermediate image {}",
+             swap_fxaa::EffectName(fxaa_effect), width, height,
+             swap_fxaa::SourceFormatName(swap_fxaa_format_));
+    } else {
+      XELOGW("Anti-aliasing (fix 137): off");
+    }
+  }
+  return use_fxaa;
+}
+
+bool VulkanCommandProcessor::CreateSwapFxaaPipelines() {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanInstance::Functions& ifn =
+      vulkan_device->vulkan_instance()->functions();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+
+  // The intermediate image's format: rendered to and sampled with a linear
+  // filter.
+  constexpr VkFormatFeatureFlags kSourceFeatures =
+      VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BIT |
+      VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT |
+      VK_FORMAT_FEATURE_SAMPLED_IMAGE_FILTER_LINEAR_BIT;
+  VkFormatProperties rgba16f_properties, rgba8_properties;
+  ifn.vkGetPhysicalDeviceFormatProperties(vulkan_device->physical_device(),
+                                          VK_FORMAT_R16G16B16A16_SFLOAT,
+                                          &rgba16f_properties);
+  ifn.vkGetPhysicalDeviceFormatProperties(vulkan_device->physical_device(),
+                                          VK_FORMAT_R8G8B8A8_UNORM,
+                                          &rgba8_properties);
+  swap_fxaa_format_ = swap_fxaa::ChooseSourceFormat(
+      (rgba16f_properties.optimalTilingFeatures & kSourceFeatures) ==
+          kSourceFeatures,
+      (rgba8_properties.optimalTilingFeatures & kSourceFeatures) ==
+          kSourceFeatures);
+  switch (swap_fxaa_format_) {
+    case swap_fxaa::SourceFormat::kRgba16Float:
+      swap_fxaa_vk_format_ = VK_FORMAT_R16G16B16A16_SFLOAT;
+      break;
+    case swap_fxaa::SourceFormat::kRgba8Unorm:
+      swap_fxaa_vk_format_ = VK_FORMAT_R8G8B8A8_UNORM;
+      break;
+    default:
+      XELOGE(
+          "Anti-aliasing (fix 137): no format to render and filter the "
+          "intermediate image; the picture stays without FXAA");
+      return false;
+  }
+
+  // Pass 1's render pass, as swap_apply_gamma_render_pass_ with the
+  // intermediate format (explicit barriers around it).
+  VkAttachmentDescription luma_attachment = {};
+  luma_attachment.format = swap_fxaa_vk_format_;
+  luma_attachment.samples = VK_SAMPLE_COUNT_1_BIT;
+  luma_attachment.loadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+  luma_attachment.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+  luma_attachment.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+  luma_attachment.stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+  luma_attachment.initialLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+  luma_attachment.finalLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+  VkAttachmentReference luma_color_attachment;
+  luma_color_attachment.attachment = 0;
+  luma_color_attachment.layout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+  VkSubpassDescription luma_subpass = {};
+  luma_subpass.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+  luma_subpass.colorAttachmentCount = 1;
+  luma_subpass.pColorAttachments = &luma_color_attachment;
+  VkSubpassDependency luma_dependencies[2];
+  for (uint32_t i = 0; i < 2; ++i) {
+    VkSubpassDependency& luma_dependency = luma_dependencies[i];
+    luma_dependency.srcSubpass = i ? 0 : VK_SUBPASS_EXTERNAL;
+    luma_dependency.dstSubpass = i ? VK_SUBPASS_EXTERNAL : 0;
+    luma_dependency.srcStageMask = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT;
+    luma_dependency.dstStageMask = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT;
+    luma_dependency.srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+    luma_dependency.dstAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+    luma_dependency.dependencyFlags = VK_DEPENDENCY_BY_REGION_BIT;
+  }
+  VkRenderPassCreateInfo luma_render_pass_create_info = {};
+  luma_render_pass_create_info.sType = VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO;
+  luma_render_pass_create_info.attachmentCount = 1;
+  luma_render_pass_create_info.pAttachments = &luma_attachment;
+  luma_render_pass_create_info.subpassCount = 1;
+  luma_render_pass_create_info.pSubpasses = &luma_subpass;
+  luma_render_pass_create_info.dependencyCount =
+      uint32_t(xe::countof(luma_dependencies));
+  luma_render_pass_create_info.pDependencies = luma_dependencies;
+  if (dfn.vkCreateRenderPass(device, &luma_render_pass_create_info, nullptr,
+                             &swap_fxaa_luma_render_pass_) != VK_SUCCESS) {
+    XELOGE("Anti-aliasing (fix 137): the luma render pass was not made");
+    ShutdownSwapFxaa();
+    return false;
+  }
+
+  // The source's sampler, set layout (the sampler immutable), pipeline layout
+  // and a descriptor set per frame in flight.
+  VkSamplerCreateInfo sampler_create_info = {};
+  sampler_create_info.sType = VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO;
+  sampler_create_info.magFilter = VK_FILTER_LINEAR;
+  sampler_create_info.minFilter = VK_FILTER_LINEAR;
+  sampler_create_info.mipmapMode = VK_SAMPLER_MIPMAP_MODE_NEAREST;
+  sampler_create_info.addressModeU = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+  sampler_create_info.addressModeV = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+  sampler_create_info.addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+  sampler_create_info.maxAnisotropy = 1.0f;
+  sampler_create_info.minLod = 0.0f;
+  sampler_create_info.maxLod = 0.0f;
+  if (dfn.vkCreateSampler(device, &sampler_create_info, nullptr,
+                          &swap_fxaa_sampler_) != VK_SUCCESS) {
+    XELOGE("Anti-aliasing (fix 137): the sampler was not made");
+    ShutdownSwapFxaa();
+    return false;
+  }
+  VkDescriptorSetLayoutBinding source_binding;
+  source_binding.binding = 0;
+  source_binding.descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+  source_binding.descriptorCount = 1;
+  source_binding.stageFlags = VK_SHADER_STAGE_FRAGMENT_BIT;
+  source_binding.pImmutableSamplers = &swap_fxaa_sampler_;
+  VkDescriptorSetLayoutCreateInfo set_layout_create_info = {};
+  set_layout_create_info.sType =
+      VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO;
+  set_layout_create_info.bindingCount = 1;
+  set_layout_create_info.pBindings = &source_binding;
+  if (dfn.vkCreateDescriptorSetLayout(device, &set_layout_create_info, nullptr,
+                                      &swap_fxaa_descriptor_set_layout_) !=
+      VK_SUCCESS) {
+    XELOGE("Anti-aliasing (fix 137): the descriptor set layout was not made");
+    ShutdownSwapFxaa();
+    return false;
+  }
+  VkPushConstantRange push_constant_range;
+  push_constant_range.stageFlags = VK_SHADER_STAGE_FRAGMENT_BIT;
+  push_constant_range.offset = 0;
+  push_constant_range.size = sizeof(swap_fxaa::PushConstants);
+  VkPipelineLayoutCreateInfo pipeline_layout_create_info = {};
+  pipeline_layout_create_info.sType =
+      VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+  pipeline_layout_create_info.setLayoutCount = 1;
+  pipeline_layout_create_info.pSetLayouts = &swap_fxaa_descriptor_set_layout_;
+  pipeline_layout_create_info.pushConstantRangeCount = 1;
+  pipeline_layout_create_info.pPushConstantRanges = &push_constant_range;
+  if (dfn.vkCreatePipelineLayout(device, &pipeline_layout_create_info, nullptr,
+                                 &swap_fxaa_pipeline_layout_) != VK_SUCCESS) {
+    XELOGE("Anti-aliasing (fix 137): the pipeline layout was not made");
+    ShutdownSwapFxaa();
+    return false;
+  }
+  VkDescriptorPoolSize pool_size;
+  pool_size.type = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+  pool_size.descriptorCount = kMaxFramesInFlight;
+  VkDescriptorPoolCreateInfo pool_create_info = {};
+  pool_create_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
+  pool_create_info.maxSets = kMaxFramesInFlight;
+  pool_create_info.poolSizeCount = 1;
+  pool_create_info.pPoolSizes = &pool_size;
+  if (dfn.vkCreateDescriptorPool(device, &pool_create_info, nullptr,
+                                 &swap_fxaa_descriptor_pool_) != VK_SUCCESS) {
+    XELOGE("Anti-aliasing (fix 137): the descriptor pool was not made");
+    ShutdownSwapFxaa();
+    return false;
+  }
+  std::array<VkDescriptorSetLayout, kMaxFramesInFlight> set_layouts;
+  set_layouts.fill(swap_fxaa_descriptor_set_layout_);
+  VkDescriptorSetAllocateInfo set_allocate_info = {};
+  set_allocate_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
+  set_allocate_info.descriptorPool = swap_fxaa_descriptor_pool_;
+  set_allocate_info.descriptorSetCount = uint32_t(set_layouts.size());
+  set_allocate_info.pSetLayouts = set_layouts.data();
+  if (dfn.vkAllocateDescriptorSets(device, &set_allocate_info,
+                                   swap_fxaa_descriptor_sets_.data()) !=
+      VK_SUCCESS) {
+    XELOGE("Anti-aliasing (fix 137): the descriptor sets were not allocated");
+    ShutdownSwapFxaa();
+    return false;
+  }
+
+  // Shaders: fullscreen_cw.vs for both passes, the luma variants of the gamma
+  // ramp shaders, FXAA and FXAA Extreme.
+  enum ShaderIndex {
+    kVertex,
+    kLumaTable,
+    kLumaPwl,
+    kFxaa,
+    kFxaaExtreme,
+    kShaderCount,
+  };
+  std::array<VkShaderModule, kShaderCount> modules{};
+  modules[kVertex] = ui::vulkan::util::CreateShaderModule(
+      vulkan_device, shaders::fullscreen_cw_vs,
+      sizeof(shaders::fullscreen_cw_vs));
+  modules[kLumaTable] = ui::vulkan::util::CreateShaderModule(
+      vulkan_device, shaders::apply_gamma_table_fxaa_luma_ps,
+      sizeof(shaders::apply_gamma_table_fxaa_luma_ps));
+  modules[kLumaPwl] = ui::vulkan::util::CreateShaderModule(
+      vulkan_device, shaders::apply_gamma_pwl_fxaa_luma_ps,
+      sizeof(shaders::apply_gamma_pwl_fxaa_luma_ps));
+  modules[kFxaa] = ui::vulkan::util::CreateShaderModule(
+      vulkan_device, shaders::fxaa_ps, sizeof(shaders::fxaa_ps));
+  modules[kFxaaExtreme] = ui::vulkan::util::CreateShaderModule(
+      vulkan_device, shaders::fxaa_extreme_ps, sizeof(shaders::fxaa_extreme_ps));
+  bool created = true;
+  for (VkShaderModule module : modules) {
+    created = created && module != VK_NULL_HANDLE;
+  }
+
+  if (created) {
+    // The fixed-function state of the gamma ramp application pipelines.
+    VkPipelineShaderStageCreateInfo stages[2] = {};
+    for (VkPipelineShaderStageCreateInfo& stage : stages) {
+      stage.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+      stage.pName = "main";
+    }
+    stages[0].stage = VK_SHADER_STAGE_VERTEX_BIT;
+    stages[0].module = modules[kVertex];
+    stages[1].stage = VK_SHADER_STAGE_FRAGMENT_BIT;
+    VkPipelineVertexInputStateCreateInfo vertex_input_state = {};
+    vertex_input_state.sType =
+        VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO;
+    VkPipelineInputAssemblyStateCreateInfo input_assembly_state = {};
+    input_assembly_state.sType =
+        VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO;
+    input_assembly_state.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+    VkPipelineViewportStateCreateInfo viewport_state = {};
+    viewport_state.sType = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO;
+    viewport_state.viewportCount = 1;
+    viewport_state.scissorCount = 1;
+    VkPipelineRasterizationStateCreateInfo rasterization_state = {};
+    rasterization_state.sType =
+        VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO;
+    rasterization_state.polygonMode = VK_POLYGON_MODE_FILL;
+    rasterization_state.cullMode = VK_CULL_MODE_NONE;
+    rasterization_state.frontFace = VK_FRONT_FACE_CLOCKWISE;
+    rasterization_state.lineWidth = 1.0f;
+    VkPipelineMultisampleStateCreateInfo multisample_state = {};
+    multisample_state.sType =
+        VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO;
+    multisample_state.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+    VkPipelineColorBlendAttachmentState color_blend_attachment_state = {};
+    color_blend_attachment_state.colorWriteMask =
+        VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_G_BIT |
+        VK_COLOR_COMPONENT_B_BIT | VK_COLOR_COMPONENT_A_BIT;
+    VkPipelineColorBlendStateCreateInfo color_blend_state = {};
+    color_blend_state.sType =
+        VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO;
+    color_blend_state.attachmentCount = 1;
+    color_blend_state.pAttachments = &color_blend_attachment_state;
+    static constexpr VkDynamicState kDynamicStates[] = {
+        VK_DYNAMIC_STATE_VIEWPORT,
+        VK_DYNAMIC_STATE_SCISSOR,
+    };
+    VkPipelineDynamicStateCreateInfo dynamic_state = {};
+    dynamic_state.sType = VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO;
+    dynamic_state.dynamicStateCount = uint32_t(xe::countof(kDynamicStates));
+    dynamic_state.pDynamicStates = kDynamicStates;
+    VkGraphicsPipelineCreateInfo pipeline_create_info = {};
+    pipeline_create_info.sType = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO;
+    pipeline_create_info.stageCount = uint32_t(xe::countof(stages));
+    pipeline_create_info.pStages = stages;
+    pipeline_create_info.pVertexInputState = &vertex_input_state;
+    pipeline_create_info.pInputAssemblyState = &input_assembly_state;
+    pipeline_create_info.pViewportState = &viewport_state;
+    pipeline_create_info.pRasterizationState = &rasterization_state;
+    pipeline_create_info.pMultisampleState = &multisample_state;
+    pipeline_create_info.pColorBlendState = &color_blend_state;
+    pipeline_create_info.pDynamicState = &dynamic_state;
+    pipeline_create_info.subpass = 0;
+    pipeline_create_info.basePipelineIndex = -1;
+    // Pass 1: the gamma ramp application's layout and descriptors, into the
+    // intermediate image.
+    pipeline_create_info.layout = swap_apply_gamma_pipeline_layout_;
+    pipeline_create_info.renderPass = swap_fxaa_luma_render_pass_;
+    for (uint32_t i = 0; i < 2 && created; ++i) {
+      stages[1].module = modules[i ? kLumaPwl : kLumaTable];
+      created = dfn.vkCreateGraphicsPipelines(
+                    device, VK_NULL_HANDLE, 1, &pipeline_create_info, nullptr,
+                    &swap_fxaa_luma_pipelines_[i]) == VK_SUCCESS;
+    }
+    // Pass 2: FXAA into the guest output image (the swap framebuffers).
+    pipeline_create_info.layout = swap_fxaa_pipeline_layout_;
+    pipeline_create_info.renderPass = swap_apply_gamma_render_pass_;
+    for (uint32_t i = 0; i < 2 && created; ++i) {
+      stages[1].module = modules[i ? kFxaaExtreme : kFxaa];
+      created = dfn.vkCreateGraphicsPipelines(
+                    device, VK_NULL_HANDLE, 1, &pipeline_create_info, nullptr,
+                    &swap_fxaa_pipelines_[i]) == VK_SUCCESS;
+    }
+  }
+  for (VkShaderModule module : modules) {
+    if (module != VK_NULL_HANDLE) {
+      dfn.vkDestroyShaderModule(device, module, nullptr);
+    }
+  }
+  if (!created) {
+    XELOGE(
+        "Anti-aliasing (fix 137): the FXAA shaders or pipelines were not made; "
+        "the picture stays without FXAA");
+    ShutdownSwapFxaa();
+    return false;
+  }
+  return true;
+}
+
+bool VulkanCommandProcessor::CreateSwapFxaaSource(uint32_t width,
+                                                  uint32_t height) {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  SwapFxaaSource source;
+  source.width = width;
+  source.height = height;
+  VkImageCreateInfo image_create_info = {};
+  image_create_info.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+  image_create_info.imageType = VK_IMAGE_TYPE_2D;
+  image_create_info.format = swap_fxaa_vk_format_;
+  image_create_info.extent.width = width;
+  image_create_info.extent.height = height;
+  image_create_info.extent.depth = 1;
+  image_create_info.mipLevels = 1;
+  image_create_info.arrayLayers = 1;
+  image_create_info.samples = VK_SAMPLE_COUNT_1_BIT;
+  image_create_info.tiling = VK_IMAGE_TILING_OPTIMAL;
+  image_create_info.usage =
+      VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT;
+  image_create_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+  image_create_info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+  bool created = ui::vulkan::util::CreateDedicatedAllocationImage(
+      vulkan_device, image_create_info,
+      ui::vulkan::util::MemoryPurpose::kDeviceLocal, source.image,
+      source.memory);
+  if (created) {
+    VkImageViewCreateInfo view_create_info = {};
+    view_create_info.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO;
+    view_create_info.image = source.image;
+    view_create_info.viewType = VK_IMAGE_VIEW_TYPE_2D;
+    view_create_info.format = swap_fxaa_vk_format_;
+    view_create_info.components.r = VK_COMPONENT_SWIZZLE_IDENTITY;
+    view_create_info.components.g = VK_COMPONENT_SWIZZLE_IDENTITY;
+    view_create_info.components.b = VK_COMPONENT_SWIZZLE_IDENTITY;
+    view_create_info.components.a = VK_COMPONENT_SWIZZLE_IDENTITY;
+    view_create_info.subresourceRange =
+        ui::vulkan::util::InitializeSubresourceRange();
+    created = dfn.vkCreateImageView(device, &view_create_info, nullptr,
+                                    &source.view) == VK_SUCCESS;
+  }
+  if (created) {
+    VkFramebufferCreateInfo framebuffer_create_info = {};
+    framebuffer_create_info.sType = VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO;
+    framebuffer_create_info.renderPass = swap_fxaa_luma_render_pass_;
+    framebuffer_create_info.attachmentCount = 1;
+    framebuffer_create_info.pAttachments = &source.view;
+    framebuffer_create_info.width = width;
+    framebuffer_create_info.height = height;
+    framebuffer_create_info.layers = 1;
+    created = dfn.vkCreateFramebuffer(device, &framebuffer_create_info,
+                                      nullptr,
+                                      &source.framebuffer) == VK_SUCCESS;
+  }
+  if (!created) {
+    XELOGE(
+        "Anti-aliasing (fix 137): the {}x{} intermediate image was not made; "
+        "the picture goes without FXAA at this size",
+        width, height);
+    DestroySwapFxaaSource(source);
+    return false;
+  }
+  swap_fxaa_source_ = source;
+  return true;
+}
+
+void VulkanCommandProcessor::RetireSwapFxaaSource() {
+  if (swap_fxaa_source_.image != VK_NULL_HANDLE ||
+      swap_fxaa_source_.memory != VK_NULL_HANDLE) {
+    swap_fxaa_retired_sources_.push_back(swap_fxaa_source_);
+  }
+  swap_fxaa_source_ = SwapFxaaSource();
+  // Another size, or FXAA again, may succeed.
+  swap_fxaa_failed_width_ = 0;
+  swap_fxaa_failed_height_ = 0;
+}
+
+void VulkanCommandProcessor::DestroySwapFxaaSource(
+    const SwapFxaaSource& source) {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  if (source.framebuffer != VK_NULL_HANDLE) {
+    dfn.vkDestroyFramebuffer(device, source.framebuffer, nullptr);
+  }
+  if (source.view != VK_NULL_HANDLE) {
+    dfn.vkDestroyImageView(device, source.view, nullptr);
+  }
+  if (source.image != VK_NULL_HANDLE) {
+    dfn.vkDestroyImage(device, source.image, nullptr);
+  }
+  if (source.memory != VK_NULL_HANDLE) {
+    dfn.vkFreeMemory(device, source.memory, nullptr);
+  }
+}
+
+void VulkanCommandProcessor::DestroyRetiredSwapFxaaSources(bool all) {
+  if (swap_fxaa_retired_sources_.empty()) {
+    return;
+  }
+  const uint64_t completed_submission = GetCompletedSubmission();
+  for (size_t i = 0; i < swap_fxaa_retired_sources_.size();) {
+    const SwapFxaaSource& retired = swap_fxaa_retired_sources_[i];
+    if (all ||
+        swap_fxaa::CanDestroy(retired.last_submission, completed_submission)) {
+      DestroySwapFxaaSource(retired);
+      swap_fxaa_retired_sources_.erase(swap_fxaa_retired_sources_.begin() +
+                                       ptrdiff_t(i));
+    } else {
+      ++i;
+    }
+  }
+}
+
+void VulkanCommandProcessor::RecordSwapFxaaLumaPass(
+    bool use_pwl_gamma_ramp, VkDescriptorSet gamma_ramp_descriptor_set,
+    uint32_t swap_frame_index, VkImageView swap_texture_view, uint32_t width,
+    uint32_t height) {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+
+  // The previous swap's FXAA pass read the image; its contents are not kept.
+  PushImageMemoryBarrier(swap_fxaa_source_.image,
+                         ui::vulkan::util::InitializeSubresourceRange(),
+                         VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT,
+                         VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+                         VK_ACCESS_SHADER_READ_BIT,
+                         VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT,
+                         VK_IMAGE_LAYOUT_UNDEFINED,
+                         VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
+  SubmitBarriers(true);
+  // Kept (if replaced or let go of) until this submission is completed.
+  swap_fxaa_source_.last_submission = GetCurrentSubmission();
+
+  VkRenderPassBeginInfo render_pass_begin_info;
+  render_pass_begin_info.sType = VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO;
+  render_pass_begin_info.pNext = nullptr;
+  render_pass_begin_info.renderPass = swap_fxaa_luma_render_pass_;
+  render_pass_begin_info.framebuffer = swap_fxaa_source_.framebuffer;
+  render_pass_begin_info.renderArea.offset.x = 0;
+  render_pass_begin_info.renderArea.offset.y = 0;
+  render_pass_begin_info.renderArea.extent.width = width;
+  render_pass_begin_info.renderArea.extent.height = height;
+  render_pass_begin_info.clearValueCount = 0;
+  render_pass_begin_info.pClearValues = nullptr;
+  deferred_command_buffer_.CmdVkBeginRenderPass(&render_pass_begin_info,
+                                                VK_SUBPASS_CONTENTS_INLINE);
+  current_render_pass_ = swap_fxaa_luma_render_pass_;
+  current_framebuffer_ = nullptr;  // Not a render target cache framebuffer
+
+  VkViewport viewport;
+  viewport.x = 0.0f;
+  viewport.y = 0.0f;
+  viewport.width = float(width);
+  viewport.height = float(height);
+  viewport.minDepth = 0.0f;
+  viewport.maxDepth = 1.0f;
+  SetViewport(viewport);
+  VkRect2D scissor;
+  scissor.offset.x = 0;
+  scissor.offset.y = 0;
+  scissor.extent.width = width;
+  scissor.extent.height = height;
+  SetScissor(scissor);
+
+  BindExternalGraphicsPipeline(
+      swap_fxaa_luma_pipelines_[use_pwl_gamma_ramp ? 1 : 0]);
+
+  // The front buffer, as the one-pass swap binds it.
+  VkDescriptorSet swap_descriptor_source =
+      swap_descriptors_source_[swap_frame_index];
+  VkDescriptorImageInfo source_image_info;
+  source_image_info.sampler = VK_NULL_HANDLE;
+  source_image_info.imageView = swap_texture_view;
+  source_image_info.imageLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+  VkWriteDescriptorSet source_write;
+  source_write.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+  source_write.pNext = nullptr;
+  source_write.dstSet = swap_descriptor_source;
+  source_write.dstBinding = 0;
+  source_write.dstArrayElement = 0;
+  source_write.descriptorCount = 1;
+  source_write.descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;
+  source_write.pImageInfo = &source_image_info;
+  source_write.pBufferInfo = nullptr;
+  source_write.pTexelBufferView = nullptr;
+  dfn.vkUpdateDescriptorSets(device, 1, &source_write, 0, nullptr);
+  std::array<VkDescriptorSet, kSwapApplyGammaDescriptorSetCount>
+      swap_descriptor_sets{};
+  swap_descriptor_sets[kSwapApplyGammaDescriptorSetRamp] =
+      gamma_ramp_descriptor_set;
+  swap_descriptor_sets[kSwapApplyGammaDescriptorSetSource] =
+      swap_descriptor_source;
+  deferred_command_buffer_.CmdVkBindDescriptorSets(
+      VK_PIPELINE_BIND_POINT_GRAPHICS, swap_apply_gamma_pipeline_layout_, 0,
+      uint32_t(swap_descriptor_sets.size()), swap_descriptor_sets.data(), 0,
+      nullptr);
+
+  deferred_command_buffer_.CmdVkDraw(3, 1, 0, 0);
+
+  deferred_command_buffer_.CmdVkEndRenderPass();
+  current_render_pass_ = VK_NULL_HANDLE;
+
+  // FXAA samples it next, in the swap render pass.
+  PushImageMemoryBarrier(swap_fxaa_source_.image,
+                         ui::vulkan::util::InitializeSubresourceRange(),
+                         VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+                         VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT,
+                         VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT,
+                         VK_ACCESS_SHADER_READ_BIT,
+                         VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
+                         VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  SubmitBarriers(true);
+}
+
+void VulkanCommandProcessor::RecordSwapFxaaPass(SwapPostEffect effect,
+                                                uint32_t swap_frame_index,
+                                                uint32_t width,
+                                                uint32_t height) {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+
+  // This frame's set (the frame that used it last was completed before this
+  // frame began), pointing at the current intermediate image.
+  VkDescriptorSet descriptor_set = swap_fxaa_descriptor_sets_[swap_frame_index];
+  VkDescriptorImageInfo source_image_info;
+  source_image_info.sampler = VK_NULL_HANDLE;  // Immutable.
+  source_image_info.imageView = swap_fxaa_source_.view;
+  source_image_info.imageLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+  VkWriteDescriptorSet source_write;
+  source_write.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+  source_write.pNext = nullptr;
+  source_write.dstSet = descriptor_set;
+  source_write.dstBinding = 0;
+  source_write.dstArrayElement = 0;
+  source_write.descriptorCount = 1;
+  source_write.descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+  source_write.pImageInfo = &source_image_info;
+  source_write.pBufferInfo = nullptr;
+  source_write.pTexelBufferView = nullptr;
+  dfn.vkUpdateDescriptorSets(device, 1, &source_write, 0, nullptr);
+
+  BindExternalGraphicsPipeline(
+      swap_fxaa_pipelines_[effect == SwapPostEffect::kFxaaExtreme ? 1 : 0]);
+  deferred_command_buffer_.CmdVkBindDescriptorSets(
+      VK_PIPELINE_BIND_POINT_GRAPHICS, swap_fxaa_pipeline_layout_, 0, 1,
+      &descriptor_set, 0, nullptr);
+  const swap_fxaa::PushConstants push_constants =
+      swap_fxaa::MakePushConstants(width, height);
+  deferred_command_buffer_.CmdVkPushConstants(
+      swap_fxaa_pipeline_layout_, VK_SHADER_STAGE_FRAGMENT_BIT, 0,
+      sizeof(push_constants), &push_constants);
+  deferred_command_buffer_.CmdVkDraw(3, 1, 0, 0);
+}
+
+void VulkanCommandProcessor::ShutdownSwapFxaa() {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  // ShutdownContext waits for the GPU first; a failed creation has nothing in
+  // flight.
+  DestroyRetiredSwapFxaaSources(true);
+  DestroySwapFxaaSource(swap_fxaa_source_);
+  swap_fxaa_source_ = SwapFxaaSource();
+  for (VkPipeline& pipeline : swap_fxaa_pipelines_) {
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyPipeline, device,
+                                           pipeline);
+  }
