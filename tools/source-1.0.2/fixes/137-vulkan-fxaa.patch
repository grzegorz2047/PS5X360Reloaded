@@ -0,0 +1,150 @@
+// SPDX-License-Identifier: MIT
+// Xbox360PS5 (fix 137): FXAA for the Vulkan swap, the decisions without Vulkan (host-checked by
+// tools/check-vulkan-fxaa.cpp).
+//
+// The launcher's "antialiasing" option (0 Off, 1 FXAA, 2 FXAA Extreme) reaches the core as
+// CommandProcessor::SwapPostEffect (kNone, kFxaa, kFxaaExtreme, the same numbers). With FXAA,
+// VulkanCommandProcessor::IssueSwap draws two passes instead of one:
+//   1. apply_gamma_{table,pwl}_fxaa_luma.ps into an intermediate image (RGBA16F, or RGBA8 when the
+//      device cannot render to and filter RGBA16F): the gamma-corrected picture with its luma in A;
+//   2. fxaa.ps / fxaa_extreme.ps from that image into the guest output image (the swap
+//      framebuffer of the one-pass path).
+// Off (or FXAA without its resources) draws exactly the one pass it always did. The intermediate
+// image follows the front buffer's size (1x and 2x differ); one replaced or no longer used is kept
+// until the GPU has completed the last submission that used it.
+#ifndef XENIA_GPU_VULKAN_SWAP_FXAA_H_
+#define XENIA_GPU_VULKAN_SWAP_FXAA_H_
+
+#include <cstdint>
+
+namespace xe {
+namespace gpu {
+namespace swap_fxaa {
+
+// CommandProcessor::SwapPostEffect's values (static_assert in vulkan_command_processor.cc).
+enum class Effect : uint32_t {
+  kNone = 0,
+  kFxaa = 1,
+  kFxaaExtreme = 2,
+};
+
+// The launcher's antialiasing value; anything unknown is Off.
+constexpr Effect EffectFromSetting(int value) {
+  return value == 1 ? Effect::kFxaa : value == 2 ? Effect::kFxaaExtreme : Effect::kNone;
+}
+
+// The value the core gets for a game: Off on the OpenGL renderer (it has no swap post effect),
+// whatever the stored value says.
+constexpr Effect EffectForRenderer(int setting, bool opengl) {
+  return opengl ? Effect::kNone : EffectFromSetting(setting);
+}
+
+constexpr const char* EffectName(Effect effect) {
+  return effect == Effect::kFxaa          ? "FXAA"
+         : effect == Effect::kFxaaExtreme ? "FXAA Extreme"
+                                          : "off";
+}
+
+// Whether this swap draws the two FXAA passes: an effect, a size, and the pipelines, the
+// intermediate image and its framebuffer all made. Anything else draws the one-pass swap.
+constexpr bool UseFxaa(Effect effect, uint32_t width, uint32_t height, bool resources_ready) {
+  return effect != Effect::kNone && width != 0 && height != 0 && resources_ready;
+}
+
+// Whether the intermediate image must be made (again) for a front buffer of this size: none yet,
+// or one of another size (1x <-> 2x, a game changing its resolution). A zero size makes none.
+constexpr bool NeedsNewSource(uint32_t current_width, uint32_t current_height, uint32_t width,
+                              uint32_t height) {
+  return width != 0 && height != 0 && (current_width != width || current_height != height);
+}
+
+// fxaa.glsli's push constants: 1 / the source's size (FXAA's fxaaQualityRcpFrame).
+struct PushConstants {
+  float size_inv_x = 0.0f;
+  float size_inv_y = 0.0f;
+};
+static_assert(sizeof(PushConstants) == 8, "fxaa.glsli's vec2 size_inv");
+
+constexpr PushConstants MakePushConstants(uint32_t width, uint32_t height) {
+  if (width == 0 || height == 0) return {};
+  return {1.0f / float(width), 1.0f / float(height)};
+}
+
+// A retired intermediate image (its view, framebuffer and memory) last used by submission
+// `last_submission` may be destroyed once the GPU completed it.
+constexpr bool CanDestroy(uint64_t last_submission, uint64_t completed_submission) {
+  return completed_submission >= last_submission;
+}
+
+// The presenter's 8 bits per component hint (Triang3l's TODO next to SetIs8bpc): the PWL gamma
+// ramp gives more than 8 bits, and so does FXAA, which blends neighbouring pixels.
+constexpr bool Is8bpc(bool use_pwl_gamma_ramp, bool use_fxaa) {
+  return !use_pwl_gamma_ramp && !use_fxaa;
+}
+
+// The intermediate image's format: RGBA16F as D3D12 (10-bit PWL output and the luma kept), else
+// RGBA8 (both are required by Vulkan for rendering and linear filtering; checked anyway), else none
+// (FXAA stays off).
+enum class SourceFormat : uint32_t {
+  kNone,
+  kRgba16Float,
+  kRgba8Unorm,
+};
+constexpr SourceFormat ChooseSourceFormat(bool rgba16f_renders_and_filters,
+                                          bool rgba8_renders_and_filters) {
+  return rgba16f_renders_and_filters ? SourceFormat::kRgba16Float
+         : rgba8_renders_and_filters ? SourceFormat::kRgba8Unorm
+                                     : SourceFormat::kNone;
+}
+constexpr const char* SourceFormatName(SourceFormat format) {
+  return format == SourceFormat::kRgba16Float  ? "R16G16B16A16_SFLOAT"
+         : format == SourceFormat::kRgba8Unorm ? "R8G8B8A8_UNORM"
+                                               : "none";
+}
+
+// The passes a swap records, in order (the model of IssueSwap the check runs).
+enum class Pass : uint32_t {
+  // apply_gamma_*.ps into the guest output image: the one-pass swap.
+  kApplyGammaToOutput,
+  // apply_gamma_*_fxaa_luma.ps into the intermediate image.
+  kApplyGammaLumaToSource,
+  // The intermediate image from color attachment to shader read.
+  kSourceBarrier,
+  // fxaa.ps or fxaa_extreme.ps from the intermediate image into the guest output image.
+  kFxaaToOutput,
+};
+struct Passes {
+  Pass pass[3];
+  uint32_t count = 0;
+};
+constexpr Passes SwapPasses(bool use_fxaa) {
+  Passes passes{};
+  if (use_fxaa) {
+    passes.pass[0] = Pass::kApplyGammaLumaToSource;
+    passes.pass[1] = Pass::kSourceBarrier;
+    passes.pass[2] = Pass::kFxaaToOutput;
+    passes.count = 3;
+  } else {
+    passes.pass[0] = Pass::kApplyGammaToOutput;
+    passes.count = 1;
+  }
+  return passes;
+}
+
+// The log line's state: a line when what is drawn changes (effect, size or format), not per frame.
+struct LineState {
+  Effect effect = Effect::kNone;
+  uint32_t width = 0;
+  uint32_t height = 0;
+  SourceFormat format = SourceFormat::kNone;
+  bool operator==(const LineState& other) const {
+    return effect == other.effect && width == other.width && height == other.height &&
+           format == other.format;
+  }
+};
+
+}  // namespace swap_fxaa
+}  // namespace gpu
+}  // namespace xe
+
+#endif  // XENIA_GPU_VULKAN_SWAP_FXAA_H_
