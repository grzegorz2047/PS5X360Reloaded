+void Mismatch(uint32_t which, const char* what) {
+  ++stats[which].mismatches;
+  if (mismatches_logged[which] < 8) {
+    ++mismatches_logged[which];
+    XELOGW("Draw memo (fix 142g): {} mismatch {} of 8 logged: {}", draw_memo::WhichName(which),
+           mismatches_logged[which], what);
+  }
+}
+// The modes from draw-memo.txt in the title folder when it exists (read again at most once a
+// second), else the cvars (a value that is not a mode is off); the line every 30 s while a memo
+// is on.
+void Refresh() {
+  const auto now = std::chrono::steady_clock::now();
+  if (settings_logged && now - checked < std::chrono::seconds(1)) return;
+  checked = now;
+  draw_memo::Settings next;
+  const uint32_t from_cvars[draw_memo::kMemos] = {cvars::draw_memo_system, cvars::draw_memo_samplers,
+                                                  cvars::draw_memo_viewport};
+  for (uint32_t w = 0; w < draw_memo::kMemos; ++w)
+    next.mode[w] = from_cvars[w] < draw_memo::kModes ? from_cvars[w] : draw_memo::kOff;
+  const char* const path = XBOX360PS5_DATA_ROOT "/draw-memo.txt";
+  int not_understood = 0;
+  bool from_file = false;
+  if (FILE* file = std::fopen(path, "rb")) {
+    std::string text;
+    char chunk[256];
+    size_t got;
+    while ((got = std::fread(chunk, 1, sizeof(chunk), file)) > 0) text.append(chunk, got);
+    std::fclose(file);
+    not_understood = draw_memo::Parse(text, next);
+    from_file = true;
+  }
+  if (!settings_logged || !(next == settings)) {
+    XELOGW("Draw memo (fix 142g): system {}, samplers {}, viewport {} (0 off, 1 verify, 2 skip), "
+           "from {}{}",
+           next.mode[0], next.mode[1], next.mode[2], from_file ? path : "the settings",
+           not_understood ? fmt::format(", {} lines not understood", not_understood)
+                          : std::string());
+    settings = next;
+    settings_logged = true;
+    system_slot.Invalidate();
+    viewport_slot.Invalidate();
+    sampler_slots[0].Invalidate();
+    sampler_slots[1].Invalidate();
+    for (uint32_t& logged : mismatches_logged) logged = 0;
+  }
+  if (line_at == std::chrono::steady_clock::time_point()) line_at = now;
+  const double seconds = std::chrono::duration<double>(now - line_at).count();
+  if (seconds >= 30.0) {
+    if (settings.mode[0] || settings.mode[1] || settings.mode[2]) {
+      XELOGW("{}", draw_memo::Line(settings, stats, stats_logged, seconds));
+    }
+    for (uint32_t w = 0; w < draw_memo::kMemos; ++w) stats_logged[w] = stats[w];
+    line_at = now;
+  }
+}
