+// SPDX-License-Identifier: MIT
+// Xbox360PS5, fix 142g: repeat memos for three per-draw computations on the GPU command thread
+// that fix 142f-diag measured as mostly repeating (research/parallel-gpu-commands/STAGE2.md,
+// section 15):
+//   - the system constants (UpdateSystemConstantValues): Modern Warfare 2 22-23 ms/s, 95.8% of
+//     the updates changing nothing;
+//   - the samplers (GetSamplerParameters and UseSampler for each of a shader's sampler
+//     bindings): MW2 45.9 ms/s, Grand Theft Auto IV 21.5;
+//   - the viewport (GetHostViewportInfo): MW2 25.9 ms/s, GTA IV 24.0.
+// Each builds a key of everything its computation reads; when the key equals the last one, the
+// computation would give the same result as last time.
+// Modes, per memo (draw_memo_* cvars, or draw-memo.txt in the title folder):
+//   0 off: computed as before (nothing here is looked at);
+//   1 verify: computed every time; when the memo says it would repeat and the result differs,
+//     a mismatch is counted (the first ones logged);
+//   2 skip: a repeat takes the last result.
+// draw-memo.txt: "system N", "samplers N", "viewport N" lines, or one number for all three.
+#ifndef XENIA_GPU_VULKAN_DRAW_MEMO_H_
+#define XENIA_GPU_VULKAN_DRAW_MEMO_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <sstream>
+#include <string>
+#include <type_traits>
+#include <vector>
+
+namespace xe {
+namespace gpu {
+namespace draw_memo {
+
+enum Mode : uint32_t { kOff = 0, kVerify = 1, kSkip = 2, kModes };
+enum Which : uint32_t { kSystem = 0, kSamplers, kViewport, kMemos };
+inline const char* WhichName(uint32_t which) {
+  static const char* const names[] = {"system", "samplers", "viewport"};
+  return which < kMemos ? names[which] : "?";
+}
+
+struct Settings {
+  uint32_t mode[kMemos] = {};
+  bool operator==(const Settings& other) const {
+    return !std::memcmp(mode, other.mode, sizeof(mode));
+  }
+};
+
+// Returns the lines not understood; what a line does not set keeps its value.
+inline int Parse(const std::string& text, Settings& settings) {
+  int not_understood = 0;
+  std::istringstream lines(text);
+  std::string line;
+  while (std::getline(lines, line)) {
+    const size_t hash = line.find('#');
+    if (hash != std::string::npos) line.resize(hash);
+    std::istringstream words(line);
+    std::string first, second, extra;
+    if (!(words >> first)) continue;
+    const bool has_second = bool(words >> second);
+    if (words >> extra) {
+      ++not_understood;
+      continue;
+    }
+    auto mode_of = [](const std::string& word, uint32_t& mode) {
+      if (word.size() != 1 || word[0] < '0' || word[0] >= char('0' + kModes)) return false;
+      mode = uint32_t(word[0] - '0');
+      return true;
+    };
+    uint32_t mode;
+    if (!has_second) {
+      if (!mode_of(first, mode)) {
+        ++not_understood;
+        continue;
+      }
+      for (uint32_t& m : settings.mode) m = mode;
+      continue;
+    }
+    uint32_t which = kMemos;
+    for (uint32_t w = 0; w < kMemos; ++w)
+      if (first == WhichName(w)) which = w;
+    if (which == kMemos || !mode_of(second, mode)) {
+      ++not_understood;
+      continue;
+    }
+    settings.mode[which] = mode;
+  }
+  return not_understood;
+}
+
+// A key: words appended in a fixed order by the caller.
+class Key {
+ public:
+  void Clear() { words_.clear(); }
+  template <typename T>
+  void Add(const T& value) {
+    static_assert(std::is_trivially_copyable<T>::value, "plain data");
+    AddBytes(&value, sizeof(T));
+  }
+  void AddBytes(const void* data, size_t size) {
+    const uint8_t* bytes = static_cast<const uint8_t*>(data);
+    while (size) {
+      uint32_t word = 0;
+      const size_t n = size < 4 ? size : 4;
+      std::memcpy(&word, bytes, n);
+      words_.push_back(word);
+      bytes += n;
+      size -= n;
+    }
+  }
+  bool operator==(const Key& other) const { return words_ == other.words_; }
+  size_t size() const { return words_.size(); }
+
+ private:
+  std::vector<uint32_t> words_;
+};
+
+// The last key whose computation ran to the end.
+class Slot {
+ public:
+  Key& Begin() {
+    key_.Clear();
+    return key_;
+  }
+  bool Predict() const { return valid_ && key_ == last_; }
+  void Commit() {
+    std::swap(last_, key_);
+    valid_ = true;
+  }
+  void Invalidate() { valid_ = false; }
+  bool valid() const { return valid_; }
+
+ private:
+  Key key_, last_;
+  bool valid_ = false;
+};
+
+struct Stats {
+  uint64_t calls = 0, predicted = 0, skipped = 0, mismatches = 0;
+};
+
+// "Draw memo (fix 142g): system mode m: n/s, repeats p%, skipped s/s, mismatches x (t in all);
+// samplers ...; viewport ..." for the counts since `before`.
+inline std::string Line(const Settings& settings, const Stats* now, const Stats* before, double seconds) {
+  const double s = seconds > 0 ? seconds : 1.0;
+  std::ostringstream line;
+  line << "Draw memo (fix 142g): ";
+  for (uint32_t w = 0; w < kMemos; ++w) {
+    const uint64_t calls = now[w].calls - before[w].calls;
+    const uint64_t predicted = now[w].predicted - before[w].predicted;
+    line << (w ? "; " : "") << WhichName(w) << " mode " << settings.mode[w] << ": "
+         << uint64_t(double(calls) / s + 0.5) << "/s, repeats "
+         << (calls ? predicted * 100 / calls : 0) << "%, skipped "
+         << uint64_t(double(now[w].skipped - before[w].skipped) / s + 0.5) << "/s, mismatches "
+         << now[w].mismatches - before[w].mismatches << " (" << now[w].mismatches << " in all)";
+  }
+  return line.str();
+}
+
+}  // namespace draw_memo
+}  // namespace gpu
+}  // namespace xe
+
+#endif  // XENIA_GPU_VULKAN_DRAW_MEMO_H_
