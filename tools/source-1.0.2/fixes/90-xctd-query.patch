diff --git a/include/xbox360ps5/xctd.hpp b/include/xbox360ps5/xctd.hpp
new file mode 100644
index 0000000..41596fd
--- /dev/null
+++ b/include/xbox360ps5/xctd.hpp
@@ -0,0 +1,111 @@
+// SPDX-License-Identifier: MIT
+// Fix 90 (1.0.5): NtQueryInformationFile(XFileXctdCompressionInformation), class 0x1B.
+//
+// Titles built with the XDK's XCTD file compression ask the kernel, for every file they open,
+// whether it is compressed; their own runtime then decompresses it (Kinect Sports, 4D5308C9:
+// 82A38740 reads the 4-byte answer's bit 0 as "compressed", and a failed query as "unknown").
+// The core answered every query with STATUS_INVALID_PARAMETER, so the runtime took its
+// fallback: it reads the file's first word itself, through the stream it then decompresses from,
+// and Kinect Sports crashed right after loading its first compressed bundle on
+// 1.0.5_candidate_5 (\AM\AMBundle\bundle\4F45161E; thread F8000078 at 827D6808, then five more).
+// XCTD files begin with the big-endian magic 0x0FF512ED (17 of Kinect Sports' bundles do); the
+// answer is now 1 for those and 0 for every other file, read at offset 0 without moving the
+// file's position. A file that cannot be read keeps the old answer.
+//
+// 1.0.5_candidate_9: Kinect Sports still stopped right after opening 4F45161E (the main thread in
+// its allocator, a free-list link of 0x00001003: its heap was overwritten). 4F45161E is the
+// disc's only XCTD file of one segment (2258 bytes, 2640 decoded: a CAFF); the larger XCTD
+// bundles before it loaded. Its frame decodes to a sane CAFF on the host (Xenia's LZX decoder,
+// window 0x20000), and the disc's compressed attribute (GDF 0x40) marks exactly the 0x0FF512ED
+// files, so the answer above is the console's. What the title then reads, asks and is told about
+// such a file is now logged (Tracer below), for the next console run.
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace xbox360ps5::xctd {
+
+constexpr uint32_t kMagic = 0x0FF512ED;
+constexpr uint32_t kCompressed = 1, kNotCompressed = 0;
+
+inline bool IsCompressedHeader(const uint8_t* bytes, size_t size) {
+  if (!bytes || size < 4) return false;
+  const uint32_t word = uint32_t(bytes[0]) << 24 | uint32_t(bytes[1]) << 16 | uint32_t(bytes[2]) << 8 | bytes[3];
+  return word == kMagic;
+}
+// The 4-byte answer (big-endian in guest memory, written by the caller).
+inline uint32_t Answer(const uint8_t* bytes, size_t size) {
+  return IsCompressedHeader(bytes, size) ? kCompressed : kNotCompressed;
+}
+
+// The handles answered "compressed", followed for the log: each with its own budget of lines
+// (kLinesPerHandle) and a total (kLinesInAll), so a 30 MB bundle read in 32 KiB pieces does not
+// flood it. A handle number reused by a later open starts over (Add replaces it).
+class Tracer {
+ public:
+  static constexpr int kLinesPerHandle = 48, kLinesInAll = 600;
+  static constexpr size_t kHandles = 32;
+  void Add(uint32_t handle, const std::string& path) {
+    std::lock_guard lock(mutex_);
+    for (auto& h : handles_)
+      if (h.handle == handle) {
+        h = {handle, path, 0};
+        return;
+      }
+    if (handles_.size() >= kHandles) handles_.erase(handles_.begin());
+    handles_.push_back({handle, path, 0});
+  }
+  // True (and the file's path) when a line about this handle may still be logged.
+  bool Take(uint32_t handle, std::string* path = nullptr) {
+    std::lock_guard lock(mutex_);
+    for (auto& h : handles_)
+      if (h.handle == handle) {
+        if (h.lines >= kLinesPerHandle || all_ >= kLinesInAll) return false;
+        ++h.lines;
+        ++all_;
+        if (path) *path = h.path;
+        return true;
+      }
+    return false;
+  }
+  bool Traced(uint32_t handle) {
+    std::lock_guard lock(mutex_);
+    for (auto& h : handles_)
+      if (h.handle == handle) return true;
+    return false;
+  }
+  void Remove(uint32_t handle) {
+    std::lock_guard lock(mutex_);
+    for (auto it = handles_.begin(); it != handles_.end(); ++it)
+      if (it->handle == handle) {
+        handles_.erase(it);
+        return;
+      }
+  }
+
+ private:
+  struct Handle {
+    uint32_t handle;
+    std::string path;
+    int lines;
+  };
+  std::mutex mutex_;
+  std::vector<Handle> handles_;
+  int all_ = 0;
+};
+inline Tracer tracer;
+// The first bytes of a buffer as hex, for the log ("0ff512ed01000000").
+inline std::string Hex(const uint8_t* bytes, size_t size, size_t most = 8) {
+  static const char digits[] = "0123456789abcdef";
+  std::string out;
+  for (size_t n = 0; bytes && n < size && n < most; ++n) {
+    out += digits[bytes[n] >> 4];
+    out += digits[bytes[n] & 15];
+  }
+  return out;
+}
+
+}  // namespace xbox360ps5::xctd
