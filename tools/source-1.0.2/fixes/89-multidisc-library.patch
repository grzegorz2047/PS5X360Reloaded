+// Fix 89.
+std::vector<std::vector<size_t>> GroupLibraryDiscs(const std::vector<LibraryDisc>& discs,
+                                                   const LibraryProbe& probe) {
+  using namespace ps5x360_disc;
+  struct Seen { size_t index; ExecutionInfo info; Hint hint; };
+  const auto known = [](const std::string& id) { return !id.empty() && id != "00000000"; };
+  // Worth reading: a disc number in the name, or a title ID another disc of the folder has.
+  std::map<std::pair<std::string, std::string>, unsigned> ids;
+  for (const auto& disc : discs)
+    if (!disc.family.empty() && known(disc.title_id)) ++ids[{disc.family, Lower(disc.title_id)}];
+  std::vector<Seen> seen;
+  for (size_t i = 0; i < discs.size() && probe; ++i) {
+    const auto& disc = discs[i];
+    if (disc.family.empty()) continue;
+    const Hint hint = DiscHint(disc.name);
+    const bool shared = known(disc.title_id) && ids[{disc.family, Lower(disc.title_id)}] > 1;
+    if (!hint.number && !shared) continue;
+    std::optional<ExecutionInfo> info;
+    try { info = probe(i); } catch (const std::exception&) { info.reset(); }
+    if (!info || !Valid(*info) || info->disc_count < 2) continue;  // unreadable, or a game of one disc
+    if (hint.number && hint.number != info->disc_number) continue;  // the name and the header disagree
+    seen.push_back({i, *info, hint});
+  }
+  std::vector<std::vector<size_t>> sets;
+  std::vector<bool> used(discs.size(), false);
+  // A set of these discs when no two claim one disc number.
+  const auto make = [&](std::vector<const Seen*> members) {
+    if (members.size() < 2) return false;
+    std::set<unsigned> numbers;
+    for (const Seen* member : members)
+      if (!numbers.insert(member->info.disc_number).second) return false;
+    std::sort(members.begin(), members.end(), [](const Seen* a, const Seen* b) {
+      return a->info.disc_number < b->info.disc_number;
+    });
+    std::vector<size_t> set;
+    for (const Seen* member : members) { set.push_back(member->index); used[member->index] = true; }
+    sets.push_back(std::move(set));
+    return true;
+  };
+  // The same title ID and save game ID: the discs fix 51's swap takes for one another.
+  std::map<std::tuple<std::string, uint32_t, uint32_t, unsigned>, std::vector<const Seen*>> same;
+  for (const auto& s : seen)
+    same[{discs[s.index].family, s.info.title_id, s.info.savegame_id, s.info.disc_count}].push_back(&s);
+  for (auto& [key, members] : same) {
+    if (make(members)) continue;
+    // Two discs claim one number (two regions of a game in one folder): the name before
+    // "Disc N" tells the sets apart; one name with two discs of a number stays ambiguous.
+    std::map<std::string, std::vector<const Seen*>> named;
+    for (const Seen* member : members) named[member->hint.family].push_back(member);
+    if (named.size() > 1)
+      for (auto& [name, part] : named) make(part);
+  }
+  // A title ID of its own on each disc: the same name before "Disc N" in one folder, each
+  // name's number the header's (checked above), and the same disc count.
+  std::map<std::tuple<std::string, std::string, unsigned>, std::vector<const Seen*>> by_name;
+  for (const auto& s : seen)
+    if (!used[s.index] && s.hint.number && !s.hint.family.empty())
+      by_name[{discs[s.index].family, s.hint.family, s.info.disc_count}].push_back(&s);
+  for (auto& [key, members] : by_name) make(members);
+  std::sort(sets.begin(), sets.end());
+  return sets;
+}
+std::string NameWithoutDisc(const std::string& name) {
+  using namespace ps5x360_disc;
+  if (!DiscNumberFromName(name)) return name;
+  std::string text = name;
+  const auto ext = Extension(text);
+  if (ext == ".iso" || ext == ".zar") text.resize(text.size() - ext.size());
+  const auto trim = [&text] {
+    while (!text.empty() && (text.back() == ' ' || text.back() == '\t' || text.back() == '\r')) text.pop_back();
+  };
+  trim();
+  if (!text.empty() && (text.back() == ')' || text.back() == ']')) text.pop_back();
+  trim();
+  while (!text.empty() && std::isdigit(static_cast<unsigned char>(text.back()))) text.pop_back();
+  while (!text.empty() && Sep(text.back())) text.pop_back();
+  const std::string lower = Lower(text);
+  const size_t word = lower.size() >= 5 && lower.compare(lower.size() - 5, 5, "disco") == 0 ? 5 : 4;
+  text.resize(text.size() - std::min(word, text.size()));
+  while (!text.empty() && (Sep(text.back()) || text.back() == '(' || text.back() == '[')) text.pop_back();
+  return text.empty() ? name : text;
+}
+size_t DefaultDisc(const std::vector<std::string>& paths, const std::vector<std::string>& recents) {
+  for (const auto& recent : recents)
+    for (size_t i = 0; i < paths.size(); ++i)
+      if (paths[i] == recent) return i;
+  return 0;
+}
 }
