--- /dev/null
+++ b/include/xbox360ps5/user_storage.hpp
@@ -0,0 +1,339 @@
+// SPDX-License-Identifier: MIT
+// Fix 165 (tools/source-1.0.2/fixes/165-user-data-folder.patch): where the user's own files live.
+//
+// Until 1.0.6 the options, each game's options, the profile, the recent list, the game folders,
+// the patch choices, the game configs, the covers, the avatars' shapes and the render target and
+// frame generation choices were kept in the app's internal storage, /download0/xbox360ps5 (the
+// download0.dat image of the installation). Installing the app again (ShadowMount) makes that
+// image anew, so all of it was lost, and it cannot be reached over FTP. They are now kept in the
+// app's data folder, XBOX360PS5_DATA_ROOT (/data/homebrew/PPSA83600), beside the logs, the cache,
+// saves/ and network.conf, which survive a reinstall and are reachable over FTP.
+//
+//   * Root() is the folder of the user's files: every one of them is Root() / name, so a later
+//     move is one line (kMoved). Use() sets it once in main, before anything reads it; until then
+//     it is the data folder.
+//   * Choose() picks it at start: the data folder when it can be made and a file written in it
+//     (a probe file, removed again); otherwise the internal storage, as before, with the reason
+//     for the log.
+//   * Then, once, each kMoved item still in the internal storage and missing in the data folder is
+//     copied there (a folder file by file: a file the data folder has is never replaced), and one
+//     line per item copied goes to the log. The old copies are left where they are. A marker in
+//     the data folder (kMarker, with those lines) records that it was done, so a file the user
+//     deletes later in the data folder does not come back from the internal storage. A start that
+//     could not copy everything writes no marker and the next start copies what is still missing.
+//     framegen.conf is the one exception to "never replaced": the internal storage's copy was the
+//     one in use (presenter_sidecar.hpp read it first), so it replaces the data folder's (an older
+//     one fix 46 imported from the official PS5X360, or put there by FTP), which is kept beside it
+//     as framegen.conf.before-move.
+//   * Each file is copied to a hidden temporary name (.<name>.moving) and renamed into place, so a
+//     start that stops while copying leaves no half file under the real name; the next start
+//     writes the temporary again.
+//
+// What stays in the internal storage (safe to lose, or only kept across one restart): the library
+// cache (library/), the disc drive's folder (disc/), the Kinect dashboard skin cache (dash-skin),
+// the saves on "Internal storage" (content/, the console's choice; a move of the saves is a later
+// fix), boot.log (the crash report when /app0/logs cannot be written), engine.log and LOGS/ (the
+// logs' last fallback), and the files that only carry something across a restart: launch-once.txt,
+// next-title.txt, switch-restart.txt, leaving-notice.txt, bug-report.txt, start-check.txt,
+// opengl-check.txt, notice.txt, game.txt, fsi.1, autotest-state.txt and the core's
+// launch_data.bin (the working folder).
+//
+// Only what the title already does on the console is used here: stat (fs::exists, fs::status,
+// is_directory, is_regular_file), directory listings, create_directories, ofstream/ifstream,
+// rename and remove; never lstat or realpath (official_import.hpp says why).
+// Header only and free of the rest of the title, so tools/check-user-storage.cpp drives the same
+// code on temporary folders.
+#pragma once
+#include <cerrno>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <string>
+#include <system_error>
+#include <vector>
+
+#include "xbox360ps5/app_identity.hpp"
+
+namespace xbox360ps5::user_storage {
+namespace fs = std::filesystem;
+
+// The app's internal storage (download0.dat): made anew when the app is installed again.
+inline constexpr char kInternalRoot[] = "/download0/xbox360ps5";
+// The app's data folder: survives a reinstall, reachable over FTP.
+inline constexpr char kDataRoot[] = XBOX360PS5_DATA_ROOT;
+// Written in the data folder once the move was done.
+inline constexpr char kMarker[] = ".moved-from-internal-storage";
+// Written and removed again to see that the data folder takes files.
+inline constexpr char kProbe[] = ".write-probe";
+// At most this many folder levels are copied (the moved folders are flat).
+inline constexpr int kMaxDepth = 8;
+
+// One moved item: its name in the internal storage, its name in the data folder.
+struct Item {
+  const char* from;
+  const char* to;
+  bool folder;
+  bool replace;  // the internal storage's copy wins over one the data folder has (framegen.conf)
+};
+inline constexpr Item kMoved[] = {
+    {"settings.txt", "settings.txt", false, false},        // the general options
+    {"game-settings", "game-settings", true, false},       // <TITLE ID>.txt: each game's options
+    {"profile.txt", "profile.txt", false, false},          // the profile chosen in the launcher
+    {"recent.txt", "recent.txt", false, false},            // the recently played games
+    {"game_paths.txt", "game_paths.txt", false, false},    // the game folders
+    {"game_paths.fix60", "game_paths.fix60", false, false},  // fix 60: the title's roms added once
+    {"resolution-scale", "resolution-scale", true, false},  // fix 117k: <TITLE ID>.txt classes
+    {"fsi.c", "fsi.c", false, false},                       // accurate render targets (FSI)
+    {"framegen.conf", "framegen.conf", false, true},        // frame generation
+    // The patch choices (<TITLE ID>.txt): a name of their own beside assets/patches (the user's
+    // patch files, fix 155c), so the two are not taken for one another.
+    {"patches", "patch-choices", true, false},
+    {"game-configs", "game-configs", true, false},  // <TITLE ID>.config.toml
+    {"avatars", "avatars", true, false},            // fix 113: <XUID>.txt, the avatar's shape
+    {"covers", "covers", true, false},              // <TITLE ID>.jpg, downloaded covers
+};
+
+inline fs::path& RootSlot() {
+  static fs::path root = kDataRoot;
+  return root;
+}
+// The folder of the user's files (the data folder, or the internal storage when it cannot be used).
+inline const fs::path& Root() { return RootSlot(); }
+// Set once in main, before anything reads Root().
+inline void Use(const fs::path& root) { RootSlot() = root; }
+
+// Writes `bytes` to `path` (replacing it). A test hook: the check makes it fail.
+using Writer = bool (*)(const fs::path& path, const std::string& bytes, std::string& why);
+inline bool WriteFile(const fs::path& path, const std::string& bytes, std::string& why) {
+  std::ofstream out(path, std::ios::binary | std::ios::trunc);
+  if (!out) {
+    why = "could not open " + path.string() + " for writing: " + std::strerror(errno);
+    return false;
+  }
+  out.write(bytes.data(), std::streamsize(bytes.size()));
+  out.close();
+  if (!out) {
+    why = "could not write " + path.string() + ": " + std::strerror(errno);
+    return false;
+  }
+  return true;
+}
+inline bool ReadFile(const fs::path& path, std::string& bytes, std::string& why) {
+  std::ifstream in(path, std::ios::binary);
+  if (!in) {
+    why = "could not open " + path.string() + ": " + std::strerror(errno);
+    return false;
+  }
+  bytes.assign(std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>());
+  if (in.bad()) {
+    why = "could not read " + path.string();
+    return false;
+  }
+  return true;
+}
+
+// Whether `path` is there (stat). An error other than "not found" is an error.
+enum class Presence { kAbsent, kFile, kFolder, kOther, kError };
+inline Presence Look(const fs::path& path, std::string& why) {
+  std::error_code error;
+  const fs::file_status status = fs::status(path, error);
+  if (status.type() == fs::file_type::not_found) return Presence::kAbsent;
+  if (error) {
+    why = "could not look at " + path.string() + ": " + error.message();
+    return Presence::kError;
+  }
+  if (status.type() == fs::file_type::regular) return Presence::kFile;
+  if (status.type() == fs::file_type::directory) return Presence::kFolder;
+  return Presence::kOther;
+}
+
+// Copies one file through a hidden temporary name and renames it into place.
+inline bool CopyFile(const fs::path& from, const fs::path& to, Writer writer, std::string& why) {
+  std::string bytes;
+  if (!ReadFile(from, bytes, why)) return false;
+  std::error_code error;
+  fs::create_directories(to.parent_path(), error);
+  if (error) {
+    why = "could not make " + to.parent_path().string() + ": " + error.message();
+    return false;
+  }
+  const fs::path temporary = to.parent_path() / ("." + to.filename().string() + ".moving");
+  if (!writer(temporary, bytes, why)) {
+    fs::remove(temporary, error);
+    return false;
+  }
+  fs::rename(temporary, to, error);
+  if (error) {
+    why = "could not rename " + temporary.string() + " to " + to.string() + ": " + error.message();
+    std::error_code ignored;
+    fs::remove(temporary, ignored);
+    return false;
+  }
+  return true;
+}
+
+struct Counts {
+  int copied = 0;
+  int present = 0;  // already in the data folder: not replaced
+};
+// Copies the files of `from` that `to` does not have, level by level.
+inline bool CopyMissing(const fs::path& from, const fs::path& to, int depth, Writer writer, Counts& counts,
+                        std::string& why) {
+  std::error_code error;
+  fs::directory_iterator it(from, error), end;
+  if (error) {
+    why = "could not list " + from.string() + ": " + error.message();
+    return false;
+  }
+  bool ok = true;
+  for (; it != end; it.increment(error)) {
+    const fs::path source = it->path();
+    const std::string name = source.filename().string();
+    if (name.size() > 7 && name.compare(name.size() - 7, 7, ".moving") == 0) continue;
+    std::string look_why;
+    const Presence kind = Look(source, look_why);
+    if (kind == Presence::kFolder) {
+      if (depth + 1 >= kMaxDepth) continue;
+      if (!CopyMissing(source, to / name, depth + 1, writer, counts, why)) ok = false;
+      continue;
+    }
+    if (kind != Presence::kFile) continue;
+    const fs::path target = to / name;
+    const Presence there = Look(target, look_why);
+    if (there == Presence::kError) { why = look_why; ok = false; continue; }
+    if (there != Presence::kAbsent) { ++counts.present; continue; }
+    if (CopyFile(source, target, writer, why)) ++counts.copied; else ok = false;
+  }
+  if (error) {
+    why = "could not list " + from.string() + ": " + error.message();
+    return false;
+  }
+  return ok;
+}
+
+struct Outcome {
+  fs::path root;              // the folder Use() is given
+  fs::path internal;          // the internal storage it was given
+  bool fallback = false;      // the data folder could not be used: the internal storage
+  std::string why;            // why not (fallback)
+  bool already = false;       // the marker was there: nothing looked at in the internal storage
+  bool marked = false;        // this start wrote the marker
+  int moved = 0;              // items copied (wholly or in part) this start
+  std::vector<std::string> lines;  // one per item copied, and one per item that failed
+};
+
+// One item: the internal storage's copy to the data folder, unless the data folder has it.
+inline bool MoveItem(const Item& item, const fs::path& internal, const fs::path& data, Writer writer,
+                     Outcome& outcome) {
+  const fs::path from = internal / item.from, to = data / item.to;
+  std::string why;
+  const Presence source = Look(from, why);
+  if (source == Presence::kError) {
+    outcome.lines.push_back(std::string("could not move ") + item.from + ": " + why);
+    return false;
+  }
+  if (source == Presence::kAbsent || source == Presence::kOther) return true;
+  if (item.folder) {
+    if (source != Presence::kFolder) return true;
+    Counts counts;
+    const bool ok = CopyMissing(from, to, 0, writer, counts, why);
+    if (counts.copied) {
+      ++outcome.moved;
+      outcome.lines.push_back(std::string("moved ") + item.from + "/: " + std::to_string(counts.copied) +
+                              (counts.copied == 1 ? " file" : " files") + " copied to " + to.string() +
+                              (counts.present ? ", " + std::to_string(counts.present) + " already there (kept)" : "") +
+                              "; the old copies stay in " + internal.string());
+    }
+    if (!ok) outcome.lines.push_back(std::string("could not move ") + item.from + "/: " + why);
+    return ok;
+  }
+  if (source != Presence::kFile) return true;
+  const Presence there = Look(to, why);
+  if (there == Presence::kError) {
+    outcome.lines.push_back(std::string("could not move ") + item.from + ": " + why);
+    return false;
+  }
+  if (there != Presence::kAbsent && !item.replace) return true;  // the data folder's own wins
+  std::string kept;
+  if (there != Presence::kAbsent) {
+    // framegen.conf: the internal storage's copy was the one in use.
+    std::string old_bytes, new_bytes;
+    if (ReadFile(to, old_bytes, why) && ReadFile(from, new_bytes, why) && old_bytes == new_bytes) return true;
+    const fs::path aside = data / (std::string(item.to) + ".before-move");
+    std::error_code error;
+    fs::rename(to, aside, error);
+    if (error) {
+      outcome.lines.push_back(std::string("could not move ") + item.from + ": could not rename " + to.string() +
+                              " to " + aside.string() + ": " + error.message());
+      return false;
+    }
+    kept = " (it replaced the one there, kept as " + aside.filename().string() + ")";
+  }
+  if (!CopyFile(from, to, writer, why)) {
+    outcome.lines.push_back(std::string("could not move ") + item.from + ": " + why);
+    return false;
+  }
+  ++outcome.moved;
+  outcome.lines.push_back(std::string("moved ") + item.from + ": copied to " + to.string() + kept +
+                          "; the old copy stays in " + internal.string());
+  return true;
+}
+
+// Picks the folder of the user's files and, once, copies them there from the internal storage.
+inline Outcome Choose(const fs::path& data, const fs::path& internal, Writer writer = WriteFile) {
+  Outcome outcome;
+  outcome.internal = internal;
+  const auto fall_back = [&](std::string why) {
+    outcome.root = internal;
+    outcome.fallback = true;
+    outcome.why = std::move(why);
+    std::error_code ignored;
+    fs::create_directories(internal, ignored);
+    return outcome;
+  };
+  std::error_code error;
+  fs::create_directories(data, error);
+  std::string why;
+  if (error) return fall_back("could not make " + data.string() + ": " + error.message());
+  if (Look(data, why) != Presence::kFolder)
+    return fall_back(why.empty() ? data.string() + " is not a folder" : why);
+  const fs::path probe = data / kProbe;
+  if (!writer(probe, "fix 165\n", why)) {
+    fs::remove(probe, error);
+    return fall_back(why);
+  }
+  fs::remove(probe, error);
+  outcome.root = data;
+  if (data.lexically_normal() == internal.lexically_normal()) return outcome;
+  const Presence marker = Look(data / kMarker, why);
+  if (marker == Presence::kFile) {
+    outcome.already = true;
+    return outcome;
+  }
+  bool ok = marker != Presence::kError;
+  if (!ok) outcome.lines.push_back("could not look at the marker: " + why);
+  if (Look(internal, why) == Presence::kFolder) {
+    for (const Item& item : kMoved)
+      if (!MoveItem(item, internal, data, writer, outcome)) ok = false;
+  }
+  if (ok) {
+    std::string text = "fix 165: the user's files moved from " + internal.string() + "\n";
+    for (const auto& line : outcome.lines) text += line + "\n";
+    if (writer(data / kMarker, text, why)) outcome.marked = true;
+    else outcome.lines.push_back("could not write the marker (the next start looks again): " + why);
+  }
+  return outcome;
+}
+
+// The boot and log line.
+inline std::string Summary(const Outcome& outcome) {
+  if (outcome.fallback)
+    return outcome.root.string() + " (the internal storage: " + outcome.why + ")";
+  if (outcome.already) return outcome.root.string();
+  return outcome.root.string() + " (" + std::to_string(outcome.moved) +
+         (outcome.moved == 1 ? " item" : " items") + " moved from " + outcome.internal.string() +
+         (outcome.marked ? "" : "; not finished, the next start tries again") + ")";
+}
+
+}  // namespace xbox360ps5::user_storage
