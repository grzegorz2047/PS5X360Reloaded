diff --git a/include/xbox360ps5/xna_title.hpp b/include/xbox360ps5/xna_title.hpp
new file mode 100644
--- /dev/null
+++ b/include/xbox360ps5/xna_title.hpp
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: MIT
+// Fix 189 (issue #82): games built on Microsoft's XNA framework (Charlie Murder, the Xbox Live
+// Indie Games) start a .NET Compact Framework runtime (RuntimeHost.xex, NetCFUserMode.dll) that
+// runs the game's managed code in the Xbox 360 kernel's user mode: a second address space made
+// by KeCreateUserMode, entered and left with KeEnterUserMode and KeLeaveUserMode, its
+// translations flushed with KeFlushUserMode*Tb. The emulator implements none of them, so the
+// runtime's thread ends (exit code FFFFFFFF), the title's launcher asks for the dashboard
+// (XamLoaderLaunchTitle with a null name) and the app went back to the menu without a word.
+//
+// The CPU backend notes each guest call to a kernel export it does not implement
+// (NoteUndefinedCall, by the export's name, so any XNA title is found the same way); when the
+// title then ends, the title switch's restart hook writes the launcher's note (NoticeLine) and
+// the menu says why the game did not start. Header-only, no Xenia headers (host-checked).
+#pragma once
+#include <atomic>
+#include <string>
+#include <string_view>
+
+namespace xbox360ps5::xna_title {
+
+// The kernel's user-mode exports the XNA runtime calls (xboxkrnl ordinals 0x58, 0x60, 0x64,
+// 0x65, 0x7E).
+inline bool IsUserModeExport(std::string_view name) {
+  return name == "KeCreateUserMode" || name == "KeEnterUserMode" || name == "KeLeaveUserMode" ||
+         name == "KeFlushUserModeCurrentTb" || name == "KeFlushUserModeTb";
+}
+
+inline std::atomic<bool> g_user_mode_called{false};
+
+// For each guest call to an unimplemented kernel export: true the first time it is one of the
+// user-mode exports (the caller logs it once).
+inline bool NoteUndefinedCall(std::string_view name) {
+  if (!IsUserModeExport(name)) return false;
+  return !g_user_mode_called.exchange(true, std::memory_order_relaxed);
+}
+
+// The title called the kernel's user mode, which the emulator does not have.
+inline bool Seen() { return g_user_mode_called.load(std::memory_order_relaxed); }
+
+// The launcher's note ("Could not launch the game: " is put before it): the game's name and the
+// translated reason, the reason alone when the title has no name.
+inline std::string NoticeLine(const std::string& game, const std::string& reason) {
+  return game.empty() ? reason : game + ": " + reason;
+}
+
+}  // namespace xbox360ps5::xna_title
