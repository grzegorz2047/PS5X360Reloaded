diff --git a/include/xbox360ps5/xbox_fitness.hpp b/include/xbox360ps5/xbox_fitness.hpp
new file mode 100644
--- /dev/null
+++ b/include/xbox360ps5/xbox_fitness.hpp
@@ -0,0 +1,148 @@
+// SPDX-License-Identifier: MIT
+// Fix 171 (Nike+ Kinect Training 4D53090F, issue 74; Zumba Fitness Core 4D4A07F0): the Xbox
+// Fitness exports of xam. Titles that link the FITNESS library (2.0.21173.0) look them up with
+// XexGetProcedureAddress by ordinal on first use and print "<name>: 0x%x" with 0x80004001 when
+// the lookup fails. Without them Nike never got a body profile and its "GET ATHLETE FIT"
+// screen waited forever after XamShowFitnessBodyProfileUI failed.
+//
+// On a console these calls go to the Xbox Live fitness service. Here they answer from this
+// header, kept apart from the kernel so the host check (tools/check-xbox-fitness.cpp) drives
+// the same code:
+//   body profile  XamFitnessGetCurrentBodyProfileRecord's 0x10-byte record, packed and
+//                 big-endian: +0 version (1), +1 gender (1 male, 2 female), +2 height in
+//                 metres (float), +6 weight in kilograms (float), +0xA birth year (u16),
+//                 +0xC zero. The library (Zumba 82504320, the same code in Nike) turns height
+//                 x 100 into centimetres and the current year minus the birth year into the
+//                 age; its own defaults are 175 cm, 75 kg, 28 years, male. The default profile
+//                 is that body, so the calorie maths stays what the title would do alone;
+//   MsgTime       seconds since 2003-01-01 00:00 (XamFitnessSystemTimeToMsgTime and back);
+//   privacy       XamFitnessGetPrivacySettings: 1 for a profile that is not on Xbox Live,
+//                 2 (the Live default) for one that is.
+// No Xenia headers here.
+#pragma once
+#include <cstdint>
+#include <cstring>
+
+namespace xbox360ps5::fitness {
+
+constexpr uint32_t kBodyProfileRecordSize = 0x10;
+constexpr uint8_t kBodyProfileVersion = 1;
+constexpr uint8_t kGenderMale = 1;
+constexpr uint8_t kGenderFemale = 2;
+// The FITNESS library's own defaults when it has no record.
+constexpr float kDefaultHeightMetres = 1.75f;
+constexpr float kDefaultWeightKilograms = 75.0f;
+constexpr uint16_t kDefaultAgeYears = 28;
+
+struct BodyProfile {
+  bool female = false;
+  float height_metres = kDefaultHeightMetres;
+  float weight_kilograms = kDefaultWeightKilograms;
+  uint16_t birth_year = 0;
+};
+
+inline BodyProfile DefaultBodyProfile(uint16_t current_year) {
+  BodyProfile profile;
+  profile.birth_year = uint16_t(current_year - kDefaultAgeYears);
+  return profile;
+}
+
+inline void StoreBe16(uint8_t* out, uint16_t value) {
+  out[0] = uint8_t(value >> 8);
+  out[1] = uint8_t(value);
+}
+inline void StoreBe32(uint8_t* out, uint32_t value) {
+  out[0] = uint8_t(value >> 24);
+  out[1] = uint8_t(value >> 16);
+  out[2] = uint8_t(value >> 8);
+  out[3] = uint8_t(value);
+}
+inline void StoreBeFloat(uint8_t* out, float value) {
+  uint32_t bits;
+  std::memcpy(&bits, &value, sizeof(bits));
+  StoreBe32(out, bits);
+}
+
+// Writes the record into a guest buffer of `size` bytes (the title passes 0x10; a shorter
+// buffer gets the leading bytes). Returns the bytes written.
+inline uint32_t WriteBodyProfileRecord(uint8_t* out, uint32_t size, const BodyProfile& profile) {
+  uint8_t record[kBodyProfileRecordSize] = {};
+  record[0] = kBodyProfileVersion;
+  record[1] = profile.female ? kGenderFemale : kGenderMale;
+  StoreBeFloat(record + 2, profile.height_metres);
+  StoreBeFloat(record + 6, profile.weight_kilograms);
+  StoreBe16(record + 0xA, profile.birth_year);
+  const uint32_t n = size < kBodyProfileRecordSize ? size : kBodyProfileRecordSize;
+  std::memcpy(out, record, n);
+  return n;
+}
+
+// Days since 1970-01-01 of a proleptic Gregorian date (H. Hinnant's days_from_civil).
+inline int64_t DaysFromCivil(int64_t year, uint32_t month, uint32_t day) {
+  year -= month <= 2;
+  const int64_t era = (year >= 0 ? year : year - 399) / 400;
+  const uint32_t yoe = uint32_t(year - era * 400);
+  const uint32_t doy = (153 * (month + (month > 2 ? -3 : 9)) + 2) / 5 + day - 1;
+  const uint32_t doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+  return era * 146097 + int64_t(doe) - 719468;
+}
+
+struct SystemTime {
+  uint16_t year, month, day_of_week, day, hour, minute, second, milliseconds;
+};
+
+inline bool ValidSystemTime(const SystemTime& t) {
+  return t.year >= 2003 && t.year <= 2139 && t.month >= 1 && t.month <= 12 && t.day >= 1 &&
+         t.day <= 31 && t.hour < 24 && t.minute < 60 && t.second < 60;
+}
+
+inline uint32_t SystemTimeToMsgTime(const SystemTime& t) {
+  const int64_t days = DaysFromCivil(t.year, t.month, t.day) - DaysFromCivil(2003, 1, 1);
+  return uint32_t(days * 86400 + t.hour * 3600 + t.minute * 60 + t.second);
+}
+
+struct CivilDate {
+  int64_t year;
+  uint32_t month, day;
+};
+
+// The date of a day counted from 1970-01-01 (H. Hinnant's civil_from_days).
+inline CivilDate CivilFromDays(int64_t days) {
+  const int64_t z = days + 719468;
+  const int64_t era = (z >= 0 ? z : z - 146096) / 146097;
+  const uint32_t doe = uint32_t(z - era * 146097);
+  const uint32_t yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
+  const uint32_t doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+  const uint32_t mp = (5 * doy + 2) / 153;
+  CivilDate date;
+  date.day = doy - (153 * mp + 2) / 5 + 1;
+  date.month = mp < 10 ? mp + 3 : mp - 9;
+  date.year = int64_t(yoe) + era * 400 + (date.month <= 2);
+  return date;
+}
+
+// The year of a Unix time (seconds since 1970-01-01 UTC), for the default birth year.
+inline uint16_t YearOfUnixTime(int64_t unix_seconds) {
+  const int64_t days = (unix_seconds >= 0 ? unix_seconds : unix_seconds - 86399) / 86400;
+  const int64_t year = CivilFromDays(days).year;
+  return year < 2003 ? uint16_t(2003) : year > 9999 ? uint16_t(9999) : uint16_t(year);
+}
+
+inline SystemTime MsgTimeToSystemTime(uint32_t msg_time) {
+  const int64_t days = int64_t(msg_time / 86400) + DaysFromCivil(2003, 1, 1);
+  const uint32_t rest = msg_time % 86400;
+  const CivilDate date = CivilFromDays(days);
+  SystemTime t = {};
+  t.year = uint16_t(date.year);
+  t.month = uint16_t(date.month);
+  t.day = uint16_t(date.day);
+  t.day_of_week = uint16_t((days % 7 + 11) % 7);  // 1970-01-01 was a Thursday (4)
+  t.hour = uint16_t(rest / 3600);
+  t.minute = uint16_t(rest / 60 % 60);
+  t.second = uint16_t(rest % 60);
+  return t;
+}
+
+inline uint32_t PrivacySetting(bool signed_in_to_live) { return signed_in_to_live ? 2 : 1; }
+
+}  // namespace xbox360ps5::fitness
