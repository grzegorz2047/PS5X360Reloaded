+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+// TrinityX360 fix 171 (Nike+ Kinect Training 4D53090F, issue 74; Zumba Fitness Core 4D4A07F0):
+// the Xbox Fitness exports. Titles that link the FITNESS library (2.0.21173.0) look them up
+// with XexGetProcedureAddress("xam.xex", ordinal) on first use; none existed, so every call
+// came back 0x80004001 ("XamFitnessInitialize: 0x80004001" and so on in the log). Nike then had
+// no body profile, its XamShowFitnessBodyProfileUI call failed too, and its "GET ATHLETE FIT"
+// screen waited forever.
+//
+// On a console these go to the Xbox Live fitness service. Here:
+//   XamFitnessInitialize(&ready)          writes 1 (the service has data), success;
+//   XamFitnessInitializeForOneUser(u, &r) the same for one user;
+//   XamFitnessUnInitialize()              success;
+//   XamFitnessGetCurrentBodyProfileRecord(user, buffer, size)
+//                                         the default body (the library's own: 1.75 m, 75 kg,
+//                                         28 years, male) as the 0x10-byte record of
+//                                         xbox360ps5/xbox_fitness.hpp; E_FAIL without a
+//                                         signed-in profile at that index, as xam;
+//   XamFitnessAddFitnessEvent(user, event, size)
+//                                         the workout is logged, nothing is kept, success;
+//   XamFitnessGetPrivacySettings(user, &setting)
+//                                         1 for a profile not on Xbox Live, 2 for one on it;
+//   XamFitnessGetSuggestedPrivacySettings(user, &setting)
+//                                         2, the setting a Live profile starts with;
+//   XamFitnessSystemTimeToMsgTime / XamFitnessMsgTimeToSystemTime
+//                                         seconds since 2003-01-01;
+//   XamShowFitnessBodyProfileUI, XamShowFitnessWarnAboutPrivacyUI, XamShowFitnessWarnAboutTimeUI
+//                                         no screen here: the system interface opens and closes
+//                                         (XN_SYS_UI true, then false 200 ms later) and the call
+//                                         succeeds, as when the player closes the screen. The
+//                                         body profile stays the default one.
+// The first 16 calls of each are logged ("Xbox Fitness: ... (fix 171)").
+
+#include <atomic>
+#include <chrono>
+#include <functional>
+
+#include "xbox360ps5/xbox_fitness.hpp"
+#include "xenia/base/logging.h"
+#include "xenia/kernel/kernel_state.h"
+#include "xenia/kernel/util/shim_utils.h"
+#include "xenia/kernel/xam/xam_private.h"
+#include "xenia/xbox.h"
+
+namespace xe {
+namespace kernel {
+namespace xam {
+
+// xam_ui.cc: shows nothing; XN_SYS_UI true, the callback, XN_SYS_UI false a little later.
+X_RESULT xeXamDispatchHeadless(std::function<X_RESULT()> run_callback, uint32_t overlapped);
+
+namespace {
+namespace fitness = xbox360ps5::fitness;
+
+std::atomic<uint32_t> fitness_calls_shown{0};
+bool FitnessLogAllowed() { return fitness_calls_shown.fetch_add(1) < 16; }
+
+UserProfile* FitnessUser(uint32_t user_index) {
+  if (user_index >= XUserMaxUserCount) return nullptr;
+  if (!kernel_state()->xam_state()->IsUserSignedIn(user_index)) return nullptr;
+  return kernel_state()->xam_state()->GetUserProfile(user_index);
+}
+
+uint16_t CurrentYear() {
+  const auto now = std::chrono::system_clock::now().time_since_epoch();
+  return fitness::YearOfUnixTime(
+      std::chrono::duration_cast<std::chrono::seconds>(now).count());
+}
+
+X_RESULT FitnessScreen(const char* name, uint32_t a1, uint32_t a2, uint32_t a3) {
+  if (FitnessLogAllowed())
+    XELOGW("Xbox Fitness: {}({:08X}, {:08X}, {:08X}): no screen here, closed with success "
+           "(fix 171)",
+           name, a1, a2, a3);
+  return xeXamDispatchHeadless([]() -> X_RESULT { return X_ERROR_SUCCESS; }, 0);
+}
+}  // namespace
+
+dword_result_t XamFitnessInitialize_entry(lpdword_t ready) {
+  if (!ready) return X_E_INVALIDARG;
+  *ready = 1;
+  if (FitnessLogAllowed())
+    XELOGW("Xbox Fitness: XamFitnessInitialize -> success, service ready (fix 171)");
+  return X_E_SUCCESS;
+}
+DECLARE_XAM_EXPORT1(XamFitnessInitialize, kNone, kSketchy);
+
+dword_result_t XamFitnessInitializeForOneUser_entry(dword_t user_index, lpdword_t ready) {
+  if (user_index >= XUserMaxUserCount || !ready) return X_E_INVALIDARG;
+  *ready = 1;
+  if (FitnessLogAllowed())
+    XELOGW("Xbox Fitness: XamFitnessInitializeForOneUser({}) -> success (fix 171)",
+           uint32_t(user_index));
+  return X_E_SUCCESS;
+}
+DECLARE_XAM_EXPORT1(XamFitnessInitializeForOneUser, kNone, kSketchy);
+
+dword_result_t XamFitnessUnInitialize_entry() { return X_E_SUCCESS; }
+DECLARE_XAM_EXPORT1(XamFitnessUnInitialize, kNone, kSketchy);
+
+dword_result_t XamFitnessGetCurrentBodyProfileRecord_entry(dword_t user_index, lpvoid_t buffer,
+                                                           dword_t size) {
+  const uint32_t length = uint32_t(size) & 0xFFFF;
+  if (user_index >= XUserMaxUserCount || !buffer || !length) return X_E_INVALIDARG;
+  if (!FitnessUser(uint32_t(user_index))) {
+    if (FitnessLogAllowed())
+      XELOGW("Xbox Fitness: XamFitnessGetCurrentBodyProfileRecord({}): no profile signed in "
+             "there, E_FAIL (fix 171)",
+             uint32_t(user_index));
+    return X_E_FAIL;
+  }
+  const fitness::BodyProfile profile = fitness::DefaultBodyProfile(CurrentYear());
+  fitness::WriteBodyProfileRecord(buffer.as<uint8_t*>(), length, profile);
+  if (FitnessLogAllowed())
+    XELOGW("Xbox Fitness: XamFitnessGetCurrentBodyProfileRecord({}, {:08X}, {}) -> the default "
+           "body: {} cm, {} kg, born {}, male (fix 171)",
+           uint32_t(user_index), buffer.guest_address(), length,
+           int(profile.height_metres * 100.0f + 0.5f), int(profile.weight_kilograms),
+           profile.birth_year);
+  return X_E_SUCCESS;
+}
+DECLARE_XAM_EXPORT1(XamFitnessGetCurrentBodyProfileRecord, kNone, kSketchy);
+
+dword_result_t XamFitnessAddFitnessEvent_entry(dword_t user_index, lpvoid_t event,
+                                               dword_t size) {
+  const uint32_t length = uint32_t(size) & 0xFFFF;
+  if (user_index >= XUserMaxUserCount || !event || !length) return X_E_INVALIDARG;
+  if (!FitnessUser(uint32_t(user_index))) return X_E_FAIL;
+  // Nike's event (0xC bytes): start (MsgTime), seconds (u16), calories (u32), kind, MET x 10.
+  const uint8_t* data = event.as<const uint8_t*>();
+  if (length >= 0xC)
+    XELOGW("Xbox Fitness: workout of user {}: start {}, {} s, {} kcal, kind {:02X}, MET {:.1f}, "
+           "not kept (fix 171)",
+           uint32_t(user_index), xe::load_and_swap<uint32_t>(data),
+           xe::load_and_swap<uint16_t>(data + 4), xe::load_and_swap<uint32_t>(data + 6),
+           data[0xA], data[0xB] / 10.0);
+  else
+    XELOGW("Xbox Fitness: workout event of user {} ({} bytes), not kept (fix 171)",
+           uint32_t(user_index), length);
+  return X_E_SUCCESS;
+}
+DECLARE_XAM_EXPORT1(XamFitnessAddFitnessEvent, kNone, kSketchy);
+
+dword_result_t XamFitnessGetPrivacySettings_entry(dword_t user_index, lpdword_t setting) {
+  if (user_index >= XUserMaxUserCount || !setting) return X_E_INVALIDARG;
+  UserProfile* user = FitnessUser(uint32_t(user_index));
+  if (!user) return X_E_FAIL;
+  *setting = fitness::PrivacySetting(user->IsSignedInToLive());
+  if (FitnessLogAllowed())
+    XELOGW("Xbox Fitness: XamFitnessGetPrivacySettings({}) -> {} (fix 171)",
+           uint32_t(user_index), setting.value());
+  return X_E_SUCCESS;
+}
+DECLARE_XAM_EXPORT1(XamFitnessGetPrivacySettings, kNone, kSketchy);
+
+dword_result_t XamFitnessGetSuggestedPrivacySettings_entry(dword_t user_index,
+                                                           lpdword_t setting) {
+  if (user_index >= XUserMaxUserCount || !setting) return X_E_INVALIDARG;
+  *setting = fitness::PrivacySetting(true);
+  return X_E_SUCCESS;
+}
+DECLARE_XAM_EXPORT1(XamFitnessGetSuggestedPrivacySettings, kNone, kSketchy);
+
+struct X_FITNESS_SYSTEMTIME {
+  xe::be<uint16_t> year;
+  xe::be<uint16_t> month;
+  xe::be<uint16_t> day_of_week;
+  xe::be<uint16_t> day;
+  xe::be<uint16_t> hour;
+  xe::be<uint16_t> minute;
+  xe::be<uint16_t> second;
+  xe::be<uint16_t> milliseconds;
+};
+static_assert_size(X_FITNESS_SYSTEMTIME, 0x10);
+
+dword_result_t XamFitnessSystemTimeToMsgTime_entry(pointer_t<X_FITNESS_SYSTEMTIME> system_time,
+                                                   lpdword_t msg_time) {
+  if (!system_time || !msg_time) return X_E_INVALIDARG;
+  fitness::SystemTime t = {};
+  t.year = system_time->year;
+  t.month = system_time->month;
+  t.day = system_time->day;
+  t.hour = system_time->hour;
+  t.minute = system_time->minute;
+  t.second = system_time->second;
+  if (!fitness::ValidSystemTime(t)) return X_E_INVALIDARG;
+  *msg_time = fitness::SystemTimeToMsgTime(t);
+  return X_E_SUCCESS;
+}
+DECLARE_XAM_EXPORT1(XamFitnessSystemTimeToMsgTime, kNone, kImplemented);
+
+dword_result_t XamFitnessMsgTimeToSystemTime_entry(dword_t msg_time,
+                                                   pointer_t<X_FITNESS_SYSTEMTIME> system_time) {
+  if (!system_time) return X_E_INVALIDARG;
+  const fitness::SystemTime t = fitness::MsgTimeToSystemTime(uint32_t(msg_time));
+  system_time->year = t.year;
+  system_time->month = t.month;
+  system_time->day_of_week = t.day_of_week;
+  system_time->day = t.day;
+  system_time->hour = t.hour;
+  system_time->minute = t.minute;
+  system_time->second = t.second;
+  system_time->milliseconds = 0;
+  return X_E_SUCCESS;
+}
+DECLARE_XAM_EXPORT1(XamFitnessMsgTimeToSystemTime, kNone, kImplemented);
+
+dword_result_t XamShowFitnessBodyProfileUI_entry(dword_t a1, dword_t user_index, dword_t a3) {
+  return FitnessScreen("XamShowFitnessBodyProfileUI", uint32_t(a1), uint32_t(user_index),
+                       uint32_t(a3));
+}
+DECLARE_XAM_EXPORT1(XamShowFitnessBodyProfileUI, kUI, kSketchy);
+
+dword_result_t XamShowFitnessWarnAboutPrivacyUI_entry(dword_t a1, dword_t user_index,
+                                                      dword_t a3) {
+  return FitnessScreen("XamShowFitnessWarnAboutPrivacyUI", uint32_t(a1), uint32_t(user_index),
+                       uint32_t(a3));
+}
+DECLARE_XAM_EXPORT1(XamShowFitnessWarnAboutPrivacyUI, kUI, kSketchy);
+
+dword_result_t XamShowFitnessWarnAboutTimeUI_entry(dword_t a1, dword_t user_index, dword_t a3) {
+  return FitnessScreen("XamShowFitnessWarnAboutTimeUI", uint32_t(a1), uint32_t(user_index),
+                       uint32_t(a3));
+}
+DECLARE_XAM_EXPORT1(XamShowFitnessWarnAboutTimeUI, kUI, kSketchy);
+
+}  // namespace xam
+}  // namespace kernel
+}  // namespace xe
+
+DECLARE_XAM_EMPTY_REGISTER_EXPORTS(Fitness);
