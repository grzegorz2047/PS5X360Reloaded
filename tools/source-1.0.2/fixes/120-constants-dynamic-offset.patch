--- /dev/null
+++ b/.deps/xenia-canary/src/xenia/gpu/vulkan/constants_dynamic.h
@@ -0,0 +1,85 @@
+/**
+ ******************************************************************************
+ * Xbox360PS5: fix 120, the draw constants as dynamic uniform buffers.        *
+ ******************************************************************************
+ * The float constants change for nearly every draw, so UpdateBindings
+ * allocated a new descriptor set of the seven constant buffers and wrote all
+ * seven descriptors (vkUpdateDescriptorSets) for nearly every draw, only
+ * because a buffer's offset had moved within the uniform buffer pool's page.
+ * Bindings were the largest part of a draw's own time after fix 104: Red Dead
+ * Redemption 150 to 163 ms/s at 190,000 to 206,000 draws a second, Grand
+ * Theft Auto IV 191 to 203 ms/s (1.0.5-work-fix102-111, fix102-105).
+ *
+ * With dynamic uniform buffer descriptors the set holds each buffer with
+ * offset 0 and a fixed range (the most a binding's block can read), and the
+ * draw's offsets are given when the set is bound. A set is written only when
+ * one of the seven buffers (a page of the pool) changed, or in a new frame
+ * (sets are recycled once their frame has completed); a draw whose constants
+ * moved only within the same buffers binds the same set again with its
+ * offsets. The pool's pages carry a tail of the largest range, so that an
+ * offset near a page's end plus the fixed range stays inside the buffer.
+ ******************************************************************************
+ */
+
+#ifndef XENIA_GPU_VULKAN_CONSTANTS_DYNAMIC_H_
+#define XENIA_GPU_VULKAN_CONSTANTS_DYNAMIC_H_
+
+#include <cstdint>
+
+namespace xe {
+namespace gpu {
+namespace vulkan {
+namespace constants_dynamic {
+
+// Buffer is VkBuffer (any comparable handle), Set is VkDescriptorSet.
+template <typename Buffer, typename Set, uint32_t kCount>
+struct State {
+  bool valid = false;
+  uint64_t frame = 0;
+  Buffer buffers[kCount] = {};
+  Set set{};
+  uint32_t offsets[kCount] = {};  // the offsets of the previous draw
+
+  struct Decision {
+    bool write;   // a new set with these buffers
+    bool rebind;  // bind the set again (new offsets, or a new set); the
+                  // command processor's bound bit also rebinds it after a new
+                  // submission or another pipeline layout
+  };
+
+  // The draw's buffers and offsets in frame `frame_now`.
+  Decision Update(uint64_t frame_now, const Buffer* buffers_now,
+                  const uint32_t* offsets_now) {
+    bool write = !valid || frame != frame_now;
+    for (uint32_t i = 0; i < kCount && !write; ++i) {
+      write = buffers[i] != buffers_now[i];
+    }
+    bool rebind = write;
+    for (uint32_t i = 0; i < kCount; ++i) {
+      rebind |= offsets[i] != offsets_now[i];
+      offsets[i] = offsets_now[i];
+    }
+    if (write) {
+      valid = false;  // until Remember
+      for (uint32_t i = 0; i < kCount; ++i) {
+        buffers[i] = buffers_now[i];
+      }
+      frame = frame_now;
+    }
+    return {write, rebind};
+  }
+  // The set written for the buffers Update was given.
+  void Remember(Set set_now) {
+    set = set_now;
+    valid = true;
+  }
+  // The sets went back to their pool (ClearTransientDescriptorPools).
+  void Forget() { valid = false; }
+};
+
+}  // namespace constants_dynamic
+}  // namespace vulkan
+}  // namespace gpu
+}  // namespace xe
+
+#endif  // XENIA_GPU_VULKAN_CONSTANTS_DYNAMIC_H_
