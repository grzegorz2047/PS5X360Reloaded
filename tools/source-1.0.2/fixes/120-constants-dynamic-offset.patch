diff --git a/include/xbox360ps5/frame_cost.hpp b/include/xbox360ps5/frame_cost.hpp
--- a/include/xbox360ps5/frame_cost.hpp
+++ b/include/xbox360ps5/frame_cost.hpp
@@ -1215,6 +1215,40 @@ class Reporter {
   Snapshot last_{};  // the first line covers the time since the game started
 };
 
+// Fix 120: the draws' constant buffer sets with dynamic offsets: the draws that wrote a new set
+// (a buffer page changed, or a new frame) and those that only bound it again with new offsets;
+// "Performance constant sets (GPU thread, fix 120): n/s written, m/s bound again with new
+// offsets, k/s draws (x% written)" since its previous line.
+inline std::atomic<uint64_t> constant_set_draws{0}, constant_sets_written{0}, constant_sets_rebound{0};
+inline void CountConstantSets(bool written, bool rebound) {
+  if (!OnGpuThread()) return;
+  AddOwn(constant_set_draws, 1);
+  if (written) AddOwn(constant_sets_written, 1);
+  else if (rebound) AddOwn(constant_sets_rebound, 1);
+}
+class ConstantSetReporter {
+ public:
+  std::string Line(double seconds) {
+    const double s = seconds > 0 ? seconds : 1;
+    const uint64_t d = constant_set_draws.load(std::memory_order_relaxed);
+    const uint64_t w = constant_sets_written.load(std::memory_order_relaxed);
