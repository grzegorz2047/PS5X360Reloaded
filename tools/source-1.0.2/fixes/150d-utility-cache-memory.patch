+class Pool {
+ public:
+  struct Chunk {
+    uint8_t* data = nullptr;
+    uint32_t segment = 0;
+  };
+  // In use at most (3 GiB: GTA IV's whole set is about 1.98 GiB); the console's direct memory kept
+  // free (1 GiB) still decides first when memory is short.
+  std::atomic<uint64_t> cap{uint64_t(3) << 30};
+  std::atomic<int64_t> reserve{int64_t(1) << 30};
+  Backing backing{MapMappingSegment, UnmapMappingSegment};
+  int64_t (*direct_free)() = [] { return xbox360ps5::resolution_scale::DirectFreeRecent(); };
+
+  std::atomic<uint64_t> used{0}, peak{0}, mapped{0}, refused{0};
+  std::atomic<uint64_t> given_back{0};  // bytes freed by deletes, shorter lengths and closes, in all
+  static constexpr size_t kLargestListed = 8;
+
+  // The files with data (for the 30 s line); a file's Data adds and removes itself.
+  void Register(const Data* data) {
+    std::lock_guard<std::mutex> lock(files_mutex_);
+    files_.insert(data);
+  }
+  void Unregister(const Data* data) {
+    std::lock_guard<std::mutex> lock(files_mutex_);
+    files_.erase(data);
+  }
+
+  Chunk Allocate() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (used.load() + kChunkBytes > cap.load()) return Refuse();
+    for (uint32_t i = 0; i < segments_.size(); ++i) {
+      Segment& segment = segments_[i];
+      if (segment.base && segment.free_count) return Take(i);
+    }
+    const int64_t free_now = direct_free ? direct_free() : -1;
+    if (free_now >= 0 && free_now - int64_t(kSegmentBytes) < reserve.load()) return Refuse();
+    int64_t handle = -1;
+    void* base = backing.map ? backing.map(kSegmentBytes, &handle) : nullptr;
+    if (!base) return Refuse();
+    xbox360ps5::resolution_scale::NoteAdmitted(kSegmentBytes);
+    uint32_t index = 0;
+    while (index < segments_.size() && segments_[index].base) ++index;
+    if (index == segments_.size()) segments_.emplace_back();
+    Segment& segment = segments_[index];
+    segment.base = static_cast<uint8_t*>(base);
+    segment.handle = handle;
+    segment.free_list.clear();
+    for (uint32_t c = kChunksPerSegment; c-- > 0;) segment.free_list.push_back(uint16_t(c));
+    segment.free_count = kChunksPerSegment;
+    mapped.fetch_add(kSegmentBytes);
+    return Take(index);
+  }
+  void Release(const Chunk& chunk) {
+    if (!chunk.data) return;
+    std::lock_guard<std::mutex> lock(mutex_);
+    Segment& segment = segments_[chunk.segment];
+    segment.free_list.push_back(uint16_t((chunk.data - segment.base) / kChunkBytes));
+    ++segment.free_count;
+    used.fetch_sub(kChunkBytes);
+    given_back.fetch_add(kChunkBytes);
+    if (segment.free_count == kChunksPerSegment) {
+      if (backing.unmap) backing.unmap(segment.base, kSegmentBytes, segment.handle);
+      segment.base = nullptr;
+      segment.free_list.clear();
+      segment.free_count = 0;
+      mapped.fetch_sub(kSegmentBytes);
+    }
+  }
+  // The 30 s line's part: "; utility cache in memory ..." (defined after Data).
+  std::string Summary();
+
+ private:
+  struct Segment {
+    uint8_t* base = nullptr;
+    int64_t handle = -1;
+    std::vector<uint16_t> free_list;
+    uint32_t free_count = 0;
+  };
+  Chunk Refuse() {
+    refused.fetch_add(1);
+    return {};
+  }
+  Chunk Take(uint32_t index) {
+    Segment& segment = segments_[index];
+    const uint16_t c = segment.free_list.back();
+    segment.free_list.pop_back();
+    --segment.free_count;
+    const uint64_t now = used.fetch_add(kChunkBytes) + kChunkBytes;
+    uint64_t high = peak.load();
+    while (now > high && !peak.compare_exchange_weak(high, now)) {
+    }
+    Chunk chunk{segment.base + size_t(c) * kChunkBytes, index};
+    std::memset(chunk.data, 0, kChunkBytes);
+    return chunk;
+  }
+  std::mutex mutex_;
+  std::vector<Segment> segments_;
+  // Taken before a file's own mutex, never while holding it (Data::Write holds its own and then
+  // mutex_, so this one is separate).
+  std::mutex files_mutex_;
+  std::unordered_set<const Data*> files_;
+  // The largest files are listed again only when the use or the number of files changed.
+  uint64_t listed_used_ = ~uint64_t(0);
+  size_t listed_files_ = ~size_t(0);
+};
+
+inline Pool& pool() {
+  static Pool* instance = new Pool();  // never destroyed (entries may outlive static destruction)
+  return *instance;
+}
+
+// One file's bytes: sparse chunks, its length.
+class Data {
+ public:
+  explicit Data(Pool& pool, std::string name = {}) : pool_(pool), name_(std::move(name)) { pool_.Register(this); }
+  ~Data() {
+    pool_.Unregister(this);  // first: the 30 s line no longer looks at it
+    for (const auto& chunk : chunks_) pool_.Release(chunk);
+  }
+  // Its path in the guest (renames follow) and whether its entry was deleted while open.
+  void SetName(std::string name) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    name_ = std::move(name);
+  }
+  void MarkDeleted() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    deleted_ = true;
+  }
+  struct Facts {
+    std::string name;
+    uint64_t bytes = 0;  // in chunks
+    bool deleted = false;
+  };
+  Facts facts() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    Facts f{name_, 0, deleted_};
+    for (const auto& chunk : chunks_) f.bytes += chunk.data ? kChunkBytes : 0;
+    return f;
+  }
+  uint64_t size() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return size_;
+  }
+  // Bytes read (0 at or past the end).
+  size_t Read(uint8_t* out, size_t length, uint64_t offset) const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (offset >= size_) return 0;
+    length = size_t(std::min<uint64_t>(length, size_ - offset));
+    size_t done = 0;
+    while (done < length) {
+      const uint64_t at = offset + done;
+      const size_t index = size_t(at / kChunkBytes), within = size_t(at % kChunkBytes);
+      const size_t n = std::min(length - done, kChunkBytes - within);
+      if (index < chunks_.size() && chunks_[index].data) {
+        std::memcpy(out + done, chunks_[index].data + within, n);
+      } else {
+        std::memset(out + done, 0, n);
+      }
+      done += n;
+    }
+    return length;
+  }
+  // Bytes written; fewer when the pool refused a chunk.
+  size_t Write(const uint8_t* in, size_t length, uint64_t offset) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    size_t done = 0;
+    while (done < length) {
+      const uint64_t at = offset + done;
+      const size_t index = size_t(at / kChunkBytes), within = size_t(at % kChunkBytes);
+      const size_t n = std::min(length - done, kChunkBytes - within);
+      if (index >= chunks_.size()) chunks_.resize(index + 1);
+      if (!chunks_[index].data) {
+        chunks_[index] = pool_.Allocate();
+        if (!chunks_[index].data) break;
+      }
+      std::memcpy(chunks_[index].data + within, in + done, n);
+      done += n;
+    }
+    size_ = std::max<uint64_t>(size_, offset + done);
+    return done;
+  }
+  // A longer length reads as zeros; a shorter one gives the chunks past it back.
+  void SetLength(uint64_t length) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    const size_t keep = size_t((length + kChunkBytes - 1) / kChunkBytes);
+    for (size_t i = keep; i < chunks_.size(); ++i) pool_.Release(chunks_[i]);
+    if (chunks_.size() > keep) chunks_.resize(keep);
+    const size_t within = size_t(length % kChunkBytes);
+    if (length < size_ && within && keep && keep <= chunks_.size() && chunks_[keep - 1].data) {
+      std::memset(chunks_[keep - 1].data + within, 0, kChunkBytes - within);
+    }
+    size_ = length;
+  }
+  size_t chunk_count() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    size_t n = 0;
+    for (const auto& chunk : chunks_) n += chunk.data != nullptr;
+    return n;
+  }
+
+ private:
+  Pool& pool_;
+  mutable std::mutex mutex_;
+  std::vector<Pool::Chunk> chunks_;
+  uint64_t size_ = 0;
+  std::string name_;
+  bool deleted_ = false;
+};
+
+inline std::string Pool::Summary() {
+  auto mib = [](uint64_t bytes) { return double(bytes) / 1048576.0; };
+  char text[320];
+  const int64_t free_now = direct_free ? direct_free() : -1;
+  std::snprintf(text, sizeof(text),
+                "; utility cache in memory (fix 150d): %.1f MiB used, peak %.1f MiB, %.0f MiB mapped, cap %.0f MiB, "
+                "%llu writes refused, direct free %lld MiB",
+                mib(used.load()), mib(peak.load()), mib(mapped.load()), mib(cap.load()),
+                (unsigned long long)refused.load(), free_now < 0 ? -1LL : (long long)(free_now >> 20));
+  std::string out = text;
+  std::vector<Data::Facts> all;
+  bool list;
+  {
+    std::lock_guard<std::mutex> lock(files_mutex_);
+    all.reserve(files_.size());
+    for (const Data* data : files_) all.push_back(data->facts());
+    const uint64_t now_used = used.load();
+    list = now_used != listed_used_ || all.size() != listed_files_;
+    listed_used_ = now_used;
+    listed_files_ = all.size();
+  }
+  size_t deleted = 0;
+  uint64_t deleted_bytes = 0;
+  for (const auto& f : all) {
+    if (!f.deleted) continue;
+    ++deleted;
+    deleted_bytes += f.bytes;
+  }
+  std::snprintf(text, sizeof(text), "; %zu files (%zu deleted and still open, %.1f MiB), %.1f MiB given back in all",
+                all.size(), deleted, mib(deleted_bytes), mib(given_back.load()));
+  out += text;
+  if (!list) return out + "; largest files as before";
+  const size_t n = std::min(all.size(), kLargestListed);
+  std::partial_sort(all.begin(), all.begin() + n, all.end(), [](const Data::Facts& a, const Data::Facts& b) {
+    return a.bytes != b.bytes ? a.bytes > b.bytes : a.name < b.name;
+  });
+  out += "; largest:";
+  for (size_t i = 0; i < n; ++i) {
+    std::snprintf(text, sizeof(text), "%s %s %.1f MiB%s", i ? "," : "", all[i].name.c_str(), mib(all[i].bytes),
+                  all[i].deleted ? " (deleted, open)" : "");
+    out += text;
+  }
+  if (!n) out += " none";
+  return out;
+}
+
+inline std::string ReportTail() { return pool().Summary(); }
