+inline constexpr size_t kChunkBytes = 64 * 1024;
+inline constexpr size_t kSegmentBytes = 16 * 1024 * 1024;
+inline constexpr size_t kChunksPerSegment = kSegmentBytes / kChunkBytes;
+static_assert(kChunksPerSegment == 256);
+
+// Where the segments' memory comes from (file mappings by default; the check counts its own).
+// The handle stays open while the view is mapped: on the console, closing it gives the direct
+// memory back (platform/ps5/memory_ps5.cpp).
+struct Backing {
+  void* (*map)(size_t bytes, int64_t* handle) = nullptr;
+  void (*unmap)(void* base, size_t bytes, int64_t handle) = nullptr;
+};
+
+inline void* MapMappingSegment(size_t bytes, int64_t* out_handle) {
+  static std::atomic<uint32_t> next{0};
+  const std::string name = "xenia_utility_cache_n" + std::to_string(next.fetch_add(1));
+  const auto handle = xe::memory::CreateFileMappingHandle(name, bytes, xe::memory::PageAccess::kReadWrite, true);
+  if (handle == xe::memory::kFileMappingHandleInvalid) return nullptr;
+  void* base = xe::memory::MapFileView(handle, nullptr, bytes, xe::memory::PageAccess::kReadWrite, 0);
+  if (!base) {
+    xe::memory::CloseFileMappingHandle(handle, name);
+    return nullptr;
+  }
+  *out_handle = int64_t(handle);
+  return base;
+}
+inline void UnmapMappingSegment(void* base, size_t bytes, int64_t handle) {
+  const auto h = xe::memory::FileMappingHandle(handle);
+  xe::memory::UnmapFileView(h, base, bytes);
+  // The name only matters for shm_open handles (unlinked here); memfd and the console ignore it.
+  xe::memory::CloseFileMappingHandle(h, std::string());
+}
