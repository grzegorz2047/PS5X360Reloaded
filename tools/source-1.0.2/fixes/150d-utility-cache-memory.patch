+class MemoryFile : public File {
+ public:
+  MemoryFile(uint32_t file_access, MemoryEntry* entry);
+  ~MemoryFile() override = default;
+  void Destroy() override;
+  X_STATUS ReadSync(std::span<uint8_t> buffer, size_t byte_offset, size_t* out_bytes_read) override;
+  X_STATUS WriteSync(std::span<const uint8_t> buffer, size_t byte_offset, size_t* out_bytes_written) override;
+  X_STATUS SetLength(size_t length) override;
+};
+
+class MemoryEntry : public Entry {
+ public:
+  MemoryEntry(Device* device, Entry* parent, const std::string_view path, uint32_t attributes,
+              memory_cache::Pool& pool)
+      : Entry(device, parent, path), pool_(pool) {
+    attributes_ = attributes;
+    create_timestamp_ = access_timestamp_ = write_timestamp_ = xe::Clock::QueryHostSystemTime();
+    if (!(attributes & kFileAttributeDirectory))
+      data_ = std::make_unique<memory_cache::Data>(pool, absolute_path());
+  }
+  ~MemoryEntry() override = default;
+
+  X_STATUS Open(uint32_t desired_access, File** out_file) override {
+    *out_file = new MemoryFile(desired_access, this);
+    return X_STATUS_SUCCESS;
+  }
+  void update() override { SyncSize(); }
+  bool SetAttributes(uint64_t attributes) override {
+    attributes_ = (attributes_ & kFileAttributeDirectory) | (uint32_t(attributes) & ~kFileAttributeDirectory);
+    return true;
+  }
+  bool SetCreateTimestamp(uint64_t timestamp) override {
+    create_timestamp_ = timestamp;
+    return true;
+  }
+  bool SetAccessTimestamp(uint64_t timestamp) override {
+    access_timestamp_ = timestamp;
+    return true;
+  }
+  bool SetWriteTimestamp(uint64_t timestamp) override {
+    write_timestamp_ = timestamp;
+    return true;
+  }
+
+  memory_cache::Data* data() { return data_.get(); }
+  void SyncSize() {
+    if (!data_) return;
+    size_ = size_t(data_->size());
+    allocation_size_ = xe::round_up(size_, size_t(device_->bytes_per_sector()));
+  }
+  void Wrote() {
+    SyncSize();
+    write_timestamp_ = xe::Clock::QueryHostSystemTime();
+  }
+
+ private:
+  std::unique_ptr<Entry> CreateEntryInternal(const std::string_view name, uint32_t attributes) override {
+    return std::make_unique<MemoryEntry>(device_, this, xe::utf8::join_guest_paths(path_, name), attributes, pool_);
+  }
+  // Its data stays with the entry (open handles still use it) and goes with it; a file is marked
+  // deleted for the 30 s line (this runs without the global lock, so a directory's children are
+  // not walked: they are freed with it).
+  bool DeleteEntryInternal(Entry* entry) override {
+    if (auto* data = static_cast<MemoryEntry*>(entry)->data()) data->MarkDeleted();
+    return true;
+  }
+  // The name in the 30 s line follows a rename (Entry::Rename sets the paths after this).
+  void RenameEntryInternal(const std::vector<std::string_view>& path_parts) override {
+    if (data_) data_->SetName(xe::utf8::join_guest_paths(device_->mount_path(), xe::utf8::join_guest_paths(path_parts)));
+  }
+
+  memory_cache::Pool& pool_;
+  std::unique_ptr<memory_cache::Data> data_;
+};
+
+inline MemoryFile::MemoryFile(uint32_t file_access, MemoryEntry* entry) : File(file_access, entry) {}
+
+inline void MemoryFile::Destroy() {
+  // As HostPathFile (fix 139): the entry is still allocated while this file uses it.
+  if (entry_ && Entry::InUse(entry_) && entry_->delete_on_close()) entry()->Delete();
+  delete this;
+}
+
+inline X_STATUS MemoryFile::ReadSync(std::span<uint8_t> buffer, size_t byte_offset, size_t* out_bytes_read) {
+  if (!(file_access_ & (FileAccess::kGenericRead | FileAccess::kFileReadData))) return X_STATUS_ACCESS_DENIED;
+  auto* data = static_cast<MemoryEntry*>(entry_)->data();
+  if (!data) return X_STATUS_INVALID_DEVICE_REQUEST;
+  namespace pio = xbox360ps5::package_io;
+  const auto start = std::chrono::steady_clock::now();
+  *out_bytes_read = data->Read(buffer.data(), buffer.size(), byte_offset);
+  const uint64_t ns = uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                   std::chrono::steady_clock::now() - start).count());
+  pio::Add(pio::file_io.memory_reads, *out_bytes_read, ns);
+  // As HostPathFile (fix 148c): EOF only for a read of nothing at or past the end.
+  if (!buffer.empty() && *out_bytes_read == 0) return X_STATUS_END_OF_FILE;
+  return X_STATUS_SUCCESS;
+}
+
+inline X_STATUS MemoryFile::WriteSync(std::span<const uint8_t> buffer, size_t byte_offset,
+                                      size_t* out_bytes_written) {
+  if (!(file_access_ & (FileAccess::kGenericWrite | FileAccess::kFileWriteData | FileAccess::kFileAppendData)))
+    return X_STATUS_ACCESS_DENIED;
+  auto* entry = static_cast<MemoryEntry*>(entry_);
+  if (!entry->data()) return X_STATUS_INVALID_DEVICE_REQUEST;
+  namespace pio = xbox360ps5::package_io;
+  const auto start = std::chrono::steady_clock::now();
+  *out_bytes_written = entry->data()->Write(buffer.data(), buffer.size(), byte_offset);
+  const uint64_t ns = uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                   std::chrono::steady_clock::now() - start).count());
+  pio::Add(pio::file_io.memory_writes, *out_bytes_written, ns);
+  entry->Wrote();
+  const uint64_t now_ns = uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                       std::chrono::steady_clock::now().time_since_epoch()).count());
+  const std::string line = pio::FileIoReport(pio::file_io, now_ns);
+  if (!line.empty()) XELOGW("{}", line);
+  return *out_bytes_written == buffer.size() ? X_STATUS_SUCCESS : X_STATUS_DISK_FULL;
+}
+
+inline X_STATUS MemoryFile::SetLength(size_t length) {
+  if (!(file_access_ & (FileAccess::kGenericWrite | FileAccess::kFileWriteData))) return X_STATUS_ACCESS_DENIED;
+  auto* entry = static_cast<MemoryEntry*>(entry_);
+  if (!entry->data()) return X_STATUS_INVALID_DEVICE_REQUEST;
+  entry->data()->SetLength(length);
+  entry->Wrote();
+  return X_STATUS_SUCCESS;
+}
+
+class MemoryDevice : public Device {
+ public:
+  explicit MemoryDevice(const std::string_view mount_path, memory_cache::Pool& pool = memory_cache::pool())
+      : Device(mount_path), pool_(pool) {}
+  ~MemoryDevice() override = default;
+
+  bool Initialize() override {
+    root_entry_ = std::make_unique<MemoryEntry>(this, nullptr, "", kFileAttributeDirectory, pool_);
+    xbox360ps5::package_io::memory_tail.store(&memory_cache::ReportTail);
+    return true;
+  }
+  void Dump(StringBuffer* string_buffer) override {
+    auto global_lock = global_critical_region_.Acquire();
+    root_entry_->Dump(string_buffer, 0);
+  }
+  Entry* ResolvePath(const std::string_view path) override { return root_entry_->ResolvePath(path); }
+  bool is_read_only() const override { return false; }
+
+  const std::string& name() const override { return name_; }
+  uint32_t attributes() const override { return 0; }
+  uint32_t component_name_max_length() const override { return 255; }
+  // As HostPathDevice (64 MiB, all free): GTA IV does not size its cache from it.
+  uint32_t total_allocation_units() const override { return 128 * 1024; }
+  uint32_t available_allocation_units() const override { return 128 * 1024; }
+  uint32_t sectors_per_allocation_unit() const override { return 1; }
+  uint32_t bytes_per_sector() const override { return 0x200; }
+
+ private:
+  memory_cache::Pool& pool_;
+  std::string name_ = "FATX";
+  std::unique_ptr<Entry> root_entry_;
+};
