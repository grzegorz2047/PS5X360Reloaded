@@ -47,6 +48,21 @@ inline BugReportFlags RestartFlags(bool with_logs, bool title_known) {
 // row on the settings page does, and it is kept by the same rule.
 inline const char* MuteRowValue(int mute) { return mute ? "On" : "Off"; }
 
+// Fix 115b: the running game's name in the guide's header ("Playing: <game>"), cut at a whole
+// UTF-8 character and ended with "..." when it is wider than `room` (width(text) measures it in the
+// header's font); empty when not even "..." fits.
+template <typename Width>
+std::string FitText(std::string text, float room, Width&& width) {
+  if (width(text) <= room) return text;
+  while (!text.empty()) {
+    while (!text.empty() && (static_cast<unsigned char>(text.back()) & 0xC0) == 0x80) text.pop_back();
+    if (!text.empty()) text.pop_back();
+    while (!text.empty() && text.back() == ' ') text.pop_back();
+    if (!text.empty() && width(text + "...") <= room) return text + "...";
+  }
+  return {};
+}
+
 }  // namespace xbox360ps5::guide_quick
 
 #endif  // XBOX360PS5_GUIDE_QUICK_HPP_
