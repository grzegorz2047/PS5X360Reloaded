+// SPDX-License-Identifier: MIT
+// Fix 190 (tools/source-1.0.2/fixes/190-app-focus-input-gate.patch): the controller no longer
+// drives the app while the system's UI is on top of it.
+//
+// The app reads the DualSense itself (scePadReadState, after scePadSetProcessPrivilege(1) so the
+// Create button reaches it as Back), and nothing told it when the console's control center, quick
+// menu or home screen took the controller: the same presses that moved the system's menu also moved
+// the launcher and the game behind it. NativePad::Read now asks libSceSystemService for the app's
+// status (sceSystemServiceGetStatus) about once a frame and, while isSystemUiOverlaid or
+// isInBackgroundExecution is set, hands every consumer (the game's pads, the extra players, the
+// launcher's keys, the guide) a resting pad: no buttons, sticks centred, triggers released. The
+// pad stays connected, so no game sees a controller leave and no player is signed out.
+//
+//   * Parse: the status record is int32 eventNum, then the flags isSystemUiOverlaid (byte 4) and
+//     isInBackgroundExecution (byte 5), three more flags and reserved bytes (134 bytes). The call
+//     fills a zeroed buffer of kStatusBufferSize, larger than the record. A call that does not
+//     return 0, or a flag byte that is not 0 or 1 (a record not laid out as expected), is not a
+//     reading.
+//   * Gate::Update: a reading pauses the pad when either flag is set, and only once a reading has
+//     said the app is on top: a flag misread as always set never leaves the app without a pad.
+//     A failed reading lets the pad through; kMaxFailures failures in a row turn the gate off for
+//     good (Disable), as does a missing status call or the switch file (ParseSwitch).
+//   * Gate::Apply: the resting pad while paused. Back on top, the buttons still held at that moment
+//     (the press that closed the system's menu) stay masked until they are released, with their
+//     trigger's analog value, so the app sees no press it did not get. Sticks come back at once.
+//   * Gate::PollDue: one status reading every kPollIntervalMs, however many reads a frame makes.
+// Every doubt (no call, a failed call, an odd record, the switch) lets the pad through as before.
+// Header only and free of the rest of the title, so tools/check-focus-gate.cpp drives it.
+#pragma once
+#include <array>
+#include <cctype>
+#include <cstddef>
+#include <cstdint>
+#include <string_view>
+
+namespace xbox360ps5::focus_gate {
+
+constexpr size_t kStatusBufferSize = 256;
+constexpr size_t kOverlaidOffset = 4;
+constexpr size_t kBackgroundOffset = 5;
+constexpr uint64_t kPollIntervalMs = 16;
+constexpr int kMaxFailures = 8;
+// The trigger buttons as PadSample carries them (ScePad's layout).
+constexpr uint32_t kL2 = 0x100, kR2 = 0x200;
+
+struct Status {
+  bool valid = false;
+  bool overlaid = false;
+  bool background = false;
+};
+
+inline Status Parse(int result, const uint8_t* raw, size_t size) {
+  Status status;
+  if (result != 0 || !raw || size <= kBackgroundOffset) return status;
+  const uint8_t overlaid = raw[kOverlaidOffset], background = raw[kBackgroundOffset];
+  if (overlaid > 1 || background > 1) return status;
+  status.valid = true;
+  status.overlaid = overlaid != 0;
+  status.background = background != 0;
+  return status;
+}
+
+// The switch file's first line: "off" or "0" (any case, spaces and a line end around it) turns the
+// gate off; anything else, an empty line or no file leaves it on.
+inline bool ParseSwitch(std::string_view line) {
+  while (!line.empty() && std::isspace(static_cast<unsigned char>(line.front()))) line.remove_prefix(1);
+  while (!line.empty() && std::isspace(static_cast<unsigned char>(line.back()))) line.remove_suffix(1);
+  if (line == "0") return false;
+  if (line.size() != 3) return true;
+  for (size_t n = 0; n < 3; ++n)
+    if (std::tolower(static_cast<unsigned char>(line[n])) != "off"[n]) return true;
+  return false;
+}
+
+enum class Change { kNone, kPaused, kResumed, kDisabled };
+
+inline const char* ChangeName(Change change) {
+  switch (change) {
+    case Change::kPaused: return "paused";
+    case Change::kResumed: return "resumed";
+    case Change::kDisabled: return "off";
+    default: return "unchanged";
+  }
+}
+
+class Gate {
+ public:
+  static constexpr size_t kSlots = 4;
+
+  // Off for good; a pad paused at that moment comes back as on a return to the top.
+  Change Disable() {
+    if (disabled_) return Change::kNone;
+    disabled_ = true;
+    if (blocked_) {
+      blocked_ = false;
+      ++resumes_;
+    }
+    return Change::kDisabled;
+  }
+  bool Disabled() const { return disabled_; }
+  bool Blocked() const { return blocked_; }
+
+  bool PollDue(uint64_t now_ms) {
+    if (disabled_) return false;
+    if (polled_ && now_ms - last_poll_ms_ < kPollIntervalMs) return false;
+    polled_ = true;
+    last_poll_ms_ = now_ms;
+    return true;
+  }
+
+  Change Update(const Status& status) {
+    if (disabled_) return Change::kNone;
+    if (!status.valid) {
+      if (++failures_ >= kMaxFailures) return Disable();
+      return SetBlocked(false);
+    }
+    failures_ = 0;
+    const bool away = status.overlaid || status.background;
+    if (!away) seen_on_top_ = true;
+    return SetBlocked(away && seen_on_top_);
+  }
+
+  template <class Sample>
+  Sample Apply(size_t slot, const Sample& raw) {
+    if (slot >= kSlots) return raw;
+    if (blocked_) {
+      Sample resting = raw;
+      resting.buttons = 0;
+      resting.lx = resting.ly = resting.rx = resting.ry = 128;
+      resting.l2 = resting.r2 = 0;
+      return resting;
+    }
+    if (seen_resumes_[slot] != resumes_) {
+      seen_resumes_[slot] = resumes_;
+      held_[slot] = raw.buttons;
+    }
+    held_[slot] &= raw.buttons;
+    Sample out = raw;
+    out.buttons &= ~held_[slot];
+    if (held_[slot] & kL2) out.l2 = 0;
+    if (held_[slot] & kR2) out.r2 = 0;
+    return out;
+  }
+
+ private:
+  Change SetBlocked(bool blocked) {
+    if (blocked == blocked_) return Change::kNone;
+    blocked_ = blocked;
+    if (blocked) return Change::kPaused;
+    ++resumes_;
+    return Change::kResumed;
+  }
+
+  bool disabled_ = false;
+  bool blocked_ = false;
+  bool seen_on_top_ = false;
+  bool polled_ = false;
+  int failures_ = 0;
+  uint64_t last_poll_ms_ = 0;
+  uint32_t resumes_ = 0;
+  std::array<uint32_t, kSlots> seen_resumes_{};
+  std::array<uint32_t, kSlots> held_{};
+};
+
+}  // namespace xbox360ps5::focus_gate
