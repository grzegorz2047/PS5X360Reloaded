+  // Fix 190: the app's status about once a frame (under mutex_); the first reading and the first 64
+  // changes are logged with the record's first bytes, so the console's layout can be checked.
+  void PollFocus(std::chrono::steady_clock::time_point now) {
+    const uint64_t now_ms = uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+        now.time_since_epoch()).count());
+    if (!focus_gate_.PollDue(now_ms)) return;
+    alignas(16) std::array<uint8_t, xbox360ps5::focus_gate::kStatusBufferSize> record{};
+    const int result = sceSystemServiceGetStatus(record.data());
+    const auto status = xbox360ps5::focus_gate::Parse(result, record.data(), record.size());
+    const auto change = focus_gate_.Update(status);
+    if (focus_log_lines_ == 0 || (change != xbox360ps5::focus_gate::Change::kNone && focus_log_lines_ <= 64)) {
+      std::printf("FOCUS GATE (fix 190): %s result=%08x record=%02x%02x%02x%02x %02x %02x %02x %02x %02x"
+                  " valid=%d overlaid=%d background=%d\n",
+                  focus_log_lines_ == 0 ? "first reading" : xbox360ps5::focus_gate::ChangeName(change),
+                  unsigned(result), record[0], record[1], record[2], record[3], record[4], record[5],
+                  record[6], record[7], record[8], int(status.valid), int(status.overlaid),
+                  int(status.background));
+      ++focus_log_lines_;
+    }
+  }
+  xbox360ps5::focus_gate::Gate focus_gate_;
+  int focus_log_lines_ = 0;
 };
