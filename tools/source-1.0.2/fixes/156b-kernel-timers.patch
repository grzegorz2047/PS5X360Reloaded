+// Fix 156b: a guest timer's DPC (KeSetTimer(Ex) with a KDPC). The host timer thread fires it
+// and has no guest context; it is queued with the APCs and run here, on the relay, as a DPC
+// (impersonated, as EmulateCPInterruptDPC runs the GPU's).
+void KernelState::QueueDpcFromHost(uint32_t dpc_ptr, uint32_t arg1,
+                                   uint32_t arg2) {
+  {
+    std::lock_guard<std::mutex> lock(host_apc_mutex_);
+    if (!host_apc_running_) {
+      ++host_apcs_unrelayed_;
+      return;
+    }
+    HostApc dpc{0, 0, 0, arg1, arg2};
+    dpc.dpc = dpc_ptr;
+    host_apcs_.push_back(dpc);
+  }
+  host_apc_cond_.notify_one();
+}
+
+void KernelState::RunTimerDpc(uint32_t dpc_ptr, uint32_t arg1, uint32_t arg2) {
+  auto* thread = XThread::GetCurrentThread();
+  auto* dpc = memory()->TranslateVirtual<XDPC*>(dpc_ptr);
+  const uint32_t routine = dpc->routine;
+  if (!thread || !routine) return;
+  static std::atomic<uint32_t> shown{0};
+  if (shown.fetch_add(1) == 0) {
+    XELOGW(
+        "Kernel timer (fix 156b): DPC {:08X} routine {:08X} run by the kernel's "
+        "relay (first; later ones not logged)",
+        dpc_ptr, routine);
+  }
+  auto* context = thread->thread_state()->context();
+  DPCImpersonationScope dpc_scope{};
+  BeginDPCImpersonation(context, dpc_scope);
+  uint64_t args[] = {dpc_ptr, uint32_t(dpc->context), arg1, arg2};
+  processor_->Execute(thread->thread_state(), routine, args, xe::countof(args));
+  EndDPCImpersonation(context, dpc_scope);
+}
