new file mode 100644
--- /dev/null
+++ b/include/xbox360ps5/kernel_timer.hpp
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: MIT
+// Fix 156b (Kinect Sports Season Two and Zumba Fitness Core, issue 63): KeSetTimer,
+// KeSetTimerEx and KeCancelTimer on a KTIMER the title initialised itself (dispatch header
+// type 8, notification, or 9, synchronization). They were undefined externs: the call
+// returned without arming anything, KeWaitForMultipleObjects found no object for the type-9
+// header and failed at once, and Season Two's helper thread spun on it (about 550k calls a
+// second) while its tennis loading screen never finished.
+//
+// The kernel backs such a header with an XTimer (a host timer, waitable like an event). This
+// is the guest-visible state that goes with it, kept apart from the host timer so the host
+// check (tools/check-kernel-timer.cpp) drives the same code:
+//   Arm     KeSetTimer(Ex): clears the signal state, puts the timer in the queue, returns
+//           whether it was in the queue before (the BOOLEAN the kernel returns), and a new
+//           generation: a firing of an older arming is dropped;
+//   Fire    the host timer's due time: signalled; a one-shot timer leaves the queue, a
+//           periodic one stays in it;
+//   Cancel  KeCancelTimer: out of the queue, the signal state as it was, returns whether it
+//           was in the queue;
+//   Consumed a satisfied wait: a synchronization timer is reset, a notification one is not.
+// No Xenia headers here.
+#pragma once
+#include <atomic>
+#include <cstdint>
+
+namespace xbox360ps5::kernel_timer {
+
+struct State {
+  std::atomic<uint32_t> generation{0};
+  std::atomic<bool> inserted{false};
+  std::atomic<bool> periodic{false};
+  std::atomic<bool> signaled{false};
+  std::atomic<uint64_t> fired{0}, dropped{0};
+};
+
+struct Armed {
+  bool was_inserted;
+  uint32_t generation;
+};
+
+inline Armed Arm(State& state, uint32_t period_ms) {
+  const uint32_t generation = state.generation.fetch_add(1) + 1;
+  state.signaled = false;
+  state.periodic = period_ms != 0;
+  const bool was_inserted = state.inserted.exchange(true);
+  return {was_inserted, generation};
+}
+
+// True when this firing belongs to the current arming (the guest header is then written).
+inline bool Fire(State& state, uint32_t generation) {
+  if (state.generation.load() != generation || !state.inserted.load()) {
+    ++state.dropped;
+    return false;
+  }
+  state.signaled = true;
+  if (!state.periodic.load()) state.inserted = false;
+  ++state.fired;
+  return true;
+}
+
+inline bool Cancel(State& state) {
+  state.generation.fetch_add(1);
+  return state.inserted.exchange(false);
+}
+
+inline void Consumed(State& state, bool synchronization) {
+  if (synchronization) state.signaled = false;
+}
+
+// The type a KTIMER's dispatch header carries: 8 notification, 9 synchronization.
+constexpr uint8_t kNotificationType = 8, kSynchronizationType = 9;
+inline bool IsTimerType(uint32_t type) {
+  return type == kNotificationType || type == kSynchronizationType;
+}
+
+}  // namespace xbox360ps5::kernel_timer
