+// Fix 156b: the title's own KTIMER (KeInitializeTimerEx is often inlined, so the header is
+// met first by KeSetTimer(Ex), KeCancelTimer or a wait; XObject::GetNativeObject creates this).
+void XTimer::InitializeNative(void* native_ptr, const X_DISPATCH_HEADER* header) {
+  assert_false(timer_);
+  synchronization_ =
+      header->type == X_OBJECT_TYPES::TimerSynchronizationObject;
+  timer_ = synchronization_ ? xe::threading::Timer::CreateSynchronizationTimer()
+                            : xe::threading::Timer::CreateManualResetTimer();
+  assert_not_null(timer_);
+  native_state_ = std::make_shared<xbox360ps5::kernel_timer::State>();
+  native_state_->inserted = header->inserted != 0;
+  native_state_->signaled = header->signal_state != 0;
