+
+bool XTimer::SetNative(int64_t due_time, uint32_t period_ms, uint32_t dpc_ptr) {
+  namespace kt = xbox360ps5::kernel_timer;
+  if (!native_state_ || !guest_object()) return false;
+  std::lock_guard<std::mutex> lock(timer_lock_);
+  const kt::Armed armed = kt::Arm(*native_state_, period_ms);
+  auto* ktimer = memory()->TranslateVirtual<X_KTIMER*>(guest_object());
+  ktimer->header.signal_state = 0;
+  ktimer->header.inserted = 1;
+  ktimer->due_time = uint64_t(due_time);
+  ktimer->period = period_ms;
+  ktimer->dpc = dpc_ptr;
+
+  auto* kernel = kernel_state();
+  if (dpc_ptr) {
+    // The relay runs the DPC; started here, on the guest thread, before the timer is armed.
+    kernel->EnsureApcRelay();
+  }
+  // Runs on the host timer thread, which has no guest context: it writes the guest's header
+  // and hands the DPC to the relay, and takes no lock a guest thread may hold while it
+  // re-arms or cancels this timer (that waits for a callback in progress).
+  auto state = native_state_;
+  Memory* memory_ptr = memory();
+  const uint32_t guest_ptr = guest_object();
+  const uint32_t generation = armed.generation;
+  std::function<void()> callback = [state, memory_ptr, kernel, guest_ptr, generation,
+                                    dpc_ptr]() {
+    if (!xbox360ps5::kernel_timer::Fire(*state, generation)) return;
+    auto* fired = memory_ptr->TranslateVirtual<X_KTIMER*>(guest_ptr);
+    fired->header.signal_state = 1;
+    if (!state->periodic.load()) fired->header.inserted = 0;
+    if (dpc_ptr) {
+      const uint64_t time = xe::Clock::QueryGuestSystemTime();
+      kernel->QueueDpcFromHost(dpc_ptr, uint32_t(time), uint32_t(time >> 32));
+    }
+  };
+  const auto due_tp = GuestDueTime(due_time);
+  if (!period_ms) {
+    timer_->SetOnceAt(due_tp, std::move(callback));
+  } else {
+    timer_->SetRepeatingAt(
+        due_tp,
+        std::chrono::milliseconds(Clock::ScaleGuestDurationMillis(period_ms)),
+        std::move(callback));
+  }
+  return armed.was_inserted;
+}
+
+bool XTimer::CancelNative() {
+  if (!native_state_ || !guest_object()) return false;
+  std::lock_guard<std::mutex> lock(timer_lock_);
+  const bool was_inserted = xbox360ps5::kernel_timer::Cancel(*native_state_);
+  timer_->Cancel();
+  memory()->TranslateVirtual<X_KTIMER*>(guest_object())->header.inserted = 0;
+  return was_inserted;
+}
+
+void XTimer::WaitCallback() {
+  // A satisfied wait resets a synchronization timer (the host timer resets itself).
+  if (!native_state_ || !synchronization_ || !guest_object()) return;
+  xbox360ps5::kernel_timer::Consumed(*native_state_, true);
+  memory()->TranslateVirtual<X_KTIMER*>(guest_object())->header.signal_state = 0;
+}
+
 }  // namespace kernel
 }  // namespace xe
