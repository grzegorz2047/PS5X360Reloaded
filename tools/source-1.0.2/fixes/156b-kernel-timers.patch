+// Xbox360PS5 fix 156b (Kinect Sports Season Two and Zumba Fitness Core, issue 63): KeSetTimer,
+// KeSetTimerEx and KeCancelTimer were undefined externs. Both games set a timer on their own
+// KTIMER (the Kinect speech and identity library, after XamXlfsInitializeUploadQueue); the call
+// armed nothing, the type-9 header had no object, and Season Two's helper thread spun on
+// KeWaitForMultipleObjects (about 550k calls a second) while tennis never finished loading.
+// The header gets an XTimer (XObject::GetNativeObject), waitable like an event; the guest's
+// KTIMER is kept as the kernel keeps it (xbox360ps5/kernel_timer.hpp). Each returns whether
+// the timer was set before. The first 8 calls are logged.
+namespace {
+object_ref<XTimer> NativeTimer(X_KTIMER* timer, const char* call) {
+  if (!timer || !xbox360ps5::kernel_timer::IsTimerType(uint32_t(timer->header.type))) {
+    static std::atomic<uint32_t> said{0};
+    if (said.fetch_add(1) < 8) {
+      XELOGW("Kernel timer (fix 156b): {} on {:08X}, header type {:02X}: not a timer", call,
+             timer ? kernel_memory()->HostToGuestVirtual(timer) : 0,
+             timer ? uint32_t(timer->header.type) : 0);
+    }
+    return nullptr;
+  }
+  auto object = XObject::GetNativeObject<XObject>(kernel_state(), timer);
+  if (!object || object->type() != XObject::Type::Timer ||
+      !static_cast<XTimer*>(object.get())->is_native()) {
+    return nullptr;
+  }
+  return object_ref<XTimer>(static_cast<XTimer*>(object.release()));
+}
+void NoteTimerCall(const char* call, uint32_t timer, uint64_t due_time, uint32_t period,
+                   uint32_t dpc, bool was_set) {
+  static std::atomic<uint32_t> shown{0};
+  if (shown.fetch_add(1) < 8) {
+    XELOGW("Kernel timer (fix 156b): {}({:08X}, due {:016X}, period {} ms, DPC {:08X}) -> "
+           "{} set before", call, timer, due_time, period, dpc, was_set ? "was" : "was not");
+  }
+}
+uint32_t SetNativeTimer(X_KTIMER* timer, uint64_t due_time, uint32_t period, uint32_t dpc,
+                        const char* call) {
+  auto object = NativeTimer(timer, call);
+  if (!object) return 0;
+  const bool was_set = object->SetNative(int64_t(due_time), period, dpc);
+  NoteTimerCall(call, object->guest_object(), due_time, period, dpc, was_set);
+  return was_set ? 1 : 0;
+}
+}  // namespace
+
+dword_result_t KeSetTimerEx_entry(pointer_t<X_KTIMER> timer, qword_t due_time,
+                                  dword_t period, lpvoid_t dpc) {
+  return SetNativeTimer(timer, uint64_t(due_time), uint32_t(period), dpc.guest_address(),
+                        "KeSetTimerEx");
+}
+DECLARE_XBOXKRNL_EXPORT1(KeSetTimerEx, kThreading, kImplemented);
+
+dword_result_t KeSetTimer_entry(pointer_t<X_KTIMER> timer, qword_t due_time,
+                                lpvoid_t dpc) {
+  return SetNativeTimer(timer, uint64_t(due_time), 0, dpc.guest_address(), "KeSetTimer");
+}
+DECLARE_XBOXKRNL_EXPORT1(KeSetTimer, kThreading, kImplemented);
+
+dword_result_t KeCancelTimer_entry(pointer_t<X_KTIMER> timer) {
+  auto object = NativeTimer(timer, "KeCancelTimer");
+  if (!object) return 0;
+  const bool was_set = object->CancelNative();
+  NoteTimerCall("KeCancelTimer", object->guest_object(), 0, 0, 0, was_set);
+  return was_set ? 1 : 0;
+}
+DECLARE_XBOXKRNL_EXPORT1(KeCancelTimer, kThreading, kImplemented);
+
