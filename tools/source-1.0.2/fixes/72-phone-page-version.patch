 // Opened from the TV's QR code the key is in the address and the page connects by itself; it then
 // waits for the Kinect game, pairs when the game turns the camera on, opens the camera (or asks
 // for one tap when the browser wants it) and reconnects by itself when the console restarts.
+// fix 72 begin: the app on the console was updated while this page stayed open (it reconnects by
+// itself): the console names its page's version in every status answer, and a page of another
+// version reloads once, keeping a typed key, to run the console's current page.
+const PAGE_VERSION = '__PAGE_VERSION__';
+function reloadIfUpdated(served, typed, storage, reload) {
+  if (!served || served === PAGE_VERSION || PAGE_VERSION.startsWith('__')) return false;
+  let done = '';
+  try { done = storage.getItem('ps5x360-reloaded-for') || ''; } catch {}
+  if (done === served) return false;  // once per version: no reload loop
+  try { storage.setItem('ps5x360-reloaded-for', served); if (typed) storage.setItem('ps5x360-key', typed); } catch {}
+  reload();
+  return true;
+}
+// fix 72 end
+try {
+  const kept = sessionStorage.getItem('ps5x360-key');
+  if (kept && !$('key').value.trim()) $('key').value = kept;
+  sessionStorage.removeItem('ps5x360-key');
+} catch {}
