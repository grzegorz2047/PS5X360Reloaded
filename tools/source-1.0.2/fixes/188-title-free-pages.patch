+  const uint32_t available_pages = xbox360ps5::title_memory::AvailablePages(
+      stats_ptr->total_physical_pages, stats_ptr->kernel_pages, used_pages,
+      physical_free);
+  stats_ptr->title.available_pages = available_pages;
+  const auto report =
+      xbox360ps5::title_memory::Note(wrapping_pages, available_pages);
+  if (report.first) {
+    XELOGW(
+        "Memory (fix 188): the game asked how much memory is free "
+        "(MmQueryStatistics): {} MiB available, {} MiB used by the physical "
+        "heaps, {} MiB free in the physical heap",
+        available_pages / 256, used_pages / 256, physical_free / 256);
+  }
+  if (report.corrected) {
+    XELOGW(
+        "Memory (fix 188): free memory answered as {} pages ({} KiB), {} "
+        "pages free in the physical heap; 1.0.6 would have answered {} pages",
+        available_pages, available_pages * 4, physical_free, wrapping_pages);
+  }
   stats_ptr->title.total_virtual_memory_bytes = 0x2FFE0000;
   stats_ptr->title.reserved_virtual_memory_bytes = reserved_pages_bytes;
   stats_ptr->title.physical_pages = 0x00001000;  // TODO(gibbed): FIXME
