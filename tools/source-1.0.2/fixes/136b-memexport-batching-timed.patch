+// Fix 136b: the batch's buffer mapped once (136 mapped all 32 MiB at every merge); on memory that
+// is not coherent, only the bytes used are invalidated.
+void* VulkanCommandProcessor::MapMemexportBatch(uint32_t used) {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  if (!memexport_batch_mapped_ &&
+      (dfn.vkMapMemory(device, memexport_batch_memory_, 0, VK_WHOLE_SIZE, 0,
+                       &memexport_batch_mapped_) != VK_SUCCESS ||
+       !memexport_batch_mapped_)) {
+    memexport_batch_mapped_ = nullptr;
+    return nullptr;
+  }
+  if (!memexport_batch_host_coherent_ && used) {
+    const VkDeviceSize atom =
+        std::max<VkDeviceSize>(vulkan_device->properties().nonCoherentAtomSize, 1);
+    VkMappedMemoryRange range = {VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE};
+    range.memory = memexport_batch_memory_;
+    range.offset = 0;
+    range.size = (VkDeviceSize(used) + atom - 1) / atom * atom;
+    if (range.size >= memexport_batch::kMaxBytes) {
+      range.size = VK_WHOLE_SIZE;
+    }
+    if (dfn.vkInvalidateMappedMemoryRanges(device, 1, &range) != VK_SUCCESS) {
+      XELOGE("Memexport batching (fix 136b): failed to invalidate the readback buffer");
+      return nullptr;
+    }
+  }
+  return memexport_batch_mapped_;
+}
+
+// Fix 136b: the check before a draw or a resolve, timed.
+void VulkanCommandProcessor::FlushMemexportBatchIfInvalid() {
+  if (memexport_batch_.empty()) {
+    return;
+  }
+  const auto check_start = std::chrono::steady_clock::now();
+  const bool invalid = memexport_batch_.AnyInvalid([this](uint32_t start, uint32_t size) {
+    return shared_memory_->IsRangeValid(start, size);
+  });
+  memexport_batch_check_ns_ += uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                            std::chrono::steady_clock::now() - check_start)
+                                            .count());
+  if (invalid) {
+    FlushMemexportBatch(memexport_batch::kInvalidated);
+  }
+}
