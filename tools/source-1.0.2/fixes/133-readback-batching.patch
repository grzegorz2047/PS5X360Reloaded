+// Fix 133: where the command processor stands as far as the CPU can tell (readback_batching.h).
+readback_batching::SyncPoint VulkanCommandProcessor::ReadbackSyncPoint() const {
+  namespace ct = xbox360ps5::cp_trace;
+  readback_batching::SyncPoint point;
+  for (const ct::Kind kind : {ct::Kind::kMemWrite, ct::Kind::kEventShd, ct::Kind::kCondWrite,
+                              ct::Kind::kRegToMem, ct::Kind::kScratch}) {
+    point.cp_writes += ct::Global().Total(kind);
+  }
+  point.ring_part = xbox360ps5::frame_cost::command_chunk_epoch;
+  point.swaps = swap_count();
+  return point;
+}
