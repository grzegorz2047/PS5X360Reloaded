+// SPDX-License-Identifier: MIT
+// Xbox360PS5, fix 133: fewer GPU waits for readbacks.
+//
+// (a) A resolve target whose start moves while its end stays put. Modern Warfare 2 on
+// 1.0.5-work-fix130 resolves one ~4 MiB target every frame at starts from 1E91E000 to 1E93E000,
+// all ending at 1ED1E000. Each start was its own key, none steady, so fix 91k gave almost every
+// resolve its own copy and waited for the GPU: 910-1068 own copies per 30 s, 42-138 ms/s of
+// waiting, while the CPU read none of them (fix 91g's read watch: "keys the CPU reads 0").
+// Such keys form a family by their end address; a family resolved in kSteadyPresence of recent
+// frames is steady, and its keys get the fast mode's late copy like any steady key, unless the
+// CPU has been seen reading that key. The cvar readback_steady_by_end (on; off per game in its
+// assets/config/<title>.config.toml) restores fix 91k's rule.
+//
+// (b) Memory exports read back at every exporting draw (Modern Warfare 2's memexport=1:
+// 191-232 a second; Kinect Sports' boxing about 870). Each one submits and waits for the GPU.
+// Waiting once for all the exports between two points where the CPU can learn that the GPU went
+// on would be enough: the command processor's writes to guest memory (MEM_WRITE,
+// EVENT_WRITE_SHD, COND_WRITE, REG_TO_MEM, the scratch write-back), the end of a part of the
+// ring, a swap. Counted here only (WouldBatch): how many such periods the waits fall in.
+#ifndef XENIA_GPU_VULKAN_READBACK_BATCHING_H_
+#define XENIA_GPU_VULKAN_READBACK_BATCHING_H_
+
+#include <cstdint>
+
+namespace xe {
+namespace gpu {
+namespace readback_batching {
+
+// A resolve key's family: its end address.
+inline uint64_t FamilyKey(uint32_t address, uint32_t length) { return uint64_t(address) + length; }
+
+struct Family {
+  uint64_t last_used_frame = 0;
+  float presence = 0;
+};
+
+// Fix 91k gives a key that is not steady its own copy. With (a): not when its family is steady
+// and the CPU has not been seen reading the key.
+inline bool OwnCopy(bool key_steady, bool family_steady, bool cpu_reads, bool steady_by_end) {
+  if (key_steady) return false;
+  if (steady_by_end && family_steady && !cpu_reads) return false;
+  return true;
+}
+
+// Where the command processor stands as far as the CPU can tell.
+struct SyncPoint {
+  uint64_t cp_writes = 0;  // the command processor's writes to guest memory so far
+  uint32_t ring_part = 0;  // fix 87's epoch
+  uint64_t swaps = 0;
+  bool operator==(const SyncPoint& other) const {
+    return cp_writes == other.cp_writes && ring_part == other.ring_part && swaps == other.swaps;
+  }
+};
+
+// Waits, and the periods between sync points they fall in: one wait per period would do.
+class WouldBatch {
+ public:
+  void Note(const SyncPoint& at) {
+    ++waits_;
+    if (!started_ || !(at == last_)) {
+      ++periods_;
+      last_ = at;
+      started_ = true;
+    }
+  }
+  uint64_t waits() const { return waits_; }
+  uint64_t periods() const { return periods_; }
+  void Reset() {
+    waits_ = periods_ = 0;
+  }
+
+ private:
+  SyncPoint last_;
+  bool started_ = false;
+  uint64_t waits_ = 0, periods_ = 0;
+};
+
+}  // namespace readback_batching
+}  // namespace gpu
+}  // namespace xe
+
+#endif  // XENIA_GPU_VULKAN_READBACK_BATCHING_H_
