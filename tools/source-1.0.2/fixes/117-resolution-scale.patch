diff --git a/include/xbox360ps5/resolution_scale.hpp b/include/xbox360ps5/resolution_scale.hpp
new file mode 100644
--- /dev/null
+++ b/include/xbox360ps5/resolution_scale.hpp
@@ -0,0 +1,168 @@
+// SPDX-License-Identifier: MIT
+// Fix 117 (tools/source-1.0.2/fixes/117-resolution-scale.patch): a game may render at twice its
+// resolution (the core's draw_resolution_scale), as a test. The option ("Resolution scale (test)",
+// key draw_scale, a start option a game may have of its own) offers 1x and 2x only: 3x needs four
+// 2 GiB sparse buffers of scaled resolve memory, more than the 4 GiB window the PS5 Vulkan driver
+// maps its memory into. The core goes back to 1x when the device has no sparse binding.
+// What it prints, to decide on the console whether it works:
+//   at start  "Resolution scale (fix 117): asked AxB, ..." (the device's sparse properties and
+//             limits, the scale in use) and "Resolution scale (fix 117): scaled resolve ..."
+//             (the sparse buffers made, or why not);
+//   10 s line "Resolution scale (fix 117): scaled resolve N heaps (M MiB) committed, ...".
+// Scaled resolve memory is committed in 16 MiB heaps that live until the game ends; no new heap
+// is made while the system's free direct memory would fall below 1 GiB (the guest's own memory
+// comes from there too: running it out closes the game). A refused heap leaves that resolve
+// unscaled or missing: a picture fault, not a crash.
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+#if defined(__PROSPERO__)
+extern "C" {
+int64_t sceKernelGetDirectMemorySize();
+int32_t sceKernelAvailableDirectMemorySize(int64_t, int64_t, size_t, int64_t*, size_t*);
+}
+#endif
+
+namespace xbox360ps5 {
+namespace resolution_scale {
+
+// The system's free direct memory, as fix 47's hang watch reads it; -1 when not known.
+inline int64_t DirectFree() {
+#if defined(__PROSPERO__)
+  size_t free_bytes = 0;
+  int64_t at = 0;
+  if (sceKernelAvailableDirectMemorySize(0, sceKernelGetDirectMemorySize(), 0x10000, &at, &free_bytes) == 0)
+    return int64_t(free_bytes);
+#endif
+  return -1;
+}
+
+// The option's choices: 0 is 1x, 1 is 2x.
+inline constexpr int kChoices = 2;
+inline uint32_t ScaleForChoice(int choice) { return choice == 1 ? 2u : 1u; }
+
+// The floor of free direct memory a new heap must leave.
+inline constexpr uint64_t kDirectFloor = uint64_t(1) << 30;
+// direct_free < 0: not known (the query failed, or not on the console): allowed.
+inline bool MayCommit(int64_t direct_free, uint64_t bytes) {
+  return direct_free < 0 || uint64_t(direct_free) >= kDirectFloor + bytes;
+}
+
+struct Counters {
+  std::atomic<uint64_t> heaps{0};          // made
+  std::atomic<uint64_t> heap_bytes{0};     // their size
+  std::atomic<uint64_t> refused{0};        // not made: the floor
+  std::atomic<uint64_t> failed{0};         // not made: vkAllocateMemory failed
+  std::atomic<int64_t> lowest_free{-1};    // the least free direct memory seen at a commit
+  std::atomic<uint32_t> scale{1};          // in use (1: no line every 10 s)
+  std::atomic<bool> sparse{false};         // the sparse scaled resolve buffers exist
+};
+inline Counters counters;
+
+inline void NoteFree(Counters& c, int64_t direct_free) {
+  if (direct_free < 0) return;
+  int64_t seen = c.lowest_free.load(std::memory_order_relaxed);
+  while ((seen < 0 || direct_free < seen) &&
+         !c.lowest_free.compare_exchange_weak(seen, direct_free, std::memory_order_relaxed)) {
+  }
+}
+// Decides one heap of `bytes` at the given free direct memory, and counts the outcome of the
+// allocation the caller then makes (allocated: whether vkAllocateMemory succeeded).
+inline bool Admit(Counters& c, int64_t direct_free, uint64_t bytes) {
+  NoteFree(c, direct_free);
+  if (MayCommit(direct_free, bytes)) return true;
+  c.refused.fetch_add(1, std::memory_order_relaxed);
+  return false;
+}
+inline void Allocated(Counters& c, bool allocated, uint64_t bytes) {
+  if (allocated) {
+    c.heaps.fetch_add(1, std::memory_order_relaxed);
+    c.heap_bytes.fetch_add(bytes, std::memory_order_relaxed);
+  } else {
+    c.failed.fetch_add(1, std::memory_order_relaxed);
+  }
+}
+
+inline long long MiB(int64_t bytes) { return bytes < 0 ? -1 : (long long)(bytes >> 20); }
+
+// At start, after the core clamped the scale to what the device supports.
+struct Device {
+  uint32_t asked_x = 1, asked_y = 1, used_x = 1, used_y = 1;
+  bool sparse_binding = false, sparse_residency_buffer = false, interlock = false;
+  uint64_t max_storage_buffer_range = 0;
+  uint32_t max_image_2d = 0, max_framebuffer_width = 0, max_framebuffer_height = 0;
+};
+inline std::string DeviceLine(const Device& d, int64_t direct_free) {
+  char line[400];
+  std::snprintf(line, sizeof(line),
+                "Resolution scale (fix 117): asked %ux%u, in use %ux%u; device sparseBinding %s, "
+                "sparseResidencyBuffer %s, fragmentShaderPixelInterlock %s, maxStorageBufferRange %llu MiB, "
+                "maxImageDimension2D %u, maxFramebuffer %ux%u; direct free %lld MiB%s",
+                d.asked_x, d.asked_y, d.used_x, d.used_y, d.sparse_binding ? "yes" : "no",
+                d.sparse_residency_buffer ? "yes" : "no", d.interlock ? "yes" : "no",
+                (unsigned long long)(d.max_storage_buffer_range >> 20), d.max_image_2d,
+                d.max_framebuffer_width, d.max_framebuffer_height, MiB(direct_free),
+                (d.asked_x > 1 || d.asked_y > 1) && d.used_x == 1 && d.used_y == 1
+                    ? " (the device cannot: 1x)"
+                    : "");
+  return line;
+}
+
+// The scaled resolve buffers at start (texture cache).
+enum class Sparse { kMade, kNoSupport, kBufferFailed, kNoMemoryType, kOffByCvar };
+inline std::string SparseLine(Sparse outcome, size_t buffers, uint32_t max_heaps, int result,
+                              int64_t direct_free) {
+  char line[300];
+  switch (outcome) {
+    case Sparse::kMade:
+      std::snprintf(line, sizeof(line),
+                    "Resolution scale (fix 117): scaled resolve: %zu sparse buffer(s) of 2 GiB made, up to %u "
+                    "heaps of 16 MiB; direct free %lld MiB, heaps stop below %lld MiB free",
+                    buffers, max_heaps, MiB(direct_free), MiB(int64_t(kDirectFloor)));
+      break;
+    case Sparse::kBufferFailed:
+      std::snprintf(line, sizeof(line),
+                    "Resolution scale (fix 117): scaled resolve: sparse buffer %zu of 2 GiB not made (VkResult %d); "
+                    "scaled resolves cannot be kept",
+                    buffers, result);
+      break;
+    case Sparse::kNoMemoryType:
+      std::snprintf(line, sizeof(line),
+                    "Resolution scale (fix 117): scaled resolve: no device-local memory type for the sparse buffers; "
+                    "scaled resolves cannot be kept");
+      break;
+    case Sparse::kOffByCvar:
+      std::snprintf(line, sizeof(line),
+                    "Resolution scale (fix 117): scaled resolve: sparse buffers off (tiled_shared_memory false)");
+      break;
+    default:
+      std::snprintf(line, sizeof(line),
+                    "Resolution scale (fix 117): scaled resolve: no sparse binding on the device");
+      break;
+  }
+  return line;
+}
+
+// Every 10 s while the scale is above 1x; empty otherwise.
+inline std::string Line(const Counters& c, int64_t direct_free) {
+  if (c.scale.load(std::memory_order_relaxed) <= 1) return {};
+  char line[300];
+  std::snprintf(line, sizeof(line),
+                "Resolution scale (fix 117): %ux, scaled resolve %s, %llu heaps (%lld MiB) committed, %llu refused "
+                "(under %lld MiB free), %llu failed; direct free %lld MiB (lowest at a commit %lld MiB)",
+                c.scale.load(std::memory_order_relaxed), c.sparse.load(std::memory_order_relaxed) ? "sparse" : "none",
+                (unsigned long long)c.heaps.load(std::memory_order_relaxed),
+                MiB(int64_t(c.heap_bytes.load(std::memory_order_relaxed))),
+                (unsigned long long)c.refused.load(std::memory_order_relaxed), MiB(int64_t(kDirectFloor)),
+                (unsigned long long)c.failed.load(std::memory_order_relaxed), MiB(direct_free),
+                MiB(c.lowest_free.load(std::memory_order_relaxed)));
+  return line;
+}
+
+}  // namespace resolution_scale
+}  // namespace xbox360ps5
