diff --git a/.deps/xenia-canary/src/xenia/gpu/memexport_deliver.h b/.deps/xenia-canary/src/xenia/gpu/memexport_deliver.h
new file mode 100644
index 0000000..f8a0999
--- /dev/null
+++ b/.deps/xenia-canary/src/xenia/gpu/memexport_deliver.h
@@ -0,0 +1,193 @@
+// Xbox360PS5, fix 177 (docs/design/memexport-readback.md, D1): a draw whose memory exports are
+// read back (fix 30: the option or a small export; fix 48: learned) queues its before and after
+// copies instead of waiting for the GPU at once, and the GPU thread waits once for all of them at
+// the next point where the CPU could learn that the GPU went on (fix 133's sync points,
+// WAIT_REG_MEM, an interrupt, the ring's read pointer, a swap), or before guest memory is uploaded
+// over a queued range. The delayed merge keeps what the CPU wrote since the draw: a dword is stored
+// only while guest memory still holds the GPU's value from before the draw (a compare and swap).
+// Off by default: memexport-deliver.txt in the title folder ("on", "verify", "off"), read at most
+// once a second. "verify" keeps today's immediate wait and merge and counts, at the next sync
+// point, the dwords the CPU changed after the merge: the ones the queued merge would have kept.
+
+#ifndef XENIA_GPU_MEMEXPORT_DELIVER_H_
+#define XENIA_GPU_MEMEXPORT_DELIVER_H_
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace xbox360ps5 {
+namespace memexport_deliver {
+
+enum class Mode { kOff, kOn, kVerify };
+inline const char* ModeName(Mode mode) {
+  return mode == Mode::kOn ? "on" : mode == Mode::kVerify ? "verify" : "off";
+}
+// The first word of the file ("on"/"1", "verify", "off"/"0"; "#" starts a comment); anything else
+// keeps `otherwise`.
+inline Mode ParseMode(const std::string& text, Mode otherwise) {
+  const size_t start = text.find_first_not_of(" \t\r\n");
+  if (start == std::string::npos) return otherwise;
+  const std::string word = text.substr(start, text.find_first_of(" \t\r\n#", start) - start);
+  if (word == "on" || word == "1") return Mode::kOn;
+  if (word == "verify") return Mode::kVerify;
+  if (word == "off" || word == "0") return Mode::kOff;
+  return otherwise;
+}
+
+// Why the queue was emptied with a wait.
+enum Point : uint32_t {
+  kSyncPacket = 0,  // MEM_WRITE, EVENT_WRITE_SHD/EXT, COND_WRITE, REG_TO_MEM, a scratch write-back
+  kWaitRegMem,      // the GPU about to wait for the guest
+  kInterrupt,       // an interrupt to the CPU
+  kRingPart,        // the ring's read pointer written back
+  kSwap,
+  kIdle,            // the GPU thread out of commands, waiting for the guest
+  kUpload,          // guest memory about to be uploaded over a queued range
+  kRefresh,         // fix 30's refresh of a queued range before another draw exports into it
+  kFull,            // the queue's byte limit
+  kSwitch,          // the switch left "on"
+  kPoints
+};
+inline const char* PointName(uint32_t point) {
+  static const char* const names[] = {"sync packets",  "WAIT_REG_MEM", "interrupts",
+                                      "ring parts",    "swaps",        "idle",
+                                      "uploads over a queued range", "refreshes",
+                                      "a full queue",  "the switch"};
+  return point < kPoints ? names[point] : "?";
+}
+
+// A dword of guest memory, raw (big-endian as stored).
+inline uint32_t LoadRaw(const uint8_t* at) {
+  uint32_t value;
+  std::memcpy(&value, at, 4);
+  return value;
+}
+
+struct Merged {
+  uint64_t written = 0;  // dwords the shader wrote, stored
+  uint64_t kept = 0;     // dwords the shader wrote, not stored: the CPU changed them since the draw
+};
+// The delayed merge: each dword where `after` (the GPU's copy once the draw was done) differs from
+// `before` (just before it) is stored only while guest memory still holds `before`, by an atomic
+// compare and swap, so a CPU write made since the draw (on any thread, also during the merge) wins,
+// as on the console, where the export lands when the GPU runs the draw. A tail shorter than a dword
+// goes byte by byte. `guest` must be 4-byte aligned (export ranges are dword ranges).
+inline Merged MergeKeepingCpu(uint8_t* guest, const uint8_t* before, const uint8_t* after,
+                              size_t size) {
+  Merged merged;
+  size_t at = 0;
+  for (; at + 4 <= size; at += 4) {
+    const uint32_t was = LoadRaw(before + at), now = LoadRaw(after + at);
+    if (was == now) continue;
+    uint32_t expected = was;
+    if (__atomic_compare_exchange_n(reinterpret_cast<uint32_t*>(guest + at), &expected, now,
+                                    false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST)) {
+      ++merged.written;
+    } else {
+      ++merged.kept;
+    }
+  }
+  for (; at < size; ++at) {
+    if (before[at] == after[at]) continue;
+    uint8_t expected = before[at];
+    if (__atomic_compare_exchange_n(guest + at, &expected, after[at], false, __ATOMIC_SEQ_CST,
+                                    __ATOMIC_SEQ_CST)) {
+      ++merged.written;
+    } else {
+      ++merged.kept;
+    }
+  }
+  return merged;
+}
+
+struct Range {
+  uint32_t start = 0, length = 0;
+};
+inline bool Overlaps(uint32_t a, uint32_t a_length, uint32_t b, uint32_t b_length) {
+  return uint64_t(a) < uint64_t(b) + b_length && uint64_t(b) < uint64_t(a) + a_length;
+}
+inline bool AnyOverlap(const std::vector<Range>& ranges, uint32_t start, uint32_t length) {
+  for (const Range& range : ranges)
+    if (Overlaps(range.start, range.length, start, length)) return true;
+  return false;
+}
+
+// Readback buffers come in powers of two from 64 KiB, kept for reuse after their merge.
+inline uint32_t SizeClass(uint32_t bytes) {
+  uint32_t size = 64 * 1024;
+  while (size < bytes && size < (1u << 31)) size <<= 1;
+  return size;
+}
+// The queue's limit: past it, the queue is emptied (with a wait) before another is queued.
+constexpr uint64_t kQueueLimitBytes = 64ull << 20;
+
+// "verify": the dwords the immediate merge stored (address, raw value), checked at the next sync
+// point against guest memory (read by `load(address)`): those changed since are the ones the
+// delayed merge would have kept.
+struct Stored {
+  uint32_t address = 0, raw = 0;
+};
+constexpr size_t kVerifyLimit = 65536;
+inline void RecordStores(uint32_t start, const uint8_t* before, const uint8_t* after, size_t size,
+                         std::vector<Stored>& out) {
+  for (size_t at = 0; at + 4 <= size && out.size() < kVerifyLimit; at += 4) {
+    const uint32_t was = LoadRaw(before + at), now = LoadRaw(after + at);
+    if (was != now) out.push_back({uint32_t(start + at), now});
+  }
+}
+template <typename Load>
+uint64_t CountChanged(const std::vector<Stored>& stored, Load load) {
+  uint64_t changed = 0;
+  for (const Stored& s : stored) changed += load(s.address) != s.raw;
+  return changed;
+}
+
+// The 30 s counts (GPU thread only).
+struct Stats {
+  uint64_t queued = 0, queued_bytes = 0, delivered = 0, waits = 0, polled = 0;
+  std::array<uint64_t, kPoints> waits_by{};
+  uint64_t written = 0, kept = 0, failed = 0;
+  uint64_t deepest = 0, deepest_bytes = 0;
+  uint64_t verify_checked = 0, verify_changed = 0;
+  void NoteDepth(uint64_t entries, uint64_t bytes) {
+    deepest = std::max(deepest, entries);
+    deepest_bytes = std::max(deepest_bytes, bytes);
+  }
+};
+inline std::string Line(Mode mode, const Stats& s, double wait_ms_s) {
+  std::string by;
+  for (uint32_t p = 0; p < kPoints; ++p) {
+    if (!s.waits_by[p]) continue;
+    char item[64];
+    std::snprintf(item, sizeof(item), "%s%s %llu", by.empty() ? "" : ", ", PointName(p),
+                  static_cast<unsigned long long>(s.waits_by[p]));
+    by += item;
+  }
+  char text[1024];
+  std::snprintf(
+      text, sizeof(text),
+      "Memexport delivery, last 30 s (fix 177, %s): %llu readbacks queued (%.1f MiB), %llu put "
+      "in guest memory, %llu without a wait; %llu waits (%.1f ms/s): %s; dwords stored %llu, kept "
+      "%llu (the CPU wrote them since the draw); %llu not merged (map failed); deepest queue %llu "
+      "(%.1f MiB); verify: %llu of %llu stored dwords changed by the CPU before the next sync point",
+      ModeName(mode), static_cast<unsigned long long>(s.queued),
+      double(s.queued_bytes) / (1024.0 * 1024.0), static_cast<unsigned long long>(s.delivered),
+      static_cast<unsigned long long>(s.polled), static_cast<unsigned long long>(s.waits),
+      wait_ms_s, by.empty() ? "none" : by.c_str(), static_cast<unsigned long long>(s.written),
+      static_cast<unsigned long long>(s.kept), static_cast<unsigned long long>(s.failed),
+      static_cast<unsigned long long>(s.deepest), double(s.deepest_bytes) / (1024.0 * 1024.0),
+      static_cast<unsigned long long>(s.verify_changed),
+      static_cast<unsigned long long>(s.verify_checked));
+  return text;
+}
+
+}  // namespace memexport_deliver
+}  // namespace xbox360ps5
+
+#endif  // XENIA_GPU_MEMEXPORT_DELIVER_H_
