+// Fix 177: a point where the CPU could learn that the GPU went on: the queued merges first (with a
+// wait), and in "verify" the count of what the CPU changed since the last immediate merges.
+void VulkanCommandProcessor::GuestSyncPoint(uint32_t point) {
+  namespace md = xbox360ps5::memexport_deliver;
+  if (!fix177::verify_stored.empty()) {
+    fix177::stats.verify_checked += fix177::verify_stored.size();
+    fix177::stats.verify_changed +=
+        md::CountChanged(fix177::verify_stored, [this](uint32_t address) {
+          return md::LoadRaw(memory_->TranslatePhysical(address));
+        });
+    fix177::verify_stored.clear();
+  }
+  if (!fix177::pending.empty() && !fix177::delivering) Fix177Deliver(true, point);
+}
+
+// Fix 177: the queued merges whose copies the GPU has made (all of them after a wait), in draw
+// order, each keeping what the CPU wrote since its draw.
+void VulkanCommandProcessor::Fix177Deliver(bool wait, uint32_t point) {
+  namespace md = xbox360ps5::memexport_deliver;
+  if (fix177::pending.empty() || fix177::delivering) return;
+  fix177::delivering = true;
+  if (wait) {
+    ++fix177::stats.waits;
+    if (point < md::kPoints) ++fix177::stats.waits_by[point];
+    const uint64_t start = xbox360ps5::frame_cost::NowNs();
+    {
+      // Counted as fix 49's memexport readback wait, as the immediate wait it replaces.
+      namespace fc = xbox360ps5::frame_cost;
+      fc::CauseScope frame_cost_cause(fc::kMemexport);
+      AwaitAllQueueOperationsCompletion();
+    }
+    fix177::wait_ns += xbox360ps5::frame_cost::NowNs() - start;
+  }
+  const uint64_t completed = wait ? GetCompletedSubmission()
+                                  : completion_timeline_.UpdateAndGetCompletedSubmission();
+  const ui::vulkan::VulkanDevice::Functions& dfn = GetVulkanDevice()->functions();
+  const VkDevice device = GetVulkanDevice()->device();
+  while (!fix177::pending.empty() && fix177::pending.front().submission <= completed) {
+    fix177::Entry entry = std::move(fix177::pending.front());
+    fix177::pending.pop_front();
+    fix177::pending_bytes -= entry.size_class;
+    void* mapped = nullptr;
+    if (!device_lost_ && MapReadbackMemory(entry.memory, entry.coherent, &mapped) && mapped) {
+      const uint8_t* after = static_cast<const uint8_t*>(mapped);
+      const uint8_t* before = after + entry.before_offset;
+      for (const md::Range& range : entry.ranges) {
+        const md::Merged merged = md::MergeKeepingCpu(memory_->TranslatePhysical(range.start),
+                                                      before, after, range.length);
+        fix177::stats.written += merged.written;
+        fix177::stats.kept += merged.kept;
+        after += range.length;
+        before += range.length;
+      }
+      dfn.vkUnmapMemory(device, entry.memory);
+      ++fix177::stats.delivered;
+      fix177::stats.polled += !wait;
+    } else {
+      ++fix177::stats.failed;
+    }
+    entry.ranges.clear();
+    fix177::spare.push_back(std::move(entry));
+  }
+  fix177::delivering = false;
+}
+
+// Fix 177: a readback buffer for one queued draw, kept for reuse after its merge.
+bool VulkanCommandProcessor::Fix177AcquireBuffer(uint32_t bytes, void* entry_out) {
+  namespace md = xbox360ps5::memexport_deliver;
+  fix177::Entry& entry = *static_cast<fix177::Entry*>(entry_out);
+  const uint32_t size_class = md::SizeClass(bytes);
+  for (size_t i = 0; i < fix177::spare.size(); ++i) {
+    if (fix177::spare[i].size_class == size_class) {
+      entry = std::move(fix177::spare[i]);
+      fix177::spare.erase(fix177::spare.begin() + i);
+      return true;
+    }
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  uint32_t memory_type = 0;
+  if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+          vulkan_device, size_class, VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+          ui::vulkan::util::MemoryPurpose::kReadback, entry.buffer, entry.memory,
+          &memory_type)) {
+    entry.buffer = VK_NULL_HANDLE;
+    entry.memory = VK_NULL_HANDLE;
+    return false;
+  }
+  entry.coherent = (vulkan_device->memory_types().host_coherent >> memory_type) & 1;
+  entry.size_class = size_class;
+  return true;
+}
+
+// Fix 177: at shutdown, after every submission completed.
+void VulkanCommandProcessor::Fix177DestroyBuffers() {
+  const ui::vulkan::VulkanDevice::Functions& dfn = GetVulkanDevice()->functions();
+  const VkDevice device = GetVulkanDevice()->device();
+  auto destroy = [&](fix177::Entry& entry) {
+    if (entry.buffer != VK_NULL_HANDLE) dfn.vkDestroyBuffer(device, entry.buffer, nullptr);
+    if (entry.memory != VK_NULL_HANDLE) dfn.vkFreeMemory(device, entry.memory, nullptr);
+  };
+  for (fix177::Entry& entry : fix177::pending) destroy(entry);
+  for (fix177::Entry& entry : fix177::spare) destroy(entry);
+  fix177::pending.clear();
+  fix177::spare.clear();
+  fix177::pending_bytes = 0;
+}
+
+// Fix 177: guest memory about to be uploaded over a queued range: its merge goes first.
+void VulkanCommandProcessor::Fix177BeforeUpload(void* context,
+                                                const std::pair<uint32_t, uint32_t>* ranges,
+                                                uint32_t count, uint32_t page_size_log2) {
+  auto* self = static_cast<VulkanCommandProcessor*>(context);
+  if (fix177::pending.empty() || fix177::delivering) return;
+  for (uint32_t i = 0; i < count; ++i) {
+    const uint32_t start = ranges[i].first << page_size_log2;
+    const uint32_t length = ranges[i].second << page_size_log2;
+    for (const fix177::Entry& entry : fix177::pending) {
+      if (xbox360ps5::memexport_deliver::AnyOverlap(entry.ranges, start, length)) {
+        self->Fix177Deliver(true, xbox360ps5::memexport_deliver::kUpload);
+        return;
+      }
+    }
+  }
+}
