+// Fix 177: memexport-deliver.txt at most once a second, and the line every 30 s.
+void VulkanCommandProcessor::Fix177Refresh() {
+  namespace md = xbox360ps5::memexport_deliver;
+  const auto now = std::chrono::steady_clock::now();
+  if (!fix177::logged || now - fix177::checked >= std::chrono::seconds(1)) {
+    fix177::checked = now;
+    md::Mode next = md::Mode::kOff;
+    const char* from = "the default";
+    const char* const path = XBOX360PS5_DATA_ROOT "/memexport-deliver.txt";
+    if (FILE* file = std::fopen(path, "rb")) {
+      char text[64] = {};
+      const size_t got = std::fread(text, 1, sizeof(text) - 1, file);
+      std::fclose(file);
+      next = md::ParseMode(std::string(text, got), md::Mode::kOff);
+      from = path;
+    }
+    if (!fix177::logged || next != fix177::mode) {
+      // Copies still queued after "on" is left are merged at the next sync point as before (no
+      // wait here: this runs at the start of EndSubmission, which a wait would enter again).
+      XELOGW("Memexport delivery (fix 177): {}, from {}", md::ModeName(next), from);
+      fix177::mode = next;
+      fix177::logged = true;
+    }
+  }
+  if (fix177::line_at == std::chrono::steady_clock::time_point()) fix177::line_at = now;
+  const double seconds =
+      std::chrono::duration<double>(now - fix177::line_at).count();
+  if (seconds >= 30.0) {
+    const md::Stats& s = fix177::stats;
+    if (fix177::mode != md::Mode::kOff || s.queued || s.waits || s.verify_checked) {
+      XELOGW("{}", md::Line(fix177::mode, s, double(fix177::wait_ns) / 1e6 / seconds));
+    }
+    fix177::stats = md::Stats();
+    fix177::wait_ns = 0;
+    fix177::line_at = now;
+  }
+}
