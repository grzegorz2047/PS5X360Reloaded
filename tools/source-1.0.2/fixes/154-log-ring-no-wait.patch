diff --git a/include/xbox360ps5/log_ring.hpp b/include/xbox360ps5/log_ring.hpp
new file mode 100644
--- /dev/null
+++ b/include/xbox360ps5/log_ring.hpp
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: MIT
+// Fix 154: the core logger's ring never makes a thread that logs wait (header-only, no Xenia headers).
+//
+// The core logger (xenia/base/logging.cc) hands each line to its writer thread through an 8 MiB
+// ring of 32768 blocks of 256 bytes. When the writer falls behind and the ring is full, the
+// disruptor's claim() spins until the writer frees blocks, on whatever thread logs: the GPU
+// command thread, the UI loop, guest threads. In 1.0.5 at "Resolution scale (test)" 2x, Kinect
+// titles logged "Resolve copy command 2 is not supported with resolution scaling" for every
+// body-tracking copy (7542 of 9470 lines in Kinect Sports, issue #65; 40806 of 43143 in Puss in
+// Boots, #64), the writer drained about 20 lines a second, the ring filled after 170-330 s and
+// the game fell to 0-2 frames a second with its GPU and UI threads in claim().
+//
+// Budget counts the blocks claimed and not yet given back by the writer. A line goes into the
+// ring only when its blocks fit (TryReserve); then claim() finds them free and returns at once.
+// A line that does not fit is dropped and counted (hang_watch::log_dropped, shown in the hang
+// watch's beat; the writer notes the count in the log). Why claim() cannot wait after a
+// reservation: every claimed and unconsumed block belongs to a reserved line, so a range claimed
+// after a reservation ends at most `capacity` blocks after the writer's last consumed one, which
+// is all claim() waits for. The writer gives blocks back (Release) only after publishing them as
+// consumed.
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+namespace xbox360ps5::log_ring {
+
+class Budget {
+ public:
+  explicit Budget(size_t capacity) : capacity_(capacity) {}
+  Budget(const Budget&) = delete;
+  Budget& operator=(const Budget&) = delete;
+
+  // Reserves `count` blocks if they are free; never waits. False: the line is to be dropped.
+  bool TryReserve(size_t count) {
+    size_t used = used_.load(std::memory_order_acquire);
+    do {
+      if (count > capacity_ || used > capacity_ - count) return false;
+    } while (!used_.compare_exchange_weak(used, used + count, std::memory_order_acq_rel,
+                                          std::memory_order_acquire));
+    return true;
+  }
+  // The writer, after it has published the blocks of the lines it wrote as consumed.
+  void Release(size_t count) { used_.fetch_sub(count, std::memory_order_acq_rel); }
+
+  size_t used() const { return used_.load(std::memory_order_relaxed); }
+  size_t capacity() const { return capacity_; }
+
+ private:
+  const size_t capacity_;
+  std::atomic<size_t> used_{0};
+};
+
+// A warning repeated many times a second is logged the first 4 times, then every 4096th, with
+// its count (as draw_util.cc's refused resolves). `count` is the number logged before this one.
+inline bool LogThisRepeat(uint32_t count) { return count < 4 || !(count & 0xFFF); }
+
+// The writer's note about dropped lines, at most once in `interval_ms`, when the total grew.
+// Returns true and advances `noted` when a note is due.
+struct DropNote {
+  uint64_t noted = 0;
+  uint64_t noted_ms = 0;
+  bool started = false;
+  bool Due(uint64_t dropped_total, uint64_t now_ms, uint64_t interval_ms = 1000) {
+    if (dropped_total <= noted) return false;
+    if (started && now_ms - noted_ms < interval_ms) return false;
+    started = true;
+    noted_ms = now_ms;
+    noted = dropped_total;
+    return true;
+  }
+};
+
+}  // namespace xbox360ps5::log_ring
