+  if (logged && now - checked < std::chrono::seconds(1)) return;
+  checked = now;
+  bool next = cvars::readback_deliver_when_done;
+  const char* from = "the settings";
+  const char* const path = XBOX360PS5_DATA_ROOT "/readback-deliver.txt";
+  if (FILE* file = std::fopen(path, "rb")) {
+    char text[32] = {};
+    const size_t got = std::fread(text, 1, sizeof(text) - 1, file);
+    std::fclose(file);
+    std::string word(text, got);
+    const size_t start = word.find_first_not_of(" \t\r\n");
+    word = start == std::string::npos
+               ? std::string()
+               : word.substr(start, word.find_first_of(" \t\r\n#", start) - start);
+    if (word == "1" || word == "on" || word == "0" || word == "off") {
+      next = word == "1" || word == "on";
+      from = path;
+    }
+  }
+  if (!logged || next != enabled) {
+    XELOGW("Readback delivery (fix 142i): {}, from {}", next ? "on" : "off", from);
+    enabled = next;
+    logged = true;
