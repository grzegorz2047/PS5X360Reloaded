+// Fix 142i: puts the queued copies the GPU has made in guest memory, oldest first; a copy whose
+// slot was reused, or older than one already put there, is dropped.
+void VulkanCommandProcessor::Fix142iDeliver() {
+  if (fix142i::pending.empty()) return;
+  readback_reads_.Take([&](uint32_t read_address, uint32_t read_length) {
+    Fix142iEarlyRead(read_address, read_length);
+    for (auto& [key, buffer] : readback_buffers_) {  // fix 91's marks, as at a resolve
+      const uint32_t key_address = uint32_t(key >> 32), key_length = uint32_t(key);
+      if (buffer.armed_frame && !buffer.cpu_reads &&
+          readback_slots::Overlaps(key_address, key_length, read_address, read_length)) {
+        buffer.cpu_reads = true;
+        ++readback_keys_flagged_;
+      }
+    }
+  });
+  const uint64_t completed = completion_timeline_.UpdateAndGetCompletedSubmission();
+  std::sort(fix142i::pending.begin(), fix142i::pending.end(),
+            [](const fix142i::Pending& a, const fix142i::Pending& b) {
+              return a.submission < b.submission;
+            });
+  const ui::vulkan::VulkanDevice::Functions& dfn = GetVulkanDevice()->functions();
+  const VkDevice device = GetVulkanDevice()->device();
+  size_t kept = 0;
+  for (size_t i = 0; i < fix142i::pending.size(); ++i) {
+    const fix142i::Pending p = fix142i::pending[i];
+    if (p.submission > completed) {
+      fix142i::pending[kept++] = p;
+      continue;
+    }
+    auto it = readback_buffers_.find(p.key);
+    uint64_t& newest = fix142i::delivered[p.key];
+    if (it == readback_buffers_.end() || it->second.submissions[p.slot] != p.submission ||
+        it->second.buffers[p.slot] == VK_NULL_HANDLE ||
+        it->second.valid_sizes[p.slot] < p.length || newest >= p.submission) {
+      ++fix142i::superseded;
+      continue;
+    }
+    ReadbackBuffer& rb = it->second;
+    if (xbox360ps5::readback_keys::NoCopy(g_readback_rules, p.address, rb.cpu_reads)) {
+      ++fix142i::left_out;
+      newest = p.submission;
+      continue;
+    }
+    void* mapped_data;
+    if (!MapReadbackMemory(rb.memories[p.slot], rb.host_coherent[p.slot], &mapped_data)) {
+      ++fix142i::superseded;
+      continue;
+    }
+    memory::vastcpy(memory_->TranslatePhysical(p.address), static_cast<uint8_t*>(mapped_data),
+                    p.length);
+    dfn.vkUnmapMemory(device, rb.memories[p.slot]);
+    newest = p.submission;
+    ++fix142i::delivered_count;
+    fix142i::delivered_bytes += p.length;
+    fix142i::delay_frames += frame_current_ - p.frame;
+  }
+  fix142i::pending.resize(kept);
+}
