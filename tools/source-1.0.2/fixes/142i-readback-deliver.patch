+// A hex guest address ("1F0E8000", "0x1F0E8000"); false if the word is not one.
+bool ParseAddress(std::string word, uint32_t& address) {
+  if (word.size() > 2 && word[0] == '0' && (word[1] == 'x' || word[1] == 'X')) word = word.substr(2);
+  if (word.empty() || word.size() > 8 ||
+      word.find_first_not_of("0123456789abcdefABCDEF") != std::string::npos) {
+    return false;
+  }
+  address = uint32_t(std::strtoul(word.c_str(), nullptr, 16));
+  return true;
