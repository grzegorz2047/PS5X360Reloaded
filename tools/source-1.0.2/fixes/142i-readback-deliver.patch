+// Fix 142i: a CPU read of a copy still queued (read before the copy was put in memory).
+// Counted once per read, and once per key it covers (a 16 KiB read can cover two 8 KiB keys).
+bool VulkanCommandProcessor::Fix142iEarlyRead(uint32_t read_address, uint32_t read_length) {
+  std::vector<uint64_t> keys;
+  for (const fix142i::Pending& p : fix142i::pending) {
+    if (!readback_slots::Overlaps(p.address, p.length, read_address, read_length) ||
+        std::find(keys.begin(), keys.end(), p.key) != keys.end()) {
+      continue;
+    }
+    keys.push_back(p.key);
+    fix142i::EarlyKey& counted = fix142i::early_by_key[p.key];
+    ++counted.reads;
+    counted.frames += frame_current_ - p.frame;
+    if (fix142i::early_shown < 16) {
+      ++fix142i::early_shown;
+      XELOGW("Readback delivery (fix 142i): the CPU read {:08X} ({} bytes) before the copy of "
+             "the key {:08X} ({} bytes) from {} frames ago was put in memory",
+             read_address, read_length, p.address, p.length, frame_current_ - p.frame);
+    }
+    if (fix142i::wait_after_early && !fix142i::read_early.count(p.key)) {
+      fix142i::read_early[p.key] = true;
+      if (fix142i::moved_shown < 32) {
+        ++fix142i::moved_shown;
+        XELOGW("Readback delivery (fix 142i): the key {:08X} ({} bytes) waits from now on, the "
+               "CPU read it before its copy was put in memory",
+               p.address, p.length);
+      }
+    }
+  }
+  if (keys.empty()) return false;
+  ++fix142i::early_reads;
+  return true;
+}
