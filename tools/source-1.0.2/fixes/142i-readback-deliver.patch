+#if XE_PLATFORM_PS5
+// Fix 142i: a CPU read of a copy still queued (read before the copy was put in memory).
+bool VulkanCommandProcessor::Fix142iEarlyRead(uint32_t read_address, uint32_t read_length) {
+  for (const fix142i::Pending& p : fix142i::pending) {
+    if (readback_slots::Overlaps(p.address, p.length, read_address, read_length)) {
+      ++fix142i::early_reads;
+      if (fix142i::early_shown < 16) {
+        ++fix142i::early_shown;
+        XELOGW("Readback delivery (fix 142i): the CPU read {:08X} ({} bytes) before the copy of "
+               "the key {:08X} ({} bytes) from {} frames ago was put in memory",
+               read_address, read_length, p.address, p.length, frame_current_ - p.frame);
+      }
+      return true;
+    }
+  }
+  return false;
+}
