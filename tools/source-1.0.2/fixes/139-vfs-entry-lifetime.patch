+namespace {
+// Xbox360PS5, fix 139: the entries with users, and the removed ones kept for their users. Never
+// destroyed (entries may still be released while the process exits).
+std::unordered_set<const Entry*>& EntriesInUse() {
+  static auto* in_use = new std::unordered_set<const Entry*>();
+  return *in_use;
+}
+std::vector<std::unique_ptr<Entry>>& RemovedInUse() {
+  static auto* removed = new std::vector<std::unique_ptr<Entry>>();
+  return *removed;
+}
+}  // namespace
+
+File::File(uint32_t file_access, Entry* entry)
+    : file_access_(file_access), entry_(entry) {
+  if (entry_) {
+    entry_->AddUser();
+  }
+}
+
+File::~File() {
+  if (entry_) {
+    Entry::ReleaseUser(entry_);
+  }
+}
+
+void Entry::AddUser() {
+  auto global_lock = xe::global_critical_region::Acquire();
+  if (users_++ == 0) {
+    EntriesInUse().insert(this);
+  }
+}
+
+void Entry::ReleaseUser(Entry* entry) {
+  auto global_lock = xe::global_critical_region::Acquire();
+  auto& in_use = EntriesInUse();
+  // Not there: freed with its device (unmounted) while used; nothing left to release.
+  if (!in_use.count(entry) || --entry->users_) {
+    return;
+  }
+  in_use.erase(entry);
+  if (entry->removed_) {
+    auto& removed = RemovedInUse();
+    for (auto it = removed.begin(); it != removed.end(); ++it) {
+      if (it->get() == entry) {
+        removed.erase(it);  // frees it
+        break;
+      }
+    }
+  }
+}
+
+bool Entry::InUse(const Entry* entry) {
+  auto global_lock = xe::global_critical_region::Acquire();
+  return EntriesInUse().count(entry) != 0;
+}
+
+void Entry::Retire(std::unique_ptr<Entry> entry) {
+  auto global_lock = xe::global_critical_region::Acquire();
+  entry->removed_ = true;
+  for (auto& child : entry->children_) {
+    Retire(std::move(child));
+  }
+  entry->children_.clear();
+  if (entry->users_) {
+    RemovedInUse().push_back(std::move(entry));
+  }
+}
+
+template <class Lock>
+Entry* Entry::ChildAfterDelete(Lock& lock, const std::string_view name) {
+  const auto until = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+  for (;;) {
+    Entry* child = GetChild(name);
+    if (!child || !child->deleting_ ||
+        std::chrono::steady_clock::now() >= until) {
+      return child;
+    }
+    // Being deleted without the lock (fix 129): let it finish.
+    lock.unlock();
+    std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    lock.lock();
+  }
+}
+
+Entry* Entry::GetChildAfterDelete(const std::string_view name) {
+  auto global_lock = global_critical_region_.Acquire();
+  AddUser();  // kept while waiting
+  Entry* child = ChildAfterDelete(global_lock, name);
+  if (removed_) {
+    child = nullptr;  // deleted with its children meanwhile
+  }
+  ReleaseUser(this);
+  return child;
+}
