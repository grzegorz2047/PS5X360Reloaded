+  // open on it, File's constructor and destructor, and Delete/CreateEntry while they run without
+  // the lock); a deleted one (or one under a deleted directory) is removed from its parent at
+  // once and freed when its last user lets go. GetChildAfterDelete waits for a child of that
+  // name being deleted (up to 5 s) instead of returning it.
+  void AddUser();
+  static void ReleaseUser(Entry* entry);
+  static bool InUse(const Entry* entry);
+  bool is_removed() const { return removed_; }
+  bool is_deleting() const { return deleting_; }
