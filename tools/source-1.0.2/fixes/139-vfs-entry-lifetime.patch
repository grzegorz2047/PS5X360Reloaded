+  // Fix 139: its users (files open on it, operations without the lock), and whether it was
+  // taken out of its parent. Under the global critical region.
+  uint32_t users_ = 0;
+  bool removed_ = false;
   std::vector<std::unique_ptr<Entry>> children_;
 };
 
