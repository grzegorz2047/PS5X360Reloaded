 void VulkanCommandProcessor::WriteRegistersFromMem(uint32_t start_index,
                                                    uint32_t* base,
                                                    uint32_t num_registers) {
+#if XE_PLATFORM_PS5
+  WriteRegistersSwapped(start_index, base, num_registers);  // fix 103
+#else
   for (uint32_t i = 0; i < num_registers; ++i) {
     uint32_t data = xe::load_and_swap<uint32_t>(base + i);
     VulkanCommandProcessor::WriteRegister(start_index + i, data);
   }
+#endif
+}
+#if XE_PLATFORM_PS5
+// Fix 103: a run of registers a block at a time (xenia/gpu/register_run.h):
+// the ring's bytes read in place instead of an out-of-line RingBuffer::Read
+// and two out-of-line WriteRegister calls per register (Grand Theft Auto IV:
+// about 1.4 million type 0 packets a second, 97 ns each).
+static_assert(register_run::kFloatFirst == XE_GPU_REG_SHADER_CONSTANT_000_X &&
+              register_run::kFloatLast == XE_GPU_REG_SHADER_CONSTANT_511_W &&
+              register_run::kFetchFirst ==
+                  XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 &&
+              register_run::kFetchLast ==
+                  XE_GPU_REG_SHADER_CONSTANT_FETCH_31_5 &&
+              register_run::kBoolLoopFirst ==
+                  XE_GPU_REG_SHADER_CONSTANT_BOOL_000_031 &&
+              register_run::kBoolLoopLast == XE_GPU_REG_SHADER_CONSTANT_LOOP_31,
+              "fix 103: the constant ranges of register_table.inc");
+void VulkanCommandProcessor::WriteRegisterRangeFromRing(xe::RingBuffer* ring,
+                                                        uint32_t base,
+                                                        uint32_t num_registers) {
+  const size_t bytes = size_t(num_registers) * sizeof(uint32_t);
+  xe::RingBuffer::ReadRange range = ring->BeginRead(bytes);
+  if (size_t(range.first_length) + size_t(range.second_length) != bytes ||
+      (range.first_length & 3)) {
+    // Not whole registers in place (not with a valid packet): the base
+    // class's reading, register by register.
+    CommandProcessor::WriteRegisterRangeFromRing(ring, base, num_registers);
+    return;
+  }
+  const uint32_t first_count = range.first_length / sizeof(uint32_t);
+  WriteRegistersSwapped(base, reinterpret_cast<const uint32_t*>(range.first),
+                        first_count);
+  if (range.second_length) {
+    WriteRegistersSwapped(base + first_count,
+                          reinterpret_cast<const uint32_t*>(range.second),
+                          range.second_length / sizeof(uint32_t));
+  }
+  ring->EndRead(range);
+}
+void VulkanCommandProcessor::WriteRegistersSwapped(uint32_t start_index,
+                                                   const uint32_t* source,
+                                                   uint32_t num_registers) {
+  const register_run::State state{
+      register_file_->values,
+      cvars::vulkan_skip_redundant_constants,
+      frame_open_,
+      current_float_constant_map_vertex_,
+      current_float_constant_map_pixel_,
+      {UINT32_C(1) << SpirvShaderTranslator::kConstantBufferFloatVertex,
+       UINT32_C(1) << SpirvShaderTranslator::kConstantBufferFloatPixel,
+       UINT32_C(1) << SpirvShaderTranslator::kConstantBufferFetch,
+       UINT32_C(1) << SpirvShaderTranslator::kConstantBufferBoolLoop},
+      &current_constant_buffers_up_to_date_};
+  register_run::Write(
+      state, start_index, source, num_registers,
+      [this](uint32_t first, uint32_t last) {
+        if (texture_cache_) {
+          texture_cache_->TextureFetchConstantsWritten(first, last);
+        }
+      },
+      [this](uint32_t index, uint32_t value) {
+        VulkanCommandProcessor::WriteRegister(index, value);
+      });
 }
+#endif  // XE_PLATFORM_PS5
