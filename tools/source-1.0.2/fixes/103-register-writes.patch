+/**
+ ******************************************************************************
+ * Xbox360PS5: fix 103, a run of registers written a block at a time.         *
+ ******************************************************************************
+ * Grand Theft Auto IV sends about 1.4 million type 0 register packets a
+ * second (about 7 per draw), 132 ms/s of the GPU command thread at 97 ns each
+ * (Modern Warfare 2: 55 ns). Each register of a run was read from the ring by
+ * an out-of-line RingBuffer::Read, then written through the virtual
+ * WriteRegister and the base class's, in other translation units.
+ *
+ * Write() takes the run's big-endian words in place and writes the shader
+ * constants (float, fetch, bool/loop) itself, with exactly the effects
+ * VulkanCommandProcessor::WriteRegister has for each of those registers: the
+ * same values in the register file, the same constant buffers marked
+ * outdated, the same texture bindings out of sync (once for the run's fetch
+ * constants). Any other register goes to `other` (WriteRegister), one at a
+ * time and in order. tools/check-register-writes.cpp compares it with the
+ * register-by-register path.
+ ******************************************************************************
+ */
+
+#ifndef XENIA_GPU_REGISTER_RUN_H_
+#define XENIA_GPU_REGISTER_RUN_H_
+
+#include <algorithm>
+#include <cstdint>
+
+namespace xe {
+namespace gpu {
+namespace register_run {
+
+// register_table.inc (checked against XE_GPU_REG_* where this is used).
+constexpr uint32_t kFloatFirst = 0x4000;     // SHADER_CONSTANT_000_X
+constexpr uint32_t kFloatLast = 0x47FF;      // SHADER_CONSTANT_511_W
+constexpr uint32_t kFetchFirst = 0x4800;     // SHADER_CONSTANT_FETCH_00_0
+constexpr uint32_t kFetchLast = 0x48BF;      // SHADER_CONSTANT_FETCH_31_5
+constexpr uint32_t kBoolLoopFirst = 0x4900;  // SHADER_CONSTANT_BOOL_000_031
+constexpr uint32_t kBoolLoopLast = 0x4927;   // SHADER_CONSTANT_LOOP_31
+
+// The constant buffers' bits in current_constant_buffers_up_to_date_.
+struct Buffers {
+  uint32_t float_vertex, float_pixel, fetch, bool_loop;
+};
+
+// The command processor's state the constants touch.
+struct State {
+  uint32_t* regs;
+  bool skip_redundant;  // vulkan_skip_redundant_constants
+  bool frame_open;
+  const uint64_t* float_map_vertex;  // current_float_constant_map_vertex_
+  const uint64_t* float_map_pixel;   // current_float_constant_map_pixel_
+  Buffers buffers;
+  uint32_t* up_to_date;  // current_constant_buffers_up_to_date_
+};
+
+inline uint32_t LoadSwapped(const uint32_t* source) {
+  return __builtin_bswap32(*source);
+}
+
+// `fetch_written(first, last)` marks fetch constants first..last written
+// (TextureCache::TextureFetchConstantsWritten); `other(index, value)` writes
+// any other register (WriteRegister).
+template <typename FetchWritten, typename Other>
+inline void Write(const State& state, uint32_t start_index,
+                  const uint32_t* source, uint32_t count,
+                  FetchWritten&& fetch_written, Other&& other) {
+  uint32_t* regs = state.regs;
+  uint32_t i = 0;
+  while (i < count) {
+    const uint32_t index = start_index + i;
+    if (index >= kFloatFirst && index <= kFloatLast) {
+      const uint32_t end = std::min(count, i + (kFloatLast + 1 - index));
+      uint32_t outdated = 0;
+      for (; i < end; ++i) {
+        const uint32_t constant = start_index + i;
+        const uint32_t value = LoadSwapped(source + i);
+        if (state.skip_redundant && regs[constant] == value) {
+          continue;
+        }
+        regs[constant] = value;
+        if (state.frame_open) {
+          uint32_t float_index = (constant - kFloatFirst) >> 2;
+          if (float_index >= 256) {
+            float_index -= 256;
+            if (state.float_map_pixel[float_index >> 6] &
+                (UINT64_C(1) << (float_index & 63))) {
+              outdated |= state.buffers.float_pixel;
+            }
+          } else if (state.float_map_vertex[float_index >> 6] &
+                     (UINT64_C(1) << (float_index & 63))) {
+            outdated |= state.buffers.float_vertex;
+          }
+        }
+      }
+      *state.up_to_date &= ~outdated;
+    } else if (index >= kFetchFirst && index <= kFetchLast) {
+      // Every fetch constant write marks them outdated, changed or not.
+      const uint32_t end = std::min(count, i + (kFetchLast + 1 - index));
+      for (; i < end; ++i) {
+        regs[start_index + i] = LoadSwapped(source + i);
+      }
+      *state.up_to_date &= ~state.buffers.fetch;
+      fetch_written((index - kFetchFirst) / 6,
+                    (start_index + end - 1 - kFetchFirst) / 6);
+    } else if (index >= kBoolLoopFirst && index <= kBoolLoopLast) {
+      const uint32_t end = std::min(count, i + (kBoolLoopLast + 1 - index));
+      bool changed = !state.skip_redundant;
+      for (; i < end; ++i) {
+        const uint32_t value = LoadSwapped(source + i);
+        changed |= regs[start_index + i] != value;
+        regs[start_index + i] = value;
+      }
+      if (changed) {
+        *state.up_to_date &= ~state.buffers.bool_loop;
+      }
+    } else {
+      other(index, LoadSwapped(source + i));
+      ++i;
+    }
+  }
+}
+
+}  // namespace register_run
+}  // namespace gpu
+}  // namespace xe
+
+#endif  // XENIA_GPU_REGISTER_RUN_H_
