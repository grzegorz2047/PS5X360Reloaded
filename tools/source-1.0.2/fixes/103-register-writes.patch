+// Fix 103: what the type 0 packets write. Grand Theft Auto IV on 1.0.5-work-fix93e: 1.36 million a
+// second (about 7 per draw), 132 ms/s of the GPU command thread, 97 ns each (Modern Warfare 2: 55).
+// Every type 0 packet is counted (the GPU thread's own counters) by the group of its first
+// register (float, fetch or bool/loop shader constants, or another register) with its register
+// count, and by its first register, so that the summary can name the registers written most.
+enum RegisterGroup : uint32_t { kRegFloat = 0, kRegFetch, kRegBoolLoop, kRegOther, kRegGroups };
+inline uint32_t RegisterGroupOf(uint32_t index) {
+  if (index >= 0x4000 && index <= 0x47FF) return kRegFloat;     // SHADER_CONSTANT_000_X.._511_W
+  if (index >= 0x4800 && index <= 0x48BF) return kRegFetch;     // SHADER_CONSTANT_FETCH_00_0.._31_5
+  if (index >= 0x4900 && index <= 0x4927) return kRegBoolLoop;  // SHADER_CONSTANT_BOOL_000_031..LOOP_31
+  return kRegOther;
+}
+inline const char* RegisterGroupName(uint32_t group) {
+  static const char* const names[] = {"float constants", "fetch constants", "bool/loop constants", "other registers"};
+  return group < kRegGroups ? names[group] : "?";
+}
+inline constexpr uint32_t kRegisterStarts = 0x8000;  // a type 0 packet's base index has 15 bits
+inline std::array<std::atomic<uint64_t>, kRegGroups> register_packets{}, register_values{};
+inline std::array<std::atomic<uint32_t>, kRegisterStarts> register_starts{};
+inline void CountRegisterWrites(uint32_t base_index, uint32_t count) {
+  if (!OnGpuThread()) return;
+  const uint32_t group = RegisterGroupOf(base_index);
+  AddOwn(register_packets[group], 1);
+  AddOwn(register_values[group], count);
+  std::atomic<uint32_t>& start = register_starts[base_index % kRegisterStarts];
+  start.store(start.load(std::memory_order_relaxed) + 1, std::memory_order_relaxed);
+}
+// "Performance register writes (GPU thread, every type 0 packet): n packets/s, m registers/s (x
+// per packet); float constants n/s (m registers/s), ...; first registers written most: 4000 n/s
+// (float constants), 2180 n/s, ..." since its previous line.
+inline constexpr uint32_t kRegisterStartsShown = 6;
+class RegisterReporter {
+ public:
+  std::string Line(double seconds) {
+    const double s = seconds > 0 ? seconds : 1;
+    uint64_t packets = 0, values = 0;
+    std::string groups;
+    for (uint32_t g = 0; g < kRegGroups; ++g) {
+      const uint64_t p = register_packets[g].load(std::memory_order_relaxed);
+      const uint64_t v = register_values[g].load(std::memory_order_relaxed);
+      const uint64_t dp = p - last_packets_[g], dv = v - last_values_[g];
+      last_packets_[g] = p;
+      last_values_[g] = v;
+      packets += dp;
+      values += dv;
+      if (!dp) continue;
+      char item[96];
+      std::snprintf(item, sizeof(item), "%s%s %.0f/s (%.0f registers/s)", groups.empty() ? "" : ", ",
+                    RegisterGroupName(g), double(dp) / s, double(dv) / s);
+      groups += item;
+    }
+    std::array<std::pair<uint32_t, uint32_t>, kRegisterStartsShown> top{};  // (packets, start)
+    for (uint32_t r = 0; r < kRegisterStarts; ++r) {
+      const uint32_t now = register_starts[r].load(std::memory_order_relaxed);
+      const uint32_t d = now - last_starts_[r];
+      last_starts_[r] = now;
+      if (!d || d <= top.back().first) continue;
+      uint32_t at = kRegisterStartsShown - 1;
+      while (at && top[at - 1].first < d) {
+        top[at] = top[at - 1];
+        --at;
+      }
+      top[at] = {d, r};
+    }
+    std::string starts;
+    for (const auto& [d, r] : top) {
+      if (!d) break;
+      char item[64];
+      std::snprintf(item, sizeof(item), "%s%04X %.0f/s", starts.empty() ? "" : ", ", r, double(d) / s);
+      starts += item;
+    }
+    char head[160];
+    std::snprintf(head, sizeof(head),
+                  "Performance register writes (GPU thread, every type 0 packet): %.0f packets/s, %.0f registers/s (%.1f per packet)",
+                  double(packets) / s, double(values) / s, packets ? double(values) / double(packets) : 0.0);
+    if (!packets) return std::string(head);
+    return std::string(head) + "; " + groups + "; first registers written most: " + starts;
+  }
+
+ private:
+  std::array<uint64_t, kRegGroups> last_packets_{}, last_values_{};
+  std::array<uint32_t, kRegisterStarts> last_starts_{};
+};
