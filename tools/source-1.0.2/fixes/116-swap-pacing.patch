-                    std::memory_order_relaxed);
-  if (on_grid) {
-    xe::threading::NanoSleep(deadline - now);  // Returns at once if late.
+  int64_t sleep_ns;
+  {
+    std::lock_guard<std::mutex> lock(pacer_mutex);
+    sleep_ns = pacer.OnSwap(now);
+    // Fix 116: every 30 s, what the pacing did since the previous line.
+    if (!last_report_ns) last_report_ns = now;
+    if (now - last_report_ns >= INT64_C(30000000000)) {
+      const double seconds = double(now - last_report_ns) / 1e9;
+      XELOGW(
+          "Performance swap pacing (fix 116): {:.1f} swaps/s, {:.1f} slept/s "
+          "({:.1f} ms/s); {}; {} decisions changed",
+          double(pacer.swaps - reported.swaps) / seconds,
