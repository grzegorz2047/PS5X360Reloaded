-  static std::atomic<int64_t> deadline_ns{0};
+  static std::mutex pacer_mutex;
+  static xbox360ps5::swap_pacing::Pacer pacer;
+  static int64_t last_report_ns = 0;
+  static xbox360ps5::swap_pacing::Pacer reported;
   const int64_t now = std::chrono::duration_cast<std::chrono::nanoseconds>(
