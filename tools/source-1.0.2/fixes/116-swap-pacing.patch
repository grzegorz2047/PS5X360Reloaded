diff --git a/include/xbox360ps5/swap_pacing.hpp b/include/xbox360ps5/swap_pacing.hpp
new file mode 100644
--- /dev/null
+++ b/include/xbox360ps5/swap_pacing.hpp
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: MIT
+// Fix 116: VdSwap pacing (fix 10) only for a game that would swap faster than the vblank.
+//
+// Fix 10 paces swaps on a 16.60 ms grid while VSync is on, so that a game unlocked by a 60 FPS
+// patch with a fixed 1/60 s step (Battlefield: Bad Company: 80 frames and more) is not too fast.
+// A game that waits for the vblank itself (Pro Evolution Soccer 6: its GPU waits once a frame on
+// a word the vblank interrupt raises) swaps about every 16.67 ms with some jitter, and an early
+// swap slept until the grid point, which pushed the frame past the next vblank: 53.5 to 54 frames
+// a second with VSync on, 59.9 with it off (1.0.5_candidate_65, same menus).
+//
+// The game's own rate is measured: the time between its swaps minus what the pacing slept.
+// Every kWindow swaps the pacer decides for the next ones: an average of kSelfPacedNs or more
+// (about 61 Hz or slower) means the game paces itself, and no swap sleeps; a faster one is paced
+// on the grid exactly as fix 10 did. It starts paced, as fix 10.
+#pragma once
+
+#include <cstdint>
+
+namespace xbox360ps5 {
+namespace swap_pacing {
+
+inline constexpr int64_t kPeriodNs = 16600000;     // fix 10's grid, about 60.2 Hz
+inline constexpr int64_t kSelfPacedNs = 16400000;  // about 61 Hz: not faster than the vblank
+inline constexpr uint32_t kWindow = 32;
+
+struct Pacer {
+  int64_t deadline = 0;    // the grid's next point (fix 10)
+  int64_t last_swap = 0;   // when the previous swap came
+  int64_t last_sleep = 0;  // what the pacing slept in it
+  int64_t window_own_ns = 0;
+  uint32_t window_swaps = 0;
+  bool pacing = true;
+  // For the summary: swaps, those that slept, the time slept, the decisions that changed.
+  uint64_t swaps = 0, slept = 0, slept_ns = 0, changes = 0;
+
+  // A swap at `now` (steady clock, ns): how long it sleeps before it goes on.
+  int64_t OnSwap(int64_t now) {
+    ++swaps;
+    if (last_swap) {
+      int64_t own = now - last_swap - last_sleep;
+      if (own < 0) own = 0;
+      window_own_ns += own;
+      if (++window_swaps == kWindow) {
+        const bool faster_than_vblank = window_own_ns < kSelfPacedNs * int64_t(kWindow);
+        if (faster_than_vblank != pacing) {
+          pacing = faster_than_vblank;
+          ++changes;
+          deadline = 0;  // a new grid from the next swap
+        }
+        window_own_ns = 0;
+        window_swaps = 0;
+      }
+    }
+    last_swap = now;
+    int64_t sleep = 0;
+    if (pacing) {
+      // Fix 10: an early swap sleeps until its deadline; one late by less than a period keeps
+      // the grid; one further behind, or the first, restarts it.
+      const bool on_grid = deadline != 0 && now < deadline + kPeriodNs;
+      if (on_grid && deadline > now) sleep = deadline - now;
+      deadline = on_grid ? deadline + kPeriodNs : now + kPeriodNs;
+    }
+    last_sleep = sleep;
+    if (sleep) {
+      ++slept;
+      slept_ns += uint64_t(sleep);
+    }
+    return sleep;
+  }
+};
+
+}  // namespace swap_pacing
+}  // namespace xbox360ps5
