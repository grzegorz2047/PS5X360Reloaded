+// Fix 130: where a submission's time goes (VulkanCommandProcessor::EndSubmission, wall time on the
+// GPU thread, nested sections included): the caches' end of submission and the upload flush
+// (prepare), sparse binds, the query segment, barriers, pool reset and vkBeginCommandBuffer
+// (begin), replaying the deferred command buffer into the Vulkan one (replay, with the bytes
+// replayed), the query resolves and vkEndCommandBuffer (end), vkQueueSubmit with its fence
+// (queue submit), and the bookkeeping after it (after). Measures how much an asynchronous submit
+// thread (F2) could take off the GPU thread: the replay, the end and the queue submit could move,
+// the rest stays. "Frame time submissions (GPU thread, fix 130): n/s, x KiB replayed each; prepare
+// a ms/s, sparse binds b, begin c, replay d, end e, queue submit f, after g".
+enum SubmitPart : uint32_t {
+  kSubmitPrepare = 0,
+  kSubmitSparse,
+  kSubmitBegin,
+  kSubmitReplay,
+  kSubmitEnd,
+  kSubmitQueue,
+  kSubmitAfter,
+  kSubmitParts
+};
+inline std::array<std::atomic<uint64_t>, kSubmitParts> submit_part_ticks{};
+inline std::atomic<uint64_t> submit_parts_count{0}, submit_replay_bytes{0};
+class SubmitTimer {
+ public:
+  SubmitTimer() : active_(OnGpuThread()), last_(active_ ? Ticks() : 0) {}
+  // The time since the previous mark belongs to `part`.
+  void Mark(SubmitPart part) {
+    if (!active_) return;
+    const uint64_t now = Ticks();
+    AddOwn(submit_part_ticks[part], now - last_);
+    last_ = now;
+  }
+  void Replayed(uint64_t bytes) {
+    if (active_) AddOwn(submit_replay_bytes, bytes);
+  }
+  void Done() {
+    if (active_) AddOwn(submit_parts_count, 1);
+  }
+  SubmitTimer(const SubmitTimer&) = delete;
+  SubmitTimer& operator=(const SubmitTimer&) = delete;
+
+ private:
+  bool active_;
+  uint64_t last_;
+};
+class SubmitPartsReporter {
+ public:
+  std::string Line(double seconds) {
+    const uint64_t ticks_now = Ticks(), ns_now = NowNs();
+    double ns_per_tick = last_ns_per_tick_ > 0 ? last_ns_per_tick_ : 1.0;
+    if (last_ticks_ && ticks_now > last_ticks_ && ns_now > last_ns_)
+      ns_per_tick = double(ns_now - last_ns_) / double(ticks_now - last_ticks_);
+    last_ns_per_tick_ = ns_per_tick;
+    last_ticks_ = ticks_now;
+    last_ns_ = ns_now;
+    const double s = seconds > 0 ? seconds : 1;
+    double ms[kSubmitParts];
+    for (uint32_t p = 0; p < kSubmitParts; ++p) {
+      const uint64_t now = submit_part_ticks[p].load(std::memory_order_relaxed);
+      ms[p] = double(now - last_parts_[p]) * ns_per_tick / 1e6 / s;
+      last_parts_[p] = now;
+    }
+    const uint64_t count = submit_parts_count.load(std::memory_order_relaxed);
+    const uint64_t bytes = submit_replay_bytes.load(std::memory_order_relaxed);
+    const uint64_t dc = count - last_count_, db = bytes - last_bytes_;
+    last_count_ = count;
+    last_bytes_ = bytes;
+    char text[320];
+    std::snprintf(text, sizeof(text),
+                  "Frame time submissions (GPU thread, fix 130): %.0f/s, %.1f KiB replayed each; prepare %.1f ms/s, "
+                  "sparse binds %.1f, begin %.1f, replay %.1f, end %.1f, queue submit %.1f, after %.1f",
+                  double(dc) / s, dc ? double(db) / 1024.0 / double(dc) : 0.0, ms[kSubmitPrepare], ms[kSubmitSparse],
+                  ms[kSubmitBegin], ms[kSubmitReplay], ms[kSubmitEnd], ms[kSubmitQueue], ms[kSubmitAfter]);
+    return text;
+  }
+
+ private:
+  uint64_t last_parts_[kSubmitParts] = {};
+  uint64_t last_count_ = 0, last_bytes_ = 0;
+  uint64_t last_ticks_ = 0, last_ns_ = 0;
+  double last_ns_per_tick_ = 0;
+};
