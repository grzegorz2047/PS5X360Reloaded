@@ -0,0 +1,59 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Copyright 2022 Ben Vanik. All rights reserved.                             *
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+#version 460
+#extension GL_GOOGLE_include_directive : require
+
+// Xbox360PS5 (fix 145): SMAA 1x, pass 2 of 3 (xenia/gpu/vulkan/swap_smaa.h):
+// blending weights from the edges with AreaTex and SearchTex into the weights
+// image (R8G8B8A8_UNORM, cleared to 0). The intermediate image's full size;
+// fullscreen_cw.vs.
+
+// swap_effects::PushConstants (as swap_post.glsli; grade_on.zw = the size).
+layout(push_constant) uniform XeSwapPostConstants {
+  vec2 size_inv;
+  vec2 offset;
+  vec4 grade;
+  vec4 grade_on;
+} xe_swap_post;
+
+#define SMAA_RT_METRICS vec4(xe_swap_post.size_inv, xe_swap_post.grade_on.zw)
+#define SMAA_GLSL_4 1
+#define SMAA_PRESET_HIGH 1
+#define SMAA_INCLUDE_VS 0
+#define SMAA_INCLUDE_PS 1
+#include "../../../../third_party/smaa/SMAA.hlsl"
+
+// Every sampler linear clamp-to-edge (the upstream contract).
+// The edges image (R8G8_UNORM).
+layout(set = 0, binding = 0) uniform sampler2D xe_smaa_edges;
+// AreaTex (160x560 R8G8_UNORM, uploaded as AreaTex.h stores it; .rg).
+layout(set = 0, binding = 1) uniform sampler2D xe_smaa_area;
+// SearchTex (64x16 R8_UNORM, as SearchTex.h stores it).
+layout(set = 0, binding = 2) uniform sampler2D xe_smaa_search;
+
+layout(location = 0) out vec4 xe_smaa_weights;
+
+void main() {
+  // gl_FragCoord.xy is the pixel's center; SMAABlendingWeightCalculationVS's
+  // offsets.
+  vec2 texcoord = gl_FragCoord.xy * SMAA_RT_METRICS.xy;
+  vec2 pixcoord = texcoord * SMAA_RT_METRICS.zw;
+  vec4 offset[3];
+  offset[0] = fma(SMAA_RT_METRICS.xyxy, vec4(-0.25, -0.125, 1.25, -0.125),
+                  texcoord.xyxy);
+  offset[1] = fma(SMAA_RT_METRICS.xyxy, vec4(-0.125, -0.25, -0.125, 1.25),
+                  texcoord.xyxy);
+  offset[2] = fma(SMAA_RT_METRICS.xxyy,
+                  vec4(-2.0, 2.0, -2.0, 2.0) * float(SMAA_MAX_SEARCH_STEPS),
+                  vec4(offset[0].xz, offset[1].yw));
+  xe_smaa_weights = SMAABlendingWeightCalculationPS(
+      texcoord, pixcoord, offset, xe_smaa_edges, xe_smaa_area, xe_smaa_search,
+      vec4(0.0));
+}
