+                      swap_smaa::kSearchTexStagingOffset,
+                  searchTexBytes, swap_smaa::kSearchTexBytes);
+      ui::vulkan::util::FlushMappedMemoryRange(
+          vulkan_device, swap_smaa_staging_memory_, staging_memory_type, 0,
+          staging_memory_size, swap_smaa::kStagingBytes);
+      dfn.vkUnmapMemory(device, swap_smaa_staging_memory_);
