+bool VulkanCommandProcessor::CreateSwapSmaaTargets(uint32_t width,
+                                                   uint32_t height) {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  SwapSmaaTargets targets;
+  targets.width = width;
+  targets.height = height;
+  const VkFormat formats[2] = {VK_FORMAT_R8G8_UNORM, VK_FORMAT_R8G8B8A8_UNORM};
+  const VkRenderPass render_passes[2] = {swap_smaa_edges_render_pass_,
+                                         swap_smaa_weights_render_pass_};
+  VkDeviceSize bytes[2] = {};
+  bool created = true;
+  for (uint32_t i = 0; i < 2 && created; ++i) {
+    VkImageCreateInfo image_create_info = {};
+    image_create_info.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+    image_create_info.imageType = VK_IMAGE_TYPE_2D;
+    image_create_info.format = formats[i];
+    image_create_info.extent.width = width;
+    image_create_info.extent.height = height;
+    image_create_info.extent.depth = 1;
+    image_create_info.mipLevels = 1;
+    image_create_info.arrayLayers = 1;
+    image_create_info.samples = VK_SAMPLE_COUNT_1_BIT;
+    image_create_info.tiling = VK_IMAGE_TILING_OPTIMAL;
+    image_create_info.usage =
+        VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT;
+    image_create_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    image_create_info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    created = ui::vulkan::util::CreateDedicatedAllocationImage(
+        vulkan_device, image_create_info,
+        ui::vulkan::util::MemoryPurpose::kDeviceLocal, targets.image[i],
+        targets.memory[i], nullptr, &bytes[i]);
+    if (created) {
+      VkImageViewCreateInfo view_create_info = {};
+      view_create_info.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO;
+      view_create_info.image = targets.image[i];
+      view_create_info.viewType = VK_IMAGE_VIEW_TYPE_2D;
+      view_create_info.format = formats[i];
+      view_create_info.subresourceRange =
+          ui::vulkan::util::InitializeSubresourceRange();
+      created = dfn.vkCreateImageView(device, &view_create_info, nullptr,
+                                      &targets.view[i]) == VK_SUCCESS;
+    }
+    if (created) {
+      VkFramebufferCreateInfo framebuffer_create_info = {};
+      framebuffer_create_info.sType = VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO;
+      framebuffer_create_info.renderPass = render_passes[i];
+      framebuffer_create_info.attachmentCount = 1;
+      framebuffer_create_info.pAttachments = &targets.view[i];
+      framebuffer_create_info.width = width;
+      framebuffer_create_info.height = height;
+      framebuffer_create_info.layers = 1;
+      created = dfn.vkCreateFramebuffer(device, &framebuffer_create_info,
+                                        nullptr, &targets.framebuffer[i]) ==
+                VK_SUCCESS;
+    }
+  }
+  if (!created) {
+    XELOGE(
+        "SMAA 1x (fix 145): the {}x{} edges and weights images were not made; "
+        "the picture goes without anti-aliasing at this size",
+        width, height);
+    DestroySwapSmaaTargets(targets);
+    return false;
+  }
+  XELOGW(
+      "SMAA 1x (fix 145): {}x{} edges (R8G8_UNORM) {} KiB and weights "
+      "(R8G8B8A8_UNORM) {} KiB allocated ({} KiB raw with the LUTs)",
+      width, height, bytes[0] / 1024, bytes[1] / 1024,
+      swap_smaa::RawBytes(width, height) / 1024);
+  swap_smaa_targets_ = targets;
+  return true;
+}
+
+void VulkanCommandProcessor::RetireSwapSmaaTargets() {
+  if (swap_smaa_targets_.image[0] != VK_NULL_HANDLE ||
+      swap_smaa_targets_.image[1] != VK_NULL_HANDLE) {
+    swap_smaa_retired_targets_.push_back(swap_smaa_targets_);
+  }
+  swap_smaa_targets_ = SwapSmaaTargets();
+  swap_smaa_failed_width_ = 0;
+  swap_smaa_failed_height_ = 0;
+}
+
+void VulkanCommandProcessor::DestroySwapSmaaTargets(
+    const SwapSmaaTargets& targets) {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  for (uint32_t i = 0; i < 2; ++i) {
+    if (targets.framebuffer[i] != VK_NULL_HANDLE) {
+      dfn.vkDestroyFramebuffer(device, targets.framebuffer[i], nullptr);
+    }
+    if (targets.view[i] != VK_NULL_HANDLE) {
+      dfn.vkDestroyImageView(device, targets.view[i], nullptr);
+    }
+    if (targets.image[i] != VK_NULL_HANDLE) {
+      dfn.vkDestroyImage(device, targets.image[i], nullptr);
+    }
+    if (targets.memory[i] != VK_NULL_HANDLE) {
+      dfn.vkFreeMemory(device, targets.memory[i], nullptr);
+    }
+  }
+}
+
+void VulkanCommandProcessor::DestroyRetiredSwapSmaaTargets(bool all) {
+  if (swap_smaa_retired_targets_.empty()) {
+    return;
+  }
+  // By the GPU's completed submissions, as fix 137's intermediate images (not
+  // by the logical frame).
+  const uint64_t completed_submission = GetCompletedSubmission();
+  for (size_t i = 0; i < swap_smaa_retired_targets_.size();) {
+    const SwapSmaaTargets& retired = swap_smaa_retired_targets_[i];
+    if (all ||
+        swap_fxaa::CanDestroy(retired.last_submission, completed_submission)) {
+      DestroySwapSmaaTargets(retired);
+      swap_smaa_retired_targets_.erase(swap_smaa_retired_targets_.begin() +
+                                       ptrdiff_t(i));
+    } else {
+      ++i;
+    }
+  }
+}
+
+bool VulkanCommandProcessor::PrepareSwapSmaa(bool asked, uint32_t width,
+                                             uint32_t height) {
+  DestroyRetiredSwapSmaaTargets(false);
+  if (!asked || !width || !height) {
+    // Not SMAA: the targets (6 bytes per pixel) are not kept; the LUTs and the
+    // pipelines (made once) stay until the context is shut down.
+    if (swap_smaa_targets_.image[0] != VK_NULL_HANDLE) {
+      RetireSwapSmaaTargets();
+    }
+    swap_smaa_failed_width_ = 0;
+    swap_smaa_failed_height_ = 0;
+    return false;
+  }
+  if (!swap_smaa_state_) {
+    swap_smaa_state_ = CreateSwapSmaaResources() ? 1 : -1;
+  }
+  if (swap_smaa_state_ <= 0) {
+    return false;
+  }
+  if (swap_smaa::NeedsNewTargets(swap_smaa_targets_.width,
+                                 swap_smaa_targets_.height, width, height)) {
+    if (swap_smaa_targets_.image[0] != VK_NULL_HANDLE) {
+      RetireSwapSmaaTargets();
+    }
+    if ((width != swap_smaa_failed_width_ ||
+         height != swap_smaa_failed_height_) &&
+        !CreateSwapSmaaTargets(width, height)) {
+      swap_smaa_failed_width_ = width;
+      swap_smaa_failed_height_ = height;
+    }
+  }
+  return swap_smaa::UseSmaa(asked, width, height,
+                            swap_smaa_targets_.framebuffer[1] != VK_NULL_HANDLE);
+}
+
+void VulkanCommandProcessor::RecordSwapSmaaPasses(const SwapEffectsPlan& plan,
+                                                  uint32_t swap_frame_index) {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  const uint32_t width = plan.source_width;
+  const uint32_t height = plan.source_height;
+  const VkImageSubresourceRange range =
+      ui::vulkan::util::InitializeSubresourceRange();
+
+  // The LUTs, once: the staging buffer is freed when this submission is
+  // completed (the command processor's destroy queues).
+  if (!swap_smaa_luts_uploaded_) {
+    for (VkImage lut : {swap_smaa_area_image_, swap_smaa_search_image_}) {
+      PushImageMemoryBarrier(lut, range, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                             VK_PIPELINE_STAGE_TRANSFER_BIT, 0,
+                             VK_ACCESS_TRANSFER_WRITE_BIT,
+                             VK_IMAGE_LAYOUT_UNDEFINED,
+                             VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+    }
+    SubmitBarriers(true);
+    VkBufferImageCopy copy = {};
+    copy.bufferOffset = 0;
+    copy.imageSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    copy.imageSubresource.layerCount = 1;
+    copy.imageExtent.width = swap_smaa::kAreaTexWidth;
+    copy.imageExtent.height = swap_smaa::kAreaTexHeight;
+    copy.imageExtent.depth = 1;
+    deferred_command_buffer_.CmdVkCopyBufferToImage(
+        swap_smaa_staging_buffer_, swap_smaa_area_image_,
+        VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &copy);
+    copy.bufferOffset = swap_smaa::kSearchTexStagingOffset;
+    copy.imageExtent.width = swap_smaa::kSearchTexWidth;
+    copy.imageExtent.height = swap_smaa::kSearchTexHeight;
+    deferred_command_buffer_.CmdVkCopyBufferToImage(
+        swap_smaa_staging_buffer_, swap_smaa_search_image_,
+        VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &copy);
+    for (VkImage lut : {swap_smaa_area_image_, swap_smaa_search_image_}) {
+      PushImageMemoryBarrier(lut, range, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                             VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT,
+                             VK_ACCESS_TRANSFER_WRITE_BIT,
+                             VK_ACCESS_SHADER_READ_BIT,
+                             VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                             VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+    }
+    destroy_buffers_.emplace_back(GetCurrentSubmission(),
+                                  swap_smaa_staging_buffer_);
+    destroy_memory_.emplace_back(GetCurrentSubmission(),
+                                 swap_smaa_staging_memory_);
+    swap_smaa_staging_buffer_ = VK_NULL_HANDLE;
+    swap_smaa_staging_memory_ = VK_NULL_HANDLE;
+    swap_smaa_luts_uploaded_ = true;
+  }
+
+  // The previous SMAA swap's passes read the targets; their contents are not
+  // kept (the render passes clear them: the edges pass discards pixels
+  // without an edge).
+  for (VkImage target : swap_smaa_targets_.image) {
+    PushImageMemoryBarrier(target, range, VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT,
+                           VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+                           VK_ACCESS_SHADER_READ_BIT,
+                           VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT,
+                           VK_IMAGE_LAYOUT_UNDEFINED,
+                           VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
+  }
+  SubmitBarriers(true);
+  swap_smaa_targets_.last_submission = GetCurrentSubmission();
+
+  // This frame's sets: the edges pass reads the intermediate image through fix
+  // 137's set, the weights pass the edges and the LUTs, the blend pass (in the
+  // swap render pass) the intermediate image and the weights.
+  VkDescriptorImageInfo image_infos[6];
+  const VkImageView views[6] = {
+      swap_fxaa_source_.view,       swap_smaa_targets_.view[0],
+      swap_smaa_area_view_,         swap_smaa_search_view_,
+      swap_fxaa_source_.view,       swap_smaa_targets_.view[1]};
+  for (uint32_t i = 0; i < 6; ++i) {
+    image_infos[i].sampler = VK_NULL_HANDLE;  // Immutable.
+    image_infos[i].imageView = views[i];
+    image_infos[i].imageLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+  }
+  const VkDescriptorSet edges_set = swap_fxaa_descriptor_sets_[swap_frame_index];
+  const VkDescriptorSet weights_set = swap_smaa_weight_sets_[swap_frame_index];
+  const VkDescriptorSet blend_set = swap_smaa_blend_sets_[swap_frame_index];
+  VkWriteDescriptorSet writes[3];
+  const VkDescriptorSet write_sets[3] = {edges_set, weights_set, blend_set};
+  const uint32_t write_first[3] = {0, 1, 4};
+  const uint32_t write_count[3] = {1, 3, 2};
+  for (uint32_t i = 0; i < 3; ++i) {
+    writes[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+    writes[i].pNext = nullptr;
+    writes[i].dstSet = write_sets[i];
+    writes[i].dstBinding = 0;
+    writes[i].dstArrayElement = 0;
+    writes[i].descriptorCount = write_count[i];
+    writes[i].descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+    writes[i].pImageInfo = &image_infos[write_first[i]];
+    writes[i].pBufferInfo = nullptr;
+    writes[i].pTexelBufferView = nullptr;
+  }
+  dfn.vkUpdateDescriptorSets(device, 3, writes, 0, nullptr);
+
+  const swap_effects::PushConstants push_constants =
+      swap_effects::MakePushConstants(width, height,
+                                      swap_effects::Crop(width, height, 0),
+                                      swap_effects::ColorPreset::kOff);
+  VkViewport viewport;
+  viewport.x = 0.0f;
+  viewport.y = 0.0f;
+  viewport.width = float(width);
+  viewport.height = float(height);
+  viewport.minDepth = 0.0f;
+  viewport.maxDepth = 1.0f;
+  VkRect2D scissor;
+  scissor.offset.x = 0;
+  scissor.offset.y = 0;
+  scissor.extent.width = width;
+  scissor.extent.height = height;
+
+  struct SmaaPass {
+    VkRenderPass render_pass;
+    VkFramebuffer framebuffer;
+    VkPipeline pipeline;
+    VkPipelineLayout layout;
+    VkDescriptorSet set;
+    VkImage target;
+  };
+  const SmaaPass passes[2] = {
+      {swap_smaa_edges_render_pass_, swap_smaa_targets_.framebuffer[0],
+       swap_smaa_edges_pipeline_, swap_fxaa_pipeline_layout_, edges_set,
+       swap_smaa_targets_.image[0]},
+      {swap_smaa_weights_render_pass_, swap_smaa_targets_.framebuffer[1],
+       swap_smaa_weights_pipeline_, swap_smaa_weight_pipeline_layout_,
+       weights_set, swap_smaa_targets_.image[1]},
+  };
+  for (const SmaaPass& pass : passes) {
+    VkClearValue clear_value = {};
+    VkRenderPassBeginInfo render_pass_begin_info;
+    render_pass_begin_info.sType = VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO;
+    render_pass_begin_info.pNext = nullptr;
+    render_pass_begin_info.renderPass = pass.render_pass;
+    render_pass_begin_info.framebuffer = pass.framebuffer;
+    render_pass_begin_info.renderArea.offset.x = 0;
+    render_pass_begin_info.renderArea.offset.y = 0;
+    render_pass_begin_info.renderArea.extent.width = width;
+    render_pass_begin_info.renderArea.extent.height = height;
+    render_pass_begin_info.clearValueCount = 1;
+    render_pass_begin_info.pClearValues = &clear_value;
+    deferred_command_buffer_.CmdVkBeginRenderPass(&render_pass_begin_info,
+                                                  VK_SUBPASS_CONTENTS_INLINE);
+    current_render_pass_ = pass.render_pass;
+    current_framebuffer_ = nullptr;  // Not a render target cache framebuffer
+    SetViewport(viewport);
+    SetScissor(scissor);
+    BindExternalGraphicsPipeline(pass.pipeline);
+    deferred_command_buffer_.CmdVkBindDescriptorSets(
+        VK_PIPELINE_BIND_POINT_GRAPHICS, pass.layout, 0, 1, &pass.set, 0,
+        nullptr);
+    deferred_command_buffer_.CmdVkPushConstants(
+        pass.layout, VK_SHADER_STAGE_FRAGMENT_BIT, 0, sizeof(push_constants),
+        &push_constants);
+    deferred_command_buffer_.CmdVkDraw(3, 1, 0, 0);
+    deferred_command_buffer_.CmdVkEndRenderPass();
+    current_render_pass_ = VK_NULL_HANDLE;
+    // The next pass samples it.
+    PushImageMemoryBarrier(pass.target, range,
+                           VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+                           VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT,
+                           VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT,
+                           VK_ACCESS_SHADER_READ_BIT,
+                           VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
+                           VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+    SubmitBarriers(true);
+  }
+}
+
+void VulkanCommandProcessor::ShutdownSwapSmaa() {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  DestroyRetiredSwapSmaaTargets(true);
+  DestroySwapSmaaTargets(swap_smaa_targets_);
+  swap_smaa_targets_ = SwapSmaaTargets();
+  for (VkPipeline* pipeline :
+       {&swap_smaa_edges_pipeline_, &swap_smaa_weights_pipeline_,
+        &swap_smaa_blend_pipeline_}) {
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyPipeline, device,
+                                           *pipeline);
+  }
+  // Frees the descriptor sets.
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyDescriptorPool, device,
+                                         swap_smaa_descriptor_pool_);
+  swap_smaa_weight_sets_.fill(VK_NULL_HANDLE);
+  swap_smaa_blend_sets_.fill(VK_NULL_HANDLE);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyPipelineLayout, device,
+                                         swap_smaa_weight_pipeline_layout_);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyPipelineLayout, device,
+                                         swap_smaa_blend_pipeline_layout_);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyDescriptorSetLayout,
+                                         device, swap_smaa_weight_set_layout_);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyDescriptorSetLayout,
+                                         device, swap_smaa_blend_set_layout_);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyRenderPass, device,
+                                         swap_smaa_edges_render_pass_);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyRenderPass, device,
+                                         swap_smaa_weights_render_pass_);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyImageView, device,
+                                         swap_smaa_area_view_);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyImageView, device,
+                                         swap_smaa_search_view_);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyImage, device,
+                                         swap_smaa_area_image_);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyImage, device,
+                                         swap_smaa_search_image_);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkFreeMemory, device,
+                                         swap_smaa_area_memory_);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkFreeMemory, device,
+                                         swap_smaa_search_memory_);
+  // Not uploaded yet: nothing in flight uses it.
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyBuffer, device,
+                                         swap_smaa_staging_buffer_);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkFreeMemory, device,
+                                         swap_smaa_staging_memory_);
+  swap_smaa_luts_uploaded_ = false;
+  swap_smaa_state_ = 0;
+  swap_smaa_failed_width_ = 0;
+  swap_smaa_failed_height_ = 0;
+}
