+  // The three pipelines: edges and weights into their targets, the blend
+  // into the guest output image (the swap framebuffers).
+  if (created) {
+    VkShaderModule vertex = ui::vulkan::util::CreateShaderModule(
+        vulkan_device, shaders::fullscreen_cw_vs,
+        sizeof(shaders::fullscreen_cw_vs));
+    VkShaderModule edge = ui::vulkan::util::CreateShaderModule(
+        vulkan_device, shaders::smaa_edge_ps, sizeof(shaders::smaa_edge_ps));
+    VkShaderModule weight = ui::vulkan::util::CreateShaderModule(
+        vulkan_device, shaders::smaa_weight_ps,
+        sizeof(shaders::smaa_weight_ps));
+    VkShaderModule blend = ui::vulkan::util::CreateShaderModule(
+        vulkan_device, shaders::smaa_blend_ps, sizeof(shaders::smaa_blend_ps));
+    created = vertex != VK_NULL_HANDLE && edge != VK_NULL_HANDLE &&
+              weight != VK_NULL_HANDLE && blend != VK_NULL_HANDLE;
+    if (created) {
+      swap_smaa_edges_pipeline_ =
+          CreateSwapEffectPipeline(swap_fxaa_pipeline_layout_,
+                                   swap_smaa_edges_render_pass_, vertex, edge);
+      swap_smaa_weights_pipeline_ = CreateSwapEffectPipeline(
+          swap_smaa_weight_pipeline_layout_, swap_smaa_weights_render_pass_,
+          vertex, weight);
+      swap_smaa_blend_pipeline_ = CreateSwapEffectPipeline(
+          swap_smaa_blend_pipeline_layout_, swap_apply_gamma_render_pass_,
+          vertex, blend);
+      created = swap_smaa_edges_pipeline_ != VK_NULL_HANDLE &&
+                swap_smaa_weights_pipeline_ != VK_NULL_HANDLE &&
+                swap_smaa_blend_pipeline_ != VK_NULL_HANDLE;
+    }
+    for (VkShaderModule module : {vertex, edge, weight, blend}) {
+      if (module != VK_NULL_HANDLE) {
+        dfn.vkDestroyShaderModule(device, module, nullptr);
+      }
+    }
+  }
+  if (!created) {
+    XELOGE(
+        "SMAA 1x (fix 145): its pipelines or LUTs were not made; the picture "
+        "goes without anti-aliasing");
+    ShutdownSwapSmaa();
+    return false;
+  }
+  XELOGW(
+      "SMAA 1x (fix 145): pipelines made; AreaTex {}x{} R8G8_UNORM and "
+      "SearchTex {}x{} R8_UNORM, {} KiB allocated",
+      swap_smaa::kAreaTexWidth, swap_smaa::kAreaTexHeight,
+      swap_smaa::kSearchTexWidth, swap_smaa::kSearchTexHeight,
+      lut_bytes / 1024);
+  return true;
+}
