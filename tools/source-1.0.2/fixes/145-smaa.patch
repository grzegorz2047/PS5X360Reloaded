diff --git a/.deps/xenia-canary/src/xenia/gpu/vulkan/swap_smaa.h b/.deps/xenia-canary/src/xenia/gpu/vulkan/swap_smaa.h
new file mode 100644
index 0000000..ef040b4
--- /dev/null
+++ b/.deps/xenia-canary/src/xenia/gpu/vulkan/swap_smaa.h
@@ -0,0 +1,117 @@
+// SPDX-License-Identifier: MIT
+// Xbox360PS5 (fix 145, GFX-03): SMAA 1x in the Vulkan swap, the decisions and sizes without Vulkan
+// (host-checked by tools/check-swap-smaa.cpp).
+//
+// The launcher's "antialiasing" gets a fourth choice, 3 SMAA 1x (0-2 stay Off, FXAA, FXAA Extreme),
+// the core's SwapPostEffect::kSmaa1x. On fix 137/141's effect path (swap_effects.h), SMAA replaces
+// FXAA in the AA slot of the presentation order (the game's gamma ramp -> at most one AA mode ->
+// the colour preset and the overscan crop -> the presenter's scaling -> the emulator's UI):
+//   1. apply_gamma_*_fxaa_luma.ps into the intermediate image (fix 137's pass), the front buffer's
+//      size, RGB after the gamma ramp (the luma domain SMAA's edge detection expects);
+//   2. smaa_edge.ps: SMAALumaEdgeDetectionPS into the edges image (R8G8_UNORM, cleared: the pass
+//      discards pixels without an edge);
+//   3. smaa_weight.ps: SMAABlendingWeightCalculationPS with AreaTex (160x560 R8G8_UNORM) and
+//      SearchTex (64x16 R8_UNORM) into the weights image (R8G8B8A8_UNORM, cleared);
+//   4. smaa_blend.ps (swap_post.glsli): SMAANeighborhoodBlendingPS from the intermediate image and
+//      the weights at the crop's corner into the guest output image, then the colour preset.
+// iryoku/smaa 71c806a (MIT): SMAA.hlsl, AreaTex.h and SearchTex.h in third_party/smaa, byte for
+// byte. Every sampler is linear clamp-to-edge (the upstream contract). Vulkan's texture and
+// framebuffer origin is the top left, as Direct3D's, so the LUTs are uploaded as the headers store
+// them (row 0 at v = 0), no Y flip; SMAA_AREATEX_SELECT is .rg (R8G8). The images and the LUTs are
+// made on the first SMAA swap only; anything missing (formats, memory, pipelines) draws the effect
+// path without AA, as Off.
+#ifndef XENIA_GPU_VULKAN_SWAP_SMAA_H_
+#define XENIA_GPU_VULKAN_SWAP_SMAA_H_
+
+#include <cstdint>
+
+namespace xe {
+namespace gpu {
+namespace swap_smaa {
+
+// The upstream LUTs (AreaTex.h, SearchTex.h).
+constexpr uint32_t kAreaTexWidth = 160;
+constexpr uint32_t kAreaTexHeight = 560;
+constexpr uint32_t kAreaTexPitch = kAreaTexWidth * 2;  // R8G8
+constexpr uint32_t kAreaTexBytes = kAreaTexPitch * kAreaTexHeight;
+constexpr uint32_t kSearchTexWidth = 64;
+constexpr uint32_t kSearchTexHeight = 16;
+constexpr uint32_t kSearchTexPitch = kSearchTexWidth;  // R8
+constexpr uint32_t kSearchTexBytes = kSearchTexPitch * kSearchTexHeight;
+// One staging buffer: AreaTex, then SearchTex at an offset that keeps a copy's 4-byte alignment.
+constexpr uint32_t kSearchTexStagingOffset = (kAreaTexBytes + 255u) & ~255u;
+constexpr uint32_t kStagingBytes = kSearchTexStagingOffset + kSearchTexBytes;
+
+// Bytes per pixel of the two targets.
+constexpr uint32_t kEdgesBytesPerPixel = 2;    // R8G8_UNORM
+constexpr uint32_t kWeightsBytesPerPixel = 4;  // R8G8B8A8_UNORM
+
+// The raw bytes SMAA adds at a front buffer size (the edges, the weights and the LUTs; the
+// intermediate image is fix 137's, shared with FXAA and the colour preset). The log line reports
+// what the driver actually allocated.
+constexpr uint64_t RawBytes(uint32_t width, uint32_t height) {
+  return uint64_t(width) * height * (kEdgesBytesPerPixel + kWeightsBytesPerPixel) +
+         kAreaTexBytes + kSearchTexBytes;
+}
+
+// Whether a swap draws the SMAA passes: SMAA asked for, a size, and its pipelines, LUTs and
+// targets made. Anything else: the effect path without AA (or the one-pass swap when nothing
+// else is asked for).
+constexpr bool UseSmaa(bool smaa_asked, uint32_t width, uint32_t height, bool resources_ready) {
+  return smaa_asked && width != 0 && height != 0 && resources_ready;
+}
+
+// The targets follow the front buffer's size (1x <-> 2x), like fix 137's intermediate image.
+constexpr bool NeedsNewTargets(uint32_t current_width, uint32_t current_height, uint32_t width,
+                               uint32_t height) {
+  return width != 0 && height != 0 && (current_width != width || current_height != height);
+}
+
+// SMAA_RT_METRICS: (1 / width, 1 / height, width, height), in swap_effects::PushConstants'
+// size_inv and its last two floats.
+struct RtMetrics {
+  float x = 0.0f;
+  float y = 0.0f;
+  float z = 0.0f;
+  float w = 0.0f;
+};
+constexpr RtMetrics MakeRtMetrics(uint32_t width, uint32_t height) {
+  if (!width || !height) return {};
+  return {1.0f / float(width), 1.0f / float(height), float(width), float(height)};
+}
+
+// The passes of an SMAA swap, in order (the model the check runs).
+enum class Pass : uint32_t {
+  kLumaToSource,      // fix 137's pass 1
+  kSourceBarrier,
+  kLutUpload,         // the first SMAA swap only
+  kEdgesClear,        // the edges render pass' clear
+  kEdges,
+  kEdgesBarrier,
+  kWeightsClear,
+  kWeights,
+  kWeightsBarrier,
+  kBlendToOutput,     // in the swap render pass, with the crop and the colour preset
+};
+struct Passes {
+  Pass pass[10];
+  uint32_t count = 0;
+};
+constexpr Passes SmaaPasses(bool luts_uploaded) {
+  Passes passes{};
+  const Pass order[] = {Pass::kLumaToSource, Pass::kSourceBarrier, Pass::kLutUpload,
+                        Pass::kEdgesClear,   Pass::kEdges,         Pass::kEdgesBarrier,
+                        Pass::kWeightsClear, Pass::kWeights,       Pass::kWeightsBarrier,
+                        Pass::kBlendToOutput};
+  for (Pass pass : order) {
+    if (pass == Pass::kLutUpload && luts_uploaded) continue;
+    passes.pass[passes.count++] = pass;
+  }
+  return passes;
+}
+
+}  // namespace swap_smaa
+}  // namespace gpu
+}  // namespace xe
+
+#endif  // XENIA_GPU_VULKAN_SWAP_SMAA_H_
