+bool VulkanCommandProcessor::CreateSwapSmaaResources() {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanInstance::Functions& ifn =
+      vulkan_device->vulkan_instance()->functions();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+
+  // Formats: the targets rendered to and sampled linearly, the LUTs sampled
+  // linearly (all required by Vulkan; checked anyway).
+  constexpr VkFormatFeatureFlags kTargetFeatures =
+      VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BIT |
+      VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT |
+      VK_FORMAT_FEATURE_SAMPLED_IMAGE_FILTER_LINEAR_BIT;
+  constexpr VkFormatFeatureFlags kLutFeatures =
+      VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT |
+      VK_FORMAT_FEATURE_SAMPLED_IMAGE_FILTER_LINEAR_BIT;
+  const std::pair<VkFormat, VkFormatFeatureFlags> kFormats[] = {
+      {VK_FORMAT_R8G8_UNORM, kTargetFeatures},
+      {VK_FORMAT_R8G8B8A8_UNORM, kTargetFeatures},
+      {VK_FORMAT_R8_UNORM, kLutFeatures},
+  };
+  for (const auto& [format, features] : kFormats) {
+    VkFormatProperties properties;
+    ifn.vkGetPhysicalDeviceFormatProperties(vulkan_device->physical_device(),
+                                            format, &properties);
+    if ((properties.optimalTilingFeatures & features) != features) {
+      XELOGE(
+          "SMAA 1x (fix 145): format {} cannot be used; the picture goes "
+          "without anti-aliasing",
+          uint32_t(format));
+      return false;
+    }
+  }
+
+  bool created = true;
+  swap_smaa_edges_render_pass_ =
+      CreateSwapEffectRenderPass(VK_FORMAT_R8G8_UNORM, true);
+  swap_smaa_weights_render_pass_ =
+      CreateSwapEffectRenderPass(VK_FORMAT_R8G8B8A8_UNORM, true);
+  created = swap_smaa_edges_render_pass_ != VK_NULL_HANDLE &&
+            swap_smaa_weights_render_pass_ != VK_NULL_HANDLE;
+
+  // The weights pass: edges, AreaTex, SearchTex; the blend pass: the
+  // intermediate image and the weights. Fix 137's linear clamp-to-edge sampler,
+  // immutable.
+  if (created) {
+    const VkSampler samplers[3] = {swap_fxaa_sampler_, swap_fxaa_sampler_,
+                                   swap_fxaa_sampler_};
+    VkDescriptorSetLayoutBinding bindings[3];
+    for (uint32_t i = 0; i < 3; ++i) {
+      bindings[i].binding = i;
+      bindings[i].descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+      bindings[i].descriptorCount = 1;
+      bindings[i].stageFlags = VK_SHADER_STAGE_FRAGMENT_BIT;
+      bindings[i].pImmutableSamplers = &samplers[i];
+    }
+    VkDescriptorSetLayoutCreateInfo set_layout_create_info = {};
+    set_layout_create_info.sType =
+        VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO;
+    set_layout_create_info.pBindings = bindings;
+    set_layout_create_info.bindingCount = 3;
+    created = dfn.vkCreateDescriptorSetLayout(
+                  device, &set_layout_create_info, nullptr,
+                  &swap_smaa_weight_set_layout_) == VK_SUCCESS;
+    set_layout_create_info.bindingCount = 2;
+    created = created && dfn.vkCreateDescriptorSetLayout(
+                             device, &set_layout_create_info, nullptr,
+                             &swap_smaa_blend_set_layout_) == VK_SUCCESS;
+  }
+  if (created) {
+    VkPushConstantRange push_constant_range;
+    push_constant_range.stageFlags = VK_SHADER_STAGE_FRAGMENT_BIT;
+    push_constant_range.offset = 0;
+    push_constant_range.size = sizeof(swap_effects::PushConstants);
+    VkPipelineLayoutCreateInfo pipeline_layout_create_info = {};
+    pipeline_layout_create_info.sType =
+        VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+    pipeline_layout_create_info.setLayoutCount = 1;
+    pipeline_layout_create_info.pushConstantRangeCount = 1;
+    pipeline_layout_create_info.pPushConstantRanges = &push_constant_range;
+    pipeline_layout_create_info.pSetLayouts = &swap_smaa_weight_set_layout_;
+    created = dfn.vkCreatePipelineLayout(device, &pipeline_layout_create_info,
+                                         nullptr,
+                                         &swap_smaa_weight_pipeline_layout_) ==
+              VK_SUCCESS;
+    pipeline_layout_create_info.pSetLayouts = &swap_smaa_blend_set_layout_;
+    created = created &&
+              dfn.vkCreatePipelineLayout(device, &pipeline_layout_create_info,
+                                         nullptr,
+                                         &swap_smaa_blend_pipeline_layout_) ==
+                  VK_SUCCESS;
+  }
+  // A weights set and a blend set per frame in flight (the edges pass uses
+  // fix 137's set of the frame).
+  if (created) {
+    VkDescriptorPoolSize pool_size;
+    pool_size.type = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+    pool_size.descriptorCount = 5 * kMaxFramesInFlight;
+    VkDescriptorPoolCreateInfo pool_create_info = {};
+    pool_create_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
+    pool_create_info.maxSets = 2 * kMaxFramesInFlight;
+    pool_create_info.poolSizeCount = 1;
+    pool_create_info.pPoolSizes = &pool_size;
+    created = dfn.vkCreateDescriptorPool(device, &pool_create_info, nullptr,
+                                         &swap_smaa_descriptor_pool_) ==
+              VK_SUCCESS;
+  }
+  if (created) {
+    std::array<VkDescriptorSetLayout, kMaxFramesInFlight> set_layouts;
+    VkDescriptorSetAllocateInfo set_allocate_info = {};
+    set_allocate_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
+    set_allocate_info.descriptorPool = swap_smaa_descriptor_pool_;
+    set_allocate_info.descriptorSetCount = uint32_t(set_layouts.size());
+    set_allocate_info.pSetLayouts = set_layouts.data();
+    set_layouts.fill(swap_smaa_weight_set_layout_);
+    created = dfn.vkAllocateDescriptorSets(device, &set_allocate_info,
+                                           swap_smaa_weight_sets_.data()) ==
+              VK_SUCCESS;
+    set_layouts.fill(swap_smaa_blend_set_layout_);
+    created = created && dfn.vkAllocateDescriptorSets(
+                             device, &set_allocate_info,
+                             swap_smaa_blend_sets_.data()) == VK_SUCCESS;
+  }
+
+  // The LUTs, uploaded at the first SMAA swap from one staging buffer, as
+  // AreaTex.h and SearchTex.h store them (row 0 at v = 0: Vulkan's origin is
+  // Direct3D's, no flip).
+  VkDeviceSize lut_bytes = 0;
+  struct Lut {
+    VkFormat format;
+    uint32_t width;
+    uint32_t height;
+    VkImage* image;
+    VkDeviceMemory* memory;
+    VkImageView* view;
+  };
+  const Lut luts[] = {
+      {VK_FORMAT_R8G8_UNORM, swap_smaa::kAreaTexWidth,
+       swap_smaa::kAreaTexHeight, &swap_smaa_area_image_,
+       &swap_smaa_area_memory_, &swap_smaa_area_view_},
+      {VK_FORMAT_R8_UNORM, swap_smaa::kSearchTexWidth,
+       swap_smaa::kSearchTexHeight, &swap_smaa_search_image_,
+       &swap_smaa_search_memory_, &swap_smaa_search_view_},
+  };
+  for (const Lut& lut : luts) {
+    if (!created) {
+      break;
+    }
+    VkImageCreateInfo image_create_info = {};
+    image_create_info.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+    image_create_info.imageType = VK_IMAGE_TYPE_2D;
+    image_create_info.format = lut.format;
+    image_create_info.extent.width = lut.width;
+    image_create_info.extent.height = lut.height;
+    image_create_info.extent.depth = 1;
+    image_create_info.mipLevels = 1;
+    image_create_info.arrayLayers = 1;
+    image_create_info.samples = VK_SAMPLE_COUNT_1_BIT;
+    image_create_info.tiling = VK_IMAGE_TILING_OPTIMAL;
+    image_create_info.usage =
+        VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    image_create_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    image_create_info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    VkDeviceSize memory_size = 0;
+    created = ui::vulkan::util::CreateDedicatedAllocationImage(
+        vulkan_device, image_create_info,
+        ui::vulkan::util::MemoryPurpose::kDeviceLocal, *lut.image,
+        *lut.memory, nullptr, &memory_size);
+    lut_bytes += memory_size;
+    if (created) {
+      VkImageViewCreateInfo view_create_info = {};
+      view_create_info.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO;
+      view_create_info.image = *lut.image;
+      view_create_info.viewType = VK_IMAGE_VIEW_TYPE_2D;
+      view_create_info.format = lut.format;
+      view_create_info.subresourceRange =
+          ui::vulkan::util::InitializeSubresourceRange();
+      created = dfn.vkCreateImageView(device, &view_create_info, nullptr,
+                                      lut.view) == VK_SUCCESS;
+    }
+  }
+  if (created) {
+    uint32_t staging_memory_type = 0;
+    VkDeviceSize staging_memory_size = 0;
+    created = ui::vulkan::util::CreateDedicatedAllocationBuffer(
+        vulkan_device, swap_smaa::kStagingBytes,
+        VK_BUFFER_USAGE_TRANSFER_SRC_BIT,
+        ui::vulkan::util::MemoryPurpose::kUpload, swap_smaa_staging_buffer_,
+        swap_smaa_staging_memory_, &staging_memory_type, &staging_memory_size);
+    void* mapping = nullptr;
+    if (created &&
+        dfn.vkMapMemory(device, swap_smaa_staging_memory_, 0, VK_WHOLE_SIZE, 0,
+                        &mapping) == VK_SUCCESS) {
+      std::memcpy(mapping, areaTexBytes, swap_smaa::kAreaTexBytes);
