--- /dev/null
+++ b/include/xbox360ps5/suspend_count.hpp
@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: MIT
+// Fix 151 (tools/source-1.0.2/fixes/151-suspend-credit-underflow.patch): the guest suspend count
+// (X_KTHREAD::suspend_count, one byte) never wraps.
+//
+// Virtua Tennis 3 (534507E1) froze in a replay on 1.0.5 (issue #61): a job thread slept with a
+// suspend count of 175 and the main thread spun on a job counter only that thread lowers. Its main
+// thread resumes a worker in bursts (13-20 resumes in the same millisecond). With fix 71's credit:
+// resume A finds 0 and leaves a credit; the worker raises its count 0->1 (without the lock); resume B
+// finds 1 and lowers it to 0; the worker then takes A's credit and lowered the count again: 0 -> 255.
+// From then on every resume only drained the count, and the worker's next suspension of itself
+// needed about 255 resumes to end. Every change to the count now goes through Raise or Lower, which
+// stop at the byte's ends instead of wrapping.
+#pragma once
+#include <atomic>
+#include <cstdint>
+
+namespace xbox360ps5::suspend_count {
+
+inline constexpr uint8_t kMax = 0xFF;
+// The console's answer to a suspension of a thread whose count is at its limit.
+inline constexpr uint32_t kStatusSuspendCountExceeded = 0xC000004A;
+
+// Raises the count by one unless it is at kMax; returns the count before (kMax: not raised).
+inline uint8_t Raise(std::atomic<uint8_t>& count) {
+  uint8_t previous = count.load();
+  while (previous != kMax && !count.compare_exchange_weak(previous, uint8_t(previous + 1))) {
+  }
+  return previous;
+}
+
+// Lowers the count by one unless it is 0; returns the count before (0: not lowered).
+inline uint8_t Lower(std::atomic<uint8_t>& count) {
+  uint8_t previous = count.load();
+  while (previous != 0 && !count.compare_exchange_weak(previous, uint8_t(previous - 1))) {
+  }
+  return previous;
+}
+
+}  // namespace xbox360ps5::suspend_count
