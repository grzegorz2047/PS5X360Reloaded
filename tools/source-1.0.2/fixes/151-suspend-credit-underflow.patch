+// Fix 151: a suspension refused because the thread's count is at its limit (255); it would have
+// wrapped to 0 before. The first kRawLines, then none (the STALL report shows the count).
+inline std::atomic<uint64_t> count_limit_hits{0};
+inline std::string CountLimitLine(uint32_t target, const char* what) {
+  const uint64_t n = count_limit_hits.fetch_add(1, std::memory_order_relaxed) + 1;
+  if (n > kRawLines) return std::string();
+  char text[200];
+  std::snprintf(text, sizeof(text),
+                "Suspend: %s of %08X refused: its suspend count is at its limit, 255 (fix 151, #%llu)", what,
+                target, (unsigned long long)n);
+  return text;
+}
+
 }  // namespace xbox360ps5::suspend_trace
