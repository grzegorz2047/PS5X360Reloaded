+// Xbox360PS5, fix 184: the games that get fix 142i's delivery of fast readback copies and fix
+// 157's reader wait while both are off in the settings (their defaults) and readback-deliver.txt
+// does not say otherwise.
+//
+// The Sims 3 (454108E2), 1.0.6-work-fix157, live mode, readback Fast and memory_boost from its
+// preset (fixes 122, 123), switched live every 90 s between "old" and these values:
+// - GPU-thread resolve readback waits: 156 ms/s (154-159) under old, 0 with the preset values;
+// - swaps: 19.7 a second under old, 27.9 (27.8-29.0) with them, at the same or heavier scenes;
+// - reader waits: 2.5-5.0 ms on average, 13.3 ms at most in steady windows, no timeouts;
+// - no black faces at a distance, no empty household portrait, no stutter.
+// Tekken Tag Tournament 2 gained nothing (about 1 ms/s of waits to begin with) and is not listed.
+// Every other game: no preset, as before.
+
+#ifndef XENIA_GPU_VULKAN_READBACK_DELIVER_PRESET_H_
+#define XENIA_GPU_VULKAN_READBACK_DELIVER_PRESET_H_
+
+#include <cstdint>
+
+namespace xbox360ps5 {
+namespace readback_deliver_preset {
+
+// The values of readback-deliver.txt's words: "on"/"off", "wait-below <KiB>",
+// "wait-after-early on|off", "reader-wait on|off", "reader-wait-ms <n>".
+struct Values {
+  bool on = false;
+  uint32_t wait_below_kib = 64;
+  bool wait_after_early = true;
+  bool reader_wait = false;
+  uint32_t reader_wait_ms = 20;
+};
+
+// The game's preset, if it has one.
+inline bool For(uint32_t title_id, Values* out) {
+  switch (title_id) {
+    case 0x454108E2:  // The Sims 3
+      out->on = true;
+      out->wait_below_kib = 0;
+      out->wait_after_early = false;
+      out->reader_wait = true;
+      out->reader_wait_ms = 20;
+      return true;
+    default:
+      return false;
+  }
+}
+
+// Whether the preset takes the place of the settings' values: only while fix 142i's
+// (readback_deliver_when_done) and fix 157's (readback_reader_wait) switches are both off in the
+// settings, so a player who set either keeps all of the settings' values. readback-deliver.txt's
+// words are read after this and win over both.
+inline bool Applies(uint32_t title_id, bool settings_on, bool settings_reader_wait,
+                    Values* out) {
+  if (settings_on || settings_reader_wait) return false;
+  return For(title_id, out);
+}
+
+// The settings line's "from".
+inline const char* From(uint32_t title_id) {
+  switch (title_id) {
+    case 0x454108E2:
+      return "the preset for The Sims 3, 454108E2 (fix 184)";
+    default:
+      return "the settings";
+  }
+}
+
+}  // namespace readback_deliver_preset
+}  // namespace xbox360ps5
+
+#endif  // XENIA_GPU_VULKAN_READBACK_DELIVER_PRESET_H_
