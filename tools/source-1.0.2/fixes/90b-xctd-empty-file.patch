@@ -41,6 +41,16 @@ inline uint32_t Answer(const uint8_t* bytes, size_t size) {
   return IsCompressedHeader(bytes, size) ? kCompressed : kNotCompressed;
 }
 
+// Fix 90b: whether the read of the first word lets the query answer. An empty file reads as end
+// of file with nothing read (Kinect Sports creates its replay buffers \CACHE\videobufferN empty
+// and asks about each at once; 1.0.5-work-fix119 logged "cannot be read" for every one): it is
+// shorter than the magic, so not compressed, as Answer has it. Any other failure keeps the old
+// answer (STATUS_INVALID_PARAMETER).
+constexpr uint32_t kStatusSuccess = 0, kStatusEndOfFile = 0xC0000011;
+inline bool HeadRead(uint32_t status, size_t read) {
+  return status == kStatusSuccess || (status == kStatusEndOfFile && read == 0);
+}
+
 // The handles answered "compressed", followed for the log: each with its own budget of lines
