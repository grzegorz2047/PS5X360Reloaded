+// SPDX-License-Identifier: MIT
+// Fix 149: the options in two groups players cannot take for each other (research/option-groups/AUDIT.md).
+//  - Picture and smoothness (category 0, was "Video"): how the finished picture looks or how smoothly
+//    it is shown. The game itself runs the same: its speed, its timing and what it is told do not change.
+//  - Emulation (advanced) (category 1, was "Performance"): how the emulated Xbox 360 behaves for the
+//    game. It can change the game's speed, timing or correctness; it is changed game by game.
+// Why: a player set GTA IV's "Emulated video rate" to 120 Hz in the guide, taking it for the TV's
+// rate. It is the emulated console's vblank clock (cvars::framerate_limit), and some games run fast
+// with it; the TV's rate is "Frame generation output (test)". The guide listed it under Video, next
+// to the picture options, with no help text.
+// The category numbers stay (the other fixes' rows say 0 or 1, a game's file holds keys only): this
+// table moves an option to its group's page, and kOrder is the order the pages are shown in, with
+// Emulation (advanced) last. Every option of the launcher's table has an entry here, and
+// tools/check-option-groups.cpp fails on one without: a new option is given its group when it is added.
+#ifndef XBOX360PS5_OPTION_GROUPS_HPP_
+#define XBOX360PS5_OPTION_GROUPS_HPP_
+
+#include <algorithm>
+#include <iterator>
+#include <string_view>
+#include <vector>
+
+namespace xbox360ps5::option_groups {
+
+enum class Group { picture, emulation, other };
+
+inline constexpr int kPicture = 0;    // kOptionCategories[0]: "Picture and smoothness"
+inline constexpr int kEmulation = 1;  // kOptionCategories[1]: "Emulation (advanced)"
+// The pages in the order they are shown: the launcher's settings, a game's sheet, the guide and the
+// phone page. Audio (2), Controls (3) and System (4) keep their place between the two groups.
+inline constexpr int kOrder[] = {kPicture, 2, 3, 4, kEmulation};
+
+// Where a category is shown (its index in kOrder); -1 (no category: the bug report row) stays -1.
+inline int Position(int category) {
+  for (int n = 0; n < int(std::size(kOrder)); ++n)
+    if (kOrder[n] == category) return n;
+  return -1;
+}
+// Categories in the order they are shown.
+inline void SortByOrder(std::vector<int>& categories) {
+  std::stable_sort(categories.begin(), categories.end(), [](int a, int b) { return Position(a) < Position(b); });
+}
+
+struct Entry {
+  const char* key;
+  Group group;
+  const char* label;  // nullptr: the table's own
+  const char* about;  // nullptr: the table's own
+};
+
+// Labels and help texts players took for the TV's own settings.
+inline constexpr const char* kVideoRateLabel = "Emulated video rate (game clock, not your TV)";
+inline constexpr const char* kVideoRateAbout =
+    "The emulated Xbox 360's own clock: how many times a second it tells the game a new frame is due. It is not your TV's refresh rate (that is Frame generation output, under Picture and smoothness). At 120 Hz some games held at 30 frames go to 60, but others run too fast. A test, game by game.";
+inline constexpr const char* kVsyncLabel = "VSync (emulated, game speed)";
+inline constexpr const char* kVsyncAbout =
+    "The emulated console's vertical sync, not your TV's. On: games show at most 60 frames a second, so games with a 60 FPS patch do not speed up. Off: no cap, and some games run too fast.";
+inline constexpr const char* kResolutionAbout =
+    "The resolution the emulated Xbox 360 reports to the game; it is not your TV's resolution. At 480p or 540p some games draw fewer pixels and run lighter; at 900p or 1080p some draw more (sharper, heavier). Many games ignore it and stay at 720p.";
+
+// Every option of the launcher's table (src/launcher.cpp, Options()), with its group.
+inline constexpr Entry kEntries[] = {
+    // Picture and smoothness: the finished picture only.
+    {"image_filter", Group::picture, nullptr, nullptr},
+    {"antialiasing", Group::picture, nullptr, nullptr},
+    {"color_preset", Group::picture, nullptr, nullptr},
+    {"overscan_crop", Group::picture, nullptr, nullptr},
+    {"sharpness", Group::picture, nullptr, nullptr},
+    {"dither", Group::picture, nullptr, nullptr},
+    {"stretch", Group::picture, nullptr, nullptr},
+    {"anisotropic", Group::picture, nullptr, nullptr},
+    {"present_limit", Group::picture, nullptr, nullptr},  // fix 146, when it is in the tree
+    {"draw_scale", Group::picture, nullptr, nullptr},
+    // Emulation (advanced): what the game is told, its clock, and how faithfully it is emulated.
+    {"renderer", Group::emulation, nullptr, nullptr},
+    {"internal_resolution", Group::emulation, nullptr, kResolutionAbout},
+    {"video_clock", Group::emulation, kVideoRateLabel, kVideoRateAbout},
+    {"vsync", Group::emulation, kVsyncLabel, kVsyncAbout},
+    {"gamma", Group::emulation, nullptr, nullptr},
+    {"depth_precision", Group::emulation, nullptr, nullptr},
+    {"decal_bias", Group::emulation, nullptr, nullptr},
+    {"mulsc", Group::emulation, nullptr, nullptr},
+    {"fast_locks", Group::emulation, nullptr, nullptr},
+    {"memory_boost", Group::emulation, nullptr, nullptr},
+    {"dynamic_buffers", Group::emulation, nullptr, nullptr},
+    {"memory_window", Group::emulation, nullptr, nullptr},
+    {"occlusion", Group::emulation, nullptr, nullptr},
+    {"readback", Group::emulation, nullptr, nullptr},
+    {"memexport", Group::emulation, nullptr, nullptr},
+    {"async_shaders", Group::emulation, nullptr, nullptr},
+    {"clear_pages", Group::emulation, nullptr, nullptr},
+    {"released_memory", Group::emulation, nullptr, nullptr},
+    {"guest_yield", Group::emulation, nullptr, nullptr},
+    {"threaded_driver", Group::emulation, nullptr, nullptr},
+    {"pipeline_threads", Group::emulation, nullptr, nullptr},
+    {"fast_dot", Group::emulation, nullptr, nullptr},
+    {"no_promotion", Group::emulation, nullptr, nullptr},
+    {"zero_page", Group::emulation, nullptr, nullptr},
+    {"fsi", Group::emulation, nullptr, nullptr},
+    // Neither: sound, controls and the system stay on their own pages. The two sound decoder options
+    // and the Arcade licence are emulation by nature, but are read only as a game starts (the guide
+    // never shows them) and players look for them there.
+    {"mute", Group::other, nullptr, nullptr},
+    {"volume", Group::other, nullptr, nullptr},
+    {"ui_sounds", Group::other, nullptr, nullptr},
+    {"ui_sound_volume", Group::other, nullptr, nullptr},
+    {"xma_decoder", Group::other, nullptr, nullptr},
+    {"xma_inline", Group::other, nullptr, nullptr},
+    {"touchpad_menu", Group::other, nullptr, nullptr},
+    {"vibration", Group::other, nullptr, nullptr},
+    {"deadzone_left", Group::other, nullptr, nullptr},
+    {"deadzone_right", Group::other, nullptr, nullptr},
+    {"motion_phone", Group::other, nullptr, nullptr},
+    {"motion_panel", Group::other, nullptr, nullptr},
+    {"motion_picture", Group::other, nullptr, nullptr},
+    {"show_fps", Group::other, nullptr, nullptr},
+    {"achievement_toasts", Group::other, nullptr, nullptr},
+    {"web_page", Group::other, nullptr, nullptr},
+    {"arcade_full", Group::other, nullptr, nullptr},
+    {"save_drive", Group::other, nullptr, nullptr},
+    {"detailed_logs", Group::other, nullptr, nullptr},
+    {"bug_report", Group::other, nullptr, nullptr},
+};
+
+inline const Entry* Find(std::string_view key) {
+  for (const Entry& entry : kEntries)
+    if (key == entry.key) return &entry;
+  return nullptr;
+}
+// The page an option is shown on: its group's, or for the others (and an option this table does not
+// know) the one its row gives.
+inline int Category(std::string_view key, int table_category) {
+  const Entry* entry = Find(key);
+  if (!entry || entry->group == Group::other) return table_category;
+  return entry->group == Group::picture ? kPicture : kEmulation;
+}
+inline const char* Label(std::string_view key, const char* table_label) {
+  const Entry* entry = Find(key);
+  return entry && entry->label ? entry->label : table_label;
+}
+inline const char* About(std::string_view key, const char* table_about) {
+  const Entry* entry = Find(key);
+  return entry && entry->about ? entry->about : table_about;
+}
+
+// The guide (src/canary_game_main.cpp). On the Emulation (advanced) page, a notice is its first row
+// (the focus lands on it as the page opens); after one of its options is changed, kChanged is shown
+// over the list's bottom for kChangedSeconds.
+inline constexpr const char* kGuideNotice =
+    "These change how the emulated Xbox 360 runs this game, not your TV. They can make it run too fast, too slow or wrong. Changes are kept for this game.";
+inline constexpr const char* kGuideChanged =
+    "Changed for this game only. If it now runs too fast, too slow or looks wrong, set it back.";
+inline constexpr float kChangedSeconds = 8.0f;
+// The time left for kGuideChanged after a frame of `dt` seconds.
+inline float ChangedLeft(float left, float dt) { return left > dt ? left - dt : 0.0f; }
+
+}  // namespace xbox360ps5::option_groups
+
+#endif  // XBOX360PS5_OPTION_GROUPS_HPP_
