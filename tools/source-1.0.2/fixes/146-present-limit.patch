diff --git a/include/xbox360ps5/present_limit.hpp b/include/xbox360ps5/present_limit.hpp
new file mode 100644
--- /dev/null
+++ b/include/xbox360ps5/present_limit.hpp
@@ -0,0 +1,292 @@
+// SPDX-License-Identifier: MIT
+// Fix 146 (GFX-02A): a limit on how often the game's new pictures are shown, on the presentation
+// side only (research/fps-limit/DESIGN.md).
+//
+// Three clocks are separate here. The emulated console's vblank (the "GPU Frame limiter" thread,
+// 60 or 120 Hz from the Emulated video rate option) is what the game paces itself by; fix 116
+// sleeps a game's VdSwap only when its own swaps come faster than that vblank. Each swap that
+// reaches the presenter makes its picture the "ready" one of a mailbox of three images
+// (Presenter::RefreshGuestOutput) and never waits for the screen. The screen (VK_KHR_display at
+// 59.94 or 119.88 Hz, FIFO) takes the newest ready picture at each paint of the UI thread
+// (Presenter::ConsumeGuestOutput) and shows the one it holds until it takes another.
+//
+// The limit decides only that last step: while it holds, the paint shows the picture it already
+// has, and the game's next pictures replace one another in the mailbox as they do today when the
+// game is faster than the screen. Nothing sleeps for it and the game is never made to wait, so
+// the game's clock, its vblanks, fix 116 and the sound are what they were. A picture is held a
+// whole number of output refreshes (30 FPS: 2 at 60 Hz, 4 at 120 Hz; 40 FPS: 3 at 120 Hz;
+// 60 FPS: 1 at 60 Hz, 2 at 120 Hz). 40 FPS is not a whole number of refreshes at 60 Hz, so there
+// it is not applied. Nor is any limit while frame generation is on (it paces its own pictures).
+// Automatic (the default) and No limit both show every picture as before.
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <mutex>
+#include <string>
+
+namespace xbox360ps5 {
+namespace present_limit {
+
+// Settings::present_limit, the launcher's choice.
+enum Choice : int { kAutomatic = 0, kNoLimit = 1, k30 = 2, k40 = 3, k60 = 4, kChoices = 5 };
+
+inline int TargetFps(int choice) {
+  return choice == k30 ? 30 : choice == k40 ? 40 : choice == k60 ? 60 : 0;
+}
+inline const char* ChoiceText(int choice) {
+  return choice == k30 ? "30 FPS" : choice == k40 ? "40 FPS" : choice == k60 ? "60 FPS"
+       : choice == kNoLimit ? "No limit" : "Automatic";
+}
+
+inline int64_t NowNs() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+// The output as the presenter knows it.
+struct Output {
+  double hz = 0;          // the display mode's refresh (VK_KHR_display): 59.94 or 119.88
+  bool fifo = false;      // the swapchain shows each present for at least a whole refresh
+  bool framegen = false;  // frame generation is on
+};
+
+// What a choice does on an output.
+struct Plan {
+  int fps = 0;             // the chosen target (0: none)
+  bool applied = false;    // the limit holds pictures
+  uint32_t refreshes = 0;  // output refreshes per new picture
+  int64_t period_ns = 0;   // their length
+  int64_t slack_ns = 0;    // half a refresh: a paint that wakes a little early is on time
+  const char* reason = "";
+};
+
+inline constexpr double kWholeTolerance = 0.05;  // 59.94 / 30 = 1.998 refreshes is 2
+
+inline Plan MakePlan(int choice, const Output& out) {
+  Plan plan;
+  plan.fps = TargetFps(choice);
+  if (!plan.fps) {
+    plan.reason = choice == kNoLimit ? "no limit chosen" : "Automatic: every picture, as before";
+    return plan;
+  }
+  if (!(out.hz >= 30 && out.hz <= 240)) {
+    plan.reason = "no display refresh known (the Vulkan display output only)";
+    return plan;
+  }
+  if (out.framegen) {
+    plan.reason = "frame generation is on and paces its own pictures";
+    return plan;
+  }
+  const double ratio = out.hz / plan.fps;
+  const double whole = std::round(ratio);
+  if (whole < 1 || std::fabs(ratio - whole) > kWholeTolerance * whole) {
+    plan.reason = "not a whole number of refreshes of this output (40 FPS needs the 120 Hz output)";
+    return plan;
+  }
+  const double refresh_ns = 1e9 / out.hz;
+  plan.applied = true;
+  plan.refreshes = uint32_t(whole);
+  plan.period_ns = int64_t(whole * refresh_ns + 0.5);
+  plan.slack_ns = int64_t(refresh_ns * 0.5);
+  plan.reason = out.fifo ? "each new picture shown for whole refreshes"
+                         : "timed only: the swapchain is not FIFO";
+  return plan;
+}
+
+// The time between new pictures, for the median and the 95th percentile of a report.
+class IntervalHistogram {
+ public:
+  static constexpr int64_t kBinNs = 250000;  // 0.25 ms
+  static constexpr size_t kBins = 400;       // up to 100 ms; longer ones count in the last
+  void Add(int64_t ns) {
+    const size_t bin = ns <= 0 ? 0 : std::min(kBins - 1, size_t(ns / kBinNs));
+    ++bins_[bin];
+    ++count_;
+  }
+  uint64_t count() const { return count_; }
+  // The upper edge of the bin that holds the given share of the intervals, in ms (0: none).
+  double PercentileMs(double share) const {
+    if (!count_) return 0;
+    const uint64_t wanted = std::max<uint64_t>(1, uint64_t(std::ceil(share * double(count_))));
+    uint64_t seen = 0;
+    for (size_t i = 0; i < kBins; ++i) {
+      seen += bins_[i];
+      if (seen >= wanted) return double((i + 1) * kBinNs) / 1e6;
+    }
+    return double(kBins * kBinNs) / 1e6;
+  }
+  void Clear() {
+    bins_.fill(0);
+    count_ = 0;
+  }
+
+ private:
+  std::array<uint32_t, kBins> bins_{};
+  uint64_t count_ = 0;
+};
+
+class Gate {
+ public:
+  static constexpr int64_t kPauseNs = 250000000;    // no new picture for longer: start again
+  static constexpr int64_t kReportNs = 30000000000;  // the summary line, every 30 s
+
+  // The launcher's choice (Settings::Apply, any thread, also from the guide while a game runs).
+  void SetChoice(int choice) {
+    choice_.store(choice >= 0 && choice < kChoices ? choice : kAutomatic, std::memory_order_relaxed);
+  }
+  int choice() const { return choice_.load(std::memory_order_relaxed); }
+  // The display mode the presenter got (at the surface's creation).
+  void SetOutputHz(double hz) { output_hz_.store(hz, std::memory_order_relaxed); }
+
+  // The producer (Presenter::RefreshGuestOutput): a new picture of the game is ready.
+  void NoteRefresh(int64_t now) {
+    refreshes_.fetch_add(1, std::memory_order_relaxed);
+    last_arrival_.store(now, std::memory_order_relaxed);
+  }
+
+  // The consumer (Presenter::ConsumeGuestOutput, under the mailbox's consumer lock), when a
+  // newer picture than the one it holds is ready: whether it takes it now. `current_active`:
+  // the picture it holds has content (a blank output is always replaced at once).
+  bool Take(int64_t now, bool current_active) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    const int64_t arrival = last_arrival_.load(std::memory_order_relaxed);
+    if (!plan_.applied || !current_active || !deadline_ ||
+        (last_taken_ && now - last_taken_ > kPauseNs)) {
+      // No limit, nothing shown yet, or after a pause: show it now and start the grid here.
+      deadline_ = plan_.applied ? now + plan_.period_ns : 0;
+      Taken(now, arrival);
+      return true;
+    }
+    if (now + plan_.slack_ns >= deadline_) {
+      // On time (within half a refresh of the grid) keeps the grid; later, because the game's
+      // picture came late, starts it again from now: no short picture to catch up.
+      deadline_ = now - deadline_ <= plan_.slack_ns ? deadline_ + plan_.period_ns
+                                                    : now + plan_.period_ns;
+      Taken(now, arrival);
+      return true;
+    }
+    ++held_;
+    return false;
+  }
+
+  // Once per paint of the presenter: the output as it is now and the emulated vblanks so far
+  // (ps5x360::framegen::source_ticks). Returns how many log lines it wrote to `lines`: one when
+  // the choice or what it does changed, one every 30 s with what happened.
+  int NotePaint(int64_t now, bool fifo, bool framegen, uint64_t vblanks, std::string lines[2]) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    int count = 0;
+    ++paints_;
+    const int choice = choice_.load(std::memory_order_relaxed);
+    Output out;
+    out.hz = output_hz_.load(std::memory_order_relaxed);
+    out.fifo = fifo;
+    out.framegen = framegen;
+    const Plan plan = MakePlan(choice, out);
+    // (30 FPS is 4 refreshes at 119.88 Hz and 2 at 59.94 Hz: the same period, a new output.)
+    if (!planned_ || choice != plan_choice_ || plan.applied != plan_.applied ||
+        plan.refreshes != plan_.refreshes || plan.period_ns != plan_.period_ns ||
+        plan.reason != plan_.reason) {
+      const bool announce = planned_ || plan.fps;  // a first Automatic is not news
+      planned_ = true;
+      plan_choice_ = choice;
+      plan_ = plan;
+      deadline_ = 0;
+      if (announce) lines[count++] = PlanLine(choice, out);
+    }
+    if (!report_at_) {
+      StartWindow(now, vblanks);
+    } else if (now - report_at_ >= kReportNs) {
+      lines[count++] = ReportLine(now, out, vblanks);
+      StartWindow(now, vblanks);
+    }
+    return count;
+  }
+
+  // For the host check.
+  const Plan& plan() const { return plan_; }
+  uint64_t taken() const { return taken_; }
+  uint64_t held() const { return held_; }
+
+ private:
+  void Taken(int64_t now, int64_t arrival) {
+    ++taken_;
+    if (arrival && now >= arrival) waited_ns_ += uint64_t(now - arrival);
+    if (last_taken_ && now - last_taken_ <= kPauseNs) intervals_.Add(now - last_taken_);
+    last_taken_ = now;
+  }
+  void StartWindow(int64_t now, uint64_t vblanks) {
+    report_at_ = now;
+    window_ = {paints_, taken_, held_, waited_ns_, refreshes_.load(std::memory_order_relaxed),
+               vblanks};
+    intervals_.Clear();
+  }
+  std::string PlanLine(int choice, const Output& out) const {
+    char text[320];
+    if (plan_.applied)
+      std::snprintf(text, sizeof(text),
+                    "Presentation limit (fix 146): %s chosen; applied: each new picture shown "
+                    "for %u refreshes of %.2f Hz%s (the game runs as before)",
+                    ChoiceText(choice), plan_.refreshes, out.hz, out.fifo ? " (FIFO)" : " (not FIFO)");
+    else
+      std::snprintf(text, sizeof(text), "Presentation limit (fix 146): %s chosen; not applied: %s",
+                    ChoiceText(choice), plan_.reason);
+    return text;
+  }
+  std::string ReportLine(int64_t now, const Output& out, uint64_t vblanks) const {
+    const double seconds = double(now - report_at_) / 1e9;
+    const uint64_t paints = paints_ - window_.paints, taken = taken_ - window_.taken;
+    const uint64_t held = held_ - window_.held;
+    const uint64_t arrived = refreshes_.load(std::memory_order_relaxed) - window_.refreshes;
+    const double waited_ms = double(waited_ns_ - window_.waited_ns) / 1e6;
+    char target[96];
+    if (plan_.applied)
+      std::snprintf(target, sizeof(target), "target %d FPS (%u refreshes of %.2f Hz)", plan_.fps,
+                    plan_.refreshes, out.hz);
+    else
+      std::snprintf(target, sizeof(target), "%s, not applied", ChoiceText(plan_choice_));
+    char text[512];
+    std::snprintf(text, sizeof(text),
+                  "Presentation limit (fix 146): %s; %.1f new pictures/s of %.1f game swaps/s, "
+                  "%.1f presents/s, %.1f vblanks/s; held %.1f/s, repeated %.1f/s, dropped %.1f/s; "
+                  "waited %.1f ms/s (%.1f ms a picture); interval median %.2f ms, p95 %.2f ms",
+                  target, double(taken) / seconds, double(arrived) / seconds,
+                  double(paints) / seconds, double(vblanks - window_.vblanks) / seconds,
+                  double(held) / seconds,
+                  double(paints > taken ? paints - taken : 0) / seconds,
+                  double(arrived > taken ? arrived - taken : 0) / seconds, waited_ms / seconds,
+                  taken ? waited_ms / double(taken) : 0.0, intervals_.PercentileMs(0.5),
+                  intervals_.PercentileMs(0.95));
+    return text;
+  }
+
+  std::atomic<int> choice_{kAutomatic};
+  std::atomic<double> output_hz_{0};
+  std::atomic<uint64_t> refreshes_{0};
+  std::atomic<int64_t> last_arrival_{0};
+  std::mutex mutex_;
+  Plan plan_;
+  int plan_choice_ = kAutomatic;
+  bool planned_ = false;
+  int64_t deadline_ = 0, last_taken_ = 0, report_at_ = 0;
+  uint64_t paints_ = 0, taken_ = 0, held_ = 0, waited_ns_ = 0;
+  struct Window {
+    uint64_t paints, taken, held, waited_ns, refreshes, vblanks;
+  } window_{};
+  IntervalHistogram intervals_;
+};
+
+// The one the launcher, the presenter and the guide share.
+inline Gate& Instance() {
+  static Gate gate;
+  return gate;
+}
+
+}  // namespace present_limit
+}  // namespace xbox360ps5
