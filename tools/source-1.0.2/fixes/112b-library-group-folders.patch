+// Fix 112b: the key of a group's "N games", with the number's form: "%d game" for one, "%d games||few"
+// for 2-4, 22-24, ... (not 12-14: Polish "3 gry", Russian "3 игры"), "%d games||one" for 21, 31, ...
+// (not 11: Russian "21 игра", Polish "21 gier"), "%d games" for the rest. Each language translates
+// all four; one with two forms gives "few" and "one" its plural.
+inline const char* CountKey(size_t n) {
+  if (n == 1) return "%d game";
+  const size_t ten = n % 10, hundred = n % 100;
+  if (ten >= 2 && ten <= 4 && !(hundred >= 12 && hundred <= 14)) return "%d games||few";
+  if (ten == 1 && hundred != 11) return "%d games||one";
+  return "%d games";
+}
