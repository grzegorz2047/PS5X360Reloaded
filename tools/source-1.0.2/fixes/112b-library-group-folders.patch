+// Fix 112b: a group of games drawn as a folder in the quad q (a case's front on the shelf, the box
+// of an NXE tile): the folder's back with its tab, its front lower and a little lighter, on it up to
+// four of its games' covers (one in the middle, two side by side, three or four in a square), the
+// folder's name at its foot and a badge with the number of games in the corner. No game's cover
+// fills it, so it does not look like a game.
+void DrawGroupFolder(const Launcher::Canvas& c, const std::vector<std::unique_ptr<xe::ui::ImmediateTexture>>& textures,
+                     const std::vector<CoverArt>& arts, const std::vector<int>& covers, size_t games,
+                     const std::string& name, const Quad& q, float light, bool nxe) {
+  ImDrawList* list = c.list;
+  const auto shade = [&](uint32_t rgb, float a = 1.0f) {
+    const float k = std::clamp(light, 0.0f, 1.0f);
+    return IM_COL32(int((rgb >> 16 & 255) * k), int((rgb >> 8 & 255) * k), int((rgb & 255) * k), int(255 * a * c.alpha));
+  };
+  const auto fill = [&](const Quad& p, uint32_t rgb, float a = 1.0f) { list->AddQuadFilled(p.tl, p.tr, p.br, p.bl, shade(rgb, a)); };
+  constexpr uint32_t kFolderBack = 0xb8801f, kFolderFront = 0xe9b246, kFolderEdge = 0xffdc8a, kFolderInk = 0x3a2604;
+  // The back and its tab, then the front.
+  const Quad tab = Part(q, 0.03f, 0.0f, 0.42f, 0.10f);
+  list->AddQuadFilled(tab.tl, Mix(tab.tl, tab.tr, 0.86f), tab.br, tab.bl, shade(kFolderBack));
+  fill(Part(q, 0.0f, 0.06f, 1.0f, 1.0f), kFolderBack);
+  const Quad front = Part(q, 0.0f, 0.14f, 1.0f, 1.0f);
+  fill(front, kFolderFront);
+  list->AddLine(front.tl, front.tr, shade(kFolderEdge, 0.9f), 2.0f * c.scale);
+  list->AddQuad(front.tl, front.tr, front.br, front.bl, shade(0x000000, 0.25f), 1.0f * c.scale);
+  // The covers, in the front's middle: u 0.08-0.92, v 0.22-0.78 of the whole folder.
+  std::vector<int> shown;
+  for (const int cover : covers)
+    if (cover >= 0 && size_t(cover) < textures.size()) shown.push_back(cover);
+  const size_t count = std::min<size_t>(shown.size(), 4);
+  const float u0 = 0.10f, u1 = 0.90f, v0 = 0.22f, v1 = 0.80f, gap = 0.025f;
+  for (size_t i = 0; i < count; ++i) {
+    float a0 = u0, a1 = u1, b0 = v0, b1 = v1;
+    if (count == 1) {
+      a0 = 0.28f; a1 = 0.72f;
+    } else if (count == 2) {
+      const float half = (u0 + u1) / 2;
+      a0 = i == 0 ? u0 : half + gap / 2; a1 = i == 0 ? half - gap / 2 : u1;
+    } else {
+      const float hu = (u0 + u1) / 2, hv = (v0 + v1) / 2;
+      a0 = i % 2 == 0 ? u0 : hu + gap / 2; a1 = i % 2 == 0 ? hu - gap / 2 : u1;
+      b0 = i < 2 ? v0 : hv + gap / 2; b1 = i < 2 ? hv - gap / 2 : v1;
+    }
+    const Quad cell = Part(q, a0, b0, a1, b1);
+    fill(Part(q, a0 + 0.012f, b0 + 0.012f, a1 + 0.012f, b1 + 0.012f), 0x000000, 0.30f);  // a little shadow
+    const CoverArt art = size_t(shown[i]) < arts.size() ? arts[size_t(shown[i])] : CoverArt{};
+    CoverImage(list, reinterpret_cast<ImTextureID>(textures[size_t(shown[i])].get()), cell, art.front_u0, 0, art.front_u1, 1,
+               shade(0xffffff));
+    list->AddQuad(cell.tl, cell.tr, cell.br, cell.bl, shade(0xffffff, 0.55f), 1.0f * c.scale);
+  }
+  if (count == 3) fill(Part(q, (u0 + u1) / 2 + gap / 2, (v0 + v1) / 2 + gap / 2, u1, v1), kFolderBack, 0.55f);
+  if (!count) {
+    // No cover yet: a second sheet peeking out of the folder.
+    fill(Part(q, 0.14f, 0.08f, 0.86f, 0.30f), 0xf4efe2);
+    fill(Part(q, 0.0f, 0.24f, 1.0f, 1.0f), kFolderFront);
+  }
+  // The name at the foot, left of the badge; the badge with the number of games at the right.
+  const ImVec2 foot_l = Part(q, 0.07f, 0.84f, 0.70f, 0.97f).tl, foot_r = Part(q, 0.07f, 0.84f, 0.70f, 0.97f).br;
+  const float height = std::max(8.0f, (foot_r.y - foot_l.y));
+  const float size = std::clamp(height * 0.80f, 8.0f, 30.0f * c.scale);
+  list->PushClipRect(foot_l, foot_r, true);
+  list->AddText(c.Font(std::max(16.0f, size / c.scale)), size, ImVec2(foot_l.x, foot_l.y + (height - size) * 0.35f),
+                shade(kFolderInk), name.c_str());
+  list->PopClipRect();
+  const Quad badge_quad = Part(q, 0.74f, 0.82f, 0.96f, 0.98f);
+  const ImVec2 centre = Mix(Mix(badge_quad.tl, badge_quad.tr, 0.5f), Mix(badge_quad.bl, badge_quad.br, 0.5f), 0.5f);
+  const float radius = std::max(6.0f, std::min(badge_quad.br.x - badge_quad.bl.x, badge_quad.bl.y - badge_quad.tl.y) * 0.55f);
+  list->AddCircleFilled(centre, radius, shade(nxe ? 0x4b9a16 : 0x1d2a14), 28);
+  list->AddCircle(centre, radius, shade(0xffffff, 0.85f), 28, 1.5f * c.scale);
+  const std::string number = games > 99 ? "99+" : std::to_string(games);
+  const float number_size = radius * (number.size() > 2 ? 0.95f : 1.15f);
+  ImFont* font = c.Font(std::max(16.0f, number_size / c.scale));
+  const ImVec2 extent = font->CalcTextSizeA(number_size, 1e9f, 0.0f, number.c_str());
+  list->AddText(font, number_size, ImVec2(centre.x - extent.x / 2, centre.y - extent.y / 2), shade(0xffffff), number.c_str());
+}
