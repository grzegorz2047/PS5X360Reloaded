+// Fix 159: the key of the folder that holds an entry, as Build makes it: its folders below the game
+// folder, lower case, without a package's title ID and content type folders ("" at the top).
+inline std::string HolderKey(const std::vector<std::string>& folders) {
+  std::string key;
+  for (const auto& folder : folders) {
+    if (folder.empty() || PackageFolder(folder)) continue;
+    key += (key.empty() ? "" : "/") + LowerAscii(folder);
+  }
+  return key;
+}
+
+// Fix 159: the key of an entry's disc set for GameKeys: the folder that holds it (HolderKey) and its
+// name without the disc tags (`set_name`, see GameKeys), lower case; "" for an entry with no set name.
+// Entries with one key are discs of one game in one folder; two or more of them are discs fix 89 left
+// as entries of their own (its set is one entry), which the launcher logs.
+inline std::string SetKey(const std::vector<std::string>& folders, const std::string& set_name) {
+  std::string name = LowerAscii(set_name);
+  while (!name.empty() && (name.back() == ' ' || name.back() == '\t')) name.pop_back();
+  return name.empty() ? name : HolderKey(folders) + "\n" + name;
+}
+
+// Fix 159: which game each entry is, for Build's `games`. A player's folder of one game of several
+// discs ("Battlefield 3 (USA, Europe) (En,Fr,De)/... (Disc 1).iso" and "(Disc 2).iso", Final Fantasy
+// XIII's three discs, Grand Theft Auto V's "(Disc 1) (Install)" and "(Disc 2) (Play)") is that game,
+// never a group. Fix 89 makes such discs one entry, so their folder holds one entry; when it could
+// not (a header unread, a title ID of its own on each disc, two regions' discs claiming one number),
+// the discs stay entries of their own, and they were counted as different games when their title
+// IDs differed or were unknown. Two entries are one game when they have one title ID (fix 112d:
+// copies of a game, wherever they are; compared without case, 00000000 is none), or when one folder
+// holds both and their names without the disc tags are one (`set_names`: for an entry whose image or
+// extracted disc folder has a disc number in its name, multidisc::NameWithoutDisc of that name; ""
+// for any other entry; compared without case), the rules of fix 89's sets. The result names each
+// entry's game ("" for an entry that is a game of its own, as Build takes it): a title ID of the
+// game when one of its entries has one, else its folder and name.
+inline std::vector<std::string> GameKeys(const std::vector<std::vector<std::string>>& folders,
+                                         const std::vector<std::string>& titles,
+                                         const std::vector<std::string>& set_names) {
+  const size_t count = folders.size();
+  std::vector<size_t> parent(count);
+  for (size_t n = 0; n < count; ++n) parent[n] = n;
+  const auto find = [&parent](size_t n) {
+    while (parent[n] != n) n = parent[n] = parent[parent[n]];
+    return n;
+  };
+  const auto join = [&](size_t a, size_t b) {
+    a = find(a);
+    b = find(b);
+    if (a != b) parent[std::max(a, b)] = std::min(a, b);
+  };
+  const auto title_of = [&titles](size_t n) {
+    const std::string id = n < titles.size() ? LowerAscii(titles[n]) : std::string();
+    return id == "00000000" ? std::string() : id;
+  };
+  const auto set_of = [&](size_t n) {
+    return n < set_names.size() ? SetKey(folders[n], set_names[n]) : std::string();
+  };
+  std::map<std::string, size_t> by_title, by_set;
+  for (size_t n = 0; n < count; ++n) {
+    if (const std::string id = title_of(n); !id.empty()) {
+      const auto [at, made] = by_title.try_emplace(id, n);
+      if (!made) join(n, at->second);
+    }
+    if (const std::string set = set_of(n); !set.empty()) {
+      const auto [at, made] = by_set.try_emplace(set, n);
+      if (!made) join(n, at->second);
+    }
+  }
+  // Each game's name: its smallest title ID, else the folder and name of its first entry's set.
+  std::map<size_t, std::string> title, set;
+  std::map<size_t, size_t> size;
+  for (size_t n = 0; n < count; ++n) {
+    const size_t root = find(n);
+    ++size[root];
+    const std::string id = title_of(n);
+    if (!id.empty() && (title[root].empty() || id < title[root])) title[root] = id;
+    if (set[root].empty()) set[root] = set_of(n);
+  }
+  std::vector<std::string> keys(count);
+  for (size_t n = 0; n < count; ++n) {
+    const size_t root = find(n);
+    if (!title[root].empty()) keys[n] = "title:" + title[root];
+    else if (size[root] > 1) keys[n] = "set:" + set[root];
+  }
+  return keys;
+}
