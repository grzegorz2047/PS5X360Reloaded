+// Fix 117h: the render targets made at 2x, one line each, at most kKeyLines a session.
+inline constexpr uint32_t kKeyLines = 64;
+inline std::atomic<uint32_t> key_lines{0};
+inline bool TakeKeyLine() { return key_lines.fetch_add(1, std::memory_order_relaxed) < kKeyLines; }
+inline std::string RenderTargetKeyLine(uint32_t host_width, uint32_t host_height, uint32_t pitch_pixels,
+                                       uint32_t base_tiles, uint32_t samples, const char* format, bool depth,
+                                       bool scaled) {
+  char line[260];
+  std::snprintf(line, sizeof(line),
+                "Resolution scale (fix 117h): render target %ux%u, pitch %u px, EDRAM base %u, %uxMSAA, %s %s, %s",
+                host_width, host_height, pitch_pixels, base_tiles, samples ? samples : 1, format ? format : "?",
+                depth ? "depth" : "colour", scaled ? "scaled" : "1x");
+  return line;
+}
