@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: MIT
+// Fix 173: where the time of the exit checkpoint of the Vulkan pipeline cache goes. GTA IV at 2x on
+// 1.0.7-work-integration1 left with "exit checkpoint timed out after 30000 ms" while its utility
+// cache on the drive took 0.95 s to create and 3.8 s to delete a file: the GPU thread (saturated) or
+// the drive (its write budget spent)? The checkpoint now notes each step from the request on -
+// queued, taken by the GPU thread, the snapshot's data read (its write starts), written - and the
+// checkpoint's line gives them in milliseconds, the steps not reached as such. Diagnostics only: the
+// checkpoint does what it did.
+#pragma once
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+namespace xbox360ps5::exit_cache_timing {
+
+enum Step : int { kTaken = 0, kRead = 1, kWritten = 2, kSteps = 3 };
+
+struct Timing {
+  std::atomic<bool> armed{false};
+  std::atomic<int64_t> start_ns{0};
+  std::atomic<int64_t> at_ns[kSteps];
+  std::atomic<uint64_t> bytes{0};
+  std::atomic<int> saved{-1};  // -1 not known, 0 failed, 1 saved
+  Timing() {
+    for (auto& at : at_ns) at.store(-1);
+  }
+};
+inline Timing& Global() {
+  static Timing* timing = new Timing();
+  return *timing;
+}
+inline int64_t NowNs() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+// The exit checkpoint asks for a snapshot: the steps after it are noted (other snapshots are not).
+inline void Begin(Timing& t, int64_t now_ns) {
+  for (auto& at : t.at_ns) at.store(-1);
+  t.bytes.store(0);
+  t.saved.store(-1);
+  t.start_ns.store(now_ns);
+  t.armed.store(true);
+}
+inline void Mark(Timing& t, Step step, int64_t now_ns, uint64_t bytes = 0) {
+  if (!t.armed.load()) return;
+  t.at_ns[step].store(now_ns - t.start_ns.load());
+  if (bytes) t.bytes.store(bytes);
+}
+inline void Finish(Timing& t, int64_t now_ns, bool saved) {
+  if (!t.armed.load()) return;
+  t.at_ns[kWritten].store(now_ns - t.start_ns.load());
+  t.saved.store(saved ? 1 : 0);
+}
+inline void End(Timing& t) { t.armed.store(false); }
+
+// "queued at 0 ms; taken by the GPU thread after 12.3 ms; snapshot of 31457280 bytes read after
+// 40.1 ms (its write starts); written after 1650.2 ms (saved)", "not reached" for the missing ones.
+inline std::string Line(const Timing& t) {
+  auto ms = [&t](Step step) -> std::string {
+    const int64_t ns = t.at_ns[step].load();
+    if (ns < 0) return "not reached";
+    char text[40];
+    std::snprintf(text, sizeof(text), "after %.1f ms", double(ns) / 1e6);
+    return text;
+  };
+  std::string line = "queued at 0 ms; taken by the GPU thread " + ms(kTaken) + "; snapshot";
+  if (const uint64_t bytes = t.bytes.load()) line += " of " + std::to_string(bytes) + " bytes";
+  line += " read " + ms(kRead) + " (its write starts); written " + ms(kWritten);
+  const int saved = t.saved.load();
+  if (saved >= 0) line += saved ? " (saved)" : " (failed or unavailable)";
+  return line;
+}
+
+}  // namespace xbox360ps5::exit_cache_timing
