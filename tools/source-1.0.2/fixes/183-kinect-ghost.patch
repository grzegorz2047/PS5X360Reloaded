+// SPDX-License-Identifier: MIT
+// Fix 183 (two-player Kinect, research/design-v108/kinect-2-players.md step 1): the "ghost
+// player" probe. Do the games take a second skeleton at all, and what do they do with a guest
+// second player? One person can answer it: with the switch file on, the skeleton frames carry a
+// second tracked body in slot 1, a copy of the player's pose from `delay-s` seconds earlier moved
+// `offset-m` metres to the side, under its own tracking ID (kGhostTrackingId) for as long as it
+// is shown. The ghost has no profile: it is a guest.
+//  - In a title whose identify is answered here (156l/156u): "call identify" (enrollment -1, no
+//    user) until the title asked to identify the ghost and got the guest answer (result 0,
+//    enrollment kGuestEnrollment, profile not matched), or, when the title never asks about it,
+//    for kGhostAskWithinMs; then the guest pair kGuestEnrollment / kUserIndexNone (Zumba maps -2
+//    to "identified, not enrolled", 82333248). Its state is its own: the player's 156t/156w
+//    timers are not touched.
+//  - In any other title: enrollment -1 and no user, as a body without a profile has today.
+// Off by default: without the switch file nothing here runs and the frames are as before.
+//
+// The switch file (kinect-ghost.txt in the data root, XBOX360PS5_DATA_ROOT), one setting a line:
+//   on                 the ghost is shown (without it the file does nothing)
+//   offset-m 1.1       metres to the side (0.3 - 3.0)
+//   delay-s 3          seconds behind the player (0 - 10)
+// Anything after '#' and any other line is ignored.
+#pragma once
+#include <cstdint>
+#include <fstream>
+#include <sstream>
+#include <string>
+#include <vector>
+
+#include "xbox360ps5/app_identity.hpp"
+#include "xbox360ps5/motion_input.hpp"
+
+namespace xbox360ps5::kinect_ghost {
+
+constexpr const char* kSwitchPath = XBOX360PS5_DATA_ROOT "/kinect-ghost.txt";
+constexpr uint32_t kGhostSlot = 1;
+constexpr uint32_t kGhostTrackingId = 0x00000F01;  // stable; the player's IDs count up from 1
+constexpr uint32_t kGuestEnrollment = 0xFFFFFFFE;
+constexpr uint32_t kEnrollmentCallIdentify = 0xFFFFFFFF, kUserIndexNone = 0xFE;
+constexpr int64_t kGhostAskWithinMs = 20000;  // as 156t's kAskWithinMs
+constexpr float kOffsetMin = 0.3f, kOffsetMax = 3.0f, kDefaultOffset = 1.1f;
+constexpr float kDelayMin = 0.0f, kDelayMax = 10.0f, kDefaultDelay = 3.0f;
+constexpr size_t kDelayFrames = 512;  // 10 s at 30 fps, with room
+
+struct Config {
+  bool on = false;
+  float offset_m = kDefaultOffset;
+  float delay_s = kDefaultDelay;
+};
+inline float Clamp(float v, float lo, float hi) { return v < lo ? lo : (v > hi ? hi : v); }
+inline Config Parse(const std::string& text) {
+  Config c;
+  std::istringstream lines(text);
+  std::string line;
+  while (std::getline(lines, line)) {
+    const size_t hash = line.find('#');
+    if (hash != std::string::npos) line.resize(hash);
+    std::istringstream words(line);
+    std::string key;
+    if (!(words >> key)) continue;
+    if (key == "on") {
+      c.on = true;
+    } else if (key == "offset-m" || key == "delay-s") {
+      float value = 0;
+      if (!(words >> value)) continue;
+      if (key == "offset-m") c.offset_m = Clamp(value, kOffsetMin, kOffsetMax);
+      else c.delay_s = Clamp(value, kDelayMin, kDelayMax);
+    }
+  }
+  return c;
+}
+inline Config Load(const char* path = kSwitchPath) {
+  std::ifstream in(path, std::ios::binary);
+  if (!in) return {};
+  std::stringstream s;
+  s << in.rdbuf();
+  return Parse(s.str());
+}
+
+// The player's poses, to be shown `delay` later.
+class DelayBuffer {
+ public:
+  void Push(const motion::Frame& pose, int64_t now_ms) {
+    if (frames_.size() < kDelayFrames) {
+      frames_.push_back({pose, now_ms});
+    } else {
+      frames_[next_] = {pose, now_ms};
+    }
+    next_ = (next_ + 1) % kDelayFrames;
+  }
+  // The newest pose taken at or before now - delay; an untracked pose when there is none yet.
+  motion::Frame Delayed(int64_t now_ms, int64_t delay_ms) const {
+    const int64_t at = now_ms - delay_ms;
+    const Entry* best = nullptr;
+    for (const Entry& e : frames_)
+      if (e.ms <= at && (!best || e.ms > best->ms)) best = &e;
+    if (!best) return {};
+    return best->pose;
+  }
+  size_t size() const { return frames_.size(); }
+  void Clear() {
+    frames_.clear();
+    next_ = 0;
+  }
+
+ private:
+  struct Entry {
+    motion::Frame pose;
+    int64_t ms = 0;
+  };
+  std::vector<Entry> frames_;
+  size_t next_ = 0;
+};
+
+// Moved `offset_m` to the side in the phone's space (+x to the right of the picture), every joint
+// the phone sent (the spine joint, which stands for the body's position, too).
+inline motion::Frame Shifted(motion::Frame pose, float offset_m) {
+  for (auto& joint : pose.joints)
+    if (joint.confidence > 0.0f) joint.x += offset_m;
+  return pose;
+}
+
+// Who the ghost is in the frames.
+struct Identity {
+  bool asked = false;     // the title asked to identify the ghost
+  bool answered = false;  // and got the guest answer
+  int64_t first_seen_ms = -1;
+};
+struct FramePair {
+  uint32_t enrollment, user_index;
+};
+inline FramePair ForFrame(bool identify_bound, const Identity& id, int64_t now_ms) {
+  if (!identify_bound) return {kEnrollmentCallIdentify, kUserIndexNone};
+  const bool fallback = !id.asked && id.first_seen_ms >= 0 &&
+                        now_ms - id.first_seen_ms >= kGhostAskWithinMs;
+  if (id.answered || fallback) return {kGuestEnrollment, kUserIndexNone};
+  return {kEnrollmentCallIdentify, kUserIndexNone};
+}
+
