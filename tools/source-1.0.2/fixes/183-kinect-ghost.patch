+// Fix 183 (kinect_ghost.hpp): a second tracked body in `slot` of a frame WriteSkeletonFrame wrote,
+// with the enrollment and user index as given (the ghost's guest pair -2/FE included).
+inline void WriteSkeletonBody(uint8_t* frame, uint32_t slot, const Frame& pose,
+                              uint32_t tracking_id, uint32_t enrollment, uint32_t user_index) {
+  if (slot >= kSkeletonCount) return;
+  uint8_t* body = frame + kSkeletonDataOffset + slot * kSkeletonDataBytes;
+  std::memset(body, 0, kSkeletonDataBytes);
+  StoreU32(body + 0x08, enrollment);
+  StoreU32(body + 0x0C, user_index);
+  if (!pose.tracked || !tracking_id) {
+    StoreU32(body + 0x08, kEnrollmentUnknown);
+    StoreU32(body + 0x0C, kUserIndexNone);
+    return;
   }
+  StoreU32(body + 0x00, kSkeletonTracked);
+  StoreU32(body + 0x04, tracking_id);
+  WriteSkeletonJoints(body, pose);
 }
 
