+void WriteGhost(uint8_t* frame, const xbox360ps5::motion::Frame& pose, bool identify_bound) {
+  namespace kg = xbox360ps5::kinect_ghost;
+  const int64_t now_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                             std::chrono::steady_clock::now().time_since_epoch())
+                             .count();
+  xbox360ps5::motion::Frame ghost;
+  kg::FramePair pair{};
+  {
+    std::lock_guard lock(g_ghost_mutex);
+    g_ghost_delay.Push(pose, now_ms);
+    ghost = kg::Shifted(g_ghost_delay.Delayed(now_ms, int64_t(g_ghost.delay_s * 1000.0f)),
+                        g_ghost.offset_m);
+    if (ghost.tracked && g_ghost_identity.first_seen_ms < 0) g_ghost_identity.first_seen_ms = now_ms;
+    pair = kg::ForFrame(identify_bound, g_ghost_identity, now_ms);
+  }
+  const bool was_live = g_ghost_live.exchange(ghost.tracked);
+  xbox360ps5::motion::WriteSkeletonBody(frame, kg::kGhostSlot, ghost, kg::kGhostTrackingId,
+                                        pair.enrollment, pair.user_index);
+  static uint32_t last_enrollment = 0;
+  if (ghost.tracked && (!was_live || pair.enrollment != last_enrollment) &&
+      g_ghost_lines.fetch_add(1) < 16)
+    XELOGW("Virtual Kinect: the ghost {:08X} is in slot {} as enrollment {:X}, user {:X} "
+           "(fix 183)", kg::kGhostTrackingId, kg::kGhostSlot, pair.enrollment, pair.user_index);
+  if (ghost.tracked) last_enrollment = pair.enrollment;
+}
