+// Xbox360PS5, fix 139b: the host file renamed in its directory (the same file system), then
+// deleted by the function returned, which Entry::Delete runs once the name is free again.
+std::function<bool()> HostPathEntry::DetachEntryInternal(Entry* entry) {
+  static std::atomic<uint64_t> next{0};
+  const auto full_path = host_path_ / xe::to_path(entry->name());
+  const bool directory = entry->attributes() & kFileAttributeDirectory;
+  std::error_code ec;
+  if (!directory && std::filesystem::is_directory(full_path, ec)) {
+    return {};  // DeleteEntryInternal refuses it
+  }
+  if (!std::filesystem::exists(full_path, ec)) {
+    return [] { return true; };  // nothing on the host (as DeleteEntryInternal)
+  }
+  const auto renamed =
+      host_path_ / xe::to_path(std::string(kDeletedPrefix) +
+                               std::to_string(next.fetch_add(1)) + "-" +
+                               std::string(entry->name()));
+  std::filesystem::rename(full_path, renamed, ec);
+  if (ec) {
+    return {};
+  }
+  return [renamed, directory] {
+    std::error_code error;
+    bool removed;
+    if (directory) {
+      const auto count = std::filesystem::remove_all(renamed, error);
+      removed = !error && count != static_cast<std::uintmax_t>(-1);
+    } else {
+      std::filesystem::remove(renamed, error);
+      removed = !error;
+    }
+    if (!removed) {
+      XELOGE("HostPathEntry: cannot delete {}: {}", xe::path_to_utf8(renamed),
+             error.message());
+    }
+    return removed;
+  };
+}
