diff --git a/include/xbox360ps5/xma_progress.hpp b/include/xbox360ps5/xma_progress.hpp
new file mode 100644
--- /dev/null
+++ b/include/xbox360ps5/xma_progress.hpp
@@ -0,0 +1,83 @@
+// SPDX-License-Identifier: MIT
+// Fix 155b: "XMA hardware-like progress", an experiment behind <data>/xma-progress.txt ("on"; read when
+// the decoder starts, logged once).
+//
+// Fix 155's trace of Grand Theft Auto V's freeze: the stream the audio thread waits on (emulator
+// context 21) had been kicked once, 31 s before; that one synchronous pass decoded until the output
+// ring was full, the write offset wrapped onto the read offset and output-valid was cleared (the
+// decoder's "full"). The game's own copy of the context still showed the state before the kick
+// (write == read, output valid: empty), so its loop at 83140450 waits forever. On the console the XMA
+// hardware works on an enabled context in the background, and a context's state keeps changing
+// between the game's snapshots; here a kick is one pass that ends in a state the game may take for
+// the one it saw before. With the switch on, the "new" decoder:
+//  (a) keeps a context it worked on enabled while it still has input, its output is valid and the
+//      game has not locked (XMADisableContext) or released it since, so the decoder thread goes on
+//      decoding as the game frees output space, as the hardware does (it needs the decoder thread:
+//      the game option "Audio without its own thread" leaves only (b));
+//  (b) never fills the output ring in one pass: one 256-byte block stays free, so the write offset
+//      never lands on the read offset and output-valid is not cleared as "full".
+// Off (the default), the decoder works as before.
+#pragma once
+#include <atomic>
+#include <cctype>
+#include <cstdint>
+#include <string>
+
+namespace xbox360ps5::xma_progress {
+
+inline std::atomic<bool> on{false};          // the switch, read once at the decoder's start
+inline std::atomic<bool> continuous{false};  // (a): on, and the decoder has its own thread
+
+// The switch file's text: "on" (any case, surrounding spaces and lines allowed) turns it on.
+inline bool ParseSwitch(const std::string& text) {
+  std::string word;
+  for (char c : text) {
+    if (std::isspace(static_cast<unsigned char>(c))) {
+      if (!word.empty()) break;
+      continue;
+    }
+    word += char(std::tolower(static_cast<unsigned char>(c)));
+  }
+  return word == "on";
+}
+
+// (b): the output blocks a pass leaves free.
+inline int32_t ReserveBlocks(bool progress) { return progress ? 1 : 0; }
+// The free blocks a pass may fill: what the ring has free, less the reserve, never below 0.
+inline int32_t UsableBlocks(int32_t free_blocks, bool progress) {
+  const int32_t usable = free_blocks - ReserveBlocks(progress);
+  return usable > 0 ? usable : 0;
+}
+
+// (a): whether a context stays enabled after a pass.
+inline bool StayEnabled(bool continuous_mode, bool allocated, bool disabled_meanwhile, bool any_input_valid,
+                        bool output_valid) {
+  return continuous_mode && allocated && !disabled_meanwhile && any_input_valid && output_valid;
+}
+
+// A model of the new decoder's fill (Work: PrepareOutputRingBuffer, the decode loop, the "full"
+// signal), for the host check: `blocks` in the ring, `per_pass` blocks a decode pass writes, the
+// input lasting `frames` passes.
+struct Fill {
+  uint32_t write = 0;
+  bool valid = true;
+  uint32_t written = 0;
+};
+inline Fill ModelFill(uint32_t blocks, uint32_t write, uint32_t read, bool valid, uint32_t per_pass, uint32_t frames,
+                      bool progress) {
+  Fill f{write, valid, 0};
+  if (!valid || !blocks) return f;
+  // RingBuffer: write == read is empty, so the whole ring is free.
+  const int32_t free_blocks = int32_t(write == read ? blocks : (read + blocks - write) % blocks);
+  int32_t remaining = UsableBlocks(free_blocks, progress);
+  while (remaining >= int32_t(per_pass) && frames) {
+    f.write = (f.write + per_pass) % blocks;
+    f.written += per_pass;
+    remaining -= int32_t(per_pass);
+    --frames;
+  }
+  if (remaining == 0 && f.write == read) f.valid = false;  // "full": the ring buffer looks empty
+  return f;
+}
+
+}  // namespace xbox360ps5::xma_progress
