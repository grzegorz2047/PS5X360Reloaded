 #include <cstring>
 extern "C" PFN_vkVoidFunction vk_icdGetInstanceProcAddr(VkInstance, const char*);
 namespace xbox360ps5 {
 namespace {
+// Fix 117b: device memory allocated and freed through the driver, for the resolution scale's
+// 10 s line (resolution_scale::driver_memory). One device; the functions are the driver's own.
+PFN_vkGetDeviceProcAddr driver_device_proc = nullptr;
+PFN_vkAllocateMemory driver_allocate_memory = nullptr;
+PFN_vkFreeMemory driver_free_memory = nullptr;
+uint64_t MemoryHandle(VkDeviceMemory memory) { return (uint64_t)(uintptr_t)memory; }
+VkResult VKAPI_CALL AllocateMemory(VkDevice device, const VkMemoryAllocateInfo* info,
+                                   const VkAllocationCallbacks* allocator, VkDeviceMemory* memory) {
+  const VkResult result = driver_allocate_memory(device, info, allocator, memory);
+  if (result == VK_SUCCESS && info && memory && *memory != VK_NULL_HANDLE)
+    resolution_scale::driver_memory.Allocated(MemoryHandle(*memory), info->allocationSize);
+  return result;
+}
+void VKAPI_CALL FreeMemory(VkDevice device, VkDeviceMemory memory, const VkAllocationCallbacks* allocator) {
+  if (memory != VK_NULL_HANDLE) resolution_scale::driver_memory.Freed(MemoryHandle(memory));
+  driver_free_memory(device, memory, allocator);
+}
+PFN_vkVoidFunction VKAPI_CALL DeviceProc(VkDevice device, const char* name) {
+  if (!name || !driver_device_proc) return nullptr;
+  if (!std::strcmp(name, "vkGetDeviceProcAddr")) return reinterpret_cast<PFN_vkVoidFunction>(DeviceProc);
+  const PFN_vkVoidFunction function = driver_device_proc(device, name);
+  if (!function) return function;
+  if (!std::strcmp(name, "vkAllocateMemory")) {
+    driver_allocate_memory = reinterpret_cast<PFN_vkAllocateMemory>(function);
+    return reinterpret_cast<PFN_vkVoidFunction>(AllocateMemory);
+  }
+  if (!std::strcmp(name, "vkFreeMemory")) {
+    driver_free_memory = reinterpret_cast<PFN_vkFreeMemory>(function);
+    return reinterpret_cast<PFN_vkVoidFunction>(FreeMemory);
+  }
+  return function;
+}
