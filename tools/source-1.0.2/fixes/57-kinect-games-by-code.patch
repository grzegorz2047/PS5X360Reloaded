+// Xbox360PS5 fix 57: which titles the virtual Kinect serves, and the running
+// executable's code for the scans in xbox360ps5/nui_image_scan.hpp.
+
+#ifndef XENIA_KERNEL_KINECT_TITLE_H_
+#define XENIA_KERNEL_KINECT_TITLE_H_
+
+#include <cstdint>
+
+#include "xbox360ps5/nui_image_scan.hpp"
+#include "xenia/cpu/xex_module.h"
+#include "xenia/kernel/kernel_state.h"
+#include "xenia/kernel/user_module.h"
+#include "xenia/kernel/util/xex2_info.h"
+#include "xenia/memory.h"
+
+namespace xe {
+namespace kernel {
+
+// A title whose executable says it requires Kinect (XEX system flags 32,
+// skeletal tracking required): Dragon Ball Z for Kinect, Kinect Sports and the
+// other Kinect-only games. Titles where Kinect is optional (skeletal tracking
+// supported) keep their own SDK and are played with the controller.
+inline bool KinectRequiredTitle(KernelState* kernel_state) {
+  auto module = kernel_state->GetExecutableModule();
+  cpu::XexModule* xex = module ? module->xex_module() : nullptr;
+  if (!xex) return false;
+  uint32_t flags = 0;
+  const bool has_flags = xex->GetOptHeader(XEX_HEADER_SYSTEM_FLAGS_32, &flags);
+  return xbox360ps5::motion::SkeletalTrackingRequired(has_flags, flags);
+}
+
+// The running executable as loaded, when every page of it is readable; empty
+// otherwise.
+inline xbox360ps5::motion::CodeView ExecutableCode(KernelState* kernel_state) {
+  auto module = kernel_state->GetExecutableModule();
+  cpu::XexModule* xex = module ? module->xex_module() : nullptr;
+  if (!xex) return {};
+  Memory* memory = kernel_state->memory();
+  const uint32_t base = xex->base_address(), size = xex->image_size();
+  if (!size || uint64_t(base) + size > 0x100000000ull) return {};
+  for (uint64_t at = base; at < uint64_t(base) + size;
+       at = (at & ~uint64_t(4095)) + 4096) {
+    auto* heap = memory->LookupHeap(uint32_t(at));
+    uint32_t protection = 0;
+    if (!heap || !heap->QueryProtect(uint32_t(at), &protection) ||
+        !(protection & kMemoryProtectRead))
+      return {};
+  }
+  return {memory->TranslateVirtual<const uint8_t*>(base), size, base};
+}
+
+// The executable's hash as Canary computes it, for the log (0 when unknown).
+inline uint64_t ExecutableHash(KernelState* kernel_state) {
+  auto module = kernel_state->GetExecutableModule();
+  return module ? module->hash().value_or(0) : 0;
+}
+
+namespace xboxkrnl {
+// 1.0.5_candidate_5 (xboxkrnl_pscam.cc): binds the skeleton frame function and the hand seam
+// as soon as the title starts its NUI library (XMsg FE/2B003), before the JIT can have compiled
+// NuiSkeletonGetNextFrame (Kinect Sports had, by its first camera request).
+void BindVirtualKinectEarly(KernelState* kernel_state);
+}  // namespace xboxkrnl
+
+}  // namespace kernel
+}  // namespace xe
+
+#endif  // XENIA_KERNEL_KINECT_TITLE_H_
