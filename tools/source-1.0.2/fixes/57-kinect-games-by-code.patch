diff --git a/include/xbox360ps5/kinect_hand_view.hpp b/include/xbox360ps5/kinect_hand_view.hpp
new file mode 100644
index 0000000..b49f702
--- /dev/null
+++ b/include/xbox360ps5/kinect_hand_view.hpp
@@ -0,0 +1,107 @@
+// SPDX-License-Identifier: MIT
+// Fixes 57 and 63: what a Kinect game makes of the player's hands, for the motion panel.
+//
+// Dragon Ball Z for Kinect moves through its menus with an arm held out: each update the game
+// measures each hand's reach (a length and a unit direction, sensor axes) and, for each of five
+// directions (right, left, up, down, towards the sensor), counts the updates in a row where the
+// reach is at least its threshold (0.4) and the direction's component beyond its other
+// threshold (0.7071); at 15 the direction is "held" and the menu moves once. The kernel side
+// (xboxkrnl_pscam.cc) reads those values from the game every frame and publishes them here;
+// the panel over the game draws them, so a player sees how far the game thinks the arm
+// reaches, against what it needs, and how long it still has to be held.
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <mutex>
+
+#include "xbox360ps5/motion_input.hpp"
+
+namespace xbox360ps5::motion {
+
+constexpr int kHandDirections = 5;
+// The title's own debounce (DBZ 821B4ED8: cmplwi counter, 0xF).
+constexpr int kHoldUpdates = 15;
+
+struct GameHand {
+  float magnitude = 0, x = 0, y = 0, z = 0;  // the game's reach, sensor axes
+  int32_t counters[kHandDirections] = {};    // updates in a row per direction (-1: re-arm)
+  uint32_t held = 0;                         // directions held (bits 1, 2, 4, 8, 0x10)
+};
+struct GameHands {
+  bool valid = false;            // a hand-reach title is running and was read this frame
+  bool context = false;          // the title's own hand context is available
+  float reach_needed = 0.4f;     // read from the title's code at binding
+  float direction_needed = 0.7071f;
+  GameHand right, left;
+  std::chrono::steady_clock::time_point at{};
+};
+
+inline std::mutex game_hands_mutex;
+inline GameHands game_hands;
+inline void PublishGameHands(const GameHands& hands) {
+  std::lock_guard lock(game_hands_mutex);
+  game_hands = hands;
+  game_hands.at = std::chrono::steady_clock::now();
+}
+inline GameHands SnapshotGameHands() {
+  std::lock_guard lock(game_hands_mutex);
+  GameHands copy = game_hands;
+  if (std::chrono::steady_clock::now() - copy.at > std::chrono::milliseconds(500)) copy.valid = false;
+  return copy;
+}
+inline void ResetGameHands() {
+  std::lock_guard lock(game_hands_mutex);
+  game_hands = {};
+}
+
+// The direction bits the title sets for a reach (DBZ 821B4DB0-821B4E1C, the same for both
+// hands): 2 right (x >= t), 1 left (x <= -t), 4 up (y >= t), 8 down (y <= -t), 0x10 towards
+// the sensor (z >= t), only while the reach is at least the reach threshold.
+inline uint32_t Directions(const GameHand& hand, float reach_needed, float direction_needed) {
+  if (!(hand.magnitude >= reach_needed)) return 0;
+  uint32_t bits = 0;
+  if (hand.x >= direction_needed) bits |= 2;
+  else if (hand.x <= -direction_needed) bits |= 1;
+  if (hand.y >= direction_needed) bits |= 4;
+  else if (hand.y <= -direction_needed) bits |= 8;
+  if (hand.z >= direction_needed) bits |= 0x10;
+  return bits;
+}
+// How far the longest running count is towards a held direction, 0..1.
+inline float HoldProgress(const GameHand& hand) {
+  int best = 0;
+  for (int n = 0; n < kHandDirections; ++n) best = std::max(best, int(hand.counters[n]));
+  return std::clamp(float(best) / float(kHoldUpdates), 0.0f, 1.0f);
+}
+
+// Where the player stands, from the phone's pose (hips at Z = kBodyDistance - distance; the
+// bridge's metres). Dragon Ball Z's own body check wants 1.8 to 3.5 m and at least ten joints
+// seen well (NUI-HANDOFF, 821B6F68).
+enum class Positioning { kOk, kStepBack, kStepCloser, kWholeBody };
+constexpr float kNearestMetres = 1.8f, kFarthestMetres = 3.5f, kBridgeBodyDistance = 2.5f;
+inline Positioning PositionHint(const Frame& pose) {
+  if (!pose.tracked) return Positioning::kOk;
+  int seen = 0;
+  for (const auto& joint : pose.joints) seen += joint.confidence >= 0.5f;
+  // Head, both hands and both feet (pose.mjs order 3, 7, 11, 15, 19).
+  bool ends = true;
+  for (int n : {3, 7, 11, 15, 19}) ends = ends && pose.joints[size_t(n)].confidence >= 0.5f;
+  if (seen < 10 || !ends) return Positioning::kWholeBody;
+  const float distance = kBridgeBodyDistance - pose.joints[0].z;
+  if (distance < kNearestMetres) return Positioning::kStepBack;
+  if (distance > kFarthestMetres) return Positioning::kStepCloser;
+  return Positioning::kOk;
+}
+
+// The phone's shoulder-to-hand length (metres), for the scale diagnostics: the arm as the
+// phone measured it, next to the reach the game made of it. 0 when not seen.
+inline float PhoneArmLength(const Frame& pose, bool right) {
+  const Joint& s = pose.joints[right ? 8 : 4];
+  const Joint& h = pose.joints[right ? 11 : 7];
+  if (!pose.tracked || s.confidence < 0.5f || h.confidence < 0.5f) return 0;
+  const float dx = h.x - s.x, dy = h.y - s.y, dz = h.z - s.z;
+  return std::sqrt(dx * dx + dy * dy + dz * dz);
+}
+
+}  // namespace xbox360ps5::motion
diff --git a/include/xbox360ps5/motion_record.hpp b/include/xbox360ps5/motion_record.hpp
new file mode 100644
index 0000000..b04e6ea
--- /dev/null
+++ b/include/xbox360ps5/motion_record.hpp
@@ -0,0 +1,180 @@
+// SPDX-License-Identifier: MIT
+// Fix 57 (1.0.5): the last seconds of phone motion, kept on the console and saved to a file,
+// so body scaling, reach and gestures can be tuned on a PC (tools/check-motion-replay.cpp)
+// instead of a console build per change.
+//
+// While a Kinect title takes skeleton frames, each frame it gets records the phone's pose as
+// the phone sent it (before body_scale.hpp) and what the title made of the hands at that
+// moment (kinect_hand_view.hpp). The last kRecordFrames (10 s at 30 frames/s) are kept in a
+// ring; opening the guide saves them to the logs folder as motion-<UTC time>.xmr.
+//
+// File (little-endian, as the phone's XMP1 packets):
+//   "XMR1", u32 version (1), u32 records, then per record:
+//   u32 milliseconds since the first record, the 336-byte XMP1 packet of the pose
+//   ("XMP1", u32 sequence, u32 session, u32 tracked, 20 x {x, y, z, confidence} f32),
+//   then the title's hands: u32 valid, u32 context, f32 reach_needed, f32 direction_needed,
+//   and per hand (right, left): f32 magnitude, x, y, z, 5 x i32 counters, u32 held.
+#pragma once
+#include <chrono>
+#include <cstdint>
+#include <cstring>
+#include <deque>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include "xbox360ps5/kinect_hand_view.hpp"
+#include "xbox360ps5/motion_input.hpp"
+
+namespace xbox360ps5::motion {
+
+constexpr size_t kRecordFrames = 300;
+constexpr size_t kXmp1Bytes = 336;
+constexpr size_t kHandBytes = 4 * 4 + kHandDirections * 4 + 4;
+constexpr size_t kRecordBytes = 4 + kXmp1Bytes + 16 + 2 * kHandBytes;
+
+struct MotionRecord {
+  uint32_t milliseconds = 0;
+  Frame pose;
+  GameHands hands;
+};
+
+namespace record_detail {
+inline void Put32(std::vector<uint8_t>& out, uint32_t value) {
+  for (int n = 0; n < 4; ++n) out.push_back(uint8_t(value >> (8 * n)));
+}
+inline void PutF(std::vector<uint8_t>& out, float value) {
+  uint32_t bits;
+  std::memcpy(&bits, &value, 4);
+  Put32(out, bits);
+}
+inline uint32_t Get32(const uint8_t* at) {
+  return uint32_t(at[0]) | uint32_t(at[1]) << 8 | uint32_t(at[2]) << 16 | uint32_t(at[3]) << 24;
+}
+inline float GetF(const uint8_t* at) {
+  const uint32_t bits = Get32(at);
+  float value;
+  std::memcpy(&value, &bits, 4);
+  return value;
+}
+}  // namespace record_detail
+
+// The pose as the phone sends it (motion_input.hpp Receive reads the same layout).
+inline void PackXmp1(std::vector<uint8_t>& out, const Frame& pose) {
+  using namespace record_detail;
+  for (char c : {'X', 'M', 'P', '1'}) out.push_back(uint8_t(c));
+  Put32(out, pose.sequence);
+  Put32(out, pose.session);
+  Put32(out, pose.tracked ? 1 : 0);
+  for (const auto& joint : pose.joints) {
+    PutF(out, joint.x); PutF(out, joint.y); PutF(out, joint.z); PutF(out, joint.confidence);
+  }
+}
+inline bool UnpackXmp1(const uint8_t* at, Frame& pose) {
+  using namespace record_detail;
+  if (std::memcmp(at, "XMP1", 4)) return false;
+  pose = {};
+  pose.sequence = Get32(at + 4);
+  pose.session = Get32(at + 8);
+  pose.tracked = Get32(at + 12) == 1;
+  for (size_t n = 0; n < 20; ++n) {
+    const uint8_t* j = at + 16 + n * 16;
+    pose.joints[n] = {GetF(j), GetF(j + 4), GetF(j + 8), GetF(j + 12)};
+  }
+  return true;
+}
+
+inline std::vector<uint8_t> SaveRecording(const std::vector<MotionRecord>& records) {
+  using namespace record_detail;
+  std::vector<uint8_t> out;
+  out.reserve(12 + records.size() * kRecordBytes);
+  for (char c : {'X', 'M', 'R', '1'}) out.push_back(uint8_t(c));
+  Put32(out, 1);
+  Put32(out, uint32_t(records.size()));
+  for (const auto& r : records) {
+    Put32(out, r.milliseconds);
+    PackXmp1(out, r.pose);
+    Put32(out, r.hands.valid ? 1 : 0);
+    Put32(out, r.hands.context ? 1 : 0);
+    PutF(out, r.hands.reach_needed);
+    PutF(out, r.hands.direction_needed);
+    for (const GameHand* hand : {&r.hands.right, &r.hands.left}) {
+      PutF(out, hand->magnitude); PutF(out, hand->x); PutF(out, hand->y); PutF(out, hand->z);
+      for (int n = 0; n < kHandDirections; ++n) Put32(out, uint32_t(hand->counters[n]));
+      Put32(out, hand->held);
+    }
+  }
+  return out;
+}
+
+// Empty when the bytes are not a whole recording.
+inline std::vector<MotionRecord> LoadRecording(const uint8_t* data, size_t size) {
+  using namespace record_detail;
+  std::vector<MotionRecord> records;
+  if (size < 12 || std::memcmp(data, "XMR1", 4) || Get32(data + 4) != 1) return records;
+  const uint32_t count = Get32(data + 8);
+  if (count > 100000 || size != 12 + size_t(count) * kRecordBytes) return records;
+  records.resize(count);
+  const uint8_t* at = data + 12;
+  for (auto& r : records) {
+    r.milliseconds = Get32(at);
+    if (!UnpackXmp1(at + 4, r.pose)) return {};
+    const uint8_t* h = at + 4 + kXmp1Bytes;
+    r.hands.valid = Get32(h) != 0;
+    r.hands.context = Get32(h + 4) != 0;
+    r.hands.reach_needed = GetF(h + 8);
+    r.hands.direction_needed = GetF(h + 12);
+    h += 16;
+    for (GameHand* hand : {&r.hands.right, &r.hands.left}) {
+      hand->magnitude = GetF(h); hand->x = GetF(h + 4); hand->y = GetF(h + 8); hand->z = GetF(h + 12);
+      for (int n = 0; n < kHandDirections; ++n) hand->counters[n] = int32_t(Get32(h + 16 + n * 4));
+      hand->held = Get32(h + 16 + kHandDirections * 4);
+      h += kHandBytes;
+    }
+    at += kRecordBytes;
+  }
+  return records;
+}
+
+// The console's ring of the last kRecordFrames.
+class MotionRecorder {
+ public:
+  void Add(const Frame& pose, const GameHands& hands, std::chrono::steady_clock::time_point at) {
+    std::lock_guard lock(mutex_);
+    if (records_.empty()) start_ = at;
+    MotionRecord r;
+    r.milliseconds = uint32_t(std::chrono::duration_cast<std::chrono::milliseconds>(at - start_).count());
+    r.pose = pose;
+    r.hands = hands;
+    records_.push_back(r);
+    if (pose.tracked) last_tracked_ = at;
+    while (records_.size() > kRecordFrames) records_.pop_front();
+  }
+  // The ring as a file's bytes (times from its first record); empty when no body was in it.
+  std::vector<uint8_t> Take() {
+    std::lock_guard lock(mutex_);
+    bool any = false;
+    for (const auto& r : records_) any = any || r.pose.tracked;
+    if (!any) return {};
+    std::vector<MotionRecord> copy(records_.begin(), records_.end());
+    const uint32_t first = copy.front().milliseconds;
+    for (auto& r : copy) r.milliseconds -= first;
+    return SaveRecording(copy);
+  }
+  size_t Size() {
+    std::lock_guard lock(mutex_);
+    return records_.size();
+  }
+  void Reset() {
+    std::lock_guard lock(mutex_);
+    records_.clear();
+  }
+
+ private:
+  std::mutex mutex_;
+  std::deque<MotionRecord> records_;
+  std::chrono::steady_clock::time_point start_{}, last_tracked_{};
+};
+inline MotionRecorder motion_recorder;
+
+}  // namespace xbox360ps5::motion
diff --git a/include/xbox360ps5/nui_image_scan.hpp b/include/xbox360ps5/nui_image_scan.hpp
new file mode 100644
index 0000000..1cfb959
--- /dev/null
+++ b/include/xbox360ps5/nui_image_scan.hpp
@@ -0,0 +1,337 @@
+// SPDX-License-Identifier: MIT
+// Fix 57: what the virtual Kinect needs from a title's executable, found by the shape
+// of its code instead of addresses traced in one image.
+//
+// 1.0.2 wired the virtual Kinect to one Dragon Ball Z for Kinect executable (Canary
+// module hash 8FDD4F4AB147612A): the identity callback had to be 8249D248, the hand
+// reach seam 821B4E24, and the skeleton hook refused every other hash. The Europe
+// disc (hash C9561ED1F9AFFED4) has the same Kinect SDK code at other addresses, so
+// its identity callback registration (XMsg FE/2C009) was refused, NuiInitialize
+// failed and the title shut its camera down after one state query.
+//
+// Everything below works on the executable's bytes as loaded (big-endian PowerPC):
+//  * which titles get the virtual camera: the executable's XEX system flags
+//    (XEX_HEADER_SYSTEM_FLAGS_32) say "skeletal tracking required" (Kinect games);
+//    "supported" (optional Kinect) titles keep their own SDK and controllers;
+//  * the identity callback a title registers: its message switch is decoded and the
+//    case of the identity-changed event (2C00F) must be "bl refresh; b out", with a
+//    refresh that does not read the message buffer (r4) before its first call;
+//  * the game's call of NuiSkeletonGetNextFrame (FindSkeletonGetNextFrame in
+//    virtual_skeleton.hpp finds the function): its one caller;
+//  * Dragon Ball Z's hand reach seam: "lis r11,X" right before the game reads its
+//    hand reach at 0x2710(r30).
+#pragma once
+#include <cstddef>
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+namespace xbox360ps5::motion {
+
+// XEX_HEADER_SYSTEM_FLAGS_32 (xex2_info.h: XEX_SYSTEM_SKELETAL_TRACKING_*).
+constexpr uint32_t kXexSkeletalTrackingRequired = 0x00000040;
+constexpr uint32_t kXexSkeletalTrackingSupported = 0x00000080;
+inline bool SkeletalTrackingRequired(bool has_flags, uint32_t flags) {
+  return has_flags && (flags & kXexSkeletalTrackingRequired) != 0;
+}
+
+// The same flag read from a raw XEX2 header (the file's first bytes, header_size long),
+// for the library, which has the file and not a loaded module.
+inline bool XexHeaderRequiresKinect(const uint8_t* header, size_t size) {
+  auto be32 = [header](size_t at) {
+    return uint32_t(header[at]) << 24 | uint32_t(header[at + 1]) << 16 |
+           uint32_t(header[at + 2]) << 8 | uint32_t(header[at + 3]);
+  };
+  if (!header || size < 24 || be32(0) != 0x58455832) return false;  // "XEX2"
+  const uint32_t count = be32(0x14);
+  for (uint32_t n = 0; n < count && n < 64 && 0x18 + size_t(n) * 8 + 8 <= size; ++n)
+    if (be32(0x18 + size_t(n) * 8) == 0x00030100)
+      return SkeletalTrackingRequired(true, be32(0x18 + size_t(n) * 8 + 4));
+  return false;
+}
+
+// The executable as loaded: bytes from base, readable.
+struct CodeView {
+  const uint8_t* code = nullptr;
+  size_t bytes = 0;
+  uint32_t base = 0;
+  bool Has(uint32_t address, size_t size = 4) const {
+    return code && address >= base && uint64_t(address - base) + size <= bytes;
+  }
+  uint32_t Word(uint32_t address) const {
+    const uint8_t* p = code + (address - base);
+    return uint32_t(p[0]) << 24 | uint32_t(p[1]) << 16 | uint32_t(p[2]) << 8 | p[3];
+  }
+  uint8_t Byte(uint32_t address) const { return code[address - base]; }
+};
+
+constexpr uint32_t kMflrR12 = 0x7D8802A6;
+constexpr uint32_t kBlr = 0x4E800020;
+constexpr uint32_t kBctr = 0x4E800420;
+constexpr uint32_t kIdentityChangedMessage = 0x0002C00F;
+
+// "b"/"bl" (I-form, relative): its target, when link is as asked.
+inline bool RelativeBranch(uint32_t at, uint32_t word, bool link, uint32_t* target) {
+  if (word >> 26 != 18 || (word & 2) || bool(word & 1) != link) return false;
+  int32_t offset = int32_t(word & 0x03FFFFFC);
+  if (offset & 0x02000000) offset -= 0x04000000;
+  *target = at + uint32_t(offset);
+  return true;
+}
+
+// Whether an instruction reads general register r. Covers what compiled C uses
+// (D-form, X-form, rotates, stores); unknown forms count as reading, which only
+// makes the check refuse more.
+inline bool ReadsRegister(uint32_t w, unsigned r) {
+  const unsigned op = w >> 26, rd = (w >> 21) & 31, ra = (w >> 16) & 31, rb = (w >> 11) & 31;
+  switch (op) {
+    case 14: case 15:  // addi, addis: rA 0 is the constant 0
+      return ra != 0 && ra == r;
+    case 7: case 8: case 10: case 11: case 12: case 13:  // mulli subfic cmpli cmpi addic addic.
+      return ra == r;
+    case 24: case 25: case 26: case 27: case 28: case 29:  // ori oris xori xoris andi. andis.
+      return rd == r;
+    case 20: return rd == r || ra == r;               // rlwimi also keeps rA's bits
+    case 21: return rd == r;                          // rlwinm
+    case 23: return rd == r || rb == r;               // rlwnm
+    case 30: return rd == r || ((w >> 4) & 1 && rb == r);
+    case 32: case 33: case 34: case 35: case 40: case 41: case 42: case 43:
+    case 48: case 49: case 50: case 51: case 58:      // loads
+      return ra == r;
+    case 36: case 37: case 38: case 39: case 44: case 45: case 52: case 53:
+    case 54: case 55: case 62:                        // stores
+      return rd == r || ra == r;
+    case 16: case 17: case 18: case 19: return false;  // branches, sc, CR ops
+    case 31: {
+      const unsigned xo = (w >> 1) & 0x3FF;
+      switch (xo) {
+        // Logical and shift forms: rS (bits 21-25) and rB in, rA out.
+        case 28: case 60: case 124: case 284: case 316: case 412: case 444: case 476:
+        case 24: case 536: case 792: case 27: case 539: case 794:
+          return rd == r || rb == r;
+        case 824: case 26: case 58: case 922: case 954: case 986:  // srawi cntlz ext*
+          return rd == r;
+        case 339: case 371: case 19: case 83: return false;  // mfspr mftb mfcr mfmsr
+        case 467: case 144: return rd == r;                  // mtspr mtcrf
+        // Indexed stores: rS, rA and rB in.
+        case 151: case 183: case 215: case 247: case 407: case 439: case 149: case 181:
+        case 662: case 918: case 150: case 214: case 663: case 695: case 727: case 759:
+          return rd == r || ra == r || rb == r;
+        default:  // arithmetic, compares, indexed loads: rA and rB in
+          return ra == r || rb == r;
+      }
+    }
+    default: return true;
+  }
+}
+
+// Whether an instruction sets general register r (the forms ReadsRegister knows).
+inline bool WritesRegister(uint32_t w, unsigned r) {
+  const unsigned op = w >> 26, rd = (w >> 21) & 31, ra = (w >> 16) & 31;
+  switch (op) {
+    case 7: case 8: case 12: case 13: case 14: case 15:
+    case 32: case 34: case 40: case 42: case 58:
+      return rd == r;
+    case 33: case 35: case 41: case 43:  // update forms also set rA
+      return rd == r || ra == r;
+    case 20: case 21: case 23: case 24: case 25: case 26: case 27: case 28: case 29: case 30:
+      return ra == r;
+    case 31: {
+      const unsigned xo = (w >> 1) & 0x3FF;
+      switch (xo) {
+        case 28: case 60: case 124: case 284: case 316: case 412: case 444: case 476:
+        case 24: case 536: case 792: case 27: case 539: case 794: case 824: case 26:
+        case 58: case 922: case 954: case 986:
+          return ra == r;
+        case 0: case 32: case 151: case 183: case 215: case 247: case 407: case 439:
+        case 149: case 181: case 467: case 144:
+          return false;
+        default:
+          return rd == r;
+      }
+    }
+    default: return false;
+  }
+}
+
+// A register save helper (__savegprlr_N): only stores relative to r1, then blr.
+inline bool IsSaveHelper(const CodeView& view, uint32_t at) {
+  for (int n = 0; n < 40 && view.Has(at); ++n, at += 4) {
+    const uint32_t w = view.Word(at);
+    if (w == kBlr) return n > 0;
+    const unsigned op = w >> 26, ra = (w >> 16) & 31;
+    if (!((op == 62 || op == 36 || op == 54) && ra == 1)) return false;
+  }
+  return false;
+}
+
+// Whether the function at `at` may read r4 (its second argument) before it is set or a
+// call (other than the register save helper) replaces it.
+inline bool MayReadArgument(const CodeView& view, uint32_t at, const char** why) {
+  for (int n = 0; n < 96; ++n, at += 4) {
+    if (!view.Has(at)) { *why = "the refresh runs past the executable"; return true; }
+    const uint32_t w = view.Word(at);
+    uint32_t target = 0;
+    if (RelativeBranch(at, w, true, &target)) {
+      if (IsSaveHelper(view, target)) continue;
+      return false;  // r4 is volatile: the call's own value from here on
+    }
+    if (w == kBlr || RelativeBranch(at, w, false, &target)) return false;
+    if (ReadsRegister(w, 4)) { *why = "the refresh reads the message buffer"; return true; }
+    if (WritesRegister(w, 4)) return false;
+  }
+  *why = "the refresh's first block is too long to check";
+  return true;
+}
+
+struct IdentityCallbackCheck {
+  bool ok = false;
+  const char* why = "";
+  uint32_t event_case = 0;  // where the switch sends 2C00F
+  uint32_t refresh = 0;     // what that case calls
+};
+
+// The identity callback (r3 message, r4 buffer) the title registers with XMsg FE/2C009.
+// Its message switch, as the Kinect SDK compiles it:
+//   addis rX,r3,-3 / addi rX,rX,0x3FFE / cmplwi crN,rX,max / bgt default
+//   lis r12,T / addi r12,r12,t / lbzx r0,r12,rX / slwi r0,r0,2
+//   lis r12,B / [nop] / addi r12,r12,b / add r12,r12,r0 / mtctr r12 / bctr
+inline IdentityCallbackCheck CheckIdentityCallback(const CodeView& view, uint32_t callback) {
+  IdentityCallbackCheck result;
+  if ((callback & 3) || !view.Has(callback, 8)) { result.why = "not in the executable"; return result; }
+  if (view.Word(callback) != kMflrR12) { result.why = "not the start of a function"; return result; }
+  int state = 0;
+  unsigned index_reg = 0, table_reg = 0, byte_reg = 0;
+  int32_t offset = 0;
+  uint32_t max = 0, table = 0, jump_base = 0;
+  int32_t high[32] = {};
+  bool has_high[32] = {};
+  for (int n = 1; n < 48 && state < 7; ++n) {
+    const uint32_t at = callback + 4 * uint32_t(n);
+    if (!view.Has(at)) break;
+    const uint32_t w = view.Word(at);
+    if (w == kBlr) break;
+    const unsigned op = w >> 26, rd = (w >> 21) & 31, ra = (w >> 16) & 31, rb = (w >> 11) & 31;
+    const int32_t simm = int16_t(w & 0xFFFF);
+    if (op == 15 && ra == 0) { high[rd] = simm * 65536; has_high[rd] = true; continue; }  // lis
+    const bool pair = op == 14 && ra == rd && rd != 0 && has_high[rd];  // lis/addi value
+    if (state == 0 && op == 15 && ra == 3) { index_reg = rd; offset = simm * 65536; state = 1; }
+    else if (state == 1 && op == 14 && rd == index_reg && ra == index_reg) { offset += simm; state = 2; }
+    else if (state == 2 && op == 10 && ra == index_reg) { max = w & 0xFFFF; state = 3; }
+    else if (state == 3 && pair) { table = uint32_t(high[rd] + simm); table_reg = rd; state = 4; }
+    else if (state == 4 && op == 31 && ((w >> 1) & 0x3FF) == 87 && ra == table_reg && rb == index_reg) {
+      byte_reg = rd; state = 5;
+    } else if (state == 5 && op == 21 && rd == byte_reg && ra == byte_reg && ((w >> 11) & 31) == 2 &&
+               ((w >> 6) & 31) == 0 && ((w >> 1) & 31) == 29) {
+      state = 6;  // slwi by 2
+    } else if (state == 6 && pair) { jump_base = uint32_t(high[rd] + simm); state = 7; }
+    if (op != 15)
+      for (unsigned r = 0; r < 32; ++r)
+        if (WritesRegister(w, r)) has_high[r] = false;
+  }
+  if (state < 7) { result.why = "no message switch at its start"; return result; }
+  const uint32_t index = kIdentityChangedMessage + uint32_t(offset);
+  if (index > max) { result.why = "its switch has no identity-changed case"; return result; }
+  if (!view.Has(table + index, 1)) { result.why = "its switch table is not in the executable"; return result; }
+  result.event_case = jump_base + uint32_t(view.Byte(table + index)) * 4;
+  uint32_t refresh = 0, out = 0;
+  if (!view.Has(result.event_case, 8) ||
+      !RelativeBranch(result.event_case, view.Word(result.event_case), true, &refresh) ||
+      !RelativeBranch(result.event_case + 4, view.Word(result.event_case + 4), false, &out)) {
+    result.why = "its identity-changed case is not a single call";
+    return result;
+  }
+  result.refresh = refresh;
+  if (!view.Has(refresh) || view.Word(refresh) != kMflrR12) {
+    result.why = "the identity-changed case does not call a function";
+    return result;
+  }
+  if (MayReadArgument(view, refresh + 4, &result.why)) return result;
+  result.ok = true;
+  return result;
+}
+
+// The relative calls of target ("bl"): where they are.
+inline std::vector<uint32_t> CallsOf(const CodeView& view, uint32_t target) {
+  std::vector<uint32_t> calls;
+  for (size_t at = 0; at + 4 <= view.bytes; at += 4) {
+    const uint32_t address = view.base + uint32_t(at), w = view.Word(address);
+    uint32_t to = 0;
+    if (RelativeBranch(address, w, true, &to) && to == target) calls.push_back(address);
+  }
+  return calls;
+}
+
+// Dragon Ball Z for Kinect's hand reach seam: "lis r11,X" followed by "lfs fN,0x2710(r30)",
+// the first read of the hand reach the handler writes. Exactly one must exist.
+struct HandSeam {
+  uint32_t site = 0;
+  uint64_t r11 = 0;  // what the replaced lis loads, sign-extended as on the console
+  size_t matches = 0;
+};
+inline HandSeam FindHandSeam(const CodeView& view) {
+  HandSeam seam;
+  for (size_t at = 0; at + 8 <= view.bytes; at += 4) {
+    const uint32_t address = view.base + uint32_t(at);
+    const uint32_t w = view.Word(address);
+    if ((w & 0xFFFF0000) != 0x3D600000) continue;                   // lis r11,X
+    if ((view.Word(address + 4) & 0xFC1FFFFF) != 0xC01E2710) continue;  // lfs f?,0x2710(r30)
+    if (++seam.matches == 1) {
+      seam.site = address;
+      seam.r11 = uint64_t(int64_t(int32_t(w << 16)));
+    }
+  }
+  if (seam.matches != 1) seam.site = 0;
+  return seam;
+}
+
+// The thresholds the hand reach code compares with, read where the seam's lis points: right
+// after it the title forms a base ("addi rB,r11,b") and loads its constants from it ("lfs
+// f,d(rB)"; DBZ 821B4DB8-821B4DC8: 0x9C the reach, 0x610 and 0x60C the direction, -/+). The
+// reach threshold is the first load, the direction one the positive one of the others.
+struct HandThresholds {
+  bool found = false;
+  float reach = 0.4f, direction = 0.7071f;
+};
+inline float FloatAt(const CodeView& view, uint32_t address) {
+  const uint32_t bits = view.Word(address);
+  float value;
+  std::memcpy(&value, &bits, 4);
+  return value;
+}
+inline HandThresholds FindHandThresholds(const CodeView& view, const HandSeam& seam) {
+  HandThresholds result;
+  if (!seam.site || !view.Has(seam.site + 8)) return result;
+  // "addi rB, r11, b" within the two instructions after the seam's lfs.
+  int base_reg = -1;
+  uint32_t base = 0;
+  for (uint32_t at = seam.site + 8; at <= seam.site + 12 && view.Has(at); at += 4) {
+    const uint32_t w = view.Word(at);
+    if (w >> 26 == 14 && ((w >> 16) & 31) == 11) {
+      base_reg = int((w >> 21) & 31);
+      base = uint32_t(seam.r11) + uint32_t(int32_t(int16_t(w & 0xFFFF)));
+      break;
+    }
+  }
+  if (base_reg < 0) return result;
+  std::vector<float> loads;
+  for (uint32_t at = seam.site + 8; at < seam.site + 0x30 && view.Has(at); at += 4) {
+    const uint32_t w = view.Word(at);
+    if (w >> 26 == 48 && int((w >> 16) & 31) == base_reg) {
+      const uint32_t address = base + uint32_t(int32_t(int16_t(w & 0xFFFF)));
+      if (!view.Has(address)) return result;
+      loads.push_back(FloatAt(view, address));
+    }
+  }
+  if (loads.size() < 2) return result;
+  float direction = 0;
+  for (size_t n = 1; n < loads.size(); ++n) direction = std::max(direction, loads[n]);
+  if (!(loads[0] > 0.05f && loads[0] < 2.0f && direction > 0.1f && direction < 1.0f)) return result;
+  result.found = true;
+  result.reach = loads[0];
+  result.direction = direction;
+  return result;
+}
