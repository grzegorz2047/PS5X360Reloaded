index 0000000..4e31ff8
--- /dev/null
+++ b/include/xbox360ps5/body_scale.hpp
@@ -0,0 +1,289 @@
+// SPDX-License-Identifier: MIT
+// Fix 57: the phone's pose brought to a plausible body size before a game sees it.
+//
+// The phone page sends MediaPipe's world landmarks (metres, around the hips). On
+// 1.0.4_candidate_25 the shoulder-to-hand distance averaged 0.37/0.36 m over a Dragon Ball Z
+// session, where an adult's straight arm is about 0.64 m, and the game's own reach for an arm
+// held out stayed at 0.2-0.35 against its 0.4 threshold. Kinect measures the body; a
+// monocular model guesses its size, and its arms come out short.
+//
+// So, per phone session, the length of the torso (hip centre to shoulder centre) and of each
+// arm bone (shoulder-elbow, elbow-wrist, wrist-hand) are followed while the joints are seen
+// well (an exponential average, about a second), and every frame:
+//  - the whole body is scaled around the hip centre so the torso is kTorsoMetres (an adult of
+//    about 1.75 m; at most x2, at least x0.8);
+//  - each arm is rebuilt from its shoulder with the bones' current directions and lengths of
+//    at least 90 % of an adult's (upper arm 0.30 m, forearm 0.26 m, hand 0.08 m, in
+//    proportion to the torso), so a bent arm keeps a real elbow instead of a collapsed one.
+// The hip centre stays where the phone put it (the body's place in the room is the page's
+// calibration). Joints the phone did not see keep their confidence; nothing is invented.
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <mutex>
+
+#include "xbox360ps5/motion_input.hpp"
+
+namespace xbox360ps5::motion {
+
+constexpr float kTorsoMetres = 0.52f;
+constexpr float kUpperArmMetres = 0.30f, kForearmMetres = 0.26f, kHandMetres = 0.08f;
+constexpr float kMinimumBoneShare = 0.9f;
+constexpr float kLargestBodyScale = 2.0f, kSmallestBodyScale = 0.8f;
+// 1.0.5_candidate_2: a bent arm whose hand is by its shoulder in the picture (an adult's metres).
+constexpr float kNearShoulderFlat = 0.12f, kBentElbowDegrees = 125.0f;
+// 1.0.5_candidate_3: the body's depth is re-centred on the bridge's body distance (Z = 0 at
+// 2.5 m) over about five seconds. The phone page calibrates the distance from the body's size
+// in its first second, as if the player stood at its "distance" setting; started near the phone,
+// it put every recording of 1.0.5_candidate_1/2 at its 3.8 m limit (hips at Z -1.30 throughout),
+// beyond Dragon Ball Z's 1.8-3.5 m: "Step closer" all the time and a raised hand ignored. Steps
+// towards and away still show; only the lasting offset goes.
+constexpr float kDepthCentreWeight = 1.0f / 150.0f;
+// 1.0.5_candidate_4: a jump of the hips' depth between two frames no body can make (the phone
+// page's "Recenter", a new calibration) takes the new depth at once instead of over seconds.
+constexpr float kDepthJumpMetres = 0.4f;
+// 1.0.5_candidate_10: a step away or towards the camera that comes back is the player's move, not
+// an offset: Dragon Ball Z's back dodge on 1.0.5_candidate_8 took the hips 0.27-0.37 m back for
+// about a second, and the average took 0.04 m of it. While the hips are more than kAwayMetres
+// from the average the average waits, unless they have stayed there for kAwayFrames (2 s at
+// 30 frames/s): then the offset is a lasting one and is taken over the usual five seconds.
+constexpr float kAwayMetres = 0.15f;
+constexpr int kAwayFrames = 60;
+// 1.0.5_candidate_8: a forearm cannot get from pointing towards the camera to pointing away from
+// it without passing the picture plane, where its depth is small. In the 13 recordings of
+// 1.0.5_candidate_1..5 the phone did that rarely (3 jumps, one left forearm in one file; upper
+// arms never); the near-shoulder rule (kNearShoulderFlat) did it often, switching on and off as
+// the hand came near its shoulder (runs of 1-5 frames with the forearm the other side). A forearm whose depth
+// share |dz|/L is past kPlaneShare on both sides of such a jump keeps its old side for
+// kSignHoldFrames, then turns to the new one over 1/kSignTurnStep frames, the middle one in the
+// plane (with 3, a steep forearm still went from +0.47 to -0.47 in one); a jump
+// back within the hold leaves nothing. A pose held on the new side (hands on the shoulders) gets
+// there in about a third of a second. Depth noise is not filtered: frame to frame the phone's z is as steady as
+// its x and y (2-3 mm), and a filter would only add delay to the 15 updates DBZ holds a hand for.
+constexpr float kPlaneShare = 0.3f;
+constexpr int kSignHoldFrames = 6;
+constexpr float kSignTurnStep = 0.25f;
+// pose.mjs joint order.
+constexpr int kHipCentre = 0, kShoulderCentre = 2;
+constexpr int kLeftArm[4] = {4, 5, 6, 7}, kRightArm[4] = {8, 9, 10, 11};
+
+// One forearm's depth side over time (KeepDepthSides).
+struct DepthSide {
+  bool set = false;
+  float last = 0;   // the forearm's depth share in the last frame, before this rule
+  float turn = 0;   // 0: as given; 1: mirrored to its old side; between: turning through the plane
+  int hold = 0;     // frames left on the old side
+};
+
+struct BodyScaleState {
+  uint32_t session = 0, sequence = 0;
+  float torso = 0;                 // averaged, metres as the phone gave them
+  float bones[2][3] = {};          // [left, right][upper, fore, hand], averaged
+  float factor = 1;                // the last scale applied
+  float hip_z = 0;                 // the hips' depth, averaged over about five seconds
+  bool hip_z_set = false;
+  float last_hip_z = 0;            // the hips' depth in the frame before
+  int away_frames = 0;             // frames in a row the hips were kAwayMetres from hip_z
+  uint32_t jumps = 0;              // depth jumps taken at once (1.0.5_candidate_6: logged)
+  float jump_from = 0, jump_to = 0;
+  DepthSide forearm[2];            // [left, right]
+  uint32_t sides_held = 0;         // forearm jumps across the picture plane held (logged)
+  Frame last_in{}, last_out{};     // the last frame normalised (for repeated asks)
+};
+
+inline float Distance(const Joint& a, const Joint& b) {
+  const float dx = a.x - b.x, dy = a.y - b.y, dz = a.z - b.z;
+  return std::sqrt(dx * dx + dy * dy + dz * dz);
+}
+inline bool Seen(const Joint& joint) { return joint.confidence >= 0.5f; }
+// The angle at the elbow, degrees (180: straight).
+inline float ElbowDegrees(const Joint& shoulder, const Joint& elbow, const Joint& wrist) {
+  const float ax = shoulder.x - elbow.x, ay = shoulder.y - elbow.y, az = shoulder.z - elbow.z;
+  const float bx = wrist.x - elbow.x, by = wrist.y - elbow.y, bz = wrist.z - elbow.z;
+  const float la = std::sqrt(ax * ax + ay * ay + az * az), lb = std::sqrt(bx * bx + by * by + bz * bz);
+  if (la < 1e-4f || lb < 1e-4f) return 180;
+  return std::acos(std::clamp((ax * bx + ay * by + az * bz) / (la * lb), -1.0f, 1.0f)) * 57.29578f;
+}
+
+// One step of the averages for a new frame (weight 0.08: about a second at 30 frames/s).
+inline void ObserveBody(BodyScaleState& state, const Frame& pose) {
+  if (pose.session != state.session) state = BodyScaleState{pose.session};
+  constexpr float kWeight = 0.08f;
+  const auto average = [](float& value, float sample) {
+    if (!(sample > 0.05f && sample < 2.0f)) return;
+    value = value > 0 ? value + kWeight * (sample - value) : sample;
+  };
+  if (Seen(pose.joints[kHipCentre]) && Seen(pose.joints[kShoulderCentre]))
+    average(state.torso, Distance(pose.joints[kHipCentre], pose.joints[kShoulderCentre]));
+  if (pose.tracked && std::isfinite(pose.joints[kHipCentre].z)) {
+    const float z = pose.joints[kHipCentre].z;
+    const bool jump = state.hip_z_set && std::fabs(z - state.last_hip_z) > kDepthJumpMetres;
+    if (jump) {
+      ++state.jumps;
+      state.jump_from = state.last_hip_z;
+      state.jump_to = z;
+    }
+    const bool away = state.hip_z_set && std::fabs(z - state.hip_z) > kAwayMetres;
+    state.away_frames = away && !jump ? state.away_frames + 1 : 0;
+    const bool waits = away && state.away_frames <= kAwayFrames;
+    state.hip_z = !state.hip_z_set || jump ? z
+                  : waits                 ? state.hip_z
+                                          : state.hip_z + kDepthCentreWeight * (z - state.hip_z);
+    state.hip_z_set = true;
+    state.last_hip_z = z;
+  }
+  for (int side = 0; side < 2; ++side) {
+    const int* arm = side ? kRightArm : kLeftArm;
+    for (int bone = 0; bone < 3; ++bone)
+      if (Seen(pose.joints[arm[bone]]) && Seen(pose.joints[arm[bone + 1]]))
+        average(state.bones[side][bone], Distance(pose.joints[arm[bone]], pose.joints[arm[bone + 1]]));
+  }
+}
+
+// The frame as the games get it: scaled and with its arms rebuilt (see above).
+inline Frame NormalizeBody(const BodyScaleState& state, const Frame& pose, float* factor_out = nullptr) {
+  Frame out = pose;
+  if (!pose.tracked || !(state.torso > 0)) {
+    if (factor_out) *factor_out = 1;
+    return out;
+  }
+  const float factor = std::clamp(kTorsoMetres / state.torso, kSmallestBodyScale, kLargestBodyScale);
+  if (factor_out) *factor_out = factor;
+  const Joint hip = pose.joints[kHipCentre];
+  const float recentre = state.hip_z_set ? -state.hip_z : 0.0f;
+  for (auto& joint : out.joints) {
+    joint.x = hip.x + (joint.x - hip.x) * factor;
+    joint.y = hip.y + (joint.y - hip.y) * factor;
+    joint.z = hip.z + (joint.z - hip.z) * factor + recentre;
+  }
+  // The body's size after scaling, as a share of an adult's (1 unless the scale was clamped).
+  const float size = state.torso * factor / kTorsoMetres;
+  const float adult[3] = {kUpperArmMetres * size, kForearmMetres * size, kHandMetres * size};
+  for (int side = 0; side < 2; ++side) {
+    const int* arm = side ? kRightArm : kLeftArm;
+    Joint previous_in = out.joints[arm[0]];  // the scaled shoulder, unchanged
+    for (int bone = 0; bone < 3; ++bone) {
+      Joint& next = out.joints[arm[bone + 1]];
+      const Joint next_in = next;
+      const float dx = next_in.x - previous_in.x, dy = next_in.y - previous_in.y;
+      float dz = next_in.z - previous_in.z;
+      const Joint& from = out.joints[arm[bone]];
+      const float flat = std::sqrt(dx * dx + dy * dy);
+      const float measured = state.bones[side][bone] > 0 ? state.bones[side][bone] * factor
+                                                         : std::sqrt(flat * flat + dz * dz);
+      // 1.0.5_candidate_1: a bone can only point as far towards or away from the camera as its
+      // picture-plane length leaves room for: |dz| <= sqrt(L^2 - flat^2). The model's depth is
+      // kept when it fits (a punch at the camera: the bones look short), cut when it does not
+      // (1.0.4_candidate_28: hands "on the shoulders" 0.12-0.53 m in front of them, both bones
+      // seen at nearly full length). Depth is never added.
+      const float room = flat < measured ? std::sqrt(measured * measured - flat * flat) : 0.0f;
+      if (std::fabs(dz) > room) dz = std::copysign(room, dz);
+      const float now = std::sqrt(flat * flat + dz * dz);
+      if (now > 1e-4f) {
+        const float length = std::max(measured, kMinimumBoneShare * adult[bone]);
+        next.x = from.x + dx / now * length;
+        next.y = from.y + dy / now * length;
+        next.z = from.z + dz / now * length;
+      }
+      previous_in = next_in;
+    }
+    // 1.0.5_candidate_2: a phone sees how far a forearm points towards or away from it, not which
+    // way. The motion recordings of 1.0.5_candidate_1 ("hands on the shoulders", DBZ's charge)
+    // had each hand on its shoulder in the picture (within 0.05 m) but 0.36-0.38 m in front of
+    // it: the elbow forward by 0.15 m (right) and the forearm forward by 0.2 m more (wrong: it
+    // comes back to the shoulder). With the hand by its shoulder in the picture and the elbow
+    // bent, the forearm (and the hand) take the depth sign that puts the hand nearer the
+    // shoulder. A straight arm at the camera (a punch) is not bent and keeps its depth.
+    const Joint& shoulder = out.joints[arm[0]];
+    Joint& elbow = out.joints[arm[1]];
+    Joint& wrist = out.joints[arm[2]];
+    Joint& hand = out.joints[arm[3]];
+    const float flat_to_shoulder = std::hypot(hand.x - shoulder.x, hand.y - shoulder.y);
+    if (flat_to_shoulder < kNearShoulderFlat * size && ElbowDegrees(shoulder, elbow, wrist) < kBentElbowDegrees) {
+      Joint wrist_flipped = wrist, hand_flipped = hand;
+      wrist_flipped.z = elbow.z - (wrist.z - elbow.z);
+      hand_flipped.z = wrist_flipped.z - (hand.z - wrist.z);
+      if (Distance(hand_flipped, shoulder) < Distance(hand, shoulder)) {
+        wrist = wrist_flipped;
+        hand = hand_flipped;
+      }
+    }
+  }
+  return out;
+}
+
+// The forearm's (and hand's) depth relative to the elbow, kept on its side across a jump through
+// the picture plane (see kPlaneShare); one call per new frame, after NormalizeBody.
+inline void KeepDepthSides(BodyScaleState& state, Frame& out) {
+  if (!out.tracked) return;
+  for (int side = 0; side < 2; ++side) {
+    const int* arm = side ? kRightArm : kLeftArm;
+    DepthSide& depth = state.forearm[side];
+    const Joint& elbow = out.joints[arm[1]];
+    Joint& wrist = out.joints[arm[2]];
+    Joint& hand = out.joints[arm[3]];
+    const float length = Distance(elbow, wrist);
+    if (!Seen(elbow) || !Seen(wrist) || length < 1e-4f) {
+      depth = {};
+      continue;
+    }
+    const float share = (wrist.z - elbow.z) / length;
+    if (depth.set && share * depth.last < 0 && std::fabs(share) > kPlaneShare &&
+        std::fabs(depth.last) > kPlaneShare) {
+      depth.turn = 1 - depth.turn;  // the output stays where it was
+      depth.hold = depth.turn > 0.5f ? kSignHoldFrames : 0;
+      if (depth.turn > 0.5f) ++state.sides_held;
+    }
+    depth.set = true;
+    depth.last = share;
+    if (depth.hold > 0) {
+      --depth.hold;
+    } else {
+      depth.turn = std::max(0.0f, depth.turn - kSignTurnStep);
+    }
+    if (depth.turn > 0) {
+      const float mirror = 1 - 2 * depth.turn;
+      const float wrist_z = wrist.z;
+      wrist.z = elbow.z + mirror * (wrist_z - elbow.z);
+      hand.z = wrist.z + mirror * (hand.z - wrist_z);
+    }
+  }
+}
+
+// The process-wide state: the newest phone frame, normalised once per frame.
+inline std::mutex body_scale_mutex;
+inline BodyScaleState body_scale;
+inline Frame NormalizedSnapshot(float* factor_out = nullptr) {
+  const Frame pose = Snapshot();
+  std::lock_guard lock(body_scale_mutex);
+  if (pose.tracked && (pose.session != body_scale.session || pose.sequence != body_scale.sequence)) {
+    ObserveBody(body_scale, pose);
+    body_scale.sequence = pose.sequence;
+    body_scale.last_in = pose;
+    body_scale.last_out = NormalizeBody(body_scale, pose, &body_scale.factor);
+    KeepDepthSides(body_scale, body_scale.last_out);
+  }
+  if (factor_out) *factor_out = pose.tracked ? body_scale.factor : 1;
+  if (!pose.tracked) return pose;
+  // Snapshot() may mark a frame untracked once it is old; the cached output follows it.
+  return pose.sequence == body_scale.sequence && pose.session == body_scale.session ? body_scale.last_out
+                                                                                     : pose;
+}
+// For the log: the averages' phone session, its depth jumps so far and the last one (hips' Z).
+struct BodyScaleReport {
+  uint32_t session = 0, jumps = 0;
+  float jump_from = 0, jump_to = 0, hip_z = 0;
+  uint32_t sides_held = 0;  // forearm jumps across the picture plane held so far (this session)
+};
+inline BodyScaleReport ReportBodyScale() {
+  std::lock_guard lock(body_scale_mutex);
+  return {body_scale.session, body_scale.jumps, body_scale.jump_from, body_scale.jump_to, body_scale.hip_z,
+          body_scale.sides_held};
+}
+inline void ResetBodyScale() {
+  std::lock_guard lock(body_scale_mutex);
+  body_scale = {};
+}
+
+}  // namespace xbox360ps5::motion
