--- /dev/null
+++ b/include/xbox360ps5/nui_hud.hpp
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: MIT
+// Fix 118 (Kinect Sports, issue 15): the Kinect system windows with the virtual Kinect. A Kinect
+// title opens its system windows through XamShowNui*UI (the save device, sign-in, message boxes),
+// and each of those asks the NUI HUD check first (xenia/kernel/nui.cc, NuiHudCheck). The check
+// wanted the console's "Kinect initialized" retail flag, which this console's settings never have,
+// so every one of them was refused (access denied) before its window: Kinect Sports, with a
+// signed-in profile picked as the player ("Player"; Guest does not save), asks where to save with
+// XamShowNuiDeviceSelectorUI once a frame, got the refusal each time and never went on (its hand
+// cursors gone, the device id it passed still 0). While the virtual Kinect serves a title that
+// requires Kinect, it is the sensor these windows are drawn for, so the check lets them through to
+// the ordinary windows (the save drive from the settings or the drive window, the sign-in, the
+// message box). Nothing else changes: with the motion option off, and for titles where Kinect is
+// optional (they keep their own SDK and the controller, and would wait for services this console
+// does not have, as XamContentOpenFile's note on 4D5309C9 says), the check refuses as before.
+#pragma once
+
+namespace xbox360ps5::motion {
+
+// The NUI HUD check's answer: `nui_data` is the NUI library's state the check reads (its data
+// pointer and the flag at 0x50 in it), `kinect_initialized` the console's retail flag and
+// `virtual_kinect` the virtual Kinect on for a title that requires Kinect.
+inline bool NuiHudAllowed(bool nui_data, bool kinect_initialized, bool virtual_kinect) {
+  return nui_data && (kinect_initialized || virtual_kinect);
+}
+
+}  // namespace xbox360ps5::motion
