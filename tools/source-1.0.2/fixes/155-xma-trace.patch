diff --git a/include/xbox360ps5/xma_trace.hpp b/include/xbox360ps5/xma_trace.hpp
new file mode 100644
--- /dev/null
+++ b/include/xbox360ps5/xma_trace.hpp
@@ -0,0 +1,236 @@
+// SPDX-License-Identifier: MIT
+// Fix 155: a trace of the emulator's XMA contexts, to tell why GTA V's audio stops.
+//
+// Grand Theft Auto V froze ~100 s into the prologue on every decoder ("new", "old", Xenia's
+// original, each with and without its own thread): its audio thread loops at 83140450-8314049C,
+// taking decoded output from an XMA stream (836A9768) until it has as many bytes as its own counters
+// say were produced; the stream's context gives none, the loop never sleeps and never kicks the
+// decoder again, and the main thread waits for the audio thread every frame. The game drives the XMA
+// hardware itself (its contexts, the current-context register 0606h). This records, per context:
+//  * each kick (XMAEnableContext): the context's fields before and after the decoder's work: input
+//    buffers 0/1 valid and packet counts, input read offset and current buffer, output buffer valid,
+//    write/read offsets and size in 256-byte blocks, error and parser error, loop count, stop when
+//    done; the output blocks it added; a kick that added none while it had input is "without output";
+//  * locks (XMADisableContext), clears (fix 67's watch lifts with them), allocations and releases;
+//  * reads of register 0606h (the current context index the game compares against).
+// Lines: the first 4 kicks of each context (64 in all); a context's error or parser error when it
+// appears (32 in all); each of fix 67's watch lifts (16); every 30 s with activity a summary; and
+// when no context was kicked for 5 s while some are allocated (a game's audio stopped), once per
+// such silence (3 in all), each allocated context's totals, its fields now and its last 8 events.
+#pragma once
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace xbox360ps5::xma_trace {
+
+constexpr uint32_t kContexts = 320;
+constexpr uint32_t kHistory = 8;
+constexpr uint32_t kFirstKicks = 4, kKickLines = 64, kErrorLines = 32, kUnwatchLines = 16, kSilences = 3;
+constexpr uint64_t kSummaryMs = 30000, kSilenceMs = 5000;
+
+inline uint32_t Be32(const uint8_t* p) {
+  return uint32_t(p[0]) << 24 | uint32_t(p[1]) << 16 | uint32_t(p[2]) << 8 | uint32_t(p[3]);
+}
+
+// The fields of a 64-byte XMA context as the guest stores it (big-endian dwords; XMA_CONTEXT_DATA).
+struct Fields {
+  uint32_t packets0 = 0, packets1 = 0, loop_count = 0, valid0 = 0, valid1 = 0, blocks = 0, write = 0;
+  uint32_t output_valid = 0, read_offset = 0, error = 0, error_set = 0, parser_error = 0, parser_error_set = 0;
+  uint32_t current_buffer = 0, input0 = 0, input1 = 0, output = 0, read = 0, stop_when_done = 0;
+};
+inline Fields Decode(const uint8_t* raw) {
+  Fields f;
+  const uint32_t d0 = Be32(raw), d1 = Be32(raw + 4), d2 = Be32(raw + 8), d3 = Be32(raw + 12), d4 = Be32(raw + 16);
+  const uint32_t d9 = Be32(raw + 36);
+  f.packets0 = d0 & 0xFFF, f.loop_count = (d0 >> 12) & 0xFF, f.valid0 = (d0 >> 20) & 1, f.valid1 = (d0 >> 21) & 1;
+  f.blocks = (d0 >> 22) & 0x1F, f.write = d0 >> 27;
+  f.packets1 = d1 & 0xFFF, f.output_valid = d1 >> 31;
+  f.read_offset = d2 & 0x3FFFFFF, f.error = (d2 >> 26) & 0x1F, f.error_set = d2 >> 31;
+  f.parser_error = (d3 >> 26) & 0x1F, f.parser_error_set = d3 >> 31;
+  f.current_buffer = d4 >> 31;
+  f.input0 = Be32(raw + 20), f.input1 = Be32(raw + 24), f.output = Be32(raw + 28);
+  f.read = d9 & 0x1F, f.stop_when_done = (d9 >> 30) & 1;
+  return f;
+}
+inline std::string Describe(const Fields& f) {
+  char text[256];
+  std::snprintf(text, sizeof(text),
+                "in0 %s %up @%08X, in1 %s %up @%08X, buffer %u read %u bits, out %s write %u read %u of %u blocks "
+                "@%08X, error %u%s, parser %u%s, loops %u%s",
+                f.valid0 ? "valid" : "empty", f.packets0, f.input0, f.valid1 ? "valid" : "empty", f.packets1, f.input1,
+                f.current_buffer, f.read_offset, f.output_valid ? "valid" : "off", f.write, f.read, f.blocks, f.output,
+                f.error, f.error_set ? " set" : "", f.parser_error, f.parser_error_set ? " set" : "", f.loop_count,
+                f.stop_when_done ? ", stop when done" : "");
+  return text;
+}
+// Output blocks a decoder pass added: the write offset's advance around the ring of `blocks`.
+inline uint32_t BlocksAdded(const Fields& before, const Fields& after) {
+  const uint32_t ring = after.blocks ? after.blocks : 32;
+  return (after.write + ring - before.write % ring) % ring;
+}
+
+enum class Kind : uint8_t { kKick, kLock, kClear, kAllocate, kRelease };
+inline const char* KindName(Kind k) {
+  switch (k) {
+    case Kind::kKick: return "kick";
+    case Kind::kLock: return "lock";
+    case Kind::kClear: return "clear";
+    case Kind::kAllocate: return "allocate";
+    default: return "release";
+  }
+}
+struct Event {
+  uint64_t ms = 0;
+  Kind kind = Kind::kKick;
+  Fields before, after;
+};
+struct Context {
+  uint64_t kicks = 0, without_output = 0, locks = 0, clears = 0, blocks_out = 0, buffers_used = 0, errors = 0;
+  uint64_t last_kick_ms = 0;
+  bool allocated = false;
+  Event history[kHistory];
+  uint32_t next = 0, count = 0;
+  void Note(const Event& e) {
+    history[next] = e;
+    next = (next + 1) % kHistory;
+    if (count < kHistory) ++count;
+  }
+};
+struct Period {
+  uint64_t kicks = 0, without_output = 0, locks = 0, clears = 0, allocations = 0, releases = 0, reads_0606 = 0,
+           errors = 0;
+  std::vector<bool> kicked = std::vector<bool>(kContexts, false);
+};
+
+class Trace {
+ public:
+  // A kick's fields before and after the decoder's pass; a line to log, if any.
+  std::vector<std::string> Kick(uint32_t id, uint32_t guest, const uint8_t* before_raw, const uint8_t* after_raw,
+                                uint64_t ms) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    std::vector<std::string> lines;
+    if (id >= kContexts) return lines;
+    Context& c = contexts_[id];
+    Event e{ms, Kind::kKick, Decode(before_raw), Decode(after_raw)};
+    const uint32_t added = BlocksAdded(e.before, e.after);
+    const bool had_input = e.before.valid0 || e.before.valid1;
+    ++c.kicks, ++period_.kicks, period_.kicked[id] = true;
+    c.blocks_out += added;
+    c.buffers_used += (e.before.valid0 && !e.after.valid0) + (e.before.valid1 && !e.after.valid1);
+    if (!added && had_input) ++c.without_output, ++period_.without_output;
+    c.last_kick_ms = ms, last_kick_ms_ = ms, last_kick_id_ = id, silent_logged_ = false;
+    c.Note(e);
+    if (c.kicks <= kFirstKicks && kick_lines_ < kKickLines) {
+      ++kick_lines_;
+      lines.push_back(Line("kick ctx %u (%08X) #%llu: +%u blocks; before %s; after %s", id, guest,
+                           (unsigned long long)c.kicks, added, Describe(e.before).c_str(), Describe(e.after).c_str()));
+    }
+    const bool new_error = (e.after.error_set && !e.before.error_set) ||
+                           (e.after.parser_error_set && !e.before.parser_error_set);
+    if (new_error) {
+      ++c.errors, ++period_.errors;
+      if (error_lines_ < kErrorLines) {
+        ++error_lines_;
+        lines.push_back(Line("ctx %u (%08X) error after kick #%llu: %s", id, guest, (unsigned long long)c.kicks,
+                             Describe(e.after).c_str()));
+      }
+    }
+    return lines;
+  }
+  void Other(Kind kind, uint32_t id, const uint8_t* before_raw, const uint8_t* after_raw, uint64_t ms) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (id >= kContexts) return;
+    Context& c = contexts_[id];
+    Event e{ms, kind, Decode(before_raw), Decode(after_raw)};
+    if (kind == Kind::kLock) ++c.locks, ++period_.locks;
+    if (kind == Kind::kClear) ++c.clears, ++period_.clears;
+    if (kind == Kind::kAllocate) c = Context{}, c.allocated = true, ++period_.allocations;
+    if (kind == Kind::kRelease) c.allocated = false, ++period_.releases;
+    c.Note(e);
+  }
+  void Read0606(uint32_t value) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    ++period_.reads_0606;
+    last_0606_ = value;
+  }
+  std::optional<std::string> Unwatch(uint32_t id, uint32_t address) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (unwatch_lines_ >= kUnwatchLines) return std::nullopt;
+    ++unwatch_lines_;
+    return Line("fix 67 lifted the memory watch on ctx %u at %08X before its clear (lift %u)", id, address,
+                unwatch_lines_);
+  }
+  // Once a second: the 30 s summary, and the dump of a silence. `raw(id)` gives a context's bytes now.
+  template <typename Raw>
+  std::vector<std::string> Poll(uint64_t ms, Raw raw) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    std::vector<std::string> lines;
+    if (!period_start_ || ms < period_start_) period_start_ = ms;  // the first poll, or a clock gone back
+    if (ms - period_start_ >= kSummaryMs) {
+      uint32_t kicked = 0, allocated = 0;
+      for (uint32_t i = 0; i < kContexts; ++i) kicked += period_.kicked[i], allocated += contexts_[i].allocated;
+      if (period_.kicks || period_.allocations || period_.releases || period_.reads_0606)
+        lines.push_back(Line("last %llu s: %llu kicks on %u contexts, %llu without output; %llu locks, %llu clears, "
+                             "%llu allocated, %llu released (%u allocated now); register 0606h read %llu times (last "
+                             "%u); %llu new errors",
+                             (unsigned long long)((ms - period_start_) / 1000), (unsigned long long)period_.kicks,
+                             kicked, (unsigned long long)period_.without_output, (unsigned long long)period_.locks,
+                             (unsigned long long)period_.clears, (unsigned long long)period_.allocations,
+                             (unsigned long long)period_.releases, allocated, (unsigned long long)period_.reads_0606,
+                             last_0606_, (unsigned long long)period_.errors));
+      period_ = Period{};
+      period_start_ = ms;
+    }
+    uint32_t allocated = 0;
+    for (uint32_t i = 0; i < kContexts; ++i) allocated += contexts_[i].allocated;
+    if (last_kick_ms_ && ms >= last_kick_ms_ && !silent_logged_ && ms - last_kick_ms_ >= kSilenceMs && allocated && silences_ < kSilences) {
+      silent_logged_ = true;
+      ++silences_;
+      lines.push_back(Line("no context kicked for %.1f s (the last: ctx %u); %u allocated:",
+                           double(ms - last_kick_ms_) / 1000.0, last_kick_id_, allocated));
+      for (uint32_t i = 0; i < kContexts; ++i) {
+        const Context& c = contexts_[i];
+        if (!c.allocated) continue;
+        uint8_t bytes[64];
+        raw(i, bytes);
+        std::string line = Line("ctx %u: %llu kicks (%llu without output), %llu locks, %llu clears, %llu blocks out, "
+                                "%llu input buffers used, %llu errors; now %s; last:",
+                                i, (unsigned long long)c.kicks, (unsigned long long)c.without_output,
+                                (unsigned long long)c.locks, (unsigned long long)c.clears,
+                                (unsigned long long)c.blocks_out, (unsigned long long)c.buffers_used,
+                                (unsigned long long)c.errors, Describe(Decode(bytes)).c_str());
+        for (uint32_t k = 0; k < c.count; ++k) {
+          const Event& e = c.history[(c.next + kHistory - c.count + k) % kHistory];
+          char part[96];
+          std::snprintf(part, sizeof(part), " [-%.1f s %s +%u, in %u%u->%u%u, write %u->%u, read %u]",
+                        double(ms - e.ms) / 1000.0, KindName(e.kind), BlocksAdded(e.before, e.after), e.before.valid0,
+                        e.before.valid1, e.after.valid0, e.after.valid1, e.before.write, e.after.write, e.after.read);
+          line += part;
+        }
+        lines.push_back(line);
+      }
+    }
+    return lines;
+  }
+
+ private:
+  template <typename... Args>
+  static std::string Line(const char* format, Args... args) {
+    char text[1024];
+    std::snprintf(text, sizeof(text), format, args...);
+    return std::string("XMA trace (fix 155): ") + text;
+  }
+  std::mutex mutex_;
+  Context contexts_[kContexts];
+  Period period_;
+  uint64_t period_start_ = 0, last_kick_ms_ = 0;
+  uint32_t last_kick_id_ = 0, last_0606_ = 0, kick_lines_ = 0, error_lines_ = 0, unwatch_lines_ = 0, silences_ = 0;
+  bool silent_logged_ = false;
+};
+
+}  // namespace xbox360ps5::xma_trace
