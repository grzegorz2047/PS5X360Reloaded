+namespace {
+// Xbox360PS5, fix 150: a host operation of 50 ms or more, logged with its path and the time on
+// the clock of the "Game swap" lines (pm4_command_processor_implement.h), at most 20 lines in
+// 30 s. The log's thread column names who waited (the background thread for its deletes).
+uint64_t NowMs() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                      std::chrono::steady_clock::now().time_since_epoch())
+                      .count());
+}
+void NoteSlow(const char* what, uint64_t ns, const std::string& path, bool background) {
+  if (ns < 50'000'000) {
+    return;
+  }
+  static std::atomic<uint64_t> window{0}, lines{0};
+  const uint64_t now = NowMs();
+  uint64_t start = window.load(std::memory_order_relaxed);
+  if (now - start >= 30000 && window.compare_exchange_strong(start, now)) {
+    lines.store(0, std::memory_order_relaxed);
+  }
+  if (lines.fetch_add(1, std::memory_order_relaxed) >= 20) {
+    return;
+  }
+  XELOGW("VFS slow host operation (fix 150): {} {:.1f} ms {}{}, at {} ms", what, double(ns) / 1e6,
+         path, background ? " (background)" : "", now);
+}
+uint64_t ElapsedNs(std::chrono::steady_clock::time_point start) {
+  return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                      std::chrono::steady_clock::now() - start)
+                      .count());
+}
+
+// Fix 150: the renamed files' deletes, one at a time on a host thread of their own, in order.
+// A file left by an exit or crash before its delete ran keeps its renamed name and is deleted at
+// the next mount (fix 139b's HostPathDevice::PopulateEntry); the name the game uses was free
+// from the rename on, so a file it makes again under it is another file.
+class BackgroundDeletes {
+ public:
+  void Add(std::function<bool()> remove, std::string path) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    queue_.push_back({std::move(remove), std::move(path)});
+    if (!started_) {
+      started_ = true;
+      std::thread([this] { Loop(); }).detach();
+    }
+    wake_.notify_all();
+  }
+  void Flush() {
+    std::unique_lock<std::mutex> lock(mutex_);
+    idle_.wait(lock, [this] { return queue_.empty() && !running_; });
+  }
+
+ private:
+  struct Job {
+    std::function<bool()> remove;
+    std::string path;
+  };
+  void Loop() {
+    for (;;) {
+      Job job;
+      {
+        std::unique_lock<std::mutex> lock(mutex_);
+        wake_.wait(lock, [this] { return !queue_.empty(); });
+        job = std::move(queue_.front());
+        queue_.pop_front();
+        running_ = true;
+      }
+      if (entry_io::test_hook) {
+        entry_io::test_hook(entry_io::kDelete);
+      }
+      const auto start = std::chrono::steady_clock::now();
+      job.remove();
+      const uint64_t ns = ElapsedNs(start);
+      entry_io::Note(entry_io::kDelete, ns);
+      NoteSlow("delete", ns, job.path, true);
+      {
+        std::lock_guard<std::mutex> lock(mutex_);
+        running_ = false;
+        if (queue_.empty()) {
+          idle_.notify_all();
+        }
+      }
+    }
+  }
+  std::mutex mutex_;
+  std::condition_variable wake_, idle_;
+  std::deque<Job> queue_;
+  bool started_ = false, running_ = false;
+};
+BackgroundDeletes& Deletes() {
+  static auto* deletes = new BackgroundDeletes();  // never destroyed (its thread lives on)
+  return *deletes;
+}
+std::atomic<int> delete_mode_override{-1};
+// "background" (the default) or "inline" from vfs-delete.txt, read at most once a second.
+bool DeleteInBackground() {
+  const int forced = delete_mode_override.load(std::memory_order_relaxed);
+  if (forced >= 0) {
+    return forced != 0;
+  }
+  static std::atomic<uint64_t> checked{0};
+  static std::atomic<bool> background{true};
+  static std::atomic<int> logged{-1};
+  const uint64_t now = NowMs();
+  if (now - checked.load(std::memory_order_relaxed) >= 1000) {
+    checked.store(now, std::memory_order_relaxed);
+    bool next = true;
+    if (FILE* file = std::fopen(XBOX360PS5_DATA_ROOT "/vfs-delete.txt", "rb")) {
+      char text[64] = {};
+      const size_t got = std::fread(text, 1, sizeof(text) - 1, file);
+      std::fclose(file);
+      next = std::string(text, got).find("inline") == std::string::npos;
+    }
+    background.store(next, std::memory_order_relaxed);
+    if (logged.exchange(next ? 1 : 0) != (next ? 1 : 0)) {
+      XELOGW("VFS deletes (fix 150): {}", next ? "renamed files deleted in the background"
+                                                : "renamed files deleted by the caller (inline)");
+    }
+  }
+  return background.load(std::memory_order_relaxed);
+}
+}  // namespace
+
+void Entry::FlushBackgroundDeletes() { Deletes().Flush(); }
+void Entry::OverrideDeleteMode(int mode) {
+  delete_mode_override.store(mode, std::memory_order_relaxed);
+}
