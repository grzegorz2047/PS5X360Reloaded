+// Fix 156o (Kinect Sports Season Two, #63): the objects a stuck thread waits on. 156m named
+// the darts load's wait (82620594: r31 = 40E90010, vtable 82026DA0, an avatar loader whose
+// IsDone needs its resource at +0x1E8 in state 2, flags at +0x214/+0x21C and every part of
+// its model done); which one never finishes is in their memory. When a thread's 10 s snapshot
+// has the same back chain (4 frames or more) as its previous one, once per chain: each distinct
+// readable r31 along it, then the heap objects those point to (one level), kDumpWords words
+// each, at most kDumpObjects objects.
+constexpr uint32_t kDumpWords = 0x120;  // 0x480 bytes
+constexpr size_t kDumpObjects = 40;
+inline bool HeapPointer(uint32_t v) { return v >= 0x40000000 && v < 0x70000000 && !(v & 3); }
+struct ObjectDump {
+  uint32_t address = 0, parent = 0, ret = 0;  // parent: the object that points to it (0: r31)
+  std::vector<uint32_t> words;
+};
+template <typename Read>
+inline std::vector<ObjectDump> DumpObjects(const SavedR31* frames, int n, Read read) {
+  std::vector<ObjectDump> out;
+  std::unordered_set<uint32_t> seen;
+  auto dump = [&](uint32_t address, uint32_t parent, uint32_t ret) {
+    if (out.size() >= kDumpObjects || !seen.insert(address).second) return false;
+    ObjectDump d;
+    d.address = address;
+    d.parent = parent;
+    d.ret = ret;
+    uint32_t w = 0;
+    while (d.words.size() < kDumpWords && read(address + 4 * uint32_t(d.words.size()), &w))
+      d.words.push_back(w);
+    if (d.words.empty()) return false;
+    out.push_back(std::move(d));
+    return true;
+  };
+  for (int i = 0; i < n; ++i)
+    if (frames[i].readable && HeapPointer(frames[i].r31)) dump(frames[i].r31, 0, frames[i].ret);
+  const size_t roots = out.size();
+  for (size_t r = 0; r < roots; ++r) {
+    const std::vector<uint32_t> words = out[r].words;
+    for (uint32_t v : words) {
+      uint32_t first = 0;
+      if (HeapPointer(v) && read(v, &first)) dump(v, out[r].address, out[r].ret);
+      if (out.size() >= kDumpObjects) return out;
+    }
+  }
+  return out;
+}
+// One line per 8 words: "+XXX: w w w w w w w w".
+inline std::vector<std::string> DumpLines(const ObjectDump& d) {
+  std::vector<std::string> lines;
+  char text[16];
+  for (size_t i = 0; i < d.words.size(); i += 8) {
+    std::snprintf(text, sizeof(text), "+%03X:", unsigned(i * 4));
+    std::string line = text;
+    for (size_t j = i; j < i + 8 && j < d.words.size(); ++j) {
+      std::snprintf(text, sizeof(text), " %08X", d.words[j]);
+      line += text;
+    }
+    lines.push_back(line);
+  }
+  return lines;
+}
+// The same chain as the previous snapshot, and not dumped for it yet.
+struct StuckChain {
+  uint32_t previous[kFrames] = {};
+  int previous_n = 0;
+  uint32_t dumped[kFrames] = {};
+  int dumped_n = -1;
+  bool Note(const uint32_t* callers, int n) {
+    const bool same = n == previous_n && std::equal(callers, callers + n, previous);
+    std::copy(callers, callers + n, previous);
+    previous_n = n;
+    if (!same || n < 4) return false;
+    if (n == dumped_n && std::equal(callers, callers + n, dumped)) return false;
+    std::copy(callers, callers + n, dumped);
+    dumped_n = n;
+    return true;
+  }
+};
+
 }  // namespace xbox360ps5::kinect_diag
