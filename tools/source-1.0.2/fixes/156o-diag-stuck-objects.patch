+        for (const auto& line : kd::DumpLines(object))
+          XELOGW("Kinect diag: thread {} object {:08X} (from {:08X}, frame {:08X}) {} (fix 156o)",
+                 context->thread_id, object.address, object.parent, object.ret, line);
+    }
   }
 }
