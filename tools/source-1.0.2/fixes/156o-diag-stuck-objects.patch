     XELOGW("Kinect diag: thread {} r31 by frame {} (fix 156k)", context->thread_id,
            kd::ChainR31(frames, m));
+    // Fix 156o: a thread at the same place as 10 s ago: the objects it is working on.
+    thread_local kd::StuckChain stuck;
