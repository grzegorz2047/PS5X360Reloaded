+// SPDX-License-Identifier: MIT
+// Fix 112: the player's own folders in a game folder, shown by the library as groups of games.
+//
+// The scan (Launcher::Scan) finds every game below a configured game folder, up to six folders
+// deep. Each library entry (a game, or a set of discs that fix 89 made into one entry) is placed
+// by the folders between its game folder and the folder that holds it: an image's or a package's
+// folder; for an extracted game the folder above its own (the game is its folder, so a folder
+// holding one extracted game is never a group); for an extracted disc set the folder above the
+// set's. Folders named by 8 hex digits (a GOD/STFS package's title ID and content type folders,
+// "4D5307E6/00007000") are not the player's and are passed through.
+//
+// A folder is a group when it holds two or more entries, counted with its subfolders. A folder
+// that holds one entry (a game in a folder of its own, a disc set's folder) is not: the entry is
+// shown where the folder is. A folder whose entries are all in one of its subfolders is passed
+// through too (that subfolder takes its place), and so is a group that would be the only thing at
+// the top of the library ("xbox360/games/<every game>"). Groups nest as deep as the folders do:
+// a group's own groups are shown inside it. Folders of the same name in two game folders are one
+// group (compared without case), named as found first. Empty folders hold nothing and never show.
+#pragma once
+#include <algorithm>
+#include <cstddef>
+#include <map>
+#include <set>
+#include <string>
+#include <vector>
+
+namespace xbox360ps5::library_groups {
+
+struct Group {
+  std::string key;                 // The folders' path below the game folder, lower case ("racing/rally").
+  std::string parent;              // The key of the group it is shown in, "" for the library itself.
+  std::string name;                // The folder's name, as found first.
+  std::vector<std::string> trail;  // The names of the groups from the library down to this one.
+  std::vector<size_t> games;       // Every entry inside it, its groups' too, in the order given.
+};
+
+struct Layout {
+  std::vector<Group> groups;            // A parent before its groups.
+  std::vector<std::string> shown_in;    // For each entry: the key of the group it is shown in, "" the library.
+  int Find(const std::string& key) const {
+    for (size_t n = 0; n < groups.size(); ++n)
+      if (groups[n].key == key) return int(n);
+    return -1;
+  }
+  // Whether the entry is inside the group `key` (directly or in one of its groups); every entry
+  // is inside the library ("").
+  bool Inside(size_t entry, const std::string& key) const {
+    if (key.empty()) return true;
+    if (entry >= shown_in.size()) return false;
+    const std::string& at = shown_in[entry];
+    return at == key || (at.size() > key.size() && at.compare(0, key.size(), key) == 0 && at[key.size()] == '/');
+  }
+};
+
+inline std::string Slashes(std::string path) {
+  for (char& ch : path) if (ch == '\\') ch = '/';
+  while (path.size() > 1 && path.back() == '/') path.pop_back();
+  return path;
+}
+
+inline std::string LowerAscii(std::string text) {
+  for (char& ch : text) if (ch >= 'A' && ch <= 'Z') ch = char(ch - 'A' + 'a');
+  return text;
+}
+
+// The folders of `path` below `root` ("/mnt/ext1/xbox360", "/mnt/ext1/xbox360/Racing/Rally" ->
+// {"Racing", "Rally"}); none when `path` is `root` or not below it.
+inline std::vector<std::string> FoldersBelow(const std::string& root, const std::string& path) {
+  const std::string r = Slashes(root), p = Slashes(path);
+  std::vector<std::string> folders;
+  if (r.empty() || p.size() <= r.size() || p.compare(0, r.size(), r) != 0) return folders;
+  size_t at = r.size();
+  if (r.back() != '/') {
+    if (p[at] != '/') return folders;  // "/data/xbox3600" is not below "/data/xbox360"
+    ++at;
+  }
+  while (at < p.size()) {
+    const size_t end = p.find('/', at);
+    const std::string part = p.substr(at, end == std::string::npos ? std::string::npos : end - at);
+    if (!part.empty() && part != ".") folders.push_back(part);
+    if (end == std::string::npos) break;
+    at = end + 1;
+  }
+  return folders;
+}
+
+// The folders that hold a library entry below its game folder `root`. An extracted game (kind
+// "XEX") is its folder `folder` (for a disc set, the set's folder), so the folder above that one
+// holds it; a game at the top of `root` itself is held by none. An image or a package (`path`)
+// is held by its own folder.
+inline std::vector<std::string> EntryFolders(const std::string& root, const std::string& kind, const std::string& path,
+                                             const std::string& folder) {
+  if (kind == "XEX") {
+    auto folders = FoldersBelow(root, folder);
+    if (!folders.empty()) folders.pop_back();
+    return folders;
+  }
+  const std::string p = Slashes(path);
+  const size_t slash = p.rfind('/');
+  return slash == std::string::npos ? std::vector<std::string>() : FoldersBelow(root, p.substr(0, slash));
+}
+
+// A GOD/STFS package's own folders: its title ID and content type ("4D5307E6", "00007000").
+inline bool PackageFolder(const std::string& name) {
+  if (name.size() != 8) return false;
+  for (const char ch : name)
+    if (!((ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f') || (ch >= 'A' && ch <= 'F'))) return false;
+  return true;
+}
+
+// `folders`: for each library entry, the folders that hold it below its game folder (FoldersBelow;
+// empty for an entry at the top of a game folder, or one that is in none, like a disc in the drive).
+inline Layout Build(const std::vector<std::vector<std::string>>& folders) {
+  struct Node {
+    std::string name, parent;
+    std::vector<size_t> direct;   // Entries held by this folder itself.
+    std::set<std::string> children;
+    size_t total = 0;
+    bool shown = false;
+  };
+  std::map<std::string, Node> nodes;
+  std::vector<std::string> holder(folders.size());
+  for (size_t entry = 0; entry < folders.size(); ++entry) {
+    std::string key;
+    for (const auto& folder : folders[entry]) {
+      if (folder.empty() || PackageFolder(folder)) continue;
+      const std::string parent = key;
+      key += (key.empty() ? "" : "/") + LowerAscii(folder);
+      auto [at, made] = nodes.try_emplace(key);
+      if (made) { at->second.name = folder; at->second.parent = parent; }
+      if (!parent.empty()) nodes[parent].children.insert(key);
+    }
+    holder[entry] = key;
+    if (!key.empty()) nodes[key].direct.push_back(entry);
+  }
+  // Totals: the deepest folders first (a longer key sorts after its parent's).
+  for (auto at = nodes.rbegin(); at != nodes.rend(); ++at) {
+    at->second.total += at->second.direct.size();
+    if (!at->second.parent.empty()) nodes[at->second.parent].total += at->second.total;
+  }
+  for (auto& [key, node] : nodes) {
+    size_t filled = 0;
+    for (const auto& child : node.children) filled += nodes[child].total ? 1 : 0;
+    node.shown = node.total >= 2 && !(node.direct.empty() && filled == 1);
+  }
+  const auto shown_ancestor = [&nodes](std::string key) {
+    while (!key.empty() && !nodes[key].shown) key = nodes[key].parent;
+    return key;
+  };
+  // A group that would be alone at the top of the library: its contents are the top instead.
+  for (;;) {
+    std::vector<std::string> top_groups;
+    bool top_entry = false;
+    for (const auto& [key, node] : nodes)
+      if (node.shown && shown_ancestor(node.parent).empty()) top_groups.push_back(key);
+    for (const auto& key : holder) top_entry = top_entry || shown_ancestor(key).empty();
+    if (top_entry || top_groups.size() != 1) break;
+    nodes[top_groups.front()].shown = false;
+  }
+  Layout layout;
+  layout.shown_in.resize(folders.size());
+  for (size_t entry = 0; entry < folders.size(); ++entry) layout.shown_in[entry] = shown_ancestor(holder[entry]);
+  for (const auto& [key, node] : nodes) {
+    if (!node.shown) continue;
+    Group group;
+    group.key = key;
+    group.parent = shown_ancestor(node.parent);
+    group.name = node.name;
+    for (std::string at = key; !at.empty(); at = shown_ancestor(nodes[at].parent)) group.trail.insert(group.trail.begin(), nodes[at].name);
+    layout.groups.push_back(std::move(group));
+  }
+  for (auto& group : layout.groups)
+    for (size_t entry = 0; entry < folders.size(); ++entry)
+      if (layout.Inside(entry, group.key)) group.games.push_back(entry);
+  return layout;
+}
+
+// The group to stay in when the library is built again: `key`, else the nearest of its parent
+// folders that is still a group, else the library ("").
+inline std::string StillThere(const Layout& layout, std::string key) {
+  while (!key.empty() && layout.Find(key) < 0) {
+    const size_t slash = key.rfind('/');
+    key = slash == std::string::npos ? std::string() : key.substr(0, slash);
+  }
+  return key;
+}
+
+}  // namespace xbox360ps5::library_groups
