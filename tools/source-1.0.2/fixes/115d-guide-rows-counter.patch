   return {};
 }
 
+// Fix 115d: which rows of a guide list are on screen, the same on both tabs: `shown` slots, the
+// window following the focused row (centred while it can be), fix 93d's button (when the list has
+// one) in a slot of its own after the `listed` rows. total: the rows and the button.
+struct ListWindow {
+  int first = 0;        // the first slot on screen
+  int last = 0;         // one past the last row (not the button) on screen
+  bool button_shown = false;
+  bool more_above = false, more_below = false;
+};
+inline ListWindow Window(int row, int total, int listed, int shown) {
+  ListWindow w;
+  const int top = total > shown ? total - shown : 0;
+  w.first = row - shown / 2;
+  if (w.first > top) w.first = top;
+  if (w.first < 0) w.first = 0;
+  w.last = w.first + shown < listed ? w.first + shown : listed;
+  w.button_shown = listed < total && listed >= w.first && listed < w.first + shown;
+  w.more_above = w.first > 0;
+  w.more_below = w.first + shown < total;
+  return w;
+}
+
 }  // namespace xbox360ps5::guide_quick
 
 #endif  // XBOX360PS5_GUIDE_QUICK_HPP_
