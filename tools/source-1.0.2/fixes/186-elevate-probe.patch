diff --git a/include/xbox360ps5/elevate_probe.hpp b/include/xbox360ps5/elevate_probe.hpp
new file mode 100644
--- /dev/null
+++ b/include/xbox360ps5/elevate_probe.hpp
@@ -0,0 +1,303 @@
+// SPDX-License-Identifier: MIT
+// Fix 186d: an optional, off-by-default probe that elevates this process to UID 0 before the fix
+// 148i/148j write benchmark, so the bench's throughput past the ~1.5-1.7 GB per-process write budget
+// (issue #80) can be measured as root. Diagnostics only; a strict no-op unless the user opts in.
+//
+// Why PATH B: the console runs etaHEN, whose 9028 command jailbreaks by an external ptrace HIJACK;
+// that killed our multithreaded emulator at every timing we tried (fix 186b/186c), before it could
+// even log. The method that works on this console (proven by TrinityXSX) is cooperative: the local
+// elfldr loads a bundled one-shot helper ELF as root, and that helper elevates us through the ELV1
+// handshake (we call seteuid(geteuid()) ourselves; no disruptive hijack).
+//
+// This MIT header does the orchestration only -- the switch, the fsync'd progress file, the
+// before/after uid checks, the safeguards -- and calls the ELV1/elfldr client through a clean
+// interface. That client (port/vendor/lapy) is an ISOLATED LGPL-2.1-or-later module adapted from
+// prospero-win + PS5-Lapy-JB-Daemon; it is a separable, relinkable unit and is NOT fused into this
+// MIT code (see NOTICE.md). The bundled helper ELF (/app0/lapy.elf) is likewise LGPL.
+//
+// Result line mirrors TrinityXSX's "PW_WINE64 data_mount ..." field names (data_before,
+// elevated_before, helper_completed, helper_errno, data_after, elevated_after, waited_ms,
+// settled_ms). Every step is fsync'd to <data>/elevate-probe-progress.txt so a death leaves a trail.
+// Safeguards: off without the switch; a per-process attempt cap; umask(0)+0666 on the test file; and
+// on any failure it logs and carries on at UID 1 -- the app is never closed.
+#pragma once
+#if !defined(XBOX360PS5_ELEVATE_PROBE_NO_SYSTEM) && defined(_WIN32)
+#define XBOX360PS5_ELEVATE_PROBE_NO_SYSTEM 1
+#endif
+
+#include <atomic>
+#include <cerrno>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <sstream>
+#include <string>
+
+#ifndef XBOX360PS5_ELEVATE_PROBE_NO_SYSTEM
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include "vendor/lapy/lapy_elevation_client.h"  // isolated LGPL-2.1 module (clean interface)
+#endif
+
+namespace xbox360ps5::elevate_probe {
+
+constexpr const char* kHelperPath = "/app0/lapy.elf";  // the bundled LGPL one-shot helper
+constexpr int kMaxAttemptsDefault = 3;
+constexpr int kMaxAttemptsCeiling = 8;
+constexpr int kTimeoutMsDefault = 8000;
+constexpr int kTimeoutMsCeiling = 20000;
+constexpr int kPollStepMs = 100;
+
+enum class Outcome { kOff, kCapped, kNotElevated, kElevated };
+enum class Backend { kNone, kLapyElfldr, kAlready };
+
+inline const char* OutcomeName(Outcome o) {
+  switch (o) {
+    case Outcome::kOff: return "off";
+    case Outcome::kCapped: return "capped";
+    case Outcome::kNotElevated: return "not-elevated";
+    case Outcome::kElevated: return "elevated";
+  }
+  return "?";
+}
+inline const char* BackendName(Backend b) {
+  switch (b) {
+    case Backend::kNone: return "none";
+    case Backend::kLapyElfldr: return "lapy-elfldr-9021";
+    case Backend::kAlready: return "already-root";
+  }
+  return "?";
+}
+
+struct Config {
+  bool on = false;
+  int max_attempts = kMaxAttemptsDefault;
+  int timeout_ms = kTimeoutMsDefault;
+};
+
+inline std::string SwitchFile(const std::string& data_root) { return data_root + "/elevate-probe.txt"; }
+inline std::string Trim(const std::string& s) {
+  size_t a = 0, b = s.size();
+  while (a < b && (unsigned char)s[a] <= ' ') ++a;
+  while (b > a && (unsigned char)s[b - 1] <= ' ') --b;
+  return s.substr(a, b - a);
+}
+inline Config Parse(const std::string& text) {
+  Config c;
+  std::istringstream in(text);
+  std::string line;
+  bool first = true;
+  while (std::getline(in, line)) {
+    const std::string t = Trim(line);
+    if (t.empty() || t[0] == '#') continue;
+    if (first) { first = false; if (t == "on") c.on = true; }
+    const size_t eq = t.find('=');
+    if (eq != std::string::npos) {
+      const std::string key = Trim(t.substr(0, eq));
+      const long value = std::strtol(Trim(t.substr(eq + 1)).c_str(), nullptr, 10);
+      if (key == "attempts" && value >= 1 && value <= kMaxAttemptsCeiling) c.max_attempts = (int)value;
+      if (key == "timeout_ms" && value >= 0 && value <= kTimeoutMsCeiling) c.timeout_ms = (int)value;
+    }
+  }
+  return c;
+}
+inline std::string DataProbeFile(const std::string& data_root, long pid) {
+  return data_root + "/.elevate-probe-write." + std::to_string(pid);
+}
+
+// What one run observed; fields mirror TrinityXSX's PW_WINE64 data_mount line.
+struct Result {
+  Outcome outcome = Outcome::kOff;
+  Backend backend = Backend::kNone;
+  Config config;
+  long pid = 0;
+  unsigned uid_before = 0, euid_before = 0, uid_after = 0, euid_after = 0;
+  bool elevated_before = false, elevated_after = false;
+  bool data_before = false, data_after = false;
+  bool helper_completed = false;  // the ELV1 client returned success
+  int helper_errno = 0;
+  int attempts = 0;
+  int waited_ms = 0, settled_ms = 0;
+
+  std::string Line() const {
+    char buf[512];
+    std::snprintf(buf, sizeof(buf),
+                  "Elevate probe (fix 186): result=%s backend=%s attempts=%d uid_before=%u "
+                  "euid_before=%u data_before=%d elevated_before=%d helper_completed=%d "
+                  "helper_errno=%d waited_ms=%d uid_after=%u euid_after=%u data_after=%d "
+                  "elevated_after=%d settled_ms=%d",
+                  OutcomeName(outcome), BackendName(backend), attempts, uid_before, euid_before,
+                  (int)data_before, (int)elevated_before, (int)helper_completed, helper_errno,
+                  waited_ms, uid_after, euid_after, (int)data_after, (int)elevated_after, settled_ms);
+    return buf;
+  }
+};
+
+inline std::atomic<int>& AttemptCounter() {
+  static std::atomic<int> counter{0};
+  return counter;
+}
+
+struct ElevateResult {
+  bool attempted = false;
+  bool ok = false;
+  int err = 0;
+};
+
+// Host-testable core. Ops: read_text, getuid/geteuid, data_write, elevate_request(pid)->ElevateResult
+// (the ELV1/elfldr client), geteuid-after via re-read; the host check drives it with fakes.
+template <class Ops>
+Result Run(Ops& ops, const std::string& data_root, long pid) {
+  Result r;
+  r.pid = pid;
+  r.config = Parse(ops.read_text(SwitchFile(data_root)));
+  if (!r.config.on) { r.outcome = Outcome::kOff; return r; }
+  r.attempts = AttemptCounter().fetch_add(1) + 1;
+  if (r.attempts > r.config.max_attempts) { r.outcome = Outcome::kCapped; return r; }
+  r.uid_before = ops.getuid();
+  r.euid_before = ops.geteuid();
+  r.elevated_before = r.euid_before == 0;
+  r.data_before = ops.data_write(DataProbeFile(data_root, pid));
+  if (r.elevated_before) {
+    r.backend = Backend::kAlready;
+    r.uid_after = r.uid_before;
+    r.euid_after = r.euid_before;
+    r.elevated_after = true;
+    r.data_after = ops.data_write(DataProbeFile(data_root, pid));
+    r.outcome = Outcome::kElevated;
+    return r;
+  }
+  const ElevateResult e = ops.elevate_request(pid);
+  r.helper_completed = e.ok;
+  r.helper_errno = e.err;
+  r.uid_after = ops.getuid();
+  r.euid_after = ops.geteuid();
+  r.elevated_after = r.euid_after == 0;
+  r.data_after = ops.data_write(DataProbeFile(data_root, pid));
+  r.backend = r.elevated_after ? Backend::kLapyElfldr : Backend::kNone;
+  r.outcome = r.elevated_after ? Outcome::kElevated : Outcome::kNotElevated;
+  return r;
+}
+
+#ifndef XBOX360PS5_ELEVATE_PROBE_NO_SYSTEM
+// 186e: a fallback sink the caller sets (boot.log + the game log), so every step is captured even
+// when the /data progress file cannot be opened (e.g. this runs before /data is writable).
+inline void (*&LogCb())(const char*) {
+  static void (*cb)(const char*) = nullptr;
+  return cb;
+}
+inline void ProgLine(int fd, const char* text) {
+  if (fd >= 0) {
+    (void)!::write(fd, text, std::strlen(text));
+    (void)!::write(fd, "\n", 1);
+    ::fsync(fd);
+  }
+  if (LogCb()) LogCb()(text);  // durable fallback, independent of /data
+}
+
+// The progress file fd for the LGPL client's step callback (one-shot, main-thread only).
+inline int& ProgFd() {
+  static int fd = -1;
+  return fd;
+}
+extern "C" inline void ProgressTrampoline(const char* step) { ProgLine(ProgFd(), step); }
+
+// umask(0) + 0666 write in the app's own data folder, removed again (issue #80: a file made while
+// elevated stays usable at UID 1).
+inline bool DataWrite(const std::string& path) {
+  const mode_t old_umask = ::umask(0);
+  errno = 0;
+  bool ok = false;
+  const int fd = ::open(path.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0666);
+  if (fd >= 0) {
+    const char token[] = "TRINITYX360\n";
+    ok = ::write(fd, token, sizeof(token) - 1) == (ssize_t)(sizeof(token) - 1);
+    ::close(fd);
+    ::unlink(path.c_str());
+  }
+  ::umask(old_umask);
+  return ok;
+}
+
+// The real entry: run the probe ONCE at the earliest, single-threaded point in main(), writing every
+// step fsync'd to <data>/elevate-probe-progress.txt. A strict no-op unless the switch says "on"; no
+// signal handler; never closes the app. The actual elevation is the isolated LGPL ELV1/elfldr client.
+inline Result AttemptEarly(const std::string& data_root, void (*log)(const char*) = nullptr) {
+  LogCb() = log;  // capture every step to boot.log / the game log too, even if /data write fails
+  Result r;
+  const long pid = (long)::getpid();
+  r.pid = pid;
+  r.config = Parse([&] {
+    std::ifstream f(SwitchFile(data_root), std::ios::binary);
+    std::ostringstream s;
+    s << f.rdbuf();
+    return s.str();
+  }());
+  if (!r.config.on) { r.outcome = Outcome::kOff; return r; }  // strict default no-op
+  if (AttemptCounter().fetch_add(1) + 1 > r.config.max_attempts) { r.outcome = Outcome::kCapped; return r; }
+
+  const std::string progress = data_root + "/elevate-probe-progress.txt";
+  ::umask(0);
+  const int prog = ::open(progress.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0666);
+  char line[192];
+
+  r.uid_before = (unsigned)::getuid();
+  r.euid_before = (unsigned)::geteuid();
+  r.elevated_before = r.euid_before == 0;
+  std::snprintf(line, sizeof(line), "186d start pid=%ld uid=%u euid=%u (switch on)", pid,
+                r.uid_before, r.euid_before);
+  ProgLine(prog, line);
+
+  if (r.elevated_before) {
+    ProgLine(prog, "already-root: euid 0 at launch, no request made");
+    r.backend = Backend::kAlready;
+    r.uid_after = r.uid_before;
+    r.euid_after = r.euid_before;
+    r.elevated_after = true;
+    r.outcome = Outcome::kElevated;
+    ProgLine(prog, "done result=elevated backend=already-root");
+    if (prog >= 0) ::close(prog);
+    return r;
+  }
+
+  r.data_before = DataWrite(DataProbeFile(data_root, pid));
+  ProgLine(prog, r.data_before ? "data_before: wrote own data folder" : "data_before: FAILED");
+
+  ProgFd() = prog;
+  ProgLine(prog, "lapy: calling isolated LGPL ELV1/elfldr client (helper /app0/lapy.elf)");
+  errno = 0;
+  const int rc = lapy_elevation_request((int32_t)pid, kHelperPath, &ProgressTrampoline);
+  r.helper_completed = rc == 0;
+  r.helper_errno = rc == 0 ? 0 : (errno ? errno : EIO);
+  std::snprintf(line, sizeof(line), "lapy: client returned rc=%d errno=%d", rc, r.helper_errno);
+  ProgLine(prog, line);
+
+  int waited = 0;
+  while ((unsigned)::geteuid() != 0 && waited < r.config.timeout_ms) {
+    ::usleep((useconds_t)kPollStepMs * 1000);
+    waited += kPollStepMs;
+  }
+  r.waited_ms = waited;
+  r.uid_after = (unsigned)::getuid();
+  r.euid_after = (unsigned)::geteuid();
+  r.elevated_after = r.euid_after == 0;
+  r.data_after = DataWrite(DataProbeFile(data_root, pid));
+  r.backend = r.elevated_after ? Backend::kLapyElfldr : Backend::kNone;
+  r.outcome = r.elevated_after ? Outcome::kElevated : Outcome::kNotElevated;
+  std::snprintf(line, sizeof(line),
+                "after uid=%u euid=%u data_after=%d elevated_after=%d waited_ms=%d", r.uid_after,
+                r.euid_after, (int)r.data_after, (int)r.elevated_after, waited);
+  ProgLine(prog, line);
+  std::snprintf(line, sizeof(line), "done result=%s backend=%s", OutcomeName(r.outcome),
+                BackendName(r.backend));
+  ProgLine(prog, line);
+  if (prog >= 0) ::close(prog);
+  return r;
+}
+#endif  // XBOX360PS5_ELEVATE_PROBE_NO_SYSTEM
+
+}  // namespace xbox360ps5::elevate_probe
