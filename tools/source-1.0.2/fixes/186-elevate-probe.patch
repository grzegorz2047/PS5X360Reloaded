+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Isolated LGPL-2.1 elevation client, adapted from prospero-win (mpereiraesaa,
+ * tag v0.3.0, rev 404cac6ebbb236d2486d2796fd28b9bd39f2caa6) native/pw_lapy_elevation.c.
+ * Not fused into TrinityX360's MIT eboot; the eboot calls it through this header.
+ * See NOTICE.md / licenses/LAPY-LGPL-2.1.txt. */
+#ifndef LAPY_ELEVATION_CLIENT_H
+#define LAPY_ELEVATION_CLIENT_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Stream the bundled one-shot ELF at helper_path to the local elfldr listener
+ * (TCP 127.0.0.1:9021) and run the versioned ELV1 handshake for this process:
+ * REQUEST -> PREPARE -> seteuid(geteuid()) -> PREPARED -> RESPONSE. Returns 0
+ * on a confirmed elevation, else -1 with errno. */
+int lapy_elevation_request(int32_t pid, const char *helper_path,
+                           void (*progress)(const char *));
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
