+// SPDX-License-Identifier: MIT
+// Fix 186 / 186b: an optional, off-by-default probe that asks the console's on-demand jailbreak
+// backend to elevate this process to UID 0 before the fix 148i/148j write benchmark, so the bench's
+// throughput past the ~1.5-1.7 GB per-process write budget (issue #80) can be measured as root and
+// compared to the UID 1 runs. Diagnostics only: it changes nothing unless the user opts in, it never
+// closes the app, and it implements no kernel write of its own -- it only sends a backend's own
+// on-demand jailbreak request and reports, honestly, whether elevation took.
+//
+// Primary backend -- etaHEN's native non-whitelist jailbreak (MIT-clean, in the MIT eboot):
+// etaHEN (the HEN the user runs) exposes a command server on TCP 127.0.0.1:9028. Its README
+// documents a "non-whitelist method": send a HijackerCommand asking it to jailbreak a PID, and it
+// grants that process a full jailbreak (root ucred + root vnode) regardless of the title. etaHEN's
+// file-marker path (/download0/etahen_jailbreak) is NOT used because it only accepts a hardcoded
+// title whitelist that excludes this app. This header reimplements etaHEN's documented 9028 wire
+// protocol independently in plain POSIX sockets; etaHEN is GPL-3.0 and no etaHEN code is copied (the
+// struct and constants are a factual wire interface). The protocol: connect 127.0.0.1:9028; send a
+// HijackerCommand{ magic=0xDEADBEEF, cmd=JAILBREAK_CMD(5), PID=getpid(), ret=-1337, msg1[0x500],
+// msg2[0x500] } (2576 bytes); read it back; success iff ret==0 (jailbroken now) or ret==-1337
+// (already). etaHEN then does a full Hijacker jailbreak of this PID.
+//
+// Secondary backend -- a resident Lapy daemon marker (also MIT): if the 9028 jailbreak does not take,
+// the probe also writes Lapy's cooperative marker (seteuid(geteuid()) first, then {"PID":<pid>} to
+// /download0/.elevate_proc.<pid> renamed to /download0/elevate_proc), for a console that runs a
+// standalone PS5-Lapy-JB-Daemon instead of etaHEN. A bundled Lapy helper is a separate LGPL binary
+// (never in this MIT eboot); the elfldr:9021 + ELV1 one-shot path (LGPL) is intentionally NOT done
+// here.
+//
+// The result line mirrors TrinityXSX's "PW_WINE64 data_mount ..." field names and semantics
+// (data_before, elevated_before, helper_completed, helper_errno, data_after, elevated_after,
+// waited_ms, settled_ms) so the two consoles' numbers compare directly. elevated_* is euid==0;
+// data_* is a real write in this app's own data folder.
+//
+// Safeguards:
+//  * switch file <data>/elevate-probe.txt must say "on"; without it the probe is a no-op and the
+//    bench runs exactly as before, at UID 1;
+//  * a hard per-process cap on elevation requests (attempts=, default 3), given that a jailbreak
+//    changes kernel credentials and legacy backends were linked to panics after many per boot;
+//  * a SIGSYS handler around the request, so a syscall the sandbox refuses is logged, not a silent
+//    process kill (the PS5 sandbox lacks some syscalls; fix 148k);
+//  * the probe's own test file is created with umask(0) and mode 0666/0777 and removed again, so a
+//    file made while elevated stays readable and writable if the user later runs at UID 1 (issue #80);
+//  * any failure (no backend, a refusal, a timeout, SIGSYS) is logged and the process carries on at
+//    UID 1 -- the app is never closed and nothing else is changed.
+#pragma once
+// The real syscalls/sockets (SystemOps, Attempt) are POSIX; the PS5 (__PROSPERO__) and the CI host
+// build them. The templated core (Run) is portable, so the host check builds it on any platform; on
+// a non-POSIX host (a local Windows zig build of the check) SystemOps is left out automatically.
+#if !defined(XBOX360PS5_ELEVATE_PROBE_NO_SYSTEM) && defined(_WIN32)
+#define XBOX360PS5_ELEVATE_PROBE_NO_SYSTEM 1
+#endif
+
+#include <atomic>
+#include <cerrno>
+#include <chrono>
+#include <csignal>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <functional>
+#include <sstream>
+#include <string>
+
+#ifndef XBOX360PS5_ELEVATE_PROBE_NO_SYSTEM
+#include <arpa/inet.h>
+#include <fcntl.h>
+#include <netinet/in.h>
+#include <setjmp.h>
+#include <signal.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <unistd.h>
+#endif
+
+namespace xbox360ps5::elevate_probe {
+
+// etaHEN's command server (README: the non-whitelist jailbreak method).
+constexpr const char* kEtahenHost = "127.0.0.1";
+constexpr int kEtahenPort = 9028;
+constexpr uint32_t kHijackerMagic = 0xDEADBEEF;
+constexpr int32_t kJailbreakCmd = 5;        // Commands: INVALID=-1,ACTIVE=0,LAUNCH,PROCLIST,KILL,KILL_APP,JAILBREAK
+constexpr int32_t kRetSentinel = -1337;     // "already jailbroken", and the request's initial ret
+constexpr size_t kHijackerMsg = 0x500;
+
+// Lapy's cooperative marker (secondary backend).
+constexpr const char* kDownloadRoot = "/download0";
+constexpr const char* kLapyMarker = "/download0/elevate_proc";
+constexpr int kMaxAttemptsDefault = 3;
+constexpr int kMaxAttemptsCeiling = 8;
+constexpr int kTimeoutMsDefault = 4000;
+constexpr int kTimeoutMsCeiling = 20000;
+constexpr int kPollStepMs = 50;
+constexpr int kSocketTimeoutMs = 3000;
+
+enum class Outcome { kOff, kCapped, kNotElevated, kElevated };
+enum class Backend { kNone, kEtahen, kLapy, kAlready };
+
+inline const char* OutcomeName(Outcome o) {
+  switch (o) {
+    case Outcome::kOff: return "off";
+    case Outcome::kCapped: return "capped";
+    case Outcome::kNotElevated: return "not-elevated";
+    case Outcome::kElevated: return "elevated";
+  }
+  return "?";
+}
+inline const char* BackendName(Backend b) {
+  switch (b) {
+    case Backend::kNone: return "none";
+    case Backend::kEtahen: return "etahen-9028";
+    case Backend::kLapy: return "lapy-marker";
+    case Backend::kAlready: return "already-root";
+  }
+  return "?";
+}
+
+struct Config {
+  bool on = false;
+  int max_attempts = kMaxAttemptsDefault;
+  int timeout_ms = kTimeoutMsDefault;
+};
+
+inline std::string SwitchFile(const std::string& data_root) { return data_root + "/elevate-probe.txt"; }
+
+inline std::string Trim(const std::string& s) {
+  size_t a = 0, b = s.size();
+  while (a < b && (unsigned char)s[a] <= ' ') ++a;
+  while (b > a && (unsigned char)s[b - 1] <= ' ') --b;
+  return s.substr(a, b - a);
+}
+
+inline Config Parse(const std::string& text) {
+  Config c;
+  std::istringstream in(text);
+  std::string line;
+  bool first = true;
+  while (std::getline(in, line)) {
+    const std::string t = Trim(line);
+    if (t.empty() || t[0] == '#') continue;
+    if (first) {
+      first = false;
+      if (t == "on") c.on = true;
+    }
+    const size_t eq = t.find('=');
+    if (eq != std::string::npos) {
+      const std::string key = Trim(t.substr(0, eq));
+      const long value = std::strtol(Trim(t.substr(eq + 1)).c_str(), nullptr, 10);
+      if (key == "attempts" && value >= 1 && value <= kMaxAttemptsCeiling) c.max_attempts = (int)value;
+      if (key == "timeout_ms" && value >= 0 && value <= kTimeoutMsCeiling) c.timeout_ms = (int)value;
+    }
+  }
+  return c;
+}
+
+inline std::string LapyTemp(long pid) {
+  return std::string(kDownloadRoot) + "/.elevate_proc." + std::to_string(pid);
+}
+inline std::string LapyBody(long pid) { return "{\"PID\":" + std::to_string(pid) + "}\n"; }
+// A write probe in this app's own data folder (writable at UID 1; mirrors TrinityXSX's data_* check).
+inline std::string DataProbeFile(const std::string& data_root, long pid) {
+  return data_root + "/.elevate-probe-write." + std::to_string(pid);
+}
+
+struct EtahenResult {
+  bool attempted = false;  // a jailbreak request was sent
+  bool ok = false;         // etaHEN accepted (ret 0 or -1337)
+  int ret = 0;
+  int err = 0;
+};
+
+// What one run observed; fields mirror TrinityXSX's PW_WINE64 data_mount line.
+struct Result {
+  Outcome outcome = Outcome::kOff;
+  Backend backend = Backend::kNone;
+  Config config;
+  long pid = 0;
+  unsigned uid_before = 0, euid_before = 0, uid_after = 0, euid_after = 0;
+  bool elevated_before = false, elevated_after = false;
+  bool data_before = false, data_after = false;
+  bool etahen_attempted = false;
+  int etahen_ret = 0;
+  bool helper_completed = false;  // a backend accepted the jailbreak request
+  int helper_errno = 0;
+  bool lapy_requested = false;
+  int attempts = 0;
+  int waited_ms = 0, settled_ms = 0;
+
+  std::string Line() const {
+    char buf[640];
+    std::snprintf(
+        buf, sizeof(buf),
+        "Elevate probe (fix 186): result=%s backend=%s attempts=%d uid_before=%u euid_before=%u "
+        "data_before=%d elevated_before=%d etahen_attempted=%d etahen_ret=%d helper_completed=%d "
+        "helper_errno=%d lapy_requested=%d waited_ms=%d uid_after=%u euid_after=%u data_after=%d "
+        "elevated_after=%d settled_ms=%d",
+        OutcomeName(outcome), BackendName(backend), attempts, uid_before, euid_before,
+        (int)data_before, (int)elevated_before, (int)etahen_attempted, etahen_ret,
+        (int)helper_completed, helper_errno, (int)lapy_requested, waited_ms, uid_after, euid_after,
+        (int)data_after, (int)elevated_after, settled_ms);
+    return buf;
+  }
+};
+
+inline std::atomic<int>& AttemptCounter() {
+  static std::atomic<int> counter{0};
+  return counter;
+}
+
+// The core, driven through Ops so the host check runs it with no console and no network. Ops provides:
+//   read_text(path)->string; getuid()/geteuid()->unsigned; seteuid(uid)->int; data_write(path)->bool;
+//   etahen_jailbreak(pid)->EtahenResult; write_lapy_marker(temp,marker,body)->bool;
+//   wait_for_root(timeout_ms,&waited_ms)->bool (true once geteuid()==0); last_errno()->int; now_ms().
+template <class Ops>
+Result Run(Ops& ops, const std::string& data_root, long pid) {
+  Result r;
+  r.pid = pid;
+  r.config = Parse(ops.read_text(SwitchFile(data_root)));
+  if (!r.config.on) {
+    r.outcome = Outcome::kOff;
+    return r;
+  }
+  r.attempts = AttemptCounter().fetch_add(1) + 1;
+  if (r.attempts > r.config.max_attempts) {
+    r.outcome = Outcome::kCapped;
+    return r;
+  }
+  r.uid_before = ops.getuid();
+  r.euid_before = ops.geteuid();
+  r.elevated_before = r.euid_before == 0;
+  r.data_before = ops.data_write(DataProbeFile(data_root, pid));
+
+  if (r.elevated_before) {
+    // Already root (e.g. etaHEN auto-jailbreak at launch): nothing to request.
+    r.backend = Backend::kAlready;
+    r.uid_after = r.uid_before;
+    r.euid_after = r.euid_before;
+    r.elevated_after = true;
+    r.data_after = ops.data_write(DataProbeFile(data_root, pid));
+    r.outcome = Outcome::kElevated;
+    return r;
+  }
+
+  // Private credential (harmless for etaHEN; a Lapy daemon requires it).
+  ops.seteuid(r.euid_before);
+
+  // Primary: etaHEN's native non-whitelist jailbreak over 127.0.0.1:9028.
+  const EtahenResult jb = ops.etahen_jailbreak(pid);
+  r.etahen_attempted = jb.attempted;
+  r.etahen_ret = jb.ret;
+  r.helper_completed = jb.ok;
+  r.helper_errno = jb.err;
+
+  // Secondary: write the Lapy marker for a console that runs a resident Lapy daemon instead.
+  if (ops.geteuid() != 0) {
+    r.lapy_requested = ops.write_lapy_marker(LapyTemp(pid), kLapyMarker, LapyBody(pid));
+  }
+
+  // Wait until this process is root, or the timeout.
+  const bool became_root = ops.wait_for_root(r.config.timeout_ms, &r.waited_ms);
+
+  const long long settle0 = ops.now_ms();
+  r.uid_after = ops.getuid();
+  r.euid_after = ops.geteuid();
+  r.elevated_after = r.euid_after == 0;
+  r.data_after = ops.data_write(DataProbeFile(data_root, pid));
+  r.settled_ms = (int)(ops.now_ms() - settle0);
+
+  if (r.elevated_after) {
+    r.backend = jb.ok ? Backend::kEtahen : (r.lapy_requested ? Backend::kLapy : Backend::kEtahen);
+    r.outcome = Outcome::kElevated;
+  } else {
+    (void)became_root;
+    r.backend = Backend::kNone;
+    r.outcome = Outcome::kNotElevated;
+  }
+  return r;
+}
+
+#ifndef XBOX360PS5_ELEVATE_PROBE_NO_SYSTEM
+// 186c: NO signal handler is installed around the request. The earlier SIGSYS guard was removed
+// because etaHEN jailbreaks the target by an external ptrace hijack, and our own handlers were a
+// prime suspect for the process being killed mid-hijack. Instead every step is written to a progress
+// file and fsync'd, so if the process dies we see exactly how far it got.
+
+// etaHEN's 9028 jailbreak command, byte-for-byte on the wire (2576 bytes). Reimplemented from
+// etaHEN's documented protocol; no etaHEN (GPL-3.0) code is copied.
+struct HijackerCommand {
+  int32_t magic;
+  int32_t cmd;
+  int32_t pid;
+  int32_t ret;
+  char msg1[kHijackerMsg];
+  char msg2[kHijackerMsg];
+};
+static_assert(sizeof(HijackerCommand) == 16 + 2 * kHijackerMsg, "HijackerCommand wire size");
+
+// One fsync'd progress line (fd < 0 = no progress file). Durable across a death mid-request.
+inline void ProgLine(int fd, const char* text) {
+  if (fd < 0) return;
+  (void)!::write(fd, text, std::strlen(text));
+  (void)!::write(fd, "\n", 1);
+  ::fsync(fd);
+}
+inline bool SendAllS(int fd, const void* data, size_t len) {
+  const char* p = (const char*)data;
+  for (size_t done = 0; done < len;) {
+    const ssize_t n = ::send(fd, p + done, len - done, 0);
+    if (n <= 0) return false;
+    done += (size_t)n;
+  }
+  return true;
+}
+inline bool RecvAllS(int fd, void* data, size_t len) {
+  char* p = (char*)data;
+  for (size_t done = 0; done < len;) {
+    const ssize_t n = ::recv(fd, p + done, len - done, 0);
+    if (n <= 0) return false;
+    done += (size_t)n;
+  }
+  return true;
+}
+// etaHEN's non-whitelist jailbreak over 127.0.0.1:9028, logging each socket step to `prog` (fsync'd)
+// so the exact point of a death is visible. prog < 0 silences the logging (used by the host path).
+inline EtahenResult EtahenJailbreakLogged(long pid, int prog) {
+  EtahenResult r;
+  ProgLine(prog, "etahen: socket()");
+  errno = 0;
+  const int fd = ::socket(AF_INET, SOCK_STREAM, 0);
+  if (fd < 0) {
+    r.err = errno;
+    ProgLine(prog, "etahen: socket() FAILED");
+    return r;
+  }
+  timeval tv{};
+  tv.tv_sec = kSocketTimeoutMs / 1000;
+  tv.tv_usec = (kSocketTimeoutMs % 1000) * 1000;
+  ::setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+  ::setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+  sockaddr_in addr{};
+  addr.sin_family = AF_INET;
+  addr.sin_port = htons((uint16_t)kEtahenPort);
+  ::inet_pton(AF_INET, kEtahenHost, &addr.sin_addr);
+  ProgLine(prog, "etahen: connect 127.0.0.1:9028");
+  if (::connect(fd, (sockaddr*)&addr, sizeof(addr)) != 0) {
+    r.err = errno;  // no etaHEN command server listening
+    ProgLine(prog, "etahen: connect FAILED (no 9028 server?)");
+    ::close(fd);
+    return r;
+  }
+  ProgLine(prog, "etahen: connected");
+  HijackerCommand cmd{};
+  cmd.magic = (int32_t)kHijackerMagic;
+  cmd.cmd = kJailbreakCmd;
+  cmd.pid = (int32_t)pid;
+  cmd.ret = kRetSentinel;
+  ProgLine(prog, "etahen: send JAILBREAK");
+  r.attempted = SendAllS(fd, &cmd, sizeof(cmd));
+  if (!r.attempted) {
+    r.err = errno;
+    ProgLine(prog, "etahen: send FAILED");
+    ::close(fd);
+    return r;
+  }
+  // The hijack (ptrace) happens while the daemon handles this request; a death appears here.
+  ProgLine(prog, "etahen: sent, awaiting reply (hijack runs now)");
+  if (RecvAllS(fd, &cmd, sizeof(cmd))) {
+    r.ret = cmd.ret;
+    r.ok = cmd.ret == 0 || cmd.ret == kRetSentinel;
+    ProgLine(prog, r.ok ? "etahen: reply OK (jailbroken)" : "etahen: reply NOT-OK");
+  } else {
+    r.err = errno;
+    ProgLine(prog, "etahen: recv FAILED/incomplete");
+  }
+  ::close(fd);
+  return r;
+}
+
+struct SystemOps {
+  int saved_errno = 0;
+  int last_errno() const { return saved_errno; }
+  std::string read_text(const std::string& path) {
+    std::ifstream f(path, std::ios::binary);
+    std::ostringstream s;
+    s << f.rdbuf();
+    return s.str();
+  }
+  unsigned getuid() { return (unsigned)::getuid(); }
+  unsigned geteuid() { return (unsigned)::geteuid(); }
+  int seteuid(unsigned uid) {
+    errno = 0;
+    const int rc = ::seteuid((uid_t)uid);
+    saved_errno = errno;
+    return rc;
+  }
+  // A write in the app's own data folder, with umask(0) + 0666, removed again (issue #80: a file made
+  // while elevated stays usable at UID 1).
+  bool data_write(const std::string& path) {
+    const mode_t old_umask = ::umask(0);
+    errno = 0;
+    bool ok = false;
+    const int fd = ::open(path.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0666);
+    if (fd >= 0) {
+      const char token[] = "TRINITYX360\n";
+      ok = ::write(fd, token, sizeof(token) - 1) == (ssize_t)(sizeof(token) - 1);
+      ::close(fd);
+      ::unlink(path.c_str());
+    }
+    saved_errno = errno;
+    ::umask(old_umask);
+    return ok;
+  }
+  // Send etaHEN the non-whitelist jailbreak request for our PID and read its verdict (unlogged path).
+  EtahenResult etahen_jailbreak(long pid) {
+    const EtahenResult r = EtahenJailbreakLogged(pid, -1);
+    saved_errno = r.err;
+    return r;
+  }
+  bool write_lapy_marker(const std::string& temp, const std::string& marker, const std::string& body) {
+    errno = 0;
+    const int fd = ::open(temp.c_str(), O_WRONLY | O_CREAT | O_EXCL, 0644);
+    if (fd < 0) {
+      saved_errno = errno;
+      return false;
+    }
+    const bool wrote = ::write(fd, body.data(), body.size()) == (ssize_t)body.size();
+    const int close_rc = ::close(fd);
+    if (!wrote || close_rc != 0 || ::rename(temp.c_str(), marker.c_str()) != 0) {
+      saved_errno = errno;
+      ::unlink(temp.c_str());
+      return false;
+    }
+    saved_errno = 0;
+    return true;
+  }
+  bool wait_for_root(int timeout_ms, int* waited_ms) {
+    const auto start = std::chrono::steady_clock::now();
+    for (;;) {
+      if (::geteuid() == 0) {
+        *waited_ms = Elapsed(start);
+        return true;
+      }
+      if (Elapsed(start) >= timeout_ms) {
+        *waited_ms = Elapsed(start);
+        return false;
+      }
+      ::usleep((useconds_t)kPollStepMs * 1000);
+    }
+  }
+  long long now_ms() {
+    return (long long)std::chrono::duration_cast<std::chrono::milliseconds>(
+               std::chrono::steady_clock::now().time_since_epoch())
+        .count();
+  }
+
+ private:
+  static int Elapsed(std::chrono::steady_clock::time_point start) {
+    return (int)std::chrono::duration_cast<std::chrono::milliseconds>(
+               std::chrono::steady_clock::now() - start)
+        .count();
+  }
+};
+
+// 186c public entry: run the probe ONCE at the earliest, single-threaded point in main() (before
+// InstallCrashReport and any worker thread or signal handler), writing every step to
+// <data>/elevate-probe-progress.txt and fsync'ing each line, so a death during etaHEN's ptrace
+// hijack leaves a durable trail of exactly how far it got. A strict no-op unless the switch file
+// says "on"; no signal handler is installed; the app is never closed by this code. Returns the
+// Result (the caller may also log it once the core logger is up, but the progress file is the
+// authoritative, flush-safe record).
+inline Result AttemptEarly(const std::string& data_root) {
+  Result r;
+  const long pid = (long)::getpid();
+  r.pid = pid;
+  SystemOps ops;
+  r.config = Parse(ops.read_text(SwitchFile(data_root)));
+  if (!r.config.on) {
+    r.outcome = Outcome::kOff;
+    return r;  // strict default no-op: the app runs exactly as without the probe
+  }
+  if (AttemptCounter().fetch_add(1) + 1 > r.config.max_attempts) {
+    r.outcome = Outcome::kCapped;
+    return r;
+  }
+
+  const std::string progress = data_root + "/elevate-probe-progress.txt";
+  ::umask(0);
+  const int prog = ::open(progress.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0666);
+  char line[192];
+
+  r.uid_before = ops.getuid();
+  r.euid_before = ops.geteuid();
+  r.elevated_before = r.euid_before == 0;
+  std::snprintf(line, sizeof(line), "186c start pid=%ld uid=%u euid=%u (switch on)", pid,
+                r.uid_before, r.euid_before);
+  ProgLine(prog, line);
+
+  if (r.elevated_before) {
+    ProgLine(prog, "already-root: euid 0 at launch, no request made");
+    r.backend = Backend::kAlready;
+    r.uid_after = r.uid_before;
+    r.euid_after = r.euid_before;
+    r.elevated_after = true;
+    r.data_after = ops.data_write(DataProbeFile(data_root, pid));
+    r.outcome = Outcome::kElevated;
+    ProgLine(prog, "done result=elevated backend=already-root");
+    if (prog >= 0) ::close(prog);
+    return r;
+  }
+
+  r.data_before = ops.data_write(DataProbeFile(data_root, pid));
+  ProgLine(prog, r.data_before ? "data_before: wrote own data folder" : "data_before: FAILED");
+
+  // etaHEN presence sanity: can we write /download0 at all (sandbox) before the request?
+  {
+    const std::string probe = std::string(kDownloadRoot) + "/.elevate-probe-test." + std::to_string(pid);
+    errno = 0;
+    const int t = ::open(probe.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0644);
+    if (t >= 0) {
+      (void)!::write(t, "x", 1);
+      ::close(t);
+      ::unlink(probe.c_str());
+      ProgLine(prog, "download0: write ok");
+    } else {
+      std::snprintf(line, sizeof(line), "download0: write FAILED errno=%d", errno);
+      ProgLine(prog, line);
+    }
+  }
+
+  ops.seteuid(r.euid_before);
+  ProgLine(prog, "seteuid(geteuid()) done");
+
+  const EtahenResult jb = EtahenJailbreakLogged(pid, prog);
+  r.etahen_attempted = jb.attempted;
+  r.etahen_ret = jb.ret;
+  r.helper_completed = jb.ok;
+  r.helper_errno = jb.err;
+
+  if (ops.geteuid() != 0) {
+    r.lapy_requested = ops.write_lapy_marker(LapyTemp(pid), kLapyMarker, LapyBody(pid));
+    ProgLine(prog, r.lapy_requested ? "lapy: marker written (secondary)" : "lapy: marker FAILED");
+  }
+
+  int waited = 0;
+  ops.wait_for_root(r.config.timeout_ms, &waited);
+  r.waited_ms = waited;
+  r.uid_after = ops.getuid();
+  r.euid_after = ops.geteuid();
+  r.elevated_after = r.euid_after == 0;
+  r.data_after = ops.data_write(DataProbeFile(data_root, pid));
+  r.backend = r.elevated_after ? (jb.ok ? Backend::kEtahen : (r.lapy_requested ? Backend::kLapy : Backend::kEtahen))
+                               : Backend::kNone;
+  r.outcome = r.elevated_after ? Outcome::kElevated : Outcome::kNotElevated;
+  std::snprintf(line, sizeof(line),
+                "after uid=%u euid=%u data_after=%d elevated_after=%d waited_ms=%d", r.uid_after,
+                r.euid_after, (int)r.data_after, (int)r.elevated_after, waited);
+  ProgLine(prog, line);
+  std::snprintf(line, sizeof(line), "done result=%s backend=%s", OutcomeName(r.outcome),
+                BackendName(r.backend));
+  ProgLine(prog, line);
+  if (prog >= 0) ::close(prog);
+  return r;
+}
+#endif  // XBOX360PS5_ELEVATE_PROBE_NO_SYSTEM
+
+}  // namespace xbox360ps5::elevate_probe
