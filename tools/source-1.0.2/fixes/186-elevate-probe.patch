diff --git a/include/xbox360ps5/elevate_probe.hpp b/include/xbox360ps5/elevate_probe.hpp
new file mode 100644
--- /dev/null
+++ b/include/xbox360ps5/elevate_probe.hpp
@@ -0,0 +1,316 @@
+// SPDX-License-Identifier: MIT
+// Fix 186: the optional, off-by-default "Unlimited write speed (root)" feature (issue #80). It raises
+// this app to UID 0 (root) at launch, which removes the PS5's per-app ~1.5-1.7 GB write-speed limit,
+// so game data and shader caches save far faster. A strict, SILENT no-op unless the player turns the
+// option on (or a developer sets the override switch file); never required, never closes the app.
+//
+// Why PATH B: the console runs etaHEN, whose 9028 command jailbreaks by an external ptrace HIJACK;
+// that killed our multithreaded emulator at every timing we tried (fix 186b/186c), before it could
+// even log. The method that works on this console (proven by TrinityXSX) is cooperative: the local
+// elfldr loads a bundled one-shot helper ELF as root, and that helper elevates us through the ELV1
+// handshake (we call seteuid(geteuid()) ourselves; no disruptive hijack). Credential-only (fix 186j):
+// UID 0 without the sandbox escape, so the app keeps its own theme, /app0 and game data.
+//
+// This MIT header does the orchestration only -- the gate (the option or the switch file), the
+// before/after uid checks, the one concise outcome line, the safeguards -- and calls the ELV1/elfldr
+// client through a clean interface. That client (port/vendor/lapy) is an ISOLATED LGPL-2.1-or-later
+// module adapted from prospero-win + PS5-Lapy-JB-Daemon; it is a separable, relinkable unit and is
+// NOT fused into this MIT code (see NOTICE.md). The bundled helper ELF (/app0/lapy.elf) is likewise LGPL.
+//
+// The Result's field names (data_before, elevated_before, helper_completed, helper_errno, data_after,
+// elevated_after, waited_ms, settled_ms) mirror TrinityXSX's "PW_WINE64 data_mount ..." line. Release
+// logging is one calm outcome line to boot.log; there is no per-step progress file. Safeguards: off
+// unless opted in; a per-process attempt cap; std:: file I/O only (fix 186f: raw ::umask/::open were
+// null imports on this firmware); on any failure it logs one line and carries on at UID 1.
+#pragma once
+#if !defined(XBOX360PS5_ELEVATE_PROBE_NO_SYSTEM) && defined(_WIN32)
+#define XBOX360PS5_ELEVATE_PROBE_NO_SYSTEM 1
+#endif
+
+#include <atomic>
+#include <cerrno>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <sstream>
+#include <string>
+
+#ifndef XBOX360PS5_ELEVATE_PROBE_NO_SYSTEM
+#include <unistd.h>      // 186f: getpid, geteuid only (toolchain-resolved; umask/open/getuid were not)
+#include <filesystem>
+#include <thread>
+#include "vendor/lapy/lapy_elevation_client.h"  // isolated LGPL-2.1 module (clean interface)
+#endif
+
+namespace xbox360ps5::elevate_probe {
+
+constexpr const char* kHelperPath = "/app0/lapy.elf";  // the bundled LGPL one-shot helper
+constexpr int kMaxAttemptsDefault = 3;
+constexpr int kMaxAttemptsCeiling = 8;
+constexpr int kTimeoutMsDefault = 8000;
+constexpr int kTimeoutMsCeiling = 20000;
+constexpr int kPollStepMs = 100;
+
+enum class Outcome { kOff, kCapped, kNotElevated, kElevated };
+enum class Backend { kNone, kLapyElfldr, kAlready };
+
+inline const char* OutcomeName(Outcome o) {
+  switch (o) {
+    case Outcome::kOff: return "off";
+    case Outcome::kCapped: return "capped";
+    case Outcome::kNotElevated: return "not-elevated";
+    case Outcome::kElevated: return "elevated";
+  }
+  return "?";
+}
+inline const char* BackendName(Backend b) {
+  switch (b) {
+    case Backend::kNone: return "none";
+    case Backend::kLapyElfldr: return "lapy-elfldr-9021";
+    case Backend::kAlready: return "already-root";
+  }
+  return "?";
+}
+
+struct Config {
+  bool on = false;
+  int max_attempts = kMaxAttemptsDefault;
+  int timeout_ms = kTimeoutMsDefault;
+};
+
+inline std::string SwitchFile(const std::string& data_root) { return data_root + "/elevate-probe.txt"; }
+inline std::string Trim(const std::string& s) {
+  size_t a = 0, b = s.size();
+  while (a < b && (unsigned char)s[a] <= ' ') ++a;
+  while (b > a && (unsigned char)s[b - 1] <= ' ') --b;
+  return s.substr(a, b - a);
+}
+inline Config Parse(const std::string& text) {
+  Config c;
+  std::istringstream in(text);
+  std::string line;
+  bool first = true;
+  while (std::getline(in, line)) {
+    const std::string t = Trim(line);
+    if (t.empty() || t[0] == '#') continue;
+    if (first) { first = false; if (t == "on") c.on = true; }
+    const size_t eq = t.find('=');
+    if (eq != std::string::npos) {
+      const std::string key = Trim(t.substr(0, eq));
+      const long value = std::strtol(Trim(t.substr(eq + 1)).c_str(), nullptr, 10);
+      if (key == "attempts" && value >= 1 && value <= kMaxAttemptsCeiling) c.max_attempts = (int)value;
+      if (key == "timeout_ms" && value >= 0 && value <= kTimeoutMsCeiling) c.timeout_ms = (int)value;
+    }
+  }
+  return c;
+}
+inline std::string DataProbeFile(const std::string& data_root, long pid) {
+  return data_root + "/.elevate-probe-write." + std::to_string(pid);
+}
+
+// Fix 186 (issue #80): the production gate. Besides the developer switch file above, the
+// optional "Unlimited write speed (root)" setting turns the elevation on. It is read straight
+// from the general settings file at the early single-threaded point, before Settings::Load
+// runs, so this parses the same "unlimited_write=<n>" line the launcher writes (a non-zero
+// value enables it). settings.txt lives in the app data folder (user_storage::Root(), normally
+// XBOX360PS5_DATA_ROOT); kInternalStorage is the pre-fix-165 fallback, still read in case the
+// move to the data folder has not run yet.
+constexpr const char* kInternalStorage = "/download0/xbox360ps5";
+inline std::string SettingsFile(const std::string& data_root) { return data_root + "/settings.txt"; }
+inline bool SettingsWantElevation(const std::string& settings_text) {
+  std::istringstream in(settings_text);
+  std::string line;
+  while (std::getline(in, line)) {
+    const std::string t = Trim(line);
+    const size_t eq = t.find('=');
+    if (eq == std::string::npos) continue;
+    if (Trim(t.substr(0, eq)) != "unlimited_write") continue;
+    return std::strtol(Trim(t.substr(eq + 1)).c_str(), nullptr, 10) != 0;
+  }
+  return false;
+}
+
+// What one run observed; fields mirror TrinityXSX's PW_WINE64 data_mount line.
+struct Result {
+  Outcome outcome = Outcome::kOff;
+  Backend backend = Backend::kNone;
+  Config config;
+  long pid = 0;
+  unsigned uid_before = 0, euid_before = 0, uid_after = 0, euid_after = 0;
+  bool elevated_before = false, elevated_after = false;
+  bool data_before = false, data_after = false;
+  bool helper_completed = false;  // the ELV1 client returned success
+  int helper_errno = 0;
+  int attempts = 0;
+  int waited_ms = 0, settled_ms = 0;
+
+  std::string Line() const {
+    char buf[512];
+    std::snprintf(buf, sizeof(buf),
+                  "Elevate probe (fix 186): result=%s backend=%s attempts=%d uid_before=%u "
+                  "euid_before=%u data_before=%d elevated_before=%d helper_completed=%d "
+                  "helper_errno=%d waited_ms=%d uid_after=%u euid_after=%u data_after=%d "
+                  "elevated_after=%d settled_ms=%d",
+                  OutcomeName(outcome), BackendName(backend), attempts, uid_before, euid_before,
+                  (int)data_before, (int)elevated_before, (int)helper_completed, helper_errno,
+                  waited_ms, uid_after, euid_after, (int)data_after, (int)elevated_after, settled_ms);
+    return buf;
+  }
+};
+
+inline std::atomic<int>& AttemptCounter() {
+  static std::atomic<int> counter{0};
+  return counter;
+}
+
+struct ElevateResult {
+  bool attempted = false;
+  bool ok = false;
+  int err = 0;
+};
+
+// Host-testable core. Ops: read_text, getuid/geteuid, data_write, elevate_request(pid)->ElevateResult
+// (the ELV1/elfldr client), geteuid-after via re-read; the host check drives it with fakes.
+template <class Ops>
+Result Run(Ops& ops, const std::string& data_root, long pid) {
+  Result r;
+  r.pid = pid;
+  r.config = Parse(ops.read_text(SwitchFile(data_root)));
+  if (!r.config.on) { r.outcome = Outcome::kOff; return r; }
+  r.attempts = AttemptCounter().fetch_add(1) + 1;
+  if (r.attempts > r.config.max_attempts) { r.outcome = Outcome::kCapped; return r; }
+  r.uid_before = ops.getuid();
+  r.euid_before = ops.geteuid();
+  r.elevated_before = r.euid_before == 0;
+  r.data_before = ops.data_write(DataProbeFile(data_root, pid));
+  if (r.elevated_before) {
+    r.backend = Backend::kAlready;
+    r.uid_after = r.uid_before;
+    r.euid_after = r.euid_before;
+    r.elevated_after = true;
+    r.data_after = ops.data_write(DataProbeFile(data_root, pid));
+    r.outcome = Outcome::kElevated;
+    return r;
+  }
+  const ElevateResult e = ops.elevate_request(pid);
+  r.helper_completed = e.ok;
+  r.helper_errno = e.err;
+  r.uid_after = ops.getuid();
+  r.euid_after = ops.geteuid();
+  r.elevated_after = r.euid_after == 0;
+  r.data_after = ops.data_write(DataProbeFile(data_root, pid));
+  r.backend = r.elevated_after ? Backend::kLapyElfldr : Backend::kNone;
+  r.outcome = r.elevated_after ? Outcome::kElevated : Outcome::kNotElevated;
+  return r;
+}
+
+#ifndef XBOX360PS5_ELEVATE_PROBE_NO_SYSTEM
+// The one log sink the caller sets: boot.log (and the game log once it is up). AttemptEarly runs at
+// the earliest single-threaded point, so this is the only channel for its one outcome line. 186f:
+// use ONLY std:: file I/O and getpid()/geteuid() -- raw ::umask/::open were unresolved (null)
+// imports on this firmware, so calling one jumped to address 0 (SIGSEGV, RIP=0); never reintroduce
+// raw POSIX file or uid calls here.
+inline void (*&LogCb())(const char*) {
+  static void (*cb)(const char*) = nullptr;
+  return cb;
+}
+inline void Log(const char* text) { if (LogCb()) LogCb()(text); }
+
+// A real 0666 write in the app's own data folder, removed again (issue #80: a file made while
+// elevated stays usable at UID 1). std::ofstream + std::filesystem only -- no raw POSIX, no umask.
+inline bool DataWrite(const std::string& path) {
+  bool ok = false;
+  {
+    std::ofstream f(path, std::ios::binary | std::ios::trunc);
+    if (f.is_open()) {
+      f << "TRINITYX360\n";
+      f.flush();
+      ok = f.good();
+    }
+  }
+  std::error_code ec;
+  std::filesystem::remove(path, ec);
+  return ok;
+}
+
+// The real entry: run the elevation ONCE at the earliest SINGLE-THREADED point in main() -- after
+// /data is writable and boot.log is up, but before any worker thread starts. The Lapy helper's
+// cooperative APPLY refuses a multi-threaded target (one credential ref required), so this must run
+// before the logger/network threads (186g). Enabled by EITHER the optional "Unlimited write speed
+// (root)" setting (settings.txt, the player-facing switch) OR the developer override file
+// <data>/elevate-probe.txt ("on"); a strict, SILENT no-op otherwise, so a user without the setting
+// or without a jailbreak backend sees nothing. On any failure it logs one calm line and carries on
+// at UID 1 -- the app is never closed. The actual elevation is the isolated LGPL ELV1/elfldr client,
+// called with no progress callback so it stays silent in release.
+inline Result AttemptEarly(const std::string& data_root, void (*log)(const char*) = nullptr) {
+  LogCb() = log;
+  Result r;
+  const long pid = (long)::getpid();
+  r.pid = pid;
+  const auto slurp = [](const std::string& path) {
+    std::ifstream f(path, std::ios::binary);
+    std::ostringstream s;
+    s << f.rdbuf();
+    return s.str();
+  };
+  r.config = Parse(slurp(SwitchFile(data_root)));  // the developer override (also sets attempts/timeout)
+  // The gate: the setting (the player-facing toggle) or the developer switch file.
+  bool want = r.config.on;
+  if (!want) want = SettingsWantElevation(slurp(SettingsFile(data_root)));
+  if (!want) want = SettingsWantElevation(slurp(std::string(kInternalStorage) + "/settings.txt"));
+  if (!want) { r.outcome = Outcome::kOff; return r; }  // silent no-op: no setting, no switch
+  if (AttemptCounter().fetch_add(1) + 1 > r.config.max_attempts) { r.outcome = Outcome::kCapped; return r; }
+
+  // 186f: euid is what matters for issue #80; getuid() was not probed by the toolchain, so skip it.
+  r.euid_before = (unsigned)::geteuid();
+  r.uid_before = r.euid_before;
+  r.elevated_before = r.euid_before == 0;
+
+  if (r.elevated_before) {
+    r.backend = Backend::kAlready;
+    r.uid_after = r.euid_after = r.euid_before;
+    r.elevated_after = true;
+    r.outcome = Outcome::kElevated;
+    Log("Unlimited write speed (fix 186): already running as root (euid 0).");
+    return r;
+  }
+
+  r.data_before = DataWrite(DataProbeFile(data_root, pid));
+  errno = 0;
+  const int rc = lapy_elevation_request((int32_t)pid, kHelperPath, nullptr);  // silent client
+  r.helper_completed = rc == 0;
+  r.helper_errno = rc == 0 ? 0 : (errno ? errno : EIO);
+
+  int waited = 0;
+  while ((unsigned)::geteuid() != 0 && waited < r.config.timeout_ms) {
+    std::this_thread::sleep_for(std::chrono::milliseconds(kPollStepMs));
+    waited += kPollStepMs;
+  }
+  r.waited_ms = waited;
+  r.euid_after = (unsigned)::geteuid();
+  r.uid_after = r.euid_after;
+  r.elevated_after = r.euid_after == 0;
+  r.data_after = DataWrite(DataProbeFile(data_root, pid));
+  r.backend = r.elevated_after ? Backend::kLapyElfldr : Backend::kNone;
+  r.outcome = r.elevated_after ? Outcome::kElevated : Outcome::kNotElevated;
+  if (r.elevated_after) {
+    Log("Unlimited write speed (fix 186): root granted (euid 0); the per-app write limit is lifted.");
+  } else {
+    // One concise, diagnosable line: the client's errno tells the stage -- a connect refusal
+    // (ECONNREFUSED) means no root backend is listening on 127.0.0.1:9021, EACCES/EPROTO mean the
+    // handshake was reached but rejected. Still no scary multi-line trace for ordinary users.
+    char msg[192];
+    std::snprintf(msg, sizeof(msg),
+                  "Unlimited write speed (fix 186): could not elevate (client errno=%d; a connect "
+                  "refusal = no root backend on 127.0.0.1:9021); running normally at UID 1.",
+                  r.helper_errno);
+    Log(msg);
+  }
+  return r;
+}
+#endif  // XBOX360PS5_ELEVATE_PROBE_NO_SYSTEM
+
+}  // namespace xbox360ps5::elevate_probe
