--- /dev/null
+++ b/port/vendor/lapy/lapy_elevation_client.c
@@ -0,0 +1,168 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Isolated LGPL-2.1 elevation client. The ELV1 handshake and the "stream the one-shot ELF to the
+ * local elfldr, then REQUEST/PREPARE/seteuid/PREPARED/RESPONSE" sequence are adapted from
+ * prospero-win (mpereiraesaa, tag v0.3.0, rev 404cac6ebbb236d2486d2796fd28b9bd39f2caa6)
+ * native/pw_lapy_elevation.c; the ELV1 wire format is PS5-Lapy-JB-Daemon's
+ * (rev b48b7d7236eca25c7b9dfd6c040c763ae05dde80). The socket layer uses plain POSIX sockets (the
+ * same the TrinityX360 eboot already uses for its localhost settings server), not prospero-win's
+ * sceNet wrappers, so it links in this eboot. This file is LGPL-2.1-or-later, compiled as a
+ * separable, relinkable unit; TrinityX360's own code stays MIT and calls it only through
+ * lapy_elevation_client.h. See NOTICE.md. */
+#define _POSIX_C_SOURCE 200809L
+#include "lapy_elevation_client.h"
+#include "lapy_elevation_protocol.h"
+
+#include <arpa/inet.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <netinet/in.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/time.h>
+#include <unistd.h>
+
+#define LAPY_PORT 9021
+#define LAPY_TIMEOUT_MS 5000
+#define LAPY_MAX_ELF_SIZE (4u * 1024u * 1024u)
+
+static int send_all(int socket, const void *data, size_t size) {
+    const uint8_t *bytes = (const uint8_t *)data;
+    while (size) {
+        ssize_t count = send(socket, bytes, size, 0);
+        if (count < 0) return -1;
+        if (count == 0) { errno = EPIPE; return -1; }
+        if ((size_t)count > size) { errno = EPROTO; return -1; }
+        bytes += count;
+        size -= (size_t)count;
+    }
+    return 0;
+}
+
+static int receive_all(int socket, void *data, size_t size) {
+    uint8_t *bytes = (uint8_t *)data;
+    while (size) {
+        ssize_t count = recv(socket, bytes, size, 0);
+        if (count < 0) return -1;
+        if (count == 0) { errno = ECONNRESET; return -1; }
+        if ((size_t)count > size) { errno = EPROTO; return -1; }
+        bytes += count;
+        size -= (size_t)count;
+    }
+    return 0;
+}
+
+static int message_matches(const struct lapy_elevation_message *message,
+                           const struct lapy_elevation_message *request, uint32_t kind) {
+    return message->magic == LAPY_ELEVATION_MAGIC &&
+           message->version == LAPY_ELEVATION_VERSION &&
+           message->size == sizeof(*message) && message->kind == kind &&
+           message->capability == request->capability && message->pid == request->pid;
+}
+
+static int status_errno(uint32_t status) {
+    switch (status) {
+    case LAPY_ELEVATION_TARGET_MISMATCH: return ESRCH;
+    case LAPY_ELEVATION_UNAVAILABLE: return ENOENT;
+    case LAPY_ELEVATION_PREPARE_FAILED: return EPERM;
+    case LAPY_ELEVATION_TRANSPORT_ERROR: return ETIMEDOUT;
+    case LAPY_ELEVATION_OK: return 0;
+    default: return EACCES;
+    }
+}
+
+static int exchange(int socket, struct lapy_elevation_message *request,
+                    void (*progress)(const char *)) {
+    struct lapy_elevation_message message;
+    if (send_all(socket, request, sizeof(*request)) ||
+        receive_all(socket, &message, sizeof(message))) {
+        errno = errno ? errno : EIO;
+        return -1;
+    }
+    if (message_matches(&message, request, LAPY_ELEVATION_RESPONSE)) {
+        /* A success without the PREPARE/PREPARED handshake never cloned the
+         * target credential natively; reject it. */
+        if (message.status == LAPY_ELEVATION_OK) { errno = EPROTO; return -1; }
+        errno = status_errno(message.status);
+        return -1;
+    }
+    if (!message_matches(&message, request, LAPY_ELEVATION_PREPARE)) { errno = EPROTO; return -1; }
+    if (message.status != LAPY_ELEVATION_OK) { errno = status_errno(message.status); return -1; }
+
+    /* Cooperative point: clone our credentials only after the helper validated
+     * the requested PID and title. */
+    struct lapy_elevation_message prepared = *request;
+    prepared.kind = LAPY_ELEVATION_PREPARED;
+    if (seteuid(geteuid()) != 0) prepared.status = LAPY_ELEVATION_PREPARE_FAILED;
+    if (progress) progress("lapy: PREPARE ok, sent PREPARED (seteuid done)");
+    if (send_all(socket, &prepared, sizeof(prepared)) ||
+        receive_all(socket, &message, sizeof(message))) {
+        errno = errno ? errno : EIO;
+        return -1;
+    }
+    if (!message_matches(&message, request, LAPY_ELEVATION_RESPONSE)) { errno = EPROTO; return -1; }
+    errno = status_errno(message.status);
+    return message.status == LAPY_ELEVATION_OK ? 0 : -1;
+}
+
+int lapy_elevation_request(int32_t pid, const char *helper_path,
+                           void (*progress)(const char *)) {
+    struct stat st;
+    struct sockaddr_in address;
+    struct timeval tv;
+    struct lapy_elevation_message request;
+    uint8_t buffer[4096];
+    int helper = -1, sock = -1, result = -1, saved_errno = EIO;
+
+    request.magic = LAPY_ELEVATION_MAGIC;
+    request.version = LAPY_ELEVATION_VERSION;
+    request.size = sizeof(struct lapy_elevation_message);
+    request.kind = LAPY_ELEVATION_REQUEST;
+    request.capability = LAPY_ELEVATION_FILESYSTEM;
+    request.pid = (uint32_t)pid;
+    request.status = LAPY_ELEVATION_OK;
+
+    if (pid <= 1 || !helper_path) { errno = EINVAL; return -1; }
+    helper = open(helper_path, O_RDONLY);
+    if (helper < 0) return -1;
+    if (fstat(helper, &st)) { saved_errno = errno ? errno : EIO; goto done; }
+    if (!S_ISREG(st.st_mode) || st.st_size <= 0) { saved_errno = EINVAL; goto done; }
+    if ((uint64_t)st.st_size > LAPY_MAX_ELF_SIZE) { saved_errno = EFBIG; goto done; }
+
+    if (progress) progress("lapy: socket");
+    sock = socket(AF_INET, SOCK_STREAM, 0);
+    if (sock < 0) { saved_errno = errno ? errno : EIO; goto done; }
+    tv.tv_sec = LAPY_TIMEOUT_MS / 1000;
+    tv.tv_usec = (LAPY_TIMEOUT_MS % 1000) * 1000;
+    (void)setsockopt(sock, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+    (void)setsockopt(sock, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+    memset(&address, 0, sizeof(address));
+    address.sin_family = AF_INET;
+    address.sin_port = htons((uint16_t)LAPY_PORT);
+    inet_pton(AF_INET, "127.0.0.1", &address.sin_addr);
+    if (progress) progress("lapy: connect 127.0.0.1:9021");
+    if (connect(sock, (const struct sockaddr *)&address, sizeof(address)) != 0) {
+        saved_errno = errno ? errno : EIO;
+        goto done;
+    }
+    if (progress) progress("lapy: connected, streaming helper ELF");
+
+    for (;;) {
+        ssize_t count = read(helper, buffer, sizeof(buffer));
+        if (count == 0) break;
+        if (count < 0) { saved_errno = errno ? errno : EIO; goto done; }
+        if (send_all(sock, buffer, (size_t)count)) { saved_errno = errno ? errno : EIO; goto done; }
+    }
+    if (progress) progress("lapy: ELF sent, ELV1 handshake (seteuid + wait for RESPONSE)");
+    if (exchange(sock, &request, progress) == 0) result = 0;
+    else saved_errno = errno ? errno : EIO;
+    if (progress) progress(result == 0 ? "lapy: RESPONSE OK (elevated)" : "lapy: handshake failed");
+
+done:
+    if (sock >= 0) (void)close(sock);
+    if (helper >= 0) (void)close(helper);
+    if (result) errno = saved_errno;
+    return result;
+}
