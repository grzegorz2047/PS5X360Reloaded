@@ -1786,11 +1788,21 @@ void Launcher::RecordLaunch(const GameEntry& game, uint32_t title_id, const std:
     std::ofstream output(cache.string() + ".png", std::ios::trunc | std::ios::binary);
     output.write(reinterpret_cast<const char*>(icon.data()), std::streamsize(icon.size()));
   }
-  std::vector<std::string> recents{path};
-  for (const auto& other : recents_) if (other != path && recents.size() < 12) recents.push_back(other);
-  recents_ = recents;
-  std::ofstream output(UserData() / "recent.txt", std::ios::trunc);
-  for (const auto& line : recents_) output << line << "\n";
+  // Fix 181 (recent_list.hpp): a start without a library scan (launch-once.txt: a game restarting
+  // the app into itself) has no list yet; the one on disk is read first, so its other games stay.
+  const fs::path recent_file = UserData() / "recent.txt";
+  if (!recents_loaded_) {
+    const auto loaded = recent_list::Load(recent_file);
+    if (loaded.usable) {
+      recents_ = loaded.paths;
+    } else {
+      recents_.clear();
+      XELOGW("Recent games: {}; the list starts again with this game", loaded.why);
+    }
+    recents_loaded_ = true;
+  }
+  recents_ = recent_list::Front(path, recents_);
+  if (!recent_list::Save(recent_file, recents_)) XELOGW("Recent games: {} could not be written", recent_file.string());
 }
 
