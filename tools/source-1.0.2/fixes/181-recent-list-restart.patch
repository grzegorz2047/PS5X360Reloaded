--- /dev/null
+++ b/include/xbox360ps5/recent_list.hpp
@@ -0,0 +1,163 @@
+// SPDX-License-Identifier: MIT
+// Fix 181 (tools/source-1.0.2/fixes/181-recent-list-restart.patch): the recently played list
+// (<data>/recent.txt, fix 165: one game path a line, most recent first, at most kLimit) keeps its
+// other games when a game starts without the library.
+//
+// The launcher read recent.txt only in Launcher::Scan. A start that goes straight into a game
+// (launch-once.txt: a game with start options of its own restarting the app into itself, the
+// guide's "Restart game", the dashboard's games; a forwarder without its library entry) has no
+// scan, so Launcher::RecordLaunch put the game in front of an empty list and wrote recent.txt with
+// that one path: the other recent games were gone, and a multi-disc game's remembered disc (fix 89:
+// the set's disc found first in the list) could change with them. Now RecordLaunch, when no scan
+// read the list, reads recent.txt first (Load) and puts the game in front of what it holds (Front),
+// as it does with the scanned list. The order is all the per-disc and per-group rules use (fix 89's
+// DefaultDisc, fix 112's group recency: the first line naming one of their games), so putting the
+// started disc first is the same rule as before.
+//
+//   * Load: a missing file is an empty list; lines are taken as Scan takes them (empty ones left
+//     out, a carriage return at the end removed), a path that comes again is kept once (its first
+//     place). A file that cannot be a list of paths (larger than kMaxBytes, a line longer than
+//     kMaxLine, a control character in a line) is not used: the list is then the started game
+//     alone, as before this fix, and the log says why.
+//   * Front: the started path first, then the others in their order without it, kLimit in all.
+//   * Save: written to recent.txt.new, then renamed over recent.txt, so a start that stops while
+//     writing leaves the old list.
+// Header only and free of the rest of the title, so tools/check-recent-list.cpp drives it.
+#pragma once
+#include <algorithm>
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <set>
+#include <string>
+#include <system_error>
+#include <vector>
+
+namespace xbox360ps5::recent_list {
+namespace fs = std::filesystem;
+
+// Games in the list, the started one included (unchanged from before fix 181).
+inline constexpr size_t kLimit = 12;
+// Larger than any list of kLimit real paths: more is not a recent list.
+inline constexpr size_t kMaxBytes = 64 * 1024;
+inline constexpr size_t kMaxLine = 4096;
+
+struct Loaded {
+  std::vector<std::string> paths;  // most recent first, each once
+  bool usable = true;              // false: the file is no list of paths (why says what)
+  std::string why;
+};
+
+// The lines of recent.txt's text.
+inline Loaded Parse(const std::string& text) {
+  Loaded loaded;
+  if (text.size() > kMaxBytes) {
+    loaded.usable = false;
+    loaded.why = "recent.txt is " + std::to_string(text.size()) + " bytes";
+    return loaded;
+  }
+  std::set<std::string> seen;
+  size_t start = 0, number = 0;
+  while (start < text.size()) {
+    size_t end = text.find('\n', start);
+    if (end == std::string::npos) end = text.size();
+    std::string line = text.substr(start, end - start);
+    start = end + 1;
+    ++number;
+    if (!line.empty() && line.back() == '\r') line.pop_back();
+    if (line.empty()) continue;
+    if (line.size() > kMaxLine) {
+      loaded = Loaded();
+      loaded.usable = false;
+      loaded.why = "recent.txt line " + std::to_string(number) + " is " + std::to_string(line.size()) + " bytes";
+      return loaded;
+    }
+    for (const unsigned char c : line) {
+      if (c < 0x20 || c == 0x7F) {
+        loaded = Loaded();
+        loaded.usable = false;
+        loaded.why = "recent.txt line " + std::to_string(number) + " holds a control character";
+        return loaded;
+      }
+    }
+    if (seen.insert(line).second) loaded.paths.push_back(line);
+  }
+  return loaded;
+}
+
+// recent.txt as it is on disk (missing: an empty list).
+inline Loaded Load(const fs::path& file) {
+  std::error_code error;
+  if (!fs::exists(file, error)) {
+    Loaded none;
+    if (error) {
+      none.usable = false;
+      none.why = "recent.txt could not be looked at: " + error.message();
+    }
+    return none;
+  }
+  const auto size = fs::file_size(file, error);
+  if (!error && size > kMaxBytes) {
+    Loaded big;
+    big.usable = false;
+    big.why = "recent.txt is " + std::to_string(size) + " bytes";
+    return big;
+  }
+  std::ifstream in(file, std::ios::binary);
+  if (!in) {
+    Loaded unread;
+    unread.usable = false;
+    unread.why = "recent.txt could not be opened";
+    return unread;
+  }
+  std::string text;
+  char buffer[4096];
+  while (in.read(buffer, sizeof(buffer)) || in.gcount() > 0) {
+    text.append(buffer, size_t(in.gcount()));
+    if (text.size() > kMaxBytes) break;
+  }
+  return Parse(text);
+}
+
+// The started path first, then the others without it, at most `limit` in all.
+inline std::vector<std::string> Front(const std::string& path, const std::vector<std::string>& before,
+                                      size_t limit = kLimit) {
+  std::vector<std::string> paths{path};
+  for (const auto& other : before)
+    if (other != path && paths.size() < limit && std::find(paths.begin(), paths.end(), other) == paths.end())
+      paths.push_back(other);
+  return paths;
+}
+
+inline std::string Format(const std::vector<std::string>& paths) {
+  std::string text;
+  for (const auto& line : paths) text += line + "\n";
+  return text;
+}
+
+// Writes the list through recent.txt.new and a rename. False: the old file is left as it was.
+inline bool Save(const fs::path& file, const std::vector<std::string>& paths) {
+  const fs::path temporary = file.string() + ".new";
+  {
+    std::ofstream out(temporary, std::ios::binary | std::ios::trunc);
+    if (!out) return false;
+    out << Format(paths);
+    out.close();
+    if (!out) {
+      std::error_code ignored;
+      fs::remove(temporary, ignored);
+      return false;
+    }
+  }
+  std::error_code error;
+  fs::rename(temporary, file, error);
+  if (error) {
+    std::error_code ignored;
+    fs::remove(temporary, ignored);
+    return false;
+  }
+  return true;
+}
+
+}  // namespace xbox360ps5::recent_list
