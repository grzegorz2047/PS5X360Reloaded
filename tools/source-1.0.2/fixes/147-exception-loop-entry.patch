+// Xbox360PS5 fix 147: a game that enters its main loop through a deliberate
+// crash (Dance Central 3: SetUnhandledExceptionFilter(filter), then a store to
+// address 0 whose exception runs the filter, and the filter the game loop). The
+// emulator does not hand guest access violations to the guest, so that store
+// becomes a call of the filter (xbox360ps5/exception_loop_entry.hpp finds the
+// shape). Every other executable is left as it is.
+static void Xbox360PS5EnterExceptionLoops(Memory* memory, UserModule* module) {
+  if (!module || !module->is_executable() || !module->xex_module()) {
+    return;
+  }
+  cpu::XexModule* xex = module->xex_module();
+  const uint32_t base = xex->base_address(), size = xex->image_size();
+  if (!size || uint64_t(base) + size > 0x100000000ull) {
+    return;
+  }
+  for (uint64_t at = base; at < uint64_t(base) + size;
+       at = (at & ~uint64_t(4095)) + 4096) {
+    auto* heap = memory->LookupHeap(uint32_t(at));
+    uint32_t protection = 0;
+    if (!heap || !heap->QueryProtect(uint32_t(at), &protection) ||
+        !(protection & kMemoryProtectRead)) {
+      return;
+    }
+  }
+  const auto scan = xbox360ps5::exception_loop::Find(
+      {memory->TranslateVirtual<const uint8_t*>(base), size, base});
+  for (const std::string& why : scan.refused) {
+    XELOGW("Exception loop (fix 147): title {:08X}, left alone at {}",
+           module->title_id(), why);
+  }
+  for (const auto& site : scan.sites) {
+    auto* heap = memory->LookupHeap(site.null_store);
+    uint32_t old_protect = 0;
+    if (!heap || !heap->QueryProtect(site.null_store, &old_protect)) {
+      continue;
+    }
+    heap->Protect(site.null_store, 4,
+                  kMemoryProtectRead | kMemoryProtectWrite);
+    xe::store_and_swap<uint32_t>(memory->TranslateVirtual(site.null_store),
+                                 site.new_word);
+    heap->Protect(site.null_store, 4, old_protect);
+    XELOGW(
+        "Exception loop (fix 147): title {:08X}: the store to address 0 at "
+        "{:08X} after SetUnhandledExceptionFilter ({:08X}, called at {:08X}) "
+        "now calls the filter {:08X} (word {:08X} -> {:08X})",
+        module->title_id(), site.null_store, site.set_filter, site.call,
+        site.filter, site.old_word, site.new_word);
+  }
+}
