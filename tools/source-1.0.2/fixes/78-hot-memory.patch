+inline constexpr uint32_t kHotShown = 5;
+class HotReporter {
+ public:
+  std::string Line(double seconds) {
+    const double s = seconds > 0 ? seconds : 1;
+    struct Row { uint32_t block, protects, notices; uint8_t kinds; };
+    std::array<Row, kHotShown> top{};
+    uint32_t armed = 0, noticed = 0;
