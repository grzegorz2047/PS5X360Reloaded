+        if (row.protects > top[i].protects) {
+          for (uint32_t j = kHotShown - 1; j > i; --j) top[j] = top[j - 1];
+          top[i] = row;
+          break;
+        }
+      }
+    }
+    std::string parts;
+    for (const Row& row : top) {
+      if (!row.protects) break;
+      std::string kinds;
+      for (uint32_t k = 0; k < kArmKinds; ++k)
+        if (row.kinds & (1u << k)) kinds += (kinds.empty() ? "" : ", ") + std::string(ArmKindName(k));
+      char item[160];
+      std::snprintf(item, sizeof(item), "%s%08X %.0f protections/s, %.0f write notices/s (%s)", parts.empty() ? "" : "; ",
+                    row.block << kHotBlockShift, double(row.protects) / s, double(row.notices) / s,
+                    kinds.empty() ? "-" : kinds.c_str());
+      parts += item;
+    }
+    char tail[96];
+    std::snprintf(tail, sizeof(tail), "%s%u blocks armed, %u with write notices", parts.empty() ? "" : "; ", armed, noticed);
+    return "Frame time hot memory (64 KiB physical blocks by watch arming): " + parts + tail;
+  }
+
+ private:
+  std::array<uint32_t, kHotBlocks> last_protects_{}, last_notices_{};
+};
