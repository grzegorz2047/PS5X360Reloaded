diff --git a/.deps/xenia-canary/src/xenia/gpu/unwatched_lock_free.h b/.deps/xenia-canary/src/xenia/gpu/unwatched_lock_free.h
new file mode 100644
--- /dev/null
+++ b/.deps/xenia-canary/src/xenia/gpu/unwatched_lock_free.h
@@ -0,0 +1,70 @@
+/**
+ ******************************************************************************
+ * Xbox360PS5: fix 111, requests over checked unwatched units without the lock.*
+ ******************************************************************************
+ * A unit left unwatched ("Optimized video memory", fix 36) is never valid, so
+ * every request over it took the global critical region in
+ * SharedMemory::RequestRange to find its invalid pages, only for
+ * FilterUnwatched to drop the units already checked in this part of the ring
+ * (fix 87) without uploading anything. Red Dead Redemption on
+ * 1.0.5_candidate_64 (fix 88's line): the GPU command thread took the lock
+ * there 13,000 to 22,000 times a second, 33 to 42 ms/s waiting for it, while
+ * the guest's write faults hold it.
+ *
+ * NothingToUpload() answers such a request without the lock: true when every
+ * unit of the range is valid, or unwatched and checked in the current part of
+ * the ring, which is exactly when the locked path ends with nothing to upload
+ * and no other effect for a request that allows unwatched units. The bits are
+ * read as FilterUnwatched reads them (relaxed, without the lock): a unit being
+ * left unwatched or watched again right now is a race the locked path has as
+ * well, between its search and the filter.
+ ******************************************************************************
+ */
+
+#ifndef XENIA_GPU_UNWATCHED_LOCK_FREE_H_
+#define XENIA_GPU_UNWATCHED_LOCK_FREE_H_
+
+#include <cstdint>
+
+namespace xe {
+namespace gpu {
+namespace unwatched_lock_free {
+
+// `valid` and `unwatched`: a bit per unit in 64-bit words; `unit_chunk`: the
+// part of the ring each unit was last checked in; `chunk`: the current part.
+inline bool NothingToUpload(const uint64_t* valid, const uint64_t* unwatched,
+                            const uint32_t* unit_chunk, uint32_t chunk,
+                            uint32_t first, uint32_t last) {
+  const uint32_t block_first = first >> 6, block_last = last >> 6;
+  for (uint32_t block = block_first; block <= block_last; ++block) {
+    uint64_t need = UINT64_MAX;
+    if (block == block_first) {
+      need &= ~((UINT64_C(1) << (first & 63)) - 1);
+    }
+    if (block == block_last && (last & 63) != 63) {
+      need &= (UINT64_C(1) << ((last & 63) + 1)) - 1;
+    }
+    uint64_t invalid =
+        ~__atomic_load_n(&valid[block], __ATOMIC_ACQUIRE) & need;
+    if (!invalid) {
+      continue;
+    }
+    if (invalid & ~__atomic_load_n(&unwatched[block], __ATOMIC_RELAXED)) {
+      return false;  // a watched unit to upload
+    }
+    while (invalid) {
+      const uint32_t bit = uint32_t(__builtin_ctzll(invalid));
+      if (unit_chunk[(block << 6) + bit] != chunk) {
+        return false;  // not checked in this part yet: the filter hashes it
+      }
+      invalid &= invalid - 1;
+    }
+  }
+  return true;
+}
+
+}  // namespace unwatched_lock_free
+}  // namespace gpu
+}  // namespace xe
+
+#endif  // XENIA_GPU_UNWATCHED_LOCK_FREE_H_
