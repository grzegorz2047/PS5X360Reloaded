@@ -19,15 +19,19 @@ namespace xbox360ps5::guide_quick {
 // Where a value the guide changes is kept.
 enum class Keep { game, general };
 
-// The options the guide keeps for the running game even when it has no value of its own yet.
-inline bool KeptForGame(std::string_view key) { return key == "volume"; }
-
-// own: the game already has its own value of this option; preset: its preset sets it;
+// Fix 143: a value changed in the guide is the running game's own, as the guide is opened over
+// that game; the launcher stays the place to change an option for every game. Before, the guide
+// kept a value for every game unless the game already had one of its own or a preset (fix 115
+// made Game volume the one exception), so a first change there (the video rate's 120 Hz test,
+// anisotropic filtering in Dragon Age II) silently changed every game.
+// per_game: the option's flag in the launcher's table (a game may have its own value). The
+// options without it are the console's own, the same in every game: the interface sounds and
+// their volume, the Sound switch (the guide's "Mute game sound"), the touchpad click, Show FPS,
+// achievement notifications, Smooth gradients; a game's file cannot hold them (LoadGameOverrides
+// drops them), so they stay general.
 // title_known: the running game has a title ID (its own options can be saved).
-inline Keep WhereToKeep(std::string_view key, bool own, bool preset, bool title_known) {
-  if (own || preset) return Keep::game;  // the rule from before (where the value came from)
-  if (title_known && KeptForGame(key)) return Keep::game;
-  return Keep::general;
+inline Keep WhereToKeep(bool per_game, bool title_known) {
+  return per_game && title_known ? Keep::game : Keep::general;
 }
 
