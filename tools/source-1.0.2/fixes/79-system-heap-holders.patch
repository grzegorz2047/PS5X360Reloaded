diff --git a/include/xbox360ps5/system_heap_watch.hpp b/include/xbox360ps5/system_heap_watch.hpp
new file mode 100644
--- /dev/null
+++ b/include/xbox360ps5/system_heap_watch.hpp
@@ -0,0 +1,138 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+// Fix 79: the emulator's own allocations in the guest's 4 KiB heap (Memory::SystemHeapAlloc),
+// by the code that made them. Battlefield 3 on 1.0.4 and 1.0.5 candidates: that heap grows by
+// about 0.45 MiB a second in play while the game's own allocations stay flat, until after about
+// 14 minutes BaseHeap::Alloc finds no room and the game reads through a null pointer. Each
+// allocation is noted with its host caller (or, for a kernel object made by XObject::CreateNative,
+// its object type) until it is freed; the summary gives the callers holding the most, and how
+// many each gained since its previous line.
+#include <algorithm>
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace xbox360ps5 {
+namespace system_heap {
+
+// A function of the title's own: its address at run time, with the symbol's address in the
+// build's eboot-symbols.txt, turns a caller's address into one in that file.
+inline void Anchor() { asm volatile(""); }
+
+// A caller above kObjectTag is a kernel object's type (XObject::Type), not a code address.
+inline constexpr uint64_t kObjectTag = 0xFFFFFFFF00000000ull;
+inline const char* ObjectTypeName(uint32_t type) {
+  static const char* const names[] = {"Undefined", "Enumerator", "Event",  "File",          "IOCompletion",
+                                      "Module",    "Mutant",     "NotifyListener", "Semaphore", "Session",
+                                      "Socket",    "SymbolicLink", "Thread", "Timer",        "Device"};
+  return type < sizeof(names) / sizeof(names[0]) ? names[type] : "?";
+}
+
+struct Caller {
+  uint64_t live = 0, live_bytes = 0, allocations = 0, frees = 0, reported_live = 0;
+};
+struct State {
+  std::mutex mutex;
+  std::unordered_map<uint32_t, std::pair<uint64_t, uint32_t>> blocks;  // address -> caller, size
+  std::unordered_map<uint64_t, Caller> callers;
+};
+inline State& Get() {
+  static State state;
+  return state;
+}
+
+inline void NoteAlloc(uint32_t address, uint32_t size, const void* caller) {
+  if (!address) return;
+  State& s = Get();
+  const uint64_t key = reinterpret_cast<uintptr_t>(caller);
+  std::lock_guard<std::mutex> lock(s.mutex);
+  s.blocks[address] = {key, size};
+  Caller& c = s.callers[key];
+  ++c.live;
+  c.live_bytes += size;
+  ++c.allocations;
+}
+inline void NoteFree(uint32_t address) {
+  if (!address) return;
+  State& s = Get();
+  std::lock_guard<std::mutex> lock(s.mutex);
+  const auto it = s.blocks.find(address);
+  if (it == s.blocks.end()) return;
+  Caller& c = s.callers[it->second.first];
+  if (c.live) --c.live;
+  c.live_bytes -= std::min<uint64_t>(c.live_bytes, it->second.second);
+  ++c.frees;
+  s.blocks.erase(it);
+}
+// The block at address belongs to a kernel object of this type (XObject::CreateNative).
+inline void NoteObject(uint32_t address, uint32_t type) {
+  if (!address) return;
+  State& s = Get();
+  std::lock_guard<std::mutex> lock(s.mutex);
+  const auto it = s.blocks.find(address);
+  if (it == s.blocks.end()) return;
+  Caller& from = s.callers[it->second.first];
+  if (from.live) --from.live;
+  from.live_bytes -= std::min<uint64_t>(from.live_bytes, it->second.second);
+  if (from.allocations) --from.allocations;
+  it->second.first = kObjectTag | type;
+  Caller& to = s.callers[it->second.first];
+  ++to.live;
+  to.live_bytes += it->second.second;
+  ++to.allocations;
+}
+
+inline constexpr size_t kShown = 6;
+// "System heap (emulator allocations in the guest 4 KiB heap): n live, x KiB; by holder: holder
+// live n (+g since the previous line), allocated a, freed f, b bytes each; ...; anchor 0x..."
+inline std::string Line(uintptr_t anchor = reinterpret_cast<uintptr_t>(&Anchor)) {
+  State& s = Get();
+  std::lock_guard<std::mutex> lock(s.mutex);
+  struct Row {
+    uint64_t key;
+    Caller c;
+    int64_t gained;
+  };
+  std::vector<Row> rows;
+  uint64_t live = 0, bytes = 0;
+  for (auto& [key, c] : s.callers) {
+    live += c.live;
+    bytes += c.live_bytes;
+    rows.push_back({key, c, int64_t(c.live) - int64_t(c.reported_live)});
+    c.reported_live = c.live;
+  }
+  std::sort(rows.begin(), rows.end(), [](const Row& a, const Row& b) {
+    return a.gained != b.gained ? a.gained > b.gained : a.c.live > b.c.live;
+  });
+  char head[128];
+  std::snprintf(head, sizeof(head), "System heap (emulator allocations in the guest 4 KiB heap): %llu live, %llu KiB; by holder: ",
+                (unsigned long long)live, (unsigned long long)(bytes >> 10));
+  std::string text = head;
+  size_t shown = 0;
+  for (const Row& row : rows) {
+    if (shown == kShown || !row.c.live) continue;
+    char who[64];
+    if (row.key >= kObjectTag)
+      std::snprintf(who, sizeof(who), "object %s", ObjectTypeName(uint32_t(row.key)));
+    else
+      std::snprintf(who, sizeof(who), "caller 0x%llx", (unsigned long long)row.key);
+    char item[200];
+    std::snprintf(item, sizeof(item), "%s%s live %llu (%+lld since the previous line), allocated %llu, freed %llu, %llu bytes each",
+                  shown ? "; " : "", who, (unsigned long long)row.c.live, (long long)row.gained,
+                  (unsigned long long)row.c.allocations, (unsigned long long)row.c.frees,
+                  (unsigned long long)(row.c.live ? row.c.live_bytes / row.c.live : 0));
+    text += item;
+    ++shown;
+  }
+  char tail[64];
+  std::snprintf(tail, sizeof(tail), "%sanchor 0x%llx", shown ? "; " : "", (unsigned long long)anchor);
+  return text + tail;
+}
+
+}  // namespace system_heap
+}  // namespace xbox360ps5
