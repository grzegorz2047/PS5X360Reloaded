--- /dev/null
+++ b/include/xbox360ps5/bug_report.hpp
@@ -0,0 +1,296 @@
+// SPDX-License-Identifier: MIT
+// Fix 93: logs for a bug report. A player turns on "Logs for a bug report" (Settings, System)
+// before starting a game; that one game session records more detail (Settings::Apply,
+// canary_game_main.cpp) and the setting turns itself off as the game starts. When the launcher
+// next comes up (after the game was closed, or the emulator was started again after a crash)
+// it lists the session's files with their paths on the console, puts them in one .zip beside
+// them and says how to get them to a phone or computer and attach them to a GitHub issue.
+//
+// The state between the starts of the title (every game start and every return to the
+// launcher is a new process) is a small text file, bug-report.txt in the title's storage:
+//   phase=running|ready|shown, game=<name>, title=<title ID>, started=<seconds since 1970, UTC>,
+//   log=<a session log's full path> (one line each).
+// Header-only, no Xenia headers: the host check (tools/check-bug-report.cpp) builds it as it is.
+#pragma once
+#include "xbox360ps5/log_zip.hpp"
+#include <algorithm>
+#include <sys/stat.h>
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <ctime>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <memory>
+#include <mutex>
+#include <sstream>
+#include <string>
+#include <system_error>
+#include <vector>
+namespace xbox360ps5::bug_report {
+namespace fs = std::filesystem;
+// Where players report problems (shown on the screen, without the scheme).
+inline constexpr const char* kIssues = "github.com/grzegorz2047/PS5X360Reloaded/issues";
+// The archives kept in the logs folder; older ones are removed when a new one is made.
+inline constexpr size_t kArchivesKept = 5;
+// boot.log collects every start of the title: the archive takes its end only.
+inline constexpr size_t kBootLogTail = 4u << 20;
+enum class Phase { none, running, ready, shown };
+struct State {
+  Phase phase = Phase::none;
+  std::string game, title;
+  int64_t started = 0;
+  std::vector<std::string> logs;
+};
+inline const char* PhaseName(Phase phase) {
+  switch (phase) {
+    case Phase::running: return "running";
+    case Phase::ready: return "ready";
+    case Phase::shown: return "shown";
+    default: return "none";
+  }
+}
+inline std::string OneLine(std::string text) {
+  for (char& c : text) if (c == '\n' || c == '\r') c = ' ';
+  return text;
+}
+inline std::string Format(const State& state) {
+  std::string text = std::string("phase=") + PhaseName(state.phase) + "\ngame=" + OneLine(state.game) +
+                     "\ntitle=" + OneLine(state.title) + "\nstarted=" + std::to_string(state.started) + "\n";
+  for (const auto& log : state.logs) text += "log=" + OneLine(log) + "\n";
+  return text;
+}
+inline State Parse(const std::string& text) {
+  State state;
+  std::istringstream lines(text);
+  for (std::string line; std::getline(lines, line);) {
+    if (!line.empty() && line.back() == '\r') line.pop_back();
+    const size_t equals = line.find('=');
+    if (equals == std::string::npos) continue;
+    const std::string key = line.substr(0, equals), value = line.substr(equals + 1);
+    if (key == "phase") {
+      state.phase = value == "running" ? Phase::running : value == "ready" ? Phase::ready
+                  : value == "shown" ? Phase::shown : Phase::none;
+    } else if (key == "game") state.game = value;
+    else if (key == "title") state.title = value;
+    else if (key == "started") state.started = std::strtoll(value.c_str(), nullptr, 10);
+    else if (key == "log" && !value.empty() && state.logs.size() < 64) state.logs.push_back(value);
+  }
+  return state;
+}
+inline State Read(const fs::path& file) {
+  std::ifstream input(file, std::ios::binary);
+  if (!input) return State{};
+  return Parse(std::string((std::istreambuf_iterator<char>(input)), std::istreambuf_iterator<char>()));
+}
+// Written to a new file, then renamed over the old one: a start that ends half way through
+// leaves the previous state, never half of one.
+inline bool Write(const fs::path& file, const State& state) {
+  const fs::path next = file.string() + ".new";
+  {
+    std::ofstream output(next, std::ios::binary | std::ios::trunc);
+    output << Format(state);
+    output.flush();
+    if (!output) return false;
+  }
+  std::error_code error;
+  fs::rename(next, file, error);
+  return !error;
+}
+// Whether this process runs a session with detailed logs: read where the extra diagnostics are
+// decided (Settings::Apply's log level, the game loop's summaries and recent system calls). A
+// relaxed atomic load where it is off: nothing else is done.
+inline std::atomic<bool> active{false};
+inline bool Active() { return active.load(std::memory_order_relaxed); }
+// At the title's start. A session that was running has ended (the game was closed, it crashed,
+// or the system ended the title) unless this start goes on with it: a title switch (the game
+// started another of its executables) is the same session. Returns whether it goes on.
+inline bool AtBoot(State& state, bool title_switch) {
+  if (state.phase != Phase::running) return false;
+  if (title_switch) return true;
+  state.phase = Phase::ready;
+  return false;
+}
+// A game starts with the setting on: a new session, replacing any earlier report.
+inline State Begin(const std::string& game, const std::string& title, int64_t now) {
+  State state;
+  state.phase = Phase::running;
+  state.game = game;
+  state.title = title;
+  state.started = now;
+  return state;
+}
+struct File {
+  fs::path path;
+  uintmax_t size = 0;
+  bool tail = false;  // Only its last kBootLogTail bytes go into the archive.
+};
+inline int64_t ModifiedAt(const fs::path& path) {
+  struct stat info{};
+  return ::stat(path.string().c_str(), &info) == 0 ? int64_t(info.st_mtime) : -1;
+}
+// The files of a session: its game logs with their rotated parts (session_log.hpp: <log>.part1
+// to .part3), the hang watch's file and the shader dumps of a hang written in the logs folder
+// since the session started (canary_game_main.cpp: hang-watch-<title>-<UTC>.txt,
+// hang-<hash>-vs|ps.ucode and .txt), then the boot log, where crash records also go: the first
+// of `boot_logs` that exists (one file under two names counts once).
+inline std::vector<File> Files(const State& state, const std::vector<fs::path>& boot_logs) {
+  std::vector<File> files;
+  std::error_code error;
+  const auto add = [&](const fs::path& path, bool tail) {
+    std::error_code e;
+    if (!fs::is_regular_file(path, e)) return false;
+    for (const auto& known : files) {
+      std::error_code same_error;
+      if (known.path == path || fs::equivalent(known.path, path, same_error)) return false;
+    }
+    const uintmax_t size = fs::file_size(path, e);
+    files.push_back({path, e ? 0 : size, tail});
+    return true;
+  };
+  for (const auto& log : state.logs) {
+    const fs::path path = log;
+    add(path, false);
+    for (int part = 1; part <= 3; ++part)
+      add(path.parent_path() / (path.stem().string() + ".part" + std::to_string(part) + ".log"), false);
+  }
+  if (!state.logs.empty()) {
+    const fs::path folder = fs::path(state.logs.front()).parent_path();
+    std::vector<fs::path> found;
+    for (fs::directory_iterator it(folder, error), end; !error && it != end; it.increment(error)) {
+      const std::string name = it->path().filename().string();
+      const bool text = name.size() > 4 && name.compare(name.size() - 4, 4, ".txt") == 0;
+      const bool ucode = name.size() > 6 && name.compare(name.size() - 6, 6, ".ucode") == 0;
+      // A second's slack: the hang watch names its file in the same second the log starts.
+      if (name.rfind("hang-", 0) == 0 && (text || ucode) && ModifiedAt(it->path()) >= state.started - 1)
+        found.push_back(it->path());
+    }
+    std::sort(found.begin(), found.end());
+    for (const auto& path : found) add(path, false);
+  }
+  for (const auto& boot : boot_logs)
+    if (add(boot, true)) break;
+  return files;
+}
+// "BugReport-<game>-<YYYYMMDD-HHMMSS>-UTC.zip": letters, digits, '-' and '_' only, so any
+// FTP program, browser and GitHub take the name as it is.
+inline std::string ArchiveName(const State& state) {
+  std::string game;
+  for (const unsigned char c : state.game) {
+    if (game.size() >= 40) break;
+    const bool plain = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-';
+    if (plain) game += char(c);
+    else if (!game.empty() && game.back() != '_') game += '_';
+  }
+  while (!game.empty() && game.back() == '_') game.pop_back();
+  if (game.empty()) game = "Game";
+  std::tm utc{};
+  char stamp[32] = "00000000-000000";
+  if (log_zip::UtcTime(std::time_t(state.started), &utc))
+    std::snprintf(stamp, sizeof(stamp), "%04d%02d%02d-%02d%02d%02d", utc.tm_year + 1900, utc.tm_mon + 1, utc.tm_mday,
+                  utc.tm_hour, utc.tm_min, utc.tm_sec);
+  return "BugReport-" + game + "-" + stamp + "-UTC.zip";
+}
+inline bool IsArchive(const std::string& name) {
+  return name.rfind("BugReport-", 0) == 0 && name.size() > 14 && name.compare(name.size() - 4, 4, ".zip") == 0;
+}
+// An archive's time, "YYYYMMDD-HHMMSS-UTC.zip", for ordering (the name itself when it has none).
+inline std::string ArchiveStamp(const std::string& name) {
+  const size_t utc = name.rfind("-UTC.zip");
+  return utc == std::string::npos || utc < 15 ? name : name.substr(utc - 15);
+}
+// The newest archive in `folder` (by name: the time is in it), or an empty path.
+inline fs::path NewestArchive(const fs::path& folder) {
+  std::error_code error;
+  fs::path newest;
+  for (fs::directory_iterator it(folder, error), end; !error && it != end; it.increment(error)) {
+    const std::string name = it->path().filename().string();
+    if (IsArchive(name) && (newest.empty() || ArchiveStamp(name) > ArchiveStamp(newest.filename().string())))
+      newest = it->path();
+  }
+  return newest;
+}
+// The text that goes into the archive for one file.
+inline std::string Contents(const File& file) {
+  std::ifstream input(file.path, std::ios::binary);
+  if (!input) return {};
+  std::string data((std::istreambuf_iterator<char>(input)), std::istreambuf_iterator<char>());
+  if (file.tail && data.size() > kBootLogTail) {
+    data.erase(0, data.size() - kBootLogTail);
+    const size_t line = data.find('\n');  // From a whole line.
+    if (line != std::string::npos) data.erase(0, line + 1);
+    data = "[... the start of this file is left out ...]\n" + data;
+  }
+  return data;
+}
+// Writes the archive (as <name>.part, then renamed), then keeps the newest kArchivesKept.
+inline bool WriteArchive(const fs::path& archive, const std::vector<File>& files) {
+  const fs::path part = archive.string() + ".part";
+  bool ok = true;
+  {
+    std::ofstream output(part, std::ios::binary | std::ios::trunc);
+    if (!output) return false;
+    log_zip::Writer zip([&output](const std::string& piece) {
+      output.write(piece.data(), std::streamsize(piece.size()));
+      return bool(output);
+    });
+    std::vector<std::string> names;
+    for (const auto& file : files) {
+      const std::string name = file.path.filename().string();
+      if (std::find(names.begin(), names.end(), name) != names.end()) continue;
+      names.push_back(name);
+      ok = zip.Add(name, Contents(file), std::time_t(ModifiedAt(file.path))) && ok;
+    }
+    ok = zip.Finish() && ok;
+    output.flush();
+    ok = ok && bool(output);
+  }
+  std::error_code error;
+  if (ok) fs::rename(part, archive, error);
+  if (!ok || error) {
+    fs::remove(part, error);
+    return false;
+  }
+  std::vector<std::string> archives;
+  for (fs::directory_iterator it(archive.parent_path(), error), end; !error && it != end; it.increment(error)) {
+    const std::string name = it->path().filename().string();
+    if (IsArchive(name)) archives.push_back(name);
+    // A .part left by a start that ended while it wrote.
+    else if (name.rfind("BugReport-", 0) == 0 && name.size() > 9 &&
+             name.compare(name.size() - 9, 9, ".zip.part") == 0 && it->path() != part)
+      fs::remove(it->path(), error);
+  }
+  std::sort(archives.begin(), archives.end(), [](const std::string& a, const std::string& b) {
+    return ArchiveStamp(a) > ArchiveStamp(b);
+  });
+  for (size_t n = kArchivesKept; n < archives.size(); ++n) fs::remove(archive.parent_path() / archives[n], error);
+  return true;
+}
+// The settings page's direct link to the newest archive: "http://<console>:<port>/?k=<key>"
+// becomes "http://<console>:<port>/bug-report.zip?k=<key>". Empty when the page is off.
+inline std::string ZipLink(const std::string& address) {
+  const size_t at = address.find("/?k=");
+  return at == std::string::npos ? std::string() : address.substr(0, at) + "/bug-report.zip" + address.substr(at + 1);
+}
+// "512 KB", "3.4 MB": sizes as the settings page shows them.
+inline std::string SizeText(uintmax_t bytes) {
+  char text[32];
+  if (bytes >= (1u << 20)) std::snprintf(text, sizeof(text), "%.1f MB", double(bytes) / double(1u << 20));
+  else std::snprintf(text, sizeof(text), "%llu KB", (unsigned long long)((bytes + 1023) / 1024));
+  return text;
+}
+// The archive being made in the background while the launcher shows the report.
+struct Archive {
+  enum Status { working, done, failed };
+  std::atomic<int> status{working};
+  fs::path path;  // Set before the start; read once status is done.
+};
+// What the launcher's report screen shows (launcher.cpp, LauncherShowBugReport).
+struct Report {
+  std::string game;
+  std::vector<File> files;
+  fs::path folder;  // The logs folder, for the FTP line.
+  std::shared_ptr<Archive> archive;
+};
+}  // namespace xbox360ps5::bug_report
