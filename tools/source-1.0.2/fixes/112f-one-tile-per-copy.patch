+// Fix 112f: the drive a game's file is on: "ext1", "usb0" (the name under /mnt), "" for the
+// console's own storage (any other path).
+inline std::string DriveOf(const std::string& path) {
+  const std::string p = Slashes(path);
+  if (p.compare(0, 5, "/mnt/") != 0) return std::string();
+  const size_t end = p.find('/', 5);
+  return end == std::string::npos ? std::string() : p.substr(5, end - 5);
+}
+// Which copy of a game is shown: the console's storage first, then the extended storage (ext*),
+// then USB drives (usb*), then anything else under /mnt.
+inline int DriveRank(const std::string& path) {
+  const std::string drive = LowerAscii(DriveOf(path));
+  if (drive.empty()) return 0;
+  if (drive.compare(0, 3, "ext") == 0) return 1;
+  if (drive.compare(0, 3, "usb") == 0) return 2;
+  return 3;
+}
+// One library entry, as MergeCopies sees it. `copyable`: an image or a package of one disc with a
+// known title ID and size (an extracted game, a disc set or a disc in the drive never merges).
+struct CopyInfo {
+  std::string title_id;
+  uint64_t bytes = 0;
+  std::string path;
+  bool copyable = false;
+};
+// For each entry, the entry it is shown as: itself, or the copy of the same game (same title ID
+// and the same size, so the same image or package) on the better drive (DriveRank; of one rank the
+// first found). Entries that differ in title ID or size stay apart.
+inline std::vector<size_t> MergeCopies(const std::vector<CopyInfo>& entries) {
+  std::vector<size_t> into(entries.size());
+  std::map<std::pair<std::string, uint64_t>, size_t> best;
+  for (size_t n = 0; n < entries.size(); ++n) {
+    into[n] = n;
+    const auto& e = entries[n];
+    if (!e.copyable || e.title_id.empty() || e.title_id == "00000000" || !e.bytes) continue;
+    const auto key = std::make_pair(LowerAscii(e.title_id), e.bytes);
+    const auto at = best.find(key);
+    if (at == best.end()) best.emplace(key, n);
+    else if (DriveRank(e.path) < DriveRank(entries[at->second].path)) at->second = n;
+  }
+  for (size_t n = 0; n < entries.size(); ++n) {
+    const auto& e = entries[n];
+    if (!e.copyable || e.title_id.empty() || e.title_id == "00000000" || !e.bytes) continue;
+    into[n] = best.at(std::make_pair(LowerAscii(e.title_id), e.bytes));
+  }
+  return into;
+}
