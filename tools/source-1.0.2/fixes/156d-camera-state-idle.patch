--- /dev/null
+++ b/include/xbox360ps5/pscam_state.hpp
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: MIT
+// Fix 156d (Kinect Sports Season Two, 4D5309D6; issue 63): the virtual camera's GetState
+// (PsCamDeviceRequest code 0) says "streaming" only while the title is reading frames.
+//
+// The NUI library's camera start (82A642B8 in Season Two's default.xex, re-run by its camera
+// worker 82A65F00 whenever the NUI pauses the camera, as it does while a sport loads) asks
+// GetState and switches on it: Ready (4) configures the camera (code 27), asks for the depth
+// table and sets its streams up; Streaming (2) means "already running" and skips all that.
+// The virtual camera said Streaming from its first frame read until a Stop (code 2), which
+// Season Two never sends; so after the sport's load the library skipped its set-up, read no
+// more frames (the depth and color counts froze at the load, the last request a GetState) and
+// the loading screen never ended (#63 tennis on 1.0.5, darts on our console).
+//
+// Now: Streaming while frame reads are queued, or the last one was asked for within kIdleAfter
+// (a title reading at 30 fps keeps two or more queued and asks every 33 ms); Ready once the
+// title has stopped reading for longer; Absent without a camera. No Xenia headers here.
+#pragma once
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+
+namespace xbox360ps5::pscam_state {
+
+constexpr uint32_t kAbsent = 0, kStreaming = 2, kReady = 4;
+constexpr std::chrono::milliseconds kIdleAfter{1000};
+
+// `since_last_read`: the time since the title's last frame read request (any value when it
+// never asked for one: `ever_read` false).
+inline uint32_t CameraState(bool camera, bool ever_read, size_t queued_reads,
+                            std::chrono::steady_clock::duration since_last_read) {
+  if (!camera) return kAbsent;
+  if (!ever_read) return kReady;
+  if (queued_reads) return kStreaming;
+  return since_last_read <= kIdleAfter ? kStreaming : kReady;
+}
+
+}  // namespace xbox360ps5::pscam_state
