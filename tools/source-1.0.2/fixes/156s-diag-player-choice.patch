+// SPDX-License-Identifier: MIT
+// Fix 156s (Zumba Fitness 4D4A07F0, issue 63): a diagnostic of which body a title picks as its
+// player. Zumba stays at "Searching for player..." (1.0.6-work-fix156q2) with our body tracked
+// in every skeleton frame and already identified (enrollment 0): it never calls its identify,
+// so its search waits on something before that. Two candidates, both in vector code that
+// cannot be read statically:
+//  - its player choice (82333918, by mode at +0x40: closest, ...): the tracking IDs it keeps
+//    at +0x48/+0x4C of its skeleton consumer and hands to NuiSkeletonSetTrackedSkeletons
+//    (8250F6A8), which stores them, relative to a base, in the NUI library's globals only when
+//    the library is ready (+0x874), skeleton tracking is on (+0x1F10) and the system path flag
+//    (+0x84, set by an XMsg 2B002 answer we do not give) is clear;
+//  - its play area ("Single Player Forward Boundary", "Rear Boundary", "Boundary Size"):
+//    our body always stands 2.5 m from the sensor.
+// Logged each second (at most kChoiceLines lines): the consumer's mode and IDs (the skeleton
+// frame function's caller keeps the consumer in r31, and the consumer holds the frame at
+// +0x20), the library's flags and stored IDs, and our body's ID; once, the play area's words.
+#pragma once
+#include <cstdint>
+#include <vector>
+
+#include "xbox360ps5/nui_image_scan.hpp"
+
+namespace xbox360ps5::nui_choice {
+
+constexpr uint32_t kChoiceLines = 120;
+constexpr int64_t kChoiceIntervalMs = 1000;
+
+// NuiSkeletonSetTrackedSkeletons, by shape: `cmplwi crN,r3,0` near the start, the codes
+// 80070057, 83010002, 83010005 and 8301000B (ori 0x57, 2, 5, 0xB), the library's globals
+// loaded as `lis rA,hi; addi rB,rA,lo` and three `lwz ?,d(rB)` (ready, tracking enabled,
+// system path), and three large `ori` offsets (the ID base and the two stored IDs).
+struct SetTracked {
+  uint32_t function = 0, globals = 0;
+  uint32_t ready = 0, enabled = 0, system = 0;  // offsets of the three flags
+  uint32_t base = 0, id0 = 0, id1 = 0;          // offsets of the ID base and the stored IDs
+};
+inline std::vector<SetTracked> FindSetTrackedSkeletons(const motion::CodeView& view) {
+  std::vector<SetTracked> found;
+  if (!view.code || (view.base & 3)) return found;
+  constexpr uint32_t kSpan = 0x200;
+  for (uint32_t start = view.base; view.Has(start); start += 4) {
+    if (view.Word(start) != motion::kMflrR12) continue;
+    std::vector<uint32_t> words;
+    for (uint32_t at = start; at - start < kSpan && view.Has(at); at += 4) {
+      const uint32_t w = view.Word(at);
+      if (at != start && w == motion::kMflrR12) break;
+      words.push_back(w);
+    }
+    bool r3_check = false, c57 = false, c2 = false, c5 = false, cB = false;
+    std::vector<uint32_t> large;
+    for (size_t i = 0; i < words.size(); ++i) {
+      const uint32_t w = words[i], op = w >> 26, low = w & 0xFFFF;
+      if (i < 8 && op == 10 && ((w >> 16) & 31) == 3 && low == 0) r3_check = true;
+      if (op == 24) {
+        c57 |= low == 0x57;
+        c2 |= low == 2;
+        c5 |= low == 5;
+        cB |= low == 0xB;
+        if (low >= 0x8000) large.push_back(low);
+      }
+    }
+    if (!r3_check || !c57 || !c2 || !c5 || !cB || large.size() != 3) continue;
+    SetTracked s;
+    s.function = start;
+    int reg = -1;
+    for (size_t i = 0; i + 1 < words.size(); ++i) {
+      const uint32_t a = words[i], b = words[i + 1];
+      if (a >> 26 == 15 && ((a >> 16) & 31) == 0 && b >> 26 == 14 &&
+          ((b >> 16) & 31) == ((a >> 21) & 31)) {
+        s.globals = ((a & 0xFFFF) << 16) + uint32_t(int32_t(int16_t(b & 0xFFFF)));
+        reg = int((b >> 21) & 31);
+        break;
+      }
+    }
+    std::vector<uint32_t> flags;
+    for (uint32_t w : words)
+      if (reg >= 0 && w >> 26 == 32 && int((w >> 16) & 31) == reg) flags.push_back(w & 0xFFFF);
+    if (!s.globals || flags.size() != 3) continue;
+    s.ready = flags[0];
+    s.enabled = flags[1];
+    s.system = flags[2];
+    s.base = large[0];
+    s.id0 = large[1];
+    s.id1 = large[2];
+    found.push_back(s);
+  }
+  return found;
+}
+// A stored ID back to a tracking ID (the function stores id - base, and 0 for 0).
+inline uint32_t TrackingId(uint32_t stored, uint32_t base) { return stored ? stored + base : 0; }
+
+// Zumba Fitness's play area (research, this executable only): its options object is allocated
+// at 8227B6D0 and kept at 82BACD98 (8227B6F4 `lis r10,-0x7d45`, 8227B6FC `stw r3,-0x3268(r10)`);
+// the play-area options are registered at object + 0xAC (8227D078 `addi r3,r31,0xac`):
+// forward boundary +4, rear boundary +8, size +0xC (floats), 16 words logged.
+struct PlayArea {
+  bool ok = false;
+  uint32_t pointer = 0, offset = 0;
+};
+inline PlayArea FindZumbaPlayArea(const motion::CodeView& view) {
+  PlayArea area;
+  struct Expected {
+    uint32_t at, word;
+  };
+  static constexpr Expected kWords[] = {
+      {0x8227B6F4, 0x3D4082BB}, {0x8227B6FC, 0x906ACD98}, {0x8227D078, 0x387F00AC}};
+  for (const auto& e : kWords)
+    if (!view.Has(e.at) || view.Word(e.at) != e.word) return area;
+  area.ok = true;
+  area.pointer = 0x82BACD98;
+  area.offset = 0xAC;
+  return area;
+}
+
+// At most once per interval and kChoiceLines in all.
+struct RateLimit {
+  int64_t last_ms = -kChoiceIntervalMs;
+  uint32_t lines = 0;
+  bool Due(int64_t now_ms) {
+    if (lines >= kChoiceLines || now_ms - last_ms < kChoiceIntervalMs) return false;
+    last_ms = now_ms;
+    ++lines;
+    return true;
+  }
+};
+
+}  // namespace xbox360ps5::nui_choice
