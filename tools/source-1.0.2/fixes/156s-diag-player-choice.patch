+// Fix 156s (xbox360ps5/nui_choice.hpp): which body the title picks as its player, once a second
+// (120 lines at most), read from guest memory only; and Zumba's play area once.
+xbox360ps5::nui_choice::SetTracked g_choice{};    // set at binding, before any frame
+xbox360ps5::nui_choice::PlayArea g_play_area{};  // set at binding, before any frame
+std::atomic<bool> g_play_area_logged{false};
+std::mutex g_choice_mutex;
+xbox360ps5::nui_choice::RateLimit g_choice_limit;
+
+void LogPlayerChoice(cpu::ppc::PPCContext* ppc_context, KernelState* kernel_state,
+                     uint32_t frame) {
+  namespace nc = xbox360ps5::nui_choice;
+  const int64_t now_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                             std::chrono::steady_clock::now().time_since_epoch())
+                             .count();
+  {
+    std::lock_guard lock(g_choice_mutex);
+    if (!g_choice_limit.Due(now_ms)) return;
+  }
+  Memory* memory = kernel_state->memory();
+  auto word = [memory](uint32_t address, uint32_t* value) {
+    if (!address || (address & 3) || !IsGuestRangeMapped(memory, address, 4, false)) return false;
+    *value = xe::load_and_swap<uint32_t>(memory->TranslateVirtual(address));
+    return true;
+  };
+  // Zumba's play area, once its options object exists.
+  uint32_t object = 0;
+  if (g_play_area.ok && !g_play_area_logged.load() && word(g_play_area.pointer, &object) &&
+      object) {
+    uint32_t w[16] = {};
+    bool all = true;
+    for (uint32_t i = 0; i < 16; ++i) all &= word(object + g_play_area.offset + 4 * i, &w[i]);
+    if (all && !g_play_area_logged.exchange(true))
+      XELOGW("Virtual Kinect: the title's play area at {:08X}: forward boundary {:.2f} m, rear "
+             "boundary {:.2f} m, size {:.2f} m; words {:08X} {:08X} {:08X} {:08X} {:08X} {:08X} "
+             "{:08X} {:08X} {:08X} {:08X} {:08X} {:08X} {:08X} {:08X} {:08X} {:08X} (fix 156s)",
+             object + g_play_area.offset, std::bit_cast<float>(w[1]),
+             std::bit_cast<float>(w[2]), std::bit_cast<float>(w[3]), w[0], w[1], w[2], w[3],
+             w[4], w[5], w[6], w[7], w[8], w[9], w[10], w[11], w[12], w[13], w[14], w[15]);
+  }
+  // The caller's consumer: r31 holds it when it keeps the frame at +0x20 (Zumba 82333678).
+  const uint32_t consumer = uint32_t(ppc_context->r[31]);
+  uint32_t held = 0, mode = 0, pick0 = 0, pick1 = 0;
+  const bool has_consumer = word(consumer + 0x20, &held) && held == frame &&
+                            word(consumer + 0x40, &mode) && word(consumer + 0x48, &pick0) &&
+                            word(consumer + 0x4C, &pick1);
+  // The NUI library's own record of the choice (NuiSkeletonSetTrackedSkeletons).
+  uint32_t ready = 0, enabled = 0, system = 0, base = 0, id0 = 0, id1 = 0;
+  const bool has_library = g_choice.function && word(g_choice.globals + g_choice.ready, &ready) &&
+                           word(g_choice.globals + g_choice.enabled, &enabled) &&
+                           word(g_choice.globals + g_choice.system, &system) &&
+                           word(g_choice.globals + g_choice.base, &base) &&
+                           word(g_choice.globals + g_choice.id0, &id0) &&
+                           word(g_choice.globals + g_choice.id1, &id1);
+  uint32_t body = 0;
+  {
+    std::lock_guard lock(xbox360ps5::motion::nui_mutex);
+    body = xbox360ps5::motion::nui_binding.tracking_id;
+  }
+  XELOGW("Virtual Kinect: player choice: the title {} (mode {}, IDs {:08X} {:08X}); the "
+         "library {} (ready {}, tracking {}, system path {}, tracked {:08X} {:08X}); our body "
+         "{:08X} (fix 156s)",
+         has_consumer ? "picks" : "(no consumer in r31)", mode, pick0, pick1,
+         has_library ? "keeps" : "(not found)", ready, enabled, system,
+         nc::TrackingId(id0, base), nc::TrackingId(id1, base), body);
+}
