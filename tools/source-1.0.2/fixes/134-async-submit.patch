+// ms/s, worker queue submit y ms/s; drains per frame: swap a, readback b, wait c, sync d, other e
+// (waiting z ms/s); waited for room f/s".
+inline std::atomic<uint64_t> async_handoffs{0}, async_chunks{0}, async_room_waits{0}, async_worker_replay_ns{0},
+    async_worker_submit_ns{0}, async_drain_ns{0};
