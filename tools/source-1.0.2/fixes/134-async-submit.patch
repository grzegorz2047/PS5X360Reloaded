+// Fix 134: the submission goes to the worker. Its fence is acquired here and the timeline told
+// it is pending, so GetCurrentSubmission moves on as after a submit; a wait for it drains the
+// worker first (AwaitSubmissionDrained).
+bool VulkanCommandProcessor::HandOffSubmission() {
+  if (!async_worker_) {
+    async_worker_ = std::make_unique<async_submit::Worker<AsyncSubmitJob>>();
+    for (int n = 0; n < 3; ++n) {
+      async_command_buffers_.push_back(std::make_unique<DeferredCommandBuffer>(*this));
+      async_free_command_buffers_.push_back(async_command_buffers_.back().get());
+    }
+    async_worker_thread_ = kernel::object_ref<kernel::XHostThread>(new kernel::XHostThread(
+        kernel_state_, 128 * 1024, 0,
+        [this]() {
+          async_worker_->Loop([this](AsyncSubmitJob& job) { RunAsyncSubmitJob(job); });
+          return 0;
+        },
+        kernel_state_->GetIdleProcess()));
+    async_worker_thread_->set_name("GPU Submit worker");
+    async_worker_thread_->Create();
+    XELOGW("Async submit (fix 134): the submit worker thread started");
+  }
+  assert_false(command_buffers_writable_.empty());
+  CommandBuffer command_buffer = command_buffers_writable_.back();
+  VkResult fence_result = VK_SUCCESS;
+  auto fence_acquisition = completion_timeline_.AcquireFenceForSubmission(&fence_result);
+  if (!fence_acquisition) {
+    XELOGE("Failed to acquire a Vulkan fence for a submission handed to the worker: {}",
+           vk::to_string(vk::Result(fence_result)));
+    return false;
+  }
+  AsyncSubmitJob job;
+  job.command_buffer = command_buffer;
+  job.submission = GetCurrentSubmission();
+  job.fence = fence_acquisition->GetFenceForSubmitting();
+  if (frame_cost_query_pool_ != VK_NULL_HANDLE) {
+    // Fix 49's timestamps, written by the worker around the replay.
+    FrameCostReadCompleted();
+    const uint32_t slot = uint32_t(job.submission % kFrameCostSlots);
+    frame_cost_slot_submission_[slot] = job.submission;
+    job.query_pool = frame_cost_query_pool_;
+    job.query_first = 2 * slot;
+  }
+  {
+    std::lock_guard<std::mutex> lock(async_free_mutex_);
+    assert_false(async_free_command_buffers_.empty());
+    job.commands = async_free_command_buffers_.back();
+    async_free_command_buffers_.pop_back();
+  }
+  job.commands->SwapContents(deferred_command_buffer_);
+  // The timeline now has this submission pending with its fence.
+  fence_acquisition.reset();
+  xbox360ps5::hang_watch::Submitted(job.submission, GetCompletedSubmission());  // fix 47
+  command_buffers_submitted_.emplace_back(job.submission, command_buffer);
+  command_buffers_writable_.pop_back();
+  xbox360ps5::frame_cost::async_handoffs.fetch_add(1, std::memory_order_relaxed);
+  if (async_worker_->Enqueue(std::move(job))) {
+    xbox360ps5::frame_cost::async_room_waits.fetch_add(1, std::memory_order_relaxed);
+  }
+  return true;
+}
