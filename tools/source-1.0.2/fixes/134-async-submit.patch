+                  d[0] / s, d[1] / f, d[3] / 1e6 / s, d[4] / 1e6 / s, d[6] / f, d[7] / f, d[8] / f, d[9] / f,
+                  d[10] / f, d[5] / 1e6 / s, d[2] / s);
+    return text;
+  }
