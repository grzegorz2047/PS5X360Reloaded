+// SPDX-License-Identifier: MIT
+// Xbox360PS5, fix 134 (F2): the GPU command thread hands chunks of a frame to a submit worker.
+//
+// Fix 130 measured replaying the deferred command buffer into the Vulkan one on the GPU thread:
+// Grand Theft Auto IV 145-147 ms/s and Red Dead Redemption 92-140 ms/s, both with the GPU thread
+// saturated (986-990 ms/s) and about one submission a frame. That one is the swap's, which must
+// be submitted before the presenter gets the image back, so a worker alone could never run in
+// parallel. Here, once the recorded stream passes the chunk size, the submission ends at the next
+// draw and, in mode 1, a worker thread replays and submits it while the GPU thread records the
+// rest of the frame; the swap's submission and every wait for the GPU first drain the worker, so
+// the queue sees the submissions in their order and nothing waits for one not yet submitted.
+//
+// Modes (gpu_async_submit, or "mode" in async-submit.txt): 0 off, exactly as before; 1 chunks
+// handed to the worker; 2 chunks submitted on the GPU thread (what the extra submissions and
+// render pass breaks cost without the worker). The chunk size: gpu_async_submit_chunk_kib, or
+// "chunk" in the file, in KiB.
+#ifndef XENIA_GPU_VULKAN_ASYNC_SUBMIT_H_
+#define XENIA_GPU_VULKAN_ASYNC_SUBMIT_H_
+
+#include <condition_variable>
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <functional>
+#include <mutex>
+#include <sstream>
+#include <string>
+
+namespace xe {
+namespace gpu {
+namespace async_submit {
+
+enum Mode : uint32_t { kOff = 0, kWorker = 1, kChunkOnly = 2, kModes };
+
+struct Settings {
+  uint32_t mode = kOff;
+  uint32_t chunk_kib = 256;
+  bool operator==(const Settings& other) const { return mode == other.mode && chunk_kib == other.chunk_kib; }
+};
+
+// async-submit.txt: "mode 0|1|2" and "chunk <KiB>" lines, "#" comments. What a line does not set
+// keeps `base`'s value (the cvars). Returns the lines not understood.
+inline int Parse(const std::string& text, Settings& settings) {
+  int not_understood = 0;
+  std::istringstream lines(text);
+  std::string line;
+  while (std::getline(lines, line)) {
+    const size_t hash = line.find('#');
+    if (hash != std::string::npos) line.resize(hash);
+    std::istringstream words(line);
+    std::string key, extra;
+    long long value = -1;
+    if (!(words >> key)) continue;
+    if (!(words >> value) || (words >> extra)) {
+      ++not_understood;
+    } else if (key == "mode" && value >= 0 && value < kModes) {
+      settings.mode = uint32_t(value);
+    } else if (key == "chunk" && value >= 16 && value <= 65536) {
+      settings.chunk_kib = uint32_t(value);
+    } else {
+      ++not_understood;
+    }
+  }
+  return not_understood;
+}
+
+// At the start of a draw: whether the submission ends here, as a chunk.
+inline bool ChunkDue(uint32_t mode, size_t stream_bytes, uint32_t chunk_kib) {
+  return mode != kOff && chunk_kib && stream_bytes >= size_t(chunk_kib) * 1024;
+}
+
+// At the end of a submission: whether the worker gets it. Never the swap's (the presenter
+// submits after it), nor one with wait semaphores (sparse binds) or query resolves to record.
+inline bool HandOff(uint32_t mode, bool is_swap, bool wait_semaphores, bool query_resolves) {
+  return mode == kWorker && !is_swap && !wait_semaphores && !query_resolves;
+}
+
+enum DrainReason : uint32_t { kDrainSwap = 0, kDrainReadback, kDrainWait, kDrainSync, kDrainOther, kDrainReasons };
+inline const char* DrainReasonName(uint32_t reason) {
+  static const char* const names[] = {"swap", "readback", "wait", "sync", "other"};
+  return reason < kDrainReasons ? names[reason] : "?";
+}
+
+// The jobs, run one at a time in order by Loop on the worker thread. At most kMaxPending are
+// queued or running: Enqueue waits for room.
+template <class Job>
+class Worker {
+ public:
+  static constexpr size_t kMaxPending = 2;
+  // Returns whether it had to wait for room.
+  bool Enqueue(Job&& job) {
+    std::unique_lock<std::mutex> lock(mutex_);
+    const bool waited = queue_.size() + (running_ ? 1 : 0) >= kMaxPending;
+    room_.wait(lock, [&] { return queue_.size() + (running_ ? 1 : 0) < kMaxPending; });
+    queue_.push_back(std::move(job));
+    ++enqueued_;
+    work_.notify_one();
+    return waited;
+  }
+  // Returns whether there was anything to wait for.
+  bool Drain() {
+    std::unique_lock<std::mutex> lock(mutex_);
+    if (queue_.empty() && !running_) return false;
+    idle_.wait(lock, [&] { return queue_.empty() && !running_; });
+    return true;
+  }
+  bool Busy() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return !queue_.empty() || running_;
+  }
+  // The worker thread's body: runs the jobs until Stop, after the queue is empty.
+  void Loop(const std::function<void(Job&)>& run) {
+    std::unique_lock<std::mutex> lock(mutex_);
+    for (;;) {
+      work_.wait(lock, [&] { return stop_ || !queue_.empty(); });
+      if (queue_.empty()) break;  // stopping
+      Job job = std::move(queue_.front());
+      queue_.pop_front();
+      running_ = true;
+      lock.unlock();
+      run(job);
+      lock.lock();
+      running_ = false;
+      ++done_;
+      room_.notify_all();
+      if (queue_.empty()) idle_.notify_all();
+    }
+    idle_.notify_all();
+  }
+  void Stop() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    stop_ = true;
+    work_.notify_all();
+  }
+  uint64_t enqueued() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return enqueued_;
+  }
+  uint64_t done() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return done_;
+  }
+
+ private:
+  mutable std::mutex mutex_;
+  std::condition_variable work_, room_, idle_;
+  std::deque<Job> queue_;
+  bool running_ = false, stop_ = false;
+  uint64_t enqueued_ = 0, done_ = 0;
+};
+
+}  // namespace async_submit
+}  // namespace gpu
+}  // namespace xe
+
+#endif  // XENIA_GPU_VULKAN_ASYNC_SUBMIT_H_
