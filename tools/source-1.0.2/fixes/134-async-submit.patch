+// Fix 134 (async_submit.h): the settings, from async-submit.txt in the title folder when it exists
+// (read again when it changes, at most once a second), else the cvars.
+void VulkanCommandProcessor::RefreshAsyncSubmitSettings() {
+  static auto checked = std::chrono::steady_clock::time_point();
+  const auto now = std::chrono::steady_clock::now();
+  if (async_settings_logged_ && now - checked < std::chrono::seconds(1)) {
+    return;
+  }
+  checked = now;
+  async_submit::Settings next;
+  next.mode = std::min<uint32_t>(cvars::gpu_async_submit, async_submit::kModes - 1);
+  next.chunk_kib = std::max<uint32_t>(cvars::gpu_async_submit_chunk_kib, 16);
+  const char* const path = XBOX360PS5_DATA_ROOT "/async-submit.txt";
+  int not_understood = 0;
+  bool from_file = false;
+  if (FILE* file = std::fopen(path, "rb")) {
+    std::string text;
+    char chunk[1024];
+    size_t got;
+    while ((got = std::fread(chunk, 1, sizeof(chunk), file)) > 0) text.append(chunk, got);
+    std::fclose(file);
+    not_understood = async_submit::Parse(text, next);
+    from_file = true;
+  }
+  if (async_settings_logged_ && next == async_settings_) {
+    return;
+  }
+  if (async_settings_.mode == async_submit::kWorker && next.mode != async_submit::kWorker) {
+    DrainAsyncSubmit(async_submit::kDrainOther);
+  }
+  async_settings_ = next;
+  async_settings_logged_ = true;
+  xbox360ps5::frame_cost::async_mode_now.store(next.mode, std::memory_order_relaxed);
+  xbox360ps5::frame_cost::async_chunk_kib_now.store(next.chunk_kib, std::memory_order_relaxed);
+  XELOGW("Async submit (fix 134): mode {} ({}), chunk {} KiB, from {}{}", next.mode,
+         next.mode == async_submit::kWorker      ? "chunks to the submit worker"
+         : next.mode == async_submit::kChunkOnly ? "chunks submitted on the GPU thread"
+                                                 : "off",
+         next.chunk_kib, from_file ? path : "the settings",
+         not_understood ? fmt::format(", {} lines not understood", not_understood) : std::string());
+}
