+ public:
+  std::string Line(double seconds, uint64_t frames) {
+    const double s = seconds > 0 ? seconds : 1;
+    const double f = frames ? double(frames) : 1.0;
+    const std::atomic<uint64_t>* const counters[11] = {
+        &async_handoffs, &async_chunks, &async_room_waits, &async_worker_replay_ns, &async_worker_submit_ns,
+        &async_drain_ns, &async_drains[0], &async_drains[1], &async_drains[2], &async_drains[3], &async_drains[4]};
+    double d[11];
+    for (int n = 0; n < 11; ++n) {
+      const uint64_t now = counters[n]->load(std::memory_order_relaxed);
+      d[n] = double(now - last_[n]);
+      last_[n] = now;
+    }
