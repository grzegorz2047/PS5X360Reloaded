+// Fix 134: on the worker thread, one job: what EndSubmission does from the pool reset to the
+// queue submit, with the job's commands and fence.
+void VulkanCommandProcessor::RunAsyncSubmitJob(AsyncSubmitJob& job) {
+  ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  const auto start = std::chrono::steady_clock::now();
+  bool ok = dfn.vkResetCommandPool(device, job.command_buffer.pool, 0) == VK_SUCCESS;
+  if (ok) {
+    VkCommandBufferBeginInfo begin_info = {VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+    begin_info.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+    ok = dfn.vkBeginCommandBuffer(job.command_buffer.buffer, &begin_info) == VK_SUCCESS;
+  }
+  if (ok && job.query_pool != VK_NULL_HANDLE) {
+    dfn.vkCmdResetQueryPool(job.command_buffer.buffer, job.query_pool, job.query_first, 2);
+    dfn.vkCmdWriteTimestamp(job.command_buffer.buffer, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                            job.query_pool, job.query_first);
+  }
+  if (ok) {
+    job.commands->Execute(job.command_buffer.buffer);
+    if (job.query_pool != VK_NULL_HANDLE) {
+      dfn.vkCmdWriteTimestamp(job.command_buffer.buffer, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
+                              job.query_pool, job.query_first + 1);
+    }
+    ok = dfn.vkEndCommandBuffer(job.command_buffer.buffer) == VK_SUCCESS;
+  }
+  const auto replayed = std::chrono::steady_clock::now();
+  if (ok) {
+    VkSubmitInfo submit_info = {VK_STRUCTURE_TYPE_SUBMIT_INFO};
+    submit_info.commandBufferCount = 1;
+    submit_info.pCommandBuffers = &job.command_buffer.buffer;
+    ui::vulkan::VulkanDevice::Queue::Acquisition queue_acquisition =
+        vulkan_device->AcquireQueue(vulkan_device->queue_family_graphics_compute(), 0);
+    ok = dfn.vkQueueSubmit(queue_acquisition.queue(), 1, &submit_info, job.fence) == VK_SUCCESS;
+  }
+  if (!ok) {
+    async_submit_failed_.store(true, std::memory_order_release);
+  }
+  const auto submitted = std::chrono::steady_clock::now();
+  xbox360ps5::frame_cost::async_worker_replay_ns.fetch_add(
+      uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(replayed - start).count()),
+      std::memory_order_relaxed);
+  xbox360ps5::frame_cost::async_worker_submit_ns.fetch_add(
+      uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(submitted - replayed).count()),
+      std::memory_order_relaxed);
+  job.commands->Reset();
+  std::lock_guard<std::mutex> lock(async_free_mutex_);
+  async_free_command_buffers_.push_back(job.commands);
+}
+
+// Fix 134: waits until the worker has submitted everything handed to it.
+void VulkanCommandProcessor::DrainAsyncSubmit(uint32_t reason) {
+  if (!async_worker_) {
+    return;
+  }
+  const auto start = std::chrono::steady_clock::now();
+  if (async_worker_->Drain()) {
+    xbox360ps5::frame_cost::async_drains[std::min<uint32_t>(reason, 4)].fetch_add(
+        1, std::memory_order_relaxed);
+    xbox360ps5::frame_cost::async_drain_ns.fetch_add(
+        uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                     std::chrono::steady_clock::now() - start)
+                     .count()),
+        std::memory_order_relaxed);
+  }
+  if (async_submit_failed_.exchange(false, std::memory_order_acq_rel) && !device_lost_) {
+    XELOGE("Async submit (fix 134): the worker failed to submit a command buffer");
+    device_lost_ = true;
+    graphics_system_->OnHostGpuLossFromAnyThread(true);
+  }
+}
+
+// Fix 134: a wait for a submission, after the worker has submitted it.
+bool VulkanCommandProcessor::AwaitSubmissionDrained(uint64_t submission) {
+  const uint32_t cause = xbox360ps5::frame_cost::cause;
+  DrainAsyncSubmit(cause == xbox360ps5::frame_cost::kMemexport ||
+                           cause == xbox360ps5::frame_cost::kResolve
+                       ? async_submit::kDrainReadback
+                       : async_submit::kDrainWait);
+  if (device_lost_) {
+    return false;
+  }
+  return completion_timeline_.AwaitSubmissionAndUpdateCompleted(submission);
+}
+
+void VulkanCommandProcessor::StopAsyncSubmit() {
+  if (!async_worker_) {
+    return;
+  }
+  DrainAsyncSubmit(async_submit::kDrainOther);
+  async_worker_->Stop();
+  async_worker_thread_->Wait(0, 0, 0, nullptr);
+  async_worker_thread_.reset();
+  async_worker_.reset();
+  async_free_command_buffers_.clear();
+  async_command_buffers_.clear();
+}
