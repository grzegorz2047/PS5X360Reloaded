+#if XE_PLATFORM_PS5
+  // Fix 105: a fetch constant written with the bits it has changes nothing
+  // the texture cache or the fetch constant buffer hold (a binding is derived
+  // from the fetch constant's bits alone; a texture outdated, destroyed or a
+  // new frame resets the bindings itself), so it is skipped as a float
+  // constant is (xenia/gpu/register_run.h, the same for runs).
+  if (cvars::vulkan_skip_redundant_constants &&
+      index >= XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 &&
+      index <= XE_GPU_REG_SHADER_CONSTANT_FETCH_31_5 &&
+      register_file_->values[index] == value) {
+    return;
+  }
+#endif
   // Only plain shader constants are eligible. Fetch writes may notify the
   // texture cache even when their bits match; scratch, coherence and gamma
   // registers also have write side effects and must always reach the base.
