diff --git a/include/xbox360ps5/suspend_trace.hpp b/include/xbox360ps5/suspend_trace.hpp
new file mode 100644
--- /dev/null
+++ b/include/xbox360ps5/suspend_trace.hpp
@@ -0,0 +1,127 @@
+// SPDX-License-Identifier: MIT
+// Fix 69 (tools/source-1.0.2/fixes/69-suspend-trace.patch): a diagnostic for lost wake-ups of
+// threads that suspend themselves. Ninja Gaiden II on 1.0.4_candidate_26 went black after 203 s:
+// two job threads (F8000164, F8000194) were suspended by their own NtSuspendThread, and the main
+// thread spun on a flag only they clear. A resume that reaches a thread before it has suspended
+// itself finds a count of 0 and does nothing (as on the console); the thread then suspends with
+// no one left to wake it.
+//  - Each guest thread keeps its last kEvents suspension changes (Ring): who suspended or resumed
+//    it, the count before, when. The STALL report prints them for every suspended thread.
+//  - A resume that finds a count of 0 is counted (early_resumes), the first kRawLines written at
+//    once with the resumer, the target and whether the target was entering its own suspension
+//    then; afterwards one line every 30 s while more come.
+#pragma once
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+namespace xbox360ps5::suspend_trace {
+
+enum Kind : uint8_t {
+  kNone = 0,
+  kSuspendedItself,  // NtSuspendThread on itself, count before
+  kWokeItself,       // its own suspension ended
+  kSuspendedBy,      // by another thread
+  kResumedBy,        // by another thread, count before (>0)
+  kResumeFoundRunning,  // a resume found count 0: nothing happened
+};
+inline const char* KindName(uint8_t kind) {
+  switch (kind) {
+    case kSuspendedItself: return "suspended itself";
+    case kWokeItself: return "woke";
+    case kSuspendedBy: return "suspended by";
+    case kResumedBy: return "resumed by";
+    case kResumeFoundRunning: return "EARLY resume (count 0) by";
+    default: return "?";
+  }
+}
+inline uint64_t NowMs() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                      std::chrono::steady_clock::now().time_since_epoch())
+                      .count());
+}
+
+struct Event {
+  uint64_t ms = 0;
+  uint32_t other = 0;  // the other thread's handle (0: the thread itself or a host thread)
+  uint8_t kind = kNone;
+  uint8_t previous = 0;  // the suspend count before
+};
+
+// Written by the thread itself and by those that suspend or resume it (a slot each, by an
+// atomic index); read by the STALL report. A torn event only garbles one diagnostic line.
+class Ring {
+ public:
+  static constexpr size_t kEvents = 16;
+  void Note(uint8_t kind, uint32_t other, uint8_t previous, uint64_t ms) {
+    const uint64_t n = next_.fetch_add(1, std::memory_order_relaxed);
+    Event& e = events_[n % kEvents];
+    e.ms = ms;
+    e.other = other;
+    e.kind = kind;
+    e.previous = previous;
+  }
+  uint64_t count() const { return next_.load(std::memory_order_relaxed); }
+  // "-76012 ms resumed by F8000008 (1->0); -76010 ms suspended itself (0->1); ..." newest first.
+  std::string Line(uint64_t now_ms) const {
+    const uint64_t n = next_.load(std::memory_order_relaxed);
+    const uint64_t shown = n < kEvents ? n : kEvents;
+    std::string out;
+    for (uint64_t k = 0; k < shown; ++k) {
+      const Event& e = events_[(n - 1 - k) % kEvents];
+      char item[96];
+      const int after = e.kind == kSuspendedItself || e.kind == kSuspendedBy ? e.previous + 1
+                        : e.kind == kResumedBy                              ? e.previous - 1
+                                                                            : e.previous;
+      const long long ago = now_ms >= e.ms ? (long long)(now_ms - e.ms) : 0;
+      if (e.kind == kWokeItself)
+        std::snprintf(item, sizeof(item), "%s-%lld ms woke", k ? "; " : "", ago);
+      else if (e.other)
+        std::snprintf(item, sizeof(item), "%s-%lld ms %s %08X (%u->%d)", k ? "; " : "", ago, KindName(e.kind),
+                      e.other, unsigned(e.previous), after);
+      else
+        std::snprintf(item, sizeof(item), "%s-%lld ms %s (%u->%d)", k ? "; " : "", ago, KindName(e.kind),
+                      unsigned(e.previous), after);
+      out += item;
+    }
+    return out.empty() ? std::string("none") : out;
+  }
+
+ private:
+  std::array<Event, kEvents> events_{};
+  std::atomic<uint64_t> next_{0};
+};
+
+// Resumes that found a count of 0.
+inline constexpr uint64_t kRawLines = 20;
+inline std::atomic<uint64_t> early_resumes{0};
+inline std::atomic<uint64_t> early_reported{0}, early_reported_ms{0};
+// The line to write for this early resume ("" for none): the first kRawLines each, then at most
+// one every 30 s with the count since the last.
+inline std::string EarlyResumeLine(uint32_t resumer, uint32_t target, bool entering, uint64_t now_ms) {
+  const uint64_t n = early_resumes.fetch_add(1, std::memory_order_relaxed) + 1;
+  char text[200];
+  if (n <= kRawLines) {
+    std::snprintf(text, sizeof(text),
+                  "Suspend: EARLY resume #%llu: %08X resumed %08X while its suspend count was 0 (%s); "
+                  "the resume did nothing",
+                  (unsigned long long)n, resumer, target,
+                  entering ? "it was entering its own suspension" : "it was running");
+    early_reported.store(n, std::memory_order_relaxed);
+    early_reported_ms.store(now_ms, std::memory_order_relaxed);
+    return text;
+  }
+  uint64_t last_ms = early_reported_ms.load(std::memory_order_relaxed);
+  if (now_ms - last_ms < 30000 ||
+      !early_reported_ms.compare_exchange_strong(last_ms, now_ms, std::memory_order_relaxed))
+    return std::string();
+  const uint64_t before = early_reported.exchange(n, std::memory_order_relaxed);
+  std::snprintf(text, sizeof(text), "Suspend: %llu more early resumes (count 0) in %.0f s, %llu in all",
+                (unsigned long long)(n - before), double(now_ms - last_ms) / 1000.0, (unsigned long long)n);
+  return text;
+}
+
+}  // namespace xbox360ps5::suspend_trace
