   // Reentry mechanism for fiber-based stack switching.
   // On Linux, C++ exceptions are used instead of setjmp/longjmp so that
diff --git a/.deps/xenia-canary/src/xenia/kernel/xthread.cc b/.deps/xenia-canary/src/xenia/kernel/xthread.cc
--- a/.deps/xenia-canary/src/xenia/kernel/xthread.cc
+++ b/.deps/xenia-canary/src/xenia/kernel/xthread.cc
@@ -1084,6 +1084,19 @@ X_STATUS XThread::Resume(uint32_t* out_suspend_count) {
     if (out_suspend_count) {
       *out_suspend_count = previous;
     }
+    {  // Fix 69: who resumed it; a resume that finds no suspension is a lost wake-up candidate.
+      XThread* caller = XThread::GetCurrentThread();
+      const uint32_t resumer = caller ? caller->handle() : 0;
+      const uint64_t now = xbox360ps5::suspend_trace::NowMs();
+      if (previous == 0) {
+        suspend_trace_.Note(xbox360ps5::suspend_trace::kResumeFoundRunning, resumer, 0, now);
+        const std::string line = xbox360ps5::suspend_trace::EarlyResumeLine(
+            resumer, handle(), entering_self_suspend_.load(std::memory_order_relaxed), now);
+        if (!line.empty()) XELOGW("{}", line);
+      } else {
+        suspend_trace_.Note(xbox360ps5::suspend_trace::kResumedBy, resumer, previous, now);
+      }
+    }
     // The host count increases on every remote Suspend, including nested
     // suspensions. Balance each decrement, rather than only the final one.
     if (previous > 0) thread_->Resume(&unused_host_suspend_count);
@@ -1146,6 +1159,11 @@ X_STATUS XThread::Suspend(uint32_t* out_suspend_count) {
   if (out_suspend_count) {
     *out_suspend_count = previous_suspend_count;
   }
+  {  // Fix 69: suspended by another thread.
+    XThread* caller = XThread::GetCurrentThread();
+    suspend_trace_.Note(xbox360ps5::suspend_trace::kSuspendedBy, caller ? caller->handle() : 0,
+                        previous_suspend_count, xbox360ps5::suspend_trace::NowMs());
+  }
   // If we are suspending ourselves, we can't hold the lock.
   uint32_t unused_host_suspend_count = 0;
 
@@ -1185,12 +1203,17 @@ uint32_t XThread::SelfSuspend() {
   xe::threading::Thread::DeferSuspension(true);
   auto& suspend_count =
       *reinterpret_cast<std::atomic_uint8_t*>(&guest_thread->suspend_count);
+  entering_self_suspend_.store(true, std::memory_order_relaxed);  // fix 69
   const uint32_t previous = suspend_count.fetch_add(1);
+  entering_self_suspend_.store(false, std::memory_order_relaxed);
+  suspend_trace_.Note(xbox360ps5::suspend_trace::kSuspendedItself, 0, uint8_t(previous),
+                      xbox360ps5::suspend_trace::NowMs());
   {
     std::unique_lock<std::mutex> lock(suspend_mutex_);
     suspend_cv_.wait(lock,
                      [&suspend_count]() { return suspend_count.load() == 0; });
   }
+  suspend_trace_.Note(xbox360ps5::suspend_trace::kWokeItself, 0, 0, xbox360ps5::suspend_trace::NowMs());
   xe::threading::Thread::DeferSuspension(false);
   return previous;
 }
