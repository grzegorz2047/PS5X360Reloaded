@@ -45,6 +45,21 @@ inline bool CacheInMemory(const std::string& title_id, const std::string& text)
   return false;
 }
 
+#define XBOX360PS5_CACHE_IN_MEMORY_BY_SCALE 1  // fix 150f (the host check looks for it)
+// Fix 150f: at resolution scale 2x the game's render targets need the direct memory (Kinect
+// Sports at 2x on 1.0.6_candidate_6: 4258 MiB of them; the cache refused 5537 writes at direct
+// free 938 MiB and a 4xMSAA target could not be made, so 4xMSAA went to 1x and the replays came
+// out dark): the titles' preset keeps the cache on the drive then. "ram" still keeps it in memory.
+inline bool ForcedInMemory(const std::string& text) { return text.find("ram") != std::string::npos; }
+inline bool CacheInMemory(const std::string& title_id, const std::string& text, uint32_t draw_scale) {
+  if (!CacheInMemory(title_id, text)) return false;
+  return draw_scale <= 1 || ForcedInMemory(text);
+}
+// For the log: in memory by the title, but on the drive for the scale.
+inline bool KeptOnDriveForScale(const std::string& title_id, const std::string& text, uint32_t draw_scale) {
+  return CacheInMemory(title_id, text) && !CacheInMemory(title_id, text, draw_scale);
+}
