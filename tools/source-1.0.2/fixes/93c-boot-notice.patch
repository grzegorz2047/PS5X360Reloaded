+// Fix 93c: the notice across the restart. The system shows black from LoadExec until the new
+// process draws (console: "Returning to the menu...", black, then the menu). What was shown is
+// written before LoadExec ("kind=<n>\nat=<ms since 1970>\n", leaving-notice.txt in the title's
+// storage) and the new process shows it again from its first frame with a presenter until the
+// launcher's first frame (or a game's start). Its time also says how long the restart took.
+inline int64_t NowMs() {
+  return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::system_clock::now().time_since_epoch())
+      .count();
+}
+inline bool Remember(const std::filesystem::path& file, Kind kind, int64_t now_ms) {
+  if (kind == Kind::none) return false;
+  std::ofstream output(file, std::ios::binary | std::ios::trunc);
+  output << "kind=" << int(kind) << "\nat=" << now_ms << "\n";
+  output.flush();
+  return bool(output);
+}
+struct Remembered {
+  Kind kind = Kind::none;
+  int64_t at_ms = 0;
+};
+// Reads and removes the file. Something written more than two minutes ago (a restart that did not
+// come, then a start much later), in the future, or not a kind gives none.
+inline Remembered Take(const std::filesystem::path& file, int64_t now_ms) {
+  Remembered found;
+  std::ifstream input(file, std::ios::binary);
+  if (!input) return found;
+  int kind = 0;
+  long long at = 0;
+  for (std::string line; std::getline(input, line);) {
+    if (line.rfind("kind=", 0) == 0) kind = std::atoi(line.c_str() + 5);
+    else if (line.rfind("at=", 0) == 0) at = std::atoll(line.c_str() + 3);
+  }
+  input.close();
+  std::error_code error;
+  std::filesystem::remove(file, error);
+  if (kind <= int(Kind::none) || kind > int(Kind::closing) || at <= 0 || at > now_ms || now_ms - at > 120000)
+    return found;
+  found.kind = Kind(kind);
+  found.at_ms = at;
+  return found;
+}
 }  // namespace xbox360ps5::leaving_notice
