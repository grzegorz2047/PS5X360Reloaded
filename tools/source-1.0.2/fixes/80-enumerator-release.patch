diff --git a/.deps/xenia-canary/src/xenia/kernel/xenumerator.cc b/.deps/xenia-canary/src/xenia/kernel/xenumerator.cc
--- a/.deps/xenia-canary/src/xenia/kernel/xenumerator.cc
+++ b/.deps/xenia-canary/src/xenia/kernel/xenumerator.cc
@@ -9,6 +9,8 @@
 
 #include "xenia/kernel/xenumerator.h"
 
+#include <unordered_map>
+
 namespace xe {
 namespace kernel {
 
@@ -18,7 +20,37 @@ XEnumerator::XEnumerator(KernelState* kernel_state, size_t items_per_enumerate,
       items_per_enumerate_(items_per_enumerate),
       item_size_(item_size) {}
 
-XEnumerator::~XEnumerator() = default;
+// Xbox360PS5 (fix 80): this emulator's enumerators by their guest object.
+// Battlefield 3 makes one about 15 times a second, takes it with
+// XamGetPrivateEnumStructureFromHandle (a handle reference) and gives it back
+// with ObDereferenceObject; that found no enumerator at the address (its stamp
+// overwritten), so the reference was never given back, the game's close never
+// freed it, and after about 14 minutes the guest's 4 KiB heap was full.
+namespace {
+std::unordered_map<uint32_t, XEnumerator*>& OwnedEnumerators() {
+  static std::unordered_map<uint32_t, XEnumerator*> owned;
+  return owned;
+}
+}  // namespace
+
+XObject* XEnumerator::RetainByGuestObject(uint32_t guest_ptr) {
+  auto global_lock = xe::global_critical_region::AcquireDirect();
+  const auto it = OwnedEnumerators().find(guest_ptr);
+  if (it == OwnedEnumerators().end() || it->second->handles().empty()) {
+    return nullptr;
+  }
+  return retain_object<XObject>(it->second).release();
+}
+
+XEnumerator::~XEnumerator() {
+  if (const uint32_t guest_ptr = guest_object()) {
+    auto global_lock = xe::global_critical_region::AcquireDirect();
+    const auto it = OwnedEnumerators().find(guest_ptr);
+    if (it != OwnedEnumerators().end() && it->second == this) {
+      OwnedEnumerators().erase(it);
+    }
+  }
+}
 
 X_STATUS XEnumerator::Initialize(uint32_t user_index, uint32_t app_id,
                                  uint32_t open_message, uint32_t close_message,
@@ -42,6 +74,10 @@ X_STATUS XEnumerator::Initialize(uint32_t user_index, uint32_t app_id,
   }
 
   extra_size_ = extra_size;
+  {
+    auto global_lock = xe::global_critical_region::AcquireDirect();
+    OwnedEnumerators()[this->guest_object()] = this;  // fix 80
+  }
   return X_STATUS_SUCCESS;
 }
 
