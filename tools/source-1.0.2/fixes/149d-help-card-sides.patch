+// Fix 149d (review of candidate 3): the card must not cover the panels the in-game overlay draws beside the
+// guide (FpsOverlay, canary_game_main.cpp): the motion panel (phone_qr_panel.hpp's box, x 1550-1900, or
+// x 24-374 with "Motion panel: Top left") while camera motion is on, and fix 147c's Harmonix music keys
+// panel (the same box on the other side, down to y 760) while a game waits for its keys. The card goes
+// right of the guide when that side is free, else left of it, else it is not drawn (the rows still show
+// each option's name and value; the launcher has the whole help).
+inline constexpr float kCardWidth = 372;  // the card, in 1080p units
+inline constexpr float kCardGap = 14;     // between the guide and the card
+struct SidePanels {
+  bool left = false, right = false;  // a panel is drawn on that side of the guide
+};
+// motion_shown: camera motion is on (its panel, or its phone QR code, is drawn); motion_panel: the "Motion
+// panel" option (0 top right, 1 top left, 2 off: the QR code still shows at the right while no phone is
+// connected); keys_shown: a game waits for the Harmonix keys (its panel goes where the motion panel is not).
+inline SidePanels BusySides(bool motion_shown, int motion_panel, bool keys_shown) {
+  SidePanels sides;
+  const bool motion_left = motion_panel == 1;
+  if (motion_shown) (motion_left ? sides.left : sides.right) = true;
+  if (keys_shown) (motion_left ? sides.right : sides.left) = true;
+  return sides;
+}
+enum class CardSide { right, left, none };
+inline CardSide HelpCardSide(SidePanels busy) {
+  return !busy.right ? CardSide::right : !busy.left ? CardSide::left : CardSide::none;
+}
+// The card's left edge for a side, given the guide's left and right edges.
+inline float CardX(CardSide side, float guide_left, float guide_right) {
+  return side == CardSide::left ? guide_left - kCardGap - kCardWidth : guide_right + kCardGap;
+}
 
