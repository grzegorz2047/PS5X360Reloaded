new file mode 100644
--- /dev/null
+++ b/include/xbox360ps5/phone_link.hpp
@@ -0,0 +1,262 @@
+// SPDX-License-Identifier: MIT
+// Fix 169 (#74): the phone link in the game log, to see why pose frames come late or stop.
+//
+// A player's bug reports (1.0.6) showed no real disconnects, but slow and uneven delivery: the
+// phone detected about 20 frames a second and sent about 6, every POST it sent arrived, and the
+// mean round trip implied by the two frames in flight was about 330 ms against a median of
+// about 56 ms, so a few POSTs stalled for 0.5-2 s. Nothing in the log said whether they stalled
+// in the console (reading, handling, answering) or before they reached it, nor when the phone's
+// connections opened, closed or timed out, nor when the page gave up on the console ('lost')
+// or the TV panel flipped to "no phone connected".
+//
+// port/phone_camera_tls.cpp reports to Link: each connection's opening and closing (with why),
+// a connection refused because kMaxConnections were open, and each /api/motion/frame POST's
+// times in the console. Link gives the lines to log: the first kEventLines connection events,
+// each frame POST that took over kSlowFrameUs in the console (the first kSlowLines), and every
+// kWindowMs a summary (frames, their console times, the waits between requests and the gaps
+// between frames). PageLine turns the page's own counts ("link" in its 2 s report, pairing.mjs's
+// PoseSender and LinkHealth) into a line: at once when something went wrong, else every
+// kWindowMs. PanelFlips (phone_qr_panel.hpp) logs the TV panel's flips.
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "xbox360ps5/phone_latency.hpp"  // Numbers, kMaxBody
+
+namespace xbox360ps5::phone_link {
+
+constexpr int64_t kWindowMs = 10000;       // the summary's window
+constexpr uint64_t kSlowFrameUs = 250000;  // a frame POST this long in the console gets its own line
+constexpr int64_t kGapMs = 500;            // motion::Snapshot() drops a body this old
+constexpr uint32_t kEventLines = 64, kSlowLines = 32, kPageAlarmLines = 200;
+constexpr size_t kSamples = 2000;          // per window (the phone sends at most ~30 a second)
+
+// Why a phone connection ended.
+enum class Close {
+  kPeer,          // the phone closed it (or reset it)
+  kIdle,          // no request for the idle timeout (SO_RCVTIMEO)
+  kHandshake,     // the TLS handshake failed
+  kTls,           // a TLS error while reading
+  kRead,          // a socket error while reading (errno)
+  kWrite,         // the answer could not be written
+  kHeadTooLarge,  // no end of the request head within 16 KiB
+  kBadRequest,    // no method and target
+  kClose,         // the phone asked for it (Connection: close)
+};
+inline const char* CloseText(Close why) {
+  switch (why) {
+    case Close::kPeer: return "the phone closed it";
+    case Close::kIdle: return "idle timeout (no request for 20 s)";
+    case Close::kHandshake: return "TLS handshake failed";
+    case Close::kTls: return "TLS error while reading";
+    case Close::kRead: return "read error";
+    case Close::kWrite: return "the answer could not be written";
+    case Close::kHeadTooLarge: return "request head too large";
+    case Close::kBadRequest: return "bad request line";
+    case Close::kClose: return "the phone asked to close it";
+  }
+  return "?";
+}
+
+// One /api/motion/frame POST in the console, in microseconds: the wait for its first bytes
+// after the previous answer on its connection (the phone and the network; 0 when they were
+// already read), reading the rest of it, handling it (Route), writing the answer.
+struct FrameTimes {
+  uint64_t wait_us = 0, read_us = 0, handle_us = 0, write_us = 0;
+};
+
+inline uint64_t Median(std::vector<uint64_t> values) {
+  if (values.empty()) return 0;
+  const size_t middle = (values.size() - 1) / 2;
+  std::nth_element(values.begin(), values.begin() + middle, values.end());
+  return values[middle];
+}
+inline uint64_t Max(const std::vector<uint64_t>& values) {
+  return values.empty() ? 0 : *std::max_element(values.begin(), values.end());
+}
+inline std::string Ms(uint64_t us) {
+  char text[32];
+  if (us < 10000) std::snprintf(text, sizeof(text), "%.1f", double(us) / 1000.0);
+  else std::snprintf(text, sizeof(text), "%llu", (unsigned long long)((us + 500) / 1000));
+  return text;
+}
+
+class Link {
+ public:
+  struct Opened {
+    uint32_t id = 0;
+    std::optional<std::string> line;
+  };
+  // A phone connection accepted; `open`: how many are open with it.
+  Opened Open(int open) {
+    std::lock_guard lock(mutex_);
+    Opened out;
+    out.id = ++next_id_;
+    ++opened_;
+    if (event_lines_ < kEventLines) {
+      ++event_lines_;
+      out.line = "Phone link: connection " + std::to_string(out.id) + " opened (" + std::to_string(open) +
+                 " open) (fix 169)";
+    }
+    return out;
+  }
+  // A connection ended after `age_ms` and `requests`; `detail`: errno or the TLS error code (0: none);
+  // `open`: how many stay open.
+  std::optional<std::string> Closed(uint32_t id, Close why, int64_t age_ms, uint32_t requests, int detail,
+                                    int open) {
+    std::lock_guard lock(mutex_);
+    ++closed_;
+    if (why == Close::kIdle) ++idle_;
+    else if (why != Close::kPeer && why != Close::kClose) ++errors_;
+    if (event_lines_ >= kEventLines) return std::nullopt;
+    ++event_lines_;
+    char text[256];
+    std::snprintf(text, sizeof(text),
+                  "Phone link: connection %u closed after %.1f s and %u request(s): %s%s (%d open) (fix 169)", id,
+                  double(age_ms) / 1000.0, requests, CloseText(why), Detail(why, detail).c_str(), open);
+    return std::string(text);
+  }
+  // A connection refused: `open` were open already.
+  std::optional<std::string> Refused(int open) {
+    std::lock_guard lock(mutex_);
+    ++refused_;
+    if (event_lines_ >= kEventLines) return std::nullopt;
+    ++event_lines_;
+    return "Phone link: a new connection refused, " + std::to_string(open) +
+           " already open (the page's request fails) (fix 169)";
+  }
+  // A frame POST served on connection `id` (its body complete at now_ms): the lines to log, a slow
+  // one's and the summary when due.
+  std::vector<std::string> Frame(uint32_t id, const FrameTimes& t, int64_t now_ms) {
+    std::lock_guard lock(mutex_);
+    std::vector<std::string> lines;
+    if (start_ms_ < 0) start_ms_ = now_ms;
+    if (wait_.size() < kSamples) {
+      wait_.push_back(t.wait_us);
+      read_.push_back(t.read_us);
+      handle_.push_back(t.handle_us);
+      write_.push_back(t.write_us);
+    }
+    ++frames_;
+    if (last_frame_ms_ >= 0) {
+      const int64_t gap = std::max<int64_t>(0, now_ms - last_frame_ms_);
+      if (gaps_.size() < kSamples) gaps_.push_back(uint64_t(gap) * 1000);
+      if (gap >= kGapMs) ++long_gaps_;
+    }
+    last_frame_ms_ = now_ms;
+    const uint64_t inside = t.read_us + t.handle_us + t.write_us;
+    if (inside >= kSlowFrameUs && slow_lines_ < kSlowLines) {
+      ++slow_lines_;
+      lines.push_back("Phone link: a frame POST on connection " + std::to_string(id) + " took " + Ms(inside) +
+                      " ms in the console (read " + Ms(t.read_us) + ", handle " + Ms(t.handle_us) + ", write " +
+                      Ms(t.write_us) + " ms) (fix 169)");
+    }
+    if (auto summary = SummaryLocked(now_ms, false)) lines.push_back(*summary);
+    return lines;
+  }
+  // The summary when kWindowMs have passed since the window began (or now, with `force`, when
+  // anything happened); it starts the next window.
+  std::optional<std::string> Summary(int64_t now_ms, bool force = false) {
+    std::lock_guard lock(mutex_);
+    return SummaryLocked(now_ms, force);
+  }
+
+ private:
+  static std::string Detail(Close why, int detail) {
+    if (!detail) return "";
+    char text[48];
+    if (why == Close::kHandshake || why == Close::kTls) std::snprintf(text, sizeof(text), " (-0x%04X)", -detail);
+    else std::snprintf(text, sizeof(text), " (errno %d)", detail);
+    return text;
+  }
+  std::optional<std::string> SummaryLocked(int64_t now_ms, bool force) {
+    if (start_ms_ < 0) {
+      if (!force || (!opened_ && !closed_ && !refused_)) return std::nullopt;
+      start_ms_ = now_ms;
+    }
+    const int64_t span = now_ms - start_ms_;
+    if (span < kWindowMs && !force) return std::nullopt;
+    char text[640];
+    const double seconds = std::max<double>(double(span) / 1000.0, 0.001);
+    std::snprintf(text, sizeof(text),
+                  "Phone link: %.1f s: %u frame POSTs (%.1f/s); in the console read/handle/write median "
+                  "%s/%s/%s ms, max %s/%s/%s ms; wait for the next request on a connection median %s ms, max "
+                  "%s ms; between frames median %s ms, max %s ms, %u gap(s) of %lld ms or more; connections "
+                  "opened %u, closed %u (idle %u, errors %u), refused %u (fix 169)",
+                  seconds, frames_, double(frames_) / seconds, Ms(Median(read_)).c_str(),
+                  Ms(Median(handle_)).c_str(), Ms(Median(write_)).c_str(), Ms(Max(read_)).c_str(),
+                  Ms(Max(handle_)).c_str(), Ms(Max(write_)).c_str(), Ms(Median(wait_)).c_str(),
+                  Ms(Max(wait_)).c_str(), Ms(Median(gaps_)).c_str(), Ms(Max(gaps_)).c_str(), long_gaps_,
+                  (long long)kGapMs, opened_, closed_, idle_, errors_, refused_);
+    start_ms_ = -1;
+    frames_ = long_gaps_ = opened_ = closed_ = idle_ = errors_ = refused_ = 0;
+    wait_.clear();
+    read_.clear();
+    handle_.clear();
+    write_.clear();
+    gaps_.clear();
+    return std::string(text);
+  }
+
+  std::mutex mutex_;
+  uint32_t next_id_ = 0, event_lines_ = 0, slow_lines_ = 0;
+  int64_t start_ms_ = -1, last_frame_ms_ = -1;
+  uint32_t frames_ = 0, long_gaps_ = 0, opened_ = 0, closed_ = 0, idle_ = 0, errors_ = 0, refused_ = 0;
+  std::vector<uint64_t> wait_, read_, handle_, write_, gaps_;
+};
+inline Link stats;
+
+// ---- The page's own counts ---------------------------------------------------------------------
+// "link":[sent, answered, failed, timed out, replaced, slowest ms, status failed, lost, resumed]
+// in the page's 2 s report (pairing.mjs: PoseSender.take(), LinkHealth.take()), since its last
+// report.
+constexpr int kPageNumbers = 9;
+struct PageLink {
+  double sent = 0, answered = 0, failed = 0, timeouts = 0, replaced = 0, slowest_ms = 0, status_failed = 0,
+         lost = 0, resumed = 0;
+  bool Alarm() const { return failed > 0 || timeouts > 0 || status_failed > 0 || lost > 0 || resumed > 0; }
+};
+inline std::optional<PageLink> ParsePage(const std::string& json) {
+  if (json.empty() || json.size() > phone_latency::kMaxBody || json.front() != '{') return std::nullopt;
+  double v[kPageNumbers];
+  if (!phone_latency::Numbers(json, "link", v, kPageNumbers)) return std::nullopt;
+  for (double x : v)
+    if (x < 0) return std::nullopt;
+  return PageLink{v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7], v[8]};
+}
+// The line for a report: at once when a request failed or timed out, or the page went 'lost' or
+// came back (the first kPageAlarmLines of those), else at most every kWindowMs.
+class PageLines {
+ public:
+  std::optional<std::string> Line(const std::string& json, int64_t now_ms) {
+    const auto page = ParsePage(json);
+    if (!page) return std::nullopt;
+    std::lock_guard lock(mutex_);
+    const bool alarm = page->Alarm() && alarms_ < kPageAlarmLines;
+    if (!alarm && last_ms_ >= 0 && now_ms - last_ms_ < kWindowMs) return std::nullopt;
+    if (alarm) ++alarms_;
+    last_ms_ = now_ms;
+    char text[400];
+    std::snprintf(text, sizeof(text),
+                  "Phone link (page): frames sent %.0f, answered %.0f, failed %.0f, given up after the timeout "
+                  "%.0f, replaced by a newer one while waiting %.0f, slowest answer %.0f ms; status polls "
+                  "failed %.0f; the page took the PS5 as lost %.0f time(s), came back in the same session %.0f "
+                  "time(s) (fix 169)",
+                  page->sent, page->answered, page->failed, page->timeouts, page->replaced, page->slowest_ms,
+                  page->status_failed, page->lost, page->resumed);
+    return std::string(text);
+  }
+
+ private:
+  std::mutex mutex_;
+  int64_t last_ms_ = -1;
+  uint32_t alarms_ = 0;
+};
+inline PageLines page_lines;
+
+}  // namespace xbox360ps5::phone_link
diff --git a/include/xbox360ps5/body_identity.hpp b/include/xbox360ps5/body_identity.hpp
new file mode 100644
--- /dev/null
+++ b/include/xbox360ps5/body_identity.hpp
@@ -0,0 +1,104 @@
+// SPDX-License-Identifier: MIT
+// Fix 169 (#74): the player's Kinect identity kept through short gaps in the phone's frames.
+//
+// A gap of over 500 ms in the phone's frames drops the body (motion::Snapshot), and the body
+// that came back got a new tracking id (SkeletonIdentity, virtual_skeleton.hpp), so the title
+// ran its player identification again; fix 156l then answered that identification with the
+// skeleton frame's binding at delivery time, and for a frame inside a gap that was no profile:
+// "profile matched false (user FE)". In Fighters Uncaged the start-screen punch was not taken.
+//
+// Now a body that comes back within kIdentityGraceMs in the same phone session keeps its
+// tracking id (virtual_skeleton.hpp), and an identify request is answered for the profile its
+// body was bound to (BoundUsers, filled by PublishNuiFrame; AnswerUser). The three 156l log
+// lines (the title's identify, enrollment and answer) get LogBudget's 64 lines instead of 8.
+#pragma once
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <mutex>
+#include <optional>
+#include <string>
+
+#include "xbox360ps5/virtual_skeleton.hpp"  // kUserIndexNone, identity_kept, identity_new
+
+namespace xbox360ps5::motion {
+
+// The profile slot each recent body (tracking id) was bound to.
+constexpr size_t kBoundBodies = 8;
+class BoundUsers {
+ public:
+  void Remember(uint32_t tracking_id, uint32_t user_index) {
+    if (!tracking_id || user_index >= 4) return;
+    std::lock_guard lock(mutex_);
+    for (size_t n = 0; n < kBoundBodies; ++n)
+      if (ids_[n] == tracking_id) {
+        users_[n] = user_index;
+        return;
+      }
+    ids_[next_] = tracking_id;
+    users_[next_] = user_index;
+    next_ = (next_ + 1) % kBoundBodies;
+  }
+  // The slot `tracking_id` was last bound to; kUserIndexNone when it never was.
+  uint32_t Of(uint32_t tracking_id) {
+    if (!tracking_id) return kUserIndexNone;
+    std::lock_guard lock(mutex_);
+    for (size_t n = 0; n < kBoundBodies; ++n)
+      if (ids_[n] == tracking_id) return users_[n];
+    return kUserIndexNone;
+  }
+  void Clear() {
+    std::lock_guard lock(mutex_);
+    for (size_t n = 0; n < kBoundBodies; ++n) ids_[n] = users_[n] = 0;
+    next_ = 0;
+  }
+
+ private:
+  std::mutex mutex_;
+  uint32_t ids_[kBoundBodies]{}, users_[kBoundBodies]{};
+  size_t next_ = 0;
+};
+inline BoundUsers bound_users;
+
+// The profile slot an identify answer is for: the slot the body was bound to while it is still
+// signed in; else the frame's binding while signed in; else the first signed-in slot (as
+// nui_identity::ProfileSlot, GetEnrollmentInformation's answer); kUserIndexNone when no profile
+// is signed in.
+inline uint32_t AnswerUser(uint32_t body_user, uint32_t live_user, uint32_t signed_in_mask) {
+  if (body_user < 4 && (signed_in_mask & (1u << body_user))) return body_user;
+  if (live_user < 4 && (signed_in_mask & (1u << live_user))) return live_user;
+  for (uint32_t slot = 0; slot < 4; ++slot)
+    if (signed_in_mask & (1u << slot)) return slot;
+  return kUserIndexNone;
+}
+
+// A log line budget for the 156l lines' `if (shown.fetch_add(1) < 8)`: fetch_add says 0 (within
+// the budget) for the first `Lines` calls and UINT32_MAX after, so those lines keep their text
+// (fix 156t's patch changes the lines next to the answer's) and log `Lines` times instead of 8.
+template <uint32_t Lines>
+struct LogBudget {
+  std::atomic<uint32_t> used{0};
+  uint32_t fetch_add(uint32_t n) { return used.fetch_add(n) < Lines ? 0 : UINT32_MAX; }
+};
+constexpr uint32_t kIdentifyLogLines = 64;
+
+// "Virtual Kinect: tracking ids so far: N new, K kept ..." when the counts changed since the last
+// line (port/phone_camera_tls.cpp asks after each pose frame), the first kIdentityLines times.
+constexpr uint32_t kIdentityLines = 64;
+inline std::optional<std::string> IdentityLine() {
+  static std::atomic<uint64_t> shown_new{0}, shown_kept{0};
+  static std::atomic<uint32_t> lines{0};
+  const uint64_t fresh = identity_new.load(), kept = identity_kept.load();
+  const bool same_new = fresh == shown_new.exchange(fresh);
+  const bool same_kept = kept == shown_kept.exchange(kept);
+  if ((same_new && same_kept) || lines.fetch_add(1) >= kIdentityLines) return std::nullopt;
+  char text[200];
