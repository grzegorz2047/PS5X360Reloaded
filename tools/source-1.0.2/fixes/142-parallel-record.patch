+// SPDX-License-Identifier: MIT
+// Xbox360PS5, fix 142: the GPU command processing of a frame split over two threads (prototype).
+//
+// The GPU command thread is the bottleneck of the heavy titles on the console (Grand Theft Auto IV,
+// Red Dead Redemption and Modern Warfare 2 keep it 90-99% busy with the PS5's GPU 25-33% busy).
+// Fix 134 moved the replay into Vulkan and the queue submit to a worker; parsing the PM4 stream,
+// the register writes and the draws' translation stayed on one thread. Fix 75 measured the part
+// of that thread outside the draws and submissions (the packets themselves, mostly register
+// writes): Battlefield 3 468 ms/s, Tekken Tag Tournament 2 316, Modern Warfare 2 150.
+//
+// Here (gpu_parallel_record 1) a decode thread walks the ring and the indirect buffers, applies
+// the packets' predication (bin mask and select), drops shader constant writes that leave a
+// constant as it is, and hands the rest to the GPU command thread in order through a FIFO of ops:
+// runs of register writes (applied with fix 103's block path) and the other packets as they are
+// (executed by the same handlers as before). The GPU command thread keeps every piece of state it
+// had (the register file, the caches, Vulkan), so what it does with an op is what it did with the
+// packet; it only no longer parses and no longer writes the unchanged constants.
+//
+// Guest-visible order: everything the guest can observe (memory writes by MEM_WRITE, EVENT_WRITE*,
+// REG_TO_MEM, COND_WRITE and the scratch registers, interrupts, swaps, the ring's read pointer
+// write-back) is done by the GPU command thread at its place in the stream, so the guest sees the
+// GPU's progress no earlier than before. The decode thread waits for the GPU command thread to
+// execute everything up to and including a WAIT_REG_MEM before it decodes past it (the condition
+// may depend on the stream's own writes), and before it enters an indirect buffer that overlaps a
+// memory write not yet executed. See research/parallel-gpu-commands/DESIGN.md.
+//
+// Modes (gpu_parallel_record, or "mode" in parallel-record.txt, read at start): 0 off, exactly as
+// before; 1 the decode thread; 2 the same ops decoded and executed by the GPU command thread alone
+// (the decoder's and the ops' correctness and cost without a second thread).
+#ifndef XENIA_GPU_VULKAN_PARALLEL_RECORD_H_
+#define XENIA_GPU_VULKAN_PARALLEL_RECORD_H_
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <mutex>
+#include <sstream>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace xe {
+namespace gpu {
+namespace parallel_record {
+
+enum Mode : uint32_t { kOff = 0, kThread = 1, kInline = 2, kModes };
+
+inline const char* ModeName(uint32_t mode) {
+  return mode == kThread ? "a decode thread" : mode == kInline ? "decoded on the GPU thread" : "off";
+}
+
+struct Settings {
+  uint32_t mode = kOff;
+  uint32_t fifo_kib = 4096;  // the FIFO of ops between the threads
+  uint32_t filter = 1;       // unchanged shader constant writes dropped by the decoder
+  uint32_t sibling = 0;      // the decode thread on the other half of the GPU thread's core
+  bool operator==(const Settings& other) const {
+    return mode == other.mode && fifo_kib == other.fifo_kib && filter == other.filter &&
+           sibling == other.sibling;
+  }
+};
+
+// parallel-record.txt: "mode 0|1|2", "fifo <KiB>" (256 to 65536), "filter 0|1", "sibling 0|1",
+// "#" comments. What a line does not set keeps the value it had (the cvars). Returns the lines not
+// understood.
+inline int Parse(const std::string& text, Settings& settings) {
+  int not_understood = 0;
+  std::istringstream lines(text);
+  std::string line;
+  while (std::getline(lines, line)) {
+    const size_t hash = line.find('#');
+    if (hash != std::string::npos) line.resize(hash);
+    std::istringstream words(line);
+    std::string key, extra;
+    long long value = -1;
+    if (!(words >> key)) continue;
+    if (!(words >> value) || (words >> extra)) {
+      ++not_understood;
+    } else if (key == "mode" && value >= 0 && value < kModes) {
+      settings.mode = uint32_t(value);
+    } else if (key == "fifo" && value >= 256 && value <= 65536) {
+      settings.fifo_kib = uint32_t(value);
+    } else if (key == "filter" && (value == 0 || value == 1)) {
+      settings.filter = uint32_t(value);
+    } else if (key == "sibling" && (value == 0 || value == 1)) {
+      settings.sibling = uint32_t(value);
+    } else {
+      ++not_understood;
+    }
+  }
+  return not_understood;
+}
+
+// The PM4 type 3 opcodes the packet handlers know (xenos.h; vulkan_command_processor.cc checks
+// them against it at compile time).
+namespace pm4 {
+constexpr uint32_t kNop = 0x10;
+constexpr uint32_t kRegRmw = 0x21;
+constexpr uint32_t kDrawIndx = 0x22;
+constexpr uint32_t kVizQuery = 0x23;
+constexpr uint32_t kWaitForIdle = 0x26;
+constexpr uint32_t kImLoad = 0x27;
+constexpr uint32_t kImLoadImmediate = 0x2b;
+constexpr uint32_t kSetConstant = 0x2d;
+constexpr uint32_t kLoadAluConstant = 0x2f;
+constexpr uint32_t kDrawIndx2 = 0x36;
+constexpr uint32_t kIndirectBufferPfd = 0x37;
+constexpr uint32_t kInvalidateState = 0x3b;
+constexpr uint32_t kWaitRegMem = 0x3c;
+constexpr uint32_t kMemWrite = 0x3d;
+constexpr uint32_t kRegToMem = 0x3e;
+constexpr uint32_t kIndirectBuffer = 0x3f;
+constexpr uint32_t kCondWrite = 0x45;
+constexpr uint32_t kEventWrite = 0x46;
+constexpr uint32_t kMeInit = 0x48;
+constexpr uint32_t kSetBinMask = 0x50;
+constexpr uint32_t kSetBinSelect = 0x51;
+constexpr uint32_t kInterrupt = 0x54;
+constexpr uint32_t kSetConstant2 = 0x55;
+constexpr uint32_t kSetShaderConstants = 0x56;
+constexpr uint32_t kEventWriteShd = 0x58;
+constexpr uint32_t kEventWriteExt = 0x5a;
+constexpr uint32_t kEventWriteZpd = 0x5b;
+constexpr uint32_t kWaitIbPfdComplete = 0x5d;
+constexpr uint32_t kContextUpdate = 0x5e;
+constexpr uint32_t kSetBinMaskLo = 0x60;
+constexpr uint32_t kSetBinMaskHi = 0x61;
+constexpr uint32_t kSetBinSelectLo = 0x62;
+constexpr uint32_t kSetBinSelectHi = 0x63;
+constexpr uint32_t kXeSwap = 0x64;
+// Whether ExecutePacketType3's switch has a case for the opcode (any other ends the buffer).
+inline bool Known(uint32_t opcode) {
+  switch (opcode) {
+    case kNop: case kRegRmw: case kDrawIndx: case kVizQuery: case kWaitForIdle: case kImLoad:
+    case kImLoadImmediate: case kSetConstant: case kLoadAluConstant: case kDrawIndx2:
+    case kIndirectBufferPfd: case kInvalidateState: case kWaitRegMem: case kMemWrite:
+    case kRegToMem: case kIndirectBuffer: case kCondWrite: case kEventWrite: case kMeInit:
+    case kSetBinMask: case kSetBinSelect: case kInterrupt: case kSetConstant2:
+    case kSetShaderConstants: case kEventWriteShd: case kEventWriteExt: case kEventWriteZpd:
+    case kWaitIbPfdComplete: case kContextUpdate: case kSetBinMaskLo: case kSetBinMaskHi:
+    case kSetBinSelectLo: case kSetBinSelectHi: case kXeSwap:
+      return true;
+    default:
+      return false;
+  }
+}
+}  // namespace pm4
+
+// The shader constants (register_table.inc), the only registers the decoder drops writes to.
+constexpr uint32_t kFloatFirst = 0x4000, kFloatLast = 0x47FF;
+constexpr uint32_t kFetchFirst = 0x4800, kFetchLast = 0x48BF;
+constexpr uint32_t kBoolLoopFirst = 0x4900, kBoolLoopLast = 0x4927;
+constexpr uint32_t kShadowFirst = kFloatFirst, kShadowCount = kBoolLoopLast + 1 - kFloatFirst;
+inline bool Filterable(uint32_t index) {
+  return (index >= kFloatFirst && index <= kFloatLast) ||
+         (index >= kFetchFirst && index <= kFetchLast) ||
+         (index >= kBoolLoopFirst && index <= kBoolLoopLast);
+}
+
+inline uint32_t Swap(uint32_t value) {
+#if defined(__GNUC__) || defined(__clang__)
+  return __builtin_bswap32(value);
+#else
+  return (value >> 24) | ((value >> 8) & 0xFF00) | ((value << 8) & 0xFF0000) | (value << 24);
+#endif
+}
+
+inline void Relax() {
+#if defined(__x86_64__) || defined(_M_X64)
+  __builtin_ia32_pause();
+#else
+  std::this_thread::yield();
+#endif
+}
+
+// ---------------------------------------------------------------------------------------------
+// The FIFO of ops: one producer (the decoder), one consumer (the GPU command thread). An op is a
+// 16-byte header and its payload, 8-byte aligned and contiguous; an op that would cross the end
+// starts at the beginning after a wrap op. Positions are byte counts since the start, never
+// wrapped: `published` is what the consumer may read, `retired` what it has executed.
+enum OpKind : uint32_t {
+  kOpWrap = 0,        // nothing up to the end of the buffer
+  kOpPackets,         // whole PM4 packets, guest byte order, for ExecutePacket
+  kOpRegisters,       // a run of register values (guest byte order) from register `arg`
+  kOpPrimaryBegin,    // a part of the ring starts (ExecutePrimaryBuffer's prologue)
+  kOpPrimaryEnd,      // ... ends (OnPrimaryBufferEnd)
+  kOpReadPointer,     // the ring's read pointer `arg` is written back for the guest
+  kOpKinds
+};
+struct OpHeader {
+  uint32_t kind;
+  uint32_t bytes;  // payload
+  uint32_t arg;
+  uint32_t reserved;
+};
+static_assert(sizeof(OpHeader) == 16, "fix 142: the op header");
+inline uint32_t OpSpan(uint32_t payload_bytes) {
+  return uint32_t(sizeof(OpHeader)) + ((payload_bytes + 7) & ~uint32_t(7));
+}
+
+class OpRing {
+ public:
+  // The largest payload: a type 3 packet (0x4000 dwords and its header) or a run of 0x4000.
+  static constexpr uint32_t kMaxPayload = (0x4000 + 1) * 4;
+  explicit OpRing(size_t bytes) {
+    size_t capacity = 256 * 1024;
+    while (capacity < bytes) capacity <<= 1;
+    capacity_ = capacity;
+    data_.assign(capacity_, 0);
+  }
+  size_t capacity() const { return capacity_; }
+
+  // --- the producer ---
+  // Room for an op of `payload_bytes` at the write position (and a wrap op before it when it
+  // would cross the end): the bytes the consumer must retire first, 0 when there is room now.
+  uint64_t RoomNeeded(uint32_t payload_bytes) const {
+    return RoomNeededAt(payload_bytes, retired_.load(std::memory_order_acquire));
+  }
+  // Waits until there is room for an op of `payload_bytes` (or `stop` turns true); the committed
+  // ops must be published. The bytes to retire and the position waited for come from one reading
+  // of `retired`: waiting for a later reading plus the bytes counted from an earlier one could
+  // ask for more than was ever published, and wait for ever. Returns whether there is room.
+  template <class Stop>
+  bool WaitRoom(uint32_t payload_bytes, const Stop& stop) {
+    for (;;) {
+      const uint64_t retired = retired_.load(std::memory_order_acquire);
+      const uint64_t need = RoomNeededAt(payload_bytes, retired);
+      if (!need) return true;
+      if (stop()) return false;
+      WaitRetired(retired + need, stop);  // at most write_: what is published
+    }
+  }
+  // The op's header, its payload written in place after it and grown up to `reserve` bytes; the
+  // caller has made room for `reserve` (RoomNeeded 0).
+  OpHeader* Begin(uint32_t kind, uint32_t reserve, uint32_t arg = 0) {
+    uint64_t at = write_ % capacity_;
+    if (at + OpSpan(reserve) > capacity_) {
+      OpHeader* wrap = reinterpret_cast<OpHeader*>(&data_[at]);
+      wrap->kind = kOpWrap;
+      wrap->bytes = uint32_t(capacity_ - at - sizeof(OpHeader));
+      wrap->arg = 0;
+      write_ += capacity_ - at;
+      at = 0;
+    }
+    OpHeader* header = reinterpret_cast<OpHeader*>(&data_[at]);
+    header->kind = kind;
+    header->bytes = 0;
+    header->arg = arg;
+    header->reserved = 0;
+    open_ = header;
+    return header;
+  }
+  uint8_t* Payload(OpHeader* header) { return reinterpret_cast<uint8_t*>(header + 1); }
+  // Grows the open op's payload (the caller made room for the final size before Begin).
+  void Grow(uint32_t more_bytes) { open_->bytes += more_bytes; }
+  void Commit() {
+    write_ += OpSpan(open_->bytes);
+    open_ = nullptr;
+  }
+  uint64_t write_position() const { return write_; }
+  // Makes the committed ops visible and wakes the consumer if it sleeps.
+  void Publish() {
+    if (published_.load(std::memory_order_relaxed) == write_) return;
+    published_.store(write_, std::memory_order_seq_cst);
+    if (consumer_sleeping_.load(std::memory_order_seq_cst)) {
+      std::lock_guard<std::mutex> lock(mutex_);
+      changed_.notify_all();
+    }
+  }
+  // Waits until the consumer has retired `position` (or `stop` turns true; timed waits keep a
+  // stop from being missed). Returns whether it had to wait.
+  template <class Stop>
+  bool WaitRetired(uint64_t position, const Stop& stop) {
+    if (retired_.load(std::memory_order_acquire) >= position) return false;
+    for (int n = 0; n < 2000; ++n) {
+      if (retired_.load(std::memory_order_acquire) >= position) return true;
+      Relax();
+    }
+    std::unique_lock<std::mutex> lock(mutex_);
+    producer_sleeping_.store(true, std::memory_order_seq_cst);
+    while (retired_.load(std::memory_order_seq_cst) < position && !stop()) {
+      changed_.wait_for(lock, std::chrono::milliseconds(1));
+    }
+    producer_sleeping_.store(false, std::memory_order_relaxed);
+    return true;
+  }
+
+  // --- the consumer ---
+  // The next op, or null when none is published. Wrap ops are taken here; `retired` moves past a
+  // wrap only with the op after it, so it is always the end of an executed op.
+  const OpHeader* Front() {
+    for (;;) {
+      if (read_ == published_.load(std::memory_order_acquire)) return nullptr;
+      const OpHeader* header = reinterpret_cast<const OpHeader*>(&data_[read_ % capacity_]);
+      if (header->kind != kOpWrap) return header;
+      read_ += capacity_ - read_ % capacity_;
+    }
+  }
+  const uint8_t* Payload(const OpHeader* header) const {
+    return reinterpret_cast<const uint8_t*>(header + 1);
+  }
+  // The op returned by Front has been executed.
+  void Pop() {
+    const OpHeader* header = reinterpret_cast<const OpHeader*>(&data_[read_ % capacity_]);
+    read_ += OpSpan(header->bytes);
+    retired_.store(read_, std::memory_order_seq_cst);
+    if (producer_sleeping_.load(std::memory_order_seq_cst)) {
+      std::lock_guard<std::mutex> lock(mutex_);
+      changed_.notify_all();
+    }
+  }
+  // Waits up to `timeout` for an op to be published; spins `spin` times first.
+  bool WaitForOps(std::chrono::microseconds timeout, int spin) {
+    for (int n = 0; n < spin; ++n) {
+      if (read_ != published_.load(std::memory_order_acquire)) return true;
+      Relax();
+    }
+    std::unique_lock<std::mutex> lock(mutex_);
+    consumer_sleeping_.store(true, std::memory_order_seq_cst);
+    if (read_ == published_.load(std::memory_order_seq_cst)) {
+      changed_.wait_for(lock, timeout);
+    }
+    consumer_sleeping_.store(false, std::memory_order_relaxed);
+    return read_ != published_.load(std::memory_order_acquire);
+  }
+  // Wakes a sleeping consumer without publishing (the decoder became idle, or stopping).
+  void Wake() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    changed_.notify_all();
+  }
+  uint64_t published() const { return published_.load(std::memory_order_acquire); }
+  uint64_t retired() const { return retired_.load(std::memory_order_acquire); }
+
+ private:
+  // With `retired` read once: what must be retired beyond it (never more than was written, as an
+  // op is never larger than the buffer).
+  uint64_t RoomNeededAt(uint32_t payload_bytes, uint64_t retired) const {
+    const uint64_t at = write_ % capacity_;
+    uint64_t need = OpSpan(payload_bytes);
+    if (at + need > capacity_) need += capacity_ - at;  // the wrap
+    const uint64_t used = write_ - retired;
+    return used + need > capacity_ ? used + need - capacity_ : 0;
+  }
+
+  size_t capacity_ = 0;
+  std::vector<uint8_t> data_;
+  uint64_t write_ = 0;      // the producer's
+  OpHeader* open_ = nullptr;
+  uint64_t read_ = 0;       // the consumer's
+  alignas(64) std::atomic<uint64_t> published_{0};
+  alignas(64) std::atomic<uint64_t> retired_{0};
+  alignas(64) std::atomic<bool> consumer_sleeping_{false};
+  std::atomic<bool> producer_sleeping_{false};
+  std::mutex mutex_;
+  std::condition_variable changed_;
+};
+
+// ---------------------------------------------------------------------------------------------
+// Why the decoder waited for the GPU command thread.
+enum SerializeReason : uint32_t {
+  kSerializeWait = 0,  // WAIT_REG_MEM: executed before decoding past it
+  kSerializeRoom,      // the FIFO was full
+  kSerializeIbWrite,   // an indirect buffer overlaps a memory write not yet executed
+  kSerializeReasons
+};
+inline const char* SerializeReasonName(uint32_t reason) {
+  static const char* const names[] = {"wait", "room", "ib-write"};
+  return reason < kSerializeReasons ? names[reason] : "?";
+}
+
+// What the decoder counts (plain counters of the decoding thread; the owner adds them up).
+struct DecodeStats {
+  uint64_t packets = 0;            // packets read, indirect buffers' included
+  uint64_t forwarded_packets = 0;  // ... handed over as they are
+  uint64_t predicated_out = 0;     // ... skipped by their predicate
+  uint64_t register_runs = 0;      // runs handed over
+  uint64_t registers_written = 0;  // register writes read (type 0, SET_CONSTANT, ...)
+  uint64_t registers_dropped = 0;  // ... dropped, the constant unchanged
+  uint64_t shadow_resets = 0;      // shadow constants forgotten (packets that may write them)
+  uint64_t indirect_buffers = 0;
+  uint64_t draws = 0;
+  uint64_t swaps = 0;
+  uint64_t primaries = 0;
+  uint64_t failed = 0;             // packets that end their buffer, as before
+  uint64_t ops = 0;
+  uint64_t op_bytes = 0;
+  uint64_t serialize[kSerializeReasons] = {};
+};
+
+// The owner's side of the decoder: the guest's memory and the waits for the GPU command thread.
+class Host {
+ public:
+  virtual ~Host() = default;
+  // The host address of guest physical memory (an indirect buffer).
+  virtual const uint8_t* Translate(uint32_t guest_address) = 0;
+  // Returns once every published op is executed.
+  virtual void Drain(uint32_t reason) = 0;
+  // Returns once the FIFO has room for an op of `payload_bytes`; false: stopping, there is none.
+  virtual bool MakeRoom(uint32_t payload_bytes) = 0;
+};
+
+// A part of guest memory read as PM4 dwords: the ring (wrapping at its capacity) or an indirect
+// buffer (capacity = its size, from 0). `remaining` is RingBuffer::read_count's bytes.
+struct GuestReader {
+  const uint8_t* base = nullptr;
+  uint32_t capacity = 0;
+  uint32_t offset = 0;
+  uint32_t remaining = 0;
+  uint32_t Raw() {
+    uint32_t value;
+    std::memcpy(&value, base + offset, 4);
+    offset += 4;
+    if (offset >= capacity) offset = 0;
+    remaining = remaining >= 4 ? remaining - 4 : 0;
+    return value;
+  }
+  uint32_t Read() { return Swap(Raw()); }
+  // The raw dword `index` dwords ahead, not consumed.
+  uint32_t PeekRaw(uint32_t index) const {
+    uint32_t at = offset + index * 4;
+    if (at >= capacity) at -= capacity;
+    uint32_t value;
+    std::memcpy(&value, base + at, 4);
+    return value;
+  }
+  uint32_t Peek(uint32_t index) const { return Swap(PeekRaw(index)); }
+  void CopyRaw(uint8_t* destination, uint32_t dwords) {
+    uint32_t bytes = dwords * 4;
+    const uint32_t first = std::min(bytes, capacity - offset);
+    std::memcpy(destination, base + offset, first);
+    if (bytes > first) std::memcpy(destination + first, base, bytes - first);
+    offset += bytes;
+    if (offset >= capacity) offset -= capacity;
+    remaining = remaining >= bytes ? remaining - bytes : 0;
+  }
+  void Skip(uint32_t dwords) {
+    const uint32_t bytes = dwords * 4;
+    offset += bytes;
+    if (offset >= capacity) offset -= capacity;
+    remaining = remaining >= bytes ? remaining - bytes : 0;
+  }
+};
+
+// The decoder. The FIFO's producer: one thread at a time.
+class Decoder {
+ public:
+  // Packets are handed over in ops of at most this many bytes, and published at least this often.
+  static constexpr uint32_t kPacketsOpBytes = 16 * 1024;
+  // Memory writes not yet executed that an indirect buffer is checked against; more pending
+  // writes than this and every indirect buffer waits for them.
+  static constexpr size_t kPendingWrites = 128;
+  // Decoded bytes after which a draw publishes them.
+  static constexpr uint32_t kPublishBytes = 4 * 1024;
+
+  Decoder(OpRing& ring, Host& host, bool filter, uint64_t bin_mask, uint64_t bin_select)
+      : ring_(ring), host_(host), filter_(filter), bin_mask_(bin_mask), bin_select_(bin_select) {
+    ResetShadow();
+  }
+  DecodeStats& stats() { return stats_; }
+  bool filter() const { return filter_; }
+
+  // ExecutePrimaryBuffer: the ring's dwords from `read_index` to `write_index`, then the read
+  // pointer's write-back. Publishes at the end.
+  void DecodePrimary(const uint8_t* ring_base, uint32_t ring_bytes, uint32_t read_index,
+                     uint32_t write_index) {
+    ++stats_.primaries;
+    EmitSimple(kOpPrimaryBegin, 0);
+    GuestReader reader;
+    reader.base = ring_base;
+    reader.capacity = ring_bytes;
+    reader.offset = (read_index * 4) % ring_bytes;
+    const uint32_t write_offset = (write_index * 4) % ring_bytes;
+    reader.remaining = reader.offset <= write_offset ? write_offset - reader.offset
+                                                     : ring_bytes - reader.offset + write_offset;
+    do {
+      if (!Packet(reader, 0)) break;  // as before: the rest of this part is skipped
+    } while (reader.remaining);
+    EmitSimple(kOpPrimaryEnd, 0);
+    EmitSimple(kOpReadPointer, write_index);
+    Publish();
+  }
+
+  // Ends the open packets op and makes everything visible.
+  void Publish() {
+    ClosePackets();
+    const uint64_t before = ring_.published();
+    ring_.Publish();
+    if (ring_.published() != before) ++publishes_;
+  }
+  uint64_t publishes() const { return publishes_; }
+
+  // The packet at the reader (ExecutePacket). False: the buffer ends here, as it did.
+  bool Packet(GuestReader& reader, int depth) {
+    if (aborted_ || reader.remaining < 4) return false;
+    const uint32_t header_raw = reader.PeekRaw(0);
+    const uint32_t packet = Swap(header_raw);
+    ++stats_.packets;
+    if (!packet || packet == 0x0BADF00D) {
+      reader.Skip(1);  // a bad packet: nothing done
+      return true;
+    }
+    const uint32_t type = packet >> 30;
+    if (type == 2) {
+      reader.Skip(1);
+      return true;
+    }
+    if (type == 1) {
+      if (reader.remaining < 12) return false;
+      Forward(reader, 3);  // two registers below 0x800, never constants
+      return true;
+    }
+    const uint32_t count = ((packet >> 16) & 0x3FFF) + 1;
+    if (reader.remaining - 4 < count * 4) {
+      reader.Skip(1);  // ExecutePacketType*_CountOverflow: false after the header
+      ++stats_.failed;
+      return false;
+    }
+    if (type == 0) {
+      const uint32_t base = packet & 0x7FFF;
+      if ((packet >> 15) & 1) {
+        // Every value to one register: rare, handed over as it is.
+        if (base >= kShadowFirst && base < kShadowFirst + kShadowCount) Forget(base, 1);
+        Forward(reader, 1 + count);
+        return true;
+      }
+      reader.Skip(1);
+      Registers(reader, base, count);
+      return true;
+    }
+    // Type 3.
+    const uint32_t opcode = (packet >> 8) & 0x7F;
+    if (packet & 1) {
+      if (!(bin_select_ & bin_mask_) || opcode == pm4::kXeSwap) {
+        reader.Skip(1 + count);
+        ++stats_.predicated_out;
+        return true;
+      }
+    }
+    switch (opcode) {
+      case pm4::kIndirectBuffer:
+      case pm4::kIndirectBufferPfd: {
+        reader.Skip(1);
+        const uint32_t list_ptr = reader.Read() & 0x1FFFFFFF;  // CpuToGpu
+        const uint32_t list_length = reader.Read() & 0xFFFFF;
+        ++stats_.indirect_buffers;
+        if (list_length) {
+          if (OverlapsPendingWrite(list_ptr, list_length * 4)) {
+            Drain(kSerializeIbWrite);
+          }
+          GuestReader indirect;
+          indirect.base = host_.Translate(list_ptr);
+          indirect.capacity = list_length * 4;
+          indirect.offset = 0;
+          indirect.remaining = list_length * 4;
+          do {
+            if (!Packet(indirect, depth + 1)) break;  // up a level, as before
+          } while (indirect.remaining);
+        }
+        // The handler reads two dwords; any more are read as packets after the buffer, as before
+        // (by the GPU thread, from the op).
+        if (count > 2) Forward(reader, count - 2);
+        return true;
+      }
+      case pm4::kWaitRegMem:
+        // Executed before anything after it is decoded: its condition may depend on what the
+        // stream wrote, and the guest may be waiting for the GPU to get here.
+        Forward(reader, 1 + count);
+        Drain(kSerializeWait);
+        return true;
+      case pm4::kSetBinMaskLo:
+        bin_mask_ = (bin_mask_ & 0xFFFFFFFF00000000ull) | reader.Peek(1);
+        break;
+      case pm4::kSetBinMaskHi:
+        bin_mask_ = (bin_mask_ & 0xFFFFFFFFull) | (uint64_t(reader.Peek(1)) << 32);
+        break;
+      case pm4::kSetBinSelectLo:
+        bin_select_ = (bin_select_ & 0xFFFFFFFF00000000ull) | reader.Peek(1);
+        break;
+      case pm4::kSetBinSelectHi:
+        bin_select_ = (bin_select_ & 0xFFFFFFFFull) | (uint64_t(reader.Peek(1)) << 32);
+        break;
+      case pm4::kSetBinMask:
+        if (count >= 2) bin_mask_ = (uint64_t(reader.Peek(1)) << 32) | reader.Peek(2);
+        break;
+      case pm4::kSetBinSelect:
+        if (count >= 2) bin_select_ = (uint64_t(reader.Peek(1)) << 32) | reader.Peek(2);
+        break;
+      case pm4::kSetConstant: {
+        const uint32_t offset_type = reader.Peek(1);
+        const uint32_t index = offset_type & 0x7FF;
+        static const uint32_t kBases[5] = {0x4000, 0x4800, 0x4900, 0x4908, 0x2000};
+        const uint32_t constant_type = (offset_type >> 16) & 0xFF;
+        if (constant_type > 4) break;  // handed over: the handler skips it
+        reader.Skip(2);
+        Registers(reader, kBases[constant_type] + index, count - 1);
+        return true;
+      }
+      case pm4::kSetConstant2:
+      case pm4::kSetShaderConstants: {
+        const uint32_t index = reader.Peek(1) & 0xFFFF;
+        reader.Skip(2);
+        Registers(reader, index, count - 1);
+        return true;
+      }
+      case pm4::kLoadAluConstant: {
+        // Constants from memory, read by the handler: forgotten here, written there.
+        const uint32_t offset_type = count >= 2 ? reader.Peek(2) : 0;
+        const uint32_t size = count >= 3 ? reader.Peek(3) & 0xFFF : 0;
+        static const uint32_t kBases[5] = {0x4000, 0x4800, 0x4900, 0x4908, 0x2000};
+        const uint32_t constant_type = (offset_type >> 16) & 0xFF;
+        if (constant_type <= 4) Forget(kBases[constant_type] + (offset_type & 0x7FF), size);
+        break;
+      }
+      case pm4::kRegRmw:
+        // May write any register: the shadow constants are forgotten.
+        ResetShadow();
+        ++stats_.shadow_resets;
+        break;
+      case pm4::kCondWrite:
+      case pm4::kMemWrite:
+      case pm4::kRegToMem:
+      case pm4::kEventWriteShd:
+      case pm4::kEventWriteExt: {
+        // Memory writes: noted with the op they are in, for the indirect buffers after them.
+        uint32_t address = 0, bytes = 4;
+        bool known = true;
+        if (opcode == pm4::kCondWrite) {
+          ResetShadow();  // may write a register instead
+          ++stats_.shadow_resets;
+          known = count >= 5;
+          if (known) address = reader.Peek(5);
+        } else if (opcode == pm4::kMemWrite) {
+          address = reader.Peek(1);
+          bytes = (count - 1) * 4;
+        } else {
+          known = count >= 2;
+          if (known) address = reader.Peek(2);
+          if (opcode == pm4::kEventWriteExt) bytes = 12;
+        }
+        Forward(reader, 1 + count);
+        if (known) NotePendingWrite(address, bytes);
+        return true;
+      }
+      case pm4::kDrawIndx:
+      case pm4::kDrawIndx2: {
+        ++stats_.draws;
+        if (DrawFails(opcode, count, reader)) {
+          return Fail(reader, count);
+        }
+        Forward(reader, 1 + count);
+        // Let the GPU thread start on what is decoded, a few KiB at a time.
+        if (ring_.write_position() + (open_ ? OpSpan(open_->bytes) : 0) >=
+            ring_.published() + kPublishBytes) {
+          Publish();
+        }
+        return true;
+      }
+      case pm4::kImLoad:
+      case pm4::kImLoadImmediate: {
+        const uint32_t dword0 = reader.Peek(1);
+        const uint32_t shader_type = opcode == pm4::kImLoad ? (dword0 & 0x3) : dword0;
+        if (shader_type > 1) return Fail(reader, count);
+        Forward(reader, 1 + count);
+        return true;
+      }
+      case pm4::kXeSwap:
+        ++stats_.swaps;
+        Forward(reader, 1 + count);
+        Publish();
+        return true;
+      default:
+        if (!pm4::Known(opcode)) {
+          // HitUnimplementedOpcode: the handler logs it and the buffer ends.
+          return Fail(reader, count);
+        }
+        break;
+    }
+    Forward(reader, 1 + count);
+    return true;
+  }
+
+  // Whether the FIFO ran out of room while stopping: nothing more is decoded.
+  bool aborted() const { return aborted_; }
+  // Whether the shadow holds `index` (for the check).
+  bool ShadowValid(uint32_t index) const {
+    const uint32_t i = index - kShadowFirst;
+    return i < kShadowCount && ((valid_[i >> 6] >> (i & 63)) & 1);
+  }
+
+ private:
+  static bool DrawFails(uint32_t opcode, uint32_t count, const GuestReader& reader) {
+    // ExecutePacketType3Draw's "Packet too small" cases.
+    uint32_t remaining = count;
+    uint32_t at = 1;
+    if (opcode == pm4::kDrawIndx) {
+      --remaining;  // the VIZ query token
+      ++at;
+    }
+    if (!remaining) return true;
+    const uint32_t initiator = reader.Peek(at);
+    --remaining;
+    const uint32_t source_select = (initiator >> 6) & 0x3;
+    if (source_select == 0 /* kDMA */ && remaining < 2) return true;
+    return false;
+  }
+
+  // A packet whose handler returns false: handed over, last in its op (the GPU thread stops
+  // executing its op there, as ExecutePrimaryBuffer and ExecuteIndirectBuffer stopped), and the
+  // buffer ends here too.
+  bool Fail(GuestReader& reader, uint32_t count) {
+    Forward(reader, 1 + count);
+    ClosePackets();
+    ++stats_.failed;
+    return false;
+  }
+  void ResetShadow() { std::memset(valid_, 0, sizeof(valid_)); }
+  void Forget(uint32_t first, uint32_t count) {
+    for (uint32_t index = first; index < first + count; ++index) {
+      const uint32_t i = index - kShadowFirst;
+      if (i < kShadowCount) valid_[i >> 6] &= ~(uint64_t(1) << (i & 63));
+    }
+  }
+
+  void Drain(uint32_t reason) {
+    Publish();
+    ++stats_.serialize[reason];
+    host_.Drain(reason);
+  }
+  bool Reserve(uint32_t payload_bytes) {
+    if (aborted_) return false;
+    if (ring_.RoomNeeded(payload_bytes)) {
+      Publish();
+      ++stats_.serialize[kSerializeRoom];
+      if (!host_.MakeRoom(payload_bytes) || ring_.RoomNeeded(payload_bytes)) {
+        aborted_ = true;
+        return false;
+      }
+    }
+    return true;
+  }
+  void ClosePackets() {
+    if (!open_) return;
+    ring_.Commit();
+    open_ = nullptr;
+  }
+  void EmitSimple(uint32_t kind, uint32_t arg) {
+    ClosePackets();
+    if (!Reserve(0)) return;
+    ring_.Begin(kind, 0, arg);
+    ring_.Commit();
+    ++stats_.ops;
+    stats_.op_bytes += OpSpan(0);
+  }
+  // `dwords` raw dwords at the reader (whole packets) into the open packets op.
+  void Forward(GuestReader& reader, uint32_t dwords) {
+    const uint32_t bytes = dwords * 4;
+    ++stats_.forwarded_packets;
+    if (open_ && open_->bytes + bytes > kPacketsOpBytes) {
+      Publish();
+    }
+    if (!open_) {
+      // Room for the largest this op can grow to.
+      const uint32_t limit = std::max(bytes, kPacketsOpBytes);
+      if (!Reserve(limit)) {
+        reader.Skip(dwords);
+        return;
+      }
+      open_ = ring_.Begin(kOpPackets, limit);
+      ++stats_.ops;
+    }
+    reader.CopyRaw(ring_.Payload(open_) + open_->bytes, dwords);
+    ring_.Grow(bytes);
+    stats_.op_bytes += bytes;
+  }
+  // A run of `count` register values at the reader from register `base`: the unchanged shader
+  // constants are dropped, the rest handed over in runs.
+  void Registers(GuestReader& reader, uint32_t base, uint32_t count) {
+    ClosePackets();
+    stats_.registers_written += count;
+    uint32_t index = base;
+    uint32_t left = count;
+    while (left) {
+      // Skip the unchanged constants at the start.
+      if (filter_) {
+        while (left) {
+          const uint32_t raw = reader.PeekRaw(0);
+          if (!Unchanged(index, raw)) break;
+          reader.Skip(1);
+          ++index;
+          --left;
+          ++stats_.registers_dropped;
+        }
+        if (!left) break;
+      }
+      // A run up to the next unchanged constant.
+      if (!Reserve(left * 4)) {
+        reader.Skip(left);
+        return;
+      }
+      OpHeader* op = ring_.Begin(kOpRegisters, left * 4, index);
+      uint8_t* out = ring_.Payload(op);
+      uint32_t run = 0;
+      while (left) {
+        const uint32_t raw = reader.PeekRaw(0);
+        if (filter_ && run && Unchanged(index, raw)) break;
+        Learn(index, raw);
+        std::memcpy(out + run * 4, &raw, 4);
+        reader.Skip(1);
+        ++index;
+        --left;
+        ++run;
+      }
+      ring_.Grow(run * 4);
+      ring_.Commit();
+      ++stats_.ops;
+      ++stats_.register_runs;
+      stats_.op_bytes += OpSpan(run * 4);
+    }
+  }
+  bool Unchanged(uint32_t index, uint32_t raw) const {
+    if (!Filterable(index)) return false;
+    const uint32_t i = index - kShadowFirst;
+    return ((valid_[i >> 6] >> (i & 63)) & 1) && shadow_[i] == raw;
+  }
+  void Learn(uint32_t index, uint32_t raw) {
+    const uint32_t i = index - kShadowFirst;
+    if (i >= kShadowCount || !Filterable(index)) return;
+    shadow_[i] = raw;
+    valid_[i >> 6] |= uint64_t(1) << (i & 63);
+  }
+
+  // Memory writes by packets not yet executed: the position where the op that holds them starts
+  // (the open op's, or the next one's). `retired` is always the end of an executed op, so once it
+  // is past that position the op has been executed.
+  void NotePendingWrite(uint32_t address, uint32_t bytes) {
+    if (!open_) return;  // aborted
+    PendingWrite& write = pending_[pending_next_++ % kPendingWrites];
+    write.position = ring_.write_position();  // where the open op starts
+    write.first = address & 0x1FFFFFFF;
+    write.last = write.first + (bytes ? bytes - 1 : 0);
+  }
+  bool OverlapsPendingWrite(uint32_t address, uint32_t bytes) {
+    const uint64_t retired = ring_.retired();
+    const size_t known = std::min<size_t>(pending_next_, kPendingWrites);
+    if (pending_next_ > kPendingWrites) {
+      // Older writes were overwritten: the oldest kept must be executed, else assume overlap.
+      const PendingWrite& oldest = pending_[pending_next_ % kPendingWrites];
+      if (oldest.position >= retired) return true;
+    }
+    const uint32_t first = address & 0x1FFFFFFF, last = first + bytes - 1;
+    for (size_t n = 0; n < known; ++n) {
+      const PendingWrite& write = pending_[n];
+      if (write.position < retired) continue;  // executed
+      if (write.first <= last && first <= write.last) return true;
+    }
+    return false;
+  }
+  struct PendingWrite {
+    uint64_t position = 0;
+    uint32_t first = 0, last = 0;
+  };
+
+  OpRing& ring_;
+  Host& host_;
+  bool filter_;
+  uint64_t bin_mask_, bin_select_;
+  OpHeader* open_ = nullptr;
+  bool aborted_ = false;
+  uint64_t publishes_ = 0;
+  uint32_t shadow_[kShadowCount] = {};
+  uint64_t valid_[(kShadowCount + 63) / 64] = {};
+  PendingWrite pending_[kPendingWrites];
+  size_t pending_next_ = 0;
+  DecodeStats stats_;
+};
