+bool VulkanCommandProcessor::RunParallelRecord() {
+  namespace fc = xbox360ps5::frame_cost;
+  parallel_record::Settings settings;
+  settings.mode = std::min<uint32_t>(cvars::gpu_parallel_record, parallel_record::kModes - 1);
+  settings.fifo_kib =
+      std::min<uint32_t>(std::max<uint32_t>(cvars::gpu_parallel_record_fifo_kib, 256), 65536);
+  settings.filter = cvars::gpu_parallel_record_filter ? 1 : 0;
+  settings.sibling = cvars::gpu_parallel_record_sibling ? 1 : 0;
+  const char* const path = XBOX360PS5_DATA_ROOT "/parallel-record.txt";
+  int not_understood = 0;
+  bool from_file = false;
+  if (FILE* file = std::fopen(path, "rb")) {
+    std::string text;
+    char chunk[1024];
+    size_t got;
+    while ((got = std::fread(chunk, 1, sizeof(chunk), file)) > 0) text.append(chunk, got);
+    std::fclose(file);
+    not_understood = parallel_record::Parse(text, settings);
+    from_file = true;
+  }
+  if (settings.mode == parallel_record::kOff) {
+    return false;
+  }
+  parallel_settings_ = settings;
+  const bool filter = settings.filter && cvars::vulkan_skip_redundant_constants;
+  fc::parallel_mode_now.store(settings.mode, std::memory_order_relaxed);
+  fc::parallel_fifo_kib_now.store(settings.fifo_kib, std::memory_order_relaxed);
+  fc::parallel_filter_now.store(filter ? 1 : 0, std::memory_order_relaxed);
+  XELOGW(
+      "Parallel record (fix 142): mode {} ({}), FIFO {} KiB, unchanged constants {}, decode "
+      "thread {}, from {}{}",
+      settings.mode, parallel_record::ModeName(settings.mode), settings.fifo_kib,
+      filter ? "dropped by the decoder" : "written",
+      settings.mode != parallel_record::kThread ? "none"
+      : settings.sibling                        ? "beside the GPU thread (CPU 3)"
+                                                : "on the shared CPUs",
+      from_file ? path : "the settings",
+      not_understood ? fmt::format(", {} lines not understood", not_understood) : std::string());
+  parallel_ring_ =
+      std::make_unique<parallel_record::OpRing>(size_t(settings.fifo_kib) * 1024);
+  parallel_host_ = std::make_unique<ParallelRecordHost>(*this);
+  parallel_decoder_ = std::make_unique<parallel_record::Decoder>(
+      *parallel_ring_, *parallel_host_, filter, bin_mask_, bin_select_);
+  if (settings.mode == parallel_record::kThread) {
+    parallel_front_thread_ = kernel::object_ref<kernel::XHostThread>(new kernel::XHostThread(
+        kernel_state_, 256 * 1024, 0,
+        [this]() {
+          ParallelFrontLoop();
+          return 0;
+        },
+        kernel_state_->GetIdleProcess()));
+    parallel_front_thread_->set_name("GPU Decode");
+    parallel_front_thread_->Create();
+    ParallelBackLoop();
+    parallel_front_thread_->Wait(0, 0, 0, nullptr);
+    parallel_front_thread_.reset();
+  } else {
+    ParallelInlineLoop();
+  }
+  XELOGW("Parallel record (fix 142): stopped");
+  parallel_decoder_.reset();
+  parallel_host_.reset();
+  parallel_ring_.reset();
+  return true;
+}
+
+// Mode 1, the decode thread: CommandProcessor::WorkerThreadMain's ring loop, decoding instead of
+// executing. It owns read_ptr_index_ from here on; the read pointer reaches the guest through
+// kOpReadPointer, once the GPU thread has executed what is before it.
+void VulkanCommandProcessor::ParallelFrontLoop() {
+  namespace fc = xbox360ps5::frame_cost;
+  if (parallel_settings_.sibling) {
+    xbox360ps5::PlaceCallingThreadBesideGpu();
+  }
+  XELOGW("Parallel record (fix 142): the decode thread started");
+  while (worker_running_) {
+    uint32_t write_ptr_index = write_ptr_index_.load();
+    if (write_ptr_index == 0xBAADF00D || read_ptr_index_ == write_ptr_index) {
+      parallel_decoder_->Publish();
+      parallel_front_idle_.store(true, std::memory_order_seq_cst);
+      parallel_ring_->Wake();
+      const uint64_t idle_start = fc::NowNs();
+      uint32_t loop_count = 0;
+      do {
+        if (loop_count > 500) {
+          xe::threading::Wait(write_ptr_index_event_.get(), true, std::chrono::milliseconds(2));
+        } else {
+          xe::threading::MaybeYield();
+        }
+        ++loop_count;
+        write_ptr_index = write_ptr_index_.load();
+      } while (worker_running_ &&
+               (write_ptr_index == 0xBAADF00D || read_ptr_index_ == write_ptr_index));
+      parallel_front_idle_.store(false, std::memory_order_seq_cst);
+      fc::parallel_ring_wait_ns.fetch_add(fc::NowNs() - idle_start, std::memory_order_relaxed);
+      continue;
+    }
+    xbox360ps5::cp_trace::Global().SetPointers(read_ptr_index_, write_ptr_index);
+    const uint64_t start = fc::NowNs();
+    const uint64_t waited_before = parallel_front_waited_ns_;
+    parallel_decoder_->DecodePrimary(memory_->TranslatePhysical(primary_buffer_ptr_),
+                                     primary_buffer_size_, read_ptr_index_, write_ptr_index);
+    const uint64_t spent = fc::NowNs() - start;
+    const uint64_t waited = parallel_front_waited_ns_ - waited_before;
+    fc::parallel_decode_ns.fetch_add(spent > waited ? spent - waited : 0,
+                                     std::memory_order_relaxed);
+    read_ptr_index_ = write_ptr_index;
+    FlushParallelStats();
+    if (parallel_decoder_->aborted()) break;
+  }
+  parallel_decoder_->Publish();
+  parallel_front_done_.store(true, std::memory_order_seq_cst);
+  parallel_ring_->Wake();
+}
+
+// Mode 1, the GPU thread: executes the ops in order. With nothing published it waits as the ring
+// loop did when the decode thread waits for the guest (PrepareForWait, fix 49's idle time, the
+// hang watch's idle mark), and only spins when the decode thread is still at work ("starved").
+void VulkanCommandProcessor::ParallelBackLoop() {
+  namespace fc = xbox360ps5::frame_cost;
+  bool prepared = false;
+  for (;;) {
+    while (!pending_fns_.empty()) {
+      auto fn = std::move(pending_fns_.front());
+      pending_fns_.pop();
+      fn();
+    }
+    const parallel_record::OpHeader* op = parallel_ring_->Front();
+    if (!op) {
+      if (parallel_front_done_.load(std::memory_order_seq_cst)) {
+        if (!parallel_ring_->Front()) break;
+        continue;
+      }
+      const uint64_t wait_start = fc::NowNs();
+      if (parallel_front_idle_.load(std::memory_order_seq_cst)) {
+        if (!prepared) {
+          PrepareForWait();
+          prepared = true;
+        } else if (zpd_mode_ == ZPDMode::kStrict && zpd_awaited_report_count_) {
+          PrepareForWait();
+        }
+        xbox360ps5::hang_watch::gpu_thread.Mark(xbox360ps5::hang_watch::kGpuIdle);
+        parallel_ring_->WaitForOps(std::chrono::microseconds(2000), 200);
+        const uint64_t waited = fc::NowNs() - wait_start;
+        fc::parallel_idle_ns.fetch_add(waited, std::memory_order_relaxed);
+        fc::totals.idle_ns.fetch_add(waited, std::memory_order_relaxed);
+      } else {
+        parallel_ring_->WaitForOps(std::chrono::microseconds(200), 4000);
+        const uint64_t waited = fc::NowNs() - wait_start;
+        fc::parallel_starved_ns.fetch_add(waited, std::memory_order_relaxed);
+        fc::totals.idle_ns.fetch_add(waited, std::memory_order_relaxed);
+      }
+      continue;
+    }
+    if (prepared) {
+      ReturnFromWait();
+      prepared = false;
+    }
+    xbox360ps5::hang_watch::gpu_thread.Mark(xbox360ps5::hang_watch::kGpuExecute);
+    const uint64_t start = fc::NowNs();
+    do {
+      ExecuteParallelOp(*op, parallel_ring_->Payload(op));
+      parallel_ring_->Pop();
+    } while (pending_fns_.empty() && (op = parallel_ring_->Front()));
+    const uint64_t spent = fc::NowNs() - start;
+    fc::parallel_execute_ns.fetch_add(spent, std::memory_order_relaxed);
+    fc::totals.execute_ns.fetch_add(spent, std::memory_order_relaxed);
+  }
+  if (prepared) {
+    ReturnFromWait();
+  }
+}
+
+// Mode 2: WorkerThreadMain's loop with each part of the ring decoded into ops and the ops then
+// executed, on the GPU thread alone (WAIT_REG_MEM and a full FIFO execute what is decoded).
+void VulkanCommandProcessor::ParallelInlineLoop() {
+  namespace fc = xbox360ps5::frame_cost;
+  while (worker_running_) {
+    while (!pending_fns_.empty()) {
+      auto fn = std::move(pending_fns_.front());
+      pending_fns_.pop();
+      fn();
+    }
+    uint32_t write_ptr_index = write_ptr_index_.load();
+    xbox360ps5::cp_trace::Global().SetPointers(read_ptr_index_, write_ptr_index);
+    if (write_ptr_index == 0xBAADF00D || read_ptr_index_ == write_ptr_index) {
+      PrepareForWait();
+      const uint64_t idle_start = fc::NowNs();
+      uint32_t loop_count = 0;
+      do {
+        if (loop_count > 500) {
+          xe::threading::Wait(write_ptr_index_event_.get(), true, std::chrono::milliseconds(2));
+          if (zpd_mode_ == ZPDMode::kStrict && zpd_awaited_report_count_) {
+            PrepareForWait();
+          }
+        } else {
+          xe::threading::MaybeYield();
+        }
+        xbox360ps5::hang_watch::gpu_thread.Mark(xbox360ps5::hang_watch::kGpuIdle);
+        ++loop_count;
+        write_ptr_index = write_ptr_index_.load();
+      } while (worker_running_ && pending_fns_.empty() &&
+               (write_ptr_index == 0xBAADF00D || read_ptr_index_ == write_ptr_index));
+      const uint64_t idle = fc::NowNs() - idle_start;
+      fc::totals.idle_ns.fetch_add(idle, std::memory_order_relaxed);
+      fc::parallel_idle_ns.fetch_add(idle, std::memory_order_relaxed);
+      ReturnFromWait();
+      if (!worker_running_ || !pending_fns_.empty()) {
+        continue;
+      }
+    }
+    xbox360ps5::hang_watch::gpu_thread.Mark(xbox360ps5::hang_watch::kGpuExecute);
+    const uint64_t start = fc::NowNs();
+    const uint64_t waited_before = parallel_front_waited_ns_;
+    parallel_decoder_->DecodePrimary(memory_->TranslatePhysical(primary_buffer_ptr_),
+                                     primary_buffer_size_, read_ptr_index_, write_ptr_index);
+    const uint64_t decoded = fc::NowNs();
+    const uint64_t executed_inside = parallel_front_waited_ns_ - waited_before;
+    const uint64_t decode_ns = decoded - start;
+    fc::parallel_decode_ns.fetch_add(decode_ns > executed_inside ? decode_ns - executed_inside : 0,
+                                     std::memory_order_relaxed);
+    ExecuteParallelOps();
+    fc::totals.execute_ns.fetch_add(fc::NowNs() - start, std::memory_order_relaxed);
+    read_ptr_index_ = write_ptr_index;
+    FlushParallelStats();
+  }
+}
+
+void VulkanCommandProcessor::ExecuteParallelOps() {
+  namespace fc = xbox360ps5::frame_cost;
+  const uint64_t start = fc::NowNs();
+  while (const parallel_record::OpHeader* op = parallel_ring_->Front()) {
+    ExecuteParallelOp(*op, parallel_ring_->Payload(op));
+    parallel_ring_->Pop();
+  }
+  fc::parallel_execute_ns.fetch_add(fc::NowNs() - start, std::memory_order_relaxed);
+}
+
+// An op does what the packets it stands for did (ExecutePrimaryBuffer, ExecutePacket and fix
+// 103's runs).
+void VulkanCommandProcessor::ExecuteParallelOp(const parallel_record::OpHeader& op,
+                                               const uint8_t* payload) {
+  switch (op.kind) {
+    case parallel_record::kOpPackets: {
+      if (!op.bytes) break;
+      RingBuffer old_reader = reader_;
+      new (&reader_) RingBuffer(const_cast<uint8_t*>(payload), op.bytes);
+      reader_.set_write_offset(op.bytes);
+      do {
+        if (!ExecutePacket()) {
+          // The decoder ended its buffer after this packet too.
+          break;
+        }
+      } while (reader_.read_count());
+      reader_ = old_reader;
+    } break;
+    case parallel_record::kOpRegisters:
+      WriteRegistersSwapped(op.arg, reinterpret_cast<const uint32_t*>(payload), op.bytes / 4);
+      break;
+    case parallel_record::kOpPrimaryBegin:
+      ++xbox360ps5::frame_cost::command_chunk_epoch;  // fix 87
+      CheckContentUnits();                            // fix 125
+      break;
+    case parallel_record::kOpPrimaryEnd:
+      OnPrimaryBufferEnd();
+      break;
+    case parallel_record::kOpReadPointer:
+      if (read_ptr_writeback_ptr_) {
+        xe::store_and_swap<uint32_t>(memory_->TranslatePhysical(read_ptr_writeback_ptr_),
+                                     op.arg);
+      }
+      break;
+    default:
+      break;
+  }
+}
+
+// The decoder waits for every published op to be executed (WAIT_REG_MEM, an indirect buffer over
+// a pending memory write): mode 1 waits for the GPU thread, mode 2 executes them here.
+void VulkanCommandProcessor::ParallelDrain(uint32_t reason) {
+  namespace fc = xbox360ps5::frame_cost;
+  const uint64_t start = fc::NowNs();
+  if (parallel_settings_.mode == parallel_record::kInline) {
+    ExecuteParallelOps();
+  } else {
+    parallel_ring_->WaitRetired(parallel_ring_->published(),
+                                [this]() { return !worker_running_; });
+  }
+  const uint64_t waited = fc::NowNs() - start;
+  parallel_front_waited_ns_ += waited;
+  fc::parallel_drain_wait_ns.fetch_add(waited, std::memory_order_relaxed);
+}
+
+bool VulkanCommandProcessor::ParallelMakeRoom(uint32_t payload_bytes) {
+  namespace fc = xbox360ps5::frame_cost;
+  const uint64_t start = fc::NowNs();
+  bool room = true;
+  if (parallel_settings_.mode == parallel_record::kInline) {
+    ExecuteParallelOps();
+  } else {
+    room = parallel_ring_->WaitRoom(payload_bytes, [this]() { return !worker_running_; });
+  }
+  const uint64_t waited = fc::NowNs() - start;
+  parallel_front_waited_ns_ += waited;
+  fc::parallel_room_wait_ns.fetch_add(waited, std::memory_order_relaxed);
+  return room;
+}
+
+void VulkanCommandProcessor::FlushParallelStats() {
+  namespace fc = xbox360ps5::frame_cost;
+  const parallel_record::DecodeStats& now = parallel_decoder_->stats();
+  parallel_record::DecodeStats& last = parallel_stats_flushed_;
+  const auto add = [](std::atomic<uint64_t>& counter, uint64_t now_value, uint64_t& last_value) {
+    if (now_value != last_value) {
+      counter.fetch_add(now_value - last_value, std::memory_order_relaxed);
+      last_value = now_value;
+    }
+  };
+  add(fc::parallel_packets, now.packets, last.packets);
+  add(fc::parallel_forwarded, now.forwarded_packets, last.forwarded_packets);
+  add(fc::parallel_predicated, now.predicated_out, last.predicated_out);
+  add(fc::parallel_runs, now.register_runs, last.register_runs);
+  add(fc::parallel_registers, now.registers_written, last.registers_written);
+  add(fc::parallel_dropped, now.registers_dropped, last.registers_dropped);
+  add(fc::parallel_resets, now.shadow_resets, last.shadow_resets);
+  add(fc::parallel_indirect, now.indirect_buffers, last.indirect_buffers);
+  add(fc::parallel_draws, now.draws, last.draws);
+  add(fc::parallel_primaries, now.primaries, last.primaries);
+  add(fc::parallel_failed, now.failed, last.failed);
+  add(fc::parallel_ops, now.ops, last.ops);
+  add(fc::parallel_op_bytes, now.op_bytes, last.op_bytes);
+  for (uint32_t n = 0; n < parallel_record::kSerializeReasons; ++n) {
+    add(fc::parallel_serialize[n], now.serialize[n], last.serialize[n]);
+  }
+  static uint64_t publishes_flushed = 0;
+  const uint64_t publishes = parallel_decoder_->publishes();
+  fc::parallel_publishes.fetch_add(publishes - publishes_flushed, std::memory_order_relaxed);
+  publishes_flushed = publishes;
+  // How far ahead the decoder is: decoded and not yet executed.
+  const uint64_t ahead = parallel_ring_->published() - parallel_ring_->retired();
+  fc::parallel_ahead_sum.fetch_add(ahead, std::memory_order_relaxed);
+  fc::parallel_ahead_samples.fetch_add(1, std::memory_order_relaxed);
+  if (ahead > fc::parallel_ahead_max.load(std::memory_order_relaxed)) {
+    fc::parallel_ahead_max.store(ahead, std::memory_order_relaxed);
+  }
+}
