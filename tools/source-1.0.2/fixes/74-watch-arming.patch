+// Fix 74: what arming a write watch costs, by alias of physical memory. Memory::
+// EnablePhysicalMemoryAccessCallbacks (MakeRangeValid's last step, fix 62's "marking valid":
+// Modern Warfare 2 248 ms/s on 1.0.4_candidate_31) calls PhysicalHeap::EnableAccessCallbacks on
+// each of the four views of physical memory (0xA0000000, 0xC0000000, 0xE0000000, 0x7F000000);
+// each takes the global critical region and protects the pages that view has. Counted on the GPU
+// thread: calls, protection calls (xe::memory::Protect), the time in the call and the part of it
+// spent waiting for the lock, per view.
+inline constexpr uint32_t kAliases = 4;
+inline const char* AliasName(uint32_t alias) {
+  static const char* const names[] = {"A0000000", "C0000000", "E0000000", "7F000000"};
+  return alias < kAliases ? names[alias] : "?";
+}
+inline uint32_t AliasOf(uint32_t heap_base) {
+  switch (heap_base) {
+    case 0xA0000000u: return 0;
+    case 0xC0000000u: return 1;
+    case 0xE0000000u: return 2;
+    case 0x7F000000u: return 3;
+    default: return kAliases;
+  }
+}
+inline std::array<std::atomic<uint64_t>, kAliases> alias_calls{}, alias_protects{}, alias_ticks{}, alias_lock_ticks{};
+// Write notices per view (PhysicalHeap::TriggerCallbacks with is_write: a guest write fault on a
+// watched page, or the emulator lifting a watch before writing), from any thread.
+inline std::array<std::atomic<uint64_t>, kAliases> alias_write_notices{};
+inline void NoteWriteNotice(uint32_t heap_base) {
+  const uint32_t alias = AliasOf(heap_base);
+  if (alias < kAliases) alias_write_notices[alias].fetch_add(1, std::memory_order_relaxed);
+}
+class ArmTimer;
+inline thread_local ArmTimer* current_arm = nullptr;  // the calling thread's arming in progress
+class ArmTimer {
+ public:
+  explicit ArmTimer(uint32_t heap_base) : alias_(AliasOf(heap_base)), active_(gpu_thread && alias_ < kAliases) {
+    if (!active_) return;
+    start_ = Ticks();
+    previous_ = current_arm;
+    current_arm = this;
+  }
+  ~ArmTimer() {
+    if (!active_) return;
+    current_arm = previous_;
+    AddOwn(alias_calls[alias_], 1);  // the GPU thread's own counters
+    AddOwn(alias_ticks[alias_], Ticks() - start_);
+  }
+  // Right after the global critical region was taken.
+  void Locked() {
+    if (active_) AddOwn(alias_lock_ticks[alias_], Ticks() - start_);
+  }
+  // One protection call made.
+  void Protected() {
+    if (active_) AddOwn(alias_protects[alias_], 1);
+  }
+  ArmTimer(const ArmTimer&) = delete;
+  ArmTimer& operator=(const ArmTimer&) = delete;
+
+ private:
+  uint32_t alias_;
+  bool active_;
+  uint64_t start_ = 0;
+  ArmTimer* previous_ = nullptr;
+};
+// "Frame time watch arming (GPU thread) by view: A0000000 n calls/s, p protections/s, x ms/s
+// (lock y ms/s); ..." since its previous line.
+class ArmReporter {
+ public:
+  std::string Line(double seconds) {
+    const uint64_t ticks_now = Ticks(), ns_now = NowNs();
+    double ns_per_tick = last_ns_per_tick_ > 0 ? last_ns_per_tick_ : 1.0;
+    if (last_ticks_ && ticks_now > last_ticks_ && ns_now > last_ns_)
+      ns_per_tick = double(ns_now - last_ns_) / double(ticks_now - last_ticks_);
+    last_ns_per_tick_ = ns_per_tick;
+    last_ticks_ = ticks_now;
+    last_ns_ = ns_now;
+    const double s = seconds > 0 ? seconds : 1;
+    std::string parts;
+    for (uint32_t a = 0; a < kAliases; ++a) {
+      const uint64_t calls = alias_calls[a].load(std::memory_order_relaxed);
+      const uint64_t protects = alias_protects[a].load(std::memory_order_relaxed);
+      const uint64_t ticks = alias_ticks[a].load(std::memory_order_relaxed);
+      const uint64_t lock = alias_lock_ticks[a].load(std::memory_order_relaxed);
+      const uint64_t notices = alias_write_notices[a].load(std::memory_order_relaxed);
+      char item[192];
+      std::snprintf(item, sizeof(item),
+                    "%s%s %.0f calls/s, %.0f protections/s, %.1f ms/s (lock %.1f ms/s), %.0f write notices/s",
+                    a ? "; " : "", AliasName(a), double(calls - last_[a][0]) / s, double(protects - last_[a][1]) / s,
+                    double(ticks - last_[a][2]) * ns_per_tick / 1e6 / s, double(lock - last_[a][3]) * ns_per_tick / 1e6 / s,
+                    double(notices - last_[a][4]) / s);
+      last_[a][0] = calls;
+      last_[a][1] = protects;
+      last_[a][2] = ticks;
+      last_[a][3] = lock;
+      last_[a][4] = notices;
+      parts += item;
+    }
+    return "Frame time watch arming (GPU thread) by view: " + parts;
+  }
+
+ private:
+  std::array<std::array<uint64_t, 5>, kAliases> last_{};
+  uint64_t last_ticks_ = 0, last_ns_ = 0;
+  double last_ns_per_tick_ = 0;
+};
