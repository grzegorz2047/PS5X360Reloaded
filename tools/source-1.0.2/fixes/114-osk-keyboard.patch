+// The capital of a key's letter; anything else as it is. Turkish dotless i gives the dotted
+// capital I (the plain I is on the letters page), the ordinal sign its feminine form.
+inline char16_t Upper(char16_t c) {
+  if (c >= 'a' && c <= 'z') return char16_t(c - 32);
+  if (c >= 0xe0 && c <= 0xfe && c != 0xf7) return char16_t(c - 32);
+  if (c == 0xff) return 0x178;
+  if (c == 0x131) return 0x130;
+  if (c == 0xba) return 0xaa;
+  if (c >= 0x100 && c <= 0x17f) {
+    // Latin Extended-A pairs a capital with the small letter after it; in 0x139-0x148 and
+    // 0x179-0x17e the capital is the odd one.
+    const bool odd_capital = (c >= 0x139 && c <= 0x148) || (c >= 0x179 && c <= 0x17e);
+    if (odd_capital ? !(c & 1) : (c & 1)) return char16_t(c - 1);
+    return c;
+  }
+  if (c >= 0x430 && c <= 0x44f) return char16_t(c - 32);
+  if (c == 0x451) return 0x401;
+  return c;
+}
+inline const ActionKey& ActionAt(int column) {
+  for (const auto& key : kActions)
+    if (column >= key.column && column < key.column + key.span) return key;
+  return kActions[0];
+}
