+// Fix 114: what XamShowKeyboardUI tells the game when the keyboard closes (Win32 codes, as XAM
+// gives them; xam_ui.cc checks they are its X_ERROR_* values).
+namespace codes {
+constexpr uint32_t kSuccess = 0, kInvalidParameter = 0x57, kCancelled = 0x4c7,
+                   kCancelledHresult = 0x800704c7;  // HRESULT_FROM_WIN32(ERROR_CANCELLED)
+}
+struct Completion {
+  uint32_t result, extended_error;
+  bool write_text;      // the text goes into the game's buffer (never on Cancel)
+  bool cancel_request;  // complete the XOVERLAPPED as cancelled (KernelState::CancelOverlapped)
+};
+// Done: success, the text written. Cancel: ERROR_CANCELLED, the buffer untouched; through an
+// XOVERLAPPED its result is ERROR_CANCELLED and its extended error the HRESULT, as the kernel
+// writes for a request the game cancels. Done with a buffer the game freed meanwhile: invalid.
+inline Completion CompletionOf(Result result, bool asynchronous, bool buffer_writable) {
+  if (result != Result::accepted)
+    return {codes::kCancelled, asynchronous ? codes::kCancelledHresult : codes::kCancelled,
+            false, asynchronous};
+  if (!buffer_writable) return {codes::kInvalidParameter, codes::kInvalidParameter, false, false};
+  return {codes::kSuccess, codes::kSuccess, true, false};
+}
