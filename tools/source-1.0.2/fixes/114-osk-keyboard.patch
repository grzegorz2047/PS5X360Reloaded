+namespace flags {
+constexpr uint32_t kPhone = 0x00000008, kIpAddress = 0x00000010, kNumeric = 0x00000020,
+                   kPassword = 0x00000080, kRussian = 0x00008000, kSelectOk = 0x10000000,
+                   kHighlightText = 0x20000000;
