+namespace pad {
+constexpr uint32_t kOptions = 0x8, kUp = 0x10, kRight = 0x20, kDown = 0x40, kLeft = 0x80,
+                   kL2 = 0x100, kR2 = 0x200, kL1 = 0x400, kR1 = 0x800, kTriangle = 0x1000,
+                   kCircle = 0x2000, kCross = 0x4000, kSquare = 0x8000;
+constexpr uint32_t kDirections = kUp | kRight | kDown | kLeft;
