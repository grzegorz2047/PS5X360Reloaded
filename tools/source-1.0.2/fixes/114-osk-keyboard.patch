+enum class Page { letters, accents, symbols, cyrillic };
+constexpr int kPages = 4, kColumns = 10, kCharacterRows = 4, kRows = 5;
+// The last row: what each key does, the column it starts at and how many columns it spans.
+enum class Action { shift, page, space, erase, left, right, cancel, done };
+struct ActionKey { Action action; int column, span; };
+constexpr ActionKey kActions[] = {
+    {Action::shift, 0, 1}, {Action::page, 1, 1},  {Action::space, 2, 2},  {Action::erase, 4, 1},
+    {Action::left, 5, 1},  {Action::right, 6, 1}, {Action::cancel, 7, 1}, {Action::done, 8, 2}};
+constexpr int kActionCount = int(sizeof(kActions) / sizeof(kActions[0]));
