diff --git a/include/xbox360ps5/virtual_mic.hpp b/include/xbox360ps5/virtual_mic.hpp
new file mode 100644
--- /dev/null
+++ b/include/xbox360ps5/virtual_mic.hpp
@@ -0,0 +1,144 @@
+// SPDX-License-Identifier: MIT
+// Fix 178 (Harry Potter Kinect 57520826, issue 76): a virtual Kinect microphone array that is
+// there and hears silence.
+//
+// Harry Potter's audio manager (82796380, run every frame until it works) starts the Kinect audio
+// capture (the NUI audio library's start, 82BE43E0, flags 5). With fix 156f's "no microphone
+// array" (XamVoiceGetMicArrayAudioEx -> 0x8007048F) the start fails, and the title answers that
+// one error with XamShowNuiHardwareRequiredUI (82796534: any other error stops it on purpose),
+// then tries again: the "Kinect required" message never goes away (1.0.6-work-fix174, 23 dialogs).
+// A console's Kinect always has its microphones, so no title is written for a Kinect without them.
+//
+// The capture protocol, read from the NUI audio library (NUIAUD 2.0.21173.0; Zumba Fitness
+// Core's copy at 8254DDE8..8254F7E8, the same build as Harry Potter's):
+//  - The library owns two 0x68-byte requests (Zumba 82A6E510/82A6E578), each with its own
+//    event, and keeps one of them with the system at all times. A request names its buffers:
+//      +0x00 size 0x68; +0x04 the processed mono block (0x200 bytes); +0x08..+0x14 the four
+//      microphones (0x400 bytes each); +0x18..+0x28 those sizes; +0x40 the block's sequence (the
+//      16-bit render-driver tic it starts at); +0x44/+0x48 two floats (the beam's direction);
+//      +0x64 0x20.
+//    XamVoiceGetMicArrayAudioEx(request, event) hands one to the system, which fills it with
+//    16 ms of audio (3 render-driver tics of 5.33 ms) and sets the event.
+//  - XAudioRegisterRenderDriverMECClient({callback, arg}, &handle) registers the library's pump
+//    (8254DDE8), which the render driver calls every tic. The pump reads XAudioGetRenderDriverTic,
+//    XamVoiceGetMicArrayUnderrunStatus (a bit in 0x3 resets the capture), polls the request it
+//    waits for, and requires each completed block's sequence to be the previous one plus 3;
+//    it locks onto the stream when a block starts at a tic it noted (a tic divisible by 3), then
+//    hands the request back, copies the blocks into its rings and, with the echo canceller,
+//    takes the speakers' frame each tic (XAudioCaptureRenderDriverFrame: 256 samples of 6
+//    channels, 0x1800 bytes) and wakes its capture thread (8254E4D8), which feeds the speech
+//    library's audio source.
+// The virtual array: requests are queued; a pump thread follows the render-driver clock, and at
+// each tic divisible by 3 completes the oldest request as the block that started 3 tics before,
+// all zeros (silence), then calls the pump. The speakers' frame is zeros too.
+#pragma once
+#include <cstdint>
+#include <deque>
+#include <mutex>
+
+namespace xbox360ps5::virtual_mic {
+
+// The render driver's clock: 256 samples at 48 kHz.
+constexpr uint64_t kTicNanoseconds = 16000000 / 3;  // 5.333 ms
+constexpr uint32_t kTicsPerBlock = 3;                // 16 ms of 16 kHz audio
+constexpr uint32_t kSpeakerFrameBytes = 256 * 6 * 4;  // XAudioCaptureRenderDriverFrame
+
+// The request (all big-endian words).
+constexpr uint32_t kRequestSize = 0x68;
+constexpr uint32_t kBufferPointers = 0x04;  // 5 pointers: mono, then the 4 microphones
+constexpr uint32_t kBufferSizes = 0x18;     // their 5 sizes
+constexpr uint32_t kBufferCount = 5;
+constexpr uint32_t kSequence = 0x40;        // 16 bits
+constexpr uint32_t kBeam = 0x44;            // 2 floats
+constexpr uint32_t kLargestBuffer = 0x10000;
+
+inline uint32_t TicAt(uint64_t nanoseconds) { return uint32_t(nanoseconds / kTicNanoseconds); }
+inline uint64_t TicStart(uint32_t tic) { return uint64_t(tic) * kTicNanoseconds; }
+
+// A tic at which a block ends (the pump's own rule: the 16-bit tic divisible by 3).
+inline bool BlockEnds(uint32_t tic) { return (tic & 0xFFFF) % kTicsPerBlock == 0; }
+// The sequence of the block that ends at `tic`.
+inline uint16_t BlockSequence(uint32_t tic) { return uint16_t((tic - kTicsPerBlock) & 0xFFFF); }
+
+struct Request {
+  uint32_t request = 0;  // guest address
+  uint32_t event = 0;    // guest KEVENT
+};
+
+// Guest memory as the completion needs it.
+struct Memory {
+  virtual bool Read32(uint32_t address, uint32_t* value) = 0;
+  virtual bool Writable(uint32_t address, uint32_t size) = 0;
+  virtual void Zero(uint32_t address, uint32_t size) = 0;
+  virtual void Write16(uint32_t address, uint16_t value) = 0;
+  virtual void Write32(uint32_t address, uint32_t value) = 0;
+  virtual ~Memory() = default;
+};
+
+// A request the virtual array can fill: the right size, and each buffer writable at its size.
+inline bool ValidRequest(Memory& memory, uint32_t request) {
+  uint32_t size = 0;
+  if (!request || !memory.Read32(request, &size) || size != kRequestSize) return false;
+  if (!memory.Writable(request, kRequestSize)) return false;
+  for (uint32_t i = 0; i < kBufferCount; ++i) {
+    uint32_t pointer = 0, bytes = 0;
+    if (!memory.Read32(request + kBufferPointers + 4 * i, &pointer) ||
+        !memory.Read32(request + kBufferSizes + 4 * i, &bytes))
+      return false;
+    if (!pointer || !bytes || bytes > kLargestBuffer || !memory.Writable(pointer, bytes))
+      return false;
+  }
+  return true;
+}
+
+// Fill a request with a silent block: zero samples, the block's sequence, a centred beam.
+inline void CompleteSilent(Memory& memory, uint32_t request, uint16_t sequence) {
+  for (uint32_t i = 0; i < kBufferCount; ++i) {
+    uint32_t pointer = 0, bytes = 0;
+    if (memory.Read32(request + kBufferPointers + 4 * i, &pointer) &&
+        memory.Read32(request + kBufferSizes + 4 * i, &bytes) && pointer && bytes &&
+        bytes <= kLargestBuffer)
+      memory.Zero(pointer, bytes);
+  }
+  memory.Write16(request + kSequence, sequence);
+  memory.Write32(request + kBeam, 0);      // 0.0f
+  memory.Write32(request + kBeam + 4, 0);  // 0.0f
+}
+
+// The requests the title handed over, oldest first.
+class Queue {
+ public:
+  static constexpr size_t kMaxPending = 8;
+  bool Submit(Request request) {
+    std::lock_guard lock(mutex_);
+    if (pending_.size() >= kMaxPending) return false;
+    pending_.push_back(request);
+    return true;
+  }
+  // The request that completes at `tic`, if a block ends there.
+  bool Take(uint32_t tic, Request* out) {
+    std::lock_guard lock(mutex_);
+    if (!BlockEnds(tic) || pending_.empty()) return false;
+    *out = pending_.front();
+    pending_.pop_front();
+    return true;
+  }
+  void Clear() {
+    std::lock_guard lock(mutex_);
+    pending_.clear();
+  }
+  size_t size() {
+    std::lock_guard lock(mutex_);
+    return pending_.size();
+  }
+
+ private:
+  std::mutex mutex_;
+  std::deque<Request> pending_;
+};
+
+// The pump's checks on the blocks it gets (Zumba 8254DA08: the 16-bit difference, and 3 for
+// consecutive blocks; a lock onto the stream needs a block starting at a noted tic).
+inline int16_t SequenceDifference(uint16_t a, uint16_t b) { return int16_t(uint16_t(a - b)); }
+
+}  // namespace xbox360ps5::virtual_mic
