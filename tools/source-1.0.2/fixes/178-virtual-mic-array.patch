+// ---- Xbox360PS5 fix 178: the virtual Kinect microphone array (xbox360ps5/virtual_mic.hpp) ----
+// Harry Potter Kinect starts the Kinect audio capture every frame and shows "Kinect required"
+// until it works (issue 76). The NUI audio library hands its two microphone requests to
+// XamVoiceGetMicArrayAudioEx (xam_voice.cc), registers its pump as the render driver's echo
+// canceller client and expects the pump to be called every render-driver tic (5.33 ms), each
+// request to come back filled with 16 ms of audio (silence here) numbered by the tic its block
+// started at, and the speakers' frame on request.
+namespace {
+namespace vm = xbox360ps5::virtual_mic;
+
+class GuestMemory : public vm::Memory {
+ public:
+  bool Read32(uint32_t address, uint32_t* value) override {
+    if (!Allowed(address, 4, false)) return false;
+    *value = xe::load_and_swap<uint32_t>(kernel_memory()->TranslateVirtual(address));
+    return true;
+  }
+  bool Writable(uint32_t address, uint32_t size) override { return Allowed(address, size, true); }
+  void Zero(uint32_t address, uint32_t size) override {
+    std::memset(kernel_memory()->TranslateVirtual(address), 0, size);
+  }
+  void Write16(uint32_t address, uint16_t value) override {
+    xe::store_and_swap<uint16_t>(kernel_memory()->TranslateVirtual(address), value);
+  }
+  void Write32(uint32_t address, uint32_t value) override {
+    xe::store_and_swap<uint32_t>(kernel_memory()->TranslateVirtual(address), value);
+  }
+
+ private:
+  static bool Allowed(uint32_t address, uint32_t size, bool write) {
+    if (!address || uint64_t(address) + size > 0x100000000ull) return false;
+    for (uint64_t at = address; at < uint64_t(address) + size;
+         at = (at & ~uint64_t(4095)) + 4096) {
+      auto* heap = kernel_memory()->LookupHeap(uint32_t(at));
+      uint32_t protection = 0;
+      if (!heap || !heap->QueryProtect(uint32_t(at), &protection) ||
+          !(protection & kMemoryProtectRead) ||
+          (write && !(protection & kMemoryProtectWrite)))
+        return false;
+    }
+    return true;
+  }
+};
+
+constexpr uint32_t kMecHandle = 0x4D454301;  // "MEC" 1
+constexpr uint32_t kNotConnected = 0x8007048F;
+vm::Queue mic_requests;
+std::mutex mec_mutex;
+object_ref<XHostThread> mec_thread;
+std::atomic<uint32_t> mec_generation{0};
+std::atomic<bool> mec_running{false};
+std::atomic<uint32_t> mec_callback{0}, mec_callback_arg{0}, mec_title{0};
+std::atomic<uint32_t> driver_tic{0};
+const auto clock_start = std::chrono::steady_clock::now();
+
+uint64_t ClockNanoseconds() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                      std::chrono::steady_clock::now() - clock_start)
+                      .count());
+}
+void MicLog(const char* what, uint32_t a, uint32_t b) {
+  static std::atomic<uint32_t> shown{0};
+  if (shown.fetch_add(1) < 16)
+    XELOGW("Kinect microphone: {} ({:08X}, {:08X}) (fix 178)", what, a, b);
+}
+
+// The pump thread: follows the render-driver clock, completes the oldest request at each tic
+// that ends a block, and calls the library's pump once per tic.
+void MecPumpMain(uint32_t generation) {
+  uint32_t tic = vm::TicAt(ClockNanoseconds());
+  uint32_t completed = 0;
+  while (mec_running.load() && mec_generation.load() == generation &&
+         kernel_state()->title_id() == mec_title.load()) {
+    const uint64_t next = vm::TicStart(tic + 1), now = ClockNanoseconds();
+    if (next > now) xe::threading::Sleep(std::chrono::microseconds((next - now + 999) / 1000));
+    const uint32_t target = vm::TicAt(ClockNanoseconds());
+    // Late: catch up a few tics, then skip ahead (the pump resynchronises on its own).
+    if (target - tic > 6) tic = target - 6;
+    while (tic != target && mec_running.load() && mec_generation.load() == generation) {
+      ++tic;
+      driver_tic.store(tic);
+      vm::Request request;
+      if (mic_requests.Take(tic, &request)) {
+        GuestMemory memory;
+        vm::CompleteSilent(memory, request.request, vm::BlockSequence(tic));
+        if (auto event = XObject::GetNativeObject<XEvent>(
+                kernel_state(), kernel_memory()->TranslateVirtual(request.event)))
+          event->Set(0, false);
+        if (++completed == 1)
+          MicLog("first silent block delivered (request, event)", request.request,
+                 request.event);
+      }
+      uint64_t args[] = {mec_callback_arg.load()};
+      kernel_state()->processor()->Execute(XThread::GetCurrentThread()->thread_state(),
+                                           mec_callback.load(), args, 1);
+    }
+  }
+}
+}  // namespace
+
+// For xam_voice.cc (XamVoiceGetMicArrayAudioEx) and xam_nui.cc (fix 170's audio read rule).
+bool VirtualMicOn() {
+  return cvars::kinect_microphone && xbox360ps5::motion::enabled.load() &&
+         KinectRequiredTitle(kernel_state());
+}
+bool VirtualMicSubmit(uint32_t request, uint32_t event) {
+  GuestMemory memory;
+  if (!event || !vm::ValidRequest(memory, request)) return false;
+  return mic_requests.Submit({request, event});
+}
+
+dword_result_t XAudioRegisterRenderDriverMECClient_entry(lpdword_t callback_ptr,
+                                                         lpdword_t handle_ptr) {
+  if (!VirtualMicOn()) {
+    MicLog("XAudioRegisterRenderDriverMECClient: no microphone array (callback, result)",
+           callback_ptr.guest_address(), kNotConnected);
+    return kNotConnected;
+  }
+  if (!callback_ptr || !callback_ptr[0]) return X_E_INVALIDARG;
+  std::lock_guard lock(mec_mutex);
+  mec_callback.store(callback_ptr[0]);
+  mec_callback_arg.store(callback_ptr[1]);
+  mec_title.store(kernel_state()->title_id());
+  const uint32_t generation = mec_generation.fetch_add(1) + 1;
+  mec_running.store(true);
+  mec_thread = object_ref<XHostThread>(new XHostThread(
+      kernel_state(), 128 * 1024, 0,
+      [generation]() {
+        MecPumpMain(generation);
+        return 0;
+      },
+      kernel_state()->GetTitleProcess()));
+  mec_thread->set_name("Kinect Microphone Pump");
+  mec_thread->Create();
+  mec_thread->SetPriority(24);
+  if (handle_ptr) *handle_ptr = kMecHandle;
+  MicLog("XAudioRegisterRenderDriverMECClient: the pump runs every tic (callback, arg)",
+         callback_ptr[0], callback_ptr[1]);
+  return X_ERROR_SUCCESS;
+}
+DECLARE_XBOXKRNL_EXPORT1(XAudioRegisterRenderDriverMECClient, kAudio, kImplemented);
+
+dword_result_t XAudioUnregisterRenderDriverMECClient_entry(dword_t handle) {
+  std::lock_guard lock(mec_mutex);
+  mec_running.store(false);
+  mec_generation.fetch_add(1);
+  mic_requests.Clear();
+  mec_thread.reset();  // the thread ends at its next tic; never joined from a guest thread
+  MicLog("XAudioUnregisterRenderDriverMECClient (handle, 0)", uint32_t(handle), 0);
+  return X_ERROR_SUCCESS;
+}
+DECLARE_XBOXKRNL_EXPORT1(XAudioUnregisterRenderDriverMECClient, kAudio, kImplemented);
+
+dword_result_t XAudioGetRenderDriverTic_entry() {
+  return mec_running.load() ? driver_tic.load() : vm::TicAt(ClockNanoseconds());
+}
+DECLARE_XBOXKRNL_EXPORT2(XAudioGetRenderDriverTic, kAudio, kImplemented, kHighFrequency);
+
+// The speakers' last frame for the echo canceller: silence (256 samples, 6 channels).
+dword_result_t XAudioCaptureRenderDriverFrame_entry(dword_t handle, dword_t buffer) {
+  GuestMemory memory;
+  if (!buffer || !memory.Writable(buffer, vm::kSpeakerFrameBytes)) return X_E_INVALIDARG;
+  memory.Zero(buffer, vm::kSpeakerFrameBytes);
+  return X_ERROR_SUCCESS;
+}
+DECLARE_XBOXKRNL_EXPORT2(XAudioCaptureRenderDriverFrame, kAudio, kImplemented, kHighFrequency);
