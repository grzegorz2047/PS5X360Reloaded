diff --git a/.deps/xenia-canary/src/xenia/cpu/xex_module.cc b/.deps/xenia-canary/src/xenia/cpu/xex_module.cc
--- a/.deps/xenia-canary/src/xenia/cpu/xex_module.cc
+++ b/.deps/xenia-canary/src/xenia/cpu/xex_module.cc
@@ -9,6 +9,8 @@
 
 #include "xenia/cpu/xex_module.h"
 
+#include <atomic>  // fix 156j
+
 #include "third_party/fmt/include/fmt/format.h"
 
 #include "xenia/base/byte_order.h"
@@ -535,7 +537,34 @@ int XexModule::ReadImage(const void* xex_addr, size_t xex_length,
     return 0;
   }
 
-  memory()->LookupHeap(base_address_)->Reset();
+  // Xbox360PS5 fix 156j (Kinect Sports Season Two, #63): only the title's executable resets
+  // its heap. Every module did, and a DLL a title loads later (Season Two's sports,
+  // TennisDLLR/DartsDLLR at 89640000/899E0000, flags TITLE | DLL_MODULE) goes into the same
+  // 80000000 heap as the executable: the reset cleared the executable's page-table entries
+  // while its memory stayed mapped and in use. The camera then refused the NUI library's
+  // read requests in the executable's data as unmapped (83507E78-83508100: region "free"
+  // from 83500000 to the DLL, fix 156h's line) and the sport never loaded; an allocation
+  // there could also have been placed over the executable. A DLL's retry with another key
+  // gives back only the image its own earlier attempt allocated.
+  {
+    auto* heap = memory()->LookupHeap(base_address_);
+    const bool dll = (xex_header()->module_flags & XEX_MODULE_DLL_MODULE) != 0;
+    if (!dll) {
+      heap->Reset();
+    } else if (read_image_attempts_ > 0) {
+      HeapAllocationInfo info = {};
+      if (heap->QueryRegionInfo(base_address_, &info) &&
+          info.allocation_base == base_address_ &&
+          (info.state & kMemoryAllocationReserve)) {
+        heap->Release(base_address_);
+      }
+    }
+    ++read_image_attempts_;
+    static std::atomic<uint32_t> shown{0};
+    if (dll && shown.fetch_add(1) < 8)
+      XELOGW("XEX: DLL {} read at {:08X} without resetting its heap (fix 156j)", name_,
+             base_address_);
+  }
 
   aes_decrypt_buffer(
       key, reinterpret_cast<const uint8_t*>(xex_security_info()->aes_key), 16,
