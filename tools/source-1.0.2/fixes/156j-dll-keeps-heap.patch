   uint32_t base_address_ = 0;
+  // Xbox360PS5 fix 156j: ReadImage attempts made (one per key), see ReadImage.
+  uint32_t read_image_attempts_ = 0;
   uint32_t low_address_ = 0;
   uint32_t high_address_ = 0;
 
