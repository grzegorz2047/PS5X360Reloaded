diff --git a/include/xbox360ps5/camera_picture.hpp b/include/xbox360ps5/camera_picture.hpp
new file mode 100644
index 0000000..8f61439
--- /dev/null
+++ b/include/xbox360ps5/camera_picture.hpp
@@ -0,0 +1,269 @@
+// SPDX-License-Identifier: MIT
+// Fix 119 (issue 15): the phone's camera picture as the virtual Kinect's colour stream. A Kinect
+// game that shows its camera (Kinect Sports' Show Off & Share replays, photos) saw a flat grey
+// picture: the phone page sent only the skeleton. With the console's "Camera picture for the game"
+// setting on and the page's own "Camera picture" switch on (both off by default), the page also
+// sends a small picture of what its camera sees, at most 10 a second and only while the network
+// keeps up, to the console alone (port/phone_camera_tls.cpp, /api/motion/picture). The console
+// keeps the latest one in memory only (never on a drive, never in a log) and gives it to the game as the Kinect colour camera's own
+// frame: 640x480, one byte a pixel, the sensor's Bayer mosaic (G R / B G rows, as libfreenect and
+// the USB Kinect path have it, reconstructed/xbox360ps5/usb_kinect.hpp), scaled up from the phone's
+// picture. Without a picture (either switch off, no picture for 10 s, none yet) the frame is the
+// grey of before (128); turning the setting off drops the stored picture.
+//
+// The page's picture ("XPC1", little-endian): 4 bytes magic, u16 width, u16 height, u32 sequence,
+// u32 reserved (0), then YCbCr 4:2:0 as JPEG has it (full range): width*height Y, then
+// (width/2)*(height/2) Cb, then as many Cr. Width and height even, 16 to 320 by 16 to 240.
+#pragma once
+#include <algorithm>
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace xbox360ps5::motion {
+
+// The setting (launcher "motion_picture"), applied with the motion switch.
+inline std::atomic<bool> picture_wanted{false};
+
+constexpr uint32_t kPictureHeaderBytes = 16;
+constexpr uint32_t kPictureMinSide = 16, kPictureMaxWidth = 320, kPictureMaxHeight = 240;
+constexpr size_t kPictureMaxBytes = kPictureHeaderBytes + size_t(kPictureMaxWidth) * kPictureMaxHeight * 3 / 2;
+// 1.0.5-work-fix119f: the last picture is the colour frame until a newer one comes, for up to
+// 10 s. With 1 s (119 to 119e) the gaps between pictures (2 to 4 a second, in bursts) gave the
+// game grey frames between them, and Kinect Sports' replay flickered between the player and grey.
+constexpr int64_t kPictureFreshMs = 10000;  // older than this, the frame is grey again
+constexpr int64_t kPictureRestartMs = 1000;  // fix 119g: an older number after this is a new page
+constexpr uint32_t kMosaicWidth = 640, kMosaicHeight = 480;
+constexpr size_t kMosaicBytes = size_t(kMosaicWidth) * kMosaicHeight;
+constexpr uint8_t kNoPictureLevel = 128;
+
+struct Picture {
+  uint32_t width = 0, height = 0, sequence = 0;
+  const uint8_t* y = nullptr;
+  const uint8_t* cb = nullptr;
+  const uint8_t* cr = nullptr;
+};
+
+inline uint32_t PictureLe32(const uint8_t* p) { return p[0] | p[1] << 8 | p[2] << 16 | uint32_t(p[3]) << 24; }
+inline uint32_t PictureLe16(const uint8_t* p) { return p[0] | p[1] << 8; }
+
+// The picture in `body`, pointing into it; false when it is not one.
+inline bool ParsePicture(std::string_view body, Picture& out) {
+  if (body.size() < kPictureHeaderBytes || std::memcmp(body.data(), "XPC1", 4) != 0) return false;
+  const auto* p = reinterpret_cast<const uint8_t*>(body.data());
+  const uint32_t width = PictureLe16(p + 4), height = PictureLe16(p + 6);
+  if (width < kPictureMinSide || height < kPictureMinSide || width > kPictureMaxWidth ||
+      height > kPictureMaxHeight || (width | height) & 1)
+    return false;
+  const size_t luma = size_t(width) * height, chroma = luma / 4;
+  if (body.size() != kPictureHeaderBytes + luma + 2 * chroma) return false;
+  out.width = width;
+  out.height = height;
+  out.sequence = PictureLe32(p + 8);
+  out.y = p + kPictureHeaderBytes;
+  out.cb = out.y + luma;
+  out.cr = out.cb + chroma;
+  return true;
+}
+
+// Full-range YCbCr (JPEG, BT.601) to one of R (0), G (1), B (2).
+inline uint8_t PictureChannel(float y, float cb, float cr, int channel) {
+  const float value = channel == 0 ? y + 1.402f * (cr - 128)
+                    : channel == 1 ? y - .344136f * (cb - 128) - .714136f * (cr - 128)
+                                   : y + 1.772f * (cb - 128);
+  return uint8_t(std::clamp(value + .5f, 0.f, 255.f));
+}
+
+// The colour the Bayer site (x, y) of the 640x480 mosaic records: G R on even rows, B G on odd.
+inline int MosaicChannel(uint32_t x, uint32_t y) { return y & 1 ? (x & 1 ? 1 : 2) : (x & 1 ? 0 : 1); }
+
+// Bilinear sample of a plane `width` x `height` at (fx, fy) in its own pixels (centres at +.5).
+inline float PictureSample(const uint8_t* plane, uint32_t width, uint32_t height, float fx, float fy) {
+  fx = std::clamp(fx - .5f, 0.f, float(width - 1));
+  fy = std::clamp(fy - .5f, 0.f, float(height - 1));
+  const uint32_t x0 = uint32_t(fx), y0 = uint32_t(fy);
+  const uint32_t x1 = std::min(x0 + 1, width - 1), y1 = std::min(y0 + 1, height - 1);
+  const float ax = fx - x0, ay = fy - y0;
+  const float top = plane[y0 * width + x0] * (1 - ax) + plane[y0 * width + x1] * ax;
+  const float bottom = plane[y1 * width + x0] * (1 - ax) + plane[y1 * width + x1] * ax;
+  return top * (1 - ay) + bottom * ay;
+}
+
+// The picture scaled to 640x480 as the colour camera's mosaic.
+inline void PictureMosaic(const Picture& picture, std::vector<uint8_t>& out) {
+  out.resize(kMosaicBytes);
+  const float sx = float(picture.width) / kMosaicWidth, sy = float(picture.height) / kMosaicHeight;
+  const uint32_t cw = picture.width / 2, ch = picture.height / 2;
+  for (uint32_t y = 0; y < kMosaicHeight; ++y) {
+    const float py = (y + .5f) * sy;
+    for (uint32_t x = 0; x < kMosaicWidth; ++x) {
+      const float px = (x + .5f) * sx;
+      const float luma = PictureSample(picture.y, picture.width, picture.height, px, py);
+      const float cb = PictureSample(picture.cb, cw, ch, px / 2, py / 2);
+      const float cr = PictureSample(picture.cr, cw, ch, px / 2, py / 2);
+      out[size_t(y) * kMosaicWidth + x] = PictureChannel(luma, cb, cr, MosaicChannel(x, y));
+    }
+  }
+}
+
+enum class PictureResult { accepted, off, malformed };
+
+// The latest picture, as a mosaic, and when it came (steady milliseconds).
+class PictureStore {
+ public:
+  // `wanted`: the setting and the motion switch are on.
+  PictureResult Publish(std::string_view body, int64_t now_ms, bool wanted) {
+    if (!wanted) {
+      Clear();
+      return PictureResult::off;
+    }
+    Picture picture;
+    if (!ParsePicture(body, picture)) return PictureResult::malformed;
+    std::vector<uint8_t> mosaic;
+    PictureMosaic(picture, mosaic);
+    std::lock_guard lock(mutex_);
+    ++pictures_;
+    // Fix 119g: with two on their way an older one can come after a newer one: it is taken and
+    // not shown. A lower number after a second without pictures is a new page (it counts from 1).
+    if (at_ms_ && picture.sequence <= sequence_ && now_ms - at_ms_ < kPictureRestartMs) return PictureResult::accepted;
+    mosaic_.swap(mosaic);
+    at_ms_ = now_ms ? now_ms : 1;
+    sequence_ = picture.sequence;
+    return PictureResult::accepted;
+  }
+  // The colour frame: the latest picture while it is fresh and wanted; false (out untouched)
+  // otherwise, and an unwanted picture is dropped.
+  bool Copy(int64_t now_ms, bool wanted, std::vector<uint8_t>& out) {
+    std::lock_guard lock(mutex_);
+    if (!wanted) {
+      std::vector<uint8_t>().swap(mosaic_);
+      at_ms_ = 0;
+      return false;
+    }
+    if (!at_ms_ || now_ms - at_ms_ >= kPictureFreshMs || mosaic_.size() != kMosaicBytes) return false;
+    out = mosaic_;
+    return true;
+  }
+  void Clear() {
+    std::lock_guard lock(mutex_);
+    std::vector<uint8_t>().swap(mosaic_);
+    at_ms_ = 0;
+  }
+  uint64_t pictures() const { return pictures_.load(); }
+
+ private:
+  std::mutex mutex_;
+  std::vector<uint8_t> mosaic_;
+  int64_t at_ms_ = 0;
+  uint32_t sequence_ = 0;
+  std::atomic<uint64_t> pictures_{0};
+};
+inline PictureStore picture_store;
+
+// The console's answers to the page's frames say whether it wants pictures.
+inline const char* PictureJson(bool wanted) { return wanted ? ",\"picture\":1" : ",\"picture\":0"; }
+
+// A whole number after "key": in the page's latency report, -1 when it is not there.
+inline int64_t ReportNumber(std::string_view body, std::string_view key) {
+  std::string wanted = "\"";
+  wanted.append(key);
+  wanted += "\":";
+  const size_t at = body.find(wanted);
+  if (at == std::string_view::npos) return -1;
+  int64_t value = -1;
+  for (size_t n = at + wanted.size(); n < body.size() && body[n] >= '0' && body[n] <= '9' && value < (int64_t(1) << 50); ++n)
+    value = (value < 0 ? 0 : value * 10) + (body[n] - '0');
+  return value;
+}
+
+// Fix 119 (1.0.5-work-fix119b): the game log says what became of the pictures, every 10 s while
+// the setting is on or pictures come (1.0.5-work-fix119 logged only the first one taken, so a
+// grey replay did not say whether the phone sent anything): pictures taken and refused, the last
+// size, the colour frames given from a picture and grey, the setting, and the phone page's own
+// switch and counts from its latency report (every 2 s). Counters only, never the picture.
+constexpr int64_t kPictureLineMs = 10000;
+class PictureStats {
+ public:
+  void Received(uint32_t width, uint32_t height) {
+    ++received_;
+    last_size_.store(width << 16 | height);
+  }
+  void Refused(bool off) { ++(off ? refused_off_ : refused_bad_); }
+  void Frame(bool from_picture) { ++(from_picture ? picture_frames_ : grey_frames_); }
+  // Fix 119h: one picture POST on the console: its body's receive after the head, and the answer
+  // (parse, convert to the mosaic, store), in microseconds.
+  void Served(uint64_t receive_us, uint64_t answer_us) {
+    served_receive_us_ += receive_us;
+    served_answer_us_ += answer_us;
+    ++served_;
+  }
+  // The page's report: its switch (picture_on), pictures sent and skipped since it opened.
+  void Page(std::string_view report) {
+    const int64_t on = ReportNumber(report, "picture_on");
+    if (on < 0) return;
+    page_on_.store(int(on == 1));
+    page_sent_.store(uint64_t(std::max<int64_t>(ReportNumber(report, "picture_sent"), 0)));
+    page_skipped_.store(uint64_t(std::max<int64_t>(ReportNumber(report, "picture_skipped"), 0)));
+    page_failed_.store(uint64_t(std::max<int64_t>(ReportNumber(report, "picture_failed"), 0)));  // fix 119d
+    page_wanted_.store(int(ReportNumber(report, "picture_wanted")));
+    // Fix 119g: the page's average time per picture since its last report (-1: none timed).
+    page_capture_ms_.store(int(ReportNumber(report, "picture_capture_ms")));
+    page_pack_ms_.store(int(ReportNumber(report, "picture_pack_ms")));
+    page_upload_ms_.store(int(ReportNumber(report, "picture_upload_ms")));
+  }
+  // The line when one is due (the window's counters start again), empty otherwise.
+  std::string Due(int64_t now_ms, bool wanted) {
+    const int64_t started = window_start_.load();
+    if (!started) {
+      window_start_.store(now_ms ? now_ms : 1);
+      return {};
+    }
+    if (now_ms - started < kPictureLineMs) return {};
+    window_start_.store(now_ms ? now_ms : 1);
+    const uint64_t received = received_.exchange(0), off = refused_off_.exchange(0), bad = refused_bad_.exchange(0);
+    const uint64_t from_picture = picture_frames_.exchange(0), grey = grey_frames_.exchange(0);
+    const uint64_t served = served_.exchange(0), receive_us = served_receive_us_.exchange(0),
+                   answer_us = served_answer_us_.exchange(0);
+    if (!wanted && !received && !off && !bad && !from_picture) return {};
+    const uint32_t size = last_size_.load();
+    const int page_on = page_on_.load();
+    std::string line = "Virtual Kinect: camera picture in 10 s (fix 119): " + std::to_string(received) + " taken";
+    if (size) line += " (last " + std::to_string(size >> 16) + "x" + std::to_string(size & 0xFFFF) + ")";
+    line += ", refused " + std::to_string(off + bad) + " (setting off " + std::to_string(off) + ", not a picture " +
+            std::to_string(bad) + "); colour frames " + std::to_string(from_picture) + " from the picture, " +
+            std::to_string(grey) + " grey; setting " + (wanted ? "on" : "off") + "; phone page: ";
+    line += page_on < 0 ? std::string("no report (an older page, or not paired)")
+                        : std::string("switch ") + (page_on ? "on" : "off") +
+                              (page_wanted_.load() == 0 ? ", sees no ask from the PS5" : page_wanted_.load() == 1 ? ", sees the PS5 ask" : "") +
+                              ", " + std::to_string(page_sent_.load()) + " sent, " + std::to_string(page_skipped_.load()) +
+                              " skipped for the network, " + std::to_string(page_failed_.load()) + " failed";
+    if (served) {
+      char times[96];
+      std::snprintf(times, sizeof(times), "; per picture on the console: receive %.1f ms, convert and store %.1f ms",
+                    double(receive_us) / served / 1000.0, double(answer_us) / served / 1000.0);
+      line += times;
+    }
+    if (page_on >= 0 && page_capture_ms_.load() >= 0)
+      line += "; per picture on the phone: capture " + std::to_string(page_capture_ms_.load()) + " ms, pack " +
+              std::to_string(page_pack_ms_.load()) + " ms, upload " + std::to_string(page_upload_ms_.load()) + " ms";
+    return line;
+  }
+
+ private:
+  std::atomic<uint64_t> received_{0}, refused_off_{0}, refused_bad_{0}, picture_frames_{0}, grey_frames_{0};
+  std::atomic<uint32_t> last_size_{0};
+  std::atomic<int> page_on_{-1};
+  std::atomic<uint64_t> page_sent_{0}, page_skipped_{0}, page_failed_{0};
+  std::atomic<int> page_wanted_{-1};
+  std::atomic<int> page_capture_ms_{-1}, page_pack_ms_{-1}, page_upload_ms_{-1};
+  std::atomic<uint64_t> served_{0}, served_receive_us_{0}, served_answer_us_{0};
+  std::atomic<int64_t> window_start_{0};
+};
+inline PictureStats picture_stats;
+
+}  // namespace xbox360ps5::motion
