+// Fix 119: the camera picture for the game (port/phone_camera_page.hpp's sendPicture; the console's
+// include/xbox360ps5/camera_picture.hpp). 160x120, 4:3 from the middle of the camera's picture.
+export const PICTURE_WIDTH = 160, PICTURE_HEIGHT = 120;
+export const PICTURE_MS = 50;                // at most 20 a second (fix 119g; 10 before)
+export const PICTURE_SLOW_NETWORK_MS = 60;   // above this, at most 8 a second (PICTURE_SLOW_MS)
+export const PICTURE_SLOW_MS = 125;
+export const PICTURE_IN_FLIGHT = 2;          // fix 119g: the next is captured while one uploads
+export const PICTURE_MAX_NETWORK_MS = 150;   // none while a pose frame takes longer than this
+
+// The middle 4:3 of a video `width` x `height` (null before the camera has a size).
+export function pictureCrop(width, height) {
+  if (!(width > 0 && height > 0)) return null;
+  let w = width, h = height;
+  if (w * 3 > h * 4) w = h * 4 / 3; else h = w * 3 / 4;
+  return {x: (width - w) / 2, y: (height - h) / 2, width: w, height: h};
+}
+
+// RGBA pixels as the console's picture: "XPC1", u16 width, u16 height, u32 sequence, u32 0, then
+// full-range YCbCr 4:2:0 (JPEG's): Y for every pixel, Cb and Cr for every 2x2 block.
+export function packPicture(rgba, width, height, sequence) {
+  const luma = width * height, chroma = luma / 4;
+  const buffer = new ArrayBuffer(16 + luma + 2 * chroma), bytes = new Uint8Array(buffer), view = new DataView(buffer);
+  [88, 80, 67, 49].forEach((c, i) => { bytes[i] = c; });
+  view.setUint16(4, width, true); view.setUint16(6, height, true);
+  view.setUint32(8, sequence >>> 0, true); view.setUint32(12, 0, true);
+  const clamp = v => Math.max(0, Math.min(255, Math.round(v)));
+  for (let n = 0; n < luma; n++)
+    bytes[16 + n] = clamp(.299 * rgba[4 * n] + .587 * rgba[4 * n + 1] + .114 * rgba[4 * n + 2]);
+  for (let y = 0; y < height / 2; y++)
+    for (let x = 0; x < width / 2; x++) {
+      let r = 0, g = 0, b = 0;
+      for (const [dx, dy] of [[0, 0], [1, 0], [0, 1], [1, 1]]) {
+        const at = 4 * ((2 * y + dy) * width + 2 * x + dx);
+        r += rgba[at] / 4; g += rgba[at + 1] / 4; b += rgba[at + 2] / 4;
+      }
+      const n = y * (width / 2) + x;
+      bytes[16 + luma + n] = clamp(128 - .168736 * r - .331264 * g + .5 * b);
+      bytes[16 + luma + chroma + n] = clamp(128 + .5 * r - .418688 * g - .081312 * b);
+    }
