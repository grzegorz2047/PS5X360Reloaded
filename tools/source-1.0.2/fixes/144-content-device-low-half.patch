+#ifndef XENIA_KERNEL_XAM_LOW_HALF_SIZE_H_
+#define XENIA_KERNEL_XAM_LOW_HALF_SIZE_H_
+
+#include <cstdint>
+
+namespace xe {
+namespace kernel {
+namespace xam {
+
+// Xbox360PS5 (fix 144): a storage size as a game is told it. A title that
+// reads only the low 32 bits of a device's 64-bit sizes (see the note at the
+// top of xam_content_device.cc) finds zero in the console's round figures,
+// 16 GiB free of 64 GiB, and refuses to save (Just Cause 2, upstream issue
+// 36). The rule of 1.0.2's XamContentGetDeviceData, in one place: a size
+// becomes the largest one not above it whose low half is 4 GiB less 1 MiB; a
+// size up to that stays as it is.
+constexpr uint64_t kLowHalfSafeLow = 0xFFF00000ull;
+
+constexpr uint64_t LowHalfSafeSize(uint64_t bytes) {
+  if (bytes <= kLowHalfSafeLow) return bytes;
+  uint64_t high = bytes >> 32;
+  if ((bytes & 0xFFFFFFFFull) < kLowHalfSafeLow) --high;
+  return (high << 32) | kLowHalfSafeLow;
+}
+
+}  // namespace xam
+}  // namespace kernel
+}  // namespace xe
+
+#endif  // XENIA_KERNEL_XAM_LOW_HALF_SIZE_H_
