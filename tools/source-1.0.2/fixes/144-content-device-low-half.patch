+// Xbox360PS5 (fix 144): low_half_size.h; the disc keeps its fixed figures.
+uint64_t ReportedTotalBytes(const DummyDeviceInfo* device_info) {
+  if (device_info->device_type == DeviceType::ODD) {
+    return device_info->total_bytes;
+  }
+  return LowHalfSafeSize(DeviceTotalBytes(device_info));
+}
+
+uint64_t ReportedFreeBytes(const DummyDeviceInfo* device_info) {
+  if (device_info->device_type == DeviceType::ODD) {
+    return device_info->free_bytes;
+  }
+  return LowHalfSafeSize(DeviceFreeBytes(device_info));
+}
