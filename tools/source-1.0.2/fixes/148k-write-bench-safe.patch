+// Fix 148k: "small": 320 KiB files, each created (O_CREAT | O_TRUNC), set to its length (ftruncate),
+// written in 128 + 128 + 64 KiB, closed, renamed and removed, until `seconds` or `mib`; a line per
+// 10 s window. Creates count the open and the ftruncate; renames and removes their own call.
+struct SmallWindow {
+  uint64_t files = 0, bytes = 0, slow_create = 0, slow_rename = 0, slow_remove = 0;
+  double longest_create = 0, longest_rename = 0, longest_remove = 0;
+};
+inline std::string SmallLine(const std::string& dir, int index, double seconds, const SmallWindow& w) {
+  char line[400];
+  const double mib = double(w.bytes) / double(kMiB);
+  std::snprintf(line, sizeof(line),
+                "Write bench (fix 148i): %s small window %d (%.1f s): %llu files (%.1f/s), %.1f MiB (%.2f MiB/s); "
+                "create longest %.1f ms, %llu over 100 ms; rename longest %.1f ms, %llu over 100 ms; remove longest "
+                "%.1f ms, %llu over 100 ms",
+                dir.c_str(), index, seconds, (unsigned long long)w.files, seconds > 0 ? double(w.files) / seconds : 0.0,
+                mib, seconds > 0 ? mib / seconds : 0.0, w.longest_create, (unsigned long long)w.slow_create,
+                w.longest_rename, (unsigned long long)w.slow_rename, w.longest_remove,
+                (unsigned long long)w.slow_remove);
+  return line;
+}
+inline Stats RunSmall(const std::string& dir, uint64_t mib, int seconds, double window_ms = 10000.0) {
+  Stats s;
+  const std::string file = TestFile(dir), renamed = RenamedFile(dir);
+  ::unlink(file.c_str());
+  ::unlink(renamed.c_str());
+  std::vector<unsigned char> buffer(128 * 1024);
+  for (size_t i = 0; i < buffer.size(); ++i) buffer[i] = static_cast<unsigned char>(i * 131 + 7);
+  const size_t parts[3] = {128 * 1024, 128 * 1024, 64 * 1024};
+  const uint64_t total = mib * kMiB;
+  const Clock::time_point start = Clock::now();
+  Clock::time_point window_start = start;
+  SmallWindow w;
+  int index = 0;
+  s.stopped = "size";
+  while (s.bytes < total) {
+    if (MsSince(start) >= seconds * 1000.0) {
+      s.stopped = "time";
+      break;
+    }
+    Clock::time_point t = Clock::now();
+    const int fd = ::open(file.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0644);
+    if (fd < 0) {
+      s.stopped = ErrorText("open", errno);
+      break;
+    }
+    if (::ftruncate(fd, off_t(320 * 1024)) != 0) {
+      s.stopped = ErrorText("ftruncate", errno);
+      ::close(fd);
+      break;
+    }
+    double ms = MsSince(t);
+    w.longest_create = ms > w.longest_create ? ms : w.longest_create;
+    w.slow_create += ms > kStallMs;
+    uint64_t at = 0;
+    bool failed = false;
+    for (size_t part : parts) {
+      t = Clock::now();
+      const ssize_t wrote = ::pwrite(fd, buffer.data(), part, off_t(at));
+      ms = MsSince(t);
+      if (wrote != ssize_t(part)) {
+        s.stopped = wrote < 0 ? ErrorText("pwrite", errno) : "a short write";
+        failed = true;
+        break;
+      }
+      ++s.writes;
+      s.stalls += ms > kStallMs;
+      s.longest_write_ms = ms > s.longest_write_ms ? ms : s.longest_write_ms;
+      at += part;
+    }
+    ::close(fd);
+    if (failed) break;
+    t = Clock::now();
+    if (::rename(file.c_str(), renamed.c_str()) != 0) {
+      s.stopped = ErrorText("rename", errno);
+      break;
+    }
+    ms = MsSince(t);
+    w.longest_rename = ms > w.longest_rename ? ms : w.longest_rename;
+    w.slow_rename += ms > kStallMs;
+    t = Clock::now();
+    if (::unlink(renamed.c_str()) != 0) {
+      s.stopped = ErrorText("unlink", errno);
+      break;
+    }
+    ms = MsSince(t);
+    w.longest_remove = ms > w.longest_remove ? ms : w.longest_remove;
+    w.slow_remove += ms > kStallMs;
+    ++w.files;
+    w.bytes += at;
+    s.bytes += at;
+    if (MsSince(window_start) >= window_ms) {
+      s.lines.push_back(SmallLine(dir, ++index, MsSince(window_start) / 1000.0, w));
+      w = SmallWindow{};
+      window_start = Clock::now();
+    }
+  }
+  if (w.files) s.lines.push_back(SmallLine(dir, ++index, MsSince(window_start) / 1000.0, w));
+  s.seconds = MsSince(start) / 1000.0;
+  char files[48];
+  std::snprintf(files, sizeof(files), "%llu files", (unsigned long long)(s.bytes / (320 * 1024)));
+  s.note = files;
+  ::unlink(file.c_str());
+  ::unlink(renamed.c_str());
+  return s;
+}
