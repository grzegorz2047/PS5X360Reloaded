+// Fix 96: "Performance events (GPU thread, every EVENT_WRITE* packet): EVENT_WRITE n/s, x us each
+// (CACHE_FLUSH_AND_INV_EVENT n/s, ...); ..." since its previous line: the opcodes sent most first,
+// each with its own time per timed packet and its kEventTypesShown commonest types.
+inline constexpr uint32_t kEventTypesShown = 4;
+class EventReporter {
+ public:
+  std::string Line(double seconds) {
+    const uint64_t ticks_now = Ticks(), ns_now = NowNs();
+    double ns_per_tick = last_ns_per_tick_ > 0 ? last_ns_per_tick_ : 1.0;
+    if (last_ticks_ && ticks_now > last_ticks_ && ns_now > last_ns_)
+      ns_per_tick = double(ns_now - last_ns_) / double(ticks_now - last_ticks_);
+    last_ns_per_tick_ = ns_per_tick;
+    last_ticks_ = ticks_now;
+    last_ns_ = ns_now;
+    const double s = seconds > 0 ? seconds : 1;
+    struct Opcode {
+      uint32_t opcode = 0;
+      uint64_t count = 0, ticks = 0, timed = 0;
+      std::array<std::pair<uint64_t, uint32_t>, kEventTypes> types{};
+    };
+    std::array<Opcode, kEventOpcodes> opcodes{};
+    for (uint32_t o = 0; o < kEventOpcodes; ++o) {
+      opcodes[o].opcode = o;
+      for (uint32_t t = 0; t < kEventTypes; ++t) {
+        const uint64_t now = event_types[o][t].load(std::memory_order_relaxed);
+        opcodes[o].types[t] = {now - last_types_[o][t], t};
+        opcodes[o].count += now - last_types_[o][t];
+        last_types_[o][t] = now;
+      }
+      const uint64_t ticks = event_ticks[o].load(std::memory_order_relaxed);
+      const uint64_t timed = event_timed[o].load(std::memory_order_relaxed);
+      opcodes[o].ticks = ticks - last_ticks_by_[o];
+      opcodes[o].timed = timed - last_timed_[o];
+      last_ticks_by_[o] = ticks;
+      last_timed_[o] = timed;
+    }
+    std::sort(opcodes.begin(), opcodes.end(), [](const Opcode& a, const Opcode& b) { return a.count > b.count; });
+    std::string parts;
+    for (Opcode& op : opcodes) {
+      if (!op.count) continue;
+      std::sort(op.types.begin(), op.types.end(), [](const auto& a, const auto& b) { return a.first > b.first; });
+      char item[128];
+      if (op.timed)
+        std::snprintf(item, sizeof(item), "%s%s %.0f/s, %.2f us each (", parts.empty() ? "" : "; ",
+                      EventOpcodeName(op.opcode), double(op.count) / s,
+                      double(op.ticks) * ns_per_tick / 1e3 / double(op.timed));
+      else
+        std::snprintf(item, sizeof(item), "%s%s %.0f/s, untimed (", parts.empty() ? "" : "; ",
+                      EventOpcodeName(op.opcode), double(op.count) / s);
+      parts += item;
+      for (uint32_t i = 0; i < kEventTypesShown && op.types[i].first; ++i) {
+        const char* name = EventTypeName(op.types[i].second);
+        if (name)
+          std::snprintf(item, sizeof(item), "%s%s %.0f/s", i ? ", " : "", name, double(op.types[i].first) / s);
+        else
+          std::snprintf(item, sizeof(item), "%stype %u %.0f/s", i ? ", " : "", op.types[i].second,
+                        double(op.types[i].first) / s);
+        parts += item;
+      }
+      parts += ")";
+    }
+    return "Performance events (GPU thread, every EVENT_WRITE* packet): " +
+           (parts.empty() ? std::string("none") : parts);
+  }
+
+ private:
+  std::array<std::array<uint64_t, kEventTypes>, kEventOpcodes> last_types_{};
+  std::array<uint64_t, kEventOpcodes> last_ticks_by_{}, last_timed_{};
+  uint64_t last_ticks_ = 0, last_ns_ = 0;
+  double last_ns_per_tick_ = 0;
+};
 
