+// Fix 96: EVENT_WRITE* by opcode and event type. Red Dead Redemption on the 1.0.5 perf builds:
+// 233,490 a second (about 1.4 per draw), 64.5 ms/s of the GPU command thread's own time, 0.28 us
+// each against 0.08 for a register write; Modern Warfare 2 sends 2,400 a second. Every event
+// packet is counted by opcode and VGT_EVENT_INITIATOR type (the GPU thread's own counters); the
+// packets fix 75 times give each opcode's own time.
+enum EventOpcode : uint32_t { kEventWrite = 0, kEventWriteShd, kEventWriteExt, kEventWriteZpd, kEventOpcodes };
+inline constexpr uint32_t kEventTypes = 64;  // VGT_EVENT_INITIATOR & 0x3F
+inline uint32_t EventOpcodeOf(uint32_t packet) {
+  if (packet >> 30 != 3) return kEventOpcodes;
+  switch ((packet >> 8) & 0x7F) {
+    case 0x46: return kEventWrite;     // PM4_EVENT_WRITE
+    case 0x58: return kEventWriteShd;  // PM4_EVENT_WRITE_SHD
+    case 0x5A: return kEventWriteExt;  // PM4_EVENT_WRITE_EXT
+    case 0x5B: return kEventWriteZpd;  // PM4_EVENT_WRITE_ZPD
+    default: return kEventOpcodes;
+  }
+}
+inline const char* EventOpcodeName(uint32_t opcode) {
+  static const char* const names[] = {"EVENT_WRITE", "EVENT_WRITE_SHD", "EVENT_WRITE_EXT", "EVENT_WRITE_ZPD"};
+  return opcode < kEventOpcodes ? names[opcode] : "?";
+}
+// xenos::Event (xenia/gpu/xenos.h); null for a type it does not name.
+inline const char* EventTypeName(uint32_t type) {
+  static const char* const names[] = {
+      "VS_DEALLOC", "PS_DEALLOC", "VS_DONE_TS", "PS_DONE_TS", "CACHE_FLUSH_TS", "CONTEXT_DONE", "CACHE_FLUSH",
+      "VIZQUERY_START", "VIZQUERY_END", "SC_WAIT_WC", "MPASS_PS_CP_REFETCH", "MPASS_PS_RST_START",
+      "MPASS_PS_INCR_START", "RST_PIX_CNT", "RST_VTX_CNT", "TILE_FLUSH", nullptr, nullptr, nullptr, nullptr,
+      "CACHE_FLUSH_AND_INV_TS_EVENT", "ZPASS_DONE", "CACHE_FLUSH_AND_INV_EVENT", "PERFCOUNTER_START",
+      "PERFCOUNTER_STOP", "SCREEN_EXT_INIT", "SCREEN_EXT_RPT", "VS_FETCH_DONE_TS"};
+  return type < sizeof(names) / sizeof(names[0]) ? names[type] : nullptr;
+}
+inline std::array<std::array<std::atomic<uint64_t>, kEventTypes>, kEventOpcodes> event_types{};
+inline std::array<std::atomic<uint64_t>, kEventOpcodes> event_ticks{}, event_timed{};
+// Called by each EVENT_WRITE* handler with the initiator it read.
+inline void CountEvent(uint32_t opcode, uint32_t initiator) {
+  if (opcode < kEventOpcodes && OnGpuThread()) AddOwn(event_types[opcode][initiator % kEventTypes], 1);
+}
