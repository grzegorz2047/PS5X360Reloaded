+// Fix 117d: the texture cache's eviction while free memory is under the render target floor: textures
+// unused for 2 s go, down to half of what the cache holds (at least 128 MiB, at most its own soft limit).
+struct EvictionLimits {
+  uint64_t soft_mb = 0;
+  uint64_t lifetime_ms = 0;
+  bool pressure = false;
+};
+inline EvictionLimits TextureEviction(uint64_t soft_mb, uint64_t lifetime_ms, uint64_t usage_mb, int64_t direct_free) {
+  EvictionLimits limits;
+  limits.soft_mb = soft_mb;
+  limits.lifetime_ms = lifetime_ms;
+  if (direct_free < 0 || uint64_t(direct_free) >= kRenderTargetFloor) return limits;
+  limits.pressure = true;
+  const uint64_t half = usage_mb / 2 > 128 ? usage_mb / 2 : 128;
+  limits.soft_mb = half < soft_mb ? half : soft_mb;
+  limits.lifetime_ms = lifetime_ms < 2000 ? lifetime_ms : 2000;
+  return limits;
+}
