+// Fix 134b: whether a wait for `awaited` must first drain the worker: only while that submission
+// was handed to it (`handed_off`, the last one) and not yet submitted (`submitted`, the last
+// one), or to surface its failure. BeginSubmission's wait for submission 0 at every new
+// submission needs nothing from the worker.
+inline bool NeedsDrain(uint64_t awaited, uint64_t submitted, uint64_t handed_off, bool failed) {
+  return failed || (awaited > submitted && awaited <= handed_off);
